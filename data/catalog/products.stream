    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085693MV1\",\"sku\":\"B085693MV1\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-maize-b085693mv1\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Maize\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Maize\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eG5BOWK6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61iI4-NMIGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61iI4-NMIGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VDoj3fvAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VDoj3fvAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KJ6pGRxKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KJ6pGRxKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715nFgrdR0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715nFgrdR0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ec+v84N7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ec+v84N7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815iQpISXCL.j