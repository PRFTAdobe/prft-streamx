      "content": {
        "bytes": "{\"id\":\"B07HSF19SC\",\"sku\":\"B07HSF19SC\",\"lang\":\"en\",\"slug\":\"kristy-tufted-dining-room-kitchen-chair-set-of-2-36-5-h-ivory-b07hsf19sc\",\"name\":\"Kristy Tufted Dining Room Kitchen Chair, Set of 2, 36.5&quot;H, Ivory\",\"description\":\"Diamond-patterned button tufting, a low arm profile, and sleek curved back legs make this dining chair stand out. The sand-washed legs and ivory fabric evoke a sense of style and class. Solid wood frame, fabric Back legs curve out for added flair without compromising support 24&quot;D x 22&quot;W x 36.5&quot;H Set of 2 Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kristy Tufted Dining Room Kitchen Chair, Set of 2, 36.5&quot;H, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eU7kd5swL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iK3L+GWfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iK3L+GWfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818YD22LUfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818YD22LUfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1itfEa7j-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1itfEa7j-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918ckPy4p9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918ckPy4p9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ln4WP+YWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ln4WP+YWL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"length\"