    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QFF9FY\",\"sku\":\"B075QFF9FY\",\"lang\":\"en\",\"slug\":\"chanton-upholstered-tufted-king-sleigh-bed-with-headboard-95-5-l-grey-b075qff9fy\",\"name\":\"Chanton Upholstered Tufted King Sleigh Bed with Headboard, 95.5&quot;L, Grey\",\"description\":\"Mid-century modern meets traditional sleigh bed. A low-profile headboard and footboard feature tufted detailing and arched rolls at the top for a truly  romantic flair. Soft linen fabric adds a feel of luxury and a touch of glamour. 95.5&quot;L x 81.1&quot;W x 52.2&quot;H Fabric of 65% rayon/35% linen covers a hardwood frame A romantic transitional style that will blend with classic and modern décor Includes upholstered side rails. Requires mattress and boxspring (sold separately). Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Chanton Upholstered Tufted King Sleigh Bed with Headboard, 95.5&quot;L, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nuvZE-NML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ny-I8JJGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ny-I8JJGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13ihzXZ8pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13ihzXZ8pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QRSHRvAAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QRSHRvAAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NwV-Bp7xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NwV-Bp7xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xApGtL-OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1