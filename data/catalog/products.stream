    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5ZTYY\",\"sku\":\"B07HZ5ZTYY\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-armless-chair-23-w-linen-b07hz5ztyy\",\"name\":\"Bagley Sectional Component Armless Chair, 23&quot;W, Linen\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the armless chair component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 23&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component Armless Chair, 23&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51iIbYypaNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813QVTviBIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813QVTviBIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kVuBRSKyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kVuBRSKyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FVEjjKZ3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FVEjjKZ3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\"}],\"attributes\":[{\"nam