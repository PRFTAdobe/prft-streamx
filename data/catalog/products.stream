    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X3SJ4V\",\"sku\":\"B075X3SJ4V\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-sandstone-b075x3sj4v\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Sandstone\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h3-04uGGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qkA0kuY-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qkA0kuY-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ig94D87IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ig94D87IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O2NqsGOJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O2NqsGOJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UWbpWHUqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UWbpWHUqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"wi