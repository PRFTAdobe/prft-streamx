    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ4NG1G\",\"sku\":\"B07HZ4NG1G\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-left-facing-sofa-chaise-fabric-41-w-stone-b07hz4ng1g\",\"name\":\"Bagley Sectional Component, Left-Facing Sofa Chaise, Fabric, 41&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the left-facing sofa chaise component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 41&quot;W x 87&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Left-Facing Sofa Chaise, Fabric, 41&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZJHciSOnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/417UjPzAhzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/417UjPzAhzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rKRvb9PqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rKRvb9PqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U92IToOQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U92IToOQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UNylcahDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UNylcahDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"43.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"89.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"180.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Facing\",\"label\":\"Facing\"},{\"value\":\"Pull\",\"label\":\"Pull\"},{\"value\":\"Left\",\"label\":\"Left\"},{\"value\":\"Sala\",\"label\":\"Sala\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"L\",\"label\":\"L\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Salas\",\"label\":\"Salas\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Cheap\",\"label\":\"Cheap\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Casa\",\"label\":\"Casa\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Grey\",\"label\":\"Grey\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Sized\",\"label\":\"Sized\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Sillones\",\"label\":\"Sillones\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Smith\",\"label\":\"Smith\"},{\"value\":\"Color\",\"label\":\"Color\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Rooms\",