    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ23K4C\",\"sku\":\"B07QJ23K4C\",\"lang\":\"en\",\"slug\":\"aikins-modern-king-footboard-and-side-rails-84-w-glazed-mocha-b07qj23k4c\",\"name\":\"Aikins Modern King Footboard and Side Rails, 84&quot;W, Glazed Mocha\",\"description\":\"A beautiful way to complete the look of your king-size bed, this glazed-mocha side-rails-and-footboard set works perfectly with the Aikins modern king headboard. 84&quot;W x 83&quot;D x 12&quot;H Glazed mocha finish, oak veneers, select solids, champagne hardware The casual contemporary style of this collection makes it the perfect addition or update to your bedroom. Platform support system means no box spring needed. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty. Wipe clean with a soft, dry cloth. Includes footboard and side rails only. Headboard sold separately.\",\"primaryImage\":{\"alt\":\"Aikins Modern King Footboard and Side Rails, 84&quot;W, Glazed Mocha\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7184WsUNn3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/511qB7iyGoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/511qB7iyGoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ir++MbpWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ir++MbpWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I4kHA5BRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I4kHA5BRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tTPcKwItL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tTPcKwItL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"12.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"89.0\",\"l