    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC15YLQ\",\"sku\":\"B07PC15YLQ\",\"lang\":\"en\",\"slug\":\"rivet-cove-mid-century-modern-tufted-sofa-with-tapered-legs-72-w-denim-b07pc15ylq\",\"name\":\"Rivet Cove Mid-Century Modern Tufted Sofa with Tapered Legs, 72&quot;W, Denim\",\"description\":\"This modern sofa comes with tufted back and seat cushions atop tall tapered legs. The design offers simple lines that fit well with most decors, and the solid wood frame give this beautiful piece a sense of solidity and timelessness. 71.7&quot;W x 33.9&quot;D x 35.4&quot;H Solid wood frame and legs; 100% polyester upholstery Add style when you add extra seating with this gorgeous modern sofa. Tufting on the seat and back cushions adds elegance to this modern sofa. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cove Mid-Century Modern Tufted Sofa with Tapered Legs, 72&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WUd0ux1kL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SSo4UqPEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SSo4UqPEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qhwmBdWWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qhwmBdWWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916G69ZJThL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916G69ZJThL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I5sR3BrRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I5sR3BrRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810iIACWP6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810iIACWP6L