    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084FMN5W9\",\"sku\":\"B084FMN5W9\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-kitchen-dining-room-accent-chair-33-h-aqua-renewed-b084fmn5w9\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Aqua (Renewed)\",\"description\":\"A cut-out back and tapered legs give this accent chair a classic mid-century modern design. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 22.8&quot;W x 22.1&quot;D x 33.1&quot;H; Seat Height is 18.5&quot; Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Aqua (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZZ6NnKQJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MOvwN7s2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MOvwN7s2L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"23.1\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Aqua\",\"label\":\"Aqua\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Din