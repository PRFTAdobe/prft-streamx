    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BKKXRVC\",\"sku\":\"B07BKKXRVC\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-velvet-bench-seat-sofa-couch-86-6-w-hunter-green-b07bkkxrvc\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Seat Sofa Couch, 86.6&quot;W, Hunter Green\",\"description\":\"This sleek, Mid-century inspired velvet sofa is designed to impress. A long fixed bench seat cushion, two back cushions, tapered wood legs, and smooth bolster pillows provide just the right mix of sophistication with a contemporary edge. 86.6&quot;W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs. Removable and reversible back cushions for easy cleaning. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Seat Sofa Couch, 86.6&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LPkVwJRGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14VXc5P95L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14VXc5P95L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W0yG1DTuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W0yG1DTuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v0+Mi2SoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v0+Mi2SoL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"86.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.2\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"110.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Hunter green\",\"label\":\"Hunter green\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Green\",\"label\":\"Green\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]},{\"id\":\"Featured\",\"slug\":\"featured\",\"name\":\"Featured\",\"value\":\"Featured\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":999,\"discountedValue\":899.1}}"
