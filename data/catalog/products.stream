    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJCBY2\",\"sku\":\"B07BWJCBY2\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-leather-loveseat-sofa-couch-78-7-w-black-b07bwjcby2\",\"name\":\"Bradbury Chesterfield Tufted Leather Loveseat Sofa Couch, 78.7&quot;W, Black\",\"description\":\"Create a lounge-worthy living room with this modernized Chesterfield sofa. Rich brown leather upholstery, along with a high back and arms, invites you to curl up to read a good book or take a catnap. Dimensions: 78.7''W x 39”D x 30.3”H Engineered wood frame and 100% leather Modern and classic touches Restyled classic design with durable leather. Easy-to-attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Leather Loveseat Sofa Couch, 78.7&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817AhxzIWeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819mIp6mRsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819mIp6mRsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eLaTci5YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eLaTci5YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915Z92fE16L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915Z92fE16L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LCctMbPPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LCctMbPPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ik1E9EStL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ik1E9EStL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZgoEqXACL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina