    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ML8YQ\",\"sku\":\"B07B4ML8YQ\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-light-blue-b07b4ml8yq\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Light Blue\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 31&quot;W x 23&quot;D x 20&quot;H; Seat Height: 20&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 20&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I3TW2mpqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X2fzb4bzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X2fzb4bzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sxHzehFuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sxHzehFuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hUhA6CaYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hUhA6CaYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tT6z-CcQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tT6z-CcQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eJSa4EvgS.jpg\",\"url\":\"https://storage.googleap