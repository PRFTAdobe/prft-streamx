    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MQQSP\",\"sku\":\"B07B4MQQSP\",\"lang\":\"en\",\"slug\":\"modern-tufted-ottoman-40-5-w-beige-b07b4mqqsp\",\"name\":\"Modern Tufted Ottoman, 40.5&quot;W, Beige\",\"description\":\"After a long day, your tired legs and feet will look forward to this soft, comfy ottoman. It's also a handy extra seat for guests and a place to rest a tray of snacks. Tufting on the top and sides gives it a mid-century modern flair. 40.5&quot;W x 40.5&quot;D x 17.3&quot;H Polyester fabric on wood frame Tufting on sides and top is classic mid-century modern style Use as a foot rest, an extra seat for company, or a perch for a snack tray No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Tufted Ottoman, 40.5&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A199PNoD3sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rxXwRquIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rxXwRquIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0oUpi6aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0oUpi6aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PP7rW2RcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PP7rW2RcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b64R-SrxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b64R-SrxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A177-+bPJiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A177-+bPJiL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"val