    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78RCTK\",\"sku\":\"B07B78RCTK\",\"lang\":\"en\",\"slug\":\"ariana-rustic-farmhouse-metal-bar-stool-set-of-2-24-75-h-brown-pine-b07b78rctk\",\"name\":\"Ariana Rustic Farmhouse Metal Bar Stool, Set of 2, 24.75&quot;H, Brown Pine\",\"description\":\"These counter-height stools are ideal for hosting guests around a kitchen island, next to the matching counter-height table (sold separately), or any room where you need extra seating. The wood and metal combination is versatile for transitional, rustic or industrial decor. 19&quot;W x 14&quot;D x 24.75&quot;H; Seat Height: 24.75&quot;H Pine hardwood seat paired with metal base and legs Versatile enough to blend with most any style Ideal height for kitchen island; easy to move to other rooms when you need extra seating Free returns for 30 days. 3-year warranty. Assembly in 30 minutes or less No detail about how to assemble\",\"primaryImage\":{\"alt\":\"Ariana Rustic Farmhouse Metal Bar Stool, Set of 2, 24.75&quot;H, Brown Pine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p8SkpTUML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jNla8P1IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jNla8P1IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n9IoJ7hzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n9IoJ7hzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NGGuRPpML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NGGuRPpML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13i6G5ChVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13i6G5ChVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LaOs+HTWL.jpg\",\"url\":\"https://storage.googleapis.co