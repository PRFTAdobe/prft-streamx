    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QGD5HS\",\"sku\":\"B075QGD5HS\",\"lang\":\"en\",\"slug\":\"rivet-gwyneth-mid-century-velvet-king-bed-with-headboard-92-1-l-jade-green-b075qgd5hs\",\"name\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 92.1&quot; L, Jade Green\",\"description\":\"This bed's sumptuous upholstery will have you feeling like royalty. Both headboard and footboard have channel tufting, while the plush velvet fabric exudes glamour. Wooden legs with warm dark finish complete this mid-century modern look. 92.1&quot;L x 81.7&quot;W x 49&quot;H Velvet upholstery; wood legs. Mid-century modern style with glam detailing and fabric No boxspring required. King mattress sold separately. Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 92.1&quot; L, Jade Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+eqPwnwzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-bxUoszDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-bxUoszDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814mQYI23lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814mQYI23lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wwwJXF2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wwwJXF2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14J8DfbqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14J8DfbqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pEhPkUrvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pEhPkUrvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"92.13\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"81.67\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"110.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Jade\",\"label\":\"Jade\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Green\",\"label\":\"Green\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"}]}],\"categories\":[{\"id\":\"Beds\",\"slug\":\"beds\",\"name\":\"Beds\",\"value\":\"Beds\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":389,\"discountedValue\":350.1}}"
