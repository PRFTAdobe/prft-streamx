    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X65QPT\",\"sku\":\"B075X65QPT\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-leather-ottoman-27-w-driftwood-b075x65qpt\",\"name\":\"Rivet Lawson Modern Angled Leather Ottoman, 27&quot;W, Driftwood\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Nylon webbing supports the seat Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Leather Ottoman, 27&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y2xuN12sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jwxp0eGiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jwxp0eGiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sxLGpmgRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sxLGpmgRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816n4ZShvxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816n4ZShvxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"27.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"valu