    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMSQ3W\",\"sku\":\"B07BWMSQ3W\",\"lang\":\"en\",\"slug\":\"andover-modern-right-u-sectional-sofa-134-w-cream-b07bwmsq3w\",\"name\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Cream\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wooden legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+N8-lBiZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71orWTMaHWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71orWTMaHWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rIt4ewllL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rIt4ewllL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ag0VzvuVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ag0VzvuVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FNzQD0q1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FNzQD0q1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"lab