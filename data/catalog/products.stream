    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831Y1G6B\",\"sku\":\"B0831Y1G6B\",\"lang\":\"en\",\"slug\":\"devonshire-modern-farmhouse-sectional-sofa-couch-114-w-putty-b0831y1g6b\",\"name\":\"Devonshire Modern Farmhouse Sectional Sofa Couch, 114&quot;W, Putty\",\"description\":\"This spacious sectional sofa makes a modern but down-to-earth design statement in your living room or family room. The foam-padded cushions are loose and reversible, providing the ultimate in comfort and durability. Putty-colored performance upholstery is easy to care for and maintain. 114&quot;W x 78.5&quot;D x 35.5&quot;H; seat height: 21.5&quot;H; seat depth: 27.5&quot;D; seat back height: 29&quot;H; arm height: 29&quot;H; leg height: 1.78&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible back and seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Devonshire Modern Farmhouse Sectional Sofa Couch, 114&quot;W, Putty\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pIfGD6ScL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Fz3L44+-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Fz3L44+-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pw0w8t-VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pw0w8t-VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VcStwQfbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VcStwQfbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19KfmOCK6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19KfmOCK6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819F5SbtvnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819F5SbtvnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xVu9N1WRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xVu9N1WRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"114.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"274.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"For\",\"label\":\"For\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Sierra\",\"label\":\"Sierra\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"With\",\"label\":\"With\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"And\",\"label\":\"And\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Lodge\",\"label\":\"Lodge\"},{\"value\":\"Grey\",\"label\":\"Grey\"},{\"value\":\"Power\",\"label\":\"Power\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":371,\"discountedValue\":333.9}}"
