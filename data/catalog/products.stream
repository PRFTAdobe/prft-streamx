    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QC85YG7\",\"sku\":\"B07QC85YG7\",\"lang\":\"en\",\"slug\":\"industrial-solid-mango-wood-coffee-table-with-trestle-style-base-52-w-honey-finish-b07qc85yg7\",\"name\":\"Industrial Solid Mango Wood Coffee Table with Trestle-Style Base, 52&quot;W, Honey Finish\",\"description\":\"The trestle-style base of this coffee table, made of solid mango, offers a stylish look and durability while touting rasped boards for a beautiful texture on top. An industrial piece, this table looks great with farmhouse decor and offers a great place to put your feet up. 51.97&quot;W x 29.92&quot;D x 17.91&quot;H This table, constructed of solid mango, comes with a rasped top that is sanded smooth. The industrial flavor of this piece adds beauty to the versatile and classic farmhouse style. Functionality is increased by the planked top and trestle-style base. Assemble in 15 minutes or less Wipe with a soft, damp cloth; dry thoroughly. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Solid Mango Wood Coffee Table with Trestle-Style Base, 52&quot;W, Honey Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zP0fnB91L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KPbJgoAGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KPbJgoAGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LCmVhuauL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LCmVhuauL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11Zke0p2pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11Zke0p2pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y2O1ottFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y2O1ottFL.jpg\"},{\"alt\":\"https://storage.googl