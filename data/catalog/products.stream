    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07JCDQWM6\",\"sku\":\"B07JCDQWM6\",\"lang\":\"en\",\"slug\":\"rivet-thomas-modern-leather-sofa-couch-81-5-w-chestnut-b07jcdqwm6\",\"name\":\"Rivet Thomas Modern Leather Sofa Couch, 81.5&quot;W, Chestnut\",\"description\":\"This top-grain leather sofa can bring natural warmth to your living room. The simple, angular design has air of modernity to it, and the solid-wood frame ensures that this sofa will last for years to come. Overall: 81.5&quot;W x 40.9&quot;D x 26.8&quot;H; Seat Height: 16.1&quot;H; Seat Depth: 28&quot;D; Seat Back Height: 25.6&quot;H; Arm Height: 26.8&quot;H; Leg Height: 1.2&quot;H Solid-wood frame and legs with 100% leather upholstery The seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Thomas Modern Leather Sofa Couch, 81.5&quot;W, Chestnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e51Rb1h4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qIZlZvbRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qIZlZvbRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mHh0uPy7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mHh0uPy7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71E0Xw2UNWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71E0Xw2UNWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nvBSHHgrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nvBSHHgrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tqV194RZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tqV194RZL.jpg\"}],\"att