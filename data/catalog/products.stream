    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBD11\",\"sku\":\"B07QCMBD11\",\"lang\":\"en\",\"slug\":\"rivet-brooker-down-filled-mid-century-love-seat-65-w-top-grain-leather-cognac-b07qcmbd11\",\"name\":\"Rivet Brooker Down-Filled Mid-Century Love Seat, 65&quot;W, Top Grain Leather, Cognac\",\"description\":\"This mid-century love seat with removable and reversible down-filled cushions offers comfort, while the hardwood frame, tapered legs, and top grain leather increase its durability. Whether used as a focus piece or a foundational piece, tufted back cushions add a touch of elegance to any room. 65&quot;W x 38&quot;D x 35&quot;H Solid hardwood frame, down-filled top grain leather cushions, tapered wood legs Removable and reversible down-filled cushions This mid-century love seat adds elegance and comfort to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brooker Down-Filled Mid-Century Love Seat, 65&quot;W, Top Grain Leather, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CcfxgUM6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qovrNXNqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qovrNXNqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wLFvaO6PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wLFvaO6PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1m8NGjhLzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1m8NGjhLzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AOb9UR6aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AOb9UR6aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71w6vmLfuNL.jpg\",\