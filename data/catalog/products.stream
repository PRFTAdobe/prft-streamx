    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4R6CT\",\"sku\":\"B075X4R6CT\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-sofa-92-w-walnut-b075x4r6ct\",\"name\":\"Charles Classic Oversized Leather Sofa, 92&quot;W, Walnut\",\"description\":\"This item is made to order just for you Overall depth: 39&quot;, Seat depth: 23&quot;, Height: 38&quot;, Width: 92&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional sofa with plenty of room for family, friends and pets Let yourself be wrapped in comfort by this extra large sofa. Traditional rolled arms and turned wood legs are combined with modern 100% leather upholstery for an update on a classic piece. Its long silhouette means ample space for the whole family. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Sofa, 92&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iNur8dupL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MMsEmt5KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MMsEmt5KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KDambstGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KDambstGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MAn3uuurL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MAn3uuurL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"92.0\",