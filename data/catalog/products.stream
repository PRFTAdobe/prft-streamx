    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9ZFQZ\",\"sku\":\"B07QF9ZFQZ\",\"lang\":\"en\",\"slug\":\"rivet-campbell-mid-century-media-console-with-tapered-legs-47-w-dark-wood-and-white-b07qf9zfqz\",\"name\":\"Rivet Campbell Mid-Century Media Console with Tapered Legs, 47&quot;W, Dark Wood and White\",\"description\":\"Tall tapered legs add visual interest to this casual, 2-toned media console with a vintage flair. The 3 self-closing drawers and cabinet provide necessary storage for those on the go, while the engineered and solid wood construction offer a lasting durability. 47&quot;W x 16&quot;D x 32&quot;H 80% MDF, 20% solid wood Vintage tapered legs add interest to the clean lines of this media console. A cabinet and 3 self-closing drawers provide a needed storage solution. Assemble in 15-30 minutes Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Campbell Mid-Century Media Console with Tapered Legs, 47&quot;W, Dark Wood and White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ixIGyx5-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hONtyzfgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hONtyzfgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8112FdvWUDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8112FdvWUDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/610IW+GJWwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/610IW+GJWwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dTmaZ3eTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dTmaZ3eTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S06peNRdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pi