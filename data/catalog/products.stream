    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5VCNQ\",\"sku\":\"B075X5VCNQ\",\"lang\":\"en\",\"slug\":\"rivet-eva-mid-century-modern-tufted-velvet-down-filled-loveseat-sofa-couch-60-5-w-navy-b075x5vcnq\",\"name\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Loveseat Sofa Couch, 60.5&quot;W, Navy\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted loveseat featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible, and is held in place by clips at the corners. 60.5&quot;W x 35.25''D x 30.25''H Durable polyester velvet on hardwood frame and brushed brass legs Modern elegant style with reversible cushion to extend the life of the piece Simple assembly in 15 minutes or less.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Loveseat Sofa Couch, 60.5&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UMgL-nEvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o2BUw9XGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o2BUw9XGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mIhJfzpzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mIhJfzpzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A110HIyIegL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A110HIyIegL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G+LmavNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G+LmavNML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"