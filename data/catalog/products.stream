    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853JPW6W\",\"sku\":\"B0853JPW6W\",\"lang\":\"en\",\"slug\":\"rivet-curved-upholstered-headboard-queen-60-w-blue-b0853jpw6w\",\"name\":\"Rivet Curved Upholstered Headboard, Queen, 60&quot;W, Blue\",\"description\":\"The softly curved silhouette of this simple yet striking headboard invites thoughts of cozy nights and restful hours of deep sleep. The blue upholstery and adjustable height mean the headboard easily fits in with your existing furnishings. 60&quot;W x 3.5&quot;D x 47.5&quot;–55.5&quot;H The well-constructed wood frame is padded with polyurethane foam for added comfort. The legs of this headboard adjust to 3 different heights, allowing it to attach to any standard bed frame. The simple yet striking panel design of this headboard will provide a soft accent to your bedroom suite. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Curved Upholstered Headboard, Queen, 60&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61U0i7NOazL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sMpdmYZIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sMpdmYZIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZeFjkgGzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZeFjkgGzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71E2OyrzJ+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71E2OyrzJ+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16oc9HAlBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16oc9HAlBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bMTyADY+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bMTyADY+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vp1Pix00L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vp1Pix00L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71utmKNNIfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71utmKNNIfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"55.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"3.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"60.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"35.64\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Footboard\",\"label\":\"Footboard\"},{\"value\":\"Progressive\",\"label\":\"Progressive\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Zinus\",\"label\":\"Zinus\"},{\"value\":\"Tufted\",\"label\":\"Tufted\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":575,\"discountedValue\":517.5}}"
