    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568YKWY\",\"sku\":\"B08568YKWY\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-faux-leather-dining-chair-21-w-set-of-2-black-b08568ykwy\",\"name\":\"Rivet Decatur Modern Faux Leather Dining Chair, 21&quot;W, Set of 2, Black\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat in durable faux leather. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Faux Leather Dining Chair, 21&quot;W, Set of 2, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7171E3qx9LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QFz6UOVRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QFz6UOVRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Djn9AfcoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Djn9AfcoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41hf9kCfjlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41hf9kCfjlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IM68fVHdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IM68fVHdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/617SKU8U2ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/617SKU8U2ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pEqUjwh