    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DMNZC\",\"sku\":\"B07B7DMNZC\",\"lang\":\"en\",\"slug\":\"rivet-modern-round-metal-coffee-table-18-5-h-gold-and-glass-b07b7dmnzc\",\"name\":\"Rivet Modern Round Metal Coffee Table, 18.5&quot;H, Gold and Glass\",\"description\":\"The high gloss, gold-finish frame rims glass shelves, bringing modern glamour to your room. Use the top for a lamp or displaying photos. The lower glass shelf gives you more display space -- or a place to stash magazines or a gaming console. 18&quot;W x 18&quot;D x 21&quot;H Metal, tempered glass Plenty of gloss and shine for a modern glam look A pretty style piece for your room along with providing display space No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Round Metal Coffee Table, 18.5&quot;H, Gold and Glass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m1AHyCSZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V-DtgBY8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V-DtgBY8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QvnK72HXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QvnK72HXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q591o1uCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q591o1uCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-dxclDXkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-dxclDXkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L1Npo13fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L1Npo13fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lw6bsNe6L.jpg\",\"url\":\"https://storage.goo