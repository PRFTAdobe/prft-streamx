        "bytes": "{\"id\":\"B07BW8QSD3\",\"sku\":\"B07BW8QSD3\",\"lang\":\"en\",\"slug\":\"andover-modern-left-u-sectional-sofa-134-w-cream-b07bw8qsd3\",\"name\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Cream\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lEmwM0jhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wata3793L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wata3793L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nTsyOMLDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nTsyOMLDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71L0nRmY8cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71L0nRmY8cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ag0VzvuVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ag0VzvuVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"