        "bytes": "{\"id\":\"B075X5HB6G\",\"sku\":\"B075X5HB6G\",\"lang\":\"en\",\"slug\":\"leila-tufted-chair-44-w-latte-b075x5hb6g\",\"name\":\"Leila Tufted Chair, 44&quot; W, Latte\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage looking chair. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Chair, 44&quot; W, Latte\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Kf58eVC1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Mw-MXkxFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Mw-MXkxFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zyqaxYOBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zyqaxYOBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pes4I7r1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pes4I7r1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N40SKn6EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N40SKn6EL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":\"inc