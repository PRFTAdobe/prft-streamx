    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK58GZ\",\"sku\":\"B07BWK58GZ\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-u-sectional-couch-sofa-117-w-slate-brown-b07bwk58gz\",\"name\":\"Rivet Edgewest Low Back Modern Left U-Sectional Couch Sofa, 117&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester/linen blend fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left U-Sectional Couch Sofa, 117&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BWSXyZZ6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pkqh2ZHBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pkqh2ZHBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nsls60BqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nsls60BqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81esXZEJsFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81esXZEJsFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81l-bzgj9tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81l-bzgj9tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r1-SsLxdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-im