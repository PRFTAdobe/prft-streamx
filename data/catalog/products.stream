    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJCPTC\",\"sku\":\"B07BWJCPTC\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-sofa-bed-70-w-storm-grey-b07bwjcptc\",\"name\":\"Rivet Revolve Modern Upholstered Sofa Bed, 70&quot;W, Storm Grey\",\"description\":\"This modern sofa has enough classic elements to blend with your existing style. Plus, clean lines, comfortable seating and durable fabric give this piece functionality as well as smart design. When it's getting late, this piece transforms into a convenient sofa bed. 36.6&quot;D x 69.7”W x 35.4&quot;H Solid wood frame and solid beech wood legs Contemporary, streamlined design This piece does double duty as a couch and a bed Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Sofa Bed, 70&quot;W, Storm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EVOxH3K6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wv33JtykL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wv33JtykL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hIe1hBjmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hIe1hBjmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oXh1HL6yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oXh1HL6yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qAmjLFm1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qAmjLFm1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tCq0dIP-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tCq0dIP-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VRjKtGz8L.jpg\",\"url\":\"ht