    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZWGR\",\"sku\":\"B07B4FZWGR\",\"lang\":\"en\",\"slug\":\"isabel-traditional-accent-chair-36-w-slate-grey-b07b4fzwgr\",\"name\":\"Isabel Traditional Accent Chair, 36&quot;W, Slate Grey\",\"description\":\"With performance fabric that resists stains along with wear and tear, this handsome chair is ready for guests, pets and an active family. Its clean, streamlined design blends with most any style room. A matching storage ottoman is sold separately. 35.8&quot;W x 35.4&quot;D x 37.4&quot;H Performance fabric on wood frame Streamlined design fits a modern or transitional room Comfortable seating with a classic style Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Accent Chair, 36&quot;W, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NB5aPxALL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9157V1ozcaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9157V1ozcaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1INljRAeJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1INljRAeJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913CZRrZyhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913CZRrZyhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917V-snetDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917V-snetDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"nam