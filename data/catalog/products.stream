    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MSPD2\",\"sku\":\"B07B4MSPD2\",\"lang\":\"en\",\"slug\":\"andover-modern-sofa-couch-78-w-light-blue-b07b4mspd2\",\"name\":\"Andover Modern Sofa Couch, 78&quot;W, Light Blue\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 78&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; choose the configuration thats right for you Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Sofa Couch, 78&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uYWv-Zj7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BsRAr1oyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BsRAr1oyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y-jy1sgpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y-jy1sgpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JXCy0l4+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JXCy0l4+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q9iC1pJIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q9iC1pJIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17eX0h9oJL.jpg\",\"url\":\"https://storage.googleapis