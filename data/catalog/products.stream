    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X52BH4\",\"sku\":\"B075X52BH4\",\"lang\":\"en\",\"slug\":\"leila-tufted-living-room-sofa-couch-88-w-pewter-b075x52bh4\",\"name\":\"Leila Tufted Living Room Sofa Couch, 88&quot;W, Pewter\",\"description\":\"This item is made to order just for you 88&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look sofa. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Three removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Living Room Sofa Couch, 88&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H9qyYN57L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cEvVraiqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cEvVraiqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bWajB2SrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bWajB2SrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19sYUppwCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19sYUppwCL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"165.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"88&quot; sofa\",\"label\":\"88&quot; sofa\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Pewter\",\"label\":\"Pewter\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Grey\",\"label\":\"Grey\"}]}],\"categories\":[{\"id\":\"Accent Furniture\",\"slug\":\"accent-furniture\",\"name\":\"Accent Furniture\",\"value\":\"Accent Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":230,\"discountedValue\":207.0}}"
