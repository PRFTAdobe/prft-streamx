      "content": {
        "bytes": "{\"id\":\"B073G6GTKL\",\"sku\":\"B073G6GTKL\",\"lang\":\"en\",\"slug\":\"modern-sweeping-arm-accent-chair-28-w-emerald-b073g6gtkl\",\"name\":\"Modern Sweeping Arm Accent Chair, 28&quot;W, Emerald\",\"description\":\"This graceful chair will make a pleasing addition to any style of room. A soft sweep of the arms and clean lines make it modern, but the beautiful woven fabric and turned wood legs with espresso-colored stain give it a classic look as well. 28”W x 29”D x 34”H Solid pine with polyester fabric Modern with classic touches Will blend with classic and transitional style rooms 4 easy-to-attach legs Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Sweeping Arm Accent Chair, 28&quot;W, Emerald\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pQlH33yML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qu7KdrAgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qu7KdrAgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xs-OFA66L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xs-OFA66L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PA5kIRjUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PA5kIRjUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMeD9PHQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMeD9PHQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B135Rio4bwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B135Rio4bwS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28.0\",\"lab