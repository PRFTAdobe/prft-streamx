    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N3J5\",\"sku\":\"B075X4N3J5\",\"lang\":\"en\",\"slug\":\"rivet-villain-mid-century-modern-leather-metal-leg-accent-lounge-chair-37-4-w-black-b075x4n3j5\",\"name\":\"Rivet Villain Mid-Century Modern Leather Metal Leg Accent Lounge Chair, 37.4&quot;W, Black\",\"description\":\"Sturdy hardwood frame with soft leather and steel. Sturdy construction and padded foam seat cushion. No assembly required. Vacuum or wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty. Lounge in complete comfort in this mid-century inspired oversized accent chair. The 100% leather upholstery has a unique pleated back. An exposed black metal frame and legs exude a bold design with hints of modern and industrial style. 37.4&quot;W x 32.7”D x 37”H. Seat height is 16.9&quot;.\",\"primaryImage\":{\"alt\":\"Rivet Villain Mid-Century Modern Leather Metal Leg Accent Lounge Chair, 37.4&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m+3JIkekL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pa-jWYG-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pa-jWYG-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A3zstAgaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A3zstAgaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R4r2d8kRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R4r2d8kRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12-jP7BxnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12-jP7BxnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813V-tnC5FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813V-tnC5FL.jpg\"}],\"attributes\":[{\"name\":\"height