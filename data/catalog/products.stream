    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GVNLN\",\"sku\":\"B07B4GVNLN\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-grey-linen-b07b4gvnln\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Grey Linen\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 31&quot;W x 23&quot;D x 20&quot;H; Seat Height: 20&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 20&quot;H; Leg Height: 5.25&quot;H Durable polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LyxuXRdeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qO6O9uXWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qO6O9uXWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17RJ5GQNmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17RJ5GQNmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X1pSO3nrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X1pSO3nrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cgB8UYqJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cgB8UYqJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uVZkKJTeL.jpg\",\"url\":\"https://storage.googleapis.com/p