    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XXTDX\",\"sku\":\"B0831XXTDX\",\"lang\":\"en\",\"slug\":\"rosemont-vintage-tufted-sofa-couch-with-nailheads-88-w-cream-b0831xxtdx\",\"name\":\"Rosemont Vintage Tufted Sofa Couch with Nailheads, 88&quot;W, Cream\",\"description\":\"This elegant cream-colored sofa with tufted back and foam-padded cushions is a stylish, comfortable addition to your living room. Sloping arms and nailhead detailing bring a distinctive flair to any interior. The durable performance upholstery is both attractive and easy to clean. 88&quot;W x 36&quot;D x 33.5&quot;H; seat height: 20&quot;H; seat depth: 24&quot;D; seat back height: 33.5&quot;H; arm height: 27.5&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rosemont Vintage Tufted Sofa Couch with Nailheads, 88&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ND4d18I+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NdxU+L6bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NdxU+L6bL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oTWNtiYrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oTWNtiYrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XInpdZhiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XInpdZhiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CL2GusseL.jpg\",\"url\":\"https://storage.googleapis.co