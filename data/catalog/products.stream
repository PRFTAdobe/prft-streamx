    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VL4TRV\",\"sku\":\"B082VL4TRV\",\"lang\":\"en\",\"slug\":\"westview-extra-deep-down-filled-accent-chair-43-3-w-smoke-b082vl4trv\",\"name\":\"Westview Extra Deep Down-Filled Accent Chair, 43.3&quot;W, Smoke\",\"description\":\"This accent chair, with its deep cushions and its sturdy frame, will help you add maximum comfort and style to any living space in your home. Never believe that you have to sacrifice comfort for style, for this chair has it both in spades. 43.3&quot;W x 42.1&quot;D x 31.5&quot;H Solid wood frame and block legs with durable 100% polyester fabric upholstery, heavy-duty webbing, and down-filled cushions Seat and back cushions are filled with luxurious down. Assemble in 15 minutes or less To clean, avoid moisture and wipe down with a clean, soft cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Westview Extra Deep Down-Filled Accent Chair, 43.3&quot;W, Smoke\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YGblVcqZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m08+HRUuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m08+HRUuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VqPtvG4gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VqPtvG4gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lnCpIky6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lnCpIky6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zujp5iGhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zujp5iGhL.jpg\"},{\"alt\":\"h