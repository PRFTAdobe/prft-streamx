    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3WY\",\"sku\":\"B075X4F3WY\",\"lang\":\"en\",\"slug\":\"rivet-lawson-mid-century-modern-angled-leather-arm-chair-33-w-saddle-brown-b075x4f3wy\",\"name\":\"Rivet Lawson Mid-Century Modern Angled Leather Arm Chair, 33&quot;W, Saddle Brown\",\"description\":\"This item is made to order just for you 33&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Tight, padded back with a removable seat cushion makes it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling up with a good book on this sophisticated chair. A sleek back, angled arms, a removable seat cushion and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Mid-Century Modern Angled Leather Arm Chair, 33&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QwqCAWQLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Im8oUrVQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Im8oUrVQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gLZyqzX6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gLZyqzX6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GxxAEE--L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GxxAEE--L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"59.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Reclining sofa\",\"label\":\"Reclining sofa\"},{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Saddle brown\",\"label\":\"Saddle brown\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Outdoor sofa\",\"label\":\"Outdoor sofa\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Leather sofa\",\"label\":\"Leather sofa\"},{\"value\":\"Contemporary sofa\",\"label\":\"Contemporary sofa\"},{\"value\":\"Patio sofa\",\"label\":\"Patio sofa\"},{\"value\":\"Futon sofa\",\"label\":\"Futon sofa\"},{\"value\":\"Mid century sofa\",\"label\":\"Mid century sofa\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Glider rocker\",\"label\":\"Glider rocker\"},{\"value\":\"Sofa bedsofa cover\",\"label\":\"Sofa bedsofa cover\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Couch covers for sofa\",\"label\":\"Couch covers for sofa\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Full size bed frame\",\"label\":\"Full size bed frame\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Sofa tables\",\"label\":\"Sofa tables\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Sofa table\",\"label\":\"Sofa table\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories