        "bytes": "{\"id\":\"B07QGWLBBC\",\"sku\":\"B07QGWLBBC\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-curved-channel-back-dining-chair-35-h-forest-b07qgwlbbc\",\"name\":\"Rivet Contemporary Curved Channel-Back Dining Chair, 35&quot;H, Forest\",\"description\":\"The curved back of this dining chair provides support, while the channel design creates a textured look that will enhance the decor of many dining spaces. Forest-green upholstery fits any number of design themes, and durable fabric means easy care. A solid wood frame creates a stable seat. 23&quot;W x 25&quot;D x 35&quot;H; seat height: 19&quot;H; seat depth: 18&quot;D; seat back height: 16&quot;H 100% polyester fabric on solid wood frame Curved back with outside channel design No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Curved Channel-Back Dining Chair, 35&quot;H, Forest\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oIV5pkH3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IcJmNGN0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IcJmNGN0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BQ2dSgxjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BQ2dSgxjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-2APzrt2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-2APzrt2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I9FXbsuDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I9FXbsuDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vrxXK6YDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vrxXK6YDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.04\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"25.2\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"22.83\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"17.16\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Industrial\",\"label\":\"Industrial\"},{\"value\":\"Ladderback\",\"label\":\"Ladderback\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Lucite\",\"label\":\"Lucite\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Glam\",\"label\":\"Glam\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Bistro\",\"label\":\"Bistro\"},{\"value\":\"Outdoor\",\"label\":\"Outdoor\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Folding\",\"label\":\"Folding\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Legs\",\"label\":\"Legs\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Waiting\",\"label\":\"Waiting\"},{\"value\":\"Leg\",\"label\":\"Leg\"},{\"value\":\"Galvanized\",\"label\":\"Galvanized\"},{\"value\":\"2\",\"label\":\"2\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Tolix\",\"label\":\"Tolix\"},{\"value\":\"4\",\"label\":\"4\"},{\"value\":\"Kitchen\",\"label\":\"Kitchen\"},{\"value\":\"Teens\",\"label\":\"Teens\"},{\"value\":\"Ghost\",\"label\":\"Ghost\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"