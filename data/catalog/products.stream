    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZVP6Z\",\"sku\":\"B07PBZVP6Z\",\"lang\":\"en\",\"slug\":\"kristin-mid-century-wood-framed-sleeper-sofa-76-w-navy-b07pbzvp6z\",\"name\":\"Kristin Mid-Century Wood-Framed Sleeper Sofa, 76&quot;W, Navy\",\"description\":\"This sofa’s foam-padded cushions sit loosely on the hardwood frame, making them easy to remove and creating a casual look that gives any space a welcoming and comfortable appearance. Performance fabrics and reversible seat cushions make this sofa easy to maintain. 76&quot;W x 37&quot;D x 37.5&quot;H Performance fabric over padded solid-wood frame with mortise-and-tenon construction; poly-Dacron foam filling Loose back and seat cushions are removable and reversible, ensuring durability and comfort. Sofa easily opens to provide extra sleeping space. Sewn-in detailing along front provides texture. No assembly required Quickly blot spills with a damp cloth. Use a soft, dry cloth for routine care. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Mid-Century Wood-Framed Sleeper Sofa, 76&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812EzAwXqcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715H9v1J2OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715H9v1J2OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qvwV7o-mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qvwV7o-mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mgXqWaDaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mgXqWaDaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+jOm-yJKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+jOm-yJKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima