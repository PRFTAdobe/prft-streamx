    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC1FXK4\",\"sku\":\"B07PC1FXK4\",\"lang\":\"en\",\"slug\":\"rivet-cove-modern-tufted-loveseat-with-tapered-legs-mid-century-56-w-denim-b07pc1fxk4\",\"name\":\"Rivet Cove Modern Tufted Loveseat with Tapered Legs, Mid-Century, 56&quot;W, Denim\",\"description\":\"This modern loveseat comes with tufted back and seat cushions atop tall tapered legs. The design offers simple lines that fit well with most decors, and the solid wood frame give this beautiful piece a sense of solidity and timelessness. 32.7&quot;W x 33.9&quot;D x 35.4&quot;H Solid wood frame and legs; 100% polyester upholstery Add style when you add extra seating with this gorgeous modern loveseat. Tufting on the seat and back cushions adds elegance to this modern loveseat. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cove Modern Tufted Loveseat with Tapered Legs, Mid-Century, 56&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913TAQJ4Y1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Sg8X9RAvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Sg8X9RAvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VZonCMywL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VZonCMywL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t8iUirNsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t8iUirNsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dban01FQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dban01FQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WTHwN0e3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag