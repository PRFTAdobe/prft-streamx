    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWKD3BG\",\"sku\":\"B07BWKD3BG\",\"lang\":\"en\",\"slug\":\"dalton-chaise-sectional-sofa-couch-91-5-stone-b07bwkd3bg\",\"name\":\"Dalton Chaise Sectional Sofa Couch, 91.5&quot;, Stone\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this sectional sofa. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 91.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Chaise Sectional Sofa Couch, 91.5&quot;, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aZH27kkCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZhbbpMoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZhbbpMoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pjjoojtnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pjjoojtnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rIn8PpgrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rIn8PpgrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RxhicxTBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RxhicxTBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zy2-n8aRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zy2-n8aRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CqKHVuJkL.jpg\",\"url\":\"https://storage.googleapis.com/p