      "content": {
        "bytes": "{\"id\":\"B073G856G3\",\"sku\":\"B073G856G3\",\"lang\":\"en\",\"slug\":\"truve-modern-studded-ottoman-19-w-merlot-b073g856g3\",\"name\":\"Truve Modern Studded Ottoman, 19&quot;W, Merlot\",\"description\":\"This beautifully styled ottoman also serves as extra storage space. Its unique curved edges, covered in linen/viscose fabric and accentuated with brass nail-head trim, bring character and class to any room. 19&quot;W x 17&quot;D x 19&quot;H Strong wood frame with linen/viscose upholstery Casual and functional Provides stylish storage No assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Truve Modern Studded Ottoman, 19&quot;W, Merlot\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EBmAez+-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Yk94RRRVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Yk94RRRVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yz0eKFZkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yz0eKFZkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ddmLKnUVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ddmLKnUVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1t8CrvCqQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1t8CrvCqQS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZwHTi3gYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZwHTi3gYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Le