    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMN19P\",\"sku\":\"B075YMN19P\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-bar-stool-41-h-canary-b075ymn19p\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Canary\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x41&quot;H | Seat height is 30&quot;. Polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. This barstool's substantial arms, back and padded seat, and swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a Mid-century style statement piece in your home. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Canary\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m27CgnJML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qskpHxoTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qskpHxoTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fFpWm2GrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fFpWm2GrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fhpUQmH8S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fhpUQmH8S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14uPJBD-7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14uPJBD-7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13deFAbwWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13deFAbwWL.jpg\"}],\"attributes\":[{\"name\":\"