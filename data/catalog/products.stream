        "bytes": "{\"id\":\"B072635G2P\",\"sku\":\"B072635G2P\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-sofa-couch-97-w-grey-tweed-b072635g2p\",\"name\":\"Hoffman Down-Filled Performance Fabric Sofa Couch, 97&quot;W, Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 97”W x 39.5”D x 37”H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Sofa Couch, 97&quot;W, Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aKwejLVuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A8zsQnilL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A8zsQnilL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12sfsTMuuS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12sfsTMuuS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-1sNJutqS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-1sNJutqS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912dO8uCZhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912dO8uCZhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QNx-ek8YS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QNx-ek8YS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name