    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086VZ3N1Q\",\"sku\":\"B086VZ3N1Q\",\"lang\":\"en\",\"slug\":\"cherrie-upholstered-gliding-swivel-chair-34-w-butterscotch-b086vz3n1q\",\"name\":\"Cherrie Upholstered Gliding Swivel Chair, 34&quot;W, Butterscotch\",\"description\":\"This plush upholstered swivel chair is the perfect addition to any living space. The smooth gliding function and rounded sides and back mean this chair exudes easy comfort. Butterscotch upholstery provides durability and easy cleaning. The seat cushion is reversible for longer wear. This item is made to order just for you 34&quot;W x 36&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 20&quot;D; back height: 33&quot;H Sturdy wood frame with polyester upholstery Smooth swivel gliding function makes this chair more versatile. Seat cushion is removable and reversible. No assembly required Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cherrie Upholstered Gliding Swivel Chair, 34&quot;W, Butterscotch\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EIR3t1eqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EZ04CbFkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EZ04CbFkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pLHNatAHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pLHNatAHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CDNojsm5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CDNojsm5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-WEE-0aCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-WEE-0aCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91es9zJa-PL.jpg\",\