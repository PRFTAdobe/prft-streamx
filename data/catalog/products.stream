    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082Q8W9ZQ\",\"sku\":\"B082Q8W9ZQ\",\"lang\":\"en\",\"slug\":\"cedar-upholstered-ottoman-with-nailheads-32-w-midnight-gray-b082q8w9zq\",\"name\":\"Cedar Upholstered Ottoman with Nailheads, 32&quot;W, Midnight Gray\",\"description\":\"This gray upholstered ottoman brings a stylish charm to any room. A durable fabric-covered foam cushion provides lasting comfort, and the rustic nailhead trim enhances any decor. This will be your favorite place to put your feet up and relax. This item is made to order just for you. Overall: 32&quot;W x 22&quot;D x 18&quot;H; leg height: 2.75&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam cushion Removable and reversible cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cedar Upholstered Ottoman with Nailheads, 32&quot;W, Midnight Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W8keu6R4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nvBowxEkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nvBowxEkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814k4LWzDhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814k4LWzDhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LbjCR4j5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LbjCR4j5L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"32.0\",\"label\":\"