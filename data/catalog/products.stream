    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084L7SNDG\",\"sku\":\"B084L7SNDG\",\"lang\":\"en\",\"slug\":\"solid-pine-rustic-farmhouse-end-table-22-w-rustic-oak-b084l7sndg\",\"name\":\"Solid Pine Rustic Farmhouse End Table, 22&quot;W, Rustic Oak\",\"description\":\"This simply constructed side table is the perfect complement to your rustic or farmhouse decor, but its pale wood finish makes it versatile enough for any design scheme. The hollow structure provides extra storage. Durable pine construction will help keep your items secure. 22&quot;W x 22&quot;D x 24&quot;H Solid pine construction The simple design features a hollowed-out frame with a wide bottom, perfect for keeping small items both conveniently located and neatly stored. Use this piece as the perfect finishing touch for your farmhouse decor or to add a rustic touch to your existing design scheme. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Solid Pine Rustic Farmhouse End Table, 22&quot;W, Rustic Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IfJJCt0HL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dSLGrJi8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dSLGrJi8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812xjeckslL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812xjeckslL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mP3MonZgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mP3MonZgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rp9fsp7mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rp9fsp7mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9