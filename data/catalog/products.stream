    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QK52FF\",\"sku\":\"B075QK52FF\",\"lang\":\"en\",\"slug\":\"delano-nailhead-trim-king-headboard-63-25-h-mist-blue-b075qk52ff\",\"name\":\"Delano Nailhead Trim King Headboard, 63.25&quot;H, Mist Blue\",\"description\":\"This headboard will make your bedroom a truly restful retreat. Performance fabric is durable and easy to clean, while ample padding makes it comfy to lean against while enjoying a good book. Nickel-finished nailhead trim borders the graceful curves. 80.5&quot;W x 3.5&quot;D x 63.25&quot;H Polyester fabric. Hardwood frame and legs. Metal nailheads. A modern style with classic linen fabric and simple lines to blend with any decor Polyester performance fabric is durable, easy to clean. Adjusts to 3 different heights. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Delano Nailhead Trim King Headboard, 63.25&quot;H, Mist Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xq-EeTJPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptOy0DAqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptOy0DAqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14mTVJjrMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14mTVJjrMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uBT7jmwGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uBT7jmwGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9158J-hlIYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9158J-hlIYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eOkNbkw6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-image