    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STD4T\",\"sku\":\"B07P8STD4T\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-loveseat-sofa-couch-78-7-w-pepper-b07p8std4t\",\"name\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Pepper\",\"description\":\"This attractive loveseat has the low button-tufted back, scroll arms, and short legs that are the hallmark of the classic chesterfield style. Whether as a statement piece or part of a living-room suite, this loveseat will be a welcome addition to any decor. Dimensions: 79&quot;W x 39&quot;D x 30&quot;H Solid hardwood frame; upholstery: 98% polyester, 2% nylon Removable and reversible seat cushions A classic style updated in stain-resistant fabric makes this perfect for the modern home. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Pepper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SAo8UiJDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YW9VArErL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YW9VArErL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jYT7TwzOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jYT7TwzOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715jQv6K+LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715jQv6K+LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kp1XTogNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kp1XTogNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IEdupIhRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I