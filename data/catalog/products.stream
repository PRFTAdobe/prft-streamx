    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5ZTZC\",\"sku\":\"B07HZ5ZTZC\",\"lang\":\"en\",\"slug\":\"fischer-full-sized-sleeper-sofa-72-w-blue-fabric-b07hz5ztzc\",\"name\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Blue Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this full-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 72&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and rich color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Blue Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qhexVORtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnYsueUOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnYsueUOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L0rhmKvrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L0rhmKvrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VKpEgMeNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VKpEgMeNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V9qKqqtxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V9qKqqtxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rDNGcMuVS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rDNGcMuVS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814gymBaXpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814gymBaXpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"74.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"203.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Facing\",\"label\":\"Facing\"},{\"value\":\"Chaise\",\"label\":\"Chaise\"},{\"value\":\"Sala\",\"label\":\"Sala\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"L\",\"label\":\"L\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Cheap\",\"label\":\"Cheap\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Corner\",\"label\":\"Corner\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Grey\",\"label\":\"Grey\"},{\"value\":\"Sized\",\"label\":\"Sized\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Sillones\",\"label\":\"Sillones\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Smith\",\"label\":\"Smith\"},{\"value\":\"Buy\",\"label\":\"Buy\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"val