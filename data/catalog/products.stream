    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DL32H\",\"sku\":\"B07B7DL32H\",\"lang\":\"en\",\"slug\":\"rustic-casual-wood-bookcase-with-doors-36-w-grey-b07b7dl32h\",\"name\":\"Rustic Casual Wood Bookcase with Doors, 36&quot;W, Grey\",\"description\":\"This handsome apothecary-style chest has endless possibilities. Use for displaying and storing glasses and china in a dining room, or as a book case in a living space or office. The distressed grey oak finish gives it a rustic casual style. 14&quot;L x 36&quot;W x 74&quot;H Wood composites; oak wood veneer; metal cabinet door knobs Ideal for a modern farmhouse décor, but will blend with most styles Two doors conceal a storage area, while 6 open shelves give you plenty of display space No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rustic Casual Wood Bookcase with Doors, 36&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K58monaJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L8HICRrVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L8HICRrVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cfnw5JJ6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cfnw5JJ6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MBQMuKEgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MBQMuKEgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iu9gg8MiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iu9gg8MiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916H7zbHEnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916H7zbHEnL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":