    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BGXN9\",\"sku\":\"B07B7BGXN9\",\"lang\":\"en\",\"slug\":\"alejandra-casual-wood-dining-kitchen-table-78-98-l-brown-b07b7bgxn9\",\"name\":\"Alejandra Casual Wood Dining Kitchen Table, 78&quot;-98&quot;L, Brown\",\"description\":\"This gorgeous farmhouse-style table with its rich butterscotch finish will fit perfectly in a casual kitchen or dining room. A leaf lets you expand up to 98 inches long so you can gather more friends and family for delicious home cooked meals. 42&quot;L x 78-98&quot;W x 30&quot;H Sturdy construction of durable hardwoods; veneer top Classic features help this piece fit with traditional and farmhouse décor. Along with functionality, it provides a clean, timeless style Assembly in 30 minutes or less; bolt base to table top Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alejandra Casual Wood Dining Kitchen Table, 78&quot;-98&quot;L, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81isy+Z6wwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ydBNC1KmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ydBNC1KmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aMLtvujEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aMLtvujEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cr+c65BBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cr+c65BBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18YyDk+lyS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18YyDk+lyS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RkpfXpJiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RkpfXpJiL.jpg\"}],\"attributes\":[{\"name\":\"he