    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQ4LN\",\"sku\":\"B07QBMQ4LN\",\"lang\":\"en\",\"slug\":\"abigail-leather-sofa-86-w-dark-brown-b07qbmq4ln\",\"name\":\"Abigail Leather Sofa, 86&quot;W, Dark Brown\",\"description\":\"Comfort meets class in this attractive transitional-style sofa. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this sofa. 86&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The removable seat and back cushions ensure durability and comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Leather Sofa, 86&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718nYVMuVgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Rmp4mkZCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Rmp4mkZCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910gs-4ioBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910gs-4ioBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g6hMAXhSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g6hMAXhSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bwlSPksqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bwlSPksqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10-3HeWB6L.jpg\",\"url\":\"https://storage.googleapis.com/