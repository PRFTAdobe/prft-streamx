    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP336C\",\"sku\":\"B075YP336C\",\"lang\":\"en\",\"slug\":\"rivet-rachel-set-of-2-space-age-mid-century-modern-swivel-dining-room-kitchen-desk-chairs-35-2-inch-height-synthetic-leather-light-brown-b075yp336c\",\"name\":\"Rivet Rachel Set of 2 Space-Age Mid-Century Modern Swivel Dining Room Kitchen Desk Chairs, 35.2 Inch Height, Synthetic Leather, Light Brown\",\"description\":\"With a look straight out of The Jetsons TV show, these chairs exude the mid-century space-age era. Enjoy swiveling 360 degrees at the dining room table or in the living room. Geometric stitching and legs in a starburst shape add to the fun style. 22.9&quot;W x 20.1&quot;D x 35.2&quot;H. Seat height is 19.7&quot;. Distressed synthetic leather on wood frame; metal legs with black finish Chairs swivel; Light enough to move from room to room for multi-tasking. Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Rachel Set of 2 Space-Age Mid-Century Modern Swivel Dining Room Kitchen Desk Chairs, 35.2 Inch Height, Synthetic Leather, Light Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z7-rIWXDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zT+lQApSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zT+lQApSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19q2x6luYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19q2x6luYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10cp-lxpbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10cp-lxpbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81u6BEn4AXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81u6BEn4AXL.jpg\"},{\"