    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0854SBC3F\",\"sku\":\"B0854SBC3F\",\"lang\":\"en\",\"slug\":\"rivet-coen-contemporary-modern-upholstered-accent-swivel-chair-30-w-velvet-ink-b0854sbc3f\",\"name\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Velvet Ink\",\"description\":\"Add the finishing touch to your home decor with this contemporary-style accent chair. Its unique design and beautiful fabric adds design interest to any room, and the swivel feature ensures it's as comfortable as it is stylish. Overall: 30&quot;W x 31&quot;D x 28&quot;H; seat height: 16.93&quot;H; seat depth: 22.83&quot;D; seat back height: 28&quot;H; arm height: 25.19&quot;H Solid-wood frame with swivel mechanism. Fabric upholstery over foam cushioning. Clean-cut contemporary style complements modern, minimal, and urban-modern home decor. No assembly required. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Velvet Ink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UvJjm7PvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714SQMeYj6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714SQMeYj6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yab68+XcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yab68+XcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yv56VRZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yv56VRZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714FjlAFHjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714FjlAFHjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XgVLp7dyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XgVLp7dyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ndg+mOflL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ndg+mOflL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RJ4Kk3QrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RJ4Kk3QrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711yndPueML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711yndPueML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e-8GzlFEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e-8GzlFEL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"28.35\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.1\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"29.53\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"55.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Oversized\",\"label\":\"Oversized\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Living\",\"label\":\"Livi