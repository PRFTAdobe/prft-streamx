    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8HJY\",\"sku\":\"B0723H8HJY\",\"lang\":\"en\",\"slug\":\"kristin-performance-fabric-sectional-sofa-couch-93-w-stone-b0723h8hjy\",\"name\":\"Kristin Performance Fabric Sectional Sofa Couch, 93&quot;W, Stone\",\"description\":\"This inviting sectional sofa will be the center of many get-togethers with family and friends. With a classic round-armed style and durable build, no one will be able to resist sitting down and relaxing in all-out comfort. 93&quot;W x 37&quot;D x 37.5&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Modern casual Classic style designed for heavy-duty use Minimal assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Performance Fabric Sectional Sofa Couch, 93&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818o3AdG5UL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1WIMEiVBHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1WIMEiVBHS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x7c19A+zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x7c19A+zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OvjCxYnHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OvjCxYnHL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"93.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"138.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\