    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MKCLM\",\"sku\":\"B07B4MKCLM\",\"lang\":\"en\",\"slug\":\"isabel-traditional-large-storage-ottoman-68-w-tan-b07b4mkclm\",\"name\":\"Isabel Traditional Large Storage Ottoman, 68&quot;W, Tan\",\"description\":\"67.7&quot;W x 29.5&quot;D x 18.9&quot;H Polyester performance fabric on wood frame Streamlined design fits a modern or transitional room Use as an ottoman, for storage, or as an extra seat. Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty. This ottoman is a multi-tasker, providing a comfy foot rest along with storage space. It can accommodate a tray of snacks or be an extra seat for guests, too. Built to last, its performance fabric will resist stains along with wear and tear.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Large Storage Ottoman, 68&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iA7Ozl8cL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wh4S8QiRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wh4S8QiRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ycBN9U8lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ycBN9U8lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KmasxN4XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KmasxN4XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o36Ab1n8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o36Ab1n8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.75\",\"label\