    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMSQ7D\",\"sku\":\"B07BWMSQ7D\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-u-sectional-117-w-charcoal-grey-b07bwmsq7d\",\"name\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Charcoal Grey\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cT1oEAcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+2O3RUQkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+2O3RUQkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wjB0rK7zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wjB0rK7zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y9l0rF13S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y9l0rF13S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A-D-lEUEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A-D-lEUEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kAqtsfPkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k