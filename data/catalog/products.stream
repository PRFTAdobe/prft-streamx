    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N3QK\",\"sku\":\"B075X4N3QK\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-beige-b075x4n3qk\",\"name\":\"Marin Studded Chair, 33&quot;W, Beige\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XWDv6Yi8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wqQTQuHJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wqQTQuHJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VS8VxdEvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VS8VxdEvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QcGo47Q2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QcGo47Q2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DQp3USzZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DQp3USzZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\"