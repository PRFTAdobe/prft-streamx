    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YPTF9M\",\"sku\":\"B075YPTF9M\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-counter-height-stool-37-h-felt-grey-b075yptf9m\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Felt Grey\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x 37&quot;H | Seat height is 26&quot;. Durable polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. This counter stool's substantial arms, back and padded seat, and swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a Mid-century style statement piece in your home. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LZFdnJ9LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YIJEPiuAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YIJEPiuAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yxPLLSwpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yxPLLSwpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N14N5ITWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N14N5ITWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"va