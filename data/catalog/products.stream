    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B86VTVM\",\"sku\":\"B07B86VTVM\",\"lang\":\"en\",\"slug\":\"rivet-stevie-mid-century-modern-bar-stool-30-h-pack-of-2-blue-b07b86vtvm\",\"name\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Blue\",\"description\":\"These fun velvet stools will add a cheerful pop of color to any room. Flared modern metal legs are topped by velvet cushions for a plush, sturdy feel and a touch of glam. Move them around to any room where you need an extra seat. 15.75&quot;W x 15.75&quot;D x 30&quot;H Velvet fabric on hardwood frame and legs An update on mid-century modern style that can blend with many rooms Velvet adds comfort and a touch of glam No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NwqhCmxIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yk12q72cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yk12q72cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QW7E+iJsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QW7E+iJsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lE6ZB83BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lE6ZB83BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b58JbUTcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b58JbUTcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T6dgE30QL.jpg\",\"url\":\"https://