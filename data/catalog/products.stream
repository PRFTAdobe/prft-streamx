        "bytes": "{\"id\":\"B071W5VJ7S\",\"sku\":\"B071W5VJ7S\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-ottoman-41-w-grey-tweed-b071w5vj7s\",\"name\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot; W, Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this ottoman has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 27.5&quot;W x 40.5&quot;D x 18.5&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot; W, Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xtSv9rJoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w3Y0nj40S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w3Y0nj40S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vGCP1IiZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vGCP1IiZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15vbOLYFPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15vbOLYFPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iiBQi965L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iiBQi965L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IKNA+OCgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IKNA+OCgL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.5\",\"label\":\"inch