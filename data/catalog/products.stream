    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMJ25F\",\"sku\":\"B075YMJ25F\",\"lang\":\"en\",\"slug\":\"rivet-florence-mid-century-wide-open-back-accent-dining-room-chairs-18-8-w-hunter-green-set-of-2-b075ymj25f\",\"name\":\"Rivet Florence Mid-Century Wide Open-Back Accent Dining Room Chairs, 18.8&quot;W, Hunter Green, Set of 2\",\"description\":\"The unique shape of this Mid-century modern chair's open back give it a light, airy feel that works in a dining room, craft room, home office -- anywhere you need an extra seat. It's easy to move between rooms and up and down stairs. Hardwood upholstered with polyester fabric; black metal legs Ideal for any home needing furniture that multi-tasks. 2 chairs to a pack. Assembly in 15 minutes; attach base with 4 screws. Vaccuum, spot clean with damp cloth. Free returns for 30 days. 1-year warranty. 18.8&quot;W x 22.8&quot;D x 33.9&quot;H. 18.7&quot; Seat height\",\"primaryImage\":{\"alt\":\"Rivet Florence Mid-Century Wide Open-Back Accent Dining Room Chairs, 18.8&quot;W, Hunter Green, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-UVKNirRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mrrrXQyCS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mrrrXQyCS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kjuQ8aEBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kjuQ8aEBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f1YTTHDKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f1YTTHDKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91howgpphsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91howgpphsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X2VKL4tmL.jpg\",\"url\":\"https://