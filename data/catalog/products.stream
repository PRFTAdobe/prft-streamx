    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9WRNM\",\"sku\":\"B07QF9WRNM\",\"lang\":\"en\",\"slug\":\"garrett-rustic-acacia-wood-coffee-table-with-iron-legs-52-w-gray-and-raw-metal-b07qf9wrnm\",\"name\":\"Garrett Rustic Acacia-Wood Coffee Table with Iron Legs, 52&quot;W, Gray and Raw Metal\",\"description\":\"Constructed of acacia, this coffee table touts a beautiful rustic style with visual knots and cracks covered with a sheer gray finish. Each unique piece has a live-edge top that sits on an open metalwork base. This table complements rustic, farmhouse, and contemporary decor with ease. 52&quot;W x 26&quot;D x 14&quot;H Acacia and iron This rustic coffee table offers a natural beauty with a live-edge top that features knots and cracks, making each piece unique. A natural clear finish allows the beauty of the wood to shine through while protecting the surface. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Garrett Rustic Acacia-Wood Coffee Table with Iron Legs, 52&quot;W, Gray and Raw Metal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zv4RyVQUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913crQWbXcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913crQWbXcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Q-Z7xgleL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Q-Z7xgleL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9163VOF4rRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9163VOF4rRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bEkLD-IkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bEkLD-IkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi