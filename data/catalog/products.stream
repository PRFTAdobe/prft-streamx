    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P9Y5K2D\",\"sku\":\"B07P9Y5K2D\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-upholstered-ottoman-31-w-dove-b07p9y5k2d\",\"name\":\"Charles Classic Oversized Upholstered Ottoman, 31&quot;W, Dove\",\"description\":\"Let your tired feet sink into this generously plush ottoman. Traditional turned wood legs are combined with modern upholstery for a welcome update on a classic piece. 31&quot;W x 25&quot;D x 20&quot;H Solid hardwood frame; upholstery: 95% polyester, 5% nylon This ottoman doubles as a welcome place to rest tired feet or as extra seating. A traditional silhouette is paired with modern, stain-resistant fabric, making this the perfect addition to a busy home. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Upholstered Ottoman, 31&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712IkP7ca+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pqj5AQiBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pqj5AQiBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GcrbVsDiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GcrbVsDiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k0knYPKtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k0knYPKtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712rWBL6GVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712rWBL6GVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61xA1bUjlZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61xA1bUjlZL.jpg\"}],\"attributes\":[{\"name\"