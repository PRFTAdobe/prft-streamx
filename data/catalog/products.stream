    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5RM1D\",\"sku\":\"B07HZ5RM1D\",\"lang\":\"en\",\"slug\":\"blaine-modern-sofa-couch-79-5-w-light-grey-b07hz5rm1d\",\"name\":\"Blaine Modern Sofa Couch, 79.5&quot;W, Light Grey\",\"description\":\"Add mid-century elegance to your living room with this light-gray sofa. The solid-wood frame and polyester upholstery make this sofa both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 79.5&quot;W x 37.8&quot;D x 35&quot;H; Seat Height: 19.3&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 25.6&quot;H; Arm Height: 24.4&quot;H; Leg Height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Blaine Modern Sofa Couch, 79.5&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RDbO-2UvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QrfLGceIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QrfLGceIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iwMluRg4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iwMluRg4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jxetcRaBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jxetcRaBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XoyhxdmTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XoyhxdmTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1b8+SoMXMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1