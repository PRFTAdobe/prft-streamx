    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5NS\",\"sku\":\"B075X4F5NS\",\"lang\":\"en\",\"slug\":\"larkin-living-room-accent-swivel-chair-30-w-khaki-b075x4f5ns\",\"name\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Khaki\",\"description\":\"This elegant slipcover swivel accent chair in Khaki is made to order just for you. Upholstered in high-performance twill fabric that is comfortable and durable, its slender design makes it practical even in small spaces. Sturdy metal base, solid wood frame, durable performance fabric; no assembly required Swivel mechanism allows you to turn in any direction Care Instructions: Vacuum or lightly brush; spot clean with a damp cloth if needed Product Dimensions: 30&quot;W x 35&quot;D x 33&quot;H; seat height is 20&quot; Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Khaki\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HTFcynUML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AwNhWFn6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AwNhWFn6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1owoI-hOpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1owoI-hOpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vROgeFXmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vROgeFXmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zhyZr7laL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zhyZr7laL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MiJV1jJYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MiJV1jJYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\"