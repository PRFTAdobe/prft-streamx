    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LKL27\",\"sku\":\"B07P5LKL27\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-upholstered-ottoman-31-w-stone-b07p5lkl27\",\"name\":\"Charles Classic Oversized Upholstered Ottoman, 31&quot;W, Stone\",\"description\":\"Let your tired feet sink into this generously plush ottoman. Traditional turned wood legs are combined with modern upholstery for a welcome update on a classic piece. 31&quot;W x 25&quot;D x 20&quot;H Solid hardwood frame; upholstery: 95% polyester, 5% nylon This ottoman doubles as a welcome place to rest tired feet or as extra seating. A traditional silhouette is paired with modern, stain-resistant fabric, making this the perfect addition to a busy home. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Upholstered Ottoman, 31&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712QR3oEhtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ezslVmANL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ezslVmANL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PMcpXAYHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PMcpXAYHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oJpIbaDYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oJpIbaDYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x0S9IQYEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x0S9IQYEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SXWCJfhsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SXWCJfhsL.jpg\"}],\"attributes\":[{\"nam