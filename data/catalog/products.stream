    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK7FXW\",\"sku\":\"B07BWK7FXW\",\"lang\":\"en\",\"slug\":\"andover-leather-left-facing-sofa-chaise-sectional-126-w-saddle-brown-b07bwk7fxw\",\"name\":\"Andover Leather Left-Facing Sofa-Chaise Sectional, 126&quot;W, Saddle Brown\",\"description\":\"Complete your living space with this stylish sectional. With its saddle-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 126&quot;W x 61&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Left-Facing Sofa-Chaise Sectional, 126&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811SkmNtm7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hk0uUkIWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hk0uUkIWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sPY+gkmZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sPY+gkmZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B6Pfww-nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B6Pfww-nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nd4At-NgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nd4At-NgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/orig