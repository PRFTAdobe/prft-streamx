    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X467NG\",\"sku\":\"B075X467NG\",\"lang\":\"en\",\"slug\":\"rivet-garfield-mid-century-modern-top-grain-leather-recliner-chair-31-w-aged-black-b075x467ng\",\"name\":\"Rivet Garfield Mid-Century Modern Top-Grain Leather Recliner Chair, 31&quot;W, Aged Black\",\"description\":\"Not your average bulky recliner, this streamlined leather chair is as comfortable as it is classy.  It features top-grain leather on a brushed brass metal base with a cushiony down-filled seat and back that you can sink into at the end of a long day. 31&quot;W x 34.25&quot;D x 34''H Leather upholstery on hardwood frame with brushed brass finish base Modern, low-profile look in a super comfortable classic recliner Simple assembly in 15 minutes or less.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Garfield Mid-Century Modern Top-Grain Leather Recliner Chair, 31&quot;W, Aged Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dgep0OFeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VDxn1bdYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VDxn1bdYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DfxoPdsZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DfxoPdsZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14ZrCEjVUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14ZrCEjVUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qaw0ShO0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qaw0ShO0L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"3