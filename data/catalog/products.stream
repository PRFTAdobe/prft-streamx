    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8MJR2\",\"sku\":\"B07BW8MJR2\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-contemporary-modern-l-sectional-sofa-116-w-grey-linen-b07bw8mjr2\",\"name\":\"Rivet Edgewest Low Back Contemporary Modern L-Sectional Sofa, 116&quot;W, Grey Linen\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Contemporary Modern L-Sectional Sofa, 116&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BUAH6L2fL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19bl1iC0AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19bl1iC0AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+u39h+MsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+u39h+MsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X5ztCeVNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X5ztCeVNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PoKVK9mHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PoKVK9mHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1f+FX6CTQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/o