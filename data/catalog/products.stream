    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMDZKG\",\"sku\":\"B082VMDZKG\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-upholstered-livingroom-accent-chair-39-w-light-grey-b082vmdzkg\",\"name\":\"Rivet Alonzo Contemporary Upholstered Livingroom Accent Chair, 39&quot;W, Light Grey\",\"description\":\"Sleek, graceful lines combine with modern touches for a vesatile, elegant armchair. A solid-wood frame and strong brass legs offer durability and comfort that will stand the test of time. Overall: 39&quot;W x 37.8&quot;D x 35.4&quot;H. Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and fabric upholstery Reversible seat and back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Upholstered Livingroom Accent Chair, 39&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rFb4mxVsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rvuTrBkiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rvuTrBkiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NPkdw80fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NPkdw80fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NpVoobyxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NpVoobyxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C1K3heb8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C1K3heb8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JZAvEEXlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JZAvEEXlL.jpg\"},{\"alt