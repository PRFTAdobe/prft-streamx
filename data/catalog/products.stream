    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4J169\",\"sku\":\"B075X4J169\",\"lang\":\"en\",\"slug\":\"hillsboro-modern-wingback-living-room-accent-chair-with-nailhead-trim-29-w-beige-b075x4j169\",\"name\":\"Hillsboro Modern Wingback Living Room Accent Chair With Nailhead Trim, 29&quot;W, Beige\",\"description\":\"Streamlined, gently curving &quot;wings&quot; and arms give a refined, modern refresh to the mid-century wingback chair. Hand-applied nailhead trim with brass finish adds an air of sophistication, while the seat cushion is removable for easy cleaning. 29&quot;W x 37''D x 40.5''H Durable polyester fabric; metal nailhead trim with brass finish; wood legs. A modernized silhouette of the mid-century wingback style with removable seat cushion Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillsboro Modern Wingback Living Room Accent Chair With Nailhead Trim, 29&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h+4KtTceL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g-SGD-q-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g-SGD-q-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v4ybWUToL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v4ybWUToL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A137JwJwSSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A137JwJwSSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IS5JGTUqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IS5JGTUqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Re3TLUznL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Re3T