    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FW7H5\",\"sku\":\"B07B4FW7H5\",\"lang\":\"en\",\"slug\":\"andover-studio-sofa-couch-78-w-driftwood-leather-b07b4fw7h5\",\"name\":\"Andover Studio Sofa Couch, 78&quot;W, Driftwood Leather\",\"description\":\"Complete your living space with this stylish studio sofa. With its driftwood-colored upholstery, this sofa is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sofa’s life. Overall: 78&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Studio Sofa Couch, 78&quot;W, Driftwood Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717AylYIi0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GarCVtjuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GarCVtjuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71a-m+cwjjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71a-m+cwjjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YtuGzuhrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YtuGzuhrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713SLzOeGAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713SLzOeGAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ENxkktJYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ENxkktJYL.jpg\