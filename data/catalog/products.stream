    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MSP8F\",\"sku\":\"B07B4MSP8F\",\"lang\":\"en\",\"slug\":\"jameson-farmhouse-leather-recliner-36-w-charcoal-b07b4msp8f\",\"name\":\"Jameson Farmhouse Leather Recliner, 36&quot;W, Charcoal\",\"description\":\"Nailhead trim takes this recliner up a notch in style. Classic rolled arms and leather upholstery bring rustic sophistication to traditional or modern farmhouse-style rooms. The leather's natural markings make each chair distinctive. 36&quot;W x 37&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 39&quot;H; Arm Height: 25.25&quot;H; Front legs: 4.25&quot;H; Back legs: 3.125&quot;H Leather upholstery on hardwood pine frame Classic roll arms and rustic nailhead trim combine for ideal modern farmhouse style Push-back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Jameson Farmhouse Leather Recliner, 36&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VwyrXjDHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dadCFbV3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dadCFbV3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15UX8Dk-FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15UX8Dk-FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AkQUj55GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AkQUj55GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sBsjx7faL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sBsjx7faL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NhiS0oF3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NhiS0oF3L.jp