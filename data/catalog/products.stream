    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDSXL6\",\"sku\":\"B082QDSXL6\",\"lang\":\"en\",\"slug\":\"rivet-bigelow-modern-leather-chair-with-square-legs-44-1-w-cognac-b082qdsxl6\",\"name\":\"Rivet Bigelow Modern Leather Chair with Square Legs, 44.1&quot;W, Cognac\",\"description\":\"Add extra seating with a modern flair anywhere in your home with this chair. The cognac-leather upholstery and classic design will blend with any decor scheme. A sloped back cushion padded with foam provides support and comfort. Square legs and a frame of solid wood create a strong foundation. 44.1&quot;W x 37.4&quot;D x 30.7&quot;H; seat height: 18.1&quot;H; seat depth: 22.8&quot;D; seat back height: 18.1&quot;H; arm height: 24&quot;H; leg height: 5.9&quot;H Solid wood frame, plinth, and tapered legs; leather upholstery A sturdy, solid wood frame and soft, foam-padded cushions bring a mix of comfort and support to any seating area. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bigelow Modern Leather Chair with Square Legs, 44.1&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MFGklQhGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mV75MMCWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mV75MMCWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718aFd1EHiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718aFd1EHiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71J0xTD3sxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71J0xTD3sxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\