      "content": {
        "bytes": "{\"id\":\"B075Z93NKX\",\"sku\":\"B075Z93NKX\",\"lang\":\"en\",\"slug\":\"fern-hill-5-drawer-office-desk-32-w-white-and-natural-pine-b075z93nkx\",\"name\":\"Fern Hill 5-Drawer Office Desk, 32&quot;W, White and Natural Pine\",\"description\":\"32&quot;W x 18”D x 40”H Solid, recycled pine wood with natural imperfections, metal hardware Five drawers and two open storage spaces provide versatile storage Perfect for small spaces, this compact desk has a surprising amount of storage and loads of rustic charm. Crafted from reclaimed wood, it's finished in modern white and brown tones with natural variations to create a look of vintage authenticity. Assemble in 15 minutes or less. Dust with soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Fern Hill 5-Drawer Office Desk, 32&quot;W, White and Natural Pine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TxNrMIOJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLiXbp43L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLiXbp43L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ELz8pse6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ELz8pse6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V18nzb23L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V18nzb23L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GjVpgloAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GjVpgloAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I-O5jPa5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I-O5jPa5L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"labe