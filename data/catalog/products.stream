    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4J15G\",\"sku\":\"B075X4J15G\",\"lang\":\"en\",\"slug\":\"rivet-eva-mid-century-modern-tufted-velvet-down-filled-accent-chair-33-5-w-dark-grey-b075x4j15g\",\"name\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Accent Chair, 33.5&quot;W, Dark Grey\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted loveseat featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible, and is held in place by clips at the corners. 33.5&quot;W x 35.25''D x 30.25''H 100% cotton velvet upholstery on hardwood frame and chrome legs Modern elegant style with reversible cushion to extend the life of the piece Simple assembly in 15 minutes or less.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Accent Chair, 33.5&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bSRaFDcLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bpj3TdOhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bpj3TdOhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+ZoC2HeWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+ZoC2HeWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RM55uiXCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RM55uiXCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CxKKgmpyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CxKKgmpyL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":