        "bytes": "{\"id\":\"B07263589M\",\"sku\":\"B07263589M\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-loveseat-sofa-couch-78-7-w-navy-b07263589m\",\"name\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Navy\",\"description\":\"An updated twist on a classic Chesterfield, this handsome tufted sofa is as comfortable as it is eye-catching. Its sturdy design and high performance upholstery will bring enduring style and durability to your home. Dimensions: 78.7''W x 39”D x 30.3”H Solid and engineered hardwoods; polyester/nylon fabric Timeless and functional Refreshed design of a classic; extra wide seating capacity Minimal assembly; just attach legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L2YGHhXfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8148MTGlfKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8148MTGlfKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CBZLExVFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CBZLExVFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fbdW7ufWS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fbdW7ufWS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18ET0HEBpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18ET0HEBpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.31496\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.97638\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"78.74016\",\"label\":\"inches\"}