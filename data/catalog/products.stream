    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0719WQH8N\",\"sku\":\"B0719WQH8N\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-sofa-with-tufted-back-64-2-w-pebble-b0719wqh8n\",\"name\":\"Rivet Sloane Mid-Century Modern Sofa with Tufted Back, 64.2&quot;W, Pebble\",\"description\":\"Impress your friends with this mid-century modern style. The u-shaped, curved silhouette of this sofa, accented by hand tufting and buttons on the back pillow, will look smart in your living room. 64.2”W x 35.8&quot;D x 33.1'H Hardwood frame with solid beech wood legs Mid-century modern An attractive, practical piece to brighten up any space Simple assembly; just attach legs and back Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Sofa with Tufted Back, 64.2&quot;W, Pebble\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VMNtOVYpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u-LaKujvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u-LaKujvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1cp7h9md4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1cp7h9md4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iOM0ni9lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iOM0ni9lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wnw+eAoBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wnw+eAoBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"64.2\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"lab