        "bytes": "{\"id\":\"B07TGVHKBK\",\"sku\":\"B07TGVHKBK\",\"lang\":\"en\",\"slug\":\"counter-height-modern-wood-barstool-set-of-2-brown-black-b07tgvhkbk\",\"name\":\"Counter-Height Modern Wood Barstool, Set of 2, Brown Black\",\"description\":\"Set of 2 counter-height bar stools with a sleek, modern design Solid wood frame construction with a rich brown-black finish fits in well with a variety of home decor aesthetics Foot rest, tapered legs, and subtly fanned back rest Smooth leather-look upholstery provides a contemporary look backed up by durability Comfortably padded back rest and seat cushion\",\"primaryImage\":{\"alt\":\"Counter-Height Modern Wood Barstool, Set of 2, Brown Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OnkGVhMWL.jpg\"},\"gallery\":[],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.58\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.72\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"14.57\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.25\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"24\",\"label\":\"24\"},{\"value\":\"Backs\",\"label\":\"Backs\"},{\"value\":\"American\",\"label\":\"American\"},{\"value\":\"Creeper\",\"label\":\"Creeper\"},{\"value\":\"Unfinished\",\"label\":\"Unfinished\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Tractor\",\"label\":\"Tractor\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Counter\",\"label\":\"Counter\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Inches\",\"label\":\"Inches\"},{\"value\":\"Outdoor\",\"label\":\"Outdoor\"},{\"value\":\"Cyclones\",\"label\":\"Cyclones\"},{\"value\":\"Height\",\"label\":\"Height\"},{\"value\":\"C