    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP3C53\",\"sku\":\"B075YP3C53\",\"lang\":\"en\",\"slug\":\"rivet-julian-minimalist-modern-tufted-dining-room-counter-height-bar-stools-set-of-2-34-3-inch-height-synthetic-leather-aqua-blue-b075yp3c53\",\"name\":\"Rivet Julian Minimalist Modern Tufted Dining Room Counter Height Bar Stools, Set of 2, 34.3 Inch Height, Synthetic Leather, Aqua Blue\",\"description\":\"Add a vibrant pop of color to your home with these fun counter stools. The low-back seats with channel tufting sit on tall metal legs. Combine with other colors or mix and match for a look that's sure to turn heads. 19.3&quot;W x 21&quot;D x 34.3&quot;H. Seat height is 25.2&quot;. Synthetic leather upholstery on hardwood frame; metal legs with grey finish Easy-care synthetic leather. Durable finish on legs. Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julian Minimalist Modern Tufted Dining Room Counter Height Bar Stools, Set of 2, 34.3 Inch Height, Synthetic Leather, Aqua Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tDegaK7zL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QsLnRZ8ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QsLnRZ8ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918WL8yG0JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918WL8yG0JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T94srtQsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T94srtQsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JJ5xTCcWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JJ5xTCcWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/