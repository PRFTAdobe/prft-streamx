    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GQ7MN\",\"sku\":\"B07B4GQ7MN\",\"lang\":\"en\",\"slug\":\"andover-modern-sofa-couch-78-w-grey-linen-b07b4gq7mn\",\"name\":\"Andover Modern Sofa Couch, 78&quot;W, Grey Linen\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 78&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Sofa Couch, 78&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hL5x-Hm9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7X1zHRfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7X1zHRfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E+KsawqmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E+KsawqmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-KHpbM+4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-KHpbM+4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Le1l82YsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Le1l82YsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KkuPja4ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresig