    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8JNN\",\"sku\":\"B0723H8JNN\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-loveseat-sofa-couch-78-7-w-hemp-b0723h8jnn\",\"name\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Hemp\",\"description\":\"An updated twist on a classic Chesterfield, this handsome tufted sofa is as comfortable as it is eye-catching. Its sturdy design and high performance upholstery will bring enduring style and durability to your home. Dimensions: 78.7''W x 39”D x 30.3”H Solid and engineered hardwoods; polyester/nylon fabric Timeless and functional Refreshed design of a classic; extra wide seating capacity Minimal assembly; just attach legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Af2N7XoiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yZOTVWdTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yZOTVWdTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kwO8JJzNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kwO8JJzNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13H6L2eqfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13H6L2eqfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1txyELfPLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1txyELfPLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Hhoo8BxWS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Hhoo8BxWS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.31496\",\"label\":\"inches\"}]},{\"name\":\"w