      "content": {
        "bytes": "{\"id\":\"B074KMJ96Q\",\"sku\":\"B074KMJ96Q\",\"lang\":\"en\",\"slug\":\"glenwood-storage-coffee-table-46-w-oak-b074kmj96q\",\"name\":\"Glenwood Storage Coffee Table, 46&quot;W, Oak\",\"description\":\"This handsome coffee table has the additional benefit of allowing you to clean up quickly for company. Stash remote controls, magazines and toys in the two drawers and storage compartment, then close the top to make way for snack and beverage trays. 46&quot;W x 30&quot;D x 17&quot;H Hardwood with quarter-sawn oak veneer for a handsome grain; metal drawer pulls Simple, sleek design and classic oak veneer combine for a transitional style Easy gliding, self-closing drawers; back of table has lift top and storage area Wipe with soft dry cloth Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Glenwood Storage Coffee Table, 46&quot;W, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Isw+LOXXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916BVhLfI+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916BVhLfI+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-E0O+tCAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-E0O+tCAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19UsXNbb+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19UsXNbb+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XSWq6NJZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XSWq6NJZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HCEga4CGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HCEga4CGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XNdv1rMZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XNdv1rMZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"46.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"119.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Red coffee table\",\"label\":\"Red coffee table\"},{\"value\":\"White coffee table\",\"label\":\"White coffee table\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Dark brown coffee table\",\"label\":\"Dark brown coffee table\"},{\"value\":\"Square coffee table\",\"label\":\"Square coffee table\"},{\"value\":\"Coffee tables for living room\",\"label\":\"Coffee tables for living room\"},{\"value\":\"Glass coffee table\",\"label\":\"Glass coffee table\"},{\"value\":\"Coffee tables\",\"label\":\"Coffee tables\"},{\"value\":\"Dark wood coffee table\",\"label\":\"Dark wood coffee table\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Lift top coffee table\",\"label\":\"Lift top coffee table\"},{\"value\":\"Oak\",\"label\":\"Oak\"},{\"value\":\"Black glass coffee table\",\"label\":\"Black glass coffee table\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Round coffee table\",\"label\":\"Round coffee table\"},{\"value\":\"Modern coffee table\",\"label\":\"Modern coffee table\"},{\"value\":\"Coffee-tables\",\"label\":\"Coffee-tables\"},{\"value\":\"Coffee table set\",\"label\":\"Coffee table set\"}]}],\"categories\":[{\"id\":\"Coffee Tables\",\"slug\":\"coffee-tables\",\"name\":\"Coffee Tables\",\"value\":\"Coffee Tables\",\"label\":n