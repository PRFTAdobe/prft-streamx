    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853NYVZ3\",\"sku\":\"B0853NYVZ3\",\"lang\":\"en\",\"slug\":\"rivet-rione-modern-upholstered-swivel-chair-with-rounded-back-30-3-w-flannel-b0853nyvz3\",\"name\":\"Rivet Rione Modern Upholstered Swivel Chair with Rounded Back, 30.3&quot;W, Flannel\",\"description\":\"Style and functionality meet in this low-profile, foam-padded swivel chair. The rotating base allows easy movement. A round back that curves into high arms provides ample support and gives the piece a classic look. Textured, flannel-colored upholstery means this chair will blend with existing decor. 30.3&quot;W x 30.7&quot;D x 30.7&quot;H; seat height: 17.3&quot;H; seat depth: 20.9&quot;D; seat back height: 27.6&quot;H; arm height: 24.8&quot;H Acrylic and polyester upholstery and foam padding The swivel features allow for easy movement within the chair, providing extra convenience and comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Rione Modern Upholstered Swivel Chair with Rounded Back, 30.3&quot;W, Flannel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wkFnVESOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C7jmqioZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C7jmqioZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rYqUUQlIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rYqUUQlIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914IllYNFVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914IllYNFVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XLNPRnPVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XLNPRnPVL.jpg\"},{\"alt\":\"https://stor