    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBKN8\",\"sku\":\"B07QCMBKN8\",\"lang\":\"en\",\"slug\":\"anne-marie-contemporary-oversized-accent-chair-48-w-charcoal-b07qcmbkn8\",\"name\":\"Anne Marie Contemporary Oversized Accent Chair, 48&quot;W, Charcoal\",\"description\":\"This oversized chair's modern take on a classic design perfectly enhances your transitional-style home decor without sacrificing comfort. The cushions are reversible to enhance durability and prolong this love seat’s life. Overall: 48&quot;W x 41&quot;D x 40&quot;H. Seat height: 21&quot;H; seat depth: 22&quot;D; seat back height: 20&quot;H Sturdy wood frame and legs with durable 100% polypropylene upholstery Loose seat and back cushions are reversible to help keep this item looking great over time Classic meets contemporary for an ideal modern farmhouse feel Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Anne Marie Contemporary Oversized Accent Chair, 48&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T1lTEEm2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wNsrFIIpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wNsrFIIpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N2xLTI0ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N2xLTI0ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qs1gbWlrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qs1gbWlrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1p47Ii23SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1p47Ii23SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jbpwIBoSL.jp