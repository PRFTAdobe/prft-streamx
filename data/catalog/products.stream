      "content": {
        "bytes": "{\"id\":\"B073G6T3HT\",\"sku\":\"B073G6T3HT\",\"lang\":\"en\",\"slug\":\"edgewood-modern-storage-ottoman-36-w-sea-blue-b073g6t3ht\",\"name\":\"Edgewood Modern Storage Ottoman, 36&quot;W, Sea Blue\",\"description\":\"This classic, tailored storage bench is the perfect place to hide those extra pillows in your master suite or stow toys in the living room. Simple modern design in a magnificent sea blue adds just the right pop of color. 36&quot;W x 18&quot;D x 18&quot;H Solid pine frame and polyester Modern and functional Provides stylish storage No assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Edgewood Modern Storage Ottoman, 36&quot;W, Sea Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hSYsu6D1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1H8x6f7YfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1H8x6f7YfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1X9fgFBEeS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1X9fgFBEeS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SQEfCr0FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SQEfCr0FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ALLiRZ4AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ALLiRZ4AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IiwZ1qGwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IiwZ1qGwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"