    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831X3864\",\"sku\":\"B0831X3864\",\"lang\":\"en\",\"slug\":\"cypress-modern-tufted-farmhouse-sofa-couch-85-w-beige-b0831x3864\",\"name\":\"Cypress Modern Tufted Farmhouse Sofa Couch, 85&quot;W, Beige\",\"description\":\"This sumptuously padded beige sofa with a tufted back brings both comfort and style to your living room. High side arms provide extra support and a distinctive flair. The performance upholstery is durable and makes spot cleaning a breeze. This will be a favorite sofa for years! 85&quot;W x 30.5&quot;D x 30&quot;H; seat height: 18.5&quot;H; seat depth: 24&quot;D; seat back height: 30&quot;H; arm height: 30&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Cypress Modern Tufted Farmhouse Sofa Couch, 85&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SKMTFyQmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yucgyG5aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yucgyG5aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TzlFXR1VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TzlFXR1VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xL4tHcIEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xL4tHcIEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71meztFaCjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71meztFaCjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JUIz5DP1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JUIz5DP1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HCdzogJ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HCdzogJ2L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"85.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"103.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"For\",\"label\":\"For\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Sierra\",\"label\":\"Sierra\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"With\",\"label\":\"With\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"And\",\"label\":\"And\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Lodge\",\"label\":\"Lodge\"},{\"value\":\"Grey\",\"label\":\"Grey\"},{\"value\":\"Power\",\"label\":\"Power\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":377,\"discountedValue\":339.3}}"
