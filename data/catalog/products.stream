    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMY2J7\",\"sku\":\"B075YMY2J7\",\"lang\":\"en\",\"slug\":\"rivet-roger-2-pack-mid-century-2-tone-accent-chairs-34-8-h-navy-and-grey-b075ymy2j7\",\"name\":\"Rivet Roger 2-Pack Mid-Century 2-Tone Accent Chairs, 34.8&quot;H, Navy and Grey\",\"description\":\"Two-tone upholstery adds a modern flair to a classic mid-century design. Light padding on grey seats and curved navy backs add comfort to pieces that can multi-task at your dining room table, as extra seating in a living room, or as desk chairs. 19.3&quot;W x 23.4&quot;D x 34.8&quot;H. Seat height is 19.1&quot;. Polyester fabric on wood frame; metal legs with black finish A multi-tasking chair easily moved from room to room; durable finish on legs. Assemble in 10 minutes or less. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Roger 2-Pack Mid-Century 2-Tone Accent Chairs, 34.8&quot;H, Navy and Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KuCqwB1nL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xTETnNyJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xTETnNyJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U2boGcX5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U2boGcX5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PtG3RJx2S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PtG3RJx2S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RCX1arexL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RCX1arexL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816aMzNxn3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816aMzNxn3L.jpg\"}],\"attribu