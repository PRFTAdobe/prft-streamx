    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC11RS2\",\"sku\":\"B07PC11RS2\",\"lang\":\"en\",\"slug\":\"leila-tufted-leather-loveseat-sofa-couch-69-w-saddle-b07pc11rs2\",\"name\":\"Leila Tufted Leather Loveseat Sofa Couch, 69&quot;W, Saddle\",\"description\":\"Vintage design and chic leather upholstery combine in this piece, making it the perfect fit for modern and classic decor schemes. Foam-padded cushions and solid wood legs ensure that this loveseat is functional and comfortable as well as a stylish addition to any lounge area. 69&quot;W x 36&quot;D x 31&quot; Sturdy wood frame and solid wood legs in a dark walnut finish with rich 100% top-grain leather. Foam cushions provide lasting support and comfort. Treat yourself to luxury with this striking vintage-look loveseat. The classic upholstery and solid wood legs in an espresso finish exude opulence. Rich leather upholstery adds sophistication and comfort to any space. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Leather Loveseat Sofa Couch, 69&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716aQ0P7q9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bjGg9z8QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bjGg9z8QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zIzHDI6sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zIzHDI6sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91r4hL4tiTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91r4hL4tiTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\"},{\"alt