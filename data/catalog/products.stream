      "content": {
        "bytes": "{\"id\":\"B075Z7HQK5\",\"sku\":\"B075Z7HQK5\",\"lang\":\"en\",\"slug\":\"rivet-modern-cross-legged-home-office-computer-desk-console-42-w-white-gloss-and-walnut-b075z7hqk5\",\"name\":\"Rivet Modern Cross Legged Home Office Computer Desk Console, 42&quot;W, White Gloss and Walnut\",\"description\":\"High gloss white lacquer finish and walnut veneer; silver hardware Versatile piece with one storage compartment and one drawer on the front This two-tone desk is anything but your ordinary workstation. Modern inspired design with a high gloss white lacquer finish is accented by warm walnut veneer, then mixed with crossed legs for a sleek, contemporary touch. 42&quot;W x 15.7&quot;D x 31.1&quot;H Easy assembly in 15-30 minutes. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Cross Legged Home Office Computer Desk Console, 42&quot;W, White Gloss and Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GXKGv-wnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y0WwhrZ-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y0WwhrZ-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BgBkxi8sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BgBkxi8sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-MkHs5iVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-MkHs5iVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IsCnFCb4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IsCnFCb4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+E109KBKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+E109KBKL.jpg\"}],\"attributes\":