    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNRBSX\",\"sku\":\"B07QDNRBSX\",\"lang\":\"en\",\"slug\":\"seagrass-woven-barstool-30-h-brown-b07qdnrbsx\",\"name\":\"Seagrass-Woven Barstool, 30&quot;H, Brown\",\"description\":\"This traditional-style barstool offers a woven seat of natural seagrass that fits comfortably with most decor. The solid birch frame offers the perfect height for use in the kitchen, at the bar, or at a counter-height table, while the backless design makes storing it out of the way a snap. 20&quot;L*20&quot;W*30&quot;H 95% birch, 5% seagrass This barstool can be used at the bar, counter, or counter-height dinner table. This traditional grass-woven barstool adds style to any kitchen or bar. Simple assembly in less than 15 minutes Use a dampened, soft and clean cloth with water only. Wipe in the direction of the grain. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Seagrass-Woven Barstool, 30&quot;H, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tRoeZP2rL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a94jV3YTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a94jV3YTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vgVcmKoPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vgVcmKoPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TAzVmjfUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TAzVmjfUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ssf4umHiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ssf4umHiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BYmh1YnoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BYmh1YnoL.jpg\"}],\"attribu