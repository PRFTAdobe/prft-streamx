    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9Y248\",\"sku\":\"B07QF9Y248\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-swivel-office-chair-25-w-gray-b07qf9y248\",\"name\":\"Rivet Modern Upholstered Swivel Office Chair, 25&quot;W, Gray\",\"description\":\"This modern swivel chair is perfect for a home office with its gray stain-resistant fabric upholstery that blends with any design taste. The adjustable height and tilt mechanism allow for maximum sitting comfort. 25&quot;W x 23&quot;D x 30.1–33.1&quot;H Fabric upholstery over plywood and metal frame; foam padding; metal base with rollers This modern chair with adjustable height has a 360-degree swivel mechanism; a tilt lock; and waterproof and stain-resistant fabric upholstery. The gray fabric and ribbed upholstery detailing of this swivel chair add an elegant flair to your home office. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Swivel Office Chair, 25&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n9hQ2UN7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eM+Fd3xFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eM+Fd3xFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81deDaU3UML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81deDaU3UML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xxjKMGZmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xxjKMGZmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lzOXpqvfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lzOXpqvfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qVPMolktL.jpg\",\"url\":