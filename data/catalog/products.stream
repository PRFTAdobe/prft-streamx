    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSJX7YW\",\"sku\":\"B07HSJX7YW\",\"lang\":\"en\",\"slug\":\"woodley-modern-dining-room-kitchen-chairs-set-of-2-40-h-grey-b07hsjx7yw\",\"name\":\"Woodley Modern Dining Room Kitchen Chairs, Set of 2, 40&quot;H, Grey\",\"description\":\"This classic Parsons-style chair is a perfect middle ground between rustic, farmhouse charm and sleek, contemporary sophistication. The squared frame, natural wooden legs, and gray upholstery are equally at home in a minimalist modern or cozy homespun motif. Solid wood frame, fabric Versatile style is ideal for both farmhouse and modern-contemporary looks 24&quot;D x 17.5&quot;W x 40&quot;H, 2PCS/CTN No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Woodley Modern Dining Room Kitchen Chairs, Set of 2, 40&quot;H, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pW6UNlvUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19l3AE7PGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19l3AE7PGS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jCQPxtSjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jCQPxtSjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zQfulPavL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zQfulPavL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p7CqZhW7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p7CqZhW7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UVC0WEUVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UVC0WEUVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"wid