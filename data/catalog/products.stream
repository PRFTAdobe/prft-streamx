    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MM4HS\",\"sku\":\"B07B4MM4HS\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-sofa-leather-87-w-charcoal-b07b4mm4hs\",\"name\":\"Rivet Edgewest Modern Sofa, Leather, 87&quot;W, Charcoal\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 87&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H; Chaise Depth: D&quot;; Chaise Width: W&quot; Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; individual pieces can be configured in many ways Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Sofa, Leather, 87&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61scVrnBOEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-H7DoUMuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-H7DoUMuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61r-4srW-kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61r-4srW-kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FTOQ-V36L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FTOQ-V36L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6133uS4DUZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6133uS4DUZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18WhIFcc+L.jpg\",\"url\"