    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9X1KF\",\"sku\":\"B07QF9X1KF\",\"lang\":\"en\",\"slug\":\"rivet-industrial-solid-wood-coffee-table-with-hairpin-metal-legs-53-15-w-b07qf9x1kf\",\"name\":\"Rivet Industrial Solid Wood Coffee Table with Hairpin Metal Legs, 53.15&quot;W\",\"description\":\"This coffee table has a sleek design, allowing you to move it easily and place it wherever you need extra storage. The table is structured with thin black metal legs and a finished plank top of solid hardwood. The wood finish and black metal create a classic color combination that will suit any space. 53.15&quot;W x 27.56&quot;D x 15.75&quot;H Made of solid hardwood with natural finish and metal legs This table has sturdy hairpin legs that give it a rustic look. The natural finish makes this console table perfect for industrial or modern decor. Smooth, solid plank top with metal hairpin legs Assemble in 15 minutes or less Clean with a soft, damp cloth. Avoid placing furniture near heat vents or open windows. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Solid Wood Coffee Table with Hairpin Metal Legs, 53.15&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717JNeEmHiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816W0Kss4CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816W0Kss4CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhhccEAeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhhccEAeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W1D1pCZ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W1D1pCZ1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71l6AJOAG1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71l6AJOAG1