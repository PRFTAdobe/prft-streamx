    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7J42PQ\",\"sku\":\"B07B7J42PQ\",\"lang\":\"en\",\"slug\":\"gazelle-rustic-metal-nesting-side-end-tables-22-w-set-of-3-weathered-taupe-gray-b07b7j42pq\",\"name\":\"Gazelle Rustic Metal Nesting Side End Tables, 22&quot;W, Set of 3, Weathered Taupe Gray\",\"description\":\"This set of three rustic nesting tables is a perfect space-saving solution for the area next to your favorite sofa or chair. Distressed-finish wood is paired with minimalist metal bases for a modern farmhouse style with a contemporary touch. 22&quot;W x 16&quot;D x 24&quot;H Hardwood tops with metal bases Touches of rustic, modern and industrial Can be stored together to save space, or to just change up the look Assembly in 30 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Gazelle Rustic Metal Nesting Side End Tables, 22&quot;W, Set of 3, Weathered Taupe Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91doXoE98+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nug14gRiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nug14gRiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gnvh6fvJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gnvh6fvJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u1+AR2r0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u1+AR2r0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QgkiBeumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QgkiBeumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19jGe+hQGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19jGe+hQGS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OH-oragNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OH-oragNL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"28.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"End table\",\"label\":\"End table\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Night stand\",\"label\":\"Night stand\"},{\"value\":\"Accent table\",\"label\":\"Accent table\"},{\"value\":\"End tables\",\"label\":\"End tables\"},{\"value\":\"Nightstand\",\"label\":\"Nightstand\"},{\"value\":\"End-tables\",\"label\":\"End-tables\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Weathered taupe gray\",\"label\":\"Weathered taupe gray\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Console table\",\"label\":\"Console table\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Sofa table\",\"label\":\"Sofa table\"},{\"value\":\"End tables living room\",\"label\":\"End tables living room\"}]}],\"categories\":[{\"id\":\"Nesting Tables\",\"slug\":\"nesting-tables\",\"name\":\"Nesting Tables\",\"value\":\"Nesting Tables\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":309,\"discountedValue\":278.1}}"
