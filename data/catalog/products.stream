    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STHBD\",\"sku\":\"B07P8STHBD\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-upholstered-ottoman-25-6-w-denim-b07p8sthbd\",\"name\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Denim\",\"description\":\"This handsome ottoman can serve as a footstool, an extra place to put a tray of snacks, or a comfortable seat for a friend. The tapered solid wood legs and low profile give this a classic mid-century modern style. 25.6&quot;W x 25.6&quot;D x 15.7&quot;H Solid wood frame and tapered beech legs; 100% polyester upholstery Comfortably rest your feet while sitting on your sofa or favorite armchair. Simple assembly in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ta3RfrEVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ucV1yxkcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ucV1yxkcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710bXno8zBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710bXno8zBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qCcBo6cnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qCcBo6cnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kZINsnQnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kZINsnQnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10kQ9WUgsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10kQ9WUgsL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"