    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLKSP9\",\"sku\":\"B082VLKSP9\",\"lang\":\"en\",\"slug\":\"rivet-frederick-mid-century-modern-tufted-leather-sofa-couch-77-5-w-taupe-b082vlksp9\",\"name\":\"Rivet Frederick Mid-Century Modern Tufted Leather Sofa Couch, 77.5&quot;W, Taupe\",\"description\":\"The rectangular shape and channeled upholstery are unmistakably mid-century, while soft leather fabric and shiny metal legs bring glamour to this sofa. This piece is a stunning style statement and a conversation starter for your modern-style room. 77.5&quot;W x 34.6&quot;D x 31.4&quot;H; Seat Height: 17.7&quot;H ; Seat Depth: 23.2&quot;D; Seat Back Height: 22.2&quot;H; Arm Height: 31.4&quot;H; Leg Height: 9.3&quot;H Leather on sturdy wood frame; aluminum legs with brass finish Mid-century modern meets glam in this statement piece Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Frederick Mid-Century Modern Tufted Leather Sofa Couch, 77.5&quot;W, Taupe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PP8RN8c2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cB6R6+rLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cB6R6+rLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aajo+IUCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aajo+IUCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FATJAtZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FATJAtZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71U82knhbBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71U82knhbBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bH6YRZK3L.jpg\",\"url\":\"https:/