        "bytes": "{\"id\":\"B075ZF4S39\",\"sku\":\"B075ZF4S39\",\"lang\":\"en\",\"slug\":\"barrett-reclaimed-wood-4-shelf-bookcase-40-w-white-and-sandstone-pine-b075zf4s39\",\"name\":\"Barrett Reclaimed Wood 4-Shelf Bookcase, 40&quot;W, White and Sandstone Pine\",\"description\":\"40&quot;W x 15&quot;D x 74”H Solid, recycled pine wood with natural imperfections for rustic touch Five wide shelves provide generous display and storage space. Display your prized family photos or works by your favorite authors on this rustic bookshelf. Influenced by early Americana style, it's made of recycled and reclaimed wood in a white and weathered sandstone finish that adds old world charm. No assembly required. Dust with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Barrett Reclaimed Wood 4-Shelf Bookcase, 40&quot;W, White and Sandstone Pine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hYIzK+q8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R+mFOujCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R+mFOujCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zA+xzLNWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zA+xzLNWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A3IKDea8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A3IKDea8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLiXbp43L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLiXbp43L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CTQcMfnjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CTQcMfnjL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"val