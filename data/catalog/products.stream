    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSGFLJ9\",\"sku\":\"B07HSGFLJ9\",\"lang\":\"en\",\"slug\":\"rivet-stevens-wood-and-metal-modern-office-computer-desk-47-24-w-brushed-tundra-gray-b07hsgflj9\",\"name\":\"Rivet Stevens Wood and Metal Modern Office Computer Desk, 47.24&quot;W, Brushed Tundra Gray\",\"description\":\"Update your home décor with this gorgeous modern-style desk. Made from solid acacia, this desk is highly durable, and its brushed tundra-gray finish blends well with most home-décor themes. Its 2 drawers offer helpful organization options. 47.24&quot;W x 25.59&quot;D x 34.25&quot;H Solid acacia with MDF acacia veneer Clean lines and rich gray finish create a modern design that's perfect for any contemporary-style home. This stylish desk has 2 drawers for storing items and a wide surface space for desk use. Assemble in 15-30 minutes Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Stevens Wood and Metal Modern Office Computer Desk, 47.24&quot;W, Brushed Tundra Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hOpEiMqsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TjNlzspTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TjNlzspTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JazS3nFhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JazS3nFhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SQUo5JTsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SQUo5JTsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mb9KHSR5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mb9KHSR5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mpp5Gp