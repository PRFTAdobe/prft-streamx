    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQCP1\",\"sku\":\"B07QBMQCP1\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-living-room-chair-with-tapered-wood-legs-35-w-felt-grey-b07qbmqcp1\",\"name\":\"Rivet Isabelle Mid-Century Modern Living Room Chair with Tapered Wood Legs, 35&quot;W, Felt Grey\",\"description\":\"This chair’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its felt-gray upholstery ensures that it will match the color scheme of any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 35&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Living Room Chair with Tapered Wood Legs, 35&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91a8o8VraIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919t5Dcm1KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919t5Dcm1KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T2wEJqbtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T2wEJqbtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uThpiaKHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uThpiaKHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1p3RjOrp6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origi