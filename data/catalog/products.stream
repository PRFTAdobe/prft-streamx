      "content": {
        "bytes": "{\"id\":\"B07HSKKD1S\",\"sku\":\"B07HSKKD1S\",\"lang\":\"en\",\"slug\":\"leon-modern-farmhouse-kitchen-counter-bar-stool-42-h-dove-grey-b07hskkd1s\",\"name\":\"Leon Modern Farmhouse Kitchen Counter Bar Stool, 42&quot;H, Dove Grey\",\"description\":\"High wooden legs adorned with dual-height stretchers and dove-gray saddle-style padded seating are accentuated by decorative bronze nailheads studding the lower edge of the seat. Solid wood frame, silver metal kickplate, fabric upholstery with nailhead accents Dual-height stretcher bars for asymmetrical style and solid support 21.5&quot;D x 17&quot;W x 42&quot;H Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leon Modern Farmhouse Kitchen Counter Bar Stool, 42&quot;H, Dove Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g8TJG3xKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19l3AE7PGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19l3AE7PGS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w-QVQAPlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w-QVQAPlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZM9jkncDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZM9jkncDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MUgMvrNYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MUgMvrNYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815xnCmDpAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815xnCmDpAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.0\"