        "bytes": "{\"id\":\"B07QGWM3CY\",\"sku\":\"B07QGWM3CY\",\"lang\":\"en\",\"slug\":\"classic-spindle-back-armless-wood-dining-chair-19-w-set-of-2-black-b07qgwm3cy\",\"name\":\"Classic Spindle-Back Armless Wood Dining Chair, 19&quot;W, Set of 2, Black\",\"description\":\"This set of 2 traditional dining chairs features an updated take on the classic spindle-backed style, lending an air of homespun charm to any setting. The beautiful glossy black finish adds the final touch of sophistication. 19.7&quot;D x 19&quot;W x 31&quot;H Set of 2 chairs Solid rubberwood with a black finish and comfortable back These dining chairs are crafted in a simple, modern design that can blend with traditional and modern styles. Simple assembly in less than 15 minutes Use a dampened, soft and clean cloth with water only. Wipe in the direction of the grain. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Spindle-Back Armless Wood Dining Chair, 19&quot;W, Set of 2, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xxH7ra0SL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719IVobRjJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719IVobRjJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b80y3XojL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b80y3XojL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jQDVrxpQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jQDVrxpQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719vD3q46JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719vD3q46JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SP7SS4-iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SP7SS4-iL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.7\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"29.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Tan\",\"label\":\"Tan\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Industrial\",\"label\":\"Industrial\"},{\"value\":\"Ladderback\",\"label\":\"Ladderback\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Iconic\",\"label\":\"Iconic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Lucite\",\"label\":\"Lucite\"},{\"value\":\"Bistro\",\"label\":\"Bistro\"},{\"value\":\"Outdoor\",\"label\":\"Outdoor\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Folding\",\"label\":\"Folding\"},{\"value\":\"Faux\",\"label\":\"Faux\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Legs\",\"label\":\"Legs\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Armen\",\"label\":\"Armen\"},{\"value\":\"Waiting\",\"label\":\"Waiting\"},{\"value\":\"Leg\",\"label\":\"Leg\"},{\"value\":\"Microfiber\",\"label\":\"Microfiber\"},{\"value\":\"Pink\",\"label\":\"Pink\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Tolix\",\"label\":\"Tolix\"},{\"value\":\"Blush\",\"label\":\"Blush\"},{\"value\":\"Ivory\",\"label\":\"Ivory\"},{\"value\":\"Kitchen\",\"label\":\"Kitchen\"},{\"value\":\"Te