  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STB84\",\"sku\":\"B07P8STB84\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-loveseat-sofa-with-removable-cushions-67-w-wathet-blue-b07p8stb84\",\"name\":\"Rivet Andrews Contemporary Loveseat Sofa with Removable Cushions, 67&quot;W, Wathet Blue\",\"description\":\"This love seat features removable cushions in an attractive easy-care blue fabric that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 67&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs Reversible and removable back and seat cushions Contemporary style and easy-care fabric combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Loveseat Sofa with Removable Cushions, 67&quot;W, Wathet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q4RWfUbdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p3DnW-JFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p3DnW-JFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tj+QwYSlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tj+QwYSlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PxjSb6uYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PxjSb6uYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rYgUIrcSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rYgUIrcSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ClrBuuJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-