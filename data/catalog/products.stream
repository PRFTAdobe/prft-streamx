    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z6SHD3\",\"sku\":\"B075Z6SHD3\",\"lang\":\"en\",\"slug\":\"reclaimed-wood-farmhouse-coffee-table-55-1-w-natural-finish-b075z6shd3\",\"name\":\"Reclaimed Wood Farmhouse Coffee Table, 55.1&quot;W, Natural Finish\",\"description\":\"This classic farmhouse coffee table makes a great style focal point for any style living room. Made of reclaimed hardwood, its base is strengthened by a &quot;V&quot; support that adds stability as well as visual interest. 55.1&quot;W x 31.5&quot;D x 17.7&quot;H Reclaimed hardwood The simple farmhouse style will complement a living room Place in front of your sofa for a convenient setting for your laptop and snack. No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Reclaimed Wood Farmhouse Coffee Table, 55.1&quot;W, Natural Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HZlpnP6RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vxd70Xu3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vxd70Xu3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pEt0PYdgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pEt0PYdgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81obOPA3zWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81obOPA3zWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dqiZtNykL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dqiZtNykL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QA1Cbe2iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QA1Cbe2iL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.7\",\"