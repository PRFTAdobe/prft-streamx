    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSCNKDC\",\"sku\":\"B07HSCNKDC\",\"lang\":\"en\",\"slug\":\"rivet-roxmere-modern-media-center-49-2-w-acacia-wood-and-dark-metal-b07hscnkdc\",\"name\":\"Rivet Roxmere Modern Media Center, 49.2&quot;W, Acacia Wood and Dark Metal\",\"description\":\"Complete your interior design with this beautiful modern-style media center, made from solid acacia with a sandblast-gray finish that nicely complements most home-décor themes. With 2 niches, 2 drawers, and 2 shelves, this media center will add both style and organization to your room. 49.2&quot;W x 15.7&quot;D x 70.9&quot;H Solid acacia with MDF acacia veneer Modern styling that also blends well with rustic- and contemporary-style home décor This media center has 2 niches, 2 drawers, and 2 shelves for maximum organization options. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Roxmere Modern Media Center, 49.2&quot;W, Acacia Wood and Dark Metal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IEX0gNYzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jyz6B-URL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jyz6B-URL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7JmlRTFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7JmlRTFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71X-hD04YJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71X-hD04YJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vVZrf4XTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vVZrf4XTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SxpMt+jWL.jpg\",\"url\":\"