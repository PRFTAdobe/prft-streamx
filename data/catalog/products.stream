    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QC864VW\",\"sku\":\"B07QC864VW\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-console-with-self-closing-drawers-55-w-b07qc864vw\",\"name\":\"Rivet Mid-Century Console with Self-Closing Drawers, 55&quot;W\",\"description\":\"The solid wood construction of this console’s body and legs will help keep all your media needs secure and in place. Self-close cabinet drawers allow you to avoid damage and injury. The light finish of the wood ensures that this console will match the color scheme of any media room. 55&quot;W x 16&quot;D x 20&quot;H MDF and solid wood The wood finish will match any decor. This cabinet has 2 self-closing drawers and 1 cabinet door. Assemble in 15-30 minutes Clean with a soft cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Console with Self-Closing Drawers, 55&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rysMv3dKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61E0y4tpb4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61E0y4tpb4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31aE4OQoQZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31aE4OQoQZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51NxNOjMaDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51NxNOjMaDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91inmLc+kqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91inmLc+kqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ARYciEw6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ARYciEw6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"2