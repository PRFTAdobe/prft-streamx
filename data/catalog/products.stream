        "bytes": "{\"id\":\"B075Z85K2F\",\"sku\":\"B075Z85K2F\",\"lang\":\"en\",\"slug\":\"culver-reclaimed-industrial-wood-coffee-table-55-1-w-natural-and-steel-b075z85k2f\",\"name\":\"Culver Reclaimed Industrial Wood Coffee Table, 55.1&quot;W, Natural and Steel\",\"description\":\"Sleek, modern stainless steel legs are paired with a reclaimed wood top for a table that will bring rustic and industrial touches to your home. Top it with trays of snacks and beverages for many fun gatherings in the years to come. 55.1&quot;W x 31.5&quot;D x 17.3&quot;H Reclaimed wood and stainless steel Touches of modern, industrial and rustic Sturdy, durable and ideal for displaying magazines or snack trays Free returns for 30 days. 3-year warranty. Assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Culver Reclaimed Industrial Wood Coffee Table, 55.1&quot;W, Natural and Steel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DqvukIRWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cAruQmfLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cAruQmfLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A189x26pPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A189x26pPdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xSqWLav0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xSqWLav0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71h-qQ1LQrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71h-qQ1LQrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QrVwBg8gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QrVwBg8gL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\