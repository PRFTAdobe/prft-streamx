    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWMTDY\",\"sku\":\"B07QGWMTDY\",\"lang\":\"en\",\"slug\":\"rivet-fulton-modern-rustic-dining-table-71-l-natural-b07qgwmtdy\",\"name\":\"Rivet Fulton Modern Rustic Dining Table, 71&quot;L, Natural\",\"description\":\"Inspired by Scandinavian designs, this dining table features slats of acacia set in angled patterns for a rustic feel, which is accented by slightly tapered metal legs and sleek metal handles. The transitional design combines easily with contemporary and minimalist styles for a look that suits you. 71&quot;L x 39&quot;D x 30&quot;H Acacia top and metal legs Metal legs and sleek handles provide a rustic feel This Scandinavian-inspired design creates a sleek and minimalist look. Simple assembly in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fulton Modern Rustic Dining Table, 71&quot;L, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ARtDOE2UL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pvPy5WG9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pvPy5WG9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N9om05YIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N9om05YIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tSh5i2TVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tSh5i2TVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1EVxpqkhiS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1EVxpqkhiS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EwDLkqPKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EwDLkqPKL.jpg\"},{\"alt\":\"http