    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JWY13\",\"sku\":\"B0857JWY13\",\"lang\":\"en\",\"slug\":\"wood-and-rattan-dining-chair-with-arms-24-8-w-black-b0857jwy13\",\"name\":\"Wood and Rattan Dining Chair with Arms, 24.8&quot;W, Black\",\"description\":\"This modern chair's curved frame is beautiful red oak with a black stain, while its seat is a 100% natural handwoven rattan. It's both durable and comfortable, with a look that straddles tradition and modernity that works for any room in the house. 24.8&quot;W x 20&quot;D x 30.5&quot;H Red oak frame with a woven seat The sturdy red oak construction with a black stain will stand the test of time, while the soft woven paper-rope seat is easy to sink into. This chair's sophisticated, curved design is offset by the warmth of its soft, handwoven rattan seat, making it versatile. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Wood and Rattan Dining Chair with Arms, 24.8&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61G3M8Gf+aL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VMkRmbAYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VMkRmbAYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81weCFE0x8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81weCFE0x8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EW6aw522L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EW6aw522L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714+-hMuwjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714+-hMuwjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c8LKjVbPL.jpg\",\"url\":\"htt