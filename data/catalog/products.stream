    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5DN\",\"sku\":\"B075X4F5DN\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-indigo-b075x4f5dn\",\"name\":\"Marin Studded Chair, 33&quot;W, Indigo\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with 100% cotton upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eozAGoXsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V3ly9lfYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V3ly9lfYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913qloXbaEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913qloXbaEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rtf-NBasL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rtf-NBasL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jFWgibuQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jFWgibuQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Uf73Hb-QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Uf73Hb-QL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":