    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XR16X\",\"sku\":\"B0831XR16X\",\"lang\":\"en\",\"slug\":\"cypress-modern-tufted-farmhouse-apartment-sofa-couch-70-w-beige-b0831xr16x\",\"name\":\"Cypress Modern Tufted Farmhouse Apartment Sofa Couch, 70&quot;W, Beige\",\"description\":\"This sumptuous beige sofa with a tufted back brings both comfort and style to your living room. High side arms provide extra support and a distinctive flair. The durable performance upholstery makes spot cleaning a breeze. This will be a favorite sofa for years! 70&quot;W x 30.5&quot;D x 30&quot;H; seat height: 18.5&quot;H; seat depth: 24&quot;D; seat back height: 30&quot;H; arm height: 30&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Cypress Modern Tufted Farmhouse Apartment Sofa Couch, 70&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vcwixzQwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QVhPrymxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QVhPrymxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yucgyG5aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yucgyG5aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ShPtx0nqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ShPtx0nqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812eaqZKdmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-