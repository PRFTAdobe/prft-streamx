    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X3SJ2T\",\"sku\":\"B075X3SJ2T\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-beige-b075x3sj2t\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Beige\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812Gwz8lrWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nrvUrln1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nrvUrln1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jt-PTgTtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jt-PTgTtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7GIDZM4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7GIDZM4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I3hYWGO-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I3hYWGO-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"labe