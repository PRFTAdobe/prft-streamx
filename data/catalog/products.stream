    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B6PJ2\",\"sku\":\"B07B7B6PJ2\",\"lang\":\"en\",\"slug\":\"alejandra-unfinished-wood-kitchen-dining-table-storage-brown-b07b7b6pj2\",\"name\":\"Alejandra Unfinished Wood Kitchen Dining Table, Storage, Brown\",\"description\":\"This beautiful drop-leaf table is the ultimate space saver and storage solution. Two leaves can extend out for meals with your friends and family, or fold down to save space. Three drawers provide room for eating utensils and other items. 29&quot;L x 19-60&quot;W x 30&quot;H Hardwoods with acacia veneer in rustic butterscotch A transitional style that can blend with farmhouse, traditional or industrial styles Leaves fold in when not in use to save space. This piece could also be used as a desk. No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Alejandra Unfinished Wood Kitchen Dining Table, Storage, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Io2g9hvYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qbLb+KC+S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qbLb+KC+S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YYZD0urEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YYZD0urEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Rid0RC-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Rid0RC-gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wXM6NklWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wXM6NklWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81O0IZ4i3kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81O0IZ4i3kL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\