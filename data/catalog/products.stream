      "content": {
        "bytes": "{\"id\":\"B07B85FJDF\",\"sku\":\"B07B85FJDF\",\"lang\":\"en\",\"slug\":\"hughes-casual-farmhouse-wood-dining-kitchen-table-60-80-l-brown-b07b85fjdf\",\"name\":\"Hughes Casual Farmhouse Wood Dining Kitchen Table, 60-80&quot;L, Brown\",\"description\":\"With warm wood tones and two crossed-leg metal pedestals, this head-turning dining table has touches of rustic, modern and industrial. High quality materials and construction techniques ensure it will last through years of family memories. 39&quot;D x 60-80&quot;L x 30&quot;H Hardwood top with acacia veneer; iron base A casual transitional table with elements of many styles An extra leaf is provided to expand the table if needed Assembly in 30 minutes or less; just bolt on bases Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Hughes Casual Farmhouse Wood Dining Kitchen Table, 60-80&quot;L, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812jH5FmXkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HrLphfSjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HrLphfSjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L2xIbAGjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L2xIbAGjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VBMfRBCTS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VBMfRBCTS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14KFieeS-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14KFieeS-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bbB0Fpl6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bbB0Fpl6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I-Juw-e3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I-Juw-e3L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"80.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"143.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Dining-tables\",\"label\":\"Dining-tables\"},{\"value\":\"Dining table\",\"label\":\"Dining table\"},{\"value\":\"Round dining table\",\"label\":\"Round dining table\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Dining room table\",\"label\":\"Dining room table\"},{\"value\":\"Kitchen table\",\"label\":\"Kitchen table\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Console table\",\"label\":\"Console table\"},{\"value\":\"Kitchen table set\",\"label\":\"Kitchen table set\"},{\"value\":\"Extendable table 60-80&quot;\",\"label\":\"Extendable table 60-80&quot;\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Tables\",\"slug\":\"tables\",\"name\":\"Tables\",\"value\":\"Tables\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":459,\"discountedValue\":413.1}}"
