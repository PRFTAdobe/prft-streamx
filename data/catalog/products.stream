      "content": {
        "bytes": "{\"id\":\"B075X33QXP\",\"sku\":\"B075X33QXP\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-cube-ottoman-pouf-20-w-bear-b075x33qxp\",\"name\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Bear\",\"description\":\"This item is made to order just for you 20&quot;W x 20&quot;Dx 17&quot;H Solid wood frame, 100% polyester fabric. Multi-purpose cube ottoman is great in any space. Free returns for 30 days. 1-year warranty. Prop up your feet or add a tray of your favorite snacks to the top of this plush cube ottoman. Sturdy enough to use as an extra seat in any room, this versatile ottoman is offered in a range of fabrics. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Bear\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19fYOhsSIS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mzWQIg1YS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mzWQIg1YS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YYHjRjbhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YYHjRjbhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-uzeWe3sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-uzeWe3sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14wEEqeX0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14wEEqeX0L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.0\",\"label\":\"inches\"}]},{\"name\":\"