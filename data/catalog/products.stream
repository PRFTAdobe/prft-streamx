    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQXR5P\",\"sku\":\"B075YQXR5P\",\"lang\":\"en\",\"slug\":\"rivet-wide-cushion-mid-century-modern-top-grain-leather-set-of-2-accent-dining-room-kitchen-chairs-26-8-w-black-b075yqxr5p\",\"name\":\"Rivet Wide Cushion Mid-Century Modern Top-Grain Leather Set of 2 Accent Dining Room Kitchen Chairs, 26.8&quot;W, Black\",\"description\":\"These wide Mid-century modern chairs stand out with their deep seats and top-grain leather. Clean lines and sturdy tapered legs give them a handsome presence at a dining room table, in a living area or behind a desk. 26.8&quot;W x 23.2&quot;D x 32.2&quot;H Top-grain leather; Solid hardwood frame and legs Foam padding and elastic suspension system keep back and seat firm Easy assembly in 15 minutes. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Wide Cushion Mid-Century Modern Top-Grain Leather Set of 2 Accent Dining Room Kitchen Chairs, 26.8&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819pHtFoDqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pa-jWYG-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pa-jWYG-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sspFeaE0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sspFeaE0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6wRY4c1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6wRY4c1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815lQZucBgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815lQZucBgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XfshXbx5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origi