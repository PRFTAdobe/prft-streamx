  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2RX9M\",\"sku\":\"B084W2RX9M\",\"lang\":\"en\",\"slug\":\"elise-upholstered-counter-height-barstool-38-6-h-hemp-b084w2rx9m\",\"name\":\"Elise Upholstered Counter-Height Barstool, 38.6&quot;H, Hemp\",\"description\":\"This hemp-colored rectangular counter-height barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 38.6&quot;H; seat height: 26&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 21.3&quot;H Solid hardwood frame upholstered in moisture-repellent, stain-resistant fabric Footrest with kickplate for stability and durability, with padded seat and back for comfort. Low profile mid-century inspired barstool. Arrives fully assembled. Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Counter-Height Barstool, 38.6&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LXa0QPbfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VLW1Dx1FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VLW1Dx1FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1acRMPoXXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1acRMPoXXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WsANWHJ9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WsANWHJ9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RzIXI3PeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RzIXI3PeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-imag