    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4T5RG\",\"sku\":\"B075X4T5RG\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-chair-33-w-blue-eclipse-b075x4t5rg\",\"name\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Blue Eclipse\",\"description\":\"This item is made to order just for you 33&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with a removable seat cushion make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling up with a good book on this sophisticated chair. A sleek back, angled arms, a removable seat cushion and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Blue Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o2rT5eBYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxl8L5QHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxl8L5QHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJPkAvzLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJPkAvzLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ivArExAJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ivArExAJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kf11sVIaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kf11sVIaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":