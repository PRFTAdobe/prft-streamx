    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QMHYYL\",\"sku\":\"B075QMHYYL\",\"lang\":\"en\",\"slug\":\"darby-wingback-king-headboard-80-w-navy-blue-b075qmhyyl\",\"name\":\"Darby Wingback King Headboard, 80&quot;W, Navy Blue\",\"description\":\"This mid-century modern headboard's wingback design is covered in linen-look performance fabric for durability. Nailhead trim adds another touch of elegance, and ample foam padding makes it comfortable to lean against while enjoying a good book. 80&quot; W x 11.5&quot;D x 51.5&quot;H Hardwood frame; polyester performance fabric; metal nailheads with antiqued brass finish An update of a classic mid-century modern style Performance fabric is durable, easy to clean. Headboard has Dacron-wrapped foam padding. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Darby Wingback King Headboard, 80&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EZ-Bpt6ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kHbKu4UgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kHbKu4UgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fsmo9AqaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fsmo9AqaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JU6EM-6pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JU6EM-6pL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"51.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"80.0\",\"