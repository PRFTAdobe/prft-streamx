    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QK35B88\",\"sku\":\"B07QK35B88\",\"lang\":\"en\",\"slug\":\"elden-nailhead-trim-kitchen-counter-backless-bar-stool-30-h-slate-b07qk35b88\",\"name\":\"Elden Nailhead-Trim Kitchen Counter Backless Bar Stool, 30&quot;H, Slate\",\"description\":\"Brushed-brass nailhead trim wraps around this barstool’s slate-colored cushion, adding a timeless look to the modern farmhouse design. Moisture-repellent and stain-resistant fabric tops the solid and sturdy wood frame, reducing the amount of everyday wear and tear while providing additional comfort. 20&quot;W x 14&quot;D x 30&quot;H 98% polyester, 2% nylon on a hardwood frame Moisture-repellent and stain-resistant fabric help keep this barstool looking like new. The brushed-brass nailhead trim adds detail to this modern farmhouse barstool, while sturdy wood legs and performance fabric help keep daily wear and tear at bay. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Nailhead-Trim Kitchen Counter Backless Bar Stool, 30&quot;H, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-qXmiDdGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Tjpppb99L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Tjpppb99L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dMSZOBgAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dMSZOBgAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QciVVosDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QciVVosDL.jpg\"},{\"alt\":\"https://storage.googl