    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMQQ59\",\"sku\":\"B07BWMQQ59\",\"lang\":\"en\",\"slug\":\"andover-right-facing-sofa-chaise-sectional-126-w-charcoal-leather-b07bwmqq59\",\"name\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Charcoal Leather\",\"description\":\"Complete your living space with this stylish sofa-chaise sectional. With its charcoal-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 126&quot;W x 61&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Charcoal Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71v5057+rnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k3rGtCjaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k3rGtCjaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71szwlAjimL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71szwlAjimL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zt0lvTPvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zt0lvTPvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714Gq6edf6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714Gq6edf6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"61.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"126.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"172.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Sofas\",\"label\":\"Sofas\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":894,\"discountedValue\":804.6}}"
