    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLWBGD\",\"sku\":\"B082VLWBGD\",\"lang\":\"en\",\"slug\":\"westview-extra-deep-down-filled-leather-accent-chair-43-3-w-brown-b082vlwbgd\",\"name\":\"Westview Extra-Deep Down-Filled Leather Accent Chair, 43.3&quot;W, Brown\",\"description\":\"This accent chair, with its deep cushions and its sturdy frame, will help you add maximum comfort and style to any living space in your home. Never believe that you have to sacrifice comfort for style, for this chair has it both in spades. 43.3&quot;W x 42.1&quot;D x 31.5&quot;H Solid wood frame and block legs with 100% top-grain leather and down-filled cushions Seat and back cushions are filled with luxurious down. Assemble in 15 minutes or less To clean, avoid moisture and wipe down with a clean, soft cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Westview Extra-Deep Down-Filled Leather Accent Chair, 43.3&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f+cjwnySL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jhUJzU4ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jhUJzU4ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+qqC1gw1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+qqC1gw1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816Hd0BjN6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816Hd0BjN6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718aPt1NGWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718aPt1NGWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H4hwVzYsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H4hwVzYsL.jpg\"},{\"alt\":\"https://storage.