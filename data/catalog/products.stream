    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFB1TLZ\",\"sku\":\"B07QFB1TLZ\",\"lang\":\"en\",\"slug\":\"ryder-industrial-round-coffee-table-43-3-diameter-brushed-natural-antique-copper-b07qfb1tlz\",\"name\":\"Ryder Industrial Round Coffee Table, 43.3&quot; Diameter, Brushed Natural Antique Copper\",\"description\":\"This industrial round coffee table comes with a natural, antique-copper-finished elm top on an iron base in a brass finish. The open base keeps the table lightweight and gives the room an airy feel. This piece looks great in any contemporary or rustic space. 43.3“ diameter x 16.54&quot;H Elm, metal This industrial coffee table comes with a natural antique-copper-finished elm top and an iron base in a brass finish. The open design of this table's base helps keep it lightweight. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Ryder Industrial Round Coffee Table, 43.3&quot; Diameter, Brushed Natural Antique Copper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Gm7bRTfkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814iCSJaE8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814iCSJaE8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K+6eAFKHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K+6eAFKHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918R+tKCH9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918R+tKCH9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815I8OdnUUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815I8OdnUUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Sb9WfdrNL.jpg\",\"url\":\"https://storage.goo