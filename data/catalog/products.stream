    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YV7SQY\",\"sku\":\"B075YV7SQY\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-curved-back-accent-dining-room-chair-22-8-w-light-grey-b075yv7sqy\",\"name\":\"Rivet Mid-Century Modern Curved Back Accent Dining Room Chair, 22,8&quot;W, Light Grey\",\"description\":\"22.8&quot;W x 25.6&quot;D x 29.9&quot;H Fabric is 60% polyester/20% linen/20% rayon. Hardwood base has espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. The wide, curved back and legs joined by a crossed wood base make this mid-century modern chair a standout. A wider seat and plenty of padding make it comfortable and eye-catching. This chair will work well in a dining room or as an accent chair. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Curved Back Accent Dining Room Chair, 22,8&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912nEwacF8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QgWz2eJ4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QgWz2eJ4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-aWeGHXsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-aWeGHXsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AFHo771TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AFHo771TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WxoTXtS4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WxoTXtS4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16aJ-nc4FS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16aJ-nc4FS.jpg\"}],\"att