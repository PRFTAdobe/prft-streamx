        "bytes": "{\"id\":\"B074KKMQHB\",\"sku\":\"B074KKMQHB\",\"lang\":\"en\",\"slug\":\"rivet-modern-hourglass-white-marble-top-and-metal-side-end-table-nightstand-17-9-w-silver-finish-b074kkmqhb\",\"name\":\"Rivet Modern Hourglass White Marble Top and Metal Side End Table Nightstand, 17.9&quot;W, Silver Finish\",\"description\":\"The vintage marble-top table receives a dramatic modern refresh in this side table. The top is supported by two metal frames with silver finish that join in a shape reminiscent of an hourglass. The compact diameter allows it to fit in tight spaces. 17.9&quot;L x 17&quot;W x 17.9&quot;H Sleek modern frame with silver finish; white marble top A modern design with classic marble top and glam finish White marble top; steel base Easy assembly. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Hourglass White Marble Top and Metal Side End Table Nightstand, 17.9&quot;W, Silver Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S2coM9HjL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h2D34EuSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h2D34EuSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TxXAxuTxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TxXAxuTxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12FvHOfYrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12FvHOfYrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817cXAJLztL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817cXAJLztL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810NzB0aS4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810NzB0aS4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.9\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"17.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"16.76\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"End table\",\"label\":\"End table\"},{\"value\":\"Night stand\",\"label\":\"Night stand\"},{\"value\":\"Modern accent table\",\"label\":\"Modern accent table\"},{\"value\":\"Accent table\",\"label\":\"Accent table\"},{\"value\":\"Accent tables\",\"label\":\"Accent tables\"},{\"value\":\"Wood accent table\",\"label\":\"Wood accent table\"},{\"value\":\"End tables\",\"label\":\"End tables\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Nightstand\",\"label\":\"Nightstand\"},{\"value\":\"Outdoor accent table\",\"label\":\"Outdoor accent table\"},{\"value\":\"Gold accent table\",\"label\":\"Gold accent table\"},{\"value\":\"End-tables\",\"label\":\"End-tables\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Silver\",\"label\":\"Silver\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Round accent table\",\"label\":\"Round accent table\"},{\"value\":\"Console table\",\"label\":\"Console table\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"17&quot;\",\"label\":\"17&quot;\"},{\"value\":\"Sofa table\",\"label\":\"Sofa table\"},{\"value\":\"Silver accent table\",\"label\":\"Silver accent table\"},{\"value\":\"End tables living room\",\"label\":\"End tables living room\"},{\"value\":\"Small accent table\",\"label\":\"Small accent table\"}]}],\"categories\":[{\"id\":\"End Tables\",\"slug\":\"end-tables\",\"name\":\"End Tables\",\"value\":\"End Tables\",\"label\":null,\"pa