    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HYYJKMC\",\"sku\":\"B07HYYJKMC\",\"lang\":\"en\",\"slug\":\"clayton-reclining-contemporary-fabric-living-room-chair-30-w-charcoal-b07hyyjkmc\",\"name\":\"Clayton Reclining Contemporary Fabric Living-Room Chair, 30&quot;W, Charcoal\",\"description\":\"With an ideal blend of style and comfort, this recliner is made to order just for you. The tasteful fabric in Charcoal and wooden frame adds a contemporary flair, the perfect addition to any room. Sturdy wooden frame with stain-resistant fabric; no assembly required The tight, fixed back and seat cushions ensure durability and comfort; fits perfectly in a living-room corner or beside a couch or bed Product Dimensions: 30&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; seat back height: 41&quot;H; arm height: 24&quot;H; leg height: 6.5&quot;H Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Clayton Reclining Contemporary Fabric Living-Room Chair, 30&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KdmQjnpXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LL-ZshfGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LL-ZshfGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b3a+V5xXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b3a+V5xXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HZb5Cl3IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HZb5Cl3IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1beHVUyYpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1beHVUyYpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919IjGPL6pL.jpg\",\"url\":\"https://storage.googleapis.com/pure