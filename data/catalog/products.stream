    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6X818\",\"sku\":\"B07HZ6X818\",\"lang\":\"en\",\"slug\":\"fischer-full-sized-sleeper-sofa-72-w-charcoal-fabric-b07hz6x818\",\"name\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Charcoal Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this full-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 72&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and neutral color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Charcoal Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NBOS3BhuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JrWSCW97L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JrWSCW97L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9182cFdXWrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9182cFdXWrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bY9tp4FFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bY9tp4FFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i3MAIhD4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i3MAIhD4L.jpg\"},{\"alt\":\"https://storag