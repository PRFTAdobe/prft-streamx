        "bytes": "{\"id\":\"B073GGGF7X\",\"sku\":\"B073GGGF7X\",\"lang\":\"en\",\"slug\":\"benton-square-ottoman-35-w-merlot-b073gggf7x\",\"name\":\"Benton Square Ottoman, 35&quot;W, Merlot\",\"description\":\"A perfect combination of style and practicality, this modern square ottoman is a great addition to any seating area. Its generous size and sturdy build allow it to work as a comfy footrest or a place to rest a tray of snacks. 35&quot;W x 35&quot;D x 16&quot;H Solid pine frame and legs with linen/viscose blend fabric Modern casual Practical design for use as extra seating or a footrest Minimal assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Benton Square Ottoman, 35&quot;W, Merlot\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GnNvRXh-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yxaaQVH4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yxaaQVH4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t+wCDOgyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t+wCDOgyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812hlBNMxoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812hlBNMxoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1schBYdWsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1schBYdWsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1OYGduwhCS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1OYGduwhCS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]}