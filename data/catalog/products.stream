    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9QCZ1\",\"sku\":\"B07QF9QCZ1\",\"lang\":\"en\",\"slug\":\"rivet-corban-contemporary-media-cabinet-59-w-gray-b07qf9qcz1\",\"name\":\"Rivet Corban Contemporary Media Cabinet, 59&quot;W, Gray\",\"description\":\"This contemporary media cabinet with clean lines and sturdy metal legs brings a modern flair into any room. The 2 cabinet doors open easily using the pocket pulls, while the cabinet offers plenty of storage space for media components and accessories. The gray tone matches most decors. 59&quot;W x 16&quot;D x 31&quot;H 80% MDF, 20% metal Sleek lines with sturdy metal legs bring a contemporary look to this media cabinet, making it a great match for modern decor. This media cabinet offers 2 doors with pocket pulls and stands on sturdy metal legs. Assemble in 15-30 minutes Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Corban Contemporary Media Cabinet, 59&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91a-+JuW3tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Wr0dJmqfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Wr0dJmqfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t7mPD-WNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t7mPD-WNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NpIg49mSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NpIg49mSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p3DhBOv4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p3DhBOv4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Ef7uqyXBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A