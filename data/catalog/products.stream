    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PRNS\",\"sku\":\"B075X4PRNS\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-centuryvelvet-tufted-customizable-daybed-sofa-78-w-hunter-green-amp-black-b075x4prns\",\"name\":\"Rivet Uptown Mid-CenturyVelvet Tufted Customizable Daybed Sofa, 78&quot;W, Hunter Green &amp; Black\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and blackened pewter metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-CenturyVelvet Tufted Customizable Daybed Sofa, 78&quot;W, Hunter Green &amp; Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jYbAaUKPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81++GsPX1KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81++GsPX1KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9110NPGmzEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9110NPGmzEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ei9WqhXWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ei9WqhXWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h9w0z1ZsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h9w0z1ZsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SQWKtMQ7L.jpg\",\"url\":\"https://storage.googlea