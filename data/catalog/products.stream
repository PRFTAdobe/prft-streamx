    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B79WSKT\",\"sku\":\"B07B79WSKT\",\"lang\":\"en\",\"slug\":\"rivet-federal-mid-century-modern-wood-dining-buffet-sideboard-cabinet-credenza-storage-brown-b07b79wskt\",\"name\":\"Rivet Federal Mid-Century Modern Wood Dining Buffet Sideboard, Cabinet Credenza, Storage, Brown\",\"description\":\"This mid-century modern buffet will add stylish storage to your dining room but can be used in other rooms as well. Four drawers and adjustable shelves are flexible for silverware and dishes -- or other treasured items in a living area or hallway. 19&quot;L x 62&quot;W x 36&quot;H Sturdy construction and durable hardwoods Mid-century modern retro style Can be used in dining room or other rooms where you need stylish storage Simple assembly in 30 minutes or less; bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Federal Mid-Century Modern Wood Dining Buffet Sideboard, Cabinet Credenza, Storage, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UhhzzqkpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LitV6FtxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LitV6FtxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CubRSsT7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CubRSsT7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jSOq5MHvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jSOq5MHvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19VhynTwAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19VhynTwAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"143.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Credenza\",\"label\":\"Credenza\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Buffet\",\"label\":\"Buffet\"},{\"value\":\"Sideboard\",\"label\":\"Sideboard\"},{\"value\":\"Wine cabinet\",\"label\":\"Wine cabinet\"},{\"value\":\"Buffet cabinet\",\"label\":\"Buffet cabinet\"},{\"value\":\"Sideboards and buffet tables with storage\",\"label\":\"Sideboards and buffet tables with storage\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Bar\",\"label\":\"Bar\"},{\"value\":\"Sideboards\",\"label\":\"Sideboards\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Liquor cabinet\",\"label\":\"Liquor cabinet\"},{\"value\":\"Sideboard buffet\",\"label\":\"Sideboard buffet\"},{\"value\":\"Buffet table\",\"label\":\"Buffet table\"}]}],\"categories\":[{\"id\":\"Buffets & Sideboards\",\"slug\":\"buffets-&-sideboards\",\"name\":\"Buffets & Sideboards\",\"value\":\"Buffets & Sideboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":818,\"discountedValue\":736.2}}"
