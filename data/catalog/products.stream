  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853J3XKZ\",\"sku\":\"B0853J3XKZ\",\"lang\":\"en\",\"slug\":\"rivet-curved-upholstered-headboard-with-nailhead-trim-queen-60-w-beige-b0853j3xkz\",\"name\":\"Rivet Curved Upholstered Headboard with Nailhead Trim, Queen, 60&quot;W, Beige\",\"description\":\"This lovely classic headboard features decorative nailhead detailing that gives the curved design a touch of sophistication and an heirloom look. The padded frame and beige upholstery make this the perfect neutral addition to any bedroom suite. 60&quot;W x 3.5&quot;D x 42&quot;–50&quot;H The well-constructed wood frame is padded with polyurethane foam for added comfort. The legs of this headboard adjust to 3 different heights, allowing it to attach to any standard bed frame. The arched design has notched corners, perfectly accented by decorative nailhead trim that lends instant eye-catching appeal to your space. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Curved Upholstered Headboard with Nailhead Trim, Queen, 60&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713059ugd+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811lqdlRjqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811lqdlRjqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61KkSVt4LPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61KkSVt4LPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mhNXK6QBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mhNXK6QBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iLACR36LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iLACR36LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71s6SQHhYoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71s6SQHhYoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SfdUZC0AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SfdUZC0AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71frd3EyreL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71frd3EyreL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"50.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"3.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"60.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"25.7\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Footboard\",\"label\":\"Footboard\"},{\"value\":\"Progressive\",\"label\":\"Progressive\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Zinus\",\"label\":\"Zinus\"},{\"value\":\"Tufted\",\"label\":\"Tufted\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":783,\"discountedValue\":704.7}}"
