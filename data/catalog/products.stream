    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4QMTN\",\"sku\":\"B075X4QMTN\",\"lang\":\"en\",\"slug\":\"rivet-clover-modern-glam-velvet-brass-arm-accent-chair-27-25-w-navy-b075x4qmtn\",\"name\":\"Rivet Clover Modern Glam Velvet Brass Arm Accent Chair, 27.25&quot;W, Navy\",\"description\":\"Add modern glamour to any room with this high-style accent chair.  A contemporary design with combined materials of plush velvet and brushed brass metal, it's as comfortable as it is sophisticated. 27.25&quot;W x  33''D x 32''H Steel with a brushed brass finish; soft 100% cotton velvet A clean, modern look with minimal lines and shape No assembly.  Wipe with a dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Clover Modern Glam Velvet Brass Arm Accent Chair, 27.25&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IZ4WjDMNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MAFG78kBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MAFG78kBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KadqMmREL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KadqMmREL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h3fxyD7tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h3fxyD7tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911935hoAdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911935hoAdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911hrVYrokL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911hrVYrokL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"value