    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082BL45ZV\",\"sku\":\"B082BL45ZV\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-swivel-home-office-task-chair-25-5-w-beige-with-nickel-finish-b082bl45zv\",\"name\":\"Rivet Modern Upholstered Swivel Home Office Task Chair, 25.5&quot;W, Beige with Nickel Finish\",\"description\":\"The soft, curved lines of this adjustable office chair will be a welcome addition to any space. The low back and arms give it a less-imposing profile suitable for a modern workplace or home office. 25.5&quot;W x 25.75&quot;D x 34&quot;–37.75&quot;H; seat height: 19.25&quot;–23&quot; Soft, contoured cushions are upholstered in a neutral desert-colored fabric. This chair has a 360-degree swivel mechanism with height and tension adjustments to accommodate your work style. This simple design focuses on comfort and functionality. Assemble in 15-30 minutes Always use on firm, level ground. Do not stand on the seat or let children play with this chair. Check (and if necessary, tighten) all screws every 90 days. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Swivel Home Office Task Chair, 25.5&quot;W, Beige with Nickel Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QO9j6YYbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YzfnmJq8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YzfnmJq8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jhrrF3sOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jhrrF3sOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6QVL2NgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6QVL2NgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81R-vPkJgoL.jpg\",\"url\":\"https://storage.googleapis.com/pur