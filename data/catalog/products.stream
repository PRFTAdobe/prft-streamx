    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QC5N35\",\"sku\":\"B082QC5N35\",\"lang\":\"en\",\"slug\":\"rivet-theresa-modern-upholstered-accent-chair-30-w-charcoal-b082qc5n35\",\"name\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Charcoal\",\"description\":\"A great fit for a fireside evening or just to lounge around in, this modern upholstered chair is the perfect addition to any room in your home. The slightly curved armrests add a touch of class, and the reversible seat cushion allows for longer wear. This item is made to order just for you. 30&quot;W x 31&quot;D x 33&quot;H; seat height: 20&quot;H; seat depth: 21&quot;D; seat back height: 13&quot;H; arm height: 24&quot;H; leg height: 12&quot;H This chair has a sturdy wood frame and legs. Foam seat cushions provide lasting support and comfort. Upholstery is 100% polyester. No assembly required; removable and reversible seat cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fEjRyfOPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IVNrHR7EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IVNrHR7EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O13nGm+0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O13nGm+0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iPSh16VxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iPSh16VxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UBz7NwctL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UBz7NwctL.jpg\"},{\"alt\":\"https://s