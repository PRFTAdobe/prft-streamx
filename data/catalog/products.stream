  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M26ZJ\",\"sku\":\"B07B4M26ZJ\",\"lang\":\"en\",\"slug\":\"andover-modern-sofa-couch-78-w-grey-b07b4m26zj\",\"name\":\"Andover Modern Sofa Couch, 78&quot;W, Grey\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 78&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; choose the configuration thats right for you Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Sofa Couch, 78&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913B9cEczhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XkeBZIxFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XkeBZIxFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tyqx+V7AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tyqx+V7AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELdgTslyS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELdgTslyS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tNAK2IT2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim