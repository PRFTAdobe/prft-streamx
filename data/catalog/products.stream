        "bytes": "{\"id\":\"B075QG3JWL\",\"sku\":\"B075QG3JWL\",\"lang\":\"en\",\"slug\":\"rivet-kyler-mid-century-upholstered-tufted-queen-bed-with-headboard-66-w-charcoal-b075qg3jwl\",\"name\":\"Rivet Kyler Mid-Century Upholstered Tufted Queen Bed with Headboard, 66&quot;W, Charcoal\",\"description\":\"Thoughtfully designed for small spaces, this bed will bring streamlined sophistication to your modern room. The headboard features simple tufting and a subtle wingback, while low-profile side rails and footboard complete the clean, simple profile. 88.2&quot;L x 66&quot;W x 45.3&quot;H Charcoal fabric Mid-century modern-inspired tufting and low-profile side rails and footboard; simple tapered legs Designed to fit a smaller bedroom, with room underneath for some storage. No boxspring required. Assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kyler Mid-Century Upholstered Tufted Queen Bed with Headboard, 66&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z7s5G-E3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-dQrsiZmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-dQrsiZmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tBBNeDOlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tBBNeDOlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TcPUXy8FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TcPUXy8FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B143pYqY-WS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B143pYqY-WS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Eu4v2bxtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Eu4v2bxtS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"45.2875\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"88.2\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"66.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"94.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"},{\"value\"