    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G5RBN\",\"sku\":\"B07B4G5RBN\",\"lang\":\"en\",\"slug\":\"varon-modern-lounge-daybed-chaise-34-2-w-dark-grey-b07b4g5rbn\",\"name\":\"Varon Modern Lounge Daybed Chaise, 34.2&quot;W, Dark Grey\",\"description\":\"With modern low-slung arms and luxuriously soft upholstery, this chaise lounge will beckon you to rest and relax. An exposed wood base adds a touch of traditional and rustic, giving this piece a transitional style that will blend with most décor. 34.2&quot;W x 68.9&quot;D x 33.4&quot;H Canvas material on wood frame; wood legs Elements of modern and traditional combine in a transitional style Great for an afternoon nap or extra seating for guests Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Varon Modern Lounge Daybed Chaise, 34.2&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UiRD6UcHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h70Nhq-DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h70Nhq-DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YRmC1+i7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YRmC1+i7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LQP9nA78L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LQP9nA78L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916H7zbHEnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916H7zbHEnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1muIFK5MjS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1muIFK5MjS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\"