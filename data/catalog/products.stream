    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4SCB6T\",\"sku\":\"B07B4SCB6T\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-queen-bed-66-w-spinnsol-cocoa-b07b4scb6t\",\"name\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Spinnsol Cocoa\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 66&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Spinnsol Cocoa\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cVhl8HXmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aLkCO2DiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aLkCO2DiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JtPJ1RluL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JtPJ1RluL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8117b+7avFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8117b+7avFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M9ydsbaVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M9ydsbaVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wwXvnuqyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/9