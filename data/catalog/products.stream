    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FWGZS\",\"sku\":\"B07B4FWGZS\",\"lang\":\"en\",\"slug\":\"andover-sofa-couch-90-w-saddle-colored-leather-b07b4fwgzs\",\"name\":\"Andover Sofa Couch, 90&quot;W, Saddle-Colored Leather\",\"description\":\"Complete your living space with this stylish sofa. With its saddle-colored upholstery, this sofa is an ideal accent for transitional-style home decor.The solid-wood frame enhances durability and extends this sofa’s life. Overall: 90&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Sofa Couch, 90&quot;W, Saddle-Colored Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yvamsDT2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YPaN7fQ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YPaN7fQ2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fXB6HQ2dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fXB6HQ2dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812TbnXtF4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812TbnXtF4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x+3VbfiTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x+3VbfiTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a0KLgTvxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a0KLgTvxL.jpg\"},{\"alt\":\"htt