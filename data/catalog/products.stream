    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BPZMH\",\"sku\":\"B07B7BPZMH\",\"lang\":\"en\",\"slug\":\"rivet-ferry-modern-industrial-dining-room-kitchen-chairs-36-h-set-of-2-blue-green-b07b7bpzmh\",\"name\":\"Rivet Ferry Modern Industrial Dining Room Kitchen Chairs, 36&quot;H, Set of 2 - Blue/Green\",\"description\":\"A fun retro vibe makes these chairs eclectic and modern. Clever metal leg bases are left exposed a short way up the sides for an extra industrial touch. The armless style is compact for the dining table or other rooms in need of extra seating. 19.2&quot;W x 25.9&quot;D x 35.8&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 18.1&quot;D; Seat Back Height: 16.5&quot;H; Arm Height: 19.2&quot;H Metal frames with cotton fabric Modern industrial with a retro vibe Use as dining room chair or as extra chair in living room or bedroom No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ferry Modern Industrial Dining Room Kitchen Chairs, 36&quot;H, Set of 2 - Blue/Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DRvPp13BL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qvnfZkODL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qvnfZkODL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ITt41KR1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ITt41KR1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMBVo7UGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMBVo7UGS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915UL-YYWOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915UL-YYWOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eJcWoIjjL.jpg\",\"url\":\"https://storage.googlea