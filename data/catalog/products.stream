    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4SZF\",\"sku\":\"B07QFP4SZF\",\"lang\":\"en\",\"slug\":\"faraday-down-filled-casual-living-room-chair-47-w-light-grey-b07qfp4szf\",\"name\":\"Faraday Down-Filled Casual Living Room Chair, 47&quot;W, Light Grey\",\"description\":\"This modern living room chair comes with removable and reversible down-filled cushions for comfort. Roomy seating is nice with company or family, and the neutral tone matches most decor, making it a great choice for any room. The luxury of a cotton-blend upholstery helps keep everyone cool through the summer. 47&quot; Width x 43&quot; Depth x 33&quot; Height Solid hardwood frame with down-filled seat and back cushions Removable and reversible cushions This casual living room chair offers down-filled cushions and a seat depth of 43&quot; for extra comfort. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Faraday Down-Filled Casual Living Room Chair, 47&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sT4q5zVDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B159POtBRiS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B159POtBRiS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915dE+VAMGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915dE+VAMGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U8CnSIb2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U8CnSIb2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12vKrW7MnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12vKrW7MnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CM7TwLnyL.jpg\",\"url\":\"https://stor