    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FHX\",\"sku\":\"B075X43FHX\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-sandstone-b075x43fhx\",\"name\":\"Marin Studded Chair, 33&quot;W, Sandstone\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l70evTsyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kFFYz26UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kFFYz26UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pEjlJJL9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pEjlJJL9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ntVoUEIbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ntVoUEIbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nE0dJWvKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nE0dJWvKL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label