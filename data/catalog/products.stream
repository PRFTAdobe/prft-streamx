    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC11SF6\",\"sku\":\"B07PC11SF6\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sofa-with-tapered-wood-legs-87-w-dark-grey-b07pc11sf6\",\"name\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Dark Grey\",\"description\":\"This sofa features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive gray fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 87&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs Removable and reversible back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SYiLkvN6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91roRZX3j6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91roRZX3j6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OOPodawqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OOPodawqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TxArOWQ3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TxArOWQ3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17RYR9c6BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17