    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L6C47\",\"sku\":\"B07B4L6C47\",\"lang\":\"en\",\"slug\":\"andover-modern-sofa-couch-78-w-linen-b07b4l6c47\",\"name\":\"Andover Modern Sofa Couch, 78&quot;W, Linen\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. 78&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Cotton/polyester blend fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Sofa Couch, 78&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u1nJvgGhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RTeBwgL5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RTeBwgL5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OP87BTSaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OP87BTSaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nfaz12VCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nfaz12VCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RO1pw7bhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RO1pw7bhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LAwY2g9GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LAwY2g9GL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"25.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"78&quot; sofa\",\"label\":\"78&quot; sofa\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Linen\",\"label\":\"Linen\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":850,\"discountedValue\":765.0}}"
