    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBHLJ\",\"sku\":\"B07QCMBHLJ\",\"lang\":\"en\",\"slug\":\"anne-marie-contemporary-sofa-couch-91-5-w-charcoal-b07qcmbhlj\",\"name\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Charcoal\",\"description\":\"This sofa’s modern take on a classic design perfectly enhances your transitional-style home decor without sacrificing comfort. The cushions are reversible to enhance durability and prolong this sofa’s life. Overall: 91.5&quot;W x 40&quot;D x 39&quot;H. Seat height: 21&quot;H; seat depth: 22&quot;D; seat back height Sturdy wood frame and legs with durable 100% polypropylene upholstery Loose seat and back cushions are reversible to help keep this item looking great over time Classic meets contemporary for an ideal modern farmhouse feel Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9104ShN7N3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vuHhJi92L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vuHhJi92L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wNsrFIIpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wNsrFIIpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xeIvH2CRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xeIvH2CRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qs1gbWlrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qs1gbWlrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jbpwIBoSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-