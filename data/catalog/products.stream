    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSBJ7J9\",\"sku\":\"B07HSBJ7J9\",\"lang\":\"en\",\"slug\":\"woodley-modern-kitchen-dining-room-chairs-set-of-2-40-h-navy-blue-b07hsbj7j9\",\"name\":\"Woodley Modern Kitchen Dining Room Chairs, Set of 2, 40&quot;H, Navy Blue\",\"description\":\"This classic Parsons-style chair is a perfect middle ground between rustic, farmhouse charm and sleek, contemporary sophistication. The squared frame, natural wooden legs, and navy upholstery are equally at home in a minimalist modern or cozy homespun motif. Solid wood frame, fabric Versatile style is ideal for both farmhouse and modern-contemporary looks. 24&quot;D x 17.5&quot;W x 40&quot;H, 2PCS/CTN No assembly required Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Woodley Modern Kitchen Dining Room Chairs, Set of 2, 40&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JUpLz2sKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SuRuf6fHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SuRuf6fHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FIn6k7QtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FIn6k7QtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i+UsjYANL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i+UsjYANL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816skz+wZVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816skz+wZVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0nNQVZtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0nNQVZtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},