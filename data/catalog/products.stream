    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GSN5K\",\"sku\":\"B07B4GSN5K\",\"lang\":\"en\",\"slug\":\"andover-leather-loveseat-sofa-67-w-charcoal-b07b4gsn5k\",\"name\":\"Andover Leather Loveseat Sofa, 67&quot;W, Charcoal\",\"description\":\"Complete your living space with this stylish loveseat. With its charcoal-colored upholstery, this loveseat is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this loveseat’s life. Overall: 67&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Loveseat Sofa, 67&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/610COOLJaoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LhqZk91nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LhqZk91nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rkbjJHwDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rkbjJHwDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AjQGewrrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AjQGewrrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913tLAPpgHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913tLAPpgHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18WhIFcc+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18WhIFcc+L.jpg\"}],\"attri