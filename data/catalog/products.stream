    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BM55W\",\"sku\":\"B07B7BM55W\",\"lang\":\"en\",\"slug\":\"reclaimed-fir-rustic-wood-dining-kitchen-table-78-8-l-brown-b07b7bm55w\",\"name\":\"Reclaimed Fir Rustic Wood Dining Kitchen Table, 78.8&quot;L, Brown\",\"description\":\"Reclaimed fir wood and ladder-rung pedestals give this table simple rustic beauty. Warm natural wood tones make your space inviting, while sturdy construction will make this piece last through many family dinners. 37.4&quot;W x 78.74&quot;L x 29.9&quot;H Made of hardwood comprised of 100% reclaimed fir A simple, natural style that will work with modern farmhouse décor A dining table that can double as a work or craft space Assembly in 30 minutes or less; attach base to top Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Reclaimed Fir Rustic Wood Dining Kitchen Table, 78.8&quot;L, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812GlDb4GEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p5PTgXF4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p5PTgXF4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q8o-aijNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q8o-aijNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pF1GI6unL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pF1GI6unL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TrADI-EdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TrADI-EdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":