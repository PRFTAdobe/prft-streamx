    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W339RK\",\"sku\":\"B084W339RK\",\"lang\":\"en\",\"slug\":\"vivianne-modern-upholstered-dining-chair-with-casters-24-4-w-slate-b084w339rk\",\"name\":\"Vivianne Modern Upholstered Dining Chair with Casters, 24.4&quot;W, Slate\",\"description\":\"This beautiful modern chair will add a touch of class to your dining room. Comfortable and softly elegant, this slate-colored upholstered chair combines form and function. Reimagine your space with a contemporary flair, and enjoy a quiet dinner for two or fabulous seating for twelve! 24.4&quot;W x 27.6&quot;D x 36.2&quot;H; seat height: 20.9&quot;H; seat depth: 17.3&quot;D; seat back height: 33.1&quot;H; arm height: 25.6&quot;H; leg height: 2&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric These chairs have wheels, which makes them easy to move and comfortable to adjust. Feather-filled cushions provide great comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Vivianne Modern Upholstered Dining Chair with Casters, 24.4&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FNorIDTsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KlcafU2rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KlcafU2rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K++Cjy7rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K++Cjy7rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PJ2-V1dhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PJ2-V1dhL.jpg\"},