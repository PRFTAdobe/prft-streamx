  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QC7YKR\",\"sku\":\"B082QC7YKR\",\"lang\":\"en\",\"slug\":\"rivet-theresa-modern-upholstered-accent-chair-30-w-berry-b082qc7ykr\",\"name\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Berry\",\"description\":\"A great fit for a fireside evening or just to lounge around in, this modern upholstered chair is the perfect addition to any room in your home. The slightly curved armrests add a touch of class, and the reversible seat cushion allows for longer wear. This item is made to order just for you. 30&quot;W x 31&quot;D x 33&quot;H; seat height: 20&quot;H; seat depth: 21&quot;D; seat back height: 13&quot;H; arm height: 24&quot;H; leg height: 12&quot;H This chair has a sturdy wood frame and legs. Foam seat cushions provide lasting support and comfort. Upholstery is 100% polyester. No assembly required; removable and reversible seat cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Berry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jnPUkMWXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AcMDWRaLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AcMDWRaLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/619oSoF2S6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/619oSoF2S6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T+9MMjXEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T+9MMjXEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hxIHpgZfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hxIHpgZfL.jpg\"},{\"alt\":\"https://storage.go