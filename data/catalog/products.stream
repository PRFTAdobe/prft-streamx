    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0728NVXWL\",\"sku\":\"B0728NVXWL\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-sofa-couch-97-w-ecru-b0728nvxwl\",\"name\":\"Hoffman Down-Filled Performance Fabric Sofa Couch, 97&quot;W, Ecru\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 97”W x 39.5”D x 37”H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Sofa Couch, 97&quot;W, Ecru\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GhbK-H1wL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ts1vaBI1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ts1vaBI1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fOmFXc4UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fOmFXc4UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-eqrjJ2GS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-eqrjJ2GS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kr8-qo5fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kr8-qo5fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kPj1M+2lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kPj1M+2lL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"lab