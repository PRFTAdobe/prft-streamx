"value\":\"Reclinable\",\"label\":\"Reclinable\"},{\"value\":\"Under\",\"label\":\"Under\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Home\",\"label\":\"Home\"},{\"value\":\"Armchair\",\"label\":\"Armchair\"},{\"value\":\"Sillones\",\"label\":\"Sillones\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Seats\",\"label\":\"Seats\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Theater\",\"label\":\"Theater\"},{\"value\":\"2\",\"label\":\"2\"},{\"value\":\"200\",\"label\":\"200\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Single\",\"label\":\"Single\"},{\"value\":\"Of\",\"label\":\"Of\"},{\"value\":\"Spaces\",\"label\":\"Spaces\"},{\"value\":\"Slim\",\"label\":\"Slim\"},{\"value\":\"On\",\"label\":\"On\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":476,\"discountedValue\":428.4}}"
