    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8ST73W\",\"sku\":\"B07P8ST73W\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-leather-sofa-couch-with-hardwood-frame-89-w-cognac-b07p8st73w\",\"name\":\"Lauren Down-Filled Oversized Leather Sofa Couch with Hardwood Frame, 89&quot;W, Cognac\",\"description\":\"Dimensions: 89&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this sofa offers plush support and security. Neutral cognac-colored leather upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Leather Sofa Couch with Hardwood Frame, 89&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qu2buBC4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8115z258GhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8115z258GhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BXp2uls4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BXp2uls4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KvDPavz0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KvDPavz0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TJaf3h4RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TJaf3h4RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ovc95AefL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pi