    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B83KVGH\",\"sku\":\"B07B83KVGH\",\"lang\":\"en\",\"slug\":\"rivet-modern-rustic-rolling-bar-cart-with-wheels-32-inch-height-wood-with-black-iron-finish-b07b83kvgh\",\"name\":\"Rivet Modern Rustic Rolling Bar Cart with Wheels, 32 Inch Height, Wood with Black Iron Finish\",\"description\":\"Deliver modern rustic style to your guests, along with the drinks and snacks, with this rolling bar cart. A black-finished metal frame holds three wood shelves, for a design that blends well in modern, industrial settings or even farmhouse settings. 14.2&quot;W x 30&quot;D x 31.7&quot;H Hardwood shelves with natural looking finish; iron frame with black finish; metal casters Wood and metal combine for a style that works in modern, industrial or farmhouse décor Casters allow you to roll it between rooms Assembly in 15 minutes; just screw on casters Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Rustic Rolling Bar Cart with Wheels, 32 Inch Height, Wood with Black Iron Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rJR-KpGAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gsbwqyY3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gsbwqyY3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-EaJJ9uYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-EaJJ9uYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71w7-p9cPaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71w7-p9cPaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jIGRp0m6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jIGRp0m6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IKM-TbrLL.jpg\",\"url\":\"htt