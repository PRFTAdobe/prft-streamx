{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":635,\"discountedValue\":571.5}}"
