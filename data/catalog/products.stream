    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSDRZL6\",\"sku\":\"B07HSDRZL6\",\"lang\":\"en\",\"slug\":\"wickstrom-upholstered-dining-chair-with-arms-26-w-caribbean-sand-beige-b07hsdrzl6\",\"name\":\"Wickstrom Upholstered Dining Chair with Arms, 26&quot;W, Caribbean Sand Beige\",\"description\":\"A modern twist on the classic wingback dining chair, this beautiful piece is upholstered in versatile neutral fabric to highlight its plush, luxurious curves and cushions. Overall: 27&quot;D x 26&quot;W x 37&quot;H. Seat height: 20&quot; Solid wood frame and legs Oversized seat cushion provides supreme comfort for all seating needs Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Wickstrom Upholstered Dining Chair with Arms, 26&quot;W, Caribbean Sand Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nvC1VdiFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uiEmBfy2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uiEmBfy2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OedGaQy8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OedGaQy8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JSQ5G5pVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JSQ5G5pVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mp-Sv7hXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mp-Sv7hXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BWpAyyziL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BWpAyyziL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\"