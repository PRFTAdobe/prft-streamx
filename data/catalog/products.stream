        "bytes": "{\"id\":\"B073ZPDT2R\",\"sku\":\"B073ZPDT2R\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-ottoman-41-w-grey-tweed-b073zpdt2r\",\"name\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot;W, Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this ottoman has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 41&quot;W x 41&quot;D x 21&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot;W, Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxPKYW1aL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1wnnOFloAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1wnnOFloAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915pyf97rjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915pyf97rjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Inapsh8PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Inapsh8PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1Dph7ojL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1Dph7ojL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GkPJjoBoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GkPJjoBoL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},