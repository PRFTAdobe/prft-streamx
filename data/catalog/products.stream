    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LMCLD\",\"sku\":\"B07P5LMCLD\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-loveseat-with-tufted-back-64-2-w-emerald-green-b07p5lmcld\",\"name\":\"Rivet Sloane Mid-Century Modern Loveseat with Tufted Back, 64.2&quot;W, Emerald Green\",\"description\":\"This modern loveseat sports a tufted back, a strong profile, and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The durable upholstery and solid-wood frame make this piece both cozy and reliable. 64.2&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; 100% polyester upholstery A solid wood frame and durable fabric make this loveseat as practical as it is stylish. A tufted back adds elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Loveseat with Tufted Back, 64.2&quot;W, Emerald Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ubOwANNhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91srgZBBI5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91srgZBBI5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H3QPi0ZSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H3QPi0ZSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dfYyMyjhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dfYyMyjhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XU7tRwcZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XU7tRwcZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-yI39U8bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-