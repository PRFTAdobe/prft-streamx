      "content": {
        "bytes": "{\"id\":\"B071ZLY13G\",\"sku\":\"B071ZLY13G\",\"lang\":\"en\",\"slug\":\"dalton-performance-fabric-loveseat-sofa-couch-63-5-w-sand-b071zly13g\",\"name\":\"Dalton Performance Fabric Loveseat Sofa Couch, 63.5&quot;W, Sand\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this arm chair. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 63.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Performance Fabric Loveseat Sofa Couch, 63.5&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913ftugnmAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DQxVboqRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DQxVboqRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1clby7Lw4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1clby7Lw4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l30A9Y-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l30A9Y-gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1P0lNoEwdS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1P0lNoEwdS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13FuK2I7rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13FuK2I7rL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inc