    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZPGWC\",\"sku\":\"B07B4ZPGWC\",\"lang\":\"en\",\"slug\":\"prudence-tufted-king-bed-84-w-classic-cream-b07b4zpgwc\",\"name\":\"Prudence Tufted King Bed, 84&quot;W, Classic Cream\",\"description\":\"This bed adds classic style to any space. A hand-tufted headboard adds an interesting design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Prudence Tufted King Bed, 84&quot;W, Classic Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eG3lHJwiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bGIh1JflL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bGIh1JflL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qA0n6+K4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qA0n6+K4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9117apuq50L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9117apuq50L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EbAN6fVGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EbAN6fVGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZzMcDGHEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZzMcDGHEL.jpg\"},{\"alt\":\"https://storage.googleapis.