    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072ZMT5R7\",\"sku\":\"B072ZMT5R7\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-round-black-wood-nesting-side-end-table-20-5-w-dark-oak-b072zmt5r7\",\"name\":\"Rivet Mid-Century Modern Round Black Wood Nesting Side End Table, 20.5&quot; W, Dark Oak\",\"description\":\"Suited for small spaces, each table is sold individually so it can be used on its own or nested as a pair. Park your remote control as you watch TV or use to serve snacks at your next party - they're just what you need beside your sofa or chair. 20.5&quot;Diameter x 20.9&quot;H Solid hardwood with dark oak finish Round modern tables with classic finish will blend with traditional and modern décor. Ideal for a tight corner next to a sofa, or for serving drinks and snacks No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Round Black Wood Nesting Side End Table, 20.5&quot; W, Dark Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8157SGpGjeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919Y+fwuupL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919Y+fwuupL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19REpEfY3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19REpEfY3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gSDU5N13L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gSDU5N13L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LzyWtuIFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LzyWtuIFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SCPz+cGtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori