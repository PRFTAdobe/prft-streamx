    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072JG3WN7\",\"sku\":\"B072JG3WN7\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-living-room-accent-armchair-with-hardwood-frame-46-w-fawn-b072jg3wn7\",\"name\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Fawn\",\"description\":\"Dimensions: 46.1&quot;W x 44.9&quot;D x 37.4&quot;H Get comfort you can literally sink into with this classically styled, overstuffed chair. A clean and simple silhouette with track arms in a durable performance fabric, it's the perfect addition for your cozy corner. Solid hardwood frame with moisture repellent, stain resistant fabric Timeless casual Exceptional comfort with high performance fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Fawn\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gxg9p2jcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1klQCRfKLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1klQCRfKLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16F+CWbY+S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16F+CWbY+S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yCg9TJurL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yCg9TJurL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z4VVlOttL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z4VVlOttL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13frMkWUaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13frMkWUaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"