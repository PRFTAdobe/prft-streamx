    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071FJR3SR\",\"sku\":\"B071FJR3SR\",\"lang\":\"en\",\"slug\":\"glenwood-industrial-metal-chest-of-drawers-52-h-oak-b071fjr3sr\",\"name\":\"Glenwood Industrial Metal Chest of Drawers, 52&quot;H, Oak\",\"description\":\"This industrial chest of drawers features robust metal pulls on its five drawers and a matching metal accent piece on the bottom. Solid hardwood construction is finished with quarter-sawn oak veneer and wire-brushed for a distressed look. 38&quot; W x 19&quot; D x 52&quot; H Solid hardwood with oak veneer and metal drawer pull and base A bold industrial design is softened by a classic wood finish to blend with modern décor. Self-closing drawers are suspended on concealed ball-bearing extension glides No assembly needed. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Glenwood Industrial Metal Chest of Drawers, 52&quot;H, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R0Lpmme9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ommZEKCNS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ommZEKCNS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hAHTc+B4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hAHTc+B4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HmtlbeGvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HmtlbeGvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A116nKpYsXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A116nKpYsXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91758oi7D3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91758oi7D3L.jpg\"}],\"attributes\":[{\"name\":\"hei