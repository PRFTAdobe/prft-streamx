    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LP2LQ\",\"sku\":\"B07P5LP2LQ\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-classic-sofa-92-9-w-pepper-b07p5lp2lq\",\"name\":\"Bradbury Chesterfield Classic Sofa, 92.9&quot;W, Pepper\",\"description\":\"This lovely sofa has the low button-tufted back, scroll arms, and short legs that are the hallmark of the classic chesterfield style. Whether as a statement piece or part of a living-room suite, this sofa will be a welcome addition to any decor. Dimensions: 93&quot;W x 39&quot;D x 30&quot;H Solid hardwood frame; upholstery: 98% polyester, 2% nylon Removable and reversible seat cushions A classic style updated in stain-resistant fabric makes this perfect for the modern home. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Classic Sofa, 92.9&quot;W, Pepper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TWkL8tCHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818mg46NSKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818mg46NSKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DaHGdsAsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DaHGdsAsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WpztbV1XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WpztbV1XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wc3+pCXWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wc3+pCXWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mVpfRvuWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mVpfRvuWL.jpg\"},{\"alt\":\"https://storage.googleapis.