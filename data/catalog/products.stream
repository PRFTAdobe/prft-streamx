    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCVWWF\",\"sku\":\"B082QCVWWF\",\"lang\":\"en\",\"slug\":\"rivet-spear-mid-century-modern-channel-tufted-leather-accent-chair-with-wood-arms-29-1-w-grey-b082qcvwwf\",\"name\":\"Rivet Spear Mid-Century Modern Channel Tufted Leather Accent Chair with Wood Arms, 29.1&quot;W, Grey\",\"description\":\"Classic design features get a modern twist in this chic channel-back accent chair. The tufted upholstery comes in a gray leather sure to fit with any design scheme. A curved back and wooden armrests provide support and an elegant look that will add a finishing touch wherever you need seating. 29.1&quot;W x 31.5&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 24.4&quot;D; seat back height: 21.7&quot;H; arm height: 25.2&quot;H; leg height: 11&quot;H Solid ash frame, leather upholstery Add elegance to any seating area with the classic design features of this channel-back chair. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Spear Mid-Century Modern Channel Tufted Leather Accent Chair with Wood Arms, 29.1&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IGT8P3zcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z3ZfUMXhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z3ZfUMXhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716ZKtNzqUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716ZKtNzqUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JUZERxYdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JUZERxYdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZE+HkkqML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81