    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GXWP5\",\"sku\":\"B07B4GXWP5\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-chaise-sofa-sectional-115-w-rouge-red-b07b4gxwp5\",\"name\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Rouge Red\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jxga3KbCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aUrVe09NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aUrVe09NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pb0pymiEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pb0pymiEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/613c-95SoUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/613c-95SoUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gP9wk6U3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gP9wk6U3L.jpg\"},{\"alt\":\"https://storage.googleap