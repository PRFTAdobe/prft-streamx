    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P9Y6WHB\",\"sku\":\"B07P9Y6WHB\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-leather-sofa-with-tapered-wood-legs-87-w-dark-brown-b07p9y6whb\",\"name\":\"Rivet Aiden Mid-Century Leather Sofa with Tapered Wood Legs, 87&quot;W, Dark Brown\",\"description\":\"This sofa features easy-care leather with removable cushions that will help keep cleaning simple, and the attractive brown color will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 87&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable and reversible back cushions Mid-century style and top grain leather combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Leather Sofa with Tapered Wood Legs, 87&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814b55i+q5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Hl7g0eByL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Hl7g0eByL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XT2zV9h6S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XT2zV9h6S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g8lOPTVfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g8lOPTVfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rLMOvEwtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rLMOvEwtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8152634zKOL.jpg\",\"url\":\"https://storage.goog