    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B77WQ7L\",\"sku\":\"B07B77WQ7L\",\"lang\":\"en\",\"slug\":\"crawford-modern-wood-dining-room-kitchen-chairs-with-arms-38-75-h-set-of-2-grey-b07b77wq7l\",\"name\":\"Crawford Modern Wood Dining Room Kitchen Chairs with Arms, 38.75&quot;H, Set of 2, Grey\",\"description\":\"23.25&quot;W x 24.75&quot;D x 38.75&quot;H; Seat Height: 19&quot;H ; Seat Depth: 18.6&quot;D; Seat Back Height: 21&quot;H; Arm Height: 25&quot;H Hardwood legs and frame; cushion and back inset have performance fabric upholstery A graceful style with rustic finish, ideal for a transitional or modern farmhouse décor Quality materials and construction are designed to outlast a busy family Assembly required Free returns for 30 days. 3-year warranty. Distressed rustic finish is paired with elegant design in this armchair. A gracefully curved back has fabric insets on the front and rear. Quality hardwood and construction techniques ensure it will last through many family dinners.\",\"primaryImage\":{\"alt\":\"Crawford Modern Wood Dining Room Kitchen Chairs with Arms, 38.75&quot;H, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z94AKnXyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEDl4LJnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEDl4LJnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I2m0dNi6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I2m0dNi6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OmmjUTyoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OmmjUTyoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P1S2XEeNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P1S2XEeNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pu