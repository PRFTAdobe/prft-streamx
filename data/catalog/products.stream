    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M2BC1\",\"sku\":\"B07B4M2BC1\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-chaise-sofa-sectional-115-w-slate-brown-b07b4m2bc1\",\"name\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Oa0yyXHZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1wzghzDeAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1wzghzDeAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I9PYk7EPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I9PYk7EPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vuw4caJ7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vuw4caJ7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hBEtUHXhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hBEtUHXhL.jpg\"},{\"alt\":\"https://storage