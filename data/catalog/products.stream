        "bytes": "{\"id\":\"B0888M8SYT\",\"sku\":\"B0888M8SYT\",\"lang\":\"en\",\"slug\":\"racing-gaming-style-office-chair-white-b0888m8syt\",\"name\":\"Racing/Gaming Style Office Chair - White\",\"description\":\"Gaming or office chair with a sleek, modern look Padded high backrest, seat, and arm rests comfortably support your body through long work sessions Swiveling 5-point molded resin base with muted 360 degree caster wheels Upgraded gas lift mechanism with side lever for adjusting chair height Smooth, supple polyurethane faux leather upholstery BIFMA certified for safety and durability\",\"primaryImage\":{\"alt\":\"Racing/Gaming Style Office Chair - White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cnznhP4YL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81s1o9eWp0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81s1o9eWp0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g+Hgw+7iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g+Hgw+7iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81d+t4vou6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81d+t4vou6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yb5UPbEeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yb5UPbEeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ry41BLlNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ry41BLlNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k7bEp8LbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k7bEp8LbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"44.1\",\"label\":\"in