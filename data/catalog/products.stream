    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSJJVD8\",\"sku\":\"B07HSJJVD8\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-end-table-15-75-w-walnut-stain-b07hsjjvd8\",\"name\":\"Rivet Mid-Century Modern End Table, 15.75&quot;W, Walnut Stain\",\"description\":\"Add a modern flair to your home with this stunning end table. With a rich walnut stain, gold-capped tapered legs, and a unique chevron inlay on the drawer’s front panel, this table exudes distinct personality and will capture attention in any room. 15.75&quot;W x 11.81&quot;D x 23.62&quot;H Engineered hardwood and fiberboard with brown ash veneer; rubber-wood legs with gold metal caps Modern style, with gold-tipped tapered legs, a gold drawer knob to match leg accents, and a chevron-design inlay on the front drawer panel This side table features 1 gliding drawer for storage next to your couch or bed. Assemble in 15 minutes or less Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern End Table, 15.75&quot;W, Walnut Stain\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BSB+EXc+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BZ4d1EVKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BZ4d1EVKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hs869b+-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hs869b+-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Dpcbk5JSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Dpcbk5JSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wBWSHKC1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wBWSHKC1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ircBEOne