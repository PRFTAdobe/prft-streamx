        "bytes": "{\"id\":\"B07HZ61DWG\",\"sku\":\"B07HZ61DWG\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-sofa-fabric-75-w-stone-b07hz61dwg\",\"name\":\"Bagley Sectional Component, Right-Facing Sofa, Fabric, 75&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing sofa component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 75&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Sofa, Fabric, 75&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Nyr+SlLUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81byIOFjteL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81byIOFjteL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jMpyY4hwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jMpyY4hwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QZ8gPSgSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QZ8gPSgSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9122rbuD-zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-p