    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQC8S\",\"sku\":\"B07QBMQC8S\",\"lang\":\"en\",\"slug\":\"joanna-contemporary-tufted-accent-chair-with-reversible-cushions-40-w-grey-b07qbmqc8s\",\"name\":\"Joanna Contemporary Tufted Accent Chair with Reversible Cushions, 40&quot;W, Grey\",\"description\":\"Clean lines give this accent armchair a modern, sophisticated look. Removable seat cushions and backs are comfortable and easy to adjust, and the performance fabric upholstery can be cleaned with a cloth or simple vacuuming. Steel seat springs and a wood frame provide structure, support and durability. Overall: 40&quot;W x 37&quot;D x 38&quot;H. Seat height: 21.5&quot;H; seat depth: 23&quot;D; seat back height: 19&quot;H Steel seat springs, wood frame and wood legs add structure and durability Loose, reversible seat cushions and inside back cushions in 100% polyester performance fabric Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Joanna Contemporary Tufted Accent Chair with Reversible Cushions, 40&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hb2LC0ItL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A-39HtMAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A-39HtMAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kSXqG9kvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kSXqG9kvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yEnNkdkoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yEnNkdkoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NtS+4OrHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NtS+4OrHL.jpg\"},{\"alt\":\"https://