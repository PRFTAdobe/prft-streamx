    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D6MRY\",\"sku\":\"B07B4D6MRY\",\"lang\":\"en\",\"slug\":\"jacobsen-traditional-accent-chair-31-w-grey-b07b4d6mry\",\"name\":\"Jacobsen Traditional Accent Chair, 31&quot;W, Grey\",\"description\":\"30.7&quot;W x 33.4&quot;D x 33.8&quot;H Top-grain leather on wood frame with wood legs The classic wingback chair is updated and downsized to a more transitional look. An ideal accent chair for a family room or a home office Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 1-year warranty. The classic wingback chair gets a modern refresh in a more compact size. Dark grey nailhead trim gives this piece an upscale accent, while the top grain leather is comfortable and durable. Natural markings in the leather make each chair unique.\",\"primaryImage\":{\"alt\":\"Jacobsen Traditional Accent Chair, 31&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LtM4Uw-cL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1P65H9V3vS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1P65H9V3vS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1HTS-bhkYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1HTS-bhkYS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WqQ1JFdlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WqQ1JFdlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913-HCogt-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913-HCogt-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I81CTKM1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I81CTKM1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":