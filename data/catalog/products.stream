    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MCBKLYT\",\"sku\":\"B07MCBKLYT\",\"lang\":\"en\",\"slug\":\"ravenna-home-modern-dining-chair-37-6-inch-height-denim-blue-b07mcbklyt\",\"name\":\"Ravenna Home Modern Dining Chair, 37.6 Inch Height, Denim Blue\",\"description\":\"Overall: 24.20&quot;W x 19.5&quot;D x 37.6&quot;H; seat height: 18.5&quot;H; seat depth: 21&quot;D; seat back height: 19&quot;H Dining chair framed in wood and manufactured wood; cushioned with high-density foam for comfort An arching back silhouette, plush upholstery, and beautiful nailhead trim along the back and bottom edges make this modern dining chair both convenient accent seating and a stunning decor accent. Brown-finished solid-wood legs balance the design and offer lasting durability. Soft, woven fabric upholstery is 100% polyester for easy cleaning and maintenance. Assemble in 15-30 minutes Use water-based cleaning agents or foam. Never use tap water. Use distilled water, as tap water contains minerals that may cause rings or fading.\",\"primaryImage\":{\"alt\":\"Ravenna Home Modern Dining Chair, 37.6 Inch Height, Denim Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uwEAIOWoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91s6s8gfPnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91s6s8gfPnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14CtGQ6NLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14CtGQ6NLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9171+GyYyaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9171+GyYyaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812jr0CHl4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812jr0CHl4L.jpg\"},{\"alt\":\"https://storage.googleapis.com