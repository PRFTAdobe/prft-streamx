    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6HH5Q\",\"sku\":\"B07HZ6HH5Q\",\"lang\":\"en\",\"slug\":\"dalton-ottoman-23-w-charcoal-b07hz6hh5q\",\"name\":\"Dalton Ottoman, 23&quot;W, Charcoal\",\"description\":\"Complete your interior design with this classic ottoman. With a traditional design that adds class and elegance to any room, this ottoman is an ideal accent for many home-decor styles. The cushions are reversible to ensure durability and extend the life of this ottoman. Overall: 23&quot;W x 37.5&quot;D x 35&quot;H; seat height: 21&quot;H; seat depth: 29&quot;D; seat back height: 29.5&quot;H; arm height: 24&quot;H; leg height: 1.75&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Charcoal-hued upholstery pairs well with your existing home-decor style. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Dalton Ottoman, 23&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EuHgRqAyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c+UoLbcFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c+UoLbcFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N21Mz5cTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N21Mz5cTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fCXM90h4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fCXM90h4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nIGB8zcPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nIGB8zcPL.jpg\"},{\"alt\":\"https://st