    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853NR959\",\"sku\":\"B0853NR959\",\"lang\":\"en\",\"slug\":\"rivet-rione-modern-upholstered-swivel-chair-with-rounded-back-30-3-w-stucco-b0853nr959\",\"name\":\"Rivet Rione Modern Upholstered Swivel Chair with Rounded Back, 30.3&quot;W, Stucco\",\"description\":\"Style and functionality meet in this low-profile, foam-padded swivel chair. The rotating base allows easy movement. A round back that curves into high arms provides ample support and gives the piece a classic look. Textured, stucco-colored upholstery means this chair will blend with existing decor. 30.3&quot;W x 30.7&quot;D x 30.7&quot;H; seat height: 17.3&quot;H; seat depth: 20.9&quot;D; seat back height: 27.6&quot;H; arm height: 24.8&quot;H Acrylic and polyester upholstery and foam padding The swivel features allow for easy movement within the chair, providing extra convenience and comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Rione Modern Upholstered Swivel Chair with Rounded Back, 30.3&quot;W, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k6zRXbaLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gfmek+OeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gfmek+OeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UXHnwLdvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UXHnwLdvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91F5Vj22muL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91F5Vj22muL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\"},{\"alt\":\"https://storage.