    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMRLM7\",\"sku\":\"B082VMRLM7\",\"lang\":\"en\",\"slug\":\"rivet-summit-mid-century-modern-top-grain-leather-steel-armed-accent-chair-27-w-black-b082vmrlm7\",\"name\":\"Rivet Summit Mid-Century Modern Top-Grain Leather Steel Armed Accent Chair 27&quot; W, Black\",\"description\":\"High design meets amazing comfort in this living room chair. Soft 100% top-grain leather is combined with a brushed steel base and arms for a sturdy, durable piece. Modern, industrial and mid-century influences will blend with most any modern style. Overall dimensions: 27&quot;W x 35”D x 27.6”H Soft top grain leather; sturdy brushed steel base and arms. Foam padding and elastic webbing make the back and seat resilient and comfortable. No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Summit Mid-Century Modern Top-Grain Leather Steel Armed Accent Chair 27&quot; W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yI6MMMsvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GE0S5QXAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GE0S5QXAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZfWx+irSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZfWx+irSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71InYy67IZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71InYy67IZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lPO9BSnwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lPO9BSnwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-YOnmgdJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-YOnmgdJL.