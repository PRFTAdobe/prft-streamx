    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7HP3W\",\"sku\":\"B07HZ7HP3W\",\"lang\":\"en\",\"slug\":\"clayton-reclining-contemporary-leather-living-room-chair-30-w-adobe-b07hz7hp3w\",\"name\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Adobe\",\"description\":\"With an ideal blend of style and comfort, this recliner is made to order just for you. The tasteful fabric in Adobe and wooden frame adds a contemporary flair, the perfect addition to any room. Sturdy wooden frame with stain-resistant fabric; no assembly required The tight, fixed back and seat cushions ensure durability and comfort; fits perfectly in a living-room corner or beside a couch or bed Product Dimensions: 30&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; seat back height: 41&quot;H; arm height: 24&quot;H; leg height: 6.5&quot;H Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Adobe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FeY2cJ0EL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lYeoN1DBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lYeoN1DBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P1PDCCEyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P1PDCCEyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zzCDncxGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zzCDncxGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dKb3aha0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dKb3aha0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VDE-Hj4nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim