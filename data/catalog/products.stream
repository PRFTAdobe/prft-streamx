  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJLYCCL\",\"sku\":\"B07QJLYCCL\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-bonded-leather-swivel-chair-23-6-w-brown-b07qjlyccl\",\"name\":\"Rivet Mid-Century Bonded Leather Swivel Chair, 23.6&quot;W, Brown\",\"description\":\"While this mid-century-design swivel chair is ideal for a home office, it's handsome enough to be used in any room. Brown upholstered bonded leather and low-slung arms offer comfort and durability. 23.6&quot;W x 25.4&quot;D x 30.5&quot;H Upholstered soft, bonded leather over a solid wood frame; foam padding; solid wood legs with walnut finish The mid-century-inspired design of this chair features an opening in the back and low-slung arms. This attractive chair is suitable for any room where stylish extra seating is needed. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Bonded Leather Swivel Chair, 23.6&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81USTdWcR4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fieaWcw0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fieaWcw0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819pRqqVbGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819pRqqVbGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OTthxaDsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OTthxaDsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11OWLHBewL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11OWLHBewL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZypkzLk2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZypkzLk2L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"23.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.4\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"21.8\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Hydraulic\",\"label\":\"Hydraulic\"},{\"value\":\"Roundhill\",\"label\":\"Roundhill\"},{\"value\":\"Rivnut\",\"label\":\"Rivnut\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Rattan\",\"label\":\"Rattan\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Side\",\"label\":\"Side\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Desk\",\"label\":\"Desk\"},{\"value\":\"Powered\",\"label\":\"Powered\"},{\"value\":\"Body\",\"label\":\"Body\"},{\"value\":\"Dining\",\"label\":\"Dining\"},{\"value\":\"Faux\",\"label\":\"Faux\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Parson\",\"label\":\"Parson\"},{\"value\":\"Pr14\",\"label\":\"Pr14\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Nutsert\",\"label\":\"Nutsert\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"West\",\"label\":\"West\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Accent\",\"label\":\"Accent\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Cordless\",\"label\":\"Cordless\"},{\"value\":\"Air\",\"label\":\"Air\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"