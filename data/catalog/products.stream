    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VM8W\",\"sku\":\"B075X4VM8W\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-leather-sofa-78-w-charcoal-b075x4vm8w\",\"name\":\"Rivet Lawson Modern Angled Leather Sofa, 78&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 78&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated sofa. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Leather Sofa, 78&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818y34nN1uL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1kudJzQufS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1kudJzQufS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816uD4Rb2eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816uD4Rb2eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10bNIOy1ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10bNIOy1ML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"114.0\",\"labe