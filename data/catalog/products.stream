    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831X8LWR\",\"sku\":\"B0831X8LWR\",\"lang\":\"en\",\"slug\":\"devonshire-modern-farmhouse-sectional-sofa-couch-114-w-tweed-b0831x8lwr\",\"name\":\"Devonshire Modern Farmhouse Sectional Sofa Couch, 114&quot;W, Tweed\",\"description\":\"This spacious sectional sofa makes a modern but down-to-earth design statement in your living room or family room. The foam-padded cushions are loose and reversible, providing the ultimate in comfort and durability. Tweed performance upholstery is easy to care for and maintain. 114&quot;W x 78.5&quot;D x 35.5&quot;H; seat height: 21.5&quot;H; seat depth: 27.5&quot;D; seat back height: 29&quot;H; arm height: 29&quot;H; leg height: 1.78&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible back and seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Devonshire Modern Farmhouse Sectional Sofa Couch, 114&quot;W, Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uKm3sZIxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xT8izHA8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xT8izHA8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TttBfuVYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TttBfuVYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vspzY9inL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vspzY9inL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZYkj1po6L.jpg\",\"url\":\"https://storage.googleapis.com/puresig