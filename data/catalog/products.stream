    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QM2V9T\",\"sku\":\"B075QM2V9T\",\"lang\":\"en\",\"slug\":\"rivet-elaine-tufted-line-upholstered-headboard-full-queen-60-h-heather-grey-b075qm2v9t\",\"name\":\"Rivet Elaine Tufted Line Upholstered Headboard Full / Queen, 60&quot;H, Heather Grey\",\"description\":\"This upholstered headboard will add a polished update to any style bedroom. Performance fabric with a linen-like texture is accented by hand-pulled button tufting. Plentiful foam padding makes it cozy to lean against while reading a good book. 64&quot;W x 7.25&quot;L x 60&quot;H Sturdy hardwood frame; polyeser performance fabric; birch wood legs Transitional style that blends with most décor Narrow profile makes it easy to move. Mattress, boxspring and bed frame sold separately. Easy assembly. All hardware and assembly tools included Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Elaine Tufted Line Upholstered Headboard Full / Queen, 60&quot;H, Heather Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oHLmEo9EL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qEYN-ew9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qEYN-ew9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w62JfH5QS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w62JfH5QS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eVWa9XXIS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eVWa9XXIS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAO2J5uXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAO2J5uXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1W4qMxWbTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images