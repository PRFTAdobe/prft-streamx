    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5NM\",\"sku\":\"B075X4F5NM\",\"lang\":\"en\",\"slug\":\"marin-studded-leather-recliner-30-w-driftwood-b075x4f5nm\",\"name\":\"Marin Studded Leather Recliner, 30&quot;W, Driftwood\",\"description\":\"Relax in style in this push-back recliner. It's crafted for durability with a solid wood frame, rich leather, and dashing nail head detail that is applied by hand over matching trim. Stylishly sloped arms complete the handsome design. This item is made to order just for you 30&quot;W x 36&quot;D x 41&quot;H. Seat height is 21&quot;. Solid wood frame and legs with 100% leather upholstery Poly wrapped foam cushions; back cushion attached with hidden Velcro to keep it in place Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Marin Studded Leather Recliner, 30&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uaMRjdc0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HB37RrRXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HB37RrRXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ShJNUP38L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ShJNUP38L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ux+00AvCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ux+00AvCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j97NxMJsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j97NxMJsL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"He