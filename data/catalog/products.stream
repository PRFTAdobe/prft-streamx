    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7X963\",\"sku\":\"B07HZ7X963\",\"lang\":\"en\",\"slug\":\"genesse-sectional-sofa-couch-91-w-smokey-blue-b07hz7x963\",\"name\":\"Genesse Sectional Sofa Couch, 91&quot;W, Smokey Blue\",\"description\":\"Complete your interior design with this beautiful smoky-blue sofa. Its performance-fabric upholstery offers comfortable seating, and its clean lines and modern narrow-arm and thin-leg design make this sofa an ideal addition to transitional-style home decor. Overall: 91&quot;W x 39&quot;D x 34&quot;H; Seat Height: 19.68&quot;H; Seat Depth 22.05&quot;D; Seat Back Height: 23.62&quot;H; Arm Height: 23.62&quot;H; Leg Height: 5.51&quot;H Solid-wood frame and legs with performance fabric upholstery Slim-arm design with wooden plinth Foam cushions provide lasting comfort Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Genesse Sectional Sofa Couch, 91&quot;W, Smokey Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CPQ-ThxFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91znfx041pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91znfx041pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GEUsI2gqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GEUsI2gqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jDRnVx-XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jDRnVx-XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kQb0iXXAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kQb0iXXAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJM+3GhYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJM+3GhYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"91.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"142.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Hide\",\"label\":\"Hide\"},{\"value\":\"A\",\"label\":\"A\"},{\"value\":\"Couchs\",\"label\":\"Couchs\"},{\"value\":\"Facing\",\"label\":\"Facing\"},{\"value\":\"Pull\",\"label\":\"Pull\"},{\"value\":\"Chaise\",\"label\":\"Chaise\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Size\",\"label\":\"Size\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"L\",\"label\":\"L\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Casa\",\"label\":\"Casa\"},{\"value\":\"French\",\"label\":\"French\"},{\"value\":\"Pillows\",\"label\":\"Pillows\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Script\",\"label\":\"Script\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Smith\",\"label\":\"Smith\"},{\"value\":\"Color\",\"label\":\"Color\"},{\"value\":\"Buy\",\"label\":\"Buy\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Rooms\",\"label\":\"Rooms\"},{\"value\":\"Out\",\"label\":\"Out\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Sleepers\",\"label\":\"Sleepers\"},{\"value\":\"Alenya\"