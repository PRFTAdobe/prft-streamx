    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5DVV2\",\"sku\":\"B07HZ5DVV2\",\"lang\":\"en\",\"slug\":\"fischer-queen-sized-sleeper-sofa-79-w-stone-fabric-b07hz5dvv2\",\"name\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Stone Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this queen-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 79&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and neutral color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Stone Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uAe+9Yi1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZBB+2GJaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZBB+2GJaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JnZYQk+jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JnZYQk+jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916+cp2ZNtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916+cp2ZNtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sqBZRDEgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sqBZRDEgL.jpg\"},{\"alt\":\"https://storage.goo