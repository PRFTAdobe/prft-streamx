    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4T5R9\",\"sku\":\"B075X4T5R9\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-chair-33-w-charcoal-b075x4t5r9\",\"name\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 33&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with a removable seat cushion make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling up with a good book on this sophisticated chair. A sleek back, angled arms, a removable seat cushion and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10ghtDYAVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s6VW143sS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s6VW143sS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9122iJouzOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9122iJouzOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ibZ1v3-KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ibZ1v3-KL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"59.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Charcoal\",\"label\":\"Charcoal\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":961,\"discountedValue\":864.9}}"
