    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4HZPN\",\"sku\":\"B075X4HZPN\",\"lang\":\"en\",\"slug\":\"leila-tufted-sofa-69-w-pewter-b075x4hzpn\",\"name\":\"Leila Tufted Sofa, 69&quot; W, Pewter\",\"description\":\"This item is made to order just for you 69&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look loveseat. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Two removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Sofa, 69&quot; W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LHLpd6uCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tJJ4OGSjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tJJ4OGSjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RSczLPtPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RSczLPtPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1K2LSKvP5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1K2LSKvP5L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"69.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":\"in