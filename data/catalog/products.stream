        "bytes": "{\"id\":\"B075X4QMX3\",\"sku\":\"B075X4QMX3\",\"lang\":\"en\",\"slug\":\"westport-modern-nailhead-upholstered-sofa-87-w-linen-b075x4qmx3\",\"name\":\"Westport Modern Nailhead Upholstered Sofa, 87&quot;W, Linen\",\"description\":\"Elevate your style with this head-turning modern sofa. A long down-blend bench seat is combined with back cushions that are reversible. Nailhead trim on the arms and across the sides, along with the exposed wood base, adds extra sophistication. 87&quot;W x 37.75''D x33''H 60% cotton/40% linen fabric; metal nailhead trim; wood legs. Removable, reversible back cushions. Corner clips keep bench seat firmly in place. No assembly required. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Westport Modern Nailhead Upholstered Sofa, 87&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814aS-KaUBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t+GZJiPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t+GZJiPdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E1mOtm97L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E1mOtm97L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zkaozUH2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zkaozUH2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TlgpYaSpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TlgpYaSpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.75\",\"labe