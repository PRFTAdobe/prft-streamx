    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MLZCXZ\",\"sku\":\"B084MLZCXZ\",\"lang\":\"en\",\"slug\":\"ravenna-home-classic-coffee-table-with-storage-drawers-42-w-blue-b084mlzcxz\",\"name\":\"Ravenna Home Classic Coffee Table with Storage Drawers, 42&quot;W, Blue\",\"description\":\"42&quot;W x 22&quot;D x 18&quot;H This coffee table has a sturdy wood frame, carved legs, and 2 drawers with solid metal handles. The softly rounded rectangular top has 2 pull-out drawers for ample storage space. The carved legs create texture and emphasize the open, airy design. Shiny gold-colored drawer pulls are shaped like bamboo for a pop of texture, perfect for enlivening a living room or home office. Assemble in 30 minutes–1 hour Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Classic Coffee Table with Storage Drawers, 42&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SzBEeGJGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WkluvaHfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WkluvaHfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XlPchBB9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XlPchBB9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I51wIrQOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I51wIrQOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OM6++qnVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OM6++qnVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61hzVJhFHIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61hzVJhFHIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-p