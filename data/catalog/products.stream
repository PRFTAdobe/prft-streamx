    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7MWMCG\",\"sku\":\"B07B7MWMCG\",\"lang\":\"en\",\"slug\":\"alicia-contemporary-office-desk-chair-36-h-washed-off-oak-b07b7mwmcg\",\"name\":\"Alicia Contemporary Office Desk Chair, 36&quot;H, Washed Off Oak\",\"description\":\"A vintage style gets modern functional updates in this elegant office chair. Handsome wood trim gives it a warmer, homier feel, while the height and tilt of the seat can be adjusted. It also swivels 360 degrees, and is easy to move on metal casters. 25.6&quot;W x 30&quot;D x 35.8&quot;-40.4&quot;H Linen upholstery on foam cushion; hardwood frame; metal base and casters This chair will blend with traditional, transitional, or modern farmhouse décor Cushioning adds comfort to a highly functional chair Assembly in less than 30 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Alicia Contemporary Office Desk Chair, 36&quot;H, Washed Off Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VzWSk49DL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YARca5jpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YARca5jpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uG96acMVS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uG96acMVS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r1NQ1O3UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r1NQ1O3UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VKlpiUniL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VKlpiUniL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZJIU8AHpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZJIU8AHpL.jpg\"}],\"attributes\":[{\"name\":\