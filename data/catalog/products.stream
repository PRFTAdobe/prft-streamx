    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z9QB8P\",\"sku\":\"B075Z9QB8P\",\"lang\":\"en\",\"slug\":\"rivet-rustic-industrial-wood-and-metal-dining-room-kitchen-table-86-6-l-fir-b075z9qb8p\",\"name\":\"Rivet Rustic Industrial Wood and Metal Dining Room Kitchen Table, 86.6&quot;L, Fir\",\"description\":\"86.6&quot;L x 37.4&quot;D x 29.8&quot;H 50% recycled fir wood; iron base with black finish A handsome piece that blends with modern, rustic or industrial decor Assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Vintage wood shop and industrial metal-working come together in this head-turning dining table. Simple, beautiful style and sturdy construction -- 50% from recycled materials -- make it a handsome asset to a rustic, modern or industrial setting.\",\"primaryImage\":{\"alt\":\"Rivet Rustic Industrial Wood and Metal Dining Room Kitchen Table, 86.6&quot;L, Fir\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lDG8RR6zL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RaWYsilQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RaWYsilQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71K3XN2S8EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71K3XN2S8EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mb3Lq80bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mb3Lq80bL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O6vISXiTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O6vISXiTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-image