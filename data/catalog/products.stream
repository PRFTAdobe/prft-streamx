    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6HHD6\",\"sku\":\"B07HZ6HHD6\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-sofa-chaise-fabric-41-w-dove-b07hz6hhd6\",\"name\":\"Bagley Sectional Component, Right-Facing Sofa Chaise, Fabric, 41&quot;W, Dove\",\"description\":\"This dove-colored sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing sofa chaise component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you. Overall: 41&quot;W x 87&quot;D x 36&quot;H; Seat Height: 22&quot;H; Seat Depth: 24&quot;D; Seat Back Height: 36&quot;H; Arm Height: 24&quot;H; Leg Height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Sofa Chaise, Fabric, 41&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6152Jw-3AIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31I3RpmMfoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31I3RpmMfoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VtYgrGptL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VtYgrGptL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hhsZzC7zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hhsZzC7zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WDr0J8XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WDr0J8XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61dEf1KXoPL.jpg\",\"url\":\"htt