    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL469L\",\"sku\":\"B07QDL469L\",\"lang\":\"en\",\"slug\":\"rivet-blanchard-living-room-chair-with-swivel-base-40-h-flannel-colored-fabric-b07qdl469l\",\"name\":\"Rivet Blanchard Living Room Chair with Swivel Base, 40&quot;H, Flannel-Colored Fabric\",\"description\":\"This contemporary high-backed living room chair offers the ease of conversation with a gunmetal-hued swivel base. The flannel-colored fabric upholstery adds a modern elegance to any room while also providing excellent durability, helping the chair to always look like new. 28&quot;W x 35&quot;D x 40&quot;H 80% polyester, 20% acrylic High back with swivel base The high back and fabric upholstery of this chair add a contemporary look to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Blanchard Living Room Chair with Swivel Base, 40&quot;H, Flannel-Colored Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WmGs1ZKFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfnW1MZWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfnW1MZWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ULVh7pYaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ULVh7pYaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dW-U8ggCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dW-U8ggCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t031NBy2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t031NBy2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hCq2EoJtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/9