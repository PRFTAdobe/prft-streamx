      "content": {
        "bytes": "{\"id\":\"B072C8Q9RF\",\"sku\":\"B072C8Q9RF\",\"lang\":\"en\",\"slug\":\"rivet-midtown-contemporary-upholstered-sofa-couch-92-1-w-charcoal-b072c8q9rf\",\"name\":\"Rivet Midtown Contemporary Upholstered Sofa Couch, 92.1&quot;W, Charcoal\",\"description\":\"Nestle in for an evening of movie marathon on this modern, smartly designed sofa. With seating for three and removable side and back cushions, you'll have plenty of room for snuggling with your pet or significant other. 37&quot;D x 92.1”W x 31.5&quot;H Sturdy hardwood frame, resilient cushions and solid beech legs Contemporary Soft, removable cushions make sofa easier to move. Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Midtown Contemporary Upholstered Sofa Couch, 92.1&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qoCnWaPuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sKloiMvBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sKloiMvBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RmwJ7k3LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RmwJ7k3LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bGjnRxpfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bGjnRxpfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T4emurwtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T4emurwtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"92.1\",\"label\":\"inches\"}]},{\"na