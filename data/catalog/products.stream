        "bytes": "{\"id\":\"B07BKKLFDK\",\"sku\":\"B07BKKLFDK\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-leather-bench-loveseat-couch-sofa-74-w-cognac-b07bkklfdk\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Leather Bench Loveseat Couch Sofa, 74&quot;W, Cognac\",\"description\":\"This sleek, Mid-century inspired leather sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge 74''W x 36.2”D x 30.3”H Soft top-grain leather; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth Free returns for 30 days, 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Leather Bench Loveseat Couch Sofa, 74&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817QdCQ1QTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s08Wlg5AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s08Wlg5AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JhAPXqCsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JhAPXqCsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WZm0FKuyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WZm0FKuyL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"74.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\