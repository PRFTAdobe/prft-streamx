    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086VZ8FC2\",\"sku\":\"B086VZ8FC2\",\"lang\":\"en\",\"slug\":\"cherrie-upholstered-gliding-swivel-chair-34-w-chimney-b086vz8fc2\",\"name\":\"Cherrie Upholstered Gliding Swivel Chair, 34&quot;W, Chimney\",\"description\":\"This plush upholstered swivel chair is the perfect addition to any living space. The smooth gliding function and rounded sides and back mean this chair exudes easy comfort. Charcoal-colored upholstery provides durability and easy cleaning. The seat cushion is reversible for longer wear. This item is made to order just for you 34&quot;W x 36&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 20&quot;D; back height: 33&quot;H Sturdy wood frame with polyester upholstery Smooth swivel gliding function makes this chair more versatile. Seat cushion is removable and reversible. No assembly required Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cherrie Upholstered Gliding Swivel Chair, 34&quot;W, Chimney\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nD6N5czWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FISPgj+cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FISPgj+cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g6D7OqcYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g6D7OqcYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TK4I55k+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TK4I55k+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818akjo1zIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818akjo1zIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GhjsIrmEL.jpg\",\"url\":\"ht