    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSDTR7C\",\"sku\":\"B07HSDTR7C\",\"lang\":\"en\",\"slug\":\"wickstrom-upholstered-bar-stool-with-arms-41-h-caribbean-sand-beige-b07hsdtr7c\",\"name\":\"Wickstrom Upholstered Bar Stool with Arms, 41&quot;H, Caribbean Sand Beige\",\"description\":\"This high-rise barstool features an elevated footrest stretcher and additional supportive stretchers on the sides to lend extra support to the sleek, low-back frame. The modern classic design is upholstered in gorgeous Caribbean sand fabric and cushioned all over for ultimate comfort. Overall: 23&quot;D x 23&quot;W x 41&quot;H Solid wood frame and legs with metal kickplate High-rise legs feature three stretcher bars for additional stability and support Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Wickstrom Upholstered Bar Stool with Arms, 41&quot;H, Caribbean Sand Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N-M5KCVWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YxUIIUkLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YxUIIUkLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wRW4k9ZHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wRW4k9ZHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OedGaQy8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OedGaQy8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JN1v8I43L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JN1v8I43L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A147VfSADtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A147VfSADtL.jpg\"}],\"attributes\":[{\"name\":\"h