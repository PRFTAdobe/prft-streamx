    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5RT3Y\",\"sku\":\"B07HZ5RT3Y\",\"lang\":\"en\",\"slug\":\"blaine-modern-loveseat-sofa-55-9-w-light-grey-b07hz5rt3y\",\"name\":\"Blaine Modern Loveseat Sofa, 55.9&quot;W, Light Grey\",\"description\":\"Add mid-century elegance to your living room with this light-gray loveseat. The solid-wood frame and polyester upholstery make this loveseat both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 55.9&quot;W x 37.8&quot;D x 35&quot;H; Seat Height: 19.3&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 25.6&quot;H; Arm Height: 24.4&quot;H; Leg Height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Blaine Modern Loveseat Sofa, 55.9&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ySyNqwhHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wbRyt78XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wbRyt78XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f+lAa0PxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f+lAa0PxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PXXBC9bBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PXXBC9bBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918U1DV65ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918U1DV65ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1b8+SoMXMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag