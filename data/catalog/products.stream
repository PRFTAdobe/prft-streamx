    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLRCCP\",\"sku\":\"B082VLRCCP\",\"lang\":\"en\",\"slug\":\"rivet-jamie-leather-mid-century-modern-low-arm-accent-chair-31-w-brown-b082vlrccp\",\"name\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Brown\",\"description\":\"A great addition to any room, this versatile accent chair is sure to be a conversation piece. It features eye catching Mid-century inspired design with distinctive slanted arms and sturdy hardwood legs. 31&quot;W x 32.3&quot;D x 35”H Solid hardwood frame and soft top-grain leather. Highly fashionable design in a compact size for small spaces. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dT2P9BzXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tRT8Su2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tRT8Su2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tI-p5n2xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tI-p5n2xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmj3INOJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmj3INOJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813+PDTplRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813+PDTplRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7150pQ2XESL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7150pQ2XESL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jWPJAWZtL.jpg\",\"url\":\"https://storage.googleapis.co