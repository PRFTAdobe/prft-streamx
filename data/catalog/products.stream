    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78LXYF\",\"sku\":\"B07B78LXYF\",\"lang\":\"en\",\"slug\":\"rivet-federal-mid-century-modern-wood-dining-room-kitchen-chairs-set-of-2-grey-b07b78lxyf\",\"name\":\"Rivet Federal Mid-Century Modern Wood Dining Room Kitchen Chairs, Set of 2, Grey\",\"description\":\"The rounded seat, simple tall back and tapered wooden legs are hallmarks of mid-century modern style, but understated enough to allow this chair to blend in a transitional décor. Polyester fabric and sturdy construction make it durable. 21&quot;W x 24&quot;D x 36&quot;H; Seat Height: 18.5&quot;H ; Seat Depth: 17.5&quot;D; Seat Back Height: 18.5&quot;H Hardwood legs and frame; polyester fabric Mid-century modern influences; can work with contemporary or transitional décor Polyester fabric is durable and easier to clean than other fabrics. Easy assembly in 15-30 minutes; just bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Federal Mid-Century Modern Wood Dining Room Kitchen Chairs, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QZJkmgEQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OXoImrq+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OXoImrq+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Ev0fuju1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Ev0fuju1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911R-c9acFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911R-c9acFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uvrCYM6CS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uvrCYM6CS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gIJmxsMPL.jpg\",\"url\":\"ht