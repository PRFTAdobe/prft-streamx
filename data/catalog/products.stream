    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BL1NYC4\",\"sku\":\"B07BL1NYC4\",\"lang\":\"en\",\"slug\":\"classic-grand-3-piece-mirror-table-vanity-set-with-stool-walnut-b07bl1nyc4\",\"name\":\"Classic Grand 3-Piece Mirror Table Vanity Set with Stool - Walnut\",\"description\":\"Vanity table with 3-panel mirror, a large top surface, and 3 pull-out drawers (2 on either side of a shallow center drawer) Matching sitting stool provides comfort and slides under the table when not in use; vanity stool holds up to 250 pounds Sturdy post-style legs on vanity table and stool offer decorative flair and reliable strength and stability Elegant style for lasting good looks; pleasingly symmetrical profile; attractive Walnut color; assembly required (step-by-step instructions included) Backed by an AmazonBasics 1-year limited warranty\",\"primaryImage\":{\"alt\":\"Classic Grand 3-Piece Mirror Table Vanity Set with Stool - Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81v7VectURL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+WwStHqLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+WwStHqLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ssxKUSq4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ssxKUSq4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MxQTyRymL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MxQTyRymL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"51.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"54.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"88.0\",\"label\":\"pounds\"}]},{\"name\":\"ke