    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071J7Q343\",\"sku\":\"B071J7Q343\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-leather-ottoman-30-3-w-cognac-b071j7q343\",\"name\":\"Bradbury Chesterfield Leather Ottoman, 30.3&quot;W, Cognac\",\"description\":\"Enhance your lounge-worthy living room with this classic Chesterfield ottoman. Rich leather upholstery, button detail trim and sturdy build will let you kick up your heels, or offer an extra seat, for years to come. Dimensions: 30.3 ”W x 22.4”D x 19.7”H Engineered wood frame and 100% leather Modern and classic touches Restyled classic design with durable leather. Easy-to-attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Leather Ottoman, 30.3&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tGD0z79mL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S5vzZxUZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S5vzZxUZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UOlC1slhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UOlC1slhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1WpW8vgBvS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1WpW8vgBvS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915X7hnkvyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915X7hnkvyL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.68504\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.440945\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"30.31496\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value