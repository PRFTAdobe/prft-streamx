    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JNJ51\",\"sku\":\"B0857JNJ51\",\"lang\":\"en\",\"slug\":\"beech-wishbone-counter-height-barstool-42-2-h-natural-b0857jnj51\",\"name\":\"Beech Wishbone Counter-Height Barstool, 42.2&quot;H, Natural\",\"description\":\"The graceful curves of this natural-colored beech barstool mask its everyday durability. It's light, portable, and perfect for any place in the house where there's a countertop. The soft, comfortable woven paper-rope seat is 100% natural. 22.4&quot;W x 22.8&quot;D x 42.2&quot;H Beech frame with a woven seat The sturdy beech frame will stand the test of time, while the soft woven paper-rope seat is easy to sink into. Simple but fashionable, this natural-colored wishbone-style curved design adds sophistication to any counter area. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Beech Wishbone Counter-Height Barstool, 42.2&quot;H, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hFRF6YEyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71niXEJ4vML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71niXEJ4vML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J0zY4KmIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J0zY4KmIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PckD5hMKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PckD5hMKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b9zEiokmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b9zEiokmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71C2hhXbT7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pi