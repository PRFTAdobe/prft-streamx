        "bytes": "{\"id\":\"B07B4D858Z\",\"sku\":\"B07B4D858Z\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-loveseat-58-w-navy-b07b4d858z\",\"name\":\"Brandeberry Farmhouse Charles of London Loveseat, 58&quot;W, Navy\",\"description\":\"The classic English roll arm gives this cozy loveseat a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 58&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Durable polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Loveseat, 58&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sbOAvdlwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QkrcUhRWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QkrcUhRWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V3ceOKmlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V3ceOKmlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bsWVKczlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bsWVKczlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816POeYl+9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816POeYl+9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"149.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":388,\"discountedValue\":349.2}}"
