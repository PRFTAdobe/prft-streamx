  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PTG6\",\"sku\":\"B075X4PTG6\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-chair-39-w-walnut-b075x4ptg6\",\"name\":\"Charles Classic Oversized Leather Chair, 39&quot;W, Walnut\",\"description\":\"This item is made to order just for you Overall depth: 39&quot;, Seat depth: 23&quot;, Height: 38&quot;, Width: 39&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional chair with plenty of room for family, friends and pets Let yourself be wrapped in comfort by this extra large seat. Traditional rolled arms and turned wood legs are combined with modern 100% leather upholstery for an update on a classic piece. Its long silhouette means ample space for you and your dog. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Chair, 39&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918lo9dRG4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sTp7Fe-FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sTp7Fe-FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kZLx1ex9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kZLx1ex9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g0lvsAv9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g0lvsAv9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.