    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G46T9\",\"sku\":\"B07B4G46T9\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-leather-ottoman-31-w-black-leather-b07b4g46t9\",\"name\":\"Rivet Kaden Mid-Century Modern Leather Ottoman, 31&quot;W, Black Leather\",\"description\":\"This handsomely-styled leather ottoman is cleverly functional for propping up your feet, or as an extra seat when needed. Compactly sized for smaller spaces, it features modern metal legs. 31.1&quot;W x 22.8&quot;D x 16.9&quot;H; Seat Height: 5.5&quot;H ; Seat Depth: 21.6&quot;D; Seat Back Height: 11.4&quot;H; Leg Height: 5.5&quot;H Genuine leather on cedar hardwood frame; metal legs Clean lines and streamlined design is thoroughly contemporary Simple sleek design adds style Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Leather Ottoman, 31&quot;W, Black Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TSEfmz+AL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RGoBGC65L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RGoBGC65L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wWJpNX-fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wWJpNX-fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GrcTK06TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GrcTK06TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+91FZb+7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+91FZb+7L.jpg\"}],\"attribut