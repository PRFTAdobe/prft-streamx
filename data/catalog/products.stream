        "bytes": "{\"id\":\"B085GXXLT2\",\"sku\":\"B085GXXLT2\",\"lang\":\"en\",\"slug\":\"hampstead-modern-power-recliner-accent-chair-with-wood-legs-30-w-gray-and-gold-geometric-b085gxxlt2\",\"name\":\"Hampstead Modern Power Recliner Accent Chair with Wood Legs, 30&quot;W, Gray and Gold Geometric\",\"description\":\"The gray and gold geometric pattern on this reclining accent chair will create a statement in any room. Add a bold touch to your decor without sacrificing comfort. A seat cushioned with compression foam and constructed with spring hangers rests on a solid wooden frame to give you extra support. 30&quot;W x 39&quot;D x 39&quot;H; seat height: 20&quot;H; seat back height: 39&quot;H; seat depth: 19&quot;D; arm height: 26&quot;H; leg height: 6.5&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. Relaxing and reclining are made easy with mechanisms that are insulated to reduce noise and designed to create a smoother motion. No assembly required Clean with shampoo, foam, or dry cleaning solvent as desired. Do not saturate. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Hampstead Modern Power Recliner Accent Chair with Wood Legs, 30&quot;W, Gray and Gold Geometric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81of4UToeLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BumwzJKLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BumwzJKLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ii8xnQHaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ii8xnQHaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81th0lf0DpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81th0lf0DpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813K-FT9MOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813K-FT9MOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KJdUBnADL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KJdUBnADL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91znZ4QrCeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91znZ4QrCeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HYyVbz3WL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HYyVbz3WL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fBaygbsgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fBaygbsgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81soxkwQqpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81soxkwQqpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bgL7TNzlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bgL7TNzlL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"70.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Motion\",\"label\":\"Motion\"},{\"value\":\"Oslo\",\"label\":\"Oslo\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Ekornes\",\"label\":\"Ekornes\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Leather\",\"