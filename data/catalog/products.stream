    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSN22\",\"sku\":\"B07QFRSN22\",\"lang\":\"en\",\"slug\":\"mid-century-foam-padded-dining-chair-30-5-h-beige-b07qfrsn22\",\"name\":\"Mid-Century Foam-Padded Dining Chair, 30.5&quot;H, Beige\",\"description\":\"A sturdy wood frame and solid wood legs create a sturdy base, and the foam padding and curved back offer a comfortable seat. A walnut finish on the legs and beige upholstery fabric create a subtle, natural look that makes this chair a great fit in many different dining spaces. 24.25&quot;W x 23&quot;D x 30.5&quot;H; seat height: 18.75&quot;H; seat depth: 17&quot;D; seat back height: 11.75&quot;H Durable fabric on wood frame, solid wood legs with walnut finish The foam padding and elastic suspension system keep the back and seat firm and springy. Contemporary design with wood frame, upholstered light-green fabric, and solid wood legs Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Mid-Century Foam-Padded Dining Chair, 30.5&quot;H, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vJPKCuN8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pa+MWQ2OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pa+MWQ2OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UxFWZHd+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UxFWZHd+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91raivEQ8AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91raivEQ8AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LKEcyZ4YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LKEcyZ4YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-p