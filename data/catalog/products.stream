        "bytes": "{\"id\":\"B075ZBW1PX\",\"sku\":\"B075ZBW1PX\",\"lang\":\"en\",\"slug\":\"rivet-vibe-swivel-leather-office-chair-25-2-w-medium-brown-b075zbw1px\",\"name\":\"Rivet Vibe Swivel Leather Office Chair, 25.2&quot;W, Medium Brown\",\"description\":\"While designed for the office, this swivel chair adds refreshing style to any room. The Mid-century inspired square silhouette features top grain leather upholstery on low-profile back and arms. Four metal legs extend outward from the swivel base. 25.2&quot;W x 24.8&quot; x29.5&quot;H Top grain leather upholstery; black metal swivel base and legs Suitable for any room, the leather upholstery shows natural markings No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Vibe Swivel Leather Office Chair, 25.2&quot;W, Medium Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xTLPnI+tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810XMhEiKML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810XMhEiKML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19bkY0s+mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19bkY0s+mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y0WwhrZ-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y0WwhrZ-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P-65hYgjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P-65hYgjL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"25.2\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"24.8\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"37.48\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Home-office-desk-chairs\",\"label\":\"Home-office-desk-chairs\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Office chair\",\"label\":\"Office chair\"},{\"value\":\"Computer desk\",\"label\":\"Computer desk\"},{\"value\":\"Ergonomic office chair\",\"label\":\"Ergonomic office chair\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Gaming chair\",\"label\":\"Gaming chair\"},{\"value\":\"Office chairs\",\"label\":\"Office chairs\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Medium\",\"label\":\"Medium\"},{\"value\":\"Desk\",\"label\":\"Desk\"},{\"value\":\"Brown leather\",\"label\":\"Brown leather\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Desk chair\",\"label\":\"Desk chair\"},{\"value\":\"Computer chair\",\"label\":\"Computer chair\"}]}],\"categories\":[{\"id\":\"Home Office Desk Chairs\",\"slug\":\"home-office-desk-chairs\",\"name\":\"Home Office Desk Chairs\",\"value\":\"Home Office Desk Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":980,\"discountedValue\":882.0}}"
