  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QLF8X7\",\"sku\":\"B075QLF8X7\",\"lang\":\"en\",\"slug\":\"rivet-elaine-tufted-line-upholstered-headboard-king-60-h-linen-rose-b075qlf8x7\",\"name\":\"Rivet Elaine Tufted Line Upholstered Headboard King, 60&quot;H, Linen Rose\",\"description\":\"This upholstered headboard will add a polished update to any style bedroom. Performance fabric with a linen-like texture is accented by hand-pulled button tufting. Plentiful foam padding makes it cozy to lean against while reading a good book. 80.75&quot;W x 7.25&quot;L x 60&quot;H Sturdy hardwood frame; polyeser performance fabric; birch wood legs Transitional style that blends with most décor Narrow profile makes it easy to move. Mattress, boxspring and bed frame sold separately. Easy assembly. All hardware and assembly tools included Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Elaine Tufted Line Upholstered Headboard King, 60&quot;H, Linen Rose\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FVSSBP8TL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Tv2kGdaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Tv2kGdaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gFh3JPZES.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gFh3JPZES.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yFENvH4vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yFENvH4vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QUrmUEiAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QUrmUEiAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qkVaxiK3S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qkVaxiK3S.