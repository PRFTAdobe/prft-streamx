    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082JJJKT3\",\"sku\":\"B082JJJKT3\",\"lang\":\"en\",\"slug\":\"modern-home-office-writing-desk-with-recessed-metal-handles-48-w-black-b082jjjkt3\",\"name\":\"Modern Home Office Writing Desk with Recessed Metal Handles, 48&quot;W, Black\",\"description\":\"This simple modern writing desk has recessed metal hardware and clean styling. The tapered legs add a touch of elegance that subtly balances its practicality. This black desk is perfect as a multifunctional home-work space. 48&quot;W x 20&quot;D x 30.5&quot;H Solid pine and MDF with metal hardware The large writing space is excellent for multiple projects. The black color gives this writing desk a clean modern look. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Home Office Writing Desk with Recessed Metal Handles, 48&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Reyr6ZPpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61alqAGKB0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61alqAGKB0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61IssMA6KzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61IssMA6KzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711wX0dWsZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711wX0dWsZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6135sJfvI5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6135sJfvI5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61D5xW0YUWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61D5xW0YUWL.jpg\"},{\"alt\":\"https://storage.goo