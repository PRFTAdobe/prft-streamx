    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B3RVS\",\"sku\":\"B07B7B3RVS\",\"lang\":\"en\",\"slug\":\"rivet-allie-velvet-industrial-mid-century-dining-kitchen-chair-33-h-grey-and-antique-brass-b07b7b3rvs\",\"name\":\"Rivet Allie Velvet Industrial Mid-Century Dining Kitchen Chair, 33&quot;H, Grey and Antique Brass\",\"description\":\"Clean lines and one-piece arm-and-leg frames on each side make for a very modern look, while soft velvet gives it a touch of glam. The compact design helps you fit more guests around the table. Quality construction is ready for wear and tear. Overall: 22&quot;W x 24.4&quot;D x 33.4&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 17.7&quot;D; Seat Back Height: 14&quot;H; Arm: 25.9&quot;H Metal frame with antique brass finish; channel-tufted velvet upholstery Contemporary design that can blend with modern and industrial décor. Sleek, clean look with a comfortable upholstered seat No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Allie Velvet Industrial Mid-Century Dining Kitchen Chair, 33&quot;H, Grey and Antique Brass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7196wQbG7KL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UHg3kOs4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UHg3kOs4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ITauIeYPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ITauIeYPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1C90IhyYNS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1C90IhyYNS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16BMYkXqZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16BMYkXqZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi