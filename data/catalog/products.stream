    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QMGMWX\",\"sku\":\"B075QMGMWX\",\"lang\":\"en\",\"slug\":\"delano-nailhead-trim-full-queen-headboard-65-w-warm-grey-b075qmgmwx\",\"name\":\"Delano Nailhead Trim Full/Queen Headboard, 65&quot;W, Warm Grey\",\"description\":\"This headboard will make your bedroom a truly restful retreat. Performance fabric is durable and easy to clean, while ample padding makes it comfy to lean against while enjoying a good book. Nickel-finished nailhead trim borders the graceful curves. 65&quot;W x 3.5&quot;D x 63.25&quot;H Polyester fabric. Hardwood frame and legs. Metal nailheads. A modern style with classic linen fabric and simple lines to blend with any decor Polyester performance fabric is durable, easy to clean. Adjusts to 3 different heights - 55.25&quot;, 59.25&quot;, and 63.25&quot;. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Delano Nailhead Trim Full/Queen Headboard, 65&quot;W, Warm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ilHLsvoCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxqQ10wkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxqQ10wkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1u9FExbhxS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1u9FExbhxS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eQ6GPIXlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eQ6GPIXlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ewe+RF1cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ewe+RF1cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1FBl3I4zmS.jpg\",\"url\":\