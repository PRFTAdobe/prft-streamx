    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LM42Y\",\"sku\":\"B07P5LM42Y\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sofa-with-tapered-wood-legs-87-w-light-grey-b07p5lm42y\",\"name\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Light Grey\",\"description\":\"This sofa features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive gray fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 87&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs Removable and reversible back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IuhOPYSWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r61w+j+XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r61w+j+XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tMBPR0EQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tMBPR0EQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MCBeE-A5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MCBeE-A5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FUHozyqvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FUHozyqvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z6wQ5zraL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/