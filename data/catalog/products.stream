    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5HB7J\",\"sku\":\"B075X5HB7J\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-charcoal-b075x5hb7j\",\"name\":\"Leila Ottoman, 34&quot; W, Charcoal\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing gives cushion resilience. This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place to set down a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and velvet upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot; W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IVfm9lqmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HozeGlOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HozeGlOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tQ2BUVX0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tQ2BUVX0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wqnjLuMmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wqnjLuMmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nG2ez5HaS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nG2ez5HaS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JRxB8Tv9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JRxB8Tv9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Wid