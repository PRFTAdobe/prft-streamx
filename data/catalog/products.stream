    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZ38G\",\"sku\":\"B07QGSZ38G\",\"lang\":\"en\",\"slug\":\"rivet-adrienne-swivel-base-contemporary-living-room-chair-29-w-fabric-stucco-b07qgsz38g\",\"name\":\"Rivet Adrienne Swivel-Base Contemporary Living Room Chair, 29&quot;W, Fabric, Stucco\",\"description\":\"Complete the contemporary ambience in your living room or office with this attractively simple swivel chair. With an eye-catching design and unique swivel base, this chair is the ideal combination of style and comfort. 29&quot;W x 30&quot;D x 32&quot;H; seat height: 18&quot;H; seat depth: 19&quot;D; seat back height: 14&quot;H; arm height: 23&quot;H; leg height: 11&quot;H Hardwood frame and metal base with 80% polyester and 20% acrylic upholstery The swivel base allows you to place this chair anywhere in the room. Elegant design adds a contemporary flair to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Adrienne Swivel-Base Contemporary Living Room Chair, 29&quot;W, Fabric, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dEUtYNpkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nbG-RyT-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nbG-RyT-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y8Miwg5VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y8Miwg5VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911LxzpxpeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911LxzpxpeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FApdgZUCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FApdgZUCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/p