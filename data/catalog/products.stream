        "bytes": "{\"id\":\"B07B4MK6YP\",\"sku\":\"B07B4MK6YP\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-leather-ottoman-31-w-light-grey-b07b4mk6yp\",\"name\":\"Rivet Kaden Mid-Century Modern Leather Ottoman, 31&quot;W, Light Grey\",\"description\":\"This handsomely-styled ottoman is versatile and functional as a foot rest, an extra seat for guests, or as a perch for a tray of snacks. Compactly sized for smaller spaces, it features modern metal legs. 31.1&quot;W x 22.8&quot;D x 16.9&quot;H; Seat Height: 5.5&quot;H ; Seat Depth: 21.6&quot;D; Seat Back Height: 11.4&quot;H; Leg Height: 5.5&quot;H Quality upholstery with a cedar hardwood frame; metal legs Clean lines and streamlined design is thoroughly contemporary Unique headrest feature adjusts upward and backward Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Leather Ottoman, 31&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z4oCS7X0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N4kqwxgBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N4kqwxgBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q4l5GQz1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q4l5GQz1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vt0wxXG8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vt0wxXG8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFFt1VJ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFFt1VJ1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.1\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"22.8\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"27.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Light grey\",\"label\":\"Light grey\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":318,\"discountedValue\":286.2}}"
