    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLYCPC\",\"sku\":\"B082VLYCPC\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-leather-sofa-couch-80-w-grey-b082vlycpc\",\"name\":\"Rivet Alonzo Contemporary Leather Sofa Couch, 80&quot;W, Grey\",\"description\":\"A single bench cushion brings visual unity and gently sloping armrests give it a sleek, comfortable style. With a solid-wood frame and strong brass legs, this sofa offers durability and elegance. Overall: 80.3&quot;W x 37.8&quot;D x 35.4&quot;H; Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and genuine leather upholstery Bench seat cushion with removable back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Leather Sofa Couch, 80&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pzr1IKkIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bq7nBIYML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bq7nBIYML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Yib7pdRhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Yib7pdRhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M27c-rEZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M27c-rEZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZGN+5io6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZGN+5io6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zBjQUQkWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zBjQUQkWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/