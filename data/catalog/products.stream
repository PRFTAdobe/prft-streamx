        "bytes": "{\"id\":\"B07BWJCPSN\",\"sku\":\"B07BWJCPSN\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-sofa-chaise-sectional-115-w-slate-brown-b07bwjcpsn\",\"name\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester/linen blend fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ynlz7iZmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1koeh7iPNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1koeh7iPNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1n2sBaLZ4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1n2sBaLZ4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rz9gilH8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rz9gilH8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A8QolAMuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A8QolAMuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hBEtUHXhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hBEtUHXhL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"28.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"75.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"114.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Slate brown\",\"label\":\"Slate brown\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Left sofa chaise\",\"label\":\"Left sofa chaise\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":311,\"discountedValue\":279.9}}"
