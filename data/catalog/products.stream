    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MN2R3\",\"sku\":\"B07B4MN2R3\",\"lang\":\"en\",\"slug\":\"andover-modern-loveseat-sofa-67-w-sand-b07b4mn2r3\",\"name\":\"Andover Modern Loveseat Sofa, 67&quot;W, Sand\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 67&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Loveseat Sofa, 67&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aTI7ql1SL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817WjvNCrHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817WjvNCrHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WXAjTGICL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WXAjTGICL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fsdIn4uFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fsdIn4uFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jp0alTXML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jp0alTXML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vx04HbxAL.jpg\",\"url\":\"https://storage.googleapis.com/