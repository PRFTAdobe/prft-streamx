    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2SXXP\",\"sku\":\"B084W2SXXP\",\"lang\":\"en\",\"slug\":\"elise-upholstered-counter-height-barstool-38-6-h-midnight-blue-b084w2sxxp\",\"name\":\"Elise Upholstered Counter-Height Barstool, 38.6&quot;H, Midnight Blue\",\"description\":\"This midnight-colored rectangular counter-height barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 38.6&quot;H; seat height: 26&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 21.3&quot;H. Solid hardwood frame upholstered in moisture-repellent, stain-resistant fabric Footrest with kickplate for stability and durability, with a padded seat and back for comfort. Low profile mid-century inspired barstool. Arrives fully assembled. Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Counter-Height Barstool, 38.6&quot;H, Midnight Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+Os8Dzl1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ujySRxMkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ujySRxMkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q2ChOBUlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q2ChOBUlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+EvTmajpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+EvTmajpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KbAj0X3vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KbAj0X3vL.jpg\"},{\"alt\":\"https://storage