    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCQ71Q\",\"sku\":\"B082QCQ71Q\",\"lang\":\"en\",\"slug\":\"rivet-maple-channel-tufted-velvet-storage-ottoman-with-a-soft-close-hinge-45-3-w-teal-b082qcq71q\",\"name\":\"Rivet Maple Channel Tufted Velvet Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Teal\",\"description\":\"Storage is made simple and convenient with this stylish channel-top ottoman. A solid wood frame and tapered legs provide a sturdy base, and a high-quality galvanized, soft-close hinge makes it easy to shut small items away but keep them within reach. Chic teal upholstery matches any existing decor. 45.3&quot;W x 18.9&quot;D x 18.5&quot;H; seat height: 18.5&quot;H; seat depth: 18.9&quot;D; leg height: 6.3&quot;H Solid wood frame and legs, polyester upholstery Store small items and help reduce clutter in your home with this ottoman. Made with a soft-close hinge for easy use. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Maple Channel Tufted Velvet Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DSsfmzCtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kG1Mu4OsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kG1Mu4OsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YHeq4naoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YHeq4naoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ipwdX3+HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ipwdX3+HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gnOkCAT9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gnOkCAT9L.jpg\"},{\"alt\"