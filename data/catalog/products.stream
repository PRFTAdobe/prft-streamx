    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071J7Q9WN\",\"sku\":\"B071J7Q9WN\",\"lang\":\"en\",\"slug\":\"rivet-summit-mid-century-modern-top-grain-leather-steel-armed-accent-chair-27-w-cognac-b071j7q9wn\",\"name\":\"Rivet Summit Mid-Century Modern Top-Grain Leather Steel Armed Accent Chair 27&quot;W, Cognac\",\"description\":\"High design meets amazing comfort in this living room chair. Soft 100% top-grain leather is combined with a brushed steel base and arms for a sturdy, durable piece. Modern, industrial and mid-century influences will blend with most any modern style. 27&quot;W x 35”D x 27.6”H Soft top-grain leather; sturdy brushed steel base and arms. Foam padding and elastic webbing make the back and seat resilient and comfortable. No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Summit Mid-Century Modern Top-Grain Leather Steel Armed Accent Chair 27&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p1BVpAQlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KaCETSo6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KaCETSo6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8Ua0QhjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8Ua0QhjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O9Mrd92QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O9Mrd92QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w6ZEMf8gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w6ZEMf8gL.jpg\"}],\"attribute