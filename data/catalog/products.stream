    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082PCLKMB\",\"sku\":\"B082PCLKMB\",\"lang\":\"en\",\"slug\":\"rivet-sheena-glam-tufted-velvet-shell-chair-23-5-w-rose-b082pclkmb\",\"name\":\"Rivet Sheena Glam Tufted Velvet Shell Chair, 23.5&quot;W, Rose\",\"description\":\"This rose-velvet upholstered accent chair has a padded seat and wide shell-like back that will keep you lounging and relaxing in plush, cushioned comfort. Splayed tapering metal legs with a golden finish ensure added stability and style. 23.5&quot;W x 26&quot;D x 32.25&quot;H; seat height: 18.5&quot;H; seat depth: 19.5&quot;D; seat back height: 21.5&quot;H; leg height: 11&quot;H Sturdy metal legs support foam cushioning covered in durable yet indulgent velvet upholstery. The soft velvet upholstery offers a rich, luxe appeal, making this accent chair equally perfect for your living room, home office, or bedroom. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sheena Glam Tufted Velvet Shell Chair, 23.5&quot;W, Rose\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DOZAvRvnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71exEXiGBWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71exEXiGBWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p2hJZfVtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p2hJZfVtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zbFy80xpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zbFy80xpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916bymz-jjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916bymz-jjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-i