    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568W891\",\"sku\":\"B08568W891\",\"lang\":\"en\",\"slug\":\"rivet-vermont-modern-faux-leather-diamond-accent-dining-chair-20-w-set-of-2-brown-b08568w891\",\"name\":\"Rivet Vermont Modern Faux Leather Diamond Accent Dining Chair, 20&quot;W, Set of 2, Brown\",\"description\":\"The armless profile, sleek metal legs and diamond-stitched cushion pattern of this dining chair combine classic and modern looks into an elegant style of its own. Overall: 23.2.&quot;D x 20&quot;W x 35&quot;H. Seat height: 19&quot; Solid wood frame with sturdy metal base. Set of 2 padded, upholstered dining chairs with brass legs and H-shaped stretcher bar. Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Vermont Modern Faux Leather Diamond Accent Dining Chair, 20&quot;W, Set of 2, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ulIauSJlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fSI9rLhIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fSI9rLhIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1ViCuBuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1ViCuBuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rZzZYUMfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rZzZYUMfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VZBIaxzqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VZBIaxzqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6147--86t-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6147--86t-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uVEuV