    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082DFP8N8\",\"sku\":\"B082DFP8N8\",\"lang\":\"en\",\"slug\":\"rivet-avery-industrial-home-office-writing-desk-with-metal-base-40-w-weathered-gray-oak-finish-b082dfp8n8\",\"name\":\"Rivet Avery Industrial Home Office Writing Desk with Metal Base, 40&quot;W, Weathered Gray Oak Finish\",\"description\":\"Industrial style meets contemporary functionality in this sturdy, streamlined desk. This versatile piece makes a home office or workplace style statement while also standing up to daily use. A single slim drawer offers handy storage without spoiling the elegantly sparse lines of the desk. 40&quot;W x 18&quot;D x 30&quot;H Durable MDF wood with gray-washed-oak-finished hardwood veneer and an antique bronze-finished metal base A wide top offers ample workspace for writers, artists, or busy professionals. The single drawer slides easily. The clean lines of this desk speak to its industrial-chic roots. The distressed gray finish of the top pairs perfectly with the antiqued metal base. Assemble in 15-30 minutes Using a soft, damp cloth, wipe in the direction of the wood grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Avery Industrial Home Office Writing Desk with Metal Base, 40&quot;W, Weathered Gray Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71dpDnH3G9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LsYjyoifL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LsYjyoifL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xSjRceh+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xSjRceh+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qY6PUJ5BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qY6PUJ5BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pu