    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MR6YG\",\"sku\":\"B07B4MR6YG\",\"lang\":\"en\",\"slug\":\"traditional-nailhead-wingback-accent-chair-34-w-grey-b07b4mr6yg\",\"name\":\"Traditional Nailhead Wingback Accent Chair, 34&quot;W, Grey\",\"description\":\"This modern refresh of the classic wingback chair will be right at home in a family room or beside a desk. The dark grey nailhead trim and polyester fabric, paired with distressed-finish wooden legs, will bring a handsome transitional style to your room. 33.8&quot;W x 35.4&quot;D x 45.2&quot;H Polyester fabric on wood frame; dark grey metal nailhead trim The traditional wingback chair has been updated to a transitional look An ideal accent chair for a family room or a home office Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Traditional Nailhead Wingback Accent Chair, 34&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14M9MjrZfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UcROqSHrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UcROqSHrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hCz6adVsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hCz6adVsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fi9PJ4UAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fi9PJ4UAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1HTS-bhkYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1HTS-bhkYS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Jnbj3NDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Jnbj3NDL.jpg\"},{\"alt\":\"https://storage.googleapis.co