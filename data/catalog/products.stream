    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4CZRYR\",\"sku\":\"B07B4CZRYR\",\"lang\":\"en\",\"slug\":\"andover-modern-loveseat-sofa-67-w-grey-linen-b07b4czryr\",\"name\":\"Andover Modern Loveseat Sofa, 67&quot;W, Grey Linen\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 67&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Loveseat Sofa, 67&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cg4Gk8O1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816UK-zqpEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816UK-zqpEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UUTXfYe7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UUTXfYe7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vYL5OBQgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vYL5OBQgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JDvL1MLCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JDvL1MLCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oQgc89dPL.jpg\",\"url\":\"https://storage.googleapis.co