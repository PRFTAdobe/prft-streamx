    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2VXYK\",\"sku\":\"B084W2VXYK\",\"lang\":\"en\",\"slug\":\"esme-memory-swivel-barstool-43-3-h-hemp-b084w2vxyk\",\"name\":\"Esme Memory-Swivel Barstool, 43.3&quot;H, Hemp\",\"description\":\"Add some stylish seating to your next get-together or party with this wingback barstool. This tall hemp-colored barstool features a memory swivel that returns the seat to its proper position every time. It will easily complement your contemporary kitchen or transitional bar. 20.1&quot;W x 22.4&quot;D x 43.3&quot;H; seat height: 29.9&quot;H; seat depth: 16.5&quot;D; seat back height: 18.5&quot;H; leg height: 24.8&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric A memory-swivel mechanism means this barstool always looks tidy. Classic transitional look with memory swivel No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Esme Memory-Swivel Barstool, 43.3&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qdAwdmvkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ks4LLfaCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ks4LLfaCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gaa9tyvdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gaa9tyvdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813XuoyEG0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813XuoyEG0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LD5eAtDRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LD5eAtDRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ier7ao5QL.jpg\",\"url\":\"https://storage.googleapis.co