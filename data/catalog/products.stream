    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N276W\",\"sku\":\"B07B4N276W\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-l-sectional-116-w-slate-brown-b07b4n276w\",\"name\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7177AeD4qVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nsls60BqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nsls60BqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-dC5acmzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-dC5acmzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gD3oK-z6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gD3oK-z6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AgDGPT3VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AgDGPT3VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nkzqI9EGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nkzqI9EGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917vl3OxKfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917vl3OxKfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"119.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Slate brown\",\"label\":\"Slate brown\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Left l-sectional\",\"label\":\"Left l-sectional\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":510,\"discountedValue\":459.0}}"
