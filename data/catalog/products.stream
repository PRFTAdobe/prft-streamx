        "bytes": "{\"id\":\"B075X4T46Q\",\"sku\":\"B075X4T46Q\",\"lang\":\"en\",\"slug\":\"leila-tufted-sofa-69-w-hunter-green-b075x4t46q\",\"name\":\"Leila Tufted Sofa, 69&quot; W, Hunter Green\",\"description\":\"This item is made to order just for you 69&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking vintage-look loveseat. With solid wood legs in a dark walnut finish, plush velvet upholstery and a low, curved tufted back, it exudes opulence. Two removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Sofa, 69&quot; W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9181fOOwXvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ckhvE9HZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ckhvE9HZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917FRWB2PfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917FRWB2PfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16GOXv9oXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16GOXv9oXL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"69.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\"