    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLR43G\",\"sku\":\"B082VLR43G\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-leather-livingroom-accent-chair-39-w-grey-b082vlr43g\",\"name\":\"Rivet Alonzo Contemporary Leather Livingroom Accent Chair, 39&quot;W, Grey\",\"description\":\"Sleek, graceful lines combine with modern touches for a vesatile, elegant armchair. A solid-wood frame and strong brass legs offer durability and comfort that will stand the test of time. Overall: 39&quot;W x 37.8&quot;D x 35.4&quot;H. Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and genuine leather upholstery Reversible seat and back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Leather Livingroom Accent Chair, 39&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EHyHEFAbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ii6cv5ZXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ii6cv5ZXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bVXoT9unL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bVXoT9unL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fAMu-FYOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fAMu-FYOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b4EHxd-pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b4EHxd-pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y9m+3l80L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y9m+3l80L.jpg\"},{\"alt\":\"https://storage.