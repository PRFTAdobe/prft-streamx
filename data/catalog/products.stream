    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGFS4JC\",\"sku\":\"B07QGFS4JC\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-desk-42-w-warm-brown-wood-with-veneer-b07qgfs4jc\",\"name\":\"Rivet Mid-Century Desk, 42&quot;W, Warm Brown Wood with Veneer\",\"description\":\"This warm brown wooden desk brings a mission-inspired mid-century flair to your home office or living space. It combines generous writing space and elegant storage drawers so you can keep necessary supplies close at hand. 42&quot;W x 26&quot;D x 29.7&quot;H Chinese ash wood, MDF and Chinese ash veneer; black metal handles The mid-century design of this wooden desk will fit perfectly in your home office or living space. It features ample writing space and 2 drawers with ball-bearing slides and black metal handles. Assemble in 15 minutes or less Wipe with a damp cloth in the direction of the grain. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Desk, 42&quot;W, Warm Brown Wood with Veneer\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817imKa7oHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8123avazqDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8123avazqDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xDwldMRfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xDwldMRfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eKy5BqOZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eKy5BqOZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Prb0s1VyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Prb0s1VyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AU6vGQvjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images