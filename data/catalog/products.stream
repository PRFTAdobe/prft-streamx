        "bytes": "{\"id\":\"B07P6JV16D\",\"sku\":\"B07P6JV16D\",\"lang\":\"en\",\"slug\":\"rivet-emerly-modern-sofa-83-5-w-steel-grey-b07p6jv16d\",\"name\":\"Rivet Emerly Modern Sofa, 83.5&quot;W, Steel Grey\",\"description\":\"Hardwood frame with sturdy mortise-and-tenon joints, performance fabric, metal legs Overall: 83.5&quot;W x 35&quot;D x 34&quot;H; seat height: 19.5&quot;H; seat depth: 28&quot;D; seat back height: 27.5&quot;H; arm height: 27.5&quot;H; leg height: 6&quot;H Wood, 100% polyester fabric, foam, metal Loose and reversible cushions This modern sofa in gray offers durability with removable and reversible cushions that are easy to maintain. Assemble in 15 minutes or less Spot clean stains and rinse with water. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Emerly Modern Sofa, 83.5&quot;W, Steel Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812+VPBi1lL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FOTTeKAtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FOTTeKAtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GGFynw-jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GGFynw-jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fkdZbrt1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fkdZbrt1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uBsrKEDFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uBsrKEDFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YibMGxhoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YibMGxhoL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"i