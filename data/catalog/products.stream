    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0714QGLVP\",\"sku\":\"B0714QGLVP\",\"lang\":\"en\",\"slug\":\"rivet-madison-modern-round-lift-top-storage-tray-ottoman-pouf-19-7-w-grey-storm-b0714qglvp\",\"name\":\"Rivet Madison Modern Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Grey Storm\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila -- it's an extra tray for snacks! An ottoman couldn't be more clever and multi-tasking than this. 19.7&quot;W x 19.7&quot;D x 16.5&quot;H Wood frame Modern, round design Perfect for any room where a storage space or footstool is needed. Simple assembly; just attach four legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Madison Modern Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Grey Storm\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-hAFSwCMS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yzTnc5QtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yzTnc5QtS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HdEKw+xML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HdEKw+xML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f0GiRQOyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f0GiRQOyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DeGw8LWSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DeGw8LWSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+ywx33E8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+ywx33E8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.5\",\"label\":\"inches\"}]},{\"na