    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085686P5N\",\"sku\":\"B085686P5N\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-graphite-b085686p5n\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Graphite\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8141LCJFuML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yhec+HxSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yhec+HxSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61UghISz1lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61UghISz1lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71dfKqK-MZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71dfKqK-MZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DW9SgzbBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DW9SgzbBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Zwh5NTGOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Zwh5NTGOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iN