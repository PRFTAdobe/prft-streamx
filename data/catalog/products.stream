    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHYD4KD\",\"sku\":\"B07QHYD4KD\",\"lang\":\"en\",\"slug\":\"joanna-contemporary-tufted-sofa-couch-with-reversible-cushions-84-w-heather-grey-b07qhyd4kd\",\"name\":\"Joanna Contemporary Tufted Sofa Couch with Reversible Cushions, 84&quot;W, Heather Grey\",\"description\":\"Clean lines give this armchair a modern, sophisticated look. Removable seat cushions and backs are comfortable and easy to adjust, and the performance fabric upholstery can be cleaned with a cloth or simple vacuuming. Steel seat springs and a wood frame provide structure, support and durability. Overall: 84&quot;W x 37&quot;D x 38&quot;H. Seat height: 21.5&quot;H; seat depth: 23&quot;D; seat back height: 19&quot;H Steel seat springs, wood frame and wood legs add structure and durability Loose, reversible seat cushions and inside back cushions in 100% polyester performance fabric Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Joanna Contemporary Tufted Sofa Couch with Reversible Cushions, 84&quot;W, Heather Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Vm8gbsGvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cgjDspD+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cgjDspD+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+EhaPiIxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+EhaPiIxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j5fTMJe8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j5fTMJe8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNHQ3aNzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNHQ3aNzL.jpg\"},{\"alt\":