    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4SBZDV\",\"sku\":\"B07B4SBZDV\",\"lang\":\"en\",\"slug\":\"rivet-jonathan-mid-century-modern-wood-bedroom-dresser-brass-toned-hardware-58-inch-wide-walnut-b07b4sbzdv\",\"name\":\"Rivet Jonathan Mid-Century Modern Wood Bedroom Dresser, Brass-Toned Hardware, 58 Inch Wide, Walnut\",\"description\":\"This classic mid-century modern dresser will have you reveling in retro style as you get dressed each morning. Six drawers with brass-toned hardware rest on a base of four slanted legs. An optional mirror (sold separately) can be mounted on the top. 58&quot;W x 19&quot;D x 35&quot;H; LegHeight: 7.5&quot; Hardwood frame and drawers with a walnut veneer and brass hardware A classic example of mid-century modern design Six drawers provide ample storage for clothing, jewelry and other items Easy assembly in 15 minutes; just bolt on base Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Jonathan Mid-Century Modern Wood Bedroom Dresser, Brass-Toned Hardware, 58 Inch Wide, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H1wyOROnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819TscY1p1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819TscY1p1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IQmrzA1uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IQmrzA1uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KSguIB1fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KSguIB1fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GaUE+YGiL.jpg\",\"url\":\"http