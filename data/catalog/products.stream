        "bytes": "{\"id\":\"B071J7Q39G\",\"sku\":\"B071J7Q39G\",\"lang\":\"en\",\"slug\":\"dalton-performance-fabric-living-room-accent-arm-chair-41-5-w-stone-b071j7q39g\",\"name\":\"Dalton Performance Fabric Living Room Accent Arm Chair, 41.5&quot;W, Stone\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this arm chair. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 41.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Performance Fabric Living Room Accent Arm Chair, 41.5&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A152TDHRs7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91labkmmVIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91labkmmVIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PKH27g0xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PKH27g0xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B107kImwfCS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B107kImwfCS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+km4C0RVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+km4C0RVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"41.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\