    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D4964\",\"sku\":\"B07B4D4964\",\"lang\":\"en\",\"slug\":\"andover-modern-right-chaise-sofa-sectional-126-w-pewter-b07b4d4964\",\"name\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Pewter\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 126&quot;W x 61&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H 80% cotton/20% polyester blend fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JoD9uScUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ENlIVCioL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ENlIVCioL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T42bzT2lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T42bzT2lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c62rBDc2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c62rBDc2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+hJlDjmuL.jpg\",\"url\":\"https: