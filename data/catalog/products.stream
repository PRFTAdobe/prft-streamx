    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MPXJP\",\"sku\":\"B07B4MPXJP\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-35-h-cream-b07b4mpxjp\",\"name\":\"Andover Modern Living Room Accent Chair, 35&quot;H, Cream\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. 38&quot;L x 38&quot;W x 35&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 35&quot;H, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-O-4txZaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EPSJJxuLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EPSJJxuLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Kk6Mxo1sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Kk6Mxo1sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ibruwDhPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ibruwDhPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nMBFI8d7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nMBFI8d7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNt6PHfjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNt6PHfjL.jpg\"}],\"attributes\":[{\"name\":\"height\"