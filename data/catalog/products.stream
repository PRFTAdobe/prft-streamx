    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8VJ4H\",\"sku\":\"B07BW8VJ4H\",\"lang\":\"en\",\"slug\":\"andover-modern-left-u-sectional-sofa-134-w-linen-b07bw8vj4h\",\"name\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Linen\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H 80% cotton/20% polyester blend fabric on hardwood pine frame Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cwCeAjv5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Tiv1p89VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Tiv1p89VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OP87BTSaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OP87BTSaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FusIt+CnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FusIt+CnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pnHp4mBxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pnHp4mBxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\"