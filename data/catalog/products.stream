    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB9K6\",\"sku\":\"B07QCMB9K6\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-ottoman-with-wood-base-and-legs-30-w-fog-gray-b07qcmb9k6\",\"name\":\"Hillman Mid-Century Ottoman with Wood Base and Legs, 30&quot;W, Fog Gray\",\"description\":\"A wide cushion and tapered wood legs are the hallmarks of this mid-century inspired ottoman. Easy-care gray upholstery helps keep this piece looking fresh over time, and a hardwood frame and tapered legs lends structure to the foam-padded cushion. 30&quot;W x 22&quot;D x 18&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Ottoman with Wood Base and Legs, 30&quot;W, Fog Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S2JEUv2dL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918DZNGE6IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918DZNGE6IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iTwcnKRPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iTwcnKRPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zAnqvKm2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zAnqvKm2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IcgveNqmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IcgveNqmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ahs2jTegL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ahs2jTegL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v+NyoRJfL.jpg