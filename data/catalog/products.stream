    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4JB18\",\"sku\":\"B075X4JB18\",\"lang\":\"en\",\"slug\":\"rivet-modern-oversized-upholstered-square-ottoman-38-w-bear-b075x4jb18\",\"name\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Bear\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Bear\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bn2pq2L5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P9k1yEsfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P9k1yEsfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zJpKySlOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zJpKySlOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qb2AWnNcS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qb2AWnNcS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"len