    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4JB3K\",\"sku\":\"B075X4JB3K\",\"lang\":\"en\",\"slug\":\"rivet-eva-tufted-mid-century-velvet-down-filled-loveseat-60-5-w-hunter-green-b075x4jb3k\",\"name\":\"Rivet Eva Tufted Mid-Century Velvet Down-Filled Loveseat, 60.5&quot;W, Hunter Green\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted loveseat featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible, and is held in place by clips at the corners. 60.5&quot;W x 35.25''D x 30.25''H Durable polyester velvet on hardwood frame and brushed brass legs Modern elegant style with reversible cushion to extend the life of the piece Free returns for 30 days. 1-year warranty. Simple assembly in 15 minutes or less. Vacuum or wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Eva Tufted Mid-Century Velvet Down-Filled Loveseat, 60.5&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JpgqJD6CL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EZ75HkE6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EZ75HkE6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iJk+hrPXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iJk+hrPXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HwG7oyuYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HwG7oyuYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"60.5\",\"label\":\"in