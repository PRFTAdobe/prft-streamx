    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P9Y5SDP\",\"sku\":\"B07P9Y5SDP\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-top-grain-leather-chair-with-removable-cushions-40-w-dark-brown-b07p9y5sdp\",\"name\":\"Rivet Andrews Contemporary Top-Grain Leather Chair with Removable Cushions, 40&quot;W, Dark Brown\",\"description\":\"This chair features removable cushions in an attractive brown leather that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 40&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable back and seat cushions Mid-century style and top grain leather combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Top-Grain Leather Chair with Removable Cushions, 40&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71isvWegUUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NHg3rm3WL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NHg3rm3WL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jZqlzME+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jZqlzME+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pyxCwDfRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pyxCwDfRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JKZ2hPnvL.jpg\",\"url\":\"https://storage.googlea