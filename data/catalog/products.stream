    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07C9W437G\",\"sku\":\"B07C9W437G\",\"lang\":\"en\",\"slug\":\"rivet-federal-mid-century-modern-wood-dining-room-kitchen-chairs-36-inch-height-set-of-2-black-b07c9w437g\",\"name\":\"Rivet Federal Mid-Century Modern Wood Dining Room Kitchen Chairs, 36 Inch Height, Set of 2, Black\",\"description\":\"The rounded seat, simple tall back and tapered wooden legs are hallmarks of mid-century modern style, but understated enough to allow this chair to blend in a transitional décor. Performance fabric and sturdy construction make it durable. 21&quot;W x 24&quot;D x 36&quot;H; Seat Height: 18.5&quot;H ; Seat Depth: 17.5&quot;D; Seat Back Height: 18.5&quot;H Hardwood legs and frame; polyester fabric Assembly in 30 minutes or less; just bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Federal Mid-Century Modern Wood Dining Room Kitchen Chairs, 36 Inch Height, Set of 2, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wvaSBsCGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rW7mcNtnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rW7mcNtnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ahu4LdBYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ahu4LdBYS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+41mGEt7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+41mGEt7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMVjfjBoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMVjfjBoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xXrmBaLJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xXrmBaLJL.jpg\"}],\"attributes\"