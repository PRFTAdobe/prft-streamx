    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4YDJT\",\"sku\":\"B075X4YDJT\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-cube-ottoman-pouf-20-w-gold-leaf-b075x4ydjt\",\"name\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Gold Leaf\",\"description\":\"This item is made to order just for you 20&quot;W x 20&quot;Dx 17&quot;H Solid wood frame, 100% polyester fabric. Multi-purpose cube ottoman is great in any space. Free returns for 30 days. 1-year warranty. Prop up your feet or add a tray of your favorite snacks to the top of this plush cube ottoman. Sturdy enough to use as an extra seat in any room, this versatile ottoman is offered in a range of fabrics. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Gold Leaf\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AV8kc3XSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16G6znCbtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16G6znCbtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14xcKy0snL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14xcKy0snL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IDmnSX81L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IDmnSX81L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1G78lonFpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1G78lonFpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.0\",\"label\":\"i