    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GSBRD\",\"sku\":\"B07B4GSBRD\",\"lang\":\"en\",\"slug\":\"appleton-farmhouse-recliner-35-w-beige-b07b4gsbrd\",\"name\":\"Appleton Farmhouse Recliner, 35&quot;W, Beige\",\"description\":\"This is definitely not your dad's old overstuffed recliner. This chair features graceful style, neutral colors and durable fabric. With its rolled arms and tufted back, it has the right touches of modern and classic to blend with most decor. 35&quot;W x 40&quot;D x 41&quot;H; Seat Height: 20&quot;H ; Seat Depth: 21&quot;D; Seat Back Height: 41&quot;H; Arm Height: 24&quot;H; Front legs: 5.625&quot;H; Back legs: 4.75&quot;H Stain-resistant polyester fabric, sturdy pine wood frame Modern and classic touches come together for a transitional style Push back reclining mechanism; removable and reversible seat cushion No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Appleton Farmhouse Recliner, 35&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81szQ+Axw5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z84FsJOZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z84FsJOZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AcUmmoVWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AcUmmoVWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EENla5ehL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EENla5ehL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhspu3VuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhspu3VuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O