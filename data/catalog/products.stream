        "bytes": "{\"id\":\"B07HSF8FXH\",\"sku\":\"B07HSF8FXH\",\"lang\":\"en\",\"slug\":\"hartford-modern-denim-style-fabric-kitchen-counter-height-bar-stool-40-5-h-navy-blue-b07hsf8fxh\",\"name\":\"Hartford Modern Denim-Style Fabric Kitchen Counter-Height Bar Stool, 40.5&quot;H, Navy Blue\",\"description\":\"This classic Parsons-style counter-height bar stool is understated enough for your farmhouse-style kitchen while still being at home in a formal modern dining room. Featuring a gorgeous easy-care navy fabric seat and back and a solid-wood frame, this comfortable cushioned stool is easily dressed up or down. Solid wood frame, silver metal kick plate and durable 100% polyester fabric Pair them for a sophisticated look or use them singly as an accent chair in your foyer or living room. These stools come fully assembled. Dust or wipe clean with a soft, dry cloth. Avoid abrasive cleaner. Keep indoors, away from direct sunlight, heat, or air conditioning. 18.5&quot;W x 21.5&quot;D x 40.5&quot;H Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hartford Modern Denim-Style Fabric Kitchen Counter-Height Bar Stool, 40.5&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GJsu53m2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814+zNBc72L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814+zNBc72L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hGrP9yHZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hGrP9yHZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TwK9x1eHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TwK9x1eHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eBCCqpIaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eBCCqpIaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0nNQVZtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0nNQVZtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"21.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"19.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"24\",\"label\":\"24\"},{\"value\":\"Products\",\"label\":\"Products\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Backs\",\"label\":\"Backs\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Tractor\",\"label\":\"Tractor\"},{\"value\":\"Automotive\",\"label\":\"Automotive\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Bancos\",\"label\":\"Bancos\"},{\"value\":\"Counter\",\"label\":\"Counter\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Inches\",\"label\":\"Inches\"},{\"value\":\"Cyclones\",\"label\":\"Cyclones\"},{\"value\":\"Height\",\"label\":\"Height\"},{\"value\":\"Teak\",\"label\":\"Teak\"},{\"value\":\"High\",\"label\":\"High\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Barstool\",\"label\":\"Barstool\"},{\"value\":\"Tools\",\"label\":\"Tools\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Barstools\",\"label\":\"Barstools\"},{\"value\":\"Tall\",\"label\":\"Tall\"},{\"value\":\"Barra\",\"label\":\"Barra\"},{\"value\":\"Island\",\"label\":\"Island\"},{\"value\":\"Shop\",