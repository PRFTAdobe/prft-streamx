    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073G7WN3H\",\"sku\":\"B073G7WN3H\",\"lang\":\"en\",\"slug\":\"truve-modern-studded-ottoman-19-w-damask-grey-b073g7wn3h\",\"name\":\"Truve Modern Studded Ottoman, 19&quot;W, Damask Grey\",\"description\":\"This beautifully styled ottoman also serves as extra storage space. Its unique curved edges, covered in linen/cotton fabric and accentuated with brass nail-head trim, bring character and class to any room. 19&quot;W x 17&quot;D x 19&quot;H Strong wood frame with linen/cotton upholstery Casual and functional Provides stylish storage No assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Truve Modern Studded Ottoman, 19&quot;W, Damask Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZVH9dy7JL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zp7yXYPcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zp7yXYPcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AkfAq5f7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AkfAq5f7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u6UUpG4BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u6UUpG4BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rd8rAoNRS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rd8rAoNRS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hHTuJmLCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hHTuJmLCL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\