    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N1RJP\",\"sku\":\"B07B4N1RJP\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-loveseat-58-w-grey-linen-b07b4n1rjp\",\"name\":\"Brandeberry Farmhouse Charles of London Loveseat, 58&quot;W, Grey Linen\",\"description\":\"The classic English roll arm gives this cozy loveseat a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 58&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Loveseat, 58&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GXlYbj+RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912nbmBQLVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912nbmBQLVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iyo5xMXBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iyo5xMXBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DZl4ZIR9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DZl4ZIR9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\"},{\"alt\":\"https://storage.googleapis.c