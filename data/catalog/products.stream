    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWNLQX\",\"sku\":\"B07QGWNLQX\",\"lang\":\"en\",\"slug\":\"rivet-modern-dining-chairs-set-of-2-39-5-h-blue-b07qgwnlqx\",\"name\":\"Rivet Modern Dining Chairs, Set of 2, 39.5&quot;H, Blue\",\"description\":\"These high-back dining chairs feature blue plush upholstered fabric on a durable metal frame for a distinctive contemporary look. Open sides allow for freedom of movement, perfect for gatherings around the dining table. 19.5&quot;W x 21.25&quot;D x 39.5&quot;H; seat height: 25.5&quot;H; seat depth: 17.5&quot;D; seat back height: 13.5&quot;H Durable fabric on metal frame The foam padding and elastic suspension system help keep the back and seat firm and springy. Contemporary design combines plush blue upholstered fabric with metal legs finished in black. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Dining Chairs, Set of 2, 39.5&quot;H, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71R538hBrfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Svq1PrgUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Svq1PrgUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b8Zj+wsRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b8Zj+wsRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71adH+KvHtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71adH+KvHtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rzDeehxLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rzDeehxLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fNKOxA3qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight