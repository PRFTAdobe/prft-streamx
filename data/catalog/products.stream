    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7TL95\",\"sku\":\"B07HZ7TL95\",\"lang\":\"en\",\"slug\":\"genesse-loveseat-sofa-couch-64-w-smokey-blue-b07hz7tl95\",\"name\":\"Genesse Loveseat Sofa Couch, 64&quot;W, Smokey Blue\",\"description\":\"Complete your interior design with this beautiful smoky-blue sofa. Its performance-fabric upholstery offers comfortable seating, and its clean lines and modern narrow-arm and thin-leg design make this sofa an ideal addition to transitional-style home decor. Overall: 64&quot;W x 39&quot;D x 34&quot;H; Seat Height: 19.68&quot;H; Seat Depth 22.05&quot;D; Seat Back Height: 23.62&quot;H; Arm Height: 23.62&quot;H; Leg Height: 5.51&quot;H Solid-wood frame and legs with performance fabric upholstery Slim-arm design with wooden plinth Foam cushions provide lasting comfort Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Genesse Loveseat Sofa Couch, 64&quot;W, Smokey Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816hZ9L45rL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BaX2waMKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BaX2waMKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-vt8jls0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-vt8jls0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJM+3GhYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJM+3GhYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8141707v2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8141707v2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F5bU74TxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F5bU74TxL.jpg\"}],\"a