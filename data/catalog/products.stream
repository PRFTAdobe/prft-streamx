      "content": {
        "bytes": "{\"id\":\"B084W32QVB\",\"sku\":\"B084W32QVB\",\"lang\":\"en\",\"slug\":\"morgan-memory-swivel-counter-height-barstool-38-2-h-hemp-b084w32qvb\",\"name\":\"Morgan Memory-Swivel Counter-Height Barstool, 38.2&quot;H, Hemp\",\"description\":\"This counter-height barstool features a memory swivel that returns the seat to its proper position every time. The hemp-colored upholstery and button-tufted chair back give this barstool a touch of class. 20.5&quot;W x 24&quot;D x 38.2&quot;H; seat height: 26&quot;H; seat depth: 16.9&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric A memory-swivel mechanism means this barstool always looks tidy. Button-tufting makes this barstool stand out. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Morgan Memory-Swivel Counter-Height Barstool, 38.2&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DqR0UZZ7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEdCUfxcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEdCUfxcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RZL22qXSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RZL22qXSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71L+btdq1kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71L+btdq1kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gpHbAVUDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gpHbAVUDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817EUA514AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817EUA514AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A4nloJLoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A4nloJLoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZA1OiYmpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZA1OiYmpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.2\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.2\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"24\",\"label\":\"24\"},{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Backs\",\"label\":\"Backs\"},{\"value\":\"Creeper\",\"label\":\"Creeper\"},{\"value\":\"Tools\",\"label\":\"Tools\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Tractor\",\"label\":\"Tractor\"},{\"value\":\"Automotive\",\"label\":\"Automotive\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Bar\",\"label\":\"Bar\"},{\"value\":\"2\",\"label\":\"2\"},{\"value\":\"Counter\",\"label\":\"Counter\"},{\"value\":\"Low\",\"label\":\"Low\"},{\"value\":\"Kitchen\",\"label\":\"Kitchen\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Inches\",\"label\":\"Inches\"},{\"value\":\"Creepers\",\"label\":\"Creepers\"},{\"value\":\"Height\",\"label\":\"Height\"}]}],\"categories\":[{\"id\":\"Barstools\",\"slug\":\"barstools\",\"name\":\"Barstools\",\"value\":\"Barstools\",\"label\":null,\"parent\":null,\"subcategories\":[]},{\"id\":\"Featured\",\"slug\":\"featured\",\"name\":\"Featured\",\"value