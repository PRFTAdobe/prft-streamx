    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2X4RY\",\"sku\":\"B075X2X4RY\",\"lang\":\"en\",\"slug\":\"marin-leather-studded-sofa-87-w-walnut-b075x2x4ry\",\"name\":\"Marin Leather Studded Sofa, 87&quot;W, Walnut\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with rich leather upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Rich leather and clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Leather Studded Sofa, 87&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DKkB8iptL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GTkWJVipL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GTkWJVipL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Re3iu4K3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Re3iu4K3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fTRHLMbVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fTRHLMbVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"n