  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCZ7YW\",\"sku\":\"B082QCZ7YW\",\"lang\":\"en\",\"slug\":\"rivet-madison-modern-vegan-faux-leather-round-lift-top-storage-tray-ottoman-pouf-19-7-w-black-b082qcz7yw\",\"name\":\"Rivet Madison Modern Vegan Faux Leather Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Black\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila—it's an extra tray for snacks! An ottoman couldn't be more clever and multitasking than this. 19.7&quot;W x 19.7&quot;D x 16.5&quot;H Compact and stable with wood-frame construction and vegan leather exterior Perfect for any room where storage space or a footstool is needed. Modern styling perfect for your contemporary home. Simple assembly in 15 minutes or less. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Madison Modern Vegan Faux Leather Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816y06roTnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pX4p7IwhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pX4p7IwhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qrrhdW6fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qrrhdW6fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81brSDyl6IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81brSDyl6IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kNHma8WuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kNHma8WuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UkcceRIfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UkcceRIfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.68\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"19.68\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"13.45\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Upholstered\",\"label\":\"Upholstered\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Square\",\"label\":\"Square\"},{\"value\":\"Foot\",\"label\":\"Foot\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Rest\",\"label\":\"Rest\"},{\"value\":\"Entryway\",\"label\":\"Entryway\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Poufs\",\"label\":\"Poufs\"},{\"value\":\"Footstools\",\"label\":\"Footstools\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":785,\"discountedValue\":706.5}}"
