    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9Y6XZ\",\"sku\":\"B07QF9Y6XZ\",\"lang\":\"en\",\"slug\":\"rivet-fulton-rustic-media-cabinet-63-w-natural-acacia-accents-b07qf9y6xz\",\"name\":\"Rivet Fulton Rustic Media Cabinet, 63&quot;W, Natural Acacia Accents\",\"description\":\"This Scandinavian-inspired, contemporary media console has a sleek yet rustic feel with angled patterns created from acacia slats and modern legs. Cable management holes help reduce tangles, while 2 cabinets create additional storage space. Neutral tones make this a great choice for any home. 63&quot;W x 18&quot;D x 19&quot;H 74% MDF, 18% acacia, 8% plywood This console, inspired by Scandinavian designs, creates a sleek and minimalist look for a contemporary style in any home. Cable management holes help control tangles, while the 2 cabinets offer additional storage. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fulton Rustic Media Cabinet, 63&quot;W, Natural Acacia Accents\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TN7DziPYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bMIPOovhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bMIPOovhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711M5WAjPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711M5WAjPdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XtMeW1t8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XtMeW1t8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916qnCxq48L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916qnCxq48L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ez+5BNZ