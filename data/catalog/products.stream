    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PT4Q\",\"sku\":\"B075X4PT4Q\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-ottoman-27-w-smoke-b075x4pt4q\",\"name\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Smoke\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Firm nylon webbing makes cushion resilient Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Smoke\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811UYsfkb8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91snK+WUfyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91snK+WUfyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ainMgdEhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ainMgdEhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VeGZ9ZywL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VeGZ9ZywL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15xLHGPQaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15xLHGPQaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"27.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Smoke\",\"label\":\"Smoke\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":735,\"discountedValue\":661.5}}"
