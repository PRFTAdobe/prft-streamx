    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8JVJ\",\"sku\":\"B0723H8JVJ\",\"lang\":\"en\",\"slug\":\"dalton-performance-fabric-loveseat-sofa-63-5-w-stone-b0723h8jvj\",\"name\":\"Dalton Performance Fabric Loveseat Sofa, 63.5&quot;W, Stone\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this arm chair. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 63.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Performance Fabric Loveseat Sofa, 63.5&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pXtl4yXZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911oxbWTxwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911oxbWTxwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YBdeW3VnS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YBdeW3VnS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WAWS1FPRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WAWS1FPRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aECRqjOEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aECRqjOEL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"63.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]