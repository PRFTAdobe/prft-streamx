        "bytes": "{\"id\":\"B07B4YXWJP\",\"sku\":\"B07B4YXWJP\",\"lang\":\"en\",\"slug\":\"rivet-fairmount-industrial-metal-king-bed-with-headboard-79-5-w-black-b07b4yxwjp\",\"name\":\"Rivet Fairmount Industrial Metal King Bed with Headboard, 79.5&quot;W, Black\",\"description\":\"85&quot;L x 79.5&quot;W x 46&quot;H Sturdy metal construction Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 1-year warranty. This classic metal spindle bed features modern updates and simple, clean lines. The slightly curved headboard with traditional round spindles combines with the sharp black finish for a fun, fresh style.\",\"primaryImage\":{\"alt\":\"Rivet Fairmount Industrial Metal King Bed with Headboard, 79.5&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M8ZPGbKOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TfwqaudGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TfwqaudGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NrlfL9PKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NrlfL9PKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81opD9k1FbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81opD9k1FbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9126oGinLwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9126oGinLwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L5WAksrqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L5WAksrqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"46.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"79.5\",\"label\":\"inches\"}]},{\"name\