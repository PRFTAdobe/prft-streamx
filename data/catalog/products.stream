    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B8J8LXH\",\"sku\":\"B07B8J8LXH\",\"lang\":\"en\",\"slug\":\"bruckner-casual-wood-side-table-24-w-brown-b07b8j8lxh\",\"name\":\"Bruckner Casual Wood Side Table, 24&quot;W, Brown\",\"description\":\"This handsome side table features simple lines and a warm finish that's ideal for any casual room next to your favorite chair or sofa. It's the perfect perch for your lamp and page-turner book. 24&quot;L x 24&quot;W x 25&quot;H Rubber and poplar hardwoods; birch veneer A transitional piece with touches of modern, rustic and global styles Rattan adds texture to your room along with storage space Assembly in 30 minutes or less; assemble and attach bases Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bruckner Casual Wood Side Table, 24&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lnkmjU2BL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DMYUBrVWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DMYUBrVWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eL+KegodL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eL+KegodL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Qfripvx2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Qfripvx2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kqZZ3rSkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kqZZ3rSkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L4fKM70eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L4fKM70eL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",