    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JZJPR\",\"sku\":\"B0857JZJPR\",\"lang\":\"en\",\"slug\":\"stella-modern-farmhouse-woven-dining-bench-47-2-w-gray-b0857jzjpr\",\"name\":\"Stella Modern Farmhouse Woven Dining Bench, 47.2&quot;W, Gray\",\"description\":\"This simple modern bench, made of rubberwood and rattan, is durable yet soft to sit on. It can fit in anywhere you need bench seating, whether you're having a quiet dinner or throwing a party. 47.2&quot;W x 20&quot;D x 18&quot;H Rubberwood frame with woven paper-rope seat This bench's solid rubberwood frame will last, while its simplicity and portability make it a perfect mainstay or add-on for gatherings anywhere. The attractive modern gray rubberwood frame is complemented by handwoven, comfortable paper-rope seating. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Stella Modern Farmhouse Woven Dining Bench, 47.2&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71I534TWwRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z8KyCAcwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z8KyCAcwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ouNBGghvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ouNBGghvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nKtd5JMeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nKtd5JMeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WFIFQ2ksL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WFIFQ2ksL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711dnPvr2vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-image