        "bytes": "{\"id\":\"B07PBZVNVD\",\"sku\":\"B07PBZVNVD\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-leather-sofa-couch-80-w-chestnut-b07pbzvnvd\",\"name\":\"Rivet Revolve Modern Leather Sofa Couch, 80&quot;W, Chestnut\",\"description\":\"This modern sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. 79.9&quot;W x 34.6&quot;D x 35.4&quot;H Hardwood frame, solid beech wood legs and durable leather upholstery stand up to wear and tear Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Leather Sofa Couch, 80&quot;W, Chestnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zPljYpQ7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812n803IpEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812n803IpEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EBfxuE1EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EBfxuE1EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iukO9KHvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iukO9KHvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j4NOUZcxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j4NOUZcxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71R9t+NPegL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71R9t+NPegL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\"