    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XDJKD\",\"sku\":\"B0831XDJKD\",\"lang\":\"en\",\"slug\":\"cypress-modern-tufted-farmhouse-sofa-couch-85-w-grey-b0831xdjkd\",\"name\":\"Cypress Modern Tufted Farmhouse Sofa Couch, 85&quot;W, Grey\",\"description\":\"This sumptuously padded gray sofa with a tufted back brings both comfort and style to your living room. High side arms provide extra support and a distinctive flair. The performance upholstery is durable and makes spot cleaning a breeze. This will be a favorite sofa for years! 85&quot;W x 30.5&quot;D x 30&quot;H; seat height: 18.5&quot;H; seat depth: 24&quot;D; seat back height: 30&quot;H; arm height: 30&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Cypress Modern Tufted Farmhouse Sofa Couch, 85&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71s8wg1XC1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DEVyUJrgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DEVyUJrgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NyqJ7TRoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NyqJ7TRoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nNVXRlIlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nNVXRlIlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71udZIJ8jBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina