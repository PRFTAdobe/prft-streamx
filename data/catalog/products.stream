    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VW4D\",\"sku\":\"B075X4VW4D\",\"lang\":\"en\",\"slug\":\"rivet-lawson-mid-century-modern-angled-leather-loveseat-sofa-couch-78-w-driftwood-b075x4vw4d\",\"name\":\"Rivet Lawson Mid-Century Modern Angled Leather Loveseat Sofa Couch, 78&quot;W, Driftwood\",\"description\":\"This item is made to order just for you 78&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated sofa. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Mid-Century Modern Angled Leather Loveseat Sofa Couch, 78&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DqPNGigcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gCfxdpoFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gCfxdpoFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ynno7NNmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ynno7NNmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H3ADbSXsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H3ADbSXsL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"na