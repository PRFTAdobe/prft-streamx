    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSMYP14\",\"sku\":\"B07HSMYP14\",\"lang\":\"en\",\"slug\":\"rivet-geometric-elm-wood-coffee-table-43-w-dark-grey-finish-b07hsmyp14\",\"name\":\"Rivet Geometric Elm Wood Coffee Table, 43&quot;W, Dark Grey Finish\",\"description\":\"Rustic meets modern in this stylish and efficient hexagon coffee table. Elm wood construction is finished with a brushed, dark grey stain for a modern piece with the appeal of natural wood. 42.49&quot;W x 42.49&quot;D x 19.17&quot;H Contemporary six-sided wood top and wood base with brushed dark natural finish. Elm wood construction with a sturdy base and raised rim to help keep tabletop items in place. No assembly required. Free 30 returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Geometric Elm Wood Coffee Table, 43&quot;W, Dark Grey Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JZ9giYQ-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UGPbP+I9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UGPbP+I9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ul0r9YlVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ul0r9YlVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o48X5knGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o48X5knGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j4cpEP+HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j4cpEP+HL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.17\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"42.49\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"42.49\",\"label\":\"inches\"}]},{\