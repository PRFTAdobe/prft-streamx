    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072FVHRZ1\",\"sku\":\"B072FVHRZ1\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-sofa-with-reversible-sectional-chaise-80-w-denim-blue-b072fvhrz1\",\"name\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Denim Blue\",\"description\":\"This modern sectional sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. Hardwood frame, solid beech wood legs and durable polyester upholstery stand up to wear and tear The chaise can be moved to either end to accommodate your room layout -- and it provides an extra seat for company. Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty. Sofa only: 79.9&quot;W x 34.6&quot;D x 35.4&quot;H Sofa and ottoman: 79.9&quot;W x 62.2&quot;D x 35.4&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Denim Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dleBZ+GFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51LxhHdFlFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51LxhHdFlFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NL2Qo1QNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NL2Qo1QNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z6dw3R6BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z6dw3R6BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51p3n93AZrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51p3n93AZrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim