      "content": {
        "bytes": "{\"id\":\"B07B4W2ZFM\",\"sku\":\"B07B4W2ZFM\",\"lang\":\"en\",\"slug\":\"rivet-fisher-rustic-wood-nightstand-22-reclaimed-look-wood-b07b4w2zfm\",\"name\":\"Rivet Fisher Rustic Wood Nightstand, 22&quot;, Reclaimed-Look Wood\",\"description\":\"A mix of style and function, this rustic nightstand is a great addition to farmhouse decor. It features a blend of multi-toned wood with an iron base and drawer pull. Stash all your bedside essentials in the single drawer and add a lamp on top. 22&quot;W x 16&quot;D x 24&quot;H; LegHeight: 16&quot; Self-close drawer with dovetail joint. Assemble all parts in 15-30 minutes Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Fisher Rustic Wood Nightstand, 22&quot;, Reclaimed-Look Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917-rcz0aCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10XAfcqzmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10XAfcqzmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ORXdSItGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ORXdSItGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12X3IlZAgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12X3IlZAgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+5f+9HsJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+5f+9HsJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11ZMp+9D8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11ZMp+9D8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lpNDALMnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lpNDALMnL.jpg\"}],