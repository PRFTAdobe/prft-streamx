      "content": {
        "bytes": "{\"id\":\"B07PMS5D2D\",\"sku\":\"B07PMS5D2D\",\"lang\":\"en\",\"slug\":\"solimo-xena-solid-wood-console-table-cocoa-finish-b07pms5d2d\",\"name\":\"Solimo Xena Solid Wood Console Table (Cocoa Finish)\",\"description\":\"Table Dimensions: Length (38 inches) , Width (15 inches), Height (28 inches) Material: Solid Pine Wood with a premium Cocoa finish No assembly required Warranty: 3-year warranty on manufacturing defects Over 20 tests conducted to ensure quality and safety Underwent dynamic loading tests for over 10,000 cycles Load bearing capacity of 36 kg to provide proper support Free from burrs & sharp edges for enhanced safety; Made free from toxins or harmful chemicals to promise safe usage\",\"primaryImage\":{\"alt\":\"Solimo Xena Solid Wood Console Table (Cocoa Finish)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CZnSBg1BL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QJrSNuGTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QJrSNuGTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CMvgziHoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CMvgziHoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QD57EVujL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QD57EVujL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fVo3b-k0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fVo3b-k0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bRXHS8krL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bRXHS8krL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61sOF5y8o7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/orig