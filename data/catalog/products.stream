    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZ31M\",\"sku\":\"B07QGSZ31M\",\"lang\":\"en\",\"slug\":\"abigail-loveseat-sofa-64-w-haze-b07qgsz31m\",\"name\":\"Abigail Loveseat Sofa, 64&quot;W, Haze\",\"description\":\"Comfort meets class in this attractive transitional-style love seat. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this love seat. 64&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The removable seat and back cushions ensure durability and comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Loveseat Sofa, 64&quot;W, Haze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ykhwTeraL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yuBom7l+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yuBom7l+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYtVYwnNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYtVYwnNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S+N+szwFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S+N+szwFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918wj3YmvyL.jpg\",\"url\":\"https://storage.googleapis.com/pures