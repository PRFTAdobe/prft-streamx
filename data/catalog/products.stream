    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6GF42\",\"sku\":\"B07HZ6GF42\",\"lang\":\"en\",\"slug\":\"rivet-goodwin-modern-loveseat-61-8-w-navy-blue-fabric-b07hz6gf42\",\"name\":\"Rivet Goodwin Modern Loveseat, 61.8&quot;W, Navy-Blue Fabric\",\"description\":\"This striking loveseat will be the perfect finishing touch for your modern-style home decor. With its beautiful navy-blue upholstery, this loveseat will nicely complement your existing interior design, and its sleek, classy design adds elegance to any room. Overall: 68.1&quot;W x 36.2&quot;D x 35.8&quot;H; Seat Height: 18.5&quot;H; Seat Depth 22&quot;D; Seat Back Height: 20.1&quot;H; Arm Height: 26.4&quot;H; Leg Height: 6.3&quot;H Solid-wood frame and legs with 100% polyester upholstery Strong slim legs elevate this piece and add modern flair. The soft, removable back and reversible cushions ensure durability and comfort. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Goodwin Modern Loveseat, 61.8&quot;W, Navy-Blue Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b-yRKWkmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aL3Oa7dOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aL3Oa7dOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lpXFK9XIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lpXFK9XIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KybFoqSzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KybFoqSzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ILouvrUNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ILouvrUNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images