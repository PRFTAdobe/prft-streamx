    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VWFB\",\"sku\":\"B075X4VWFB\",\"lang\":\"en\",\"slug\":\"leila-tufted-chair-44-w-smoky-teal-b075x4vwfb\",\"name\":\"Leila Tufted Chair, 44&quot; W, Smoky Teal\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage look chair. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Chair, 44&quot; W, Smoky Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j1KgsMuTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SLfMqQUuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SLfMqQUuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KJcNpaLbS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KJcNpaLbS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e+te01d6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e+te01d6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"l