        "bytes": "{\"id\":\"B07MF1SFJ5\",\"sku\":\"B07MF1SFJ5\",\"lang\":\"en\",\"slug\":\"ravenna-home-modern-counter-stool-with-back-38-25-inch-height-white-set-of-2-b07mf1sfj5\",\"name\":\"Ravenna Home Modern Counter Stool with Back, 38.25 Inch Height, White, Set of 2\",\"description\":\"Overall: 24.75&quot;W x 18&quot;D x 38.25&quot;H; seat height: 24&quot;H; seat depth: 17.5&quot;D; seat back height: 14.5&quot;H Barstool of durable fabric on wood frame Contemporary design with wooden frame and upholstered white fabric; solid-wood legs with black finish Foam padding and elastic suspension system keep the back and seat firm and springy. Assemble in 15-30 minutes Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Modern Counter Stool with Back, 38.25 Inch Height, White, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61PPvO0+O9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61mCOYrOz+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61mCOYrOz+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QqreA52oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QqreA52oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61d5GT3+WmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61d5GT3+WmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EtKdY4idL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EtKdY4idL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7x1thHfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j7x1thHfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-67TvqgNL