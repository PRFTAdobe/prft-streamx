      "content": {
        "bytes": "{\"id\":\"B075YMY1S1\",\"sku\":\"B075YMY1S1\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-upholstered-low-back-kitchen-bar-stool-41-h-blue-b075ymy1s1\",\"name\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Bar Stool, 41&quot;H, Blue\",\"description\":\"Fabric is 60% polyester/20% linen/20% rayon Foam padding and elastic suspension system helps keep seat firm No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty. This fun bar stool features an upholstered low-back seat on tall, straight wood legs. Firm padding and a solid wood frame add sturdiness and durability, while the marine blue fabric gives your bar area a nice pop of color. 20&quot;W x 21&quot;D x 41&quot;H. Seat height is 30&quot;.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Bar Stool, 41&quot;H, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iA2E+h+sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81R9VhTCF-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81R9VhTCF-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817uxh1WatL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817uxh1WatL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ln1pCn13L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ln1pCn13L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jMRMIKHlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jMRMIKHlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aPP22XTiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aPP22XTiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1