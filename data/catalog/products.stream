    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4JJK9\",\"sku\":\"B075X4JJK9\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-accent-chair-32-w-berry-b075x4jjk9\",\"name\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Berry\",\"description\":\"A straight back and sloping, low-profile arms are the highlights of this mid-century inspired chair. Assembled in the U.S., it features a sturdy wood frame upholstered with durable, tightly woven fabric for a handsome design that's built to last. This item is made to order just for you 32&quot;W x 33&quot;D x 38&quot;H. Seat height is 19&quot;. Sturdy wood frame, durable polyester fabric, wood legs with walnut finish A Mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Berry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iZeDGJCeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915ru6x9DtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915ru6x9DtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMHzBy7JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMHzBy7JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rc6MEMwDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rc6MEMwDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Wchxd-NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Wchxd-NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sLmS619zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sLmS619zL.jpg\"}],\"attributes\":