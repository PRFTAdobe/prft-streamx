        "bytes": "{\"id\":\"B07DBGHY3F\",\"sku\":\"B07DBGHY3F\",\"lang\":\"en\",\"slug\":\"ravenna-home-winona-button-tufted-turned-wood-leg-nailhead-accent-chair-28-w-sand-b07dbghy3f\",\"name\":\"Ravenna Home Winona Button Tufted Turned Wood Leg Nailhead Accent Chair, 28&quot;W, Sand\",\"description\":\"Hardwood frame, plywood, web suspension seat support, linen-like polyester fabric Vintage French chic with button tufted back and nailhead trim A style statement piece; casters on front legs make it easy to move Less than 15 minutes assembly required; only attaching the legs Free returns for 30 days. 1-year warranty. 34&quot;L x 28&quot;W x 32.5&quot;H\",\"primaryImage\":{\"alt\":\"Ravenna Home Winona Button Tufted Turned Wood Leg Nailhead Accent Chair, 28&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+rmoCA82L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GsUmtudJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GsUmtudJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19evRJ0hLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19evRJ0hLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s9V0PMl5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s9V0PMl5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TNpTJMsNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TNpTJMsNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DyISllvDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DyISllvDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28