    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QF9Y71V\",\"sku\":\"B07QF9Y71V\",\"lang\":\"en\",\"slug\":\"industrial-coffee-table-53-w-antique-natural-and-black-b07qf9y71v\",\"name\":\"Industrial Coffee Table, 53&quot;W, Antique Natural and Black\",\"description\":\"This industrial coffee table touts an iron base in a black powder-coated finish and a natural-antique, solid-wood top and has a contemporary-meets-country flair that looks great with most decor. The sturdy iron base adds durability to the rustic elegance and helps reduce daily wear and tear. 53.15&quot;W x 29.53&quot;D x 15.75&quot;H Solid wood tops an iron base. This casual coffee table with an iron base and a solid wood top in an antique finish looks great with most decor styles. The solid wood top and iron base add durability. Assemble in 15 minutes or less Wipe with a soft, damp cloth; dry thoroughly. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Coffee Table, 53&quot;W, Antique Natural and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kIETMF8jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71m3-BhxXdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71m3-BhxXdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914A3nLotwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914A3nLotwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UxYXgpabL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UxYXgpabL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qOffm8s-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qOffm8s-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HZEx+1XRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-