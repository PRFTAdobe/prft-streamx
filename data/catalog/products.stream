        "bytes": "{\"id\":\"B075X4VQV1\",\"sku\":\"B075X4VQV1\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-loveseat-58-w-blackwood-b075x4vqv1\",\"name\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Blackwood\",\"description\":\"This item is made to order just for you 58&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Blackwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l2DKwwibL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rGtOZdolS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rGtOZdolS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iRVmTBEFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iRVmTBEFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kQ2IXSsiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kQ2IXSsiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17huvpt+pS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17huvpt+pS.jpg\"}],\"attributes\":[{\"n