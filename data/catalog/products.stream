    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZNM4\",\"sku\":\"B07B4FZNM4\",\"lang\":\"en\",\"slug\":\"isabel-traditional-loveseat-sofa-83-8-w-tan-b07b4fznm4\",\"name\":\"Isabel Traditional Loveseat Sofa, 83.8&quot;W, Tan\",\"description\":\"Between the chaise lounge, sofa and ottoman, this sectional has plenty of room for family, friends and pets. Even better, it features performance fabric and hidden storage, making it a stylish and highly functional addition to your room. Performance fabric on wood frame Streamlined design fits a modern or transitional room Hidden compartments beneath the chaise and ottoman provide handy storage space Easy assembly in 30 minutes or less; screw on legs and attach sectional pieces together Free returns for 30 days. 1-year warranty. 100&quot;W x 39.70 73.60&quot;D x 37.4&quot;H\",\"primaryImage\":{\"alt\":\"Isabel Traditional Loveseat Sofa, 83.8&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ecydDf2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10INldBATL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10INldBATL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qO-P-LmtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qO-P-LmtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eUArn88lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eUArn88lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eULW0X+TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eULW0X+TL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":