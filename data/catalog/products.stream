    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084QWW4LR\",\"sku\":\"B084QWW4LR\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-two-door-media-console-table-48-w-antique-espresso-b084qww4lr\",\"name\":\"Rivet Mid-Century Modern Two-Door Media Console Table, 48&quot;W, Antique Espresso\",\"description\":\"The classic lines and solid pine construction give this espresso media console table a mid-century look that will blend with any decor. Two shelves behind two sliding doors provide plenty of storage to help you prevent clutter. A wide top provides the ideal place for a TV or other electronics. 48&quot;W x 12.2&quot;D x 27.5&quot;H Solid pine construction A pair of sliding doors reveal two shelves, perfect for storing items out of sight. Solid construction helps provide a secure base for electronics. A traditional design and espresso finish create a vintage feel that will add a classic touch to any space. Assemble in 15-30 minutes Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Two-Door Media Console Table, 48&quot;W, Antique Espresso\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mxAOE06EL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VqEJ4py2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VqEJ4py2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rQ13aD0kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rQ13aD0kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OCi-XBSnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OCi-XBSnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lrmcqyfrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lrmcqyfrL.jpg\"},{\"alt\":\"