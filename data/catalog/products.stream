    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M6CN1\",\"sku\":\"B07B4M6CN1\",\"lang\":\"en\",\"slug\":\"rivet-berkshire-mid-century-modern-sofa-couch-82-6-w-grey-b07b4m6cn1\",\"name\":\"Rivet Berkshire Mid-Century Modern Sofa Couch, 82.6&quot;W, Grey\",\"description\":\"Low-angled arms, deep seat cushions and lumbar pillows are hallmarks of this mid-century influenced design. Piping on the arms and slanted metal legs add additional visual interest to this sofa, which is sure to be a conversation piece. 82.6&quot;W x 37&quot;D x 32.2&quot;H; Seat Height: 18.8&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 21.2&quot;H; Arm Height: 22&quot;H; Leg Height: 5.5&quot; Polyester fabric on sturdy wood frame; metal legs with nickel finish Clean lines, low-slung arms and metal legs are hallmarks of mid-century modern style In addition to being a comfortable sofa, this is an eye-catching statement piece. Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Berkshire Mid-Century Modern Sofa Couch, 82.6&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ctFAP2vXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ceZvjEhoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ceZvjEhoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811tIHOg1ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811tIHOg1ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zv8OpTkBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zv8OpTkBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-