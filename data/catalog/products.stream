    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWL4C2Y\",\"sku\":\"B07BWL4C2Y\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-sofa-chaise-sectional-115-w-eclipse-blue-b07bwl4c2y\",\"name\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Eclipse Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester/linen blend fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Eclipse Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TS3k8xF2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B128YX8sOhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B128YX8sOhS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lMYdFTPPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lMYdFTPPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fpZ3UpzuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fpZ3UpzuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fsfPuRfRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fsfPuRfRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YZQkDJHIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim