    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073GC43QZ\",\"sku\":\"B073GC43QZ\",\"lang\":\"en\",\"slug\":\"rivet-martin-modern-storage-bench-39-w-scopic-blue-b073gc43qz\",\"name\":\"Rivet Martin Modern Storage Bench, 39&quot;W, Scopic Blue\",\"description\":\"You're having friends over, but didn't have time to clean first. No problem - this storage ottoman is a great place to quickly stash clutter. In addition to its functionality, it's a stylish piece when closed. NOTE: This item is made-to-order, please expect an increased shipping time. 39” W x 19” D x 19” H Solid pine wood with a linen/cotton blend fabric Contemporary but classic A great ottoman for the living room or storage for blankets in a bedroom Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Martin Modern Storage Bench, 39&quot;W, Scopic Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91upK6BuZaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UQz83uyaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UQz83uyaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsHSc5O8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsHSc5O8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oJHDOotlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oJHDOotlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PDe8y2V7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PDe8y2V7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912ylZA8V6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912ylZA8V6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label