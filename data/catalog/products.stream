        "bytes": "{\"id\":\"B07SR9GVQP\",\"sku\":\"B07SR9GVQP\",\"lang\":\"en\",\"slug\":\"knit-foam-floor-pouf-ottoman-grey-b07sr9gvqp\",\"name\":\"Knit Foam Floor Pouf Ottoman, Grey\",\"description\":\"Knit ottoman pouf to be used as a foot rest or for floor seating Knit design adds a touch of cozy, contemporary style to the room Can be used as extra seating for kids or adults; great for game nights, movie nights, and more Foam interior keeps its shape with consistent use Lightweight, compact design; easy to move and store\",\"primaryImage\":{\"alt\":\"Knit Foam Floor Pouf Ottoman, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n51K4mAXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h+8DJKuML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h+8DJKuML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812g4nCbS8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812g4nCbS8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fRleGz+mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fRleGz+mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717uYnSz4CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717uYnSz4CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31QwedolkNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31QwedolkNL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"10.63\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"16.14\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"16.14\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[