    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78G4Q8\",\"sku\":\"B07B78G4Q8\",\"lang\":\"en\",\"slug\":\"creston-modern-expandable-wood-dining-kitchen-table-round-72-w-oak-b07b78g4q8\",\"name\":\"Creston Modern Expandable Wood Dining Kitchen Table, Round, 72&quot;W, Oak\",\"description\":\"54&quot;L x 54-72&quot;W x 30&quot;H Solid hardwood top and legs; oak veneer with distressed finish A versatile style that can work with modern, transitional or farmhouse decor An extra leaf is provided to expand the table if needed Assembly in 30 minutes or less; attach base to top Free returns for 30 days. 3-year warranty. A distressed rustic finish is paired with an edgy angular base on this dining table. An extra leaf allows it to accommodate a few more dinner guests. The versatile transitional style allows it to blend with traditional or modern farmhouse decor.\",\"primaryImage\":{\"alt\":\"Creston Modern Expandable Wood Dining Kitchen Table, Round, 72&quot;W, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KsS1MGc6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FBzqlWuOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FBzqlWuOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cfDaTVBiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cfDaTVBiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P1S2XEeNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P1S2XEeNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916x8Mdgd1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916x8Mdgd1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OxAD2eCIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OxAD2eCIL.jpg\"}],\"attr