    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D84TW\",\"sku\":\"B07B4D84TW\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-u-sectional-117-w-slate-brown-b07b4d84tw\",\"name\":\"Rivet Edgewest Low Back Modern Left U-Sectional, 117&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left U-Sectional, 117&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W1ASg1GmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818dToa+7-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818dToa+7-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ttmgs7u5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ttmgs7u5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AgD6KimwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AgD6KimwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I0MftYB9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I0MftYB9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images