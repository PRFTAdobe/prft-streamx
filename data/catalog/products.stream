    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XKV24\",\"sku\":\"B0831XKV24\",\"lang\":\"en\",\"slug\":\"devonshire-modern-farmhouse-large-ottoman-41-w-putty-b0831xkv24\",\"name\":\"Devonshire Modern Farmhouse Large Ottoman, 41&quot;W, Putty\",\"description\":\"The generous size of this fully padded ottoman provides plenty of room for putting your feet up and relaxing. The clean, modern lines and putty-colored upholstery bring a distinctive flair to your living room or family room. Durable, easy-care performance fabric makes cleaning a breeze. 41&quot;W x 41&quot;D x 18.5&quot;H; leg height: 2&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Devonshire Modern Farmhouse Large Ottoman, 41&quot;W, Putty\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RmuNSZMRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tMYyDBBIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tMYyDBBIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MB734SZVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MB734SZVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AyF5YZF3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AyF5YZF3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19KfmOCK6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19KfmOCK6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"62.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"12\",\"label\":\"12\"},{\"value\":\"Fringed\",\"label\":\"Fringed\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Edside\",\"label\":\"Edside\"},{\"value\":\"Taylor\",\"label\":\"Taylor\"},{\"value\":\"Jennifer\",\"label\":\"Jennifer\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Foot\",\"label\":\"Foot\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Storage\",\"label\":\"Storage\"},{\"value\":\"Footstool\",\"label\":\"Footstool\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Round\",\"label\":\"Round\"},{\"value\":\"Footstools\",\"label\":\"Footstools\"},{\"value\":\"Decorative\",\"label\":\"Decorative\"},{\"value\":\"10\",\"label\":\"10\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":370,\"discountedValue\":333.0}}"
