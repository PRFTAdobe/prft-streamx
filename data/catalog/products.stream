    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ58T4K\",\"sku\":\"B07HZ58T4K\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-corner-sofa-fabric-90-w-dove-b07hz58t4k\",\"name\":\"Bagley Sectional Component, Right-Facing Corner Sofa, Fabric, 90&quot;W, Dove\",\"description\":\"This dove-colored sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing corner sofa component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you. Overall: 90&quot;W x 40&quot;D x 36&quot;H; Seat Height: 22&quot;H; Seat Depth: 24&quot;D; Seat Back Height: 36&quot;H; Arm Height: 24&quot;H; Leg Height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Corner Sofa, Fabric, 90&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61y70zaxGnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dnJyEJC-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dnJyEJC-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jGhs2WhAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jGhs2WhAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DA86Kr02L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DA86Kr02L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hhsZzC7zL.jpg\",\"url\":\"htt