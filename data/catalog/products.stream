    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MSYPS\",\"sku\":\"B07B4MSYPS\",\"lang\":\"en\",\"slug\":\"andover-modern-right-l-sectional-sofa-124-w-tan-b07b4msyps\",\"name\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Tan\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DtqF96WfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814AwmQXNNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814AwmQXNNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuZmtZ-zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuZmtZ-zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lzRze4blL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lzRze4blL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sC9cc-hhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sC9cc-hhS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-+dT1+zML.jpg\",\"url\":\"https://storage.googleapis.com/puresig