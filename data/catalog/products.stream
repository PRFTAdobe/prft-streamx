    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3PL\",\"sku\":\"B075X4F3PL\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-velvet-bench-loveseat-sofa-74-w-otter-grey-b075x4f3pl\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Loveseat Sofa, 74&quot;W, Otter Grey\",\"description\":\"This sleek, Mid-century inspired velvet sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 74''W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Loveseat Sofa, 74&quot;W, Otter Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813vEMBclqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913XHRe6v+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913XHRe6v+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jk-rADV1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jk-rADV1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817rZY+lPUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817rZY+lPUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16c2ChSBBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16c2ChSBBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ldMb4FaZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ldMb4FaZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UV3K4wgcL.jpg\