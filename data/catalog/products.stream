    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6X84B\",\"sku\":\"B07HZ6X84B\",\"lang\":\"en\",\"slug\":\"clayton-reclining-contemporary-leather-living-room-chair-30-w-gray-b07hz6x84b\",\"name\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Gray\",\"description\":\"With an ideal blend of style and comfort, this recliner will be the perfect addition to your contemporary-style home decor. The tasteful gray leather and wood legs and arms add a classic flair to a modern room, and the rich leather upholstery is easy to clean and maintain. Overall: 30&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; seat back height: 41&quot;H; arm height: 24&quot;H; leg height: 6.5&quot;H Sturdy wood frame with rich top-grain leather upholstery. Comfortably sized recliner fits perfectly in a living-room corner or beside a couch or bed. The tight, fixed back and seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OOs00LyEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u0pdzsmkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u0pdzsmkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912iQClQBAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912iQClQBAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3mrs6tmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3mrs6tmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q-2xHINnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q-2xHINnL.jpg\"},{\