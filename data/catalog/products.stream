  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B9FH8\",\"sku\":\"B07B7B9FH8\",\"lang\":\"en\",\"slug\":\"rivet-federal-mid-century-modern-wood-dining-kitchen-chairs-set-of-2-green-b07b7b9fh8\",\"name\":\"Rivet Federal Mid-Century Modern Wood Dining Kitchen Chairs, Set of 2, Green\",\"description\":\"The rounded seat, simple tall back and tapered wooden legs are hallmarks of mid-century modern style, but understated enough to allow this chair to blend in a transitional décor. Performance fabric and sturdy construction make it durable. 21&quot;W x 24&quot;D x 36&quot;H; Seat Height: 18.5&quot;H ; Seat Depth: 17.5&quot;D; Seat Back Height: 18.5&quot;H Hardwood legs and frame; polyester fabric Mid-century modern influences; can work with contemporary or transitional décor Polyester fabric is durable and easier to clean than other fabrics. Easy assembly in 15-30 minutes; just bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Federal Mid-Century Modern Wood Dining Kitchen Chairs, Set of 2, Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914T7iVDZ-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18a7s7aJQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18a7s7aJQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mJRxte3BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mJRxte3BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tMRCrgiwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tMRCrgiwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1F5c3zTcXS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1F5c3zTcXS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zkJ3pKpOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zkJ3pKpOL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"26.45\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"},{\"value\":\"Green\",\"label\":\"Green\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":542,\"discountedValue\":487.8}}"
