    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZS99DS\",\"sku\":\"B07TZS99DS\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-high-back-swivel-seat-counter-stool-39-h-beige-b07tzs99ds\",\"name\":\"Alaina Contemporary High-Back Swivel Seat Counter Stool, 39&quot;H, Beige\",\"description\":\"This counter-height bar stool allows you to fit your guests around the kitchen island for special celebrations, while a swivel function makes it extra easy for everyone to chat. Their transitional style allows them to blend with any style room. 18.5&quot;W x 22&quot;D x 39&quot;H; Seat Depth: 16.5&quot;D; Seat Back Height: 12.5&quot;H; Seat Height: 26&quot;H Moisture-repellent, stain-resistant fabric on a solid hardwood frame with swivel seat and low arms Modern design with classic solid fabric provides a transitional look No assembly required. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary High-Back Swivel Seat Counter Stool, 39&quot;H, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aa56ZxG0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g3pvSZVnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g3pvSZVnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TZVgPKazL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TZVgPKazL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BhpzkzCIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BhpzkzCIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YmebVLh4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YmebVLh4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UoytIvJ-L.jpg\",\"url\":\"https://storage.googleapis.com/pures