    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4CXTRY\",\"sku\":\"B07B4CXTRY\",\"lang\":\"en\",\"slug\":\"appleton-farmhouse-tufted-leather-recliner-35-w-driftwood-b07b4cxtry\",\"name\":\"Appleton Farmhouse Tufted Leather Recliner, 35&quot;W, Driftwood\",\"description\":\"This is not your dad's old overstuffed recliner. You'll enjoy comfort and coziness along with quality leather and graceful style. With its rolled arms and tufted back, this chair has the modern and classic features to fit a transitional decor. 35&quot;W x 40&quot;D x 41&quot;H; Seat Height: 20&quot;H ; Seat Depth: 21&quot;D; Seat Back Height: 41&quot;H; Arm Height: 24&quot;H; Front legs: 5.625&quot;H; Back legs: 4.75&quot;H Leather upholstery on sturdy pine wood frame Modern and classic come together for a transitional style Push back reclining mechanism; seat cushion can be removed for cleaning No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Appleton Farmhouse Tufted Leather Recliner, 35&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91glr9E+OoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sfCaqT7HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sfCaqT7HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y+bPTSpNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y+bPTSpNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uvxUVl9VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uvxUVl9VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jWio+eSVL.jpg\",\"url\":\"https://storage.googleapi