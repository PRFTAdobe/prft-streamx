    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KPWM7\",\"sku\":\"B0853KPWM7\",\"lang\":\"en\",\"slug\":\"rivet-lundberg-contemporary-upholstered-barstool-with-brass-legs-44-5-h-flannel-b0853kpwm7\",\"name\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Flannel\",\"description\":\"Comfort and style meet in this contemporary barstool. Feather-filled cushions and open sides provide maximum comfort, while the flannel-colored upholstery and brass legs display a spare, contemporary style. These barstools coordinate well with any modern interior decor. Solid wood frame; feather-filled upholstered cushions; brass base Classic brass legs and footrest, plus the open sides, allow for maximum freedom of movement. Feather-filled cushion provides comfort and a contemporary look at the same time. Classic brass metal base has a footrest for added stability. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty 18.1&quot;W x 22.4&quot;D x 44.5&quot;H; seat height: 29.9&quot;H; seat depth: 12.6&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Flannel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U9Wr9IZRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j2-Z1nJaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j2-Z1nJaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sOY0g3jDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sOY0g3jDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W86g8fqTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W86g8fqTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jKXo8k