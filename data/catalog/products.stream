    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FMG\",\"sku\":\"B075X43FMG\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-latte-b075x43fmg\",\"name\":\"Leila Ottoman, 34&quot; W, Latte\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing gives cushion resilience. This striking, vintage look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and velvet upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot; W, Latte\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CTWnhHMHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ymOFtnu8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ymOFtnu8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gwLp88qKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gwLp88qKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NrF8aL7qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NrF8aL7qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WW4nFaQCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WW4nFaQCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cV-BmwcFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cV-BmwcFL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":