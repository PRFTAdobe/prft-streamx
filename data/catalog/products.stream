    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMSQ7S\",\"sku\":\"B07BWMSQ7S\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-sofa-chaise-sectional-115-w-rouge-red-b07bwmsq7s\",\"name\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Rouge Red\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DWuyfLL0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NtBiKIbnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NtBiKIbnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vFCEVRweL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vFCEVRweL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OlQhx6xUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OlQhx6xUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18dyweKI+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18dyweKI+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-TAAd+0VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-T