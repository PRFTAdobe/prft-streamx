    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073GCWSTR\",\"sku\":\"B073GCWSTR\",\"lang\":\"en\",\"slug\":\"benton-modern-square-ottoman-35-w-buffalo-square-holiday-red-b073gcwstr\",\"name\":\"Benton Modern Square Ottoman, 35&quot;W, Buffalo Square Holiday Red\",\"description\":\"A perfect combination of style and practicality, this modern square ottoman is a great addition to any seating area. Its generous size and sturdy build allow it to work as a comfy footrest or a place to rest a tray of snacks. 35&quot;W x 35&quot;D x 17&quot;H Solid pine frame and legs with linen/cotton blend fabric Modern Practical design for use as extra seating or a footrest Minimal assembly required 3-year warranty. All returns free, including shipping, for first 30 days.\",\"primaryImage\":{\"alt\":\"Benton Modern Square Ottoman, 35&quot;W, Buffalo Square Holiday Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61kVdTXTJ4L.jpg\"},\"gallery\":[],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"31.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Jennifer\",\"label\":\"Jennifer\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Cocktail\",\"label\":\"Cocktail\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Coffee\",\"label\":\"Coffee\"},{\"value\":\"Orange\",\"label\":\"Orange\"},{\"value\":\"Benches\",\"label\":\"Benches\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Entryway\",\"label\":\"Entryway\"},{\"value\":\"French\",\"label\":\"French\"},{\"value\":\"Pouf\",\"label\":\"