    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PTRL\",\"sku\":\"B075X4PTRL\",\"lang\":\"en\",\"slug\":\"rivet-eva-mid-century-modern-tufted-velvet-down-filled-sectional-sofa-couch-87-w-hunter-green-b075x4ptrl\",\"name\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Sectional Sofa Couch, 87&quot;W, Hunter Green\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted sofa featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible and is held in place by clips at the corners. 87&quot;W x 35.25''D x 30.25''H Durable polyester velvet on hardwood frame and brushed brass legs Modern elegant style with reversible cushion to extend the life of the piece Simple assembly in 15 minutes or less.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Sectional Sofa Couch, 87&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818WpI3XVOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kAzpj0GlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kAzpj0GlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tIgCv529L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tIgCv529L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"182.38\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Hunter green\",\"label\":\"Hunter green\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Green\",\"label\":\"Green\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":638,\"discountedValue\":574.2}}"
