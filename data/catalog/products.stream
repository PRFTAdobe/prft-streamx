    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBNF1\",\"sku\":\"B07QCMBNF1\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-loveseat-with-tapered-wood-legs-55-w-aqua-b07qcmbnf1\",\"name\":\"Rivet Isabelle Mid-Century Modern Loveseat with Tapered Wood Legs, 55&quot;W, Aqua\",\"description\":\"This love seat’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its subtle upholstery ensures that it will match the color scheme of most any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 55&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Loveseat with Tapered Wood Legs, 55&quot;W, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Si0-emhRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819jf5SL6NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819jf5SL6NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qnNdN7xLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qnNdN7xLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bmQNyvyjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bmQNyvyjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nKkbWQ0XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nKkbWQ0XL.jpg\"},{\"alt\":\