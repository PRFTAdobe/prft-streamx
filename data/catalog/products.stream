        "bytes": "{\"id\":\"B07DBHCKF9\",\"sku\":\"B07DBHCKF9\",\"lang\":\"en\",\"slug\":\"ravenna-home-keith-rounded-faux-leather-nailhead-club-accent-chair-29-5-w-black-b07dbhckf9\",\"name\":\"Ravenna Home Keith Rounded Faux Leather Nailhead Club Accent Chair, 29.5&quot;W, Black\",\"description\":\"Wood frame and legs; ink black faux leather; foam padding; nailhead trim Classic rounded back club chair with sophisticated nailhead detailing Versatile faux leather and classic club design can blend with most any style room Easy assembly required, attach legs and insert seat cushion Free returns for 30 days. 1-year warranty. 36.87&quot;L x 29.53&quot;W x 30.71&quot;H\",\"primaryImage\":{\"alt\":\"Ravenna Home Keith Rounded Faux Leather Nailhead Club Accent Chair, 29.5&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OtLb8+y2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b3AtJ77NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b3AtJ77NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nab9lr8wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nab9lr8wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lFDVt7a1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lFDVt7a1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a5+5BK9iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a5+5BK9iL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.71\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.53\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.87\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"va