    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WNWG\",\"sku\":\"B075X2WNWG\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-tufted-customizable-daybed-sofa-78-w-rain-amp-silver-b075x2wnwg\",\"name\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Rain &amp; Silver\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and silver metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. This stylish piece can serve as a daybed and loveseat. Upholstered in a subtle off-white and teal pattern, it features a long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish, making it perfect for any room. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Rain &amp; Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t3Rb+caDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91a7nTbWAyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91a7nTbWAyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f-wOhJ1mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f-wOhJ1mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CyCTDrmtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CyCTDrmtS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19zmbOiRCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19zmbOiRCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xsUiVvhhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B