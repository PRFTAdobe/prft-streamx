    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQ4K3\",\"sku\":\"B07QBMQ4K3\",\"lang\":\"en\",\"slug\":\"abigail-loveseat-sofa-64-w-golden-brown-b07qbmq4k3\",\"name\":\"Abigail Loveseat Sofa, 64&quot;W, Golden Brown\",\"description\":\"Comfort meets class in this attractive transitional-style love seat. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this love seat. 64&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with life-friendly 83% olefin and 17% polyester performance fabric The removable and reversible seat and back cushions ensure durability and comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Loveseat Sofa, 64&quot;W, Golden Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VNIihycdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uqLOU9iLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uqLOU9iLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11gQPwCR+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11gQPwCR+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xcfmpLK7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xcfmpLK7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/ori