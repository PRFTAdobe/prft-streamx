    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5TN2K\",\"sku\":\"B075X5TN2K\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-tan-b075x5tn2k\",\"name\":\"Marin Studded Chair, 33&quot;W, Tan\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RNvhlBrlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910TSmK9VML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910TSmK9VML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1aQrTQTwJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1aQrTQTwJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MPLUeOoBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MPLUeOoBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BSn2kV-rS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BSn2kV-rS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"val