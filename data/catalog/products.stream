    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMTPJY\",\"sku\":\"B082VMTPJY\",\"lang\":\"en\",\"slug\":\"rivet-frederick-mid-century-modern-tufted-velvet-living-room-chair-38-w-grey-b082vmtpjy\",\"name\":\"Rivet Frederick Mid-Century Modern Tufted Velvet Living Room Chair, 38&quot;W, Grey\",\"description\":\"The squared shape and channeled upholstery are unmistakably mid-century, while velvet fabric and shiny metal legs bring glamour to this chair. This piece is a stunning style statement and a conversation starter for your modern-style room. 38.1&quot;W x 34.6&quot;D x 31.4&quot;H; Seat Height: 17.7&quot;H ; Seat Depth: 23.2&quot;D; Seat Back Height: 22.2&quot;H; Arm Height: 31.4&quot;H; Leg Height: 9.3&quot;H Velvet fabric on sturdy wood frame; aluminum legs with brass finish Mid-century modern meets glam in this statement piece Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Frederick Mid-Century Modern Tufted Velvet Living Room Chair, 38&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XkuHhIbAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KkPf1UAZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KkPf1UAZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71r5K0WuyhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71r5K0WuyhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UCGWjW5pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UCGWjW5pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51qFvXG3i2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51qFvXG3i2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yc18fyY2L.jpg\",\"url\":\"h