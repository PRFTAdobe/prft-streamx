    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075ZF4SF1\",\"sku\":\"B075ZF4SF1\",\"lang\":\"en\",\"slug\":\"reclaimed-wood-farmhouse-console-table-70-9-w-natural-finish-b075zf4sf1\",\"name\":\"Reclaimed Wood Farmhouse Console Table, 70.9&quot;W, Natural Finish\",\"description\":\"This classic farmhouse console table makes a great style focal point for an entry way, hallway or living room. Made of reclaimed hardwood, its base is strengthened by a &quot;V&quot; support that adds stability as well as visual interest. 70.9&quot;W x 18.1&quot;D x 33.5&quot;H Reclaimed hardwood The simple farmhouse style will complement any entry way, hallway, or living room Perfect to display decor or use as entry way storage No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Reclaimed Wood Farmhouse Console Table, 70.9&quot;W, Natural Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TLmJcorWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12Is11c1ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12Is11c1ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nVIYsnaDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nVIYsnaDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QA1Cbe2iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QA1Cbe2iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y+3n3x42L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y+3n3x42L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.1\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\