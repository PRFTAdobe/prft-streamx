    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP32RX\",\"sku\":\"B075YP32RX\",\"lang\":\"en\",\"slug\":\"rivet-ricky-mid-century-modern-set-of-2-kitchen-dining-room-table-chairs-37-inch-height-marine-blue-b075yp32rx\",\"name\":\"Rivet Ricky Mid-Century Modern Set of 2 Kitchen Dining Room Table Chairs, 37 Inch Height, Marine Blue\",\"description\":\"Simple, sleek high-backed mid-century modern dining chairs. They're also easy to move anywhere you need extra seating. 24&quot;W x 19&quot;D x 37&quot;H Fabric is 60% polyester/20%linen/20%rayon on wood frame, solid hardwood base Foam padding and elastic suspension system keep backs and seats firm and springy Free returns for 30 days. 1-year warranty. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Ricky Mid-Century Modern Set of 2 Kitchen Dining Room Table Chairs, 37 Inch Height, Marine Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w5QuFwgrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MIQtkV87L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MIQtkV87L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ynmUAzmzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ynmUAzmzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nwJvH2RlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nwJvH2RlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-iTasGBnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-iTasGBnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",