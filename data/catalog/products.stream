    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HYY8Z7P\",\"sku\":\"B07HYY8Z7P\",\"lang\":\"en\",\"slug\":\"rivet-goodwin-modern-living-room-accent-chair-32-3-w-x-35-8-h-charcoal-grey-b07hyy8z7p\",\"name\":\"Rivet Goodwin Modern Living Room Accent Chair, 32.3&quot;W x 35.8&quot;H, Charcoal Grey\",\"description\":\"This striking living-room chair will be the perfect finishing touch for your modern-style home decor. With its beautiful charcoal-colored upholstery, this chair will nicely complement your existing interior design, and its sleek, classy design adds elegance to any room. Overall: 32.3&quot;W x 36.2&quot;D x 35.8&quot;H; Seat Height: 18.5&quot;H; Seat Depth 22&quot;D; Seat Back Height: 20.1&quot;H; Arm Height: 26.4&quot;H; Leg Height: 6.3&quot;H Solid-wood frame and legs with 100% polyester upholstery Strong slim legs elevate this piece and add modern flair. The soft, removable back and reversible cushions ensure durability and comfort. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Goodwin Modern Living Room Accent Chair, 32.3&quot;W x 35.8&quot;H, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sBic2Q+wL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jRMBa+xoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jRMBa+xoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iiaGaz9DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iiaGaz9DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X3du12X0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X3du12X0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WKGELINdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/orig