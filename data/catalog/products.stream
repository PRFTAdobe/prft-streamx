    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4NW6PY\",\"sku\":\"B07B4NW6PY\",\"lang\":\"en\",\"slug\":\"brandeberry-leather-sofa-82-w-saddle-b07b4nw6py\",\"name\":\"Brandeberry Leather Sofa, 82&quot;W, Saddle\",\"description\":\"Complete your interior design with this elegant sofa. With its rich saddle-colored leather, this sofa is an ideal match for traditional, farmhouse, or vintage home decor. The sturdy wood frame and reversible cushions add durability and extend the life of this beautiful piece. Overall: 82&quot;W x 43&quot;D x 39&quot;H; seat height: 21&quot;H; seat depth: 22&quot;D; seat back height: 37&quot;H; arm height: 27&quot;H; leg height: 5.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Rich leather enhances tasteful traditional style Sturdy frame; reversible cushions for durability; front-leg casters make it easy to move Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Brandeberry Leather Sofa, 82&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61LXb48rVlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716UMpntE5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716UMpntE5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61aRZtiezYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61aRZtiezYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tWwk0A3gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tWwk0A3gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yN7G4gB-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yN7G4gB-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7196MxQtu8L.jpg\",\"url\":\"h