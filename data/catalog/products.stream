    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L9G5Z\",\"sku\":\"B0853L9G5Z\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-barstool-42-1-h-silver-b0853l9g5z\",\"name\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Silver\",\"description\":\"Powerful in its simplicity, this barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 42.1&quot;H; seat height: 29.9&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H Solid wood frame with 100% polyester fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lX+MdLZSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61uKDEJggfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61uKDEJggfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OKR+EwcIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OKR+EwcIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p7BkA0geL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p7BkA0geL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SUhIrOdyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SUhIrOdyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XHIORD1NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-p