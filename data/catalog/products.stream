    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853NQPV8\",\"sku\":\"B0853NQPV8\",\"lang\":\"en\",\"slug\":\"rivet-olander-mid-century-modern-ottoman-with-self-centering-swivel-base-20-5-w-lemongrass-b0853nqpv8\",\"name\":\"Rivet Olander Mid-Century Modern Ottoman with Self-Centering Swivel Base, 20.5&quot;W, Lemongrass\",\"description\":\"This ergonomically sloped ottoman will help you create a seating area that is relaxing and stylish. The curved sides provide a comfortable place for you to rest your feet and legs and also add a contemporary feel to the piece. A self-centering swivel base of brushed metal allows you to easily rotate while seated. 20.5&quot;W x 15.4&quot;D x 15.4&quot;H; seat height: 15.4&quot;H; seat depth: 15.4&quot;D Brushed-brass base with polyester and acrylic upholstery Ottoman features a self-centering swivel for convenience. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Olander Mid-Century Modern Ottoman with Self-Centering Swivel Base, 20.5&quot;W, Lemongrass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TZ88xM44L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T6YVTE8sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T6YVTE8sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mX3K4-UjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mX3K4-UjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JS0OmuNZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JS0OmuNZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kX0QTz1EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kX0QTz1EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight