    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQJWF\",\"sku\":\"B07QBMQJWF\",\"lang\":\"en\",\"slug\":\"abigail-leather-sofa-couch-86-w-saddle-brown-b07qbmqjwf\",\"name\":\"Abigail Leather Sofa Couch, 86&quot;W, Saddle Brown\",\"description\":\"Comfort meets class in this attractive transitional-style sofa. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this sofa. 86&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The removable seat and back cushions ensure durability and comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Leather Sofa Couch, 86&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fvZV3876L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ht5V8-XJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ht5V8-XJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TizxU2v8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TizxU2v8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+8RTEqjZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+8RTEqjZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nVQRYmJKL.jpg\",\"url\":\"https:/