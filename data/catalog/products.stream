    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853Q7C48\",\"sku\":\"B0853Q7C48\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-pine-bar-cabinet-31-5-w-brown-b0853q7c48\",\"name\":\"Rivet Mid-Century Modern Pine Bar Cabinet, 31.5&quot;W, Brown\",\"description\":\"This mid-century-style 2-door bar cabinet offers an understated but classic way to store your kitchen and bar supplies. It can easily fit in your kitchen or dining room, reducing clutter while adding a simple elegance. 31.5&quot;W x 15.8&quot;D x 39.4&quot;H Pine and MDF with pine veneer This cabinet offers storage for your kitchen, bar, or dining room, with interior shelving for ample storage space. This bar cabinet sports a classic mid-century design that allows it to fit in any kitchen or dining room. Assemble in 15-30 minutes Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Pine Bar Cabinet, 31.5&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nFsn95pqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lJUEBgxmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lJUEBgxmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vhRSztlBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vhRSztlBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UR6yuj4jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UR6yuj4jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71joJNcsUWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71joJNcsUWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fW71TxOEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original