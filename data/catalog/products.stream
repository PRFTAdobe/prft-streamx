    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78M4GB\",\"sku\":\"B07B78M4GB\",\"lang\":\"en\",\"slug\":\"elden-leather-nailhead-trim-kitchen-counter-height-backless-stool-26-h-black-b07b78m4gb\",\"name\":\"Elden Leather Nailhead-Trim Kitchen Counter-Height Backless Stool, 26&quot;H, Black\",\"description\":\"With a top-grain leather seat and brass-finished nailhead trim, this handsome counter stool exudes sophistication. The seat is curved for extra comfort, while high quality construction and materials ensure it will last through many good times. 14.2&quot;W x 19.7&quot;D x 26&quot;H Top-grain leather seat on hardwood base Leather, wood and nailhead trim combine for a sophistication that blends with any décor No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Leather Nailhead-Trim Kitchen Counter-Height Backless Stool, 26&quot;H, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61aQl3lqWFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qPRBdg88L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qPRBdg88L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cJwRuwMaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cJwRuwMaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PPO0KSZvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PPO0KSZvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"14.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"12.1\",\"label\":\"pounds\"}]},{\"name\":\"keyw