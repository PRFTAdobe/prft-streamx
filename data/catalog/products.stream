    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B94L2\",\"sku\":\"B07B7B94L2\",\"lang\":\"en\",\"slug\":\"hughes-modern-casual-wood-buffet-bar-cabinet-credenza-brown-b07b7b94l2\",\"name\":\"Hughes Modern Casual Wood Buffet Bar, Cabinet Credenza, Brown\",\"description\":\"With its warm wood tones and crossed-leg metal base, this head-turning buffet has touches of rustic, mid-century modern and industrial. It's as functional as it is eye-catching, with an adjustable shelf behind each door and three drawers for storage. 18&quot;L x 54&quot;W x 32&quot;H Hardwood frame, doors and drawers; steel base A casual transitional piece with elements of many styles Use as a dining room buffet or a storage cabinet in a hallway or living space Assembly in less than 15 minutes; bolt on base Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Hughes Modern Casual Wood Buffet Bar, Cabinet Credenza, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DyCdkMQhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jz5qgEySL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jz5qgEySL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LTN4QhxdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LTN4QhxdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qbLb+KC+S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qbLb+KC+S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IzVjLnC9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IzVjLnC9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-gkAMNSVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-gkAMNSVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MZ7hNGBkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MZ7hNGBkL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"54.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"242.51\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Credenza\",\"label\":\"Credenza\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Buffet\",\"label\":\"Buffet\"},{\"value\":\"Sideboard\",\"label\":\"Sideboard\"},{\"value\":\"Wine cabinet\",\"label\":\"Wine cabinet\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Buffet cabinet\",\"label\":\"Buffet cabinet\"},{\"value\":\"Sideboards and buffet tables with storage\",\"label\":\"Sideboards and buffet tables with storage\"},{\"value\":\"Bar\",\"label\":\"Bar\"},{\"value\":\"Sideboards\",\"label\":\"Sideboards\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Liquor cabinet\",\"label\":\"Liquor cabinet\"},{\"value\":\"Sideboard buffet\",\"label\":\"Sideboard buffet\"},{\"value\":\"Buffet table\",\"label\":\"Buffet table\"}]}],\"categories\":[{\"id\":\"Tables\",\"slug\":\"tables\",\"name\":\"Tables\",\"value\":\"Tables\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":609,\"discountedValue\":548.1}}"
