  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TYTP8SG\",\"sku\":\"B07TYTP8SG\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-upholstered-counter-height-stool-with-gold-accents-37-h-felt-grey-b07tytp8sg\",\"name\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Felt Grey\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous felt grey, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 37&quot;H; Seat Height: 26&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KBb9AndIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OPWV0xRjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OPWV0xRjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fFgp3wkoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fFgp3wkoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-wyhSkN0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-wyhSkN0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A102KAjKcrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A102KAjKcrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KsGXuDjnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight