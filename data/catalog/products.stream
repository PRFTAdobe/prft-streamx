        "bytes": "{\"id\":\"B07HSF6Z8G\",\"sku\":\"B07HSF6Z8G\",\"lang\":\"en\",\"slug\":\"kinsley-kitchen-counter-height-stool-38-h-washed-denim-b07hsf6z8g\",\"name\":\"Kinsley Kitchen Counter Height Stool, 38&quot;H, Washed Denim\",\"description\":\"This wingback counter height stool takes its inspiration from classic French design and pairs it with a modern wood frame for the best of both the old and new worlds. Solid wood frame, fabric, nailheads Square stretcher bars for supreme stability and support Product Dimensions: 22&quot;D x 19.5&quot;W x 38&quot;H Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kinsley Kitchen Counter Height Stool, 38&quot;H, Washed Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nJ4lmduUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N5eFOs5sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N5eFOs5sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L4Ais5HiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L4Ais5HiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AwUbR3RDS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AwUbR3RDS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vHxUJ+GhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vHxUJ+GhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919DZacBz8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919DZacBz8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"value