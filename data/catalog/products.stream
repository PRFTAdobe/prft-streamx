    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZSC9WP\",\"sku\":\"B07TZSC9WP\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-kitchen-bar-stool-41-h-aqua-b07tzsc9wp\",\"name\":\"Rivet Decatur Modern Kitchen Bar Stool, 41&quot;H, Aqua\",\"description\":\"This beautiful modern barstool features a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar supports a plush, backed, armless seat covered in beautiful aqua fabric. Overall: 22&quot;D x 18&quot;W x 41&quot;H. Seat height: 30&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Kitchen Bar Stool, 41&quot;H, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tAj-ez+4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r4U+9N1lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r4U+9N1lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q5xLp4y0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q5xLp4y0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715n9X+peFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715n9X+peFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jkSb90SSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jkSb90SSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pthxnCPwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pthxnCPwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LBYRvVgXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origi