      "content": {
        "bytes": "{\"id\":\"B075X4VQXQ\",\"sku\":\"B075X4VQXQ\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-charcoal-b075x4vqxq\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w5v-qm1xL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LxE-0I4LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LxE-0I4LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j07oSN+rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j07oSN+rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i9B4LQm9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i9B4LQm9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DJpSeYO2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DJpSeYO2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width