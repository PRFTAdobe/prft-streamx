    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831Y2YSC\",\"sku\":\"B0831Y2YSC\",\"lang\":\"en\",\"slug\":\"lyon-upholstered-sofa-couch-94-w-linen-b0831y2ysc\",\"name\":\"Lyon Upholstered Sofa Couch, 94&quot;W, Linen\",\"description\":\"This linen upholstered sofa couch brings a crisp, modern style to your living room with a distinctive flair. Fully padded seat and back cushions provide long-lasting comfort while out-slanting arms allow plenty of freedom of movement. Easy-care, durable performance fabric makes cleaning a snap. 94&quot;W x 38&quot;D x 37&quot;H; seat height: 21.5&quot;H; seat depth: 23.5&quot;D; seat back height: 30.5&quot;H; arm height: 30.5&quot;H; leg height: 6&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Lyon Upholstered Sofa Couch, 94&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+lGBh-LBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c7J+ybatL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c7J+ybatL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gDbCb9EdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gDbCb9EdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xo1UDgkiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xo1UDgkiL.jpg\"},{\"alt\":\"https: