        "bytes": "{\"id\":\"B075YMXWZC\",\"sku\":\"B075YMXWZC\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-oak-dining-table-63-l-walnut-finish-b075ymxwzc\",\"name\":\"Rivet Mid-Century Modern Oak Dining Table, 63&quot;L, Walnut Finish\",\"description\":\"This table is beautiful in its design and simplicity. Solid oak legs have the slanted tapering reminiscent of mid-century style. You'll enjoy serving dinner to your friends, but it's also useful for crafting or working on your laptop. 63&quot;L x 35.5''D x 29.5''H A clean, simple design that works well for any style home Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Solid oak legs; hardwood top with oak finish\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Oak Dining Table, 63&quot;L, Walnut Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819xFi9RJWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WFgiAtKeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WFgiAtKeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810XwIaFYaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810XwIaFYaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p0+lrja9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p0+lrja9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HvRHFKBdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HvRHFKBdL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.53\",\"label\":\"inches\"}]},{\"name\":\"width\",