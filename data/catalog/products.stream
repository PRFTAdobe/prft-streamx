    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YXWRB\",\"sku\":\"B07B4YXWRB\",\"lang\":\"en\",\"slug\":\"bridgewater-curved-queen-headboard-66-w-spinnsol-iron-b07b4yxwrb\",\"name\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Spinnsol Iron\",\"description\":\"This headboard adds classic style to any space. Hand-applied pewter nailhead trim accents the headboards curved silhouette. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 66&quot;W x 4&quot;D x 56&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Spinnsol Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TQINhyBwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vkf4sz8xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vkf4sz8xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vFfm4wqsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vFfm4wqsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JSIFPU6YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JSIFPU6YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BFvBY28hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BFvBY28hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tcgucNfIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tcgucNfI