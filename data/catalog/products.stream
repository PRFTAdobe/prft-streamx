    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z6YRVN\",\"sku\":\"B075Z6YRVN\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-microfiber-kitchen-bar-stools-40-9-h-2-pack-grey-b075z6yrvn\",\"name\":\"Rivet Mid-Century Modern Microfiber Kitchen Bar Stools, 40.9&quot;H, 2-Pack, Grey\",\"description\":\"18.9”W X 22.8”D x 40.9”H Microfiber fabric over hardwood frame; metal base has black finish Along with seating, these stools bring retro fun to your bar area Assemble in 15 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Simple sloped seats are paired with tall black metal bases for a classic Mid-century style. The microfiber has a distressed finish to give these bar stools a hint of vintage style -- but with the modern conveniences of easy cleaning and durability.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Microfiber Kitchen Bar Stools, 40.9&quot;H, 2-Pack, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rXfQxTzwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NE4HolSfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NE4HolSfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LSv5GoFCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LSv5GoFCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JmRMx0jLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JmRMx0jLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-oerXiVkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-oerXiVkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pdHY9kceL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pdHY9kceL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima