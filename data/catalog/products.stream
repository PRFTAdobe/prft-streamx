        "bytes": "{\"id\":\"B073GC43KS\",\"sku\":\"B073GC43KS\",\"lang\":\"en\",\"slug\":\"modern-sweeping-arm-settee-51-w-damask-taupe-b073gc43ks\",\"name\":\"Modern Sweeping Arm Settee, 51&quot;W, Damask Taupe\",\"description\":\"This graceful settee will make a pleasing addition to any style of room. A soft sweep of the arms and clean lines make it modern, but linen-look fabric and turned wood-look legs with espresso-colored stain give it a classic look as well. 51”W x 29”D x 35”H Solid pine with linen/cotton fabric Modern with classic touches Will blend with classic and transitional style rooms 4 easy-to-attach legs Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Sweeping Arm Settee, 51&quot;W, Damask Taupe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v0XlPTvGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OqmP2t8EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OqmP2t8EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RJKDzNZ5S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RJKDzNZ5S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13cMSs9jEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13cMSs9jEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KtiyrWXuS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KtiyrWXuS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CnuAZzrlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CnuAZzrlL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"51.0\",\"label\