    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBMW7\",\"sku\":\"B07QCMBMW7\",\"lang\":\"en\",\"slug\":\"anne-marie-contemporary-oversized-accent-chair-48-w-cream-b07qcmbmw7\",\"name\":\"Anne Marie Contemporary Oversized Accent Chair, 48&quot;W, Cream\",\"description\":\"This oversized armchair's modern take on a classic design perfectly enhances your transitional-style home decor without sacrificing comfort. The cushions are reversible to enhance durability and prolong this chair’s life. Overall: 48&quot;W x 41&quot;D x 40&quot;H. Seat height: 21&quot;H; seat depth: 22&quot;D; seat back height: 20&quot;H Sturdy wood frame and legs with durable 92% polyester and 8% nylon upholstery Loose seat and back cushions are reversible to help keep this piece looking great over time Classic meets contemporary for an ideal contemporary farmhouse feel. Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Anne Marie Contemporary Oversized Accent Chair, 48&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bdU7AN32L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xGjRzXZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xGjRzXZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H+mWdoCCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H+mWdoCCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UvkzMVRbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UvkzMVRbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I6lx3b35L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I6lx3b35L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YSXo8