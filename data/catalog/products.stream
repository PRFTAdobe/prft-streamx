    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHYF1L3\",\"sku\":\"B07QHYF1L3\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-loveseat-with-tapered-wood-legs-55-w-felt-grey-b07qhyf1l3\",\"name\":\"Rivet Isabelle Mid-Century Modern Loveseat with Tapered Wood Legs, 55&quot;W, Felt Grey\",\"description\":\"This love seat’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its felt-gray upholstery ensures that it will match the color scheme of any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 55&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Loveseat with Tapered Wood Legs, 55&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uh6ZGZ3tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819qF68I3pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819qF68I3pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iuy7VhKGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iuy7VhKGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e1cMbLnWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e1cMbLnWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SrvCXnpnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SrvCXnpnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.04\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.43\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"55.12\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"66.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Prime\",\"label\":\"Prime\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Chaise\",\"label\":\"Chaise\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Wide\",\"label\":\"Wide\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Rooms\",\"label\":\"Rooms\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Reclining\",\"label\":\"Reclining\