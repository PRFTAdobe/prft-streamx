    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4Z9Q56\",\"sku\":\"B07B4Z9Q56\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-king-headboard-88-w-lagoon-b07b4z9q56\",\"name\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Lagoon\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 88&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Lagoon\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915CT8kuE+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CPeYOzoVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CPeYOzoVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mC-Rg1RZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mC-Rg1RZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D-kTTVkeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D-kTTVkeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QzpISUW1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QzpISUW1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gHWSA6EBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gHWSA6EBL.jpg\"},{\"alt\":\"https