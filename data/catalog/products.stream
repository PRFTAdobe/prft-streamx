    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082BL8QJM\",\"sku\":\"B082BL8QJM\",\"lang\":\"en\",\"slug\":\"rivet-bertha-mid-century-velvet-upholstered-swivel-office-chair-25-25-w-sapphire-blue-with-chrome-finish-b082bl8qjm\",\"name\":\"Rivet Bertha Mid-Century Velvet-Upholstered Swivel Office Chair, 25.25&quot;W, Sapphire Blue with Chrome Finish\",\"description\":\"This sapphire-blue velvet chair has an unusual, squared-off silhouette that will add a stylish mid-century flair to any workplace or home office. Its adjustable height, casters, and smooth swivel mechanism make it as flexible as it is attractive. 25.25&quot;W x 25&quot;D x 32.75&quot;–35.75&quot;H; seat height: 19.75&quot;–22.75&quot; Generously padded cushions are upholstered in a soft azure velvet that adds a touch of luxury to a workday necessity. This chair has a 360-degree swivel mechanism with height and tension adjustments to accommodate your work style. Mid-century modern design meets all-day comfort in this stylish office chair. Assemble in 15-30 minutes Always use on firm, level ground. Do not stand on the seat or let children play with this chair. Check (and if necessary, tighten) all screws every 90 days. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Bertha Mid-Century Velvet-Upholstered Swivel Office Chair, 25.25&quot;W, Sapphire Blue with Chrome Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CnWn7TIIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710XbanuxaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710XbanuxaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rV6eINz7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rV6eINz7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zIMZhBohL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images