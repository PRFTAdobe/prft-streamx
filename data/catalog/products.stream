    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8PZ2K\",\"sku\":\"B07BW8PZ2K\",\"lang\":\"en\",\"slug\":\"andover-modern-left-l-sectional-sofa-124-w-sand-b07bw8pz2k\",\"name\":\"Andover Modern Left L-Sectional Sofa, 124&quot;W, Sand\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wood legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left L-Sectional Sofa, 124&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QgKM8OZfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9100JNEJZgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9100JNEJZgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YtNSowWRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YtNSowWRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GIo0XmqTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GIo0XmqTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9189jMrmOFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9189jMrmOFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SRgwGOXvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SRgwGOXvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight