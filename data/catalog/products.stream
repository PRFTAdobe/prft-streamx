    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSM6C1J\",\"sku\":\"B07HSM6C1J\",\"lang\":\"en\",\"slug\":\"rivet-two-toned-modern-nightstand-15-75-w-natural-amp-white-b07hsm6c1j\",\"name\":\"Rivet Two-Toned Modern Nightstand 15.75&quot;W, Natural &amp; White\",\"description\":\"Brighten your bedside with this cheerful two-toned nightstand. White trim and splayed legs contrast nicely with the oak-veneer body, giving this nightstand a lively, homey look. The 2 drawers, accessed via solid-wood pulls, provide storage for bedside items. 15.75&quot;W x 11.81&quot;D x 23.63&quot;H Oak veneer with iron; white-powder-coated legs and wood pulls Two-tone end table with simple but modern design The end table features two drawers for maximized storage next to couch or bed. Gliding drawers feature matching knobs for uniform look. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Two-Toned Modern Nightstand 15.75&quot;W, Natural &amp; White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yLG1LoY5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i3AjUx42L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i3AjUx42L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pABURhicL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pABURhicL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d2qZwN51L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d2qZwN51L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IXCzzLR+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IXCzzLR+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HOUCAdPFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/8