    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZQQLV\",\"sku\":\"B07B4ZQQLV\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-king-bed-with-headboard-84-w-spinnsol-cocoa-brown-b07b4zqqlv\",\"name\":\"Tisbury Nailhead Trim King Bed with Headboard, 84&quot;W, Spinnsol Cocoa Brown\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim King Bed with Headboard, 84&quot;W, Spinnsol Cocoa Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cVhl8HXmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aLkCO2DiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aLkCO2DiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JtPJ1RluL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JtPJ1RluL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DASdOR+nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DASdOR+nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M9ydsbaVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M9ydsbaVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wwXvnuqyL.jpg\",\"url\":\"ht