    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JLP6K\",\"sku\":\"B0857JLP6K\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-birch-dining-chair-17-5-w-dark-gray-b0857jlp6k\",\"name\":\"Modern Farmhouse Birch Dining Chair, 17.5&quot;W, Dark Gray\",\"description\":\"This solid birch dining chair has a timeless, traditional look but is still comfortable enough for the most casual of get-togethers. Its dark-gray color helps it match with different tables and types of rooms. 17.5&quot;W x 21.5&quot;D x 39&quot;H Solid birch The 100% birch construction makes this chair sturdy enough to last a lifetime but easy to sit in every day. The birch and gray finish give this chair a classic, understated look that can be adapted to different purposes. Assemble in 15 minutes or less Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Birch Dining Chair, 17.5&quot;W, Dark Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61c7kxFu6hL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DR5XsJ08L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DR5XsJ08L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61kgsdISBXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61kgsdISBXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OjmziJHbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OjmziJHbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41fjx63H+jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41fjx63H+jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ye8Y7dp9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ye8Y7dp9L.jpg\"},{\"alt\