    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084ZB3XZ9\",\"sku\":\"B084ZB3XZ9\",\"lang\":\"en\",\"slug\":\"rustic-solid-pine-bed-with-headboard-full-59-45-w-gray-b084zb3xz9\",\"name\":\"Rustic Solid Pine Bed with Headboard, Full, 59.45&quot;W, Gray\",\"description\":\"This traditional bed complete with headboard has true rustic charm. Perfect for any bedroom in your home, this pine bed can stand alone as a centerpiece or blend with your existing furniture, adding a touch of welcome serenity. 59.45&quot;W x 79.06&quot;D x 49.02&quot;H Made of pine, plywood, and metal This bed needs no box spring. This rustic design is made with natural reclaimed wood in a gray finish. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rustic Solid Pine Bed with Headboard, Full, 59.45&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51PENijr6-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ujfWDBJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ujfWDBJmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oGdXCqCRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oGdXCqCRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K8VTfo-uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K8VTfo-uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WnxGeyuUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WnxGeyuUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51zc2RcZFDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51zc2RcZFDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"49.02\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"59.45\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"79.06\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"47.33\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Frame\",\"label\":\"Frame\"},{\"value\":\"Platform\",\"label\":\"Platform\"},{\"value\":\"Olb\",\"label\":\"Olb\"},{\"value\":\"One\",\"label\":\"One\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Needed\",\"label\":\"Needed\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Shore\",\"label\":\"Shore\"},{\"value\":\"Cheap\",\"label\":\"Cheap\"},{\"value\":\"Matrimoniales\",\"label\":\"Matrimoniales\"},{\"value\":\"Malm\",\"label\":\"Malm\"},{\"value\":\"Swpbhc\",\"label\":\"Swpbhc\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Dressers\",\"label\":\"Dressers\"},{\"value\":\"Murphy\",\"label\":\"Murphy\"},{\"value\":\"Captain's\",\"label\":\"Captain's\"},{\"value\":\"Frames\",\"label\":\"Frames\"},{\"value\":\"Con\",\"label\":\"Con\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Upholstered\",\"label\":\"Upholstered\"},{\"value\":\"South\",\"label\":\"South\"},{\"value\":\"Tall\",\"label\":\"Tall\"},{\"value\":\"California\",\"label\":\"California\"},{\"value\":\"Captain\",\"label\":\"Captain\"},{\"value\":\"Spring\",\"label\":\"Spring\"},{\"value\":\"Double\",\"label\":\"Double\"},{\"value\":\"Kids\",\"label\":\"Kids\"},{\"value\":\"Colchon\",\"label\":\"Colchon\"},{\"value\":\"Twin\",\"label\":\"Twin\"},{\"value\":\"Storage\",\"label\":\"Storage\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Captains\",\"label\":\"Captains\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Zinus\",\"label\":\"Zinus\"},{\"value\":\"Country\",\"label\":\"Country\"},{\"value\":\"Collection\",\"label\":\"Collection\"},{\"value\":\"F