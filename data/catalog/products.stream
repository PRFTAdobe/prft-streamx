    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LM551\",\"sku\":\"B07P5LM551\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-ottoman-with-tapered-legs-31-9-w-yellow-b07p5lm551\",\"name\":\"Rivet Sloane Mid-Century Modern Ottoman with Tapered Legs, 31.9&quot;W, Yellow\",\"description\":\"This modern ottoman sports a strong profile and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The durable upholstery and solid-wood frame make this piece both cozy and reliable. 31.9&quot;W x 24&quot;D x 17.7&quot;H Solid wood frame and legs; 100% polyester upholstery A solid wood frame and durable fabric make this ottoman as practical as it is stylish. Tapered legs add elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Ottoman with Tapered Legs, 31.9&quot;W, Yellow\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xSoks27SL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZKY9eAjWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZKY9eAjWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EEhFJ27ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EEhFJ27ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uoMRWLu-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uoMRWLu-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17VWk4dX+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17VWk4dX+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sxR2Q9mIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sxR2Q9mIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"31.9\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.2\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Yellow\",\"label\":\"Yellow\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Upholstered stool\",\"label\":\"Upholstered stool\"},{\"value\":\"Cushion\",\"label\":\"Cushion\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":320,\"discountedValue\":288.0}}"
