        "bytes": "{\"id\":\"B07DBHGHRV\",\"sku\":\"B07DBHGHRV\",\"lang\":\"en\",\"slug\":\"ravenna-home-penridge-rolled-armed-seamed-back-accent-chair-29-92-w-navy-blue-b07dbhghrv\",\"name\":\"Ravenna Home Penridge Rolled Armed Seamed Back Accent Chair, 29.92&quot;W, Navy Blue\",\"description\":\"Wood frame; polyester; foam padding; wood legs with black painted finish A seamed back adds a casual modern twist to a traditional roll-arm chair Elements of traditional and modern style allow this chair to blend anywhere Easy to assemble, just attach legs Free returns for 30 days. 1-year warranty. 27.95&quot;L x 29.92&quot;W x 33.46&quot;H\",\"primaryImage\":{\"alt\":\"Ravenna Home Penridge Rolled Armed Seamed Back Accent Chair, 29.92&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PYcbmtItL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XslFOyH5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XslFOyH5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sy12pP7oS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sy12pP7oS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RKsXtO2wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RKsXtO2wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HRkw1MV1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HRkw1MV1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OMUCt4Z7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OMUCt4Z7L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.46\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.92\",\"label\":\"inche