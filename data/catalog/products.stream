        "bytes": "{\"id\":\"B07QCMBCX7\",\"sku\":\"B07QCMBCX7\",\"lang\":\"en\",\"slug\":\"rivet-blanchard-living-room-chair-with-swivel-base-40-h-stucco-b07qcmbcx7\",\"name\":\"Rivet Blanchard Living Room Chair with Swivel Base, 40&quot;H, Stucco\",\"description\":\"This contemporary high-backed living room chair offers the ease of conversation with a gunmetal-hued swivel base. The stucco-colored fabric upholstery adds a modern elegance to any room while also providing excellent durability, helping the chair to always look like new. 28&quot;W x 35&quot;D x 40&quot;H 80% polyester, 20% acrylic High back with swivel base The high back and fabric upholstery of this chair add a contemporary look to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Blanchard Living Room Chair with Swivel Base, 40&quot;H, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Kzh6vpWNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ehWxeJDYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ehWxeJDYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81touTzq0DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81touTzq0DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FApdgZUCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FApdgZUCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812+jEMs2sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812+jEMs2sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Tdh3hZlZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Tdh3hZlZL.jpg\"}],\"attributes\":[{\"name\":\