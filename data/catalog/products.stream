  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQPNX\",\"sku\":\"B07QBMQPNX\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-loveseat-sofa-with-wood-base-and-legs-62-w-fog-gray-b07qbmqpnx\",\"name\":\"Hillman Mid-Century Loveseat Sofa with Wood Base and Legs, 62&quot;W, Fog Gray\",\"description\":\"Wide, comfortable cushions are a hallmark of this mid-century inspired love seat. Easy-care gray upholstery and reversible back cushions help keep this piece looking fresh. A hardwood frame connects to tapered wood legs and lends structure to the foam-padded cushions. High arms give additional support. 62&quot;W x 38&quot;D x 33&quot;H; seat height: 18&quot;H; seat depth: 21&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 8&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Removable and reversible back and throw cushions Classic shape and plush cushions make this love seat work with a variety of decors. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Loveseat Sofa with Wood Base and Legs, 62&quot;W, Fog Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jv99BwvrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KcHAp0iCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KcHAp0iCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Iy2B7qAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Iy2B7qAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QSHVBLbmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QSHVBLbmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v+NyoRJfL.jpg\",\"url\":\"https://storage.googleapis.com/