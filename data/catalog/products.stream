    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMN1J8\",\"sku\":\"B075YMN1J8\",\"lang\":\"en\",\"slug\":\"sophia-modern-swivel-kitchen-counter-height-stool-39-4-h-slate-grey-b075ymn1j8\",\"name\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Slate Grey\",\"description\":\"With a substantial padded back and seat, this counter stool provides maximum comfort and swivels for easy conversation. The solid hardwood frame is sturdy and stable, and performance fabric makes it durable and easy to clean. 17.7&quot;D x 21.3&quot;W x 39.4&quot;H. Seat height is 26&quot;. 95% polyester/5% nylon on hardwood frame; solid poplar legs. Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t43eIRkKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ac1DznkbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ac1DznkbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a4uJbXm+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a4uJbXm+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PRBwORyJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PRBwORyJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g-F-SukLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g-F-SukLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height