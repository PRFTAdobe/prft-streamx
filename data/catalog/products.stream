    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073ZNVNLL\",\"sku\":\"B073ZNVNLL\",\"lang\":\"en\",\"slug\":\"kristin-chair-and-a-half-upholstered-sleeper-sofa-55-5-w-stone-b073znvnll\",\"name\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Stone\",\"description\":\"In addition to being a lovely accent piece for any room, this chair doubles as a pull-out twin bed perfect for hosting guests. Round arms and clean style give this chair modern and classic touches, allowing it to blend with most styles. 55.5&quot;W and 72&quot;D when unfolded into bed Solid hardwood and laminate wood frame; polyester/nylon performance fabric Modern casual Doubles as an accent chair and pull-out twin bed No assembly required Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ndw9QthmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qqgSqfXlS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qqgSqfXlS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81COlvAECqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81COlvAECqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1du4N8huUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1du4N8huUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jl1wFyvnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jl1wFyvnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v13+UIJAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v13+UIJAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inc