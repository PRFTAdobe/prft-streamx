    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BDFQ4\",\"sku\":\"B07B7BDFQ4\",\"lang\":\"en\",\"slug\":\"elden-leather-nailhead-trim-saddle-kitchen-counter-backless-bar-stool-30-h-black-b07b7bdfq4\",\"name\":\"Elden Leather Nailhead-Trim Saddle Kitchen Counter Backless Bar Stool, 30&quot;H, Black\",\"description\":\"With a top-grain leather seat and brass-finished nailhead trim, this handsome bar stool exudes sophistication. The seat is curved for extra comfort, while high quality construction and materials ensure it will last through many good times. 19.6&quot;W x 14.1&quot;D x 29.9&quot;H Top-grain leather seat on hardwood base Leather, wood and nailhead trim combine for a sophistication that blends with any décor No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Leather Nailhead-Trim Saddle Kitchen Counter Backless Bar Stool, 30&quot;H, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61m-iyrxoVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OGQONJ1zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OGQONJ1zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I960tE2GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I960tE2GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PPO0KSZvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PPO0KSZvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"14.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"13.2\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Black leather\",\"label\":\"Black leather\"},{\"value\":\"Barstools\",\"label\":\"Barstools\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Counter stool\",\"label\":\"Counter stool\"},{\"value\":\"Bar stools set of 4\",\"label\":\"Bar stools set of 4\"},{\"value\":\"Bar stools set of 3\",\"label\":\"Bar stools set of 3\"},{\"value\":\"Bar stools set of 2\",\"label\":\"Bar stools set of 2\"},{\"value\":\"Counter stools\",\"label\":\"Counter stools\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Counter height bar stools\",\"label\":\"Counter height bar stools\"},{\"value\":\"Bar height\",\"label\":\"Bar height\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Bar stool\",\"label\":\"Bar stool\"}]}],\"categories\":[{\"id\":\"Barstools\",\"slug\":\"barstools\",\"name\":\"Barstools\",\"value\":\"Barstools\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":495,\"discountedValue\":445.5}}"
