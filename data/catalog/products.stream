    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B5127YV\",\"sku\":\"B07B5127YV\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-queen-headboard-71-w-curious-charcoal-b07b5127yv\",\"name\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Curious Charcoal\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 71&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Curious Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Os447M5lL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rXE-5vwcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rXE-5vwcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CmlrPsqaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CmlrPsqaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uHRPB7kbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uHRPB7kbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bpuzwn1vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bpuzwn1vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sVvPZ1kPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1