    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ1WXCM\",\"sku\":\"B07QJ1WXCM\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-dining-chair-35-h-ink-blue-king-b07qj1wxcm\",\"name\":\"Rivet Contemporary Dining Chair, 35&quot;H, Ink Blue, King\",\"description\":\"These modern dining chairs feature ink-blue plush upholstery and sloping low armrests. A distinctive ribbed channel design appears on the exterior of the chair back. 23&quot;W x 25&quot;D x 35&quot;H; seat height: 19&quot;H; seat depth: 18&quot;D; seat back height: 16&quot;H Plush upholstery on a solid wood frame Low armrests offer stability as well as ease of movement. The contemporary design features clean lines and a curved back with upholstered ribbed channel exterior. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Dining Chair, 35&quot;H, Ink Blue, King\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7159sNCN8pL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YfkQGO4dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YfkQGO4dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18eJjafDJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18eJjafDJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UKUbc+Y0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UKUbc+Y0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810lDQnFvML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810lDQnFvML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715W7xG-VLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715W7xG-VLL.jpg\"}],\"attributes\":[{\"name\":\"height