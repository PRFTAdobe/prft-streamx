    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08569F1GX\",\"sku\":\"B08569F1GX\",\"lang\":\"en\",\"slug\":\"rivet-vern-contemporary-round-back-swivel-dining-chair-with-arms-23-w-spearmint-b08569f1gx\",\"name\":\"Rivet Vern Contemporary Round Back Swivel Dining Chair with Arms, 23&quot;W, Spearmint\",\"description\":\"This beautiful grey-green dining chair combines sophisticated contemporary style with timeless comfort and conversation-friendly swivel motion. A solid wood frame supports a cushioned seat with a full seat back. Overall: 24&quot;D x 23&quot;W x 32&quot;H. Seat height: 18.5&quot;, arm height: 23.6&quot; Fabric upholstery and foam padding on a solid wood frame with swivel mechanism. Supreme comfort and convenience meets contemporary style. Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Vern Contemporary Round Back Swivel Dining Chair with Arms, 23&quot;W, Spearmint\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IuucyeJKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IqPTcnKCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IqPTcnKCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YlHjgkVqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YlHjgkVqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MWKJ5ADuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MWKJ5ADuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bBzy2BXQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bBzy2BXQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13UldNoUkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13UldNoUkL.jpg\"},{\"alt\"