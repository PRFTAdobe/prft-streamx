    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5HBB2\",\"sku\":\"B075X5HBB2\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-ottoman-31-w-saddle-brown-b075x5hbb2\",\"name\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Saddle Brown\",\"description\":\"Sit back, relax, and rest those tired feet on this extra large ottoman. Add a tray on the top to display magazines or place drinks, and also have extra seating for a guest or two. Leather upholstery adds the classic touch. This item is made to order just for you Overall depth: 25&quot;, Seat depth: 25&quot;, Height: 20&quot;, Width: 31&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional ottoman with seating for two Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zEgZ7Z+nL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qZjEZjr7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qZjEZjr7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H+QlqF2LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H+QlqF2LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h7b0aNGlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h7b0aNGlL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Saddle brown\",\"label\":\"Saddle brown\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Storage-ottomans\",\"label\":\"Storage-ottomans\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":604,\"discountedValue\":543.6}}"
