    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LN1M4\",\"sku\":\"B07P5LN1M4\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-loveseat-with-hardwood-frame-74-w-chocolate-b07p5ln1m4\",\"name\":\"Lauren Down-Filled Oversized Loveseat with Hardwood Frame, 74&quot;W, Chocolate\",\"description\":\"Dimensions: 74&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this loveseat offers plush support and security. Neutral chocolate-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Loveseat with Hardwood Frame, 74&quot;W, Chocolate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lINIAEBmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71H4dBUqWCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71H4dBUqWCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DqXtPpdaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DqXtPpdaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hKrCINszL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hKrCINszL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dZRzWg7ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dZRzWg7ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XzbBYdX3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A