    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSG7KWF\",\"sku\":\"B07HSG7KWF\",\"lang\":\"en\",\"slug\":\"rivet-modern-leather-swivel-desk-armless-office-chair-30-6-inch-height-adjustable-height-grey-b07hsg7kwf\",\"name\":\"Rivet Modern Leather Swivel Desk Armless Office Chair 30.6 Inch Height, Adjustable Height, Grey\",\"description\":\"This high-backed modern desk chair lends any office an air of sleek sophistication with its chromed base and genuine gray leather seat, while its ability to swivel gives it an ergonomic edge over its stationary counterparts. 25.88&quot;W x 22.8&quot;D x 30.6&quot;H; Seat Height: 18.72-23.2”H; Seat Depth: 17.16”D; Seat Back Height: 21.45”H 100% Genuine Leather A chromed base helps achieve a contemporary style for your work space . Carefully crafted gray genuine leather creates a welcoming atmosphere in your office. Simple assembly in 15-30 minutes Wipes clean with a soft, dry cloth. Avoid moisture. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Leather Swivel Desk Armless Office Chair 30.6 Inch Height, Adjustable Height, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YkyRmBvfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nX6a6gXXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nX6a6gXXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hXzBBfo+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hXzBBfo+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fofKeQJKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fofKeQJKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714gYj+EzTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714gYj+EzTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresig