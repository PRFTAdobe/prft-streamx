        "bytes": "{\"id\":\"B07DBHBB4N\",\"sku\":\"B07DBHBB4N\",\"lang\":\"en\",\"slug\":\"ravenna-home-sarah-tufted-wingback-nailhead-trim-loveseat-bench-settee-32-w-cream-b07dbhbb4n\",\"name\":\"Ravenna Home Sarah Tufted Wingback Nailhead Trim Loveseat Bench Settee, 32&quot;W, Cream\",\"description\":\"52&quot;Lx 32&quot;Wx 42&quot;H Wood frame; polyester; foam padding; wood legs with black painted finish; nailhead trim Squared back gives a modern update to the Mid-century wingback style This handsome settee adds a style statement and extra seating to a living space or bedroom Less than 15-30 minutes assembly required; just attach the back and legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Sarah Tufted Wingback Nailhead Trim Loveseat Bench Settee, 32&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gUcrTT7zL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rLgdjNzTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rLgdjNzTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y+qk8JJbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y+qk8JJbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NINR8bssL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NINR8bssL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xgPTshFML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xgPTshFML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CibVJ8DvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CibVJ8DvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"labe