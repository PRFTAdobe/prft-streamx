    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4QFDW\",\"sku\":\"B075X4QFDW\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-ottoman-31-w-sod-b075x4qfdw\",\"name\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Sod\",\"description\":\"Sit back, relax, and rest those tired feet on this extra large ottoman. Add a tray on the top to display magazines or place drinks, and also have extra seating for a guest or two. Leather upholstery adds the classic touch. This item is made to order just for you Overall depth: 25&quot;, Seat depth: 25&quot;, Height: 20&quot;, Width: 31&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional ottoman with seating for two Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Sod\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91znaFlA0UL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MtD0FAdzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MtD0FAdzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qKpeebzpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qKpeebzpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oXa5Hr0NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oXa5Hr0NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fmhiuXtAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fmhiuXtAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YbIUO0tjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YbIUO0tjL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"He