    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4JJNN\",\"sku\":\"B075X4JJNN\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-straight-back-settee-49-w-bear-b075x4jjnn\",\"name\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Bear\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish. A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Bear\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MJfibcz8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ja+5d4fGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ja+5d4fGS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fvsDwDzCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fvsDwDzCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qc-jUyfwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qc-jUyfwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NZfMUZOWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NZfMUZOWL.jpg\"},{\"alt\":\"https://storage.go