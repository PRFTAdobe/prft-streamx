    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSF3Y12\",\"sku\":\"B07HSF3Y12\",\"lang\":\"en\",\"slug\":\"rylee-modern-acacia-wood-queen-bed-67-52-w-gray-wash-acacia-b07hsf3y12\",\"name\":\"Rylee Modern Acacia Wood Queen Bed, 67.52&quot;W, Gray-Wash Acacia\",\"description\":\"Add a modern flair to your home with this beautiful queen bed. Made from solid acacia with a subtle gray-wash finish, this bed frame perfectly complements most home-décor styles. Its 4 elegant but strong legs keep the bed sturdy, and its cross rails provide ample support for a mattress. 67.52&quot;W x 84.65&quot;D x 43.31&quot;H; Leg Height: 11&quot;H Solid acacia with acacia veneer Subtle gray-washed distressed finish and clean lines create an attractive modern look. Modern headboard shape; mattress sold separately Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rylee Modern Acacia Wood Queen Bed, 67.52&quot;W, Gray-Wash Acacia\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712geqvgnbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IL7YJGj3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IL7YJGj3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lqQ3EKbOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lqQ3EKbOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mWJIlAEXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mWJIlAEXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qnGB2Xh+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qnGB2Xh+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ETZpAht6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ETZpAht6L.jpg\"}],\"attribute