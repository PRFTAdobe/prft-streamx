        "bytes": "{\"id\":\"B07DBK7KBY\",\"sku\":\"B07DBK7KBY\",\"lang\":\"en\",\"slug\":\"ravenna-home-sarah-tufted-wingback-nailhead-trim-loveseat-bench-settee-32-w-light-grey-b07dbk7kby\",\"name\":\"Ravenna Home Sarah Tufted Wingback Nailhead Trim Loveseat Bench Settee, 32&quot;W, Light Grey\",\"description\":\"52&quot;Lx 32&quot;Wx 42&quot;H Wood frame; polyester; foam padding; wood legs with black painted finish; nailhead trim Squared back gives a modern update to the Mid-century wingback style This handsome settee adds a style statement and extra seating to a living space or bedroom Less than 15-30 minutes assembly required; just attach the back and legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Sarah Tufted Wingback Nailhead Trim Loveseat Bench Settee, 32&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oFjZpfnJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMbeXWUfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMbeXWUfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RoXBO7cdS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RoXBO7cdS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iFU2UAyoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iFU2UAyoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELnGwFU3S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELnGwFU3S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rOEVHsuZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rOEVHsuZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.0\",\"label\":\"inches\"}]},{\"name\":\