        "bytes": "{\"id\":\"B07BWJCZJX\",\"sku\":\"B07BWJCZJX\",\"lang\":\"en\",\"slug\":\"lummi-modern-armless-living-room-accent-chair-21-6-w-denim-b07bwjczjx\",\"name\":\"Lummi Modern Armless Living Room Accent Chair, 21.6&quot; W, Denim\",\"description\":\"Let your unique style shine through with this modern accent slipper chair. The soft brushed fabric blends well in your master suite or living room. 29.9&quot;D x 21.6&quot;W x 32.7&quot;H Beech wood frame covered in polyester fabric Modern Simple, streamlined design will complement your existing style Minimal assembly; just attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Lummi Modern Armless Living Room Accent Chair, 21.6&quot; W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mTAUFojML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81At9LfRk9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81At9LfRk9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81krmWsMZqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81krmWsMZqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NppE9SCuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NppE9SCuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cn2SJx9dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cn2SJx9dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/614kXjIiJ6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/614kXjIiJ6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.9\",\"label\":\"inches\"}]},{\"name\":\"