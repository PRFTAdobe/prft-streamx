    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D84F8\",\"sku\":\"B07B4D84F8\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-mid-centory-modern-couch-sofa-87-w-hunter-green-b07b4d84f8\",\"name\":\"Rivet Edgewest Low Back Mid-Centory Modern Couch Sofa, 87&quot;W, Hunter Green\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 87&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Mid-Centory Modern Couch Sofa, 87&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oVbSi+gnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b0xc5DX-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b0xc5DX-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810kyA7huPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810kyA7huPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EjUGhj0xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EjUGhj0xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8195kJKPyLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8195kJKPyLL.jpg\"},{\"alt\":\"https://sto