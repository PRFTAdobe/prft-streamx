        "bytes": "{\"id\":\"B07B4YZWSR\",\"sku\":\"B07B4YZWSR\",\"lang\":\"en\",\"slug\":\"industry-french-metal-king-bed-with-headboard-79-5-w-black-b07b4yzwsr\",\"name\":\"Industry French Metal King Bed with Headboard, 79.5&quot;W, Black\",\"description\":\"85&quot;L x 79.5&quot;W x 56&quot;H Sturdy steel construction Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 3-year warranty Create a romantic retreat with this French country-inspired king bed. This metal bed frame with brushed black pewter finish features a unique scroll design. Add fluffy, cozy bedding and pillows to create an inviting focal point in your room.\",\"primaryImage\":{\"alt\":\"Industry French Metal King Bed with Headboard, 79.5&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ruA2WzAmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hFQ88JMAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hFQ88JMAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81asSpMCJoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81asSpMCJoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lYaV3jtZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lYaV3jtZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g9g2i-34L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g9g2i-34L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tc4-Zcf3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tc4-Zcf3L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"56.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"79.5\",\"label\":\"inches\"}]},{\"