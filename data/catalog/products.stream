        "bytes": "{\"id\":\"B07B8NBQQP\",\"sku\":\"B07B8NBQQP\",\"lang\":\"en\",\"slug\":\"vintage-farmhouse-wood-floating-wall-storage-cabinet-with-chalkboard-24-x-21-x-8-inches-antique-white-b07b8nbqqp\",\"name\":\"Vintage Farmhouse Wood Floating Wall Storage Cabinet with Chalkboard - 24 x 21 x 8 Inches, Antique White\",\"description\":\"This clever piece provides a chalkboard for reminders, shelves for storing small items and art for your wall -- all in one. The white painted finish provides a striking contrast to the dark chalkboard and metalwork across the top. 21.25&quot; W x 23.75&quot; H x 8.25&quot; D Constructed from hardwood with iron bar Ready to hang, all hardware included\",\"primaryImage\":{\"alt\":\"Vintage Farmhouse Wood Floating Wall Storage Cabinet with Chalkboard - 24 x 21 x 8 Inches, Antique White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91olkxPcm4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ovRakna+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ovRakna+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719QJnT1SGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719QJnT1SGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HLe8wRyjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HLe8wRyjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dbwFxYbBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dbwFxYbBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"23.75\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"21.25\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"8.25\",\"label\":\"inches\"}]},{\"name