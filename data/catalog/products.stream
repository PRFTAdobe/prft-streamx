        "bytes": "{\"id\":\"B072C8QG7V\",\"sku\":\"B072C8QG7V\",\"lang\":\"en\",\"slug\":\"rivet-north-end-modern-wood-accent-sectional-sofa-couch-78-3-w-grey-weave-b072c8qg7v\",\"name\":\"Rivet North End Modern Wood Accent Sectional Sofa Couch, 78.3&quot;W, Grey Weave\",\"description\":\"This smart-looking sofa has clean lines and an exposed solid wood base that is sure to turn heads. With comfortable cushions and soft, durable fabric, it's also built to withstand wear and tear from your many visitors. Sturdy hardwood construction, solid beech legs, stain-resistant polyester fabric Contemporary and comfortable At home in your living room Simple assembly; just attach legs Free returns for 30 days. 1-year warranty. 37.8''D x 78.3&quot;W x 34.6&quot;H\",\"primaryImage\":{\"alt\":\"Rivet North End Modern Wood Accent Sectional Sofa Couch, 78.3&quot;W, Grey Weave\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t1Tzi3TNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rEizMIc6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rEizMIc6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15lbCLBiCS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15lbCLBiCS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JRD6raBTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JRD6raBTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81R87WCM1gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81R87WCM1gL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\