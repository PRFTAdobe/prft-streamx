        "bytes": "{\"id\":\"B07B4MRKR8\",\"sku\":\"B07B4MRKR8\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-ottoman-32-w-rouge-red-b07b4mrkr8\",\"name\":\"Rivet Edgewest Modern Ottoman, 32&quot;W, Rouge Red\",\"description\":\"Features such as box-edge framing and metal legs make this ottoman look sharp in modern or industrial settings. With a solid frame and durable fabric, it's ready to welcome tired feet or to serve as extra seating for guests. 32&quot;W x 26&quot;D x 19&quot;H; Seat Height: 19&quot;H ; Seat Depth: 26&quot;D; Seat Back Height: 19&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Ottoman, 32&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KFzUuGVtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nE8vbLpnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nE8vbLpnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hLIoPRnzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hLIoPRnzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91INX2tOv7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91INX2tOv7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RkbuRk+6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RkbuRk+6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vPEP8zJZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vPEP8zJZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"26.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"26.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Rouge red\",\"label\":\"Rouge red\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"}]}],\"categories\":[{\"id\":\"Living Room Furniture\",\"slug\":\"living-room-furniture\",\"name\":\"Living Room Furniture\",\"value\":\"Living Room Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":754,\"discountedValue\":678.6}}"
