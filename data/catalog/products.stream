    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGFZ2B4\",\"sku\":\"B07QGFZ2B4\",\"lang\":\"en\",\"slug\":\"rivet-industrial-mango-topped-side-table-19-61-w-b07qgfz2b4\",\"name\":\"Rivet Industrial Mango-Topped Side Table, 19.61&quot;W\",\"description\":\"The parquetry design of this mango-topped piece turns a side table into a point of visual interest wherever it is placed. Metal legs in an X shape provide stability and add a modern element. No assembly and compact dimensions make this table a convenient and stylish feature to add to any room. 19.61&quot;W x 19.61&quot;D x 21.65&quot;H Made with mango top and metal base This stylish console table features a parquetry top that adds classic appeal to your space. Ships fully assembled. All seams are welded, and there are no exposed screws or bolts. Table features a solid wood parquetry top. No assembly required Clean with a soft, damp cloth. Avoid placing furniture near heat vents or open windows. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Mango-Topped Side Table, 19.61&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m-qwaKN0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81secerAB-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81secerAB-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zepjMKtRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zepjMKtRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kR7Rb+kHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kR7Rb+kHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CohXv+i0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CohXv+i0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91