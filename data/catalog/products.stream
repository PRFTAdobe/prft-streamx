    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831Y914Z\",\"sku\":\"B0831Y914Z\",\"lang\":\"en\",\"slug\":\"devonshire-modern-farmhouse-large-ottoman-41-w-tweed-b0831y914z\",\"name\":\"Devonshire Modern Farmhouse Large Ottoman, 41&quot;W, Tweed\",\"description\":\"The generous size of this fully padded ottoman provides plenty of room for putting your feet up and relaxing. The clean, modern lines and tweed upholstery bring a distinctive flair to your living room or family room. Durable, easy-care performance fabric makes cleaning a breeze. 41&quot;W x 41&quot;D x 18.5&quot;H; leg height: 2&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Devonshire Modern Farmhouse Large Ottoman, 41&quot;W, Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91plM-2tQ8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZYkj1po6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZYkj1po6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814waUBDkcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814waUBDkcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KT73M4vlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KT73M4vlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810CwhJRcML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810CwhJRcML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\