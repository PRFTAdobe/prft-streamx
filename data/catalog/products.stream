        "bytes": "{\"id\":\"B07B4MKCT9\",\"sku\":\"B07B4MKCT9\",\"lang\":\"en\",\"slug\":\"denton-leather-chair-stone-beam-b07b4mkct9\",\"name\":\"Denton Leather Chair Stone & Beam\",\"description\":\"This eye-catching &quot;egg chair&quot; and matching ottoman are ready to be fun conversation pieces in your family room. Top-grain leather upholstery is combined with metal four-point bases for a look that is the epitome of mid-century modern design. [Dimensions Placeholder] Top-grain leather upholstery on wood frame; metal base Mid-century modern at its finest A statement style piece that's comfortable, too. Assembly in 15 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Denton Leather Chair Stone & Beam\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61kVdTXTJ4L.jpg\"},\"gallery\":[],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.75\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"107.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Office\",\"label\":\"Office\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Butterfly\",\"label\":\"Butterfly\"},{\"value\":\"Popular\",\"label\":\"Popular\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Glider\",\"label\":\"Glider\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Wingback\",\"label\":\"Wingback\"},{\"value\":\"Royalty\",\"label\":\"Royalty\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"610\",\"label\":\"610\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Back\",\"label\