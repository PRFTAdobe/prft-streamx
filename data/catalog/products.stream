    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B1HCM\",\"sku\":\"B07B7B1HCM\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-high-back-swivel-seat-counter-stool-39-h-grey-b07b7b1hcm\",\"name\":\"Alaina Contemporary High-Back Swivel Seat Counter Stool, 39&quot;H, Grey\",\"description\":\"This counter height bar stool allows you to fit your guests around the kitchen island for special celebrations, while a swivel function makes it extra easy for everyone to chat. Their transitional style allows them to blend with any style room. 18.5&quot;W x 22&quot;D x 39&quot;H; Seat Depth: 16.5&quot;D; Seat Back Height: 12.5&quot;H; Seat Height: 26&quot;H Moisture-repellent, stain-resistant fabric on a solid hardwood frame with swivel seat and low arms Modern design with classic solid fabric provides a transitional look No assembly required. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary High-Back Swivel Seat Counter Stool, 39&quot;H, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I4rtql78L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+bkAeqXCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+bkAeqXCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oyE07ecNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oyE07ecNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HVS8UoE1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HVS8UoE1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oR8OqhsYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oR8OqhsYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wYFTZC8sL.jpg\",\"url\":\"https://storage.googleapis.com/puresigh