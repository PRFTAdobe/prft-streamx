    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568FHP9\",\"sku\":\"B08568FHP9\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-juniper-b08568fhp9\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Juniper\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Juniper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qA3zXFyTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71X1DB8fcwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71X1DB8fcwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71myypI6MoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71myypI6MoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E3mjuYaFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E3mjuYaFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yuYLlkRXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yuYLlkRXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uddBs-k-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uddBs-k-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MRqZe