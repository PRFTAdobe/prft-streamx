        "bytes": "{\"id\":\"B07HSG2V2Y\",\"sku\":\"B07HSG2V2Y\",\"lang\":\"en\",\"slug\":\"rivet-tinted-glass-and-metal-round-coffee-table-with-storage-shelf-36-9-w-brown-gold-and-walnut-finish-b07hsg2v2y\",\"name\":\"Rivet Tinted-Glass and Metal Round Coffee Table with Storage Shelf, 36.9&quot;W, Brown, Gold and Walnut Finish\",\"description\":\"This large circular coffee table will make a stylish statement as the focal point of your living room or lounge. The tinted-glass top adds a dimensional transparency to the piece, while the round walnut-finish shelf provides handy storage. 36.93&quot; diameter x 15.75&quot; high Brown glass top, satin gold-finished metal frame and walnut-finished MDF shelf The transparent tinted-glass top allows a view of the structural base. A handy shelf offers extra storage. This retro-feel coffee table exudes classic style. Assemble in 15-30 minutes. Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Tinted-Glass and Metal Round Coffee Table with Storage Shelf, 36.9&quot;W, Brown, Gold and Walnut Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719reyq1yjL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qFVSd13vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qFVSd13vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718bAHQ3uQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718bAHQ3uQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51+-dZjFRML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51+-dZjFRML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BOKxyDHeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BOKxyDHeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AnGkXLKXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AnGkXLKXL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"5.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Antique\",\"label\":\"Antique\"},{\"value\":\"Mesas\",\"label\":\"Mesas\"},{\"value\":\"Bromborough\",\"label\":\"Bromborough\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Entertainment\",\"label\":\"Entertainment\"},{\"value\":\"Sala\",\"label\":\"Sala\"},{\"value\":\"Sauder\",\"label\":\"Sauder\"},{\"value\":\"Industrial\",\"label\":\"Industrial\"},{\"value\":\"Wheels\",\"label\":\"Wheels\"},{\"value\":\"Cocktail\",\"label\":\"Cocktail\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Aldwin\",\"label\":\"Aldwin\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Vintage\",\"label\":\"Vintage\"},{\"value\":\"Lifttop\",\"label\":\"Lifttop\"},{\"value\":\"Centro\",\"label\":\"Centro\"},{\"value\":\"Tables\",\"label\":\"Tables\"},{\"value\":\"Books\",\"label\":\"Books\"},{\"value\":\"Home\",\"label\":\"Home\"},{\"value\":\"Tub\",\"label\":\"Tub\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Tv\",\"label\":\"Tv\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Songmics\",\"label\":\"Songmics\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Game\",\"label\":\"Game\"},{\"value\":\"Storage\",\"label\":\"Storage\"},{\"value\":\"Wooden\"