    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FD2\",\"sku\":\"B075X43FD2\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-sofa-78-w-dove-b075x43fd2\",\"name\":\"Rivet Lawson Modern Angled Sofa, 78&quot;W, Dove\",\"description\":\"This item is made to order just for you 78&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated sofa. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Sofa, 78&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gQz8sTXbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x2wJNJP1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x2wJNJP1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LebFLArRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LebFLArRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IkF+otxBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IkF+otxBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sY31BfvzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sY31BfvzL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"labe