        "bytes": "{\"id\":\"B07HSJXP8D\",\"sku\":\"B07HSJXP8D\",\"lang\":\"en\",\"slug\":\"rylee-modern-acacia-wood-dining-table-71-102-l-gray-wash-acacia-b07hsjxp8d\",\"name\":\"Rylee Modern Acacia Wood Dining Table, 71&quot;-102&quot;L, Gray-Wash Acacia\",\"description\":\"Add a contemporary touch to your home with this beautiful dining table with extensions. Made from solid acacia with a subtle gray-washed finish, this table perfectly complements most home-décor styles. Acacia solid wood with Acacia veneer 70.8-102.4&quot;L x 39.4&quot;W x 29.9&quot;H The table length can be extended up to 102&quot; with leaf inserts. Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Rylee Modern Acacia Wood Dining Table, 71&quot;-102&quot;L, Gray-Wash Acacia\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PelY0rV-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z+-G80xTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71z+-G80xTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17f4rgAmCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17f4rgAmCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YM+NCxOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YM+NCxOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712C7VYsDRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712C7VYsDRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.9\",\"label\":\"inches\"}]},{\"name\":\"width\"