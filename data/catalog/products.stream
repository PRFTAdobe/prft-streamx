    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BJK89\",\"sku\":\"B07B7BJK89\",\"lang\":\"en\",\"slug\":\"rivet-boundary-modern-reclaimed-fir-wood-dining-kitchen-table-66-l-honey-brown-b07b7bjk89\",\"name\":\"Rivet Boundary Modern Reclaimed Fir Wood Dining Kitchen Table, 66&quot;L, Honey Brown\",\"description\":\"Reclaimed fir wood has been fashioned into a dining table that defines simple rustic beauty. Beautiful natural wood tones make your space warm and inviting, while sturdy construction will make this piece last through many game nights. 66&quot;L x 38&quot;D x 29.9&quot;H Made of hardwood comprised of 100% reclaimed fir A simple, natural style that works with modern farmhouse décor A dining table that can double as a work or craft space Assembly in 15 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Boundary Modern Reclaimed Fir Wood Dining Kitchen Table, 66&quot;L, Honey Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kGdCge1mL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912j+Md7qVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912j+Md7qVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911R-c9acFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911R-c9acFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ntg1+2yoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ntg1+2yoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KV5-qsmQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KV5-qsmQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0L.jpg\"}],\"attributes