  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831Y1G61\",\"sku\":\"B0831Y1G61\",\"lang\":\"en\",\"slug\":\"cypress-modern-tufted-farmhouse-apartment-sofa-couch-70-w-grey-b0831y1g61\",\"name\":\"Cypress Modern Tufted Farmhouse Apartment Sofa Couch, 70&quot;W, Grey\",\"description\":\"This sumptuous charcoal-gray sofa with a tufted back brings both comfort and style to your living room. High side arms provide extra support and a distinctive flair. The durable polyester and nylon performance upholstery makes spot cleaning a breeze. This will be a favorite sofa for years! 70&quot;W x 30.5&quot;D x 30&quot;H; seat height: 18.5&quot;H; seat depth: 24&quot;D; seat back height: 30&quot;H; arm height: 30&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Cypress Modern Tufted Farmhouse Apartment Sofa Couch, 70&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8198beDcneL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QVtvg2QTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QVtvg2QTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71C76OCWqmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71C76OCWqmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aJu7ZZ9-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aJu7ZZ9-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gIBtN-0EL.jpg\",\"url\":\"https://storage.