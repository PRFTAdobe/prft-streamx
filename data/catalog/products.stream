        "bytes": "{\"id\":\"B075X4PT58\",\"sku\":\"B075X4PT58\",\"lang\":\"en\",\"slug\":\"marin-upholstered-ottoman-29-w-smoky-teal-b075x4pt58\",\"name\":\"Marin Upholstered Ottoman, 29&quot;W, Smoky Teal\",\"description\":\"This item is made to order just for you 29&quot;W x 23&quot;D x 21&quot;H Sturdy hardwood frame with durable performance fabric upholstery Firm nylon webbing makes cushion resilient Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Sit back, relax, and prop up your feet on this plush ottoman. This sophisticated yet practical addition to your home can be an extra seat or place to set a tray of snacks. The sturdy frame and upholstery will last for many years.\",\"primaryImage\":{\"alt\":\"Marin Upholstered Ottoman, 29&quot;W, Smoky Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gCflJoouL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aQZqjwLRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aQZqjwLRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QZVnMOC6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QZVnMOC6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XDL1cZGrS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XDL1cZGrS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yO5wluqqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yO5wluqqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},