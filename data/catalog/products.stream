    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084ZB8L8W\",\"sku\":\"B084ZB8L8W\",\"lang\":\"en\",\"slug\":\"rustic-3-drawer-bedroom-dresser-31-9-w-oak-finish-b084zb8l8w\",\"name\":\"Rustic 3-Drawer Bedroom Dresser, 31.9&quot;W, Oak Finish\",\"description\":\"This charming rustic dresser is the perfect addition to any bedroom, whether it's the master or guest room. The traditional sturdy design is complemented by the warm wood grain. Three drawers offer ample and handy bedside storage. 31.89&quot;W x 16.93&quot;D x 31.1&quot;H Made of solid wood and manufactured wood in a rustic oak finish with metal accents. This dresser has three drawers riding on wooden glides. Assemble in 30 minutes-1 hour Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rustic 3-Drawer Bedroom Dresser, 31.9&quot;W, Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61v29Y0-gAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B3lZe9PkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B3lZe9PkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KXwIaEDkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KXwIaEDkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GXEHCtZ7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GXEHCtZ7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51RciUeILWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51RciUeILWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71im9bSXCpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71im9bSXCpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818j5dLPQsL.jpg\",\"u