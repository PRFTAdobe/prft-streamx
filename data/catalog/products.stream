    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MGRBP\",\"sku\":\"B07B4MGRBP\",\"lang\":\"en\",\"slug\":\"jameson-farmhouse-leather-recliner-36-w-saddle-brown-b07b4mgrbp\",\"name\":\"Jameson Farmhouse Leather Recliner, 36&quot;W, Saddle Brown\",\"description\":\"Gold-finished nailhead trim takes this recliner up a notch in style. Classic rolled arms and leather upholstery bring rustic sophistication to traditional or modern farmhouse-style rooms. The leather's natural markings make each chair distinctive. 36&quot;W x 37&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 39&quot;H; Arm Height: 25.25&quot;H; Front legs: 4.25&quot;H; Back legs: 3.125&quot;H Top-grain leather upholstery on hardwood pine frame Classic roll arms and rustic nailhead trim combine for ideal modern farmhouse style Push-back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Jameson Farmhouse Leather Recliner, 36&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hGn7VKhNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lzYeuIYDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lzYeuIYDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nq0Cje0RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nq0Cje0RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V7JhbyCVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V7JhbyCVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ujbjSz58L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-p