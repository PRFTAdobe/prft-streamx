    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08DSX6DTF\",\"sku\":\"B08DSX6DTF\",\"lang\":\"en\",\"slug\":\"rivet-henrik-modern-open-back-plastic-dining-chair-18-5-w-mild-gray-renewed-b08dsx6dtf\",\"name\":\"Rivet Henrik Modern Open-Back Plastic Dining Chair, 18.5&quot;W, Mild Gray (Renewed)\",\"description\":\"This modern open-backed chair with its stylish European design easily complements many dining room tables. Its professional look makes it an excellent fit in an office or living room as well. Made of sturdy beech, steel, and plastic, it will last and adapt to any changes in the surrounding decor. 18.5&quot;W x 21.5&quot;D x 26.9&quot;H; seat height: 18.1&quot;H; seat depth: 17.5&quot;D; seat back height: 15.3&quot;H; leg height: 16.3&quot;H Polypropylene, steel, beech This versatile, durable chair can be used alone or as part of a dining room set. An original piece by an Italian designer that complements many different table styles Clean with a damp, warm cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Henrik Modern Open-Back Plastic Dining Chair, 18.5&quot;W, Mild Gray (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vnncLdikL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kGkMS3DBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kGkMS3DBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XS4fBvJyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XS4fBvJyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/612H2gBGAvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/612H2gBGAvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LQNC5yZLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LQNC5yZLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"21.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"11.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Armen\",\"label\":\"Armen\"},{\"value\":\"Shell\",\"label\":\"Shell\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"4\",\"label\":\"4\"},{\"value\":\"Sillas\",\"label\":\"Sillas\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Kitchen\",\"label\":\"Kitchen\"},{\"value\":\"Teens\",\"label\":\"Teens\"},{\"value\":\"Dinner\",\"label\":\"Dinner\"},{\"value\":\"6\",\"label\":\"6\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Furmax\",\"label\":\"Furmax\"},{\"value\":\"Comedor\",\"label\":\"Comedor\"},{\"value\":\"Round\",\"label\":\"Round\"},{\"value\":\"Desk\",\"label\":\"Desk\"},{\"value\":\"Faux\",\"label\":\"Faux\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":384,\"discountedValue\":345.6}}"
