      "content": {
        "bytes": "{\"id\":\"B076NP6T56\",\"sku\":\"B076NP6T56\",\"lang\":\"en\",\"slug\":\"glenwood-panel-dining-room-table-chairs-20-w-set-of-2-oak-wood-b076np6t56\",\"name\":\"Glenwood Panel Dining Room Table Chairs, 20&quot;W, Set of 2, Oak Wood\",\"description\":\"These handsome panel-back chairs are a modern take on a classic design. Solid hardwood has an Oak finish and performance fabric upholstery on the seat, allowing it to withstand wear and tear from a busy family. 20&quot;W x 23.25&quot;D x 38&quot;H Performance fabric A simple modern piece that can blend with traditional and modern styles Free returns for 30 days. 3-year warranty. Assembly is required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Glenwood Panel Dining Room Table Chairs, 20&quot;W, Set of 2, Oak Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hb04heFaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aXw0uhmGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aXw0uhmGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811GkTa4EBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811GkTa4EBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19tfFVZVeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19tfFVZVeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wo1Zl5beL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wo1Zl5beL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kSarmlYtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kSarmlYtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"35.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Furniture\",\"slug\":\"furniture\",\"name\":\"Furniture\",\"value\":\"Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":591,\"discountedValue\":531.9}}"
