    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP38V2\",\"sku\":\"B075YP38V2\",\"lang\":\"en\",\"slug\":\"rivet-julie-mid-century-modern-dining-room-accent-chair-with-arms-32-h-ash-grey-b075yp38v2\",\"name\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Ash Grey\",\"description\":\"This classic mid-century modern accent chair features a simple, clean design with narrow armrests and tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 24&quot;W x 24&quot;D x 32&quot;H; seat height: 19&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Fabric is 60% polyester/20% linen/20% rayon; hardwood legs with espresso finish Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Ash Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A169sYfGkJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nh7mtBvfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nh7mtBvfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16RXEGlWHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16RXEGlWHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YKbmgRWzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YKbmgRWzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZnRMfJKkL.jpg\",\"url\":\"https://storage.googleapis.com/p