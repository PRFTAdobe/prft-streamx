    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X65QY7\",\"sku\":\"B075X65QY7\",\"lang\":\"en\",\"slug\":\"leila-tufted-velvet-oversized-accent-chair-living-room-chair-hunter-green-b075x65qy7\",\"name\":\"Leila Tufted Velvet Oversized Accent Chair, Living Room Chair, Hunter Green\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking vintage look chair. With solid wood legs in a dark walnut finish, plush velvet upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Velvet Oversized Accent Chair, Living Room Chair, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9169Ucda5DL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hS6Y2V3xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hS6Y2V3xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jCEW2f31L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jCEW2f31L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Aw1DEegiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Aw1DEegiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GjxyUYZmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GjxyUYZmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4d