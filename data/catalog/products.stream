  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4NW6ZQ\",\"sku\":\"B07B4NW6ZQ\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-sofa-87-w-blue-ink-b07b4nw6zq\",\"name\":\"Rivet Edgewest Low Back Modern Sofa, 87&quot;W, Blue Ink\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 87&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Sofa, 87&quot;W, Blue Ink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wJ2FV+jaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SNrA6hO4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SNrA6hO4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715ClAYh1RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715ClAYh1RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ay+HDgtQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ay+HDgtQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zOdEC-BpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zOdEC-BpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cLDZlAF1L.j