  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VM767S\",\"sku\":\"B082VM767S\",\"lang\":\"en\",\"slug\":\"rivet-alvin-contemporary-livingroom-chair-39-w-light-grey-b082vm767s\",\"name\":\"Rivet Alvin Contemporary Livingroom Chair, 39&quot;W, Light Grey\",\"description\":\"If you’re looking for a piece that’s at once modern and timeless, this chair is for you. The button-tufted, fixed back gently curves into a pair of elegant armrests, and the firm, spacious seat cushion adds durability and comfort. Overall: 39&quot;W x 36.6&quot;D x 32.3&quot;H. Seat Height: 18.1&quot;H; Seat Depth: 23.2&quot;D; Seat Back Height: 32&quot;H; Arm Height: 22&quot;H; Leg Height: 7.1&quot;H Solid-wood frame and legs with performance upholstery Modern, simple design that combines Mid-century touches with contemporary Scandinavian appeal Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alvin Contemporary Livingroom Chair, 39&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VmeRrLNAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fZejM7YEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fZejM7YEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12JLjcNvCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12JLjcNvCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ydtW0iamL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ydtW0iamL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ca5BCXApL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ca5BCXApL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WnnU+hMVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WnnU+hMVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818EiG2024L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818EiG2024L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81prVdYhArL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81prVdYhArL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.28\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.61\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"38.98\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"54.01\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Glider\",\"label\":\"Glider\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Accent\",\"label\":\"Accent\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy