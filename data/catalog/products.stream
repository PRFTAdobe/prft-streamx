    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZHG7\",\"sku\":\"B07B4FZHG7\",\"lang\":\"en\",\"slug\":\"andover-modern-square-ottoman-33-w-pewter-b07b4fzhg7\",\"name\":\"Andover Modern Square Ottoman, 33&quot;W, Pewter\",\"description\":\"Wooden legs, clean lines, and box-edge cushions bring stylish sophistication to modern or transitional rooms. With a sturdy frame and springy cushioning, this ottoman is ready to withstand years as a footrest or extra seating for guests. 33&quot;W x 33&quot;D x 21&quot;H; Seat Height: 21&quot;H ; Seat Depth: 33&quot;D; Seat Back Height: 21&quot;H; Leg Height: 4.25&quot;H Cotton/polyester blend fabric on hardwood pine frame The streamlined shape is a hallmark of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Square Ottoman, 33&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aMuIdiQfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qgh9BGUGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Qgh9BGUGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pxLyKm+pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pxLyKm+pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MQ6Vj5eDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MQ6Vj5eDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\