    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRV13H\",\"sku\":\"B07QFRV13H\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-dune-b07qfrv13h\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Dune\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft dune-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616+F2ZMCmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bLLvM6YyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bLLvM6YyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y72i19bCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y72i19bCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919E-vJQhNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919E-vJQhNL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":