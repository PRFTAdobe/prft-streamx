    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4NVYM9\",\"sku\":\"B07B4NVYM9\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-loveseat-65-w-rouge-red-b07b4nvym9\",\"name\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Rouge Red\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 65&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NOlr5HUTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917AxVjpyzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917AxVjpyzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Y1UnFZTLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Y1UnFZTLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RgmKM130L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RgmKM130L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iz2vcrhLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iz2vcrhLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/9