    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568VZZN\",\"sku\":\"B08568VZZN\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-silver-grey-b08568vzzn\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Silver Grey\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Silver Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81u7bqY4kXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ox6gt2qiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ox6gt2qiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nbstr2GgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nbstr2GgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DV60GPAML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DV60GPAML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lO8FG3tKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lO8FG3tKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719WiFPvmnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719WiFPvmnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origina