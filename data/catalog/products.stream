    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JTZYS\",\"sku\":\"B07P6JTZYS\",\"lang\":\"en\",\"slug\":\"rivet-sloane-modern-leather-ottoman-with-tapered-legs-31-9-w-caramel-b07p6jtzys\",\"name\":\"Rivet Sloane Modern Leather Ottoman with Tapered Legs, 31.9&quot;W, Caramel\",\"description\":\"This modern ottoman sports a strong profile and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The leather upholstery and solid-wood frame make this piece both cozy and reliable. 31.9&quot;W x 24&quot;D x 17.7&quot;H Solid wood frame and legs; leather upholstery A solid wood frame and leather upholstery make this ottoman as practical as it is stylish. Tapered legs add elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Modern Leather Ottoman with Tapered Legs, 31.9&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815rkIyRNpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nVrqQ1YPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nVrqQ1YPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8Gr3AjVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8Gr3AjVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TIPDWMs9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TIPDWMs9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916AwYZXOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916AwYZXOzL.jpg\"}],\"attributes