    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D48XJ\",\"sku\":\"B07B4D48XJ\",\"lang\":\"en\",\"slug\":\"andover-modern-right-l-sectional-sofa-124-w-cream-b07b4d48xj\",\"name\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Cream\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Lq37DwXCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91E6fpkpHRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91E6fpkpHRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BWS99xpUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BWS99xpUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715mTL2QbdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715mTL2QbdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ag0VzvuVL.jpg\",\"url\":\"https://storage.googleapis.com/p