        "bytes": "{\"id\":\"B07B4MR1MY\",\"sku\":\"B07B4MR1MY\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-82-w-charcoal-b07b4mr1my\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Charcoal\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 82&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Stain-resistant polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TVVGj5ZUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1smD+U9NtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1smD+U9NtS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WZWct-OzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WZWct-OzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YBi8MLhcS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YBi8MLhcS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fba6OQEnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fba6OQEnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EHpHIUWxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EHpHIUWxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"82.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"43.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"22.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Charcoal\",\"label\":\"Charcoal\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":440,\"discountedValue\":396.0}}"
