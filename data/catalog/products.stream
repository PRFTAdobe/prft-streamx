        "bytes": "{\"id\":\"B085FH4N3Y\",\"sku\":\"B085FH4N3Y\",\"lang\":\"en\",\"slug\":\"ravenna-home-classic-swivel-recliner-with-storage-ottoman-35-w-cream-b085fh4n3y\",\"name\":\"Ravenna Home Classic Swivel Recliner with Storage Ottoman, 35&quot;W, Cream\",\"description\":\"Recliner: 35&quot;W x 34.6&quot;D x 37.8&quot;H; seat height: 18.9&quot;H; seat depth: 19.7&quot;D. Ottoman: 22.4&quot;W x 17.7&quot;D x 20.5&quot;H Plywood frame with strong reclining mechanism, round arms, and solid performance seat and backrest cushions Reclining chair with swivel glide, round arms, and extra storage ottoman Assemble in 15 minutes or less Indoor use only; avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Classic Swivel Recliner with Storage Ottoman, 35&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VUico3KzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BEOLELpvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BEOLELpvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gTg7SLQzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gTg7SLQzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NWD-jZ+fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NWD-jZ+fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QJ5VmjtUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QJ5VmjtUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RmdLCw9zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RmdLCw9zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zBJ7Ed9-L.jpg\",\"url\":\"h