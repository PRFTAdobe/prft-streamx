    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072ZKZ33K\",\"sku\":\"B072ZKZ33K\",\"lang\":\"en\",\"slug\":\"rivet-king-street-industrial-floating-storage-coffee-table-walnut-black-metal-glass-b072zkz33k\",\"name\":\"Rivet King Street Industrial Floating Storage Coffee Table, Walnut, Black Metal, Glass\",\"description\":\"This piece is an all-in-one side table with display space and storage. The tempered glass top and bottom and narrow legs give a totally modern feel, while the wooden drawer is a handy place to throw your keys and phone. 47.2&quot;L x 15.7&quot;W x 27.6&quot;H Engineered wood, walnut veneer drawer, metal legs, tempered glass top Modern Industrial Two drawers provide storage space Simple assembly in 15-30 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet King Street Industrial Floating Storage Coffee Table, Walnut, Black Metal, Glass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gSZ8wsQqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zwbHpAtAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zwbHpAtAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14E+5i16EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14E+5i16EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dBJAKEekL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dBJAKEekL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+nJ+ZNvpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+nJ+ZNvpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"27.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\