    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQPJ2\",\"sku\":\"B07QBMQPJ2\",\"lang\":\"en\",\"slug\":\"modern-hardwood-rocking-chair-24-5-w-beige-b07qbmqpj2\",\"name\":\"Modern Hardwood Rocking Chair, 24.5&quot;W, Beige\",\"description\":\"This rocking chair’s solid wood frame and legs create a stable structure, and their natural finish complements beige cushions. Cushions are removable and reversible and feature easy-care upholstery, which will help make this rocker a long-lasting feature in any room that needs seating. 24.5&quot;W x 33.75&quot;D x 31.125&quot;H; seat height: 17.75&quot;H; seat depth: 18.75&quot;W; seat back height: 25.5&quot;H; arm height: 22.75&quot;H; leg height: 11&quot;H Durable fabric on wood frame and solid wood legs with a natural finish The tight, fixed back and removable and reversible cushions ensure durability and comfort. Classic meets contemporary for an ideal transitional-style feel. Assemble in 15-30 minutes Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Hardwood Rocking Chair, 24.5&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IpJqunhYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q0AjHptWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q0AjHptWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nw5jRtSkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nw5jRtSkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wVetJSBbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wVetJSBbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ietcs+4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ietcs+4L.jpg\"},{\"alt\":\"https://storage.googleapi