    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMW6LH\",\"sku\":\"B075YMW6LH\",\"lang\":\"en\",\"slug\":\"glenwood-modern-industrial-metal-base-dining-room-table-78-l-oak-wood-b075ymw6lh\",\"name\":\"Glenwood Modern Industrial Metal Base Dining Room Table, 78&quot;L, Oak Wood\",\"description\":\"This handsome modern table combines an attractive wood top with an industrial-style metal base. Simple, clean lines and beautiful quarter-sawn oak veneer finish make this piece look at home in rustic or modern settings. 78&quot;L x 40&quot;D x 30&quot;H Hardwood table top with quarter-sawn oak veneer and metal base A simple modern piece with rustic and industrial influences Free returns for 30 days. 3-year warranty. Assembly is required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Glenwood Modern Industrial Metal Base Dining Room Table, 78&quot;L, Oak Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-DggqdReL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1kCMoCpBAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1kCMoCpBAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aXw0uhmGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aXw0uhmGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NfkmlEjwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NfkmlEjwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GwwIbSspL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GwwIbSspL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CNqnjzSnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CNqnjzSnL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"in