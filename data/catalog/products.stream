    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MTFQR\",\"sku\":\"B07B4MTFQR\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-38-w-grey-b07b4mtfqr\",\"name\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Grey\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 38&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11i10fuKfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iRsMs6cAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iRsMs6cAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fAf1tabQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fAf1tabQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QgMGaX0tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QgMGaX0tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MeYCCDxRL.jpg\",\"url\":