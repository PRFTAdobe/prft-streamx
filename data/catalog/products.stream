    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L9P6Y\",\"sku\":\"B07B4L9P6Y\",\"lang\":\"en\",\"slug\":\"appleton-farmhouse-leather-recliner-35-w-charcoal-b07b4l9p6y\",\"name\":\"Appleton Farmhouse Leather Recliner, 35&quot;W, Charcoal\",\"description\":\"This is not your dad's old overstuffed recliner. You'll enjoy comfort and coziness along with quality leather and graceful style. With its rolled arms and tufted back, this chair has the modern and classic features to fit a transitional decor. 35&quot;W x 40&quot;D x 41&quot;H; Seat Height: 20&quot;H ; Seat Depth: 21&quot;D; Seat Back Height: 41&quot;H; Arm Height: 24&quot;H; Front legs: 5.625&quot;H; Back legs: 4.75&quot;H Leather upholstery on sturdy pine wood frame Modern and classic come together for a transitional style Push back reclining mechanism; seat cushion can be removed for cleaning No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Appleton Farmhouse Leather Recliner, 35&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+rDNDy7WL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816r0DHAfNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816r0DHAfNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xN952RDWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xN952RDWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kSovO8gQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kSovO8gQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NhiS0oF3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NhiS0oF3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SFX23owuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag