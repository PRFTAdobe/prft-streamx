    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VMC6\",\"sku\":\"B075X4VMC6\",\"lang\":\"en\",\"slug\":\"marin-studded-sofa-87-w-smoky-teal-b075x4vmc6\",\"name\":\"Marin Studded Sofa, 87&quot;W, Smoky Teal\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Sofa, 87&quot;W, Smoky Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91r7EafsqIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mKV77daUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mKV77daUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1R9OAZmQPS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1R9OAZmQPS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XoYCe-weL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XoYCe-weL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j0RDf4SIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j0RDf4SIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label