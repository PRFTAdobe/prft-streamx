    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M68LW\",\"sku\":\"B07B4M68LW\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-beige-b07b4m68lw\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Beige\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 31&quot;W x 23&quot;D x 20&quot;H; Seat Height: 20&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 20&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816P385FjaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OXSDhzPBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OXSDhzPBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lXquUeC6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lXquUeC6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ev9aG7R0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ev9aG7R0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A81936pNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A81936pNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u2Z6jbYyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u2Z6jbYyL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"49.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Beige\",\"label\":\"Beige\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":620,\"discountedValue\":558.0}}"
