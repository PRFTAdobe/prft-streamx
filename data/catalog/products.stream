    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082TC37LY\",\"sku\":\"B082TC37LY\",\"lang\":\"en\",\"slug\":\"rivet-canton-deep-mid-century-modern-loveseat-sofa-couch-76-7-w-dark-grey-b082tc37ly\",\"name\":\"Rivet Canton Deep Mid-Century Modern Loveseat Sofa Couch, 76.7&quot;W, Dark Grey\",\"description\":\"Crafted with postmodern flair, this dark grey loveseat with tapered wooden legs will enliven any modern living space while also providing comfort and durability. Easy to clean and maintain, this is a loveseat for the modern home. 76.8&quot;W x 40.2&quot;D x 34.3&quot;H; seat height: 18.5&quot;; seat depth: 32.3&quot;; seat back height: 20.9&quot;; arm height: 26.37&quot;; leg height: 6.3&quot; Solid wood frame and legs with 100% polyester upholstery The tight, fixed back and removable cushions ensure durability and comfort. This stunning work of craftsmanship takes the very best of modern design and reinvents it for the now. Assemble in 15 minutes or less Avoid moisture and wipe clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Canton Deep Mid-Century Modern Loveseat Sofa Couch, 76.7&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IF+-HU0pL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vwgENnkpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vwgENnkpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hMP3Uct9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hMP3Uct9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81haYuxis9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81haYuxis9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15b-WJaLnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15b-WJ