    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSDNSL9\",\"sku\":\"B07HSDNSL9\",\"lang\":\"en\",\"slug\":\"arced-rustic-king-bed-headboard-with-raised-panels-queen-64-inch-new-whitewash-b07hsdnsl9\",\"name\":\"Arced Rustic King Bed Headboard with Raised Panels - Queen, 64 Inch, New Whitewash\",\"description\":\"This solid-wood headboard is at once striking and welcoming, with a tall, bold arc and a subtle whitewash finish that offers a touch of casual. The ashen wood grain makes this an excellent addition to any bedroom with neutral tones in its design scheme. 64&quot;W x 3&quot;D x 80&quot;H Solid hardwood with a subtle whitewash finish. The headboard has a casual coastal feel but can be used in any neutral bedroom. This headboard will require a mattress and box spring. A bed frame is not included. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Arced Rustic King Bed Headboard with Raised Panels - Queen, 64 Inch, New Whitewash\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X85l2ZsvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MW3VpFzEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MW3VpFzEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fB8dHFJ-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fB8dHFJ-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DGxw7SiQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DGxw7SiQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xYM9SEXqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xYM9SEXqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911fpwNmsVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911fp