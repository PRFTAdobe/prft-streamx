    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8VJG1\",\"sku\":\"B07BW8VJG1\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-loveseat-couch-79-w-dark-grey-tweed-b07bw8vjg1\",\"name\":\"Hoffman Down-Filled Performance Loveseat Couch, 79&quot;W, Dark Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 79&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Loveseat Couch, 79&quot;W, Dark Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11qh6eGnKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JATvPSNFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JATvPSNFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ3Efv24S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ3Efv24S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zViTsWoML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zViTsWoML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wEQPHWuWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wEQPHWuWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oMJzvzebL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oMJzvzebL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A130Cs3CXBL.jpg\",\"url\":