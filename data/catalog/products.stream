    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQD97R\",\"sku\":\"B07QBQD97R\",\"lang\":\"en\",\"slug\":\"merrill-queen-headboard-with-decorative-nailhead-trim-75-w-pewter-b07qbqd97r\",\"name\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Pewter\",\"description\":\"This chic pewter-colored queen-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 75&quot;W x 11&quot;D x 52&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NoQaB9aBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o8923davL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o8923davL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714oZ5jTv5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714oZ5jTv5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91faLGo2SEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91faLGo2SEL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"75.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"65.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Panels\",\"label\":\"Panels\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Cherry\",\"label\":\"Cherry\"},{\"value\":\"Boards\",\"label\":\"Boards\"},{\"value\":\"Platform\",\"label\":\"Platform\"},{\"value\":\"Mattress\",\"label\":\"Mattress\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Modular\",\"label\":\"Modular\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Wingback\",\"label\":\"Wingback\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Xl\",\"label\":\"Xl\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Head\",\"label\":\"Head\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Ajustable\",\"label\":\"Ajustable\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Bookcase\",\"label\":\"Bookcase\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"California\",\"label\":\"California\"},{\"value\":\"Bedframes\",\"label\":\"Bedframes\"},{\"value\":\"Espaldar\",\"label\":\"Espaldar\"},{\"value\":\"Crema\",\"label\":\"Crema\"},{\"value\":\"Cal\",\"label\":\"Cal\"},{\"value\":\"Twin\",\"label\":\"Twin\"},{\"value\":\"Taupe\",\"label\":\"Taupe\"},{\"value\":\"Progressive\",\"label\":\"Progressive\"},{\"value\":\"Storage\",\"label\":\"Storage\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Lafayette\",\"label\":\"Lafayette\"},{\"value\":\"Upholstery\",\"label\":\"Upholstery\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Zinus\",\"label\":\"Zinus\"},{\"value\":\"Linen\",\"label\":\"Linen\"},{\"value\":\"Split\",\"label\":\"Split\"},{\"value\":\"Camas\",\"label\":\"Camas\"},{\"value\":\"Drawer