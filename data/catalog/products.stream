    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082Q97M5B\",\"sku\":\"B082Q97M5B\",\"lang\":\"en\",\"slug\":\"cedar-upholstered-accent-chair-with-nailheads-43-w-midnight-gray-b082q97m5b\",\"name\":\"Cedar Upholstered Accent Chair with Nailheads, 43&quot;W, Midnight Gray\",\"description\":\"This gray upholstered accent chair brings a stylish charm to any room. Durable fabric-covered foam seat cushions provide lasting comfort, and the rustic nailhead trim enhances any decor. This will be your favorite spot to curl up and read a book or enjoy your favorite hot beverage. This item is made to order just for you. Overall: 43&quot;W x 38&quot;D x 30&quot;H; seat height: 19&quot;H; seat depth: 20&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 2.75&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cedar Upholstered Accent Chair with Nailheads, 43&quot;W, Midnight Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D5gCHQLXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tKdhg8meL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tKdhg8meL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81alstQq7OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81alstQq7OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8173rw8lW+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8173rw8lW+L.jpg\"},{\"alt\":\"https://storag