    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4Z7XVD\",\"sku\":\"B07B4Z7XVD\",\"lang\":\"en\",\"slug\":\"prudence-tufted-king-bed-84-w-fresh-dune-b07b4z7xvd\",\"name\":\"Prudence Tufted King Bed, 84&quot;W, Fresh Dune\",\"description\":\"This bed adds classic style to any space. A hand-tufted headboard adds an interesting design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Prudence Tufted King Bed, 84&quot;W, Fresh Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zYM+M825L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wOK9E3jKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wOK9E3jKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k21iU+GpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k21iU+GpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918d-tf4qdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918d-tf4qdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818SyFxIsTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818SyFxIsTL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\"