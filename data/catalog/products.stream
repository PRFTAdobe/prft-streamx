    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MBFDRYD\",\"sku\":\"B07MBFDRYD\",\"lang\":\"en\",\"slug\":\"classic-tufted-dining-chair-set-of-2-23-w-beige-b07mbfdryd\",\"name\":\"Classic Tufted Dining Chair, Set of 2, 23&quot;W, Beige\",\"description\":\"Complete your dining room with these vintage-inspired tufted chairs. The sturdy solid-wood frame features an elastic suspension system that’s designed to keep the seat firm, and the elegant design nicely complements vintage, country and farmhouse-style home decor. Overall: 23&quot;W x 20.75&quot;D x 36&quot;H; seat height: 18.75&quot;H; seat depth: 18&quot;D; seat back height: 19&quot;H Durable fabric on wood frame; solid-wood legs with natural finish Set of 2 vintage-inspired dining or accent chairs with wood frame and beige upholstery Foam padding and elastic suspension system keep the back and seat firm and springy. Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Tufted Dining Chair, Set of 2, 23&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719V0NzOYfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fnak+teHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fnak+teHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZkRnVJ9cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZkRnVJ9cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jWdttB6-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jWdttB6-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M5clMt7aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M5clMt7aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qe2g5NIKL.jpg\",\"url\":\"h