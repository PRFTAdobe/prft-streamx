        "bytes": "{\"id\":\"B07RD7P3CV\",\"sku\":\"B07RD7P3CV\",\"lang\":\"en\",\"slug\":\"solimo-zeus-engineered-wood-bedside-table-wenge-finish-b07rd7p3cv\",\"name\":\"Solimo Zeus Engineered Wood Bedside Table (Wenge Finish)\",\"description\":\"Premium-quality engineered wood bedside table which has undergone more than 15 safety and quality tests Material: European Standard Particle Board Smooth edges for beautiful aesthetics and protection against scrapes and cuts Tested for resistance against humidity, stains and hot water Free from harmful carcinogens like lead, formaldehyde and pentachlorophenol (PCP) Comes with a 3-year warranty on manufacturing defects\",\"primaryImage\":{\"alt\":\"Solimo Zeus Engineered Wood Bedside Table (Wenge Finish)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dx6qSSt3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AH-7OjGRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AH-7OjGRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vWMS1NR4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vWMS1NR4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ccqDQiBML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ccqDQiBML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BSbmHsX2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BSbmHsX2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TOT-jsZ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TOT-jsZ2L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.1417\",\"label\":\"millimeters\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"15.15745\",\"label