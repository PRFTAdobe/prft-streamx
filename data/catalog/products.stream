    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B8KNR\",\"sku\":\"B07B7B8KNR\",\"lang\":\"en\",\"slug\":\"reclaimed-wood-ladder-rung-counter-height-dining-table-bar-36-h-x-44-l-fir-b07b7b8knr\",\"name\":\"Reclaimed Wood Ladder-Rung Counter-Height Dining Table Bar, 36&quot;H x 44&quot;L, Fir\",\"description\":\"Reclaimed fir wood and ladder-rung pedestals give this counter-height table simple rustic beauty. Warm natural wood tones make your space inviting, while sturdy construction will make this piece last for decades. 44&quot;W x 20&quot;D x 36&quot;H Made of hardwood; comprised of 100% reclaimed fir A simple, natural style that will work with modern farmhouse décor Multi-functional as a dining table, bar, desk, or extra counter space No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Reclaimed Wood Ladder-Rung Counter-Height Dining Table Bar, 36&quot;H x 44&quot;L, Fir\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fQ+TfKRKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WL90+c3tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WL90+c3tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51MtQ1jJ2cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51MtQ1jJ2cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iqao7Td5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Iqao7Td5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17SlclywOS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17SlclywOS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vMdvcldZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vMdvcldZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"