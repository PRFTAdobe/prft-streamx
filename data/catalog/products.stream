    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VWS3\",\"sku\":\"B075X4VWS3\",\"lang\":\"en\",\"slug\":\"rivet-modern-oversized-upholstered-square-ottoman-38-w-boho-b075x4vws3\",\"name\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Boho\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Boho\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HtqT-H+TL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1soNOL124L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1soNOL124L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bHcZUCr2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bHcZUCr2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LaF2TkxbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LaF2TkxbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hbhu0BCJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hbhu0BCJL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"len