    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNR85R\",\"sku\":\"B07QDNR85R\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-eclipse-b07qdnr85r\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Eclipse\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft eclipse-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TWgL9IdAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tNLR3IMHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tNLR3IMHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911nKbGkspL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911nKbGkspL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XzSpl8sVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XzSpl8sVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]}