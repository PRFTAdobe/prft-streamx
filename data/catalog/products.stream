    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LKKMW\",\"sku\":\"B07P5LKKMW\",\"lang\":\"en\",\"slug\":\"rivet-sloane-modern-leather-sofa-with-tufted-back-79-9-w-caramel-b07p5lkkmw\",\"name\":\"Rivet Sloane Modern Leather Sofa with Tufted Back, 79.9&quot;W, Caramel\",\"description\":\"This modern sofa sports a tufted back, a strong profile, and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The leather upholstery and solid-wood frame make this piece both cozy and reliable. 79.9&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; leather upholstery A solid wood frame and leather upholstery make this sofa as practical as it is stylish. A tufted back adds elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Modern Leather Sofa with Tufted Back, 79.9&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718tEH1N8gL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U4kkY1xdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U4kkY1xdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bKn3h6hlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bKn3h6hlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Jz43OPWwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Jz43OPWwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914njhRTOdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914njhRTOdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"}],\"attribut