    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5HB8J\",\"sku\":\"B075X5HB8J\",\"lang\":\"en\",\"slug\":\"leila-tufted-velvet-living-room-sofa-couch-88-w-ink-blue-b075x5hb8j\",\"name\":\"Leila Tufted Velvet Living Room Sofa Couch, 88&quot;W, Ink Blue\",\"description\":\"This item is made to order just for you 88&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury with this striking, vintage-look sofa. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Three removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Velvet Living Room Sofa Couch, 88&quot;W, Ink Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ENvOcQWKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VENeeBasL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VENeeBasL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bl6yRtUcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bl6yRtUcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JmTF0TIhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JmTF0TIhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\"