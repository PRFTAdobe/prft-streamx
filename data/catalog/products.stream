    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ782D9\",\"sku\":\"B07HZ782D9\",\"lang\":\"en\",\"slug\":\"blaine-modern-upholstered-living-room-accent-chair-32-3-w-navy-blue-b07hz782d9\",\"name\":\"Blaine Modern Upholstered Living Room Accent Chair, 32.3&quot;W, Navy Blue\",\"description\":\"Add mid-century elegance to your living room with this navy blue living room chair. The solid-wood frame and polyester upholstery make this living room chair both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 32.3&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 22&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H\",\"primaryImage\":{\"alt\":\"Blaine Modern Upholstered Living Room Accent Chair, 32.3&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tzWrqBo4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1THY1Nq2uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1THY1Nq2uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W5CQbvohL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W5CQbvohL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRUAsVrOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRUAsVrOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11d0KosxyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11d0KosxyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origina