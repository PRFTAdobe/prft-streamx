    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M35MF\",\"sku\":\"B07B4M35MF\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-82-w-sand-b07b4m35mf\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Sand\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 82&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Stain-resistant polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-MGRymDwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XUviUSKlS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XUviUSKlS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/C1/C1sCYAz8NAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/C1/C1sCYAz8NAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LdiuFH+eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LdiuFH+eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DujccK8yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DujccK8yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-i