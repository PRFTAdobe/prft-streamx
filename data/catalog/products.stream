    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HYYBHW1\",\"sku\":\"B07HYYBHW1\",\"lang\":\"en\",\"slug\":\"fischer-sleeper-chair-51-w-blue-fabric-b07hyybhw1\",\"name\":\"Fischer Sleeper Chair, 51&quot;W, Blue Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this sleeper chair a perfect blend of style and functionality. The solid hardwood frame keeps this chair sturdy through years of use, and the reversible seat cushions ensure durability and extend this chair’s life. Overall: 51&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and rich color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Sleeper Chair, 51&quot;W, Blue Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NAoUUXvwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1er3tVkKeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1er3tVkKeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aUPiQ8FvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aUPiQ8FvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qg1lZ6MxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qg1lZ6MxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P3NkyltxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P3NkyltxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O