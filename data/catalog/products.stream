    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33RYD\",\"sku\":\"B075X33RYD\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-ottoman-31-w-charcoal-b075x33ryd\",\"name\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Charcoal\",\"description\":\"Sit back, relax, and rest those tired feet on this extra large ottoman. Add a tray on the top to display magazines or place drinks, and also have extra seating for a guest or two. Leather upholstery adds the classic touch. This item is made to order just for you Overall depth: 25&quot;, Seat depth: 25&quot;, Height: 20&quot;, Width: 31&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional ottoman with seating for two Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Ottoman, 31&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wlfV3+XIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAR82+8dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAR82+8dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-L01PMNkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-L01PMNkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dB-zVz4JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dB-zVz4JL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\