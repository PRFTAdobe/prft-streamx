    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78M4DN\",\"sku\":\"B07B78M4DN\",\"lang\":\"en\",\"slug\":\"cottage-wood-bar-stool-24-h-green-b07b78m4dn\",\"name\":\"Cottage Wood Bar Stool, 24&quot;H, Green\",\"description\":\"This simple, classic wooden counter stool is offered in a distressed hunter green finish. It's perfect for adding seating to a rustic or modern farmhouse kitchen, and easy to move around when you need more seating in another room. 18&quot;W x 9.5&quot;D x 24&quot;H; Seat Height: 24&quot;H Sturdy hardwoods Ideal for rustic and modern farmhouse spaces Easy to care for -- just wipe with damp cloth Assembly in 15-30 minutes Doesn't say what you need to do Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Cottage Wood Bar Stool, 24&quot;H, Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717oJybLo5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717XmQ9butL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717XmQ9butL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hvTq8nBkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hvTq8nBkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GMYVg3TJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GMYVg3TJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819QMOcHrSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819QMOcHrSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sPOmEkhJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sPOmEkhJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kazq3E+pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kazq3E+pL.jpg\