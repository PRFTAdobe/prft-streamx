    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL48NK\",\"sku\":\"B07QDL48NK\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-sofa-with-tapered-wood-legs-76-w-felt-grey-b07qdl48nk\",\"name\":\"Rivet Isabelle Mid-Century Modern Sofa with Tapered Wood Legs, 76&quot;W, Felt Grey\",\"description\":\"This sofa’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its felt-gray upholstery ensures that it will match the color scheme of any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 76&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Sofa with Tapered Wood Legs, 76&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NXgtGv2ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pc+UcV8rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pc+UcV8rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FAsDg3+TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FAsDg3+TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ozSgQQXhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ozSgQQXhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AW22vu2SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AW22vu2SL.jpg\"},{\"alt\":\"htt