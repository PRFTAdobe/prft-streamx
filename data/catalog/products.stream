    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWLJR4Q\",\"sku\":\"B07BWLJR4Q\",\"lang\":\"en\",\"slug\":\"andover-modern-right-u-sectional-sofa-134-w-charcoal-b07bwljr4q\",\"name\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Charcoal\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wood legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HZkY1L55L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HiyeTY-5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HiyeTY-5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1blkf76ZqS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1blkf76ZqS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gxG51thbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gxG51thbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bq58uur1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bq58uur1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M8JbVSH7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M8JbVSH7L.jpg\"},{\"alt\":\"https://storage.googleapi