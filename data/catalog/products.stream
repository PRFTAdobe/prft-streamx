    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085559VGM\",\"sku\":\"B085559VGM\",\"lang\":\"en\",\"slug\":\"rivet-alva-modern-curved-back-plastic-dining-chair-23-2-w-nude-pink-b085559vgm\",\"name\":\"Rivet Alva Modern Curved-Back Plastic Dining Chair, 23.2&quot;W, Nude Pink\",\"description\":\"This modern chair with a sleek European design is stylish but flexible enough to go with many types of dining room tables or even be used in other rooms. Made of sturdy beech, steel, and plastic, it will last and adapt to any changes in the surrounding furniture. 23.23&quot;W x 19.9&quot;D x 30.7&quot;H; seat height: 18.11&quot;H; seat depth: 15.5&quot;D; seat back height: 15&quot;H; arm height: 27.5–30.7&quot;H; leg height: 17.3&quot;H Polypropylene, steel, beech This versatile, durable chair can be used alone or as part of a dining room set. An original piece by an Italian designer that complements many different table styles Avoid moisture. Clean with a damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alva Modern Curved-Back Plastic Dining Chair, 23.2&quot;W, Nude Pink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61qMUSl0-qL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61i1InOyPZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61i1InOyPZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rJUO92SNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rJUO92SNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GQ-NF--4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GQ-NF--4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51obiOuqUJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51obiOuqUJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pur