      "content": {
        "bytes": "{\"id\":\"B075QBL1V8\",\"sku\":\"B075QBL1V8\",\"lang\":\"en\",\"slug\":\"clifton-modern-upholstered-king-bed-with-headboard-84-25-w-cream-b075qbl1v8\",\"name\":\"Clifton Modern Upholstered King Bed with Headboard, 84.25&quot;W, Cream\",\"description\":\"Clean, modern lines combined with classic fabric upholstery allow this lovely piece to work with any style bedroom. A low-profile headboard and footboard help it blend with smaller rooms. Side rails are upholstered in the same pleasing neutral color. 89.75&quot;L x 84.25&quot;W x 57.9&quot;H Hardwood frame coverd by polyester fabric Modern design with classic fabric upholstery helps it blend with most styles No boxspring required; mattress sold separately Minor assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Clifton Modern Upholstered King Bed with Headboard, 84.25&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817PiskMTRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12g9tJa6cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12g9tJa6cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CUQIdfnOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CUQIdfnOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M0sAZ7xyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M0sAZ7xyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912u5iaZkRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912u5iaZkRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"