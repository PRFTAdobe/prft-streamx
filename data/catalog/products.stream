    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X342PB\",\"sku\":\"B075X342PB\",\"lang\":\"en\",\"slug\":\"rivet-modern-oversized-upholstered-square-ottoman-38-w-russet-b075x342pb\",\"name\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Russet\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Russet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9126Itu+2iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Gr6IIVkvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Gr6IIVkvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x1ob9w7pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x1ob9w7pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1THpdBILhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1THpdBILhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Y4OgCYmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Y4OgCYmL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\"