    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK58DV\",\"sku\":\"B07BWK58DV\",\"lang\":\"en\",\"slug\":\"andover-modern-left-chaise-sofa-sectional-126-w-charcoal-b07bwk58dv\",\"name\":\"Andover Modern Left Chaise Sofa Sectional, 126&quot;W, Charcoal\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 126&quot;W x 61&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wood legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left Chaise Sofa Sectional, 126&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+32oPoJQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vNm3AYD7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vNm3AYD7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K8yt-4L-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K8yt-4L-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bq58uur1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bq58uur1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fVaDfq-qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fVaDfq-qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16i00twNSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16i00twNSS.jpg\"}],\"attributes\":[{\"name