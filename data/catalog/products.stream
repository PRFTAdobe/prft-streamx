    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWM2CSV\",\"sku\":\"B07BWM2CSV\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-left-facing-sofa-chaise-sectional-leather-115-w-saddle-b07bwm2csv\",\"name\":\"Rivet Edgewest Modern Left-Facing Sofa Chaise Sectional, Leather, 115&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 115&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H; Chaise Depth: 46&quot;D; Chaise Width: 33&quot;W Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; choose the configuration thats right for you Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Left-Facing Sofa Chaise Sectional, Leather, 115&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B0DSf+1UL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aXXbzRk7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aXXbzRk7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F08KpkwUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F08KpkwUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+--ODfnDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+--ODfnDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nQUzmj3XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nQUzmj3XL.jpg\"},{\"alt\":\"http