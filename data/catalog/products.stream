    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HYYBHWJ\",\"sku\":\"B07HYYBHWJ\",\"lang\":\"en\",\"slug\":\"fischer-queen-sized-sleeper-sofa-79-w-dove-fabric-b07hyybhwj\",\"name\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Dove Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this queen-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 79&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and neutral color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Dove Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HCvi+efrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m3Pz5-oYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m3Pz5-oYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JRjM1nVpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JRjM1nVpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-Epl7-GbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-Epl7-GbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gdqgN2azL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gdqgN2azL.jpg\"},{\"alt\":\"https://storage.google