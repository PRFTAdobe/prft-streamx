        "bytes": "{\"id\":\"B0764W75LL\",\"sku\":\"B0764W75LL\",\"lang\":\"en\",\"slug\":\"faux-linen-upholstered-tufted-headboard-queen-grey-b0764w75ll\",\"name\":\"Faux Linen Upholstered Tufted Headboard - Queen, Grey\",\"description\":\"Upholstered headboard brings elegant style and added comfort to any queen-size bed Metal frame; soft 100% polyester faux-linen upholstery in Gray Tufted design creates impression of orderly squares for a sleek modern appearance Adjustable height; wipes clean with a damp cloth; weighs 22 pounds Measures 3.5 inches deep by 61.5 inches wide by 45.5 to 53 inches high (floor to top of headboard); backed by an AmazonBasics limited 1-year warranty\",\"primaryImage\":{\"alt\":\"Faux Linen Upholstered Tufted Headboard - Queen, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JW-EesbKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EdgzPq5cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EdgzPq5cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BR5rHwIHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BR5rHwIHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QSQfSPc6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QSQfSPc6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"3.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"61.8\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"19.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Basic\",\"label\":\"Basic\"},{\"value\":\"Company\",\"label\":\"Company\"},{\"value\":\"