  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK59QP\",\"sku\":\"B07BWK59QP\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-sofa-with-reversible-sectional-chaise-80-w-storm-grey-b07bwk59qp\",\"name\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Storm Grey\",\"description\":\"This modern sectional sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. Hardwood frame, solid beech wood legs and durable polyester upholstery stand up to wear and tear The chaise can be moved to either end to accommodate your room layout -- and it provides an extra seat for company. Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty. Sofa only: 79.9&quot;W x 34.6&quot;D x 35.4&quot;H Sofa and ottoman: 79.9&quot;W x 62.2&quot;D x 35.4&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Storm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NIhZ31GOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81szD0NZ9zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81szD0NZ9zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dGwoiZoXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dGwoiZoXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x7+1qSOsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x7+1qSOsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YZH0qDp4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YZH0qDp4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OsFHaFIiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OsFHaFIiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71J8T16myxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71J8T16myxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AerANom3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AerANom3L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"79.9\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"62.2\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"54.5\",\"label\":\"kilograms\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Hide\",\"label\":\"Hide\"},{\"value\":\"A\",\"label\":\"A\"},{\"value\":\"Facing\",\"label\":\"Facing\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Pull\",\"label\":\"Pull\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Size\",\"label\":\"Size\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"L\",\"label\":\"L\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Belinda\",\"label\":\"Belinda\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Poundex\",\"label\":\"Poundex\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Smith\",\"label\":\"Smith\"},{\"value\":\"Mid\",\"