    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5T677\",\"sku\":\"B075X5T677\",\"lang\":\"en\",\"slug\":\"rivet-modern-oversized-upholstered-square-ottoman-38-w-charcoal-b075x5t677\",\"name\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Charcoal\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12lKu90AfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dXH5bPQ5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dXH5bPQ5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IKEPN--wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IKEPN--wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919ETsaubTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919ETsaubTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0wo4L9aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+0wo4L9aL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"