        "bytes": "{\"id\":\"B07HSJSH7G\",\"sku\":\"B07HSJSH7G\",\"lang\":\"en\",\"slug\":\"industrial-rolling-bar-cart-20-67-w-natural-and-black-b07hsjsh7g\",\"name\":\"Industrial Rolling Bar Cart, 20.67&quot;W, Natural and Black\",\"description\":\"Stark black iron contrasts with the delicate wood grain of the natural rubberwood shelves to bring a contemporary flair to this beautiful serving cart. The lipped design of the shelves helps keep your belongings safe, and the locking casters allow for increased control and mobility. Rubberwood, Iron Lipped trays help secure your belongings and locking casters are useful for securing the cart. Simple assembly in 15-30 minutes 12.2”D x 20.67”W x 42.52”H Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Industrial Rolling Bar Cart, 20.67&quot;W, Natural and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NIjV+qy1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pEn6T2VSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pEn6T2VSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719hqR0HhLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719hqR0HhLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xu15EJvOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xu15EJvOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OG8XaEu2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OG8XaEu2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k399kVkQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k399kVkQL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.55\",\"label\":\"inches\"}]},{\"name