    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK42J3\",\"sku\":\"B07BWK42J3\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-l-sectional-116-w-hunter-green-b07bwk42j3\",\"name\":\"Rivet Edgewest Low Back Modern Right L-Sectional, 116&quot;W, Hunter Green\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right L-Sectional, 116&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wFQLIv6ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719ah4s7ENL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719ah4s7ENL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18sMhgUGxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18sMhgUGxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918i9xjZrjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918i9xjZrjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QtYNP6BqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QtYNP6BqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"}],\"