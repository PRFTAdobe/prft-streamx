    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086TFXK75\",\"sku\":\"B086TFXK75\",\"lang\":\"en\",\"slug\":\"metal-bed-with-modern-industrial-design-headboard-14-inch-height-for-under-bed-storage-wood-slats-easy-assemble-twin-b086tfxk75\",\"name\":\"Metal Bed with Modern Industrial Design Headboard - 14 Inch Height for Under-Bed Storage - Wood Slats - Easy Assemble, Twin\",\"description\":\"Contemporary style: Twin-size metal bed frame with modern headboard combines strength and sleek style for ultimate sleeping comfort; note: mattress not included; no box spring needed Durable noise-free design: steel frame with 10 wood slats provides reliable support; non-slip tape on slats to keep mattress in place; plastic feet for floor protection; foam-padded tape and non-loosening screws prevent the metal frame from making noise Adjustable-height headboard: easily raise or lower the headboard, using the intuitive hook-and-loop configuration, to accommodate different size mattresses and different user heights Under-bed storage space: with a vertical clearance of 12 inches (from the floor to the bottom of the rail), the bed frame provides convenient out-of-the-way storage space Weight capacity, easy assembly, and warranty: bed frame holds up to 300 pounds of combined weight (not including a mattress); assembles easily in a matter of minutes; screw kit and instructions included; backed by an AmazonBasics 5-year limited warranty\",\"primaryImage\":{\"alt\":\"Metal Bed with Modern Industrial Design Headboard - 14 Inch Height for Under-Bed Storage - Wood Slats - Easy Assemble, Twin\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715aWbUUsNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712Mm9NpQsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712Mm9NpQsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nZWZNXflL.jpg\",\"url\":\"https://storage.googleapis.c