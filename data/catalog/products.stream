        "bytes": "{\"id\":\"B07HZ7SN4B\",\"sku\":\"B07HZ7SN4B\",\"lang\":\"en\",\"slug\":\"kristin-living-room-chair-44-w-navy-b07hz7sn4b\",\"name\":\"Kristin Living-Room Chair, 44&quot;W, Navy\",\"description\":\"Add style and comfort to your home with this classic living-room chair. With a time-tested traditional design, this chair is an ideal accent for many home-decor styles, and its beautiful indigo hue brightens the room with color. Its cushions are reversible to extend this chair’s life. Overall: 44&quot;W x 37&quot;D x 37.5&quot;H; Seat Height: 21.5&quot;H; Seat Depth 24&quot;D; Seat Back Height: 30&quot;H; Arm Height: 32&quot;H; Leg Height: 2.5&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Traditional design is both fashionable and practical. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Kristin Living-Room Chair, 44&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q5kDJeyVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0l+UqJKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0l+UqJKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g1UsLjN7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g1UsLjN7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BG402VjjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BG402VjjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vrk4suorL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vrk4suorL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"46.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"71.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Prime\",\"label\":\"Prime\"},{\"value\":\"Hugger\",\"label\":\"Hugger\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Recline\",\"label\":\"Recline\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Motor\",\"label\":\"Motor\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Armless\",\"label\":\"Armless\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Holders\",\"label\":\"Holders\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Perfect\",\"label\":\"Perfect\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Heat\",\"label\":\"Heat\"},{\"value\":\"Sleep\",\"label\":\"Sleep\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Yellow\",\"label\":\"Yellow\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Signature\",\"label\":\"Signature\"},{\"value\":\"Lazyboy\",\"label\":\"Lazyboy\"},{\"value\":\"By\",\"label\":\"By\"},{\"