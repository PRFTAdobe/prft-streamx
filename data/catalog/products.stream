    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L1BMK\",\"sku\":\"B0853L1BMK\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-barstool-42-1-h-graphite-b0853l1bmk\",\"name\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Graphite\",\"description\":\"Powerful in its simplicity, this barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 42.1&quot;H; seat height: 29.9&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H Solid wood frame with 100% polyester fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AkzeTdBCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jeea9xaJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jeea9xaJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lRtNkOzQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lRtNkOzQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TOiX4REXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TOiX4REXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SLcPU4beL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SLcPU4beL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V6nGXhwML.jpg\",\"url\":\"https://storage.googleapis.com/pures