    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MQD2113\",\"sku\":\"B07MQD2113\",\"lang\":\"en\",\"slug\":\"ravenna-home-modern-dining-chair-37-6-inch-height-charcoal-gray-b07mqd2113\",\"name\":\"Ravenna Home Modern Dining Chair, 37.6 Inch Height, Charcoal Gray\",\"description\":\"Overall: 24.20&quot;W x 19.5&quot;D x 37.6&quot;H; seat height: 18.5&quot;H; seat depth: 21&quot;D; seat back height: 19&quot;H Dining chair framed in wood and manufactured wood; cushioned with high-density foam for comfort An arching back silhouette, plush upholstery, and beautiful nailhead trim along the back and bottom edges make this modern dining chair both convenient accent seating and a stunning decor accent. Brown-finished solid-wood legs balance the design and offer lasting durability. Soft, woven fabric upholstery is 100% polyester for easy cleaning and maintenance. Assemble in 15-30 minutes Use water-based cleaning agents or foam. Never use tap water. Use distilled water, as tap water contains minerals that may cause rings or fading.\",\"primaryImage\":{\"alt\":\"Ravenna Home Modern Dining Chair, 37.6 Inch Height, Charcoal Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+w9M27BQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Cy5y8CmdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Cy5y8CmdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919icvtboaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919icvtboaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IpFZSsljL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IpFZSsljL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1e+dscdWHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1e+dscdWHS.jpg\"},{\"alt\":\"https://storage.googl