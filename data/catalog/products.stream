    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSCRG8T\",\"sku\":\"B07HSCRG8T\",\"lang\":\"en\",\"slug\":\"industrial-round-end-pedestal-table-16-14-w-gunmetal-b07hscrg8t\",\"name\":\"Industrial Round End Pedestal Table, 16.14&quot;W, Gunmetal\",\"description\":\"Thrill your home décor with this unique industrial-style accent table. Made from solid steel, this table is highly durable, and its clean gunmetal finish complements the colors in any room. The raised tabletop edge keeps items from falling off, and the 3 metal legs keep the table sturdy. 16.14&quot;W x 16.14&quot;D x 24&quot;H This accent table is made of steel and metal and finished in dark gunmetal tone. A classic design that can be used chairside to hold your favorite book or cocktail. The metal gallery edge prevents items from easily falling off. The table arrives fully assembled. No assembly required Care: Clean as required with a soft, damp cloth; wipe completely dry. Avoid placing furniture near heat vents or open windows. Long periods of heat or excessive dampness can cause splitting, warping, and swelling in solid wood. Protect fine furniture finishes from hot dishes, alcohol, and excessive moisture or dampness. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Round End Pedestal Table, 16.14&quot;W, Gunmetal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71A598i27WL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MUVDkjvGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MUVDkjvGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b3a+V5xXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b3a+V5xXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UDZ1qEhuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UDZ1qEhuL.jpg\"},{\"alt\":\"https:/