    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082BL4G1J\",\"sku\":\"B082BL4G1J\",\"lang\":\"en\",\"slug\":\"rivet-bertha-mid-century-velvet-upholstered-swivel-office-chair-25-25-w-olive-green-with-gold-finish-b082bl4g1j\",\"name\":\"Rivet Bertha Mid-Century Velvet-Upholstered Swivel Office Chair, 25.25&quot;W, Olive Green with Gold Finish\",\"description\":\"This olive-green velvet chair has an unusual, squared-off silhouette that will add a stylish mid-century flair to any workplace or home office. Its adjustable height, casters, and smooth swivel mechanism make it as flexible as it is attractive. 25.25&quot;W x 25&quot;D x 32.75&quot;–35.75&quot;H; seat height: 19.75&quot;–22.75&quot; Generously padded cushions are upholstered in a soft olive-green velvet that adds a touch of luxury to a workday necessity. This chair has a 360-degree swivel mechanism with height and tension adjustments to accommodate your work style. Mid-century modern design meets all-day comfort in this stylish office chair. Assemble in 15-30 minutes Always use on firm, level ground. Do not stand on the seat or let children play with this chair. Check (and if necessary, tighten) all screws every 90 days. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Bertha Mid-Century Velvet-Upholstered Swivel Office Chair, 25.25&quot;W, Olive Green with Gold Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VHQwEYbIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uSNSvFdnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uSNSvFdnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919XBP7-MoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919XBP7-MoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81279QWa+pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina