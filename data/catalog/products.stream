    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZPGXL\",\"sku\":\"B07B4ZPGXL\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-king-headboard-88-w-cream-herringbone-b07b4zpgxl\",\"name\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Cream Herringbone\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 88&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Cream Herringbone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BIqCM9rkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lU8t7YLnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lU8t7YLnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B-AUeEBuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B-AUeEBuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Je+F9CVpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Je+F9CVpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918QwRd1IDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918QwRd1IDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cnzC3q6sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91