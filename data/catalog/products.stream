    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WN11\",\"sku\":\"B075X2WN11\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-leather-bench-seat-sofa-without-side-pillows-86-6-w-cognac-b075x2wn11\",\"name\":\"Rivet Aiden Tufted Mid-Century Leather Bench Seat Sofa, Without Side Pillows, 86.6&quot;W, Cognac\",\"description\":\"This sleek, Mid-century inspired leather sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 86.6&quot;W x 36.2”D x 30.3”H Soft top-grain leather; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Leather Bench Seat Sofa, Without Side Pillows, 86.6&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ca86zAKBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H11UUemRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H11UUemRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qjDBLelBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qjDBLelBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R0d-Y9XpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R0d-Y9XpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q2Ivo4ftL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q2Ivo4ftL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pures