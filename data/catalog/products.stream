        "bytes": "{\"id\":\"B075YV7SKC\",\"sku\":\"B075YV7SKC\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-round-wood-dining-table-42-w-chestnut-b075yv7skc\",\"name\":\"Rivet Mid-Century Round Wood Dining Table, 42&quot;W, Chestnut\",\"description\":\"Beautiful in its simplicity and clean lines, this dining table is Mid-century minimalist design at its best. With a simple 42&quot; round top, it can easily fit in small kitchens while providing ample tabletop space. 42&quot;Diameter x 30&quot;H Natural color variations in wood create unique and beautiful pieces Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Simple round dining table with a warm chestnut finish\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Round Wood Dining Table, 42&quot;W, Chestnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JGjYvSKDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81scB2osMtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81scB2osMtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U2boGcX5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U2boGcX5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VqjIJhQ+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VqjIJhQ+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kapPg4QAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kapPg4QAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BLpaCbyhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BLpaCbyhL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Widt