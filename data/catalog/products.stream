    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8D37\",\"sku\":\"B0723H8D37\",\"lang\":\"en\",\"slug\":\"highland-modern-living-room-wingback-accent-chair-32-w-denim-b0723h8d37\",\"name\":\"Highland Modern Living Room Wingback Accent Chair, 32&quot;W, Denim\",\"description\":\"Bridging classic and contemporary, this accent chair is a modern twist on the timeless wingback chair. The clean, updated style with thick-woven fabric brings welcoming comfort to your seating area. 31.9&quot;W x 37.8&quot;D x 42&quot;H Sustainably sourced solid beech wood covered in thick-woven fabric Contemporary Updated design on a classic piece blends well with existing décor. Minimal assembly; just attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Highland Modern Living Room Wingback Accent Chair, 32&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wMzgVT2XL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+plAL1glS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+plAL1glS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818gXraBasL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818gXraBasL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1jciOiCUgS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1jciOiCUgS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Maeboo9eS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Maeboo9eS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zckXyyqSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zckXyyqSL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"l