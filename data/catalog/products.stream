    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LLX4R\",\"sku\":\"B07P5LLX4R\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-loveseat-with-hardwood-frame-74-w-pearl-b07p5llx4r\",\"name\":\"Lauren Down-Filled Oversized Loveseat with Hardwood Frame, 74&quot;W, Pearl\",\"description\":\"Dimensions: 74&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this loveseat offers plush support and security. Neutral pearl-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Loveseat with Hardwood Frame, 74&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Y5tZVYDxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PXUqZNTWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PXUqZNTWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715JCyajG7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715JCyajG7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AWYpKO7GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AWYpKO7GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wfQlRbzTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wfQlRbzTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16e6wUkPrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16e6wUkPrL.jpg\"