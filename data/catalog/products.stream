    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK58CN\",\"sku\":\"B07BWK58CN\",\"lang\":\"en\",\"slug\":\"andover-leather-left-facing-l-shaped-sectional-124-w-charcoal-b07bwk58cn\",\"name\":\"Andover Leather Left-Facing L-Shaped Sectional, 124&quot;W, Charcoal\",\"description\":\"Complete your living space with this stylish sectional. With its charcoal-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 124&quot;W x 96&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Left-Facing L-Shaped Sectional, 124&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71saL1ieBiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713AsVloPYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713AsVloPYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sX5Pe42UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sX5Pe42UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B137ulErL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B137ulErL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61wGl3tLyUL.jpg\",\"url\":\"https://storage.googleapis.com/pu