    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7J8CGH\",\"sku\":\"B07B7J8CGH\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-honeycomb-square-end-side-nesting-tables-wood-and-bronze-b07b7j8cgh\",\"name\":\"Rivet Mid-Century Modern Honeycomb Square End/Side/Nesting Tables, Wood and Bronze\",\"description\":\"Simple and practical, these two square nesting tables provide maximum function for small spaces. Use separately for extra table space or nest inside one another. The bronze metal frame complements the maple finish, giving a warm yet modern look. Large: 19.87x19.87x21.62; Small 18x18x18.62 Maple honeycomb wood top, metal base with powder-coated bronze finish Mid-century modern minimalist style A narrow, compact design ideal for small spaces and versatile uses No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Honeycomb Square End/Side/Nesting Tables, Wood and Bronze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fTUez+DLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Qmh1w1OaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Qmh1w1OaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91euiChmMyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91euiChmMyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7126CqsXY7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7126CqsXY7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VNpu6uZ0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VNpu6uZ0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718RupgpnHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718RupgpnHL.jpg\"},{\"alt\":\"https://sto