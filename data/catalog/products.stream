    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X543TW\",\"sku\":\"B075X543TW\",\"lang\":\"en\",\"slug\":\"leila-velvet-ottoman-34-w-blue-b075x543tw\",\"name\":\"Leila Velvet Ottoman, 34&quot;W, Blue\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with 100% polyester upholstery. Firm nylon webbing gives cushion resilience. This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and plush velvet upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Velvet Ottoman, 34&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oXIL6P58L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91balib6DJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91balib6DJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9141W2mFLxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9141W2mFLxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qlm1vxdyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qlm1vxdyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cq2oElHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cq2oElHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":