    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YXRLF\",\"sku\":\"B07B4YXRLF\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-queen-headboard-71-w-spinnsol-indigo-b07b4yxrlf\",\"name\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Spinnsol Indigo\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 71&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Spinnsol Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817RF3bScSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ukm-bROlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ukm-bROlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tug-Ivm2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tug-Ivm2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xARVFpaOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xARVFpaOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9193X7pnDBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9193X7pnDBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KqGWQwy0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KqG