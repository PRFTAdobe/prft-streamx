    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075ZCLPS1\",\"sku\":\"B075ZCLPS1\",\"lang\":\"en\",\"slug\":\"roland-metal-x-frame-console-hallway-table-24-w-pine-b075zclps1\",\"name\":\"Roland Metal X-Frame Console Hallway Table, 24&quot; W, Pine\",\"description\":\"48&quot;L x 16&quot;W x 30&quot;H Solid pine top with metal frame Industrial, rustic and modern touches come together in a piece that blends with most décor This sturdy piece will last through years handy use by your family Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. This wood and metal console table combines elements of industrial and rustic, allowing it to blend with many styles. The solid pine wood top has a natural distressed finish, while the metal base has modern &quot;x&quot; frames on three sides of this table.\",\"primaryImage\":{\"alt\":\"Roland Metal X-Frame Console Hallway Table, 24&quot; W, Pine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eDaI7zZJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hRf80O4yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hRf80O4yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11rg6QP-VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11rg6QP-VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916Yis7XzgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916Yis7XzgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tdPu1C8tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tdPu1C8tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wx9rJrKmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wx9rJrKmL.jpg\"},{\"alt\":\"https://storage.googleapis.co