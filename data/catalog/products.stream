    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3V5\",\"sku\":\"B075X4F3V5\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-velvet-tufted-customizable-daybed-sofa-78-w-berry-amp-black-b075x4f3v5\",\"name\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Berry &amp; Black\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and blackened pewter metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Berry &amp; Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qGhXfnA5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1+C4r3jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1+C4r3jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AY49uRwsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AY49uRwsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ANJfqNcxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ANJfqNcxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91izEsf5yOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91izEsf5yOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NE+To79PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-