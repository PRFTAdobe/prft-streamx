    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33SBS\",\"sku\":\"B075X33SBS\",\"lang\":\"en\",\"slug\":\"westport-modern-nailhead-upholstered-accent-arm-chair-36-w-neutral-b075x33sbs\",\"name\":\"Westport Modern Nailhead Upholstered Accent Arm Chair, 36&quot;W, Neutral\",\"description\":\"Elevate your style with this head-turning modern sofa. A long down-blend bench seat is combined with back cushions that are reversible. Nailhead trim on the arms and across the sides, along with the exposed wood base, adds extra sophistication. 87&quot;W x 37.75''D x33''H Durable polyester fabric; metal nailhead trim; wood legs. Removable, reversible back cushions. Corner clips keep bench seat firmly in place. No assembly required. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Westport Modern Nailhead Upholstered Accent Arm Chair, 36&quot;W, Neutral\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iw9DDmqwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wcv397EvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wcv397EvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rvPY1IDBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rvPY1IDBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IrWkdjq+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IrWkdjq+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CSfprMOuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CSfprMOuL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",