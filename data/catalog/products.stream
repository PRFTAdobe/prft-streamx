    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQCG6J\",\"sku\":\"B07QBQCG6J\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-curved-back-armless-dining-chair-35-h-felt-gray-set-of-2-b07qbqcg6j\",\"name\":\"Rivet Contemporary Curved-Back Armless Dining Chair, 35&quot;H, Felt Gray, Set of 2\",\"description\":\"A curved back and sturdy solid wood frame provide support in this modern armless chair. Felt-gray upholstery provides a complement to most any dining area color scheme, allowing these chairs to enhance any space they are in, and durable fabric construction upkeep for this chair is simple. 20&quot;W x 24&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 17&quot;D; seat back height: 15&quot;H Set of 2 100% polyester fabric on solid wood frame Contemporary design with curved back Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Curved-Back Armless Dining Chair, 35&quot;H, Felt Gray, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y+f8p5JLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VHa-6FSfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VHa-6FSfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zszWZXCkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zszWZXCkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81COa3DxrhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81COa3DxrhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+xbfFMXEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+xbfFMXEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage.googleapis.co