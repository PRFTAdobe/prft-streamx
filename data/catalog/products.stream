    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCSFK7\",\"sku\":\"B082QCSFK7\",\"lang\":\"en\",\"slug\":\"rivet-bigelow-modern-upholstered-chair-with-square-legs-44-1-w-light-grey-b082qcsfk7\",\"name\":\"Rivet Bigelow Modern Upholstered Chair with Square Legs, 44.1&quot;W, Light Grey\",\"description\":\"Add extra seating with a modern flair anywhere in your home with this chair. The light-gray upholstery and classic design will blend with any decor scheme. A sloped back cushion padded with foam provides support and comfort. Square legs and a frame of solid wood create a strong foundation. 44.1&quot;W x 37.4&quot;D x 30.7&quot;H; seat height: 18.1&quot;H; seat depth: 22.8&quot;D; seat back height: 18.1&quot;H; arm height: 24&quot;H; leg height: 5.9&quot;H Solid wood frame, plinth, and tapered legs A sturdy, solid wood frame and soft, foam-padded cushions bring a mix of comfort and support to any seating area. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bigelow Modern Upholstered Chair with Square Legs, 44.1&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vv6n94yeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BfjAOxR1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BfjAOxR1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Fwvp9gMPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Fwvp9gMPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RorF29KJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RorF29KJL.jpg\"},{\"alt\