    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LN16X\",\"sku\":\"B07P5LN16X\",\"lang\":\"en\",\"slug\":\"rivet-sloane-modern-leather-loveseat-with-tufted-back-64-2-w-caramel-b07p5ln16x\",\"name\":\"Rivet Sloane Modern Leather Loveseat with Tufted Back, 64.2&quot;W, Caramel\",\"description\":\"This modern loveseat sports a tufted back, a strong profile, and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The leather upholstery and solid-wood frame make this piece both cozy and reliable. 64.2&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; leather upholstery A solid wood frame and leather upholstery make this loveseat as practical as it is stylish. A tufted back adds elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Modern Leather Loveseat with Tufted Back, 64.2&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SiSSChdOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QIUxF-Z-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QIUxF-Z-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ql7S5j6kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ql7S5j6kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x-IgrwloL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x-IgrwloL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bCewjVj3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bCewjVj3