    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC5GS8J\",\"sku\":\"B07PC5GS8J\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-sofa-with-reversible-sectional-chaise-80-w-heritage-green-b07pc5gs8j\",\"name\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Heritage Green\",\"description\":\"This modern sectional sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. Hardwood frame, solid beech wood legs and durable polyester upholstery stand up to wear and tear The chaise can be moved to either end to accommodate your room layout -- and it provides an extra seat for company. Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty. Sofa only: 79.9&quot;W x 34.6&quot;D x 35.4&quot;H Sofa and ottoman: 79.9&quot;W x 62.2&quot;D x 35.4&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Sofa with Reversible Sectional Chaise, 80&quot;W, Heritage Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y+NBcIpkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZB3jEHBUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZB3jEHBUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FOuSiaeIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FOuSiaeIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mYMSLIaWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mYMSLIaWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+yiHJ6SeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+yiHJ6SeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/p