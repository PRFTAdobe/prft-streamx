    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHYDDLP\",\"sku\":\"B07QHYDDLP\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-channel-backed-loveseat-sofa-61-w-felt-grey-b07qhyddlp\",\"name\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat Sofa, 61&quot;W, Felt Grey\",\"description\":\"A channeled back brings elegance to this mid-century sofa with tapered wood legs. The solid hardwood frame combines with the durable upholstery, decreasing the wear and tear that comes with daily life and helping to keep this sofa looking like new. 61&quot;W x 38&quot;D x 32&quot;H Solid hardwood frame, 100% polyester fabric, bench seat cushion with high-density foam, tapered wood legs, brass metal cap Removable and reversible seat cushion A solid hardwood frame with high-density foam adds durability to this channel-backed mid-century sofa. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat Sofa, 61&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817CK2Awr+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CczVPW2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CczVPW2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mQ7UA5gcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mQ7UA5gcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81neaOaszSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81neaOaszSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jv5lcD67L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jv5lcD67L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/