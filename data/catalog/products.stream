    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWM38F\",\"sku\":\"B07QGWM38F\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-curved-back-armless-dining-chair-35-h-aqua-set-of-2-b07qgwm38f\",\"name\":\"Rivet Contemporary Curved-Back Armless Dining Chair, 35&quot;H, Aqua, Set of 2\",\"description\":\"A curved back and sturdy solid wood frame provide support in this modern armless chair. Aqua upholstery provides a pop of color in most any dining area color scheme, allowing these chairs to enhance any space they are in, and durable fabric construction upkeep for this chair is simple. 20&quot;W x 24&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 17&quot;D; seat back height: 15&quot;H Set of 2 100% polyester fabric on solid wood frame Contemporary design with curved back Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Curved-Back Armless Dining Chair, 35&quot;H, Aqua, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RyoxnNenL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15AGcXRZpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15AGcXRZpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WiQJVOAeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WiQJVOAeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SrVKY4nuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SrVKY4nuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HQ6GGdjjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HQ6GGdjjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RrELoLNrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-im