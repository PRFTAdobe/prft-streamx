    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZD1Z\",\"sku\":\"B07QGSZD1Z\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-channel-backed-loveseat-sofa-75-w-leather-cognac-b07qgszd1z\",\"name\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat Sofa, 75&quot;W, Leather, Cognac\",\"description\":\"A channeled back brings elegance to this mid-century 100% top grain leather sofa with tapered wood legs. The solid hardwood frame combines with the stain resistance of the upholstery, decreasing the wear and tear that comes with daily life and helping to keep this sofa looking like new. 75&quot;W x 38&quot;D x 32&quot;H Solid hardwood frame, top grain leather, bench seat cushion with high-density foam, tapered wood legs, brass metal cap Removable and reversible seat cushion A solid hardwood frame with high-density foam adds durability to this channel-backed mid-century sofa. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat Sofa, 75&quot;W, Leather, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712Wz1FLE0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pwgR8Kk1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pwgR8Kk1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FKJvby0FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FKJvby0FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d5wJ5aJaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d5wJ5aJaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d5J0yNZKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d5J0yNZKL.jpg\"},{\"alt\":\"https://stor