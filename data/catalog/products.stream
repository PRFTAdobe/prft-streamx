    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LMCZ3\",\"sku\":\"B07P5LMCZ3\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-living-room-accent-armchair-with-hardwood-frame-46-w-chocolate-b07p5lmcz3\",\"name\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Chocolate\",\"description\":\"Dimensions: 46&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this armchair offers plush support and security. Neutral chocolate-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Chocolate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aPPn8TWDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818C7hlnLZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818C7hlnLZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WcXExZc9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WcXExZc9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OuBGmABBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OuBGmABBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dZRzWg7ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dZRzWg7ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zTvFZWkvL.jpg\",\"url\":\"https://