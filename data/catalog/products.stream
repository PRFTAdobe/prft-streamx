    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSJDM\",\"sku\":\"B07QFRSJDM\",\"lang\":\"en\",\"slug\":\"rivet-julie-mid-century-modern-dining-room-accent-chair-with-arms-32-h-ink-blue-b07qfrsjdm\",\"name\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Ink Blue\",\"description\":\"This mid-century modern accent chair is perfect for the dining room or anywhere else you might need extra seating. The simple design includes back and armrests in one fluid construction. The ink-blue color lends a distinctive flair. 24&quot;W x 24&quot;D x 32&quot;H; seat height: 19&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Upholstered fabric on a solid wood frame Armrests provide comfortable support and stability. This classic mid-century modern accent chair features a simple, clean design with narrow armrests and tapered legs. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Ink Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+M+iEb3FL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QBy-80ckL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QBy-80ckL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZBBdZkB4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZBBdZkB4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qIkbfY6kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qIkbfY6kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SyztQndkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SyztQndkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images