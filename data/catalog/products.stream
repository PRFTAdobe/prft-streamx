    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072FVHSN2\",\"sku\":\"B072FVHSN2\",\"lang\":\"en\",\"slug\":\"rivet-north-end-wood-accent-living-room-arm-chair-38-w-denim-b072fvhsn2\",\"name\":\"Rivet North End Wood Accent Living Room Arm Chair, 38&quot;W, Denim\",\"description\":\"This smart-looking chair has clean lines and an exposed solid wood base that is sure to turn heads. With comfortable cushions and soft, durable fabric, it's also built to withstand wear and tear from your many visitors. 35&quot;D x 38&quot;W x 34.6&quot;H Sturdy hardwood construction, solid beech legs, stain-resistant polyester fabric Contemporary and comfortable At home in your living room or in the corner of a bedroom Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet North End Wood Accent Living Room Arm Chair, 38&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KiRSzU2hL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917xQWat+hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917xQWat+hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18OwN0wIeS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18OwN0wIeS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SSlgGgJ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SSlgGgJ1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"68.9\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"val