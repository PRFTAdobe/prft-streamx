    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DL32P\",\"sku\":\"B07B7DL32P\",\"lang\":\"en\",\"slug\":\"rivet-anne-mid-century-modern-wood-office-computer-desk-62-w-walnut-b07b7dl32p\",\"name\":\"Rivet Anne Mid-Century Modern Wood Office Computer Desk, 62&quot;W, Walnut\",\"description\":\"28&quot;L x 62&quot;W x 30&quot;H Wood composites; walnut veneer; brass pulls Mid-century minimalist, retro style The interior of each drawer has velvet-lined bottom Assembly in 15 minutes or less; simply attach legs Free returns for 30 days. 3-year warranty. Tapered legs and minimalist design touches bring mid-century modern style to your home office. Three drawers with brass pulls provide storage for pens, paper and other office supplies. A matching rolling file cabinet is sold separately.\",\"primaryImage\":{\"alt\":\"Rivet Anne Mid-Century Modern Wood Office Computer Desk, 62&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DV+dV0+5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17j+mnuocL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17j+mnuocL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12H8axMGyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12H8axMGyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XSDDq7YyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XSDDq7YyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816iwEzf15L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816iwEzf15L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ipndLP3UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ipndLP3UL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":