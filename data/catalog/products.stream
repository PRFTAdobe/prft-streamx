    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5DP\",\"sku\":\"B075X4F5DP\",\"lang\":\"en\",\"slug\":\"marin-studded-sofa-87-w-beige-b075x4f5dp\",\"name\":\"Marin Studded Sofa, 87&quot;W, Beige\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Sofa, 87&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YojcUAheL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sO7vYuTTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sO7vYuTTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t59yzUFjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t59yzUFjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-EJabxoaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-EJabxoaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pBBimWUxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pBBimWUxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"