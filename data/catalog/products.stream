    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMRLLB\",\"sku\":\"B082VMRLLB\",\"lang\":\"en\",\"slug\":\"rivet-alvin-contemporary-livingroom-ottoman-29-5-w-light-grey-b082vmrllb\",\"name\":\"Rivet Alvin Contemporary Livingroom Ottoman, 29.5&quot;W, Light Grey\",\"description\":\"If you’re looking for a versatile piece that's both modern and timeless, this ottoman is for you. Fitted performance upholstery rests securely on a firm cushion, and blonde wood legs add durability and stability. Overall: 29.5&quot;W x 21.7&quot;D x 16.9&quot;H Solid-wood frame and legs with performance upholstery Modern, simple design that combines Mid-century touches with contemporary Scandinavian appeal Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alvin Contemporary Livingroom Ottoman, 29.5&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q93KNDy9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RGrZpOeIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RGrZpOeIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81O5LqP0-lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81O5LqP0-lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bVMgolB5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bVMgolB5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xbqXx2zUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xbqXx2zUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rYVIRXI5L.jpg\",\"url\":\"h