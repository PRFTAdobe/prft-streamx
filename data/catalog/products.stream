    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B3ZMF\",\"sku\":\"B07B7B3ZMF\",\"lang\":\"en\",\"slug\":\"rivet-federal-mid-century-modern-wood-dining-kitchen-chairs-upholstered-set-of-2-red-b07b7b3zmf\",\"name\":\"Rivet Federal Mid-Century Modern Wood Dining Kitchen Chairs, Upholstered, Set of 2, Red\",\"description\":\"The rounded seat, simple tall back and tapered wooden legs are hallmarks of mid-century modern style, but understated enough to allow this chair to blend in a transitional décor. Performance fabric and sturdy construction make it durable. 21&quot;W x 24&quot;D x 36&quot;H; Seat Height: 18.5&quot;H ; Seat Depth: 17.5&quot;D; Seat Back Height: 18.5&quot;H Hardwood legs and frame; polyester fabric Mid-century modern influences; can work with contemporary or transitional décor Polyester fabric is durable and easier to clean than other fabrics. Easy assembly in 15-30 minutes; just bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Federal Mid-Century Modern Wood Dining Kitchen Chairs, Upholstered, Set of 2, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mno3-u6oL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XwFOXZJhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XwFOXZJhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gn4cWElvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gn4cWElvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kPwth2kAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kPwth2kAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kSJCSgy3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kSJCSgy3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JLhFvI