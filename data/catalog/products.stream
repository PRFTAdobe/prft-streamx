    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07CB57CG5\",\"sku\":\"B07CB57CG5\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-u-sectional-117-w-hunter-green-b07cb57cg5\",\"name\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Hunter Green\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PF8CqE9dL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71A4kLn05TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71A4kLn05TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16x7tRVFNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16x7tRVFNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ULC6j+c1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ULC6j+c1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c9h8XmOhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c9h8XmOhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bh2HKEaCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Bh2HKEaCL.jpg\"}],\"