    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8623J\",\"sku\":\"B075Z8623J\",\"lang\":\"en\",\"slug\":\"benton-leather-swivel-office-chair-with-wheels-28-4-w-black-b075z8623j\",\"name\":\"Benton Leather Swivel Office Chair with Wheels, 28.4&quot;W, Black\",\"description\":\"Top-grain leather and bold, eclectic armrests make this swivel office chair a style stand-out. The two-paneled back, firm cushioning and elastic webbing make it durable and comfortable, while the leather shows unique natural markings. 28.4&quot;W x 24.2&quot;D x 41&quot;H Top-grain leather upholstery; wood and metal swivel base; five metal wheels. 360 degree swivel. Sturdy for up to 250 lb capacity. Top-grain leather shows unique markings. Easy assembly in 15 minutes. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Benton Leather Swivel Office Chair with Wheels, 28.4&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8167nyUU9mL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kss4gJUuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kss4gJUuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MaG1PqPvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MaG1PqPvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10uYwX0xgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10uYwX0xgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RLEtnP2zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RLEtnP2zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EBHYYIKQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EBHYYIKQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-im