  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQD983\",\"sku\":\"B07QBQD983\",\"lang\":\"en\",\"slug\":\"merrill-queen-headboard-with-decorative-nailhead-trim-75-w-iron-b07qbqd983\",\"name\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Iron\",\"description\":\"This chic iron-colored queen-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 75&quot;W x 11&quot;D x 52&quot;H Cotton fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NHk5pGiaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71U7ib9sJAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71U7ib9sJAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IicN47eKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IicN47eKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zjfNjmZ5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zjfNjmZ5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"v