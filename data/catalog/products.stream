      "content": {
        "bytes": "{\"id\":\"B072FVHP11\",\"sku\":\"B072FVHP11\",\"lang\":\"en\",\"slug\":\"dalton-performance-fabric-ottoman-23-w-charcoal-b072fvhp11\",\"name\":\"Dalton Performance Fabric Ottoman, 23&quot;W, Charcoal\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this sectional sofa. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 98.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Performance Fabric Ottoman, 23&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815tDG23Y5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1060cm1Y6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1060cm1Y6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dM1lmFFLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dM1lmFFLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yQjzraf4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yQjzraf4S.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"98.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"168.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\"