    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSLVMP2\",\"sku\":\"B07HSLVMP2\",\"lang\":\"en\",\"slug\":\"rylee-modern-acacia-wood-3-drawer-sideboard-buffet-63-w-acacia-gray-wash-acacia-b07hslvmp2\",\"name\":\"Rylee Modern Acacia Wood 3-Drawer Sideboard Buffet, 63&quot;W, Acacia, Gray-Wash Acacia\",\"description\":\"Add a contemporary touch to your home with this beautiful sideboard console cabinet. Made from solid acacia with a subtle gray-washed finish, this sideboard perfectly complements most home décor styles. Featuring strong legs for stability and 3 drawers and doors for ample concealed storage. 63&quot;W x 17.7&quot;D x 31.5&quot;H Solid acacia, with acacia veneer on back panel, shelves, and drawer bottoms Subtle, cool gray-washed distressed finish and clean lines create an attractive modern look. Features 3 drawers, 3 doors with soft-closing hinges, and interior shelves creating 2 niches behind each door. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rylee Modern Acacia Wood 3-Drawer Sideboard Buffet, 63&quot;W, Acacia, Gray-Wash Acacia\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911HVVZ5a9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819vNd+2I2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819vNd+2I2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91T2PXzxmuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91T2PXzxmuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810V+DaRx0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810V+DaRx0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-p