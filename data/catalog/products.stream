        "bytes": "{\"id\":\"B07P8ST6VT\",\"sku\":\"B07P8ST6VT\",\"lang\":\"en\",\"slug\":\"rivet-emerly-modern-ottoman-33-w-steel-grey-b07p8st6vt\",\"name\":\"Rivet Emerly Modern Ottoman, 33&quot;W, Steel Grey\",\"description\":\"Hardwood frame with sturdy mortise-and-tenon joints, performance fabric, metal legs Overall: 33&quot;W x 23&quot;D x 18&quot;H; seat height: 18&quot;H; seat depth: 23&quot;D; leg height: 6&quot;H Wood, 100% polyester fabric, foam, metal Easy-to-clean upholstery This modern ottoman in gray offers durability with easy-to-maintain upholstery that matches most decors. Assemble in 15 minutes or less Spot clean stains and rinse with water. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Emerly Modern Ottoman, 33&quot;W, Steel Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aY7PVqtdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qtp-xZVcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qtp-xZVcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uBsrKEDFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uBsrKEDFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iXK6wv67L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iXK6wv67L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GGFynw-jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GGFynw-jL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"val