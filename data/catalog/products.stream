        "bytes": "{\"id\":\"B075ZBW1S4\",\"sku\":\"B075ZBW1S4\",\"lang\":\"en\",\"slug\":\"larson-industrial-wood-metal-side-end-table-22-w-walnut-b075zbw1s4\",\"name\":\"Larson Industrial Wood & Metal Side End Table, 22&quot;W, Walnut\",\"description\":\"The convenient L shape of this end table makes it perfect for pulling up close to your chair or sofa while working on your laptop. The solid pine top has a natural distressed finish, while the metal legs and trim have a darker brown matte finish. 16&quot;W x 10&quot;D x 26.25H Solid pine top and metal frame Industrial and rustic touches allow this table to blend with many styles. Distressed top with a walnut finish Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Larson Industrial Wood & Metal Side End Table, 22&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BiQ6821oL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916a13RsfSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916a13RsfSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9163xxAo8PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9163xxAo8PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TMoTJ0B5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TMoTJ0B5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L54vB1cdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L54vB1cdL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.25\"