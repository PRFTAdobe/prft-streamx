    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP32XY\",\"sku\":\"B075YP32XY\",\"lang\":\"en\",\"slug\":\"sophia-modern-accent-kitchen-dining-room-table-chairs-36-inch-height-set-of-2-slate-blue-b075yp32xy\",\"name\":\"Sophia Modern Accent Kitchen Dining Room Table Chairs, 36 Inch Height, Set of 2, Slate Blue\",\"description\":\"Regardless of your style, these clean, simple chairs will look handsome at your dining room table, in a living room or at a desk. The comfortable backs and seats are anchored by wood left in a light, natural-color finish. 24&quot;W x 20&quot;D x 36&quot;H 95% polyester/5% nylon performance fabric on hardwood frame; solid rubberwood legs in natural finish Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Accent Kitchen Dining Room Table Chairs, 36 Inch Height, Set of 2, Slate Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819X0fDsUPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aPkLsOFrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aPkLsOFrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UzyBPuhgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UzyBPuhgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EUkEazJnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EUkEazJnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A2USwCbDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A2USwCbDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12MdORkh8S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12MdORkh8S.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"17.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dinning table set\",\"label\":\"Dinning table set\"},{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Round dinning table\",\"label\":\"Round dinning table\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Dinning table\",\"label\":\"Dinning table\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Table & Chair Sets\",\"slug\":\"table-&-chair-sets\",\"name\":\"Table & Chair Sets\",\"value\":\"Table & Chair Sets\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":305,\"discountedValue\":274.5}}"
