    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MF6YH\",\"sku\":\"B07B4MF6YH\",\"lang\":\"en\",\"slug\":\"andover-modern-rectangle-ottoman-32-w-tan-b07b4mf6yh\",\"name\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Tan\",\"description\":\"Wooden legs, clean lines, and box-edge cushions bring stylish sophistication to modern or transitional rooms. With a sturdy frame and springy cushioning, this ottoman is ready to withstand years as a footrest or extra seating for guests. 32&quot;W x 25&quot;D x 21&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 21&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame The streamlined shape is a hallmark of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914TrKIu0lL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JOvS2iPqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JOvS2iPqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuZmtZ-zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuZmtZ-zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9157ZvWK-0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9157ZvWK-0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D9HqYSJeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D9HqYSJeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1557qotk0S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1557qotk0S.jpg\"}],\"attributes\":[