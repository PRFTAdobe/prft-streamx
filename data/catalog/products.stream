    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB481\",\"sku\":\"B07QCMB481\",\"lang\":\"en\",\"slug\":\"rivet-asher-modern-storage-ottoman-15-75-w-fabric-red-b07qcmb481\",\"name\":\"Rivet Asher Modern Storage Ottoman, 15.75&quot;W, Fabric, Red\",\"description\":\"Complete your modern-style interior decorating with this tastefully elegant ottoman. With a sleek design and a storage compartment under its lid, this ottoman is an ideal combination of style, comfort, and functionality. 15.75&quot;W x 15.75&quot;D x 16&quot;H; seat height: 16&quot;H; seat depth: 15.75&quot;D Solid-wood frame with 100% polyester upholstery Storage ottoman with comfortable red fabric This ottoman's simple elegance perfectly complements a modern-style room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Asher Modern Storage Ottoman, 15.75&quot;W, Fabric, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91coA7vKWnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zeX87cPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zeX87cPdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918nVlp1BnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918nVlp1BnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812QURB18uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812QURB18uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TKv8hXoKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TKv8hXoKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oLVKhr9eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oLVKhr9eL.jpg\"},{\"alt\":\"https://storage.google