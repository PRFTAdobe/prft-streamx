    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6SC9H\",\"sku\":\"B07HZ6SC9H\",\"lang\":\"en\",\"slug\":\"blaine-modern-sleeper-sofa-bed-78-w-navy-blue-b07hz6sc9h\",\"name\":\"Blaine Modern Sleeper Sofa Bed, 78&quot;W, Navy Blue\",\"description\":\"Add mid-century elegance to your living room with this navy blue sofa bed. The solid-wood frame and polyester upholstery make this sofa bed both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 78&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 21.7&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you\",\"primaryImage\":{\"alt\":\"Blaine Modern Sleeper Sofa Bed, 78&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pj4UQ7SEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913crQWbXcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913crQWbXcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914A3nLotwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914A3nLotwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vCdf8wc1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vCdf8wc1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jrk+k1q0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jrk+k1q0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PDFBbNbvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images