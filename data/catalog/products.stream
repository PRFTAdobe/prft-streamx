    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4DB65T\",\"sku\":\"B07B4DB65T\",\"lang\":\"en\",\"slug\":\"rivet-cliff-mid-century-modern-round-tufted-velvet-pouf-ottoman-39-w-grey-b07b4db65t\",\"name\":\"Rivet Cliff Mid-Century Modern Round Tufted Velvet Pouf Ottoman, 39&quot;W, Grey\",\"description\":\"After a long day, your tired legs and feet will look forward to this plush velvet ottoman. It's also a handy extra seat for guests and a place to rest a tray of snacks. Tufting gives it a mid-century modern flair, while the fabric adds a bit of glam. 39.3&quot;W x 39.3&quot;D x 15.7&quot;H Velvet fabric on wood frame Mid-century modern meets glam in this statement piece Can be a foot rest, extra seating for guests, or a perch for a tray of snacks No assembly required Free returns for 30 days. 1-year warranty. Avoid direct sunlight as the fabric will fade with exposure\",\"primaryImage\":{\"alt\":\"Rivet Cliff Mid-Century Modern Round Tufted Velvet Pouf Ottoman, 39&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tUvoPjrrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Nj6CmdqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Nj6CmdqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AjMqeFUUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AjMqeFUUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wt7ZFJgBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wt7ZFJgBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19L-tbTa6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19L-tbTa6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"va