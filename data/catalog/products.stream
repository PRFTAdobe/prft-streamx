"Black\"},{\"value\":\"Euro\",\"label\":\"Euro\"},{\"value\":\"Mac\",\"label\":\"Mac\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Matching\",\"label\":\"Matching\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Swivel\",\"label\":\"Swivel\"},{\"value\":\"Collection\",\"label\":\"Collection\"},{\"value\":\"Stressless\",\"label\":\"Stressless\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":435,\"discountedValue\":391.5}}"
