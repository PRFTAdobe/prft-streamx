    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJCZCR\",\"sku\":\"B07BWJCZCR\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-left-facing-l-shape-sectional-leather-116-w-saddle-b07bwjczcr\",\"name\":\"Rivet Edgewest Modern Left Facing L Shape Sectional, Leather, 116&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 116&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; choose the configuration thats right for you Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Left Facing L Shape Sectional, Leather, 116&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OUQN8CWBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pdDNePV9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pdDNePV9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xY+1RHV6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xY+1RHV6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m+D8MYusL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m+D8MYusL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81