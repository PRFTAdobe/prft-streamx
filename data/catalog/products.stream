    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7634C\",\"sku\":\"B07HZ7634C\",\"lang\":\"en\",\"slug\":\"blaine-modern-loveseat-sofa-55-w-beige-b07hz7634c\",\"name\":\"Blaine Modern Loveseat Sofa, 55.&quot;W, Beige\",\"description\":\"Add mid-century elegance to your living room with this beige loveseat. The solid-wood frame and polyester upholstery make this sofa both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 55.9&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 22&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you\",\"primaryImage\":{\"alt\":\"Blaine Modern Loveseat Sofa, 55.&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mSt4BHJ6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EsSS8nh+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EsSS8nh+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QcNq3RlNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QcNq3RlNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qeKqxaROL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qeKqxaROL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FeEeaDYXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FeEeaDYXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TshL9bPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TshL9bPdL.jp