    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N4S4\",\"sku\":\"B075X4N4S4\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-velvet-accent-chair-35-4-w-hunter-green-b075x4n4s4\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Accent Chair, 35.4&quot;W, Hunter Green\",\"description\":\"This sleek, mid-century inspired velvet chair is designed to impress. A deep seat cushion, back cushion, tapered wood legs, and smooth bolster pillows provide just the right mix of sophistication with a contemporary edge. 35.4”W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs. Removable and reversible back cushion for easy cleaning. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Accent Chair, 35.4&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918XQnTTbFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AXR8pyZTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AXR8pyZTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1st23gPmVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1st23gPmVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ivg0fOG7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ivg0fOG7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17wKsm7OIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17wKsm7OIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RwsvRrCNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RwsvRrCNL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"la