    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YNL24V\",\"sku\":\"B075YNL24V\",\"lang\":\"en\",\"slug\":\"carson-tufted-counter-height-kitchen-stool-41-h-slate-b075ynl24v\",\"name\":\"Carson Tufted Counter Height Kitchen Stool, 41&quot;H, Slate\",\"description\":\"Your purchase includes One Stone & Beam Carson Tufted Kitchen Stool | Not pair Product dimensions – 23.6” W x 18.5” L x 41” H | Floor to seat – 25” | Weight – 15.4 lbs. No assembly required | Wipe with soft dry cloth to clean 98% polyester/2% nylon fabric | Solid poplar legs with espresso finish Foam padding and elastic suspension system keeps upholstery firm and resilient Modern tufting on the back, along with substantial padding in the back and seat, make this counter stool stylish and comfortable | Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Carson Tufted Counter Height Kitchen Stool, 41&quot;H, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810m9onbNbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MU14TEDTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MU14TEDTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q8wm1wpdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q8wm1wpdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RGgAZGrnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RGgAZGrnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XqlxZOacL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XqlxZOacL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{