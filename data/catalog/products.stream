    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQCK7\",\"sku\":\"B07QBMQCK7\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-channel-backed-living-room-chair-35-w-felt-grey-b07qbmqck7\",\"name\":\"Rivet Damien Mid-Century Modern Channel-Backed Living Room Chair, 35&quot;W, Felt Grey\",\"description\":\"A channeled back brings elegance to this mid-century living room chair with tapered wood legs. The solid hardwood frame combines with the durable upholstery, decreasing the wear and tear that comes with daily life and helping to keep this chair looking like new. 35&quot;W x 38&quot;D x 32&quot;H Solid hardwood frame, 100% polyester fabric, bench seat cushion with high-density foam, tapered wood legs, brass metal cap Removable and reversible seat cushion A solid hardwood frame with high-density foam adds durability to this channel-backed mid-century chair. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Channel-Backed Living Room Chair, 35&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jv9kLF7eL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PwwETZ5QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PwwETZ5QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dkOr0nmDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dkOr0nmDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818QjN3Fq9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818QjN3Fq9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R-JFfR-fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R-JFfR-fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi