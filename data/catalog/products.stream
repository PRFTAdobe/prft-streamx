    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D8982\",\"sku\":\"B07B4D8982\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-l-sectional-116-w-beige-b07b4d8982\",\"name\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Beige\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jKAUw-hWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IhcDPXvZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IhcDPXvZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rkdJQ--ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rkdJQ--ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915L6tvGEiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915L6tvGEiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/ori