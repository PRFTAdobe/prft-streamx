    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QJDGPN\",\"sku\":\"B075QJDGPN\",\"lang\":\"en\",\"slug\":\"rivet-elaine-tufted-line-upholstered-headboard-king-60-h-heather-grey-b075qjdgpn\",\"name\":\"Rivet Elaine Tufted Line Upholstered Headboard King, 60&quot;H, Heather Grey\",\"description\":\"This upholstered headboard will add a polished update to any style bedroom. Performance fabric with a linen-like texture is accented by hand-pulled button tufting. Plentiful foam padding makes it cozy to lean against while reading a good book. 80.75&quot;W x 7.25&quot;L x 60&quot;H Sturdy hardwood frame; polyester performance fabric; birch wood legs Transitional style that blends with most décor Narrow profile makes it easy to move. Mattress, boxspring and bed frame sold separately. Easy assembly. All hardware and assembly tools included Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Elaine Tufted Line Upholstered Headboard King, 60&quot;H, Heather Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oHLmEo9EL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f-tjwHUZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f-tjwHUZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w62JfH5QS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w62JfH5QS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eVWa9XXIS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eVWa9XXIS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1W4qMxWbTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1W4qMxWbTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UvkRS4SdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Uvk