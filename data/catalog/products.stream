    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X54417\",\"sku\":\"B075X54417\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-straight-back-settee-49-w-moondust-b075x54417\",\"name\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Moondust\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Moondust\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lhww0lwtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XU1ow-PnS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XU1ow-PnS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uftNEb1fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uftNEb1fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SROi16o2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SROi16o2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ec+ZUT0HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ec+ZUT0HL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"49.0\",\"label\":\"inche