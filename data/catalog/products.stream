    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWN2XC\",\"sku\":\"B07QGWN2XC\",\"lang\":\"en\",\"slug\":\"rivet-julian-mid-century-counter-stools-set-of-2-34-3-h-grey-b07qgwn2xc\",\"name\":\"Rivet Julian Mid-Century Counter Stools, Set of 2, 34.3&quot;H, Grey\",\"description\":\"These low-back counter stools feature a minimalist mid-century design with padded seats and backs. Sturdy steel construction includes geometric open-style legs. 19.3&quot;W x 21&quot;D x 34.3&quot;H; seat height: 25.2&quot;H; seat dimension: 16&quot; x 14&quot; Fabric upholstery on wood frame with steel legs The fabric seat and powder-coated finish on the metal legs make for easy care and durability. Grey upholstery is stylishly paired with a slender grey steel frame and geometric legs. Assemble in 15 minutes or less Clean by vacuuming or wiping with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julian Mid-Century Counter Stools, Set of 2, 34.3&quot;H, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LLPOX+kTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qvY-vVMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qvY-vVMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812Sh2hse7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812Sh2hse7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tkZF39MML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tkZF39MML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1F6tXPoUCS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1F6tXPoUCS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jib+J18aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/7