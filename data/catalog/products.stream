    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4ZG4\",\"sku\":\"B07QFP4ZG4\",\"lang\":\"en\",\"slug\":\"joanna-contemporary-tufted-sofa-couch-with-reversible-cushions-84-w-blue-b07qfp4zg4\",\"name\":\"Joanna Contemporary Tufted Sofa Couch with Reversible Cushions, 84&quot;W, Blue\",\"description\":\"Clean lines give this sofa a modern, sophisticated look. Removable seat cushions and backs are comfortable and easy to adjust, and the performance fabric upholstery can be cleaned with a cloth or simple vacuuming. Steel seat springs and a wood frame provide structure, support and durability. Overall: 84&quot;W x 37&quot;D x 38&quot;H. Seat height: 21.5&quot;H; seat depth: 23&quot;D; seat back height: 19&quot;H Steel seat springs, wood frame and wood legs add structure and durability Loose, reversible seat cushions and inside back cushions in 100% polyester performance fabric Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Joanna Contemporary Tufted Sofa Couch with Reversible Cushions, 84&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PP7uO1jJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RxZP1hV-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RxZP1hV-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qZqNMJhxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qZqNMJhxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917jjDONbJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917jjDONbJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hf-JU9ufL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hf-JU9ufL.jpg\"},{\"alt\":\"https://storage.googleapi