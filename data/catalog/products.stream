    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MG3WR\",\"sku\":\"B07B4MG3WR\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-38-w-charcoal-b07b4mg3wr\",\"name\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Charcoal\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 38&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w8wotJx8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fh3i1eREL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fh3i1eREL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QouCuko5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QouCuko5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yBW1BiFcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yBW1BiFcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j1NyrJ2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j1NyrJ2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qTePe1sVL.jp