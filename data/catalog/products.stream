    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4W5S3K\",\"sku\":\"B07B4W5S3K\",\"lang\":\"en\",\"slug\":\"bridgewater-curved-queen-headboard-66-w-spinnsol-natural-b07b4w5s3k\",\"name\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Spinnsol Natural\",\"description\":\"This headboard adds classic style to any space. Hand-applied pewter nailhead trim accents the headboards curved silhouette. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 66&quot;W x 4&quot;D x 56&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Spinnsol Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81emzPEe2XL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aIhWGxw3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aIhWGxw3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812c7xHxV+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812c7xHxV+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911k9I+-6OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911k9I+-6OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DU8FGnzAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DU8FGnzAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gqrenoz1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9