    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4M7W\",\"sku\":\"B07QFP4M7W\",\"lang\":\"en\",\"slug\":\"abigail-sofa-couch-86-w-golden-brown-b07qfp4m7w\",\"name\":\"Abigail Sofa Couch, 86&quot;W, Golden Brown\",\"description\":\"Comfort meets class in this attractive transitional-style sofa. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this sofa. 86&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with life-friendly 83% olefin and 17% polyester performance fabric The removable and reversible seat and back cushions ensure durability and comfort.Q55 Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Sofa Couch, 86&quot;W, Golden Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DBbYWWh4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZrgSSKZaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZrgSSKZaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gka1y3R0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gka1y3R0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rtRJx-CML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rtRJx-CML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rKNUx