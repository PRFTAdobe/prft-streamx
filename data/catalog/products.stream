    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSK7Y5G\",\"sku\":\"B07HSK7Y5G\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-upholstered-bar-stool-with-gold-accents-41-h-navy-velvet-b07hsk7y5g\",\"name\":\"Rivet Whit Contemporary Upholstered Bar Stool with Gold Accents, 41&quot;H, Navy Velvet\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous navy velvet, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 41&quot;H; Seat Height: 30&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Upholstered Bar Stool with Gold Accents, 41&quot;H, Navy Velvet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718WhYlb74L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RlP7LLl4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RlP7LLl4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716RXGnMFTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716RXGnMFTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xaG39YQqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xaG39YQqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tSH9LfjFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tSH9LfjFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CZJJHYprL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7