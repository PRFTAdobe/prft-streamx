    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MRLRJ\",\"sku\":\"B07B4MRLRJ\",\"lang\":\"en\",\"slug\":\"rivet-berkshire-modern-living-room-accent-chair-37-w-dark-grey-b07b4mrlrj\",\"name\":\"Rivet Berkshire Modern Living Room Accent Chair, 37&quot;W, Dark Grey\",\"description\":\"Low-angled arms, deep seat cushions and lumbar pillows are hallmarks of this mid-century influenced design. Piping on the arms and slanted metal legs add additional visual interest to this chair, which is sure to be a conversation piece. 37&quot;W x 37&quot;D x 32.2&quot;H; Seat Height: 18.8&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 21.2&quot;H; Arm Height: 22&quot;H; Leg Height: 5.5&quot; Polyester fabric on sturdy wood frame; metal legs with nickel finish Clean lines, low-slung arms and metal legs are hallmarks of mid-century modern style In addition to being a comfortable chair, this is an eye-catching statement piece. Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Berkshire Modern Living Room Accent Chair, 37&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iOr4d5VoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mM5w0LUpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mM5w0LUpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13nEWMF2cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13nEWMF2cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rFCjKE54S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1rFCjKE54S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1YprquKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1YprquKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HR8F30AsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HR8F30AsL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.2\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"68.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dark grey\",\"label\":\"Dark grey\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":214,\"discountedValue\":192.6}}"
