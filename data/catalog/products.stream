    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSKY884\",\"sku\":\"B07HSKY884\",\"lang\":\"en\",\"slug\":\"half-moon-industrial-rustic-bookcase-54-w-dark-fir-finish-with-bronze-accents-b07hsky884\",\"name\":\"Half-Moon Industrial Rustic Bookcase, 54&quot;W, Dark Fir Finish with Bronze Accents\",\"description\":\"The seamless marriage of cool black metal and warm dark-fir finished wood make this 4-shelf bookcase a versatile addition to any room. The half-moon frame design and sturdy metal supports hold your collection in style. 54”W x 13.75”D x 41.8”H Metal half-moon frame adds elegance and style to this 4-shelf bookcase A low height profile makes this bookcase ideal for displays against busy walls Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Half-Moon Industrial Rustic Bookcase, 54&quot;W, Dark Fir Finish with Bronze Accents\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815--d7el+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815TwzHe6kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815TwzHe6kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FqXaNW24L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FqXaNW24L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812bmrQtxmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812bmrQtxmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OYEk2EccL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OYEk2EccL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zHSP9QbKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zHSP9QbKS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\