        "bytes": "{\"id\":\"B07B8CX5W5\",\"sku\":\"B07B8CX5W5\",\"lang\":\"en\",\"slug\":\"rivet-modern-metal-kitchen-rolling-bar-cart-with-wheels-30-inch-height-gold-b07b8cx5w5\",\"name\":\"Rivet Modern Metal Kitchen Rolling Bar Cart with Wheels, 30&quot; Inch Height, Gold\",\"description\":\"Deliver some glamour to your guests along with the food and beverages. Marble shelves and gold-toned metal add beauty to the functionality of this bar cart. Metal casters allow you to easily load it in the kitchen and roll it to your guests. 12&quot;W x 16&quot;D x 30&quot;H Marble shelves housed in metal frame; metal casters A modern design with charmingly glam finishes and materials Casters allow you to roll it between rooms Assembly in 15 minutes; just screw on casters Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Metal Kitchen Rolling Bar Cart with Wheels, 30&quot; Inch Height, Gold\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aJEgZ94CL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYMZaAbyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYMZaAbyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e2CXME8NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e2CXME8NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ymx8cqsxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ymx8cqsxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tqqVEJP8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tqqVEJP8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMzwLDjWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMzwLDjWL.jpg\"}],\"attributes\":[{\"name\":\"heig