    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082DJ4X4C\",\"sku\":\"B082DJ4X4C\",\"lang\":\"en\",\"slug\":\"charlotte-executive-office-chair-with-heavy-duty-casters-27-9-w-gray-b082dj4x4c\",\"name\":\"Charlotte Executive Office Chair with Heavy-Duty Casters, 27.9&quot;W, Gray\",\"description\":\"The thoughtfully distributed padding along the tall back of this chair adds support and comfort where it's most needed. The nailhead trim is a subtle nod to traditional styling, while the heavy-duty casters add modern flexibility. The gray upholstery is a classic neutral that will suit any space. 27.9&quot;W x 24.4&quot;D x 41.7&quot;–44.9&quot;H; seat height: 18.3–21.5&quot;H; seat depth: 16.5&quot;D; seat back height: 24.8&quot;H; arm height: 25.7&quot;–28.7&quot;H; leg height: 14.1&quot;–16.9&quot;H Performance upholstery and foam cushioning over a metal and plywood frame with metal base and rolling caster wheels A supportive high back makes this chair useful and comfortable for long workdays while casters add mobility and flexibility. Simple assembly in 15 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Charlotte Executive Office Chair with Heavy-Duty Casters, 27.9&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ONyIenhPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FuS+yqn8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FuS+yqn8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MiUa3IpYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MiUa3IpYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mkCXKCfIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mkCXKCfIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7