    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YNHSN\",\"sku\":\"B07B4YNHSN\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-queen-bed-66-w-fresh-pewter-b07b4ynhsn\",\"name\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Fresh Pewter\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 66&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Fresh Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KZ3hYqxqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1amPoCkBEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1amPoCkBEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hJg-WqDQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hJg-WqDQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j6Re-13yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j6Re-13yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19QLXtbH5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19QLXtbH5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814PM0sP+aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814P