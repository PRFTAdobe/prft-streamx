    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084L8195R\",\"sku\":\"B084L8195R\",\"lang\":\"en\",\"slug\":\"solid-pine-rustic-farmhouse-console-table-52-w-rustic-oak-b084l8195r\",\"name\":\"Solid Pine Rustic Farmhouse Console Table, 52&quot;W, Rustic Oak\",\"description\":\"This console table’s light finish and simple design mean it will be home with any decor—traditional or modern. X-shaped detailing on the sides provides dimension in any space. Sturdy pine construction and two wide shelves make this table a great storage option as well as a stylish focal point. 52&quot;W x 15&quot;D x 30&quot;H Solid pine construction The simple design features two split shelves to store your small items. Solid wood construction creates a sturdy base to help keep items secure. Use this piece as the perfect finishing touch for your farmhouse decor or as a way to add a rustic touch to your existing design scheme. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Solid Pine Rustic Farmhouse Console Table, 52&quot;W, Rustic Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QsaoK4Y4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CvBxSQsrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CvBxSQsrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FTjumCbnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FTjumCbnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817xSr+-ELL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817xSr+-ELL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M++6Rz25L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M++6Rz25L.jpg\"}],\"attributes\":[{\"name\":\"height