    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQDGJ7\",\"sku\":\"B07QBQDGJ7\",\"lang\":\"en\",\"slug\":\"glenwilde-queen-headboard-75-w-charcoal-b07qbqdgj7\",\"name\":\"Glenwilde Queen Headboard, 75&quot;W, Charcoal\",\"description\":\"The strong, smooth lines of this charcoal-colored queen-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 75&quot;W x 11&quot;D x 52&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Queen Headboard, 75&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zy0s4AbNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TeNLxFLlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TeNLxFLlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rDLSX9N7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rDLSX9N7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aSb68PJKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aSb68PJKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lH7VqnftL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lH7VqnftL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"1