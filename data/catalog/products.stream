    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6VT4D\",\"sku\":\"B07HZ6VT4D\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-left-facing-corner-sofa-fabric-90-w-linen-b07hz6vt4d\",\"name\":\"Bagley Sectional Component, Left-Facing Corner Sofa, Fabric, 90&quot;W, Linen\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the left-facing corner sofa component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 90&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Left-Facing Corner Sofa, Fabric, 90&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61FaLgc5NBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nNoWBhaoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nNoWBhaoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UZeSHy7+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UZeSHy7+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hb6DNVApL.jpg\",\"url\":\"https://storage.go