    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N273D\",\"sku\":\"B07B4N273D\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-accent-chair-34-w-charcoal-grey-b07b4n273d\",\"name\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Charcoal Grey\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 34&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lpmX2XvmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JvqhERShL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JvqhERShL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Pm-V6etpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Pm-V6etpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9189LwACpML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9189LwACpML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y9InIElZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y9InIElZL.jpg\"},{\"alt\":\"https://storage.googleap