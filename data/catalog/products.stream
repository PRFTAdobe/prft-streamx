    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BRXDH\",\"sku\":\"B07B7BRXDH\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-high-back-swivel-seat-bar-stool-43-h-blue-b07b7brxdh\",\"name\":\"Alaina Contemporary High-Back Swivel Seat Bar Stool, 43&quot;H, Blue\",\"description\":\"This bar stool allows you to fit your guests around the bar or kitchen island for special celebrations, while a swivel function makes it extra easy for everyone to chat. Their transitional style allows them to blend with any style room. 18.5&quot;W x 22&quot;D x 43&quot;H; Seat Depth: 16.5&quot;D; Seat Back Height: 12.5&quot;H; Seat Height: 30&quot;H Moisture-repellent, stain-resistant fabric on a solid hardwood frame with swivel seat and low arms Modern design with classic solid upholstery provides a transitional look No assembly required. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary High-Back Swivel Seat Bar Stool, 43&quot;H, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910r4CDmpPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BBm3DE8hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BBm3DE8hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x5cY9DhWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x5cY9DhWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ogz7zk8kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ogz7zk8kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1holVmxpaS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1holVmxpaS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KmqpuPhmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori