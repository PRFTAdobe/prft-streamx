    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082SVPLZY\",\"sku\":\"B082SVPLZY\",\"lang\":\"en\",\"slug\":\"sadie-living-room-wingback-accent-chair-33-w-cream-b082svplzy\",\"name\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Cream\",\"description\":\"The classic wingback chair gets a modern refresh with crisp, neutral upholstery. Made to order in the United States of partially imported materials, it features a sturdy wood frame; tall tapered legs; and durable, tightly woven fabric in a classic color. This item is made to order just for you. 33&quot;W x 38&quot;D x 41&quot;H Sturdy wood frame and legs with durable woven fabric Hard-wearing fabric and reversible seat cushion for durability No assembly required. Vacuum or spot clean with a damp cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911krb4lOZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C4yh1X-YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C4yh1X-YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9105ve3ofUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9105ve3ofUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f1FuMptzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f1FuMptzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IhlZuucsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IhlZuucsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811Vculf39L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811Vculf39L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ha