    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP4WYT\",\"sku\":\"B075YP4WYT\",\"lang\":\"en\",\"slug\":\"rivet-modern-industrial-wood-and-metal-pedestal-dining-room-table-63-l-walnut-finish-b075yp4wyt\",\"name\":\"Rivet Modern Industrial Wood and Metal Pedestal Dining Room Table, 63&quot;L, Walnut Finish\",\"description\":\"Four metal legs extend out from a metal base in this distinctive industrial-style table. The hardwood top with walnut veneer is roomy for dining but also works as a desk. This piece will add a unique style to a modern or industrial setting. 63&quot;L x 35.4&quot;D x 29.5&quot;H Hardwood top with walnut finish; metal pedestal and legs with black finish A distinctive industrial-style piece useful as a dining room table or as a desk Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Industrial Wood and Metal Pedestal Dining Room Table, 63&quot;L, Walnut Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+3GO7fFCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e0TQntgoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e0TQntgoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p8K5MUKvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71p8K5MUKvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GNOrBo-XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GNOrBo-XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S1L4xz1CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S1L4xz1CL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"63.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"72.2\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Counter height table\",\"label\":\"Counter height table\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Dining-tables\",\"label\":\"Dining-tables\"},{\"value\":\"Dining table\",\"label\":\"Dining table\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Round dining table\",\"label\":\"Round dining table\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Dining room table\",\"label\":\"Dining room table\"},{\"value\":\"Kitchen table\",\"label\":\"Kitchen table\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Console table\",\"label\":\"Console table\"},{\"value\":\"Kitchen table set\",\"label\":\"Kitchen table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"}]}],\"categories\":[{\"id\":\"Tables\",\"slug\":\"tables\",\"name\":\"Tables\",\"value\":\"Tables\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":672,\"discountedValue\":604.8}}"
