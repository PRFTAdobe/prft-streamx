    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4DB68P\",\"sku\":\"B07B4DB68P\",\"lang\":\"en\",\"slug\":\"isabel-traditional-sofa-84-w-slate-grey-b07b4db68p\",\"name\":\"Isabel Traditional Sofa, 84&quot;W, Slate Grey\",\"description\":\"With performance fabric that resists stains along with wear and tear, this handsome couch is ready for guests, pets and an active family. Its clean, streamlined design blends with most any style room. A matching storage ottoman is sold separately. 83.8&quot;W x 35.4&quot;D x 37.4&quot;H Performance fabric on wood frame Streamlined design fits a modern or transitional room Comfortable seating with a classic style Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Sofa, 84&quot;W, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919iT5CtW2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M8inuJcpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M8inuJcpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nug14gRiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nug14gRiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhAwDpwjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhAwDpwjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810-E9hkkdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810-E9hkkdL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":