  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QJDGNN\",\"sku\":\"B075QJDGNN\",\"lang\":\"en\",\"slug\":\"darby-wingback-full-queen-upholstered-headboard-66-25-w-navy-blue-b075qjdgnn\",\"name\":\"Darby Wingback Full / Queen Upholstered Headboard, 66.25&quot;W, Navy Blue\",\"description\":\"This mid-century modern headboard's wingback design is covered in linen-look performance fabric for durability. Nailhead trim adds another touch of elegance, and ample foam padding makes it comfortable to lean against while enjoying a good book. 66.25&quot; W x 11.5&quot; D x 51.5&quot;H Hardwood frame; polyester performance fabric; metal nailheads with antiqued brass finish An update of a classic mid-century modern style Performance fabric is durable, easy to clean. Headboard has Dacron-wrapped foam padding. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Darby Wingback Full / Queen Upholstered Headboard, 66.25&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EZ-Bpt6ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IVXqbFKyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IVXqbFKyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x59tIG1aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x59tIG1aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JU6EM-6pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JU6EM-6pL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"51.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"66.25\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"11.75\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"62.7\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Full or queen\",\"label\":\"Full or queen\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"Navy blue\",\"label\":\"Navy blue\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"},{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"}]}],\"categories\":[{\"id\":\"Headbo