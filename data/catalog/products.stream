    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MBFCRD8\",\"sku\":\"B07MBFCRD8\",\"lang\":\"en\",\"slug\":\"classic-tufted-barstool-set-of-2-44-h-beige-b07mbfcrd8\",\"name\":\"Classic Tufted Barstool, Set of 2, 44&quot;H, Beige\",\"description\":\"Overall: 21.25&quot;W x 20.5&quot;D x 43.5&quot;H; seat height: 30.25&quot;H; seat depth: 18&quot;D; seat back height: 13.5&quot;H Durable fabric on wood frame; solid-wood legs with natural finish Set of 2 vintage-inspired barstools with wood frame and beige upholstery Foam padding and elastic suspension system keep the back and seat firm and springy. Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 3-year warranty. Complete your kitchen or bar area with these vintage-inspired tufted barstools. The sturdy solid-wood frame features an elastic suspension system that’s designed to keep the seat firm, and the elegant design nicely complements vintage, country and farmhouse-style home decor.\",\"primaryImage\":{\"alt\":\"Classic Tufted Barstool, Set of 2, 44&quot;H, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+FW1aLxpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YVMTN7nXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YVMTN7nXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pnu7jG5XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pnu7jG5XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Axu5iFUyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Axu5iFUyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZArCVEbwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZArCVEbwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qe2g5NIKL.jpg\",\"url\":\"https://st