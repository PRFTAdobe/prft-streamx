    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WP64\",\"sku\":\"B075X2WP64\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-pewter-b075x2wp64\",\"name\":\"Marin Studded Chair, 33&quot;W, Pewter\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with 80% cotton/20% polyester upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TeTiDeUaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15BjkkjK4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1osL7riaIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1osL7riaIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915bmsjVHpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915bmsjVHpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912EHtbQFTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912EHtbQFTL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\"