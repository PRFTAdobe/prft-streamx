        "bytes": "{\"id\":\"B085FHGH3V\",\"sku\":\"B085FHGH3V\",\"lang\":\"en\",\"slug\":\"ravenna-home-classic-swivel-recliner-with-storage-ottoman-35-w-black-b085fhgh3v\",\"name\":\"Ravenna Home Classic Swivel Recliner with Storage Ottoman, 35&quot;W, Black\",\"description\":\"Recliner: 35&quot;W x 34.6&quot;D x 37.8&quot;H; seat height: 18.9&quot;H; seat depth: 19.7&quot;D. Ottoman: 22.4&quot;W x 17.7&quot;D x 20.5&quot;H Plywood frame with strong reclining mechanism, round arms, and solid performance seat and backrest cushions Reclining chair with swivel glide, round arms, and extra storage ottoman Assemble in 15 minutes or less Indoor use only; avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Classic Swivel Recliner with Storage Ottoman, 35&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q7zEfRNBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uK-vAoaFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uK-vAoaFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tQXvr7-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tQXvr7-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RdVFOmI0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RdVFOmI0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xK5ZlBmiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xK5ZlBmiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lQqeJoWvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lQqeJoWvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qMlp7ju8L.jpg\",\"url\":\"h