    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWQM5D\",\"sku\":\"B07QGWQM5D\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-luxe-velvet-dining-chair-34-1-h-set-of-2-dark-green-b07qgwqm5d\",\"name\":\"Rivet Mid-Century Luxe Velvet Dining Chair, 34.1&quot;H, Set of 2, Dark Green\",\"description\":\"These mid-century casual dining chairs in dark green offer a touch of glam with easy-care luxe velvet upholstery and a Hollywood regency flavor. Rounded edges on the seat and back along with golden powder-coated legs accent this simple design that comes as a set of 2. 21&quot;W x 21.5&quot;D x 41&quot;H Easy-care fabric on wood frame with metal legs Soft, rounded edges on the seat and back These casual dining chairs with a mid-century look offer a touch of glam with luxe velvet upholstery that rests on golden powder-coated legs. Simple assembly in 15-30 minutes Vacuum or wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Luxe Velvet Dining Chair, 34.1&quot;H, Set of 2, Dark Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eKeT5QZfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3Lr-iduL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3Lr-iduL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cJzEk+abL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cJzEk+abL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1meZoxKNQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1meZoxKNQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71r477FpuLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71r477FpuLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tbSqX4t7L.jpg\",\"url\":