    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZRJSGN\",\"sku\":\"B07TZRJSGN\",\"lang\":\"en\",\"slug\":\"sophia-modern-swivel-kitchen-counter-height-stool-39-4-h-chalk-b07tzrjsgn\",\"name\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Chalk\",\"description\":\"With a substantial padded back and seat, this counter stool provides maximum comfort and swivels for easy conversation. The solid hardwood frame is sturdy and stable, and performance fabric makes it durable and easy to clean. 17.7&quot;D x 21.3&quot;W x 39.4&quot;H. Seat height is 26&quot;. 95% polyester/5% nylon on hardwood frame; solid poplar legs. Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YApkTz54L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GUZBBGgqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GUZBBGgqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CME6LAj9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CME6LAj9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vzrxyVsyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vzrxyVsyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TCRAdkStL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TCRAdkStL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZlqnIEZcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZlqnIEZcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original