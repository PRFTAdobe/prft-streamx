    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B94GH\",\"sku\":\"B07B7B94GH\",\"lang\":\"en\",\"slug\":\"cottage-wood-saddle-kitchen-bar-counter-stool-24-inch-height-creme-white-b07b7b94gh\",\"name\":\"Cottage Wood Saddle Kitchen Bar Counter Stool, 24 Inch Height, Creme White\",\"description\":\"This simple, classic wooden counter stool is offered in a distressed light blue finish. It's perfect for adding seating to a rustic or modern farmhouse kitchen, and easy to move around when you need more seating in another room. 21.5 x 45 x 31.2 inches; Seat Height: 24&quot;H Sturdy hardwoods Ideal for rustic and modern farmhouse spaces Easy to care for -- just wipe with damp cloth Assembly in 15-30 minutes Doesn't say what you need to do Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Cottage Wood Saddle Kitchen Bar Counter Stool, 24 Inch Height, Creme White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51q5+JcqX2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MBkTbS0vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MBkTbS0vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yHFbkfKZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yHFbkfKZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mp1uFwNBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mp1uFwNBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O4zYlc1AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O4zYlc1AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SveQ5rVwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SveQ5rVwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\