      "content": {
        "bytes": "{\"id\":\"B072ZP9XL1\",\"sku\":\"B072ZP9XL1\",\"lang\":\"en\",\"slug\":\"rivet-axel-lift-up-storage-wood-and-metal-side-end-table-walnut-and-black-b072zp9xl1\",\"name\":\"Rivet Axel Lift-Up Storage Wood and Metal Side End Table, Walnut and Black\",\"description\":\"This square side table has clean lines and metal legs for a modern look. A lift-up top reveals convenient storage space for concealing magazines, remote controls and other small items. 23.6&quot;L x 23.6&quot;W x 18.3&quot;H The high-quality engineered wood and sturdy metal legs create a stylish table you’ll be able to depend on for years. The moving hardware is expertly designed to smoothly lift from the back of the table, not from the center, to avoid blocking either storage compartment. Gliding, metal parts are tucked away inside the table to protect your hands and belongings. Easy assembly in 15-30 minutes. Wipes clean with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Axel Lift-Up Storage Wood and Metal Side End Table, Walnut and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jCZbCpUdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YQzQxWlfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YQzQxWlfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16crS3jCsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16crS3jCsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rJ8ie-sWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rJ8ie-sWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Iw4ytnmvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Iw4ytnmvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"23.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.3\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.6\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"42.9\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"White side table\",\"label\":\"White side table\"},{\"value\":\"White coffee table\",\"label\":\"White coffee table\"},{\"value\":\"Side table for bedroom\",\"label\":\"Side table for bedroom\"},{\"value\":\"Coffee tables for living room\",\"label\":\"Coffee tables for living room\"},{\"value\":\"Glass coffee table\",\"label\":\"Glass coffee table\"},{\"value\":\"Chairside table\",\"label\":\"Chairside table\"},{\"value\":\"Side tables for small spaces\",\"label\":\"Side tables for small spaces\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Coffee tables\",\"label\":\"Coffee tables\"},{\"value\":\"Lift top coffee table\",\"label\":\"Lift top coffee table\"},{\"value\":\"Black side table\",\"label\":\"Black side table\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"Coffee table set\",\"label\":\"Coffee table set\"},{\"value\":\"Bedside table\",\"label\":\"Bedside table\"},{\"value\":\"Square coffee table\",\"label\":\"Square coffee table\"},{\"value\":\"Gold side table\",\"label\":\"Gold side table\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Side tables living room\",\"label\":\"Side tables living room\"},{\"value\":\"Round side table\",\"label\":\"Round side table\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Side-tables\",\"label\":\"Side-tables\"},{\"value\":\"Round coffee table\",\"label\":\"Round coffee table\"},{\"value\":\"Modern coffee table\",\"label\":\"Modern coffee table\"}]}],\"cate