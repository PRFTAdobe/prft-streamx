    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4W23DL\",\"sku\":\"B07B4W23DL\",\"lang\":\"en\",\"slug\":\"bridgewater-curved-king-headboard-82-w-fresh-pewter-b07b4w23dl\",\"name\":\"Bridgewater Curved King Headboard, 82&quot;W, Fresh Pewter\",\"description\":\"This headboard adds classic style to any space. Hand-applied pewter nailhead trim accents the headboards curved silhouette. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 82&quot;W x 4&quot;D x 56&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Curved King Headboard, 82&quot;W, Fresh Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SqgFdxVyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S7hFyR8YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S7hFyR8YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S6AQEdmaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S6AQEdmaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wp1SeItJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wp1SeItJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FKofmuAGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FKofmuAGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TiwXIVG9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TiwXIVG9L.jpg\