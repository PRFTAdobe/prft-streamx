    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MMTXT\",\"sku\":\"B07B4MMTXT\",\"lang\":\"en\",\"slug\":\"jameson-farmhouse-leather-nailhead-recliner-chair-36-w-driftwood-b07b4mmtxt\",\"name\":\"Jameson Farmhouse Leather Nailhead Recliner Chair, 36&quot;W, Driftwood\",\"description\":\"Gold-finished nailhead trim takes this recliner up a notch in style. Classic rolled arms and leather upholstery bring rustic sophistication to traditional or modern farmhouse-style rooms. The leather's natural markings make each chair distinctive. 36&quot;W x 37&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 39&quot;H; Arm Height: 25.25&quot;H; Front legs: 4.25&quot;H; Back legs: 3.125&quot;H Leather upholstery on hardwood pine frame Classic roll arms and rustic nailhead trim combine for ideal modern farmhouse style Push-back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Jameson Farmhouse Leather Nailhead Recliner Chair, 36&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YQ0SlflAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819ZWMlOn5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819ZWMlOn5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l4uBLqhvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l4uBLqhvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+ZpJqfjRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+ZpJqfjRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uJiTCjZdL.jpg\",\"url\":\"https://storage.