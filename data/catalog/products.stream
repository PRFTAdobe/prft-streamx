        "bytes": "{\"id\":\"B075YZYJQN\",\"sku\":\"B075YZYJQN\",\"lang\":\"en\",\"slug\":\"rivet-eastport-industrial-wood-dresser-30-w-oak-finish-b075yzyjqn\",\"name\":\"Rivet Eastport Industrial Wood Dresser, 30&quot;W, Oak Finish\",\"description\":\"This rustic planked pine chest of drawers with an oak veneer will be a perfect addition to your master suite or any bedroom. Four drawers of storage space plus an open shelf in a modern industrial design. Durable solid wood is built to last and sustainably sourced. 30&quot;W x 17.7&quot;D x 48.8&quot;H Handcrafted from solid wood. Modern industrial design of natural pine to blend with modern and rustic styles Drawers feature wood runners and metal handles. No assembly needed. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eastport Industrial Wood Dresser, 30&quot;W, Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LJs0oNg8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U1jfqUKwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U1jfqUKwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tbuM-FtQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tbuM-FtQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qQArJ31IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qQArJ31IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wFyzTHHQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wFyzTHHQL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\