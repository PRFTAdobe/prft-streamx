    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJD1WT\",\"sku\":\"B07BWJD1WT\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-ottoman-41-w-dark-grey-tweed-b07bwjd1wt\",\"name\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot;W, Dark Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this ottoman has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 41&quot;W x 41&quot;D x 21&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Ottoman, 41&quot;W, Dark Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jTJlcZH4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aUHUwn9IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aUHUwn9IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1csuYOqo0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1csuYOqo0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vrpLTpwvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vrpLTpwvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AHIUcIMMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AHIUcIMMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qKYHd2XsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qKYHd2XsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SjhIOHdoL.jpg\",\"url\"