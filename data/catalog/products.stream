    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07JD47LW3\",\"sku\":\"B07JD47LW3\",\"lang\":\"en\",\"slug\":\"rivet-rockwood-modern-reversible-chaise-fabric-93-3-w-light-gray-b07jd47lw3\",\"name\":\"Rivet Rockwood Modern Reversible Chaise, Fabric, 93.3&quot;W, Light Gray\",\"description\":\"This reversible chaise offers contemporary spin on mid-century style, with splayed wooden legs, wooden detail work along the bottom, and comfortable polyester upholstery. It has a tight, released back and removable cushions. Overall: 93.3&quot;W x 63.4&quot;D x 33.5&quot;H; Seat Height: 18.5&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 20.5&quot;H Arm Height: 28.7&quot;H; Leg Height: 6.3&quot;H; Chaise Depth: 26.4&quot;D; Chaise Width: 33.9&quot;W Solid-wood frame and legs with 100% polyester upholstery The tight, released back and removable/reversible cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Rockwood Modern Reversible Chaise, Fabric, 93.3&quot;W, Light Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81B8n2mGA4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jmpEmBUUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jmpEmBUUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kgz6AWVLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kgz6AWVLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h0-uaMLiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h0-uaMLiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z0iKcvNIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z0iKcvNIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pur