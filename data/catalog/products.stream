    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4QMW7\",\"sku\":\"B075X4QMW7\",\"lang\":\"en\",\"slug\":\"rivet-eva-mid-century-modern-tufted-velvet-down-filled-sectional-sofa-couch-87-w-navy-b075x4qmw7\",\"name\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Sectional Sofa Couch, 87&quot;W, Navy\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted sofa featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible and is held in place by clips at the corners. 87&quot;W x 35.25''D x 30.25''H Durable polyester velvet on hardwood frame and brushed brass legs Modern elegant style with reversible cushion to extend the life of the piece Simple assembly in 15 minutes or less.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eva Mid-Century Modern Tufted Velvet Down-Filled Sectional Sofa Couch, 87&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KZp1brWYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818WXL2uM1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818WXL2uM1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P3tPyy2nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P3tPyy2nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G+LmavNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G+LmavNML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\