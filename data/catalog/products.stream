,{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Sleepers\",\"label\":\"Sleepers\"},{\"value\":\"Microfiber\",\"label\":\"Microfiber\"},{\"value\":\"Sleep\",\"label\":\"Sleep\"},{\"value\":\"Love\",\"label\":\"Love\"},{\"value\":\"Couches\",\"label\":\"Couches\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Signature\",\"label\":\"Signature\"},{\"value\":\"By\",\"label\":\"By\"},{\"value\":\"Ashley\",\"label\":\"Ashley\"},{\"value\":\"Cortinas\",\"label\":\"Cortinas\"},{\"value\":\"Ikea\",\"label\":\"Ikea\"},{\"value\":\"Honbay\",\"label\":\"Honbay\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]},{\"id\":\"Featured\",\"slug\":\"featured\",\"name\":\"Featured\",\"value\":\"Featured\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":978,\"discountedValue\":880.2}}"
