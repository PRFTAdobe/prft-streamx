    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSM5D\",\"sku\":\"B07QFRSM5D\",\"lang\":\"en\",\"slug\":\"glenwilde-queen-headboard-75-w-cream-b07qfrsm5d\",\"name\":\"Glenwilde Queen Headboard, 75&quot;W, Cream\",\"description\":\"The strong, smooth lines of this cream-colored queen-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 75&quot;W x 11&quot;D x 52&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Queen Headboard, 75&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cTWDvUSgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rMd4qI7gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rMd4qI7gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhYnXM8HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhYnXM8HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sYHUe1pgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sYHUe1pgL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"label\":\"inches