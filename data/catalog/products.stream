    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P7NVM2S\",\"sku\":\"B07P7NVM2S\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-ottoman-with-tapered-legs-31-9-w-emerald-green-b07p7nvm2s\",\"name\":\"Rivet Sloane Mid-Century Modern Ottoman with Tapered Legs, 31.9&quot;W, Emerald Green\",\"description\":\"This modern ottoman sports a strong profile and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The durable upholstery and solid-wood frame make this piece both cozy and reliable. 31.9&quot;W x 24&quot;D x 17.7&quot;H Solid wood frame and legs; 100% polyester upholstery A solid wood frame and durable fabric make this ottoman as practical as it is stylish. Tapered legs add elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Ottoman with Tapered Legs, 31.9&quot;W, Emerald Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uwu6126XL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A186KpoZggL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A186KpoZggL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UH-BeG-2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UH-BeG-2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pa0Wb1yIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pa0Wb1yIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rcqcsAY2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rcqcsAY2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eo9DldURL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81