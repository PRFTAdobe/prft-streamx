  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4ZN5\",\"sku\":\"B07QFP4ZN5\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-sofa-couch-with-wood-base-and-legs-78-w-fog-gray-b07qfp4zn5\",\"name\":\"Hillman Mid-Century Sofa Couch with Wood Base and Legs, 78&quot;W, Fog Gray\",\"description\":\"Wide, comfortable cushions are a hallmark of this mid-century inspired sofa. Easy-care gray upholstery and reversible back cushions help keep this piece looking fresh. A hardwood frame connects to tapered wood legs and lends structure to the foam-padded cushions. High arms give additional support. 78&quot;W x 38&quot;D x 33&quot;H; seat height: 18&quot;H; seat depth: 21&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 8&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Removable and reversible back and throw cushions Classic shape and plush cushions make this sofa work in a variety of decors. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Sofa Couch with Wood Base and Legs, 78&quot;W, Fog Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FB4B3c9LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KcHAp0iCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KcHAp0iCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PUTmGK61L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PUTmGK61L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DsTQKEykL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DsTQKEykL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wvckPjttL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wvckPjttL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v+NyoRJfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v+NyoRJfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.38\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"77.95\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"112.2\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Hide\",\"label\":\"Hide\"},{\"value\":\"Facing\",\"label\":\"Facing\"},{\"value\":\"Pull\",\"label\":\"Pull\"},{\"value\":\"Chaise\",\"label\":\"Chaise\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Size\",\"label\":\"Size\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Modular\",\"label\":\"Modular\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Corner\",\"label\":\"Corner\"},{\"value\":\"French\",\"label\":\"French\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Pillows\",\"label\":\"Pillows\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"Script\",\"label\":\"Script\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Rooms\",\"label\":\"Rooms\"},{\"value\":\"Out\",\"label\":\"Out\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Sl