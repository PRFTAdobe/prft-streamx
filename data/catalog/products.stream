        "bytes": "{\"id\":\"B07BWJCPWR\",\"sku\":\"B07BWJCPWR\",\"lang\":\"en\",\"slug\":\"rivet-emerly-modern-sofa-chaise-96-w-pewter-b07bwjcpwr\",\"name\":\"Rivet Emerly Modern Sofa Chaise, 96&quot;W, Pewter\",\"description\":\"Hardwood frame with sturdy mortise-and-tenon joints, performance fabric, metal legs Overall: 96&quot;W x 35&quot;D x 34&quot;H; seat height: 19.5&quot;H; seat depth: 28&quot;D; seat back height: 27.5&quot;H; arm height: 27.5&quot;H; leg height: 6&quot;H; chaise depth: 64&quot;D; chaise width: 34&quot;W Wood, 100% polyester fabric, foam, metal Contemporary Reversible cushions double the lifespan of this piece Simple assembly. Just attach the legs. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Emerly Modern Sofa Chaise, 96&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81buve2-RVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8reP5NcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8reP5NcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FtdmgwafL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FtdmgwafL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17zND8tU3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17zND8tU3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71evbDzlLOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71evbDzlLOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ap3rW0tSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ap3rW0tSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51yxGEJOmtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/or