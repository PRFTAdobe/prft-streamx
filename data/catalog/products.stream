    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TYTR8M3\",\"sku\":\"B07TYTR8M3\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-leather-bar-stool-with-gold-accents-41-h-light-brown-b07tytr8m3\",\"name\":\"Rivet Whit Contemporary Leather Bar Stool with Gold Accents, 41&quot;H, Light Brown\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous light brown leather, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 41&quot;H; Seat Height: 30&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Leather Bar Stool with Gold Accents, 41&quot;H, Light Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IOdgKWfbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715R1dxaugL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715R1dxaugL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UqJXqYt-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UqJXqYt-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7165Zt-2YAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7165Zt-2YAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715aXsskVCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715aXsskVCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-