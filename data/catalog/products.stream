    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MRJ6Z\",\"sku\":\"B07B4MRJ6Z\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-38-w-grey-linen-b07b4mrj6z\",\"name\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Grey Linen\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 38&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EON1aOz2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918-S688tLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918-S688tLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913b9xK260L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913b9xK260L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NTgeZ4Z4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NTgeZ4Z4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u5XZDlS4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u5XZDlS4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9174P21whkL.jpg\",\"url\