    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X463MJ\",\"sku\":\"B075X463MJ\",\"lang\":\"en\",\"slug\":\"rivet-modern-oversized-upholstered-square-ottoman-38-w-platinum-b075x463mj\",\"name\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Platinum\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Oversized Upholstered Square Ottoman, 38&quot;W, Platinum\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JnW8DHcxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hv1EmUW9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hv1EmUW9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iS9iucajL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iS9iucajL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15phXer71L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15phXer71L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qpN-cYIoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qpN-cYIoL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"