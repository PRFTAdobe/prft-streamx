    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X65R45\",\"sku\":\"B075X65R45\",\"lang\":\"en\",\"slug\":\"cameron-classic-oversized-chair-32-w-dove-b075x65r45\",\"name\":\"Cameron Classic Oversized Chair, 32&quot;W, Dove\",\"description\":\"This item is made to order just for you 32&quot;W x 36&quot;D x 37&quot;H. Seat height is 21&quot;. Solid wood frame and legs, 100% polyester upholstery, metal with nickel finish Tight seat and back crafted to endure heavy wear. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty. Add some elegance to your living room with this oversized accent chair. With its smooth fabric on rolled arms and back, it exudes classic high style. Turned spindle wood legs on coated nickel casters makes it easy to move from room to room.\",\"primaryImage\":{\"alt\":\"Cameron Classic Oversized Chair, 32&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zdbxD-hNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TwEhnogkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TwEhnogkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91it1fESj1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91it1fESj1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lgy2wXYkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lgy2wXYkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gbaZeMvJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gbaZeMvJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sPGkAdGPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sPGkAdGPL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\