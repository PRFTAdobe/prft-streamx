    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B79GMHH\",\"sku\":\"B07B79GMHH\",\"lang\":\"en\",\"slug\":\"cottage-wood-saddle-kitchen-bar-counter-stool-24-inch-height-blue-b07b79gmhh\",\"name\":\"Cottage Wood Saddle Kitchen Bar Counter Stool, 24 Inch Height, Blue\",\"description\":\"This simple, classic wooden counter stool is offered in a distressed light blue finish. It's perfect for adding seating to a rustic or modern farmhouse kitchen, and easy to move around when you need more seating in another room. 18&quot;W x 9.5&quot;D x 24&quot;H; Seat Height: 24&quot;H Sturdy hardwoods Ideal for rustic and modern farmhouse spaces Easy to care for -- just wipe with damp cloth Assembly in 15-30 minutes Doesn't say what you need to do Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Cottage Wood Saddle Kitchen Bar Counter Stool, 24 Inch Height, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nuCpCq5zL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-U6Xiu4nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-U6Xiu4nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yl1zFAESL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yl1zFAESL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x4FukD4zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x4FukD4zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HV0y4bXUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HV0y4bXUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pcBZ3icWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pcBZ3icWL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.0\",\"label\