    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07K6H2P7G\",\"sku\":\"B07K6H2P7G\",\"lang\":\"en\",\"slug\":\"mattress-foundation-smart-box-spring-for-full-size-bed-tool-free-easy-assembly-5-inch-full-b07k6h2p7g\",\"name\":\"Mattress Foundation / Smart Box Spring for Full Size Bed, Tool-Free Easy Assembly - 5-Inch, Full\",\"description\":\"Offers the look and functionality of a traditional box spring, but made from steel for longer-lasting durability sturdy enough to support any spring, foam, or hybrid mattress Durable steel frame and horizontal slats provide sturdy, reliable support for any same-size mattress 2-piece fabric top and bottom covers zip securely together for full coverage; cover is removable for spot cleaning Easy Assembly: New frame construction allows for easy assembly in minutes with no tools required Foldable steel frame to be packed in one smart package and faster delivery to your front Measures 5 inches deep; backed by an AmazonBasics 1-year limited warranty\",\"primaryImage\":{\"alt\":\"Mattress Foundation / Smart Box Spring for Full Size Bed, Tool-Free Easy Assembly - 5-Inch, Full\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J1zEvsM5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VRhQaG8QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VRhQaG8QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VHxyC1NzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VHxyC1NzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NILQDoxxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NILQDoxxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NWxdmeowL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NWxdmeowL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pures