    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MXKVQB\",\"sku\":\"B084MXKVQB\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-solid-wood-headboard-queen-64-w-natural-finish-b084mxkvqb\",\"name\":\"Modern Farmhouse Solid Wood Headboard, Queen, 64&quot;W, Natural Finish\",\"description\":\"This solid pine headboard has a natural finish that lets the beauty of the wood shine through. Made from recycled pine, this rustic headboard will complement your bedroom and blend seamlessly with farmhouse or contemporary decor. 64&quot;W x 3&quot;D x 45&quot;H Recycled pine Predrilled holes allow for easy connection to most metal bed frames. Made of recycled pine, each headboard is unique and slightly different from the next. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Solid Wood Headboard, Queen, 64&quot;W, Natural Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wawwtreQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71S+Z-uXyYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71S+Z-uXyYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NamsE0InL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NamsE0InL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qGnjAbM4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qGnjAbM4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81si39pyumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81si39pyumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eEBTQwMmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eEBTQwMmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714cXgvaqeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714cXgvaqeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"45.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"2.76\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"63.19\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"41.41\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Solid\",\"label\":\"Solid\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":585,\"discountedValue\":526.5}}"
