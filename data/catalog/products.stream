    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KTNN8\",\"sku\":\"B0853KTNN8\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-dining-chair-set-of-2-19-3-w-silver-b0853ktnn8\",\"name\":\"Rivet Eli Modern Curved-Back Dining Chair, Set of 2, 19.3&quot;W, Silver\",\"description\":\"Powerful in its simplicity, each chair is fully upholstered with a curved, supportive back and sturdy wood legs. Soft, rounded edges give these chairs a sculptural quality that makes them a charming addition to any room. 19.3&quot;W x 23.2&quot;D x 33.1&quot;H; seat height: 18.9&quot;H; seat depth: 16.9&quot;D; seat back height: 17.7&quot;H; leg height: 15.4&quot;H Solid wood frame with 100% polyester fabric The solid wood frame is well cushioned and fully upholstered. Set of 2 lovely mid-Century inspired chairs are both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Dining Chair, Set of 2, 19.3&quot;W, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719u57z6VTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Cr1okepfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Cr1okepfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7121vN9fXIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7121vN9fXIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HlmsOITeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HlmsOITeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61FzO3rPSLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61FzO3rPSLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Kz+idJhqL.jpg\",\"url\":\"htt