      "content": {
        "bytes": "{\"id\":\"B075YP4WVQ\",\"sku\":\"B075YP4WVQ\",\"lang\":\"en\",\"slug\":\"sophia-modern-swivel-kitchen-bar-stool-43-3-h-merlot-b075yp4wvq\",\"name\":\"Sophia Modern Swivel Kitchen Bar Stool, 43.3&quot;H, Merlot\",\"description\":\"With a substantial padded back and seat, this bar stool provides maximum comfort -- and it swivels! The solid hardwood frame is sturdy and stable, and performance fabric makes it durable and easy to clean. 17.7&quot;D x 21.3&quot;W x 43.3&quot;H. Seat height is 30 inches. 95% polyester/5% nylon on hardwood frame; solid poplar legs. Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Swivel Kitchen Bar Stool, 43.3&quot;H, Merlot\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61+H8ylAvNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zQikfTkoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zQikfTkoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kikwsQQDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kikwsQQDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pdKc6q9HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pdKc6q9HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UWF1C77KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UWF1C77KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-8wfbYYHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-8wfbYYHL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"43.3\",\"label\":\"inches\"}]},{\"na