    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGG24Z2\",\"sku\":\"B07QGG24Z2\",\"lang\":\"en\",\"slug\":\"industrial-table-with-trestle-style-base-60-04-w-solid-honey-finished-mango-wood-b07qgg24z2\",\"name\":\"Industrial Table with Trestle-Style Base, 60.04&quot;W, Solid Honey-Finished Mango Wood\",\"description\":\"The trestle-style base of this decorative table, made of solid mango, offers a stylish look and durability, while touting rasped boards for a beautiful texture on top. The width provides versatility in placement. An industrial piece, this table looks great with farmhouse decor. 60.04&quot;W x 15.94&quot;D x 31.89&quot;H This table, constructed of solid mango, comes with a rasped top that is sanded smooth. The industrial flavor of this piece adds beauty to the versatile and classic farmhouse style. Functionality is increased by the planked top and trestle-style base. Assemble in 15 minutes or less Wipe with a soft, damp cloth; dry thoroughly. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Table with Trestle-Style Base, 60.04&quot;W, Solid Honey-Finished Mango Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Mj-ALEXeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OQk82jD0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OQk82jD0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jbw7kKpgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jbw7kKpgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-FVBNJuJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-FVBNJuJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wcZ8AsURL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wcZ8AsURL.jpg\"},{\"alt\":\"https://storage.google