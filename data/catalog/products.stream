    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4HZQM\",\"sku\":\"B075X4HZQM\",\"lang\":\"en\",\"slug\":\"leila-tufted-sofa-88-w-charcoal-b075x4hzqm\",\"name\":\"Leila Tufted Sofa, 88&quot; W, Charcoal\",\"description\":\"This item is made to order just for you 88&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look sofa. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Three removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Sofa, 88&quot; W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CU0WhmykL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KJzKLp6SS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KJzKLp6SS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9166ZGRzzBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9166ZGRzzBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1urtD1tS+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1urtD1tS+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":