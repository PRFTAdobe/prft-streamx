    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JYVBP\",\"sku\":\"B0857JYVBP\",\"lang\":\"en\",\"slug\":\"beech-wishbone-counter-height-barstool-38-2-h-natural-b0857jyvbp\",\"name\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Natural\",\"description\":\"The graceful curves of this natural-colored beech barstool mask its everyday durability. It's light, portable, and perfect for any place in the house where there's a countertop. The soft, comfortable woven paper-rope seat is 100% natural. 22.4&quot;W x 22.8&quot;D x 38.2&quot;H Beech frame with a woven seat The sturdy beech frame will stand the test of time, while the soft woven paper-rope seat is easy to sink into. Simple but fashionable, this natural-colored wishbone-style curved design adds sophistication to any counter area. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71U1W1pCDXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kPymEW43L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kPymEW43L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7145dXVlflL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7145dXVlflL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YdVo-gNLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YdVo-gNLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wAomaNNbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wAomaNNbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71emPC21AML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pi