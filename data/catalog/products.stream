        "bytes": "{\"id\":\"B07DBB7831\",\"sku\":\"B07DBB7831\",\"lang\":\"en\",\"slug\":\"ravenna-home-angela-modern-turned-wood-leg-side-table-nightstand-20-w-grey-b07dbb7831\",\"name\":\"Ravenna Home Angela Modern Turned Wood Leg Side Table Nightstand, 20&quot;W, Grey\",\"description\":\"Solid pine and medium-density fibreboard With a handy lower shelf, this end table can hold a lamp, favorite photos and magazines Traditional style with turned legs 15-30 minutes assembly required Free returns for 30 days. 1-year warranty. 20&quot;L x 18&quot;W x 22&quot;H\",\"primaryImage\":{\"alt\":\"Ravenna Home Angela Modern Turned Wood Leg Side Table Nightstand, 20&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fLSXrMsQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j5Hjxm70L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j5Hjxm70L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fdPyXV-jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fdPyXV-jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fycHMoIWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fycHMoIWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Xi0VZQb2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Xi0VZQb2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-iGeHf6KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-iGeHf6KL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"18.0\",