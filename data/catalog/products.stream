    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L5DJV\",\"sku\":\"B07B4L5DJV\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-loveseat-leather-65-w-saddle-b07b4l5djv\",\"name\":\"Rivet Edgewest Modern Loveseat, Leather, 65&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; individual pieces can be configured in many ways Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you. Overall: 65&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Loveseat, Leather, 65&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jxWwk0hqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61p3QnlIDAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61p3QnlIDAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gp6MYiQhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gp6MYiQhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jI396ZKkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jI396ZKkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kZ-KbcPjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kZ-KbcPjL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"labe