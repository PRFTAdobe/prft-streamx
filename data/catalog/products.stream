        "bytes": "{\"id\":\"B075X43FJ7\",\"sku\":\"B075X43FJ7\",\"lang\":\"en\",\"slug\":\"marin-upholstered-ottoman-29-w-sandstone-b075x43fj7\",\"name\":\"Marin Upholstered Ottoman, 29&quot;W, Sandstone\",\"description\":\"This item is made to order just for you 29&quot;W x 23&quot;D x 21&quot;H Sturdy hardwood frame with durable performance fabric upholstery Firm nylon webbing makes cushion resilient Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Sit back, relax, and prop up your feet on this plush ottoman. This sophisticated yet practical addition to your home can be an extra seat or place to set a tray of snacks. The sturdy frame and upholstery will last for many years.\",\"primaryImage\":{\"alt\":\"Marin Upholstered Ottoman, 29&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919XkculVnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bv6JXmkJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bv6JXmkJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnYdLAFXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnYdLAFXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913AVn-WvyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913AVn-WvyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cMmwg1Q4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cMmwg1Q4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"