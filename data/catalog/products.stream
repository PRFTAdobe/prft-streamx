    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSBD6TF\",\"sku\":\"B07HSBD6TF\",\"lang\":\"en\",\"slug\":\"rivet-weedin-contemporary-velvet-dining-kitchen-chair-33-inch-height-set-of-2-rouge-red-b07hsbd6tf\",\"name\":\"Rivet Weedin Contemporary Velvet Dining Kitchen Chair 33 Inch Height, Set of 2, Rouge Red\",\"description\":\"The gorgeous rouge asymmetrical weave pattern of this contemporary dining chair pairs perfectly with the sleek rounded design to make a truly modern statement of style and sophistication. Smooth black metal legs complete the motif and lend sturdy support to the cushioned wooden frame. Metal legs lend extra support to the solid wooden frame. Avoid moisture. Wipes clean with soft, dry cloth. 23&quot;D x 20&quot;W x 33&quot;H Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Weedin Contemporary Velvet Dining Kitchen Chair 33 Inch Height, Set of 2, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716wjyEfVaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a73GCV2KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a73GCV2KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QUWWufawL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QUWWufawL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+O+UXsfXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+O+UXsfXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12ROn4Or+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12ROn4Or+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A176Ye5nDOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A176Ye5nDOL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\