    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085FHVGW9\",\"sku\":\"B085FHVGW9\",\"lang\":\"en\",\"slug\":\"ravenna-home-contemporary-swivel-glider-recliner-chair-33-9-w-black-b085fhvgw9\",\"name\":\"Ravenna Home Contemporary Swivel Glider Recliner Chair, 33.9&quot;W, Black\",\"description\":\"33.9&quot;W x 37.8&quot;D x 37.8&quot;H; seat height: 19.7&quot;H; seat depth: 19.7&quot;D Plywood frame with strong reclining mechanism, flat arms, and solid performance seat cushion and backrest cushion Recliner has a swivel glide that rotates 360 degrees. Assemble in 15 minutes or less Indoor use only; avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Contemporary Swivel Glider Recliner Chair, 33.9&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WfE1RgcfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iAwOiAqKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iAwOiAqKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r8xDLcVqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r8xDLcVqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o0q5ANIuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81o0q5ANIuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KhSKIzbqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KhSKIzbqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fb3nWDCdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fb3nWDCdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JK9XrBSXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JK9XrBSXL