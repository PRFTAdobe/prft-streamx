    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B8B3NPQ\",\"sku\":\"B07B8B3NPQ\",\"lang\":\"en\",\"slug\":\"rivet-2-tiered-modern-kitchen-rolling-bar-cart-with-wheels-32-3-w-natural-gold-b07b8b3npq\",\"name\":\"Rivet 2-Tiered Modern Kitchen Rolling Bar Cart with Wheels, 32.3&quot;W, Natural, Gold\",\"description\":\"This two-tiered rolling bar cart combines the warmth of natural wood with elegant gold-finished metal framing for a touch of glam. Rolling wheels make it easy to move, and two wheel locks allow you to keep it in place. Fill with your favorite beverages and you're ready to host friends for a night of fun. 32.31&quot;W x 15.76&quot;D x 27.78&quot;H Hardwood shelves. Metal trim, frame and wheel casters have a gold finish. Two of the four rotating wheels lock to park the cart just where you want it This versatile piece functions as a mobile bar cart or as an accent table for potted plants or decor Some assembly required. Clean with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet 2-Tiered Modern Kitchen Rolling Bar Cart with Wheels, 32.3&quot;W, Natural, Gold\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h13j0ptIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919qXWAWp1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919qXWAWp1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p4S637wTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p4S637wTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aFqMVQAeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aFqMVQAeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DpmFJLEuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DpmFJLEuL.jpg\"},{\"alt\":\"https://storage.google