    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8ST791\",\"sku\":\"B07P8ST791\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-top-grain-leather-loveseat-sofa-with-removable-cushions-67-w-black-b07p8st791\",\"name\":\"Rivet Andrews Contemporary Top-Grain Leather Loveseat Sofa with Removable Cushions, 67&quot;W, Black\",\"description\":\"This love seat features removable cushions in an attractive black leather that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 67&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable back and seat cushions Contemporary style and top grain leather combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Top-Grain Leather Loveseat Sofa with Removable Cushions, 67&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71w37WvA9YL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b30n1WU1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b30n1WU1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TM6u8lovL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TM6u8lovL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vle12F5eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vle12F5eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712LLzxpZdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712LLzxpZdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816BSqax-rL.jpg\",\"url\":\"https://s