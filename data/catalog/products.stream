    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMBHXV\",\"sku\":\"B07QCMBHXV\",\"lang\":\"en\",\"slug\":\"faraday-down-filled-casual-loveseat-75-w-light-grey-b07qcmbhxv\",\"name\":\"Faraday Down-Filled Casual Loveseat, 75&quot;W, Light Grey\",\"description\":\"This modern love seat comes with removable and reversible down-filled cushions for comfort. Roomy seating is nice with company or family, and the neutral tone matches most decor, making it a great choice for any room. The luxury of a cotton-blend upholstery helps keep everyone cool through the summer. 75&quot; Width x 43&quot; Depth x 33&quot; Height Solid hardwood frame with down-filled seat and back cushions Removable and reversible cushions This casual love seat offers down-filled cushions and a seat depth of 43&quot; for extra comfort. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Faraday Down-Filled Casual Loveseat, 75&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VnK2JqETL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DVMZAI4gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DVMZAI4gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hH11bE2sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hH11bE2sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811Pa2EPtsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811Pa2EPtsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DImOTHZQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DImOTHZQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PAQPKJ45L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori