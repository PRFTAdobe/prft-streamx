    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ3BH9\",\"sku\":\"B07QCQ3BH9\",\"lang\":\"en\",\"slug\":\"merrill-queen-headboard-with-decorative-nailhead-trim-75-w-pearl-b07qcq3bh9\",\"name\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Pearl\",\"description\":\"This chic pearl-colored queen-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 75&quot;W x 11&quot;D x 52&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719-EGyPm0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rQv0IC5cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rQv0IC5cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nz82mSCpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nz82mSCpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Oax2dKmIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Oax2dKmIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",