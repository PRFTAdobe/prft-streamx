        "bytes": "{\"id\":\"B072JG3W45\",\"sku\":\"B072JG3W45\",\"lang\":\"en\",\"slug\":\"kristin-round-arm-performance-fabric-loveseat-sofa-couch-88-w-sand-b072jg3w45\",\"name\":\"Kristin Round Arm Performance Fabric Loveseat Sofa Couch, 88&quot;W, Sand\",\"description\":\"This inviting sofa will be the center of many get-togethers with family and friends. With a classic style and durable build, no one will be able to resist sitting down and relaxing in all-out comfort. 88&quot;W x 37&quot;D x 37.5&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Modern casual Classic style designed for heavy-duty use No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Round Arm Performance Fabric Loveseat Sofa Couch, 88&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nx2+1qUpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v3733s2fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v3733s2fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TrFKXR21L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TrFKXR21L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XCJXrDEQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1XCJXrDEQS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1afMD57ROS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1afMD57ROS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"labe