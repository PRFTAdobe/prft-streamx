    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L9FHL\",\"sku\":\"B07B4L9FHL\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-accent-chair-34-w-grey-linen-b07b4l9fhl\",\"name\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Grey Linen\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 34&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pOmRMxoJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19be0vpRbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19be0vpRbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Fov+6iGmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Fov+6iGmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cIn2+kPnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cIn2+kPnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1K7zr13PjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1K7zr13PjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-im