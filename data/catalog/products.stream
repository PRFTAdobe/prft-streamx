    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07CB5GWKR\",\"sku\":\"B07CB5GWKR\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-u-sectional-117-w-eclipse-blue-b07cb5gwkr\",\"name\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Eclipse Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester/linen blend fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Eclipse Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VJVNVVrxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BrZjZADUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BrZjZADUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b+1gsUMNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b+1gsUMNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FikcvzSiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FikcvzSiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lOb2N1tqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lOb2N1tqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IGhI24dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IGhI24dA