    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YNQ7TC\",\"sku\":\"B075YNQ7TC\",\"lang\":\"en\",\"slug\":\"rivet-wide-cushion-mid-century-modern-top-grain-leather-set-of-2-accent-dining-room-table-chairs-26-8-w-brown-b075ynq7tc\",\"name\":\"Rivet Wide Cushion Mid-Century Modern Top-Grain Leather Set of 2 Accent Dining Room Table Chairs, 26.8&quot;W, Brown\",\"description\":\"These wide Mid-century modern chairs stand out with their deep seats and top-grain leather. Clean lines and sturdy tapered legs give them a handsome presence at a dining room table, in a living area or behind a desk. 26.8&quot;W x 23.2&quot;D x 32.2&quot;H Top-grain leather; Solid hardwood frame and legs Foam padding and elastic suspension system keep back and seat firm Easy assembly in 15 minutes. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Wide Cushion Mid-Century Modern Top-Grain Leather Set of 2 Accent Dining Room Table Chairs, 26.8&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p-6pyQKxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KKjKeg5GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KKjKeg5GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17QbSAOJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17QbSAOJmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12uTetADpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12uTetADpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12PYjOvPdS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12PYjOvPdS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HwI4pNFDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91