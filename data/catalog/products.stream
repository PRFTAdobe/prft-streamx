        "bytes": "{\"id\":\"B07HZ6GJC2\",\"sku\":\"B07HZ6GJC2\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-loveseat-fabric-52-w-linen-b07hz6gjc2\",\"name\":\"Bagley Sectional Component, Right Facing Loveseat, Fabric, 52&quot;W, Linen\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing loveseat component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 52&quot;W x 40&quot;D x 36&quot;H; seat height: seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right Facing Loveseat, Fabric, 52&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ArlPn-gUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bX2Aj-eSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bX2Aj-eSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GpKKMmZWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GpKKMmZWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SA9HWdsGL.jpg\",\"url\":\"https://storage.googleapis.com/puresi