    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCY5SV\",\"sku\":\"B082QCY5SV\",\"lang\":\"en\",\"slug\":\"rivet-new-luna-upholstered-crescent-mid-century-accent-chair-with-tapered-legs-31-5-w-teal-b082qcy5sv\",\"name\":\"Rivet New Luna Upholstered Crescent Mid-Century Accent Chair with Tapered Legs, 31.5&quot;W, Teal\",\"description\":\"A sturdy frame of solid wood and wooden tapered legs form the base of this classic mid-century accent chair. Foam padding provides cushioned support. Soft teal upholstery creates a comfortable place to sit and gives the piece a vibrant color that will be at home in any living space. 31.5&quot;W x 35&quot;D x 36.6&quot;H; seat height: 18.1&quot;H; seat depth: 21.3&quot;D; seat back height: 27.6&quot;H; arm height: 24.4&quot;H; leg height: 9.1&quot;H Solid wood frame This handy and beautiful accent chair offers extra seating for surprise guests. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet New Luna Upholstered Crescent Mid-Century Accent Chair with Tapered Legs, 31.5&quot;W, Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nOFu074uL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j4AhV8UkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j4AhV8UkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EN+skawSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EN+skawSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EYX9UA8ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EYX9UA8ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MRqZeN90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MRqZeN90L.jpg\"},{\"alt\":\"https://stor