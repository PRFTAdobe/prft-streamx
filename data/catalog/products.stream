    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D86J6\",\"sku\":\"B07B4D86J6\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-adjustable-headrest-leather-loveseat-sofa-77-5-w-black-leather-b07b4d86j6\",\"name\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Loveseat Sofa, 77.5&quot;W, Black Leather\",\"description\":\"This leather sofa isn't just handsomely styled; it's cleverly functional, too. A headrest across the back adjusts upright for watching TV, then tilts back when you're ready to relax. Compactly sized for smaller spaces, it features modern metal legs. 77.5&quot;W x 39.3&quot;D x 37&quot;H; Seat Height: 16.9&quot;H ; Seat Depth: 21.2&quot;D; Seat Back Height: 17.77&quot;H; Arm Height: 23.2&quot;H; Leg Height: 5.5&quot; Seat and back cushions feature top grain leather; side and back of sofa are split leather Clean lines and streamlined design is thoroughly contemporary Unique headrest feature adjusts upward and backward Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Loveseat Sofa, 77.5&quot;W, Black Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oLg7vFdeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eBe-ISogL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eBe-ISogL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KmqXn5l8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KmqXn5l8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81roRWPQRWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/