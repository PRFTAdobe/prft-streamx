    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QG3JVF\",\"sku\":\"B075QG3JVF\",\"lang\":\"en\",\"slug\":\"rivet-payton-mid-century-modern-tufted-king-bed-with-headboard-82-w-natural-b075qg3jvf\",\"name\":\"Rivet Payton Mid-Century Modern Tufted King Bed with Headboard, 82&quot; W, Natural\",\"description\":\"This bed is as functional as it is elegant. Subtle tufting in the herringbone fabric gives the headboard and footboard distinctive style. Four drawers underneath provide the perfect place for hiding Christmas gifts or storing off-season clothing. 89.4&quot;L x 82&quot;W x 59.8&quot;H 100% polyester fabric Mid-century modern-inspired design with subtle tufting Two drawers on each side are preassembled and easy to slide in Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. No box spring required; mattress sold seperately Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Payton Mid-Century Modern Tufted King Bed with Headboard, 82&quot; W, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xVUzCKLpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rDreKeDmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rDreKeDmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WK4jfVpkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WK4jfVpkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19MNuhpzfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19MNuhpzfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1krgOHY00L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1krgOHY00L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n9UgcuB+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n9UgcuB+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"59.83\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"89.375\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"82.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"131.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Natural\",\"label\":\"Natural\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Natural herringbone\",\"label\":\"Natural herringbone\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Kids twi