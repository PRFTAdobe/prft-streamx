{
  "key": "pim:B0853L515S",
  "action": "publish",
  "eventTime": null,
  "properties": {
    "sx:type": "data/product"
  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L515S\",\"sku\":\"B0853L515S\",\"lang\":\"en\",\"slug\":\"rivet-lundberg-contemporary-upholstered-barstool-with-brass-legs-44-5-h-juniper-b0853l515s\",\"name\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Juniper\",\"description\":\"Comfort and style meet in this contemporary barstool. Feather-filled cushions and open sides provide maximum comfort, while the juniper-colored upholstery and brass legs display a spare, contemporary style. These barstools coordinate well with any modern interior decor. Solid wood frame; feather-filled upholstered cushions; brass base Classic brass legs and footrest, plus the open sides, allow for maximum freedom of movement. Feather-filled cushion provides comfort and a contemporary look at the same time. Classic brass metal base has a footrest for added stability. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty 18.1&quot;W x 22.4&quot;D x 44.5&quot;H; seat height: 29.9&quot;H; seat depth: 12.6&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Juniper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pzH9WbLdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MRqZeN90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MRqZeN90L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ugWseb7ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ugWseb7ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F4hRLrEML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F4hRLrEML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F5DJf5BrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F5DJf5BrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gr76bFllL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gr76bFllL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fCyxb8nzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fCyxb8nzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q0s28lEqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q0s28lEqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zsLCHlyLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zsLCHlyLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"44.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"18.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"22.046\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"24\",\"label\":\"24\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Backs\",\"label\":\"Backs\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Creeper\",\"label\":\"Creeper\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Tractor\",\"label\":\"Tractor\"},{\"value\":\"Automotive\",\"label\":\"Automotive\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Bancos\",\"label\":\"Bancos\"},{\"value\":\"Counter\",\"label\":\"Counter\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Inches\",\"label\":\"In