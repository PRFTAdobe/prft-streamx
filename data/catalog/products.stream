    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ23T42\",\"sku\":\"B07QJ23T42\",\"lang\":\"en\",\"slug\":\"leather-dining-chair-with-deep-tufting-42-h-cognac-queen-b07qj23t42\",\"name\":\"Leather Dining Chair with Deep Tufting, 42&quot;H, Cognac, Queen -\",\"description\":\"Deep tufting creates texture and depth on this traditional dining chair. The brass nail design creates a contrast with cognac-colored upholstery. Leather upholstery fabric repels both water and stains, making the chair simple to care for. The chair is supported by a durable hardwood frame. 23&quot;W x 26&quot;D x 42&quot;H; seat height: 20&quot;H; seat depth: 18&quot;D; seat back height: 22&quot;H Solid wood frame; top grain leather Classic design, deep tufting, and brass nails No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leather Dining Chair with Deep Tufting, 42&quot;H, Cognac, Queen -\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jywfoT3fL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UHp63PB5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UHp63PB5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iJ8kVw6hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iJ8kVw6hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qLiqJ8aNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qLiqJ8aNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhT+SMDzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QhT+SMDzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q+NBeur9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q+NBeur9L.jpg\"}],\"attributes\