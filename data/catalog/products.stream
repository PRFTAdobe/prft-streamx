    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MRJ6F\",\"sku\":\"B07B4MRJ6F\",\"lang\":\"en\",\"slug\":\"andover-leather-loveseat-sofa-67-w-driftwood-b07b4mrj6f\",\"name\":\"Andover Leather Loveseat Sofa, 67&quot;W, Driftwood\",\"description\":\"Complete your living space with this stylish loveseat. With its driftwood-colored upholstery, this loveseat is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this loveseat’s life. Overall: 67&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Loveseat Sofa, 67&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W8lVZ0LVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710UBoAV3DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710UBoAV3DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fsQ8PCGUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fsQ8PCGUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k5+dJFIiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71k5+dJFIiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ozXn-RAUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ozXn-RAUL.jpg\"},{\"a