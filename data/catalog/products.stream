    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STB67\",\"sku\":\"B07P8STB67\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-top-grain-leather-chair-with-removable-cushions-40-w-black-b07p8stb67\",\"name\":\"Rivet Andrews Contemporary Top-Grain Leather Chair with Removable Cushions, 40&quot;W, Black\",\"description\":\"This chair features removable cushions in an attractive black leather that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 40&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable back and seat cushions Contemporary style and top grain leather combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Top-Grain Leather Chair with Removable Cushions, 40&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vo4Q6ieBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pu+odvCJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pu+odvCJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KYviIYvyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KYviIYvyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sc4nvu9KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sc4nvu9KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MLXSzudiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MLXSzudiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816BSqax-rL.jpg\",\"url\":\"https://storage.googleapis.com/puresi