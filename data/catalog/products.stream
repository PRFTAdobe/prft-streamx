    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2X4MB\",\"sku\":\"B075X2X4MB\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-loveseat-58-w-charcoal-b075x2x4mb\",\"name\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Charcoal\",\"description\":\"This item is made to order just for you Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. 58&quot;W x 34&quot;D x 34&quot;H No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11U0yTJhxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FZC4pKwML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FZC4pKwML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xoNg34SdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xoNg34SdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914FlUOL6PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914FlUOL6PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1e4Z5JJOAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1e4Z5JJOAS.jpg\"}],\"attribute