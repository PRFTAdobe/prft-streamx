    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4CXVB8\",\"sku\":\"B07B4CXVB8\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-38-w-pewter-b07b4cxvb8\",\"name\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Pewter\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 38&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Cotton/polyester blend fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sKhEiWMdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910UZFtGGrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910UZFtGGrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FPb587tBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FPb587tBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RkmchYqXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RkmchYqXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OJrKRMIVL.jpg\",\"url