    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMDFXN\",\"sku\":\"B082VMDFXN\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-leather-loveseat-sofa-64-w-cognac-b082vmdfxn\",\"name\":\"Rivet Alonzo Contemporary Leather Loveseat Sofa, 64&quot;W, Cognac\",\"description\":\"A single bench cushion brings visual unity and gently sloping armrests give it a sleek, comfortable style. With a solid-wood frame and strong brass legs, this love seat offers durability and elegance. Overall: 63.8&quot;W x 37.8&quot;D x 35.4&quot;H. Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and genuine leather upholstery Bench seat cushion with removable back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Leather Loveseat Sofa, 64&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mm8UJrQQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TMj7pw69L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TMj7pw69L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pc3J5MtdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pc3J5MtdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q2qTU3OpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q2qTU3OpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pOGztr2yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pOGztr2yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lp7-a-qSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lp7-a-qSL.jpg\"},{\"alt\":\"https://sto