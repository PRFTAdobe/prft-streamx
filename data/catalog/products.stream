    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X61W74\",\"sku\":\"B075X61W74\",\"lang\":\"en\",\"slug\":\"sadie-living-room-wingback-accent-chair-33-w-indigo-blue-plaid-b075x61w74\",\"name\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Indigo Blue Plaid\",\"description\":\"The classic wingback chair gets a modern refresh with neutral upholstery in Indigo Blue Plaid. Made to order in the United States of partially imported materials, it features a sturdy wood frame, tall tapered legs, and durable, tightly woven fabric. Sturdy wood frame and legs; hard-wearing fabric with reversible seat cushion for durability; no assembly required Product Dimensions: 33&quot;W x 38&quot;D x 41&quot;H Care Instructions: Avoid moisture; wipe down with a clean, soft cloth Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Indigo Blue Plaid\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11Sxifq8ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y7eBQf7KS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y7eBQf7KS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ru7XL3gvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ru7XL3gvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ez4YeEOgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ez4YeEOgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n03s7-rSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n03s7-rSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bzqE0ESqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bzqE0ESqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"val