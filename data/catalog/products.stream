    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGG24Z5\",\"sku\":\"B07QGG24Z5\",\"lang\":\"en\",\"slug\":\"rivet-industrial-plank-topped-console-table-with-metal-hairpin-legs-55-12-w-b07qgg24z5\",\"name\":\"Rivet Industrial Plank-Topped Console Table with Metal Hairpin Legs, 55.12&quot;W\",\"description\":\"This console table has a sleek design, allowing you to move it easily and place it wherever you need extra storage. The table is structured with thin black metal legs and a finished plank top of solid hardwood. The wood finish and black metal create a classic color combination that will suit any space. 55.12&quot;W x 15.75&quot;D x 31.5&quot;H Made of solid hardwood with natural finish and metal legs This table has sturdy hairpin legs that give it a rustic look. The natural finish makes this console table perfect for industrial or modern decor. Smooth, solid plank top with metal hairpin legs Assemble in 15 minutes or less Clean with a soft, damp cloth. Avoid placing furniture near heat vents or open windows. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Plank-Topped Console Table with Metal Hairpin Legs, 55.12&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71raQKKCY6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91r3r4uTVkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91r3r4uTVkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81biDGC2U8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81biDGC2U8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W5udeZIIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W5udeZIIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719zvoDFBaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7