    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D6M8Q\",\"sku\":\"B07B4D6M8Q\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-accent-chair-34-w-rouge-red-b07b4d6m8q\",\"name\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Rouge Red\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 34&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nmcX0+2bL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q9KacMc9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q9KacMc9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QsKYYpN3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QsKYYpN3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsWrFfjoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsWrFfjoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wQu5eEcgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wQu5eEcgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-image