    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2SXVY\",\"sku\":\"B084W2SXVY\",\"lang\":\"en\",\"slug\":\"reinhart-classic-upholstered-dining-chair-20-5-w-set-of-2-light-gray-b084w2sxvy\",\"name\":\"Reinhart Classic Upholstered Dining Chair, 20.5&quot;W, Set of 2, Light Gray\",\"description\":\"This set of two classically styled armless upholstered dining chairs are perfect for a vintage-look dining room or upscale kitchen. The gently curved high backs of these light-gray chairs suggest luxury as well as practicality, and the tapering legs are as supportive as they are lovely. 20.5&quot;W x 26&quot;D x 39&quot;H; seat height: 18.9&quot;H; seat depth: 18.1&quot;D; seat back height: 22.5&quot;H; leg height: 16.5&quot;H The solid wood frame is upholstered in a polyester, rayon, linen blend fabric. The classic style of these chairs makes theme equally suited to modern or traditional decor. Classic high-back dining chair has a transitional look. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Reinhart Classic Upholstered Dining Chair, 20.5&quot;W, Set of 2, Light Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MAmeM9y5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LG7-DqJ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LG7-DqJ2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H55nYSS8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H55nYSS8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hr0j0yI1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hr0j0yI1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81od1pqiRtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81od1