    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQ4WZ\",\"sku\":\"B07QBMQ4WZ\",\"lang\":\"en\",\"slug\":\"rivet-brooker-down-filled-mid-century-sofa-76-w-top-grain-leather-cognac-b07qbmq4wz\",\"name\":\"Rivet Brooker Down-Filled Mid-Century Sofa, 76&quot;W, Top Grain Leather, Cognac\",\"description\":\"This mid-century sofa with removable and reversible down-filled cushions offers comfort, while the hardwood frame, tapered legs, and top grain leather increase its durability. Whether used as a focus piece or a foundational piece, tufted back cushions add a touch of elegance to any room. 76&quot;W x 38&quot;D x 35&quot;H Solid hardwood frame, down-filled top grain leather cushions, tapered wood legs Removable and reversible down-filled cushions This mid-century sofa adds elegance and comfort to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brooker Down-Filled Mid-Century Sofa, 76&quot;W, Top Grain Leather, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tzzQKiSRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wLFvaO6PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wLFvaO6PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gRJP9erVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gRJP9erVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q3JdEq2RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81q3JdEq2RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gCmChWAUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gCmChWAUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-iKQdIFhL.jpg\",\"url\":\"https://storage.