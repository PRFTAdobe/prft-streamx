    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FW792\",\"sku\":\"B07B4FW792\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-leather-recliner-accnet-chair-30-w-brown-leather-b07b4fw792\",\"name\":\"Edmunds Traditional Leather Recliner Accnet Chair, 30&quot;W, Brown Leather\",\"description\":\"Straight lines and narrow arms combine modern touches with classic fabric, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Leather upholstery on hardwood pine frame Streamlined silhouette combines modern style with quality leather for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Leather Recliner Accnet Chair, 30&quot;W, Brown Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hoIlN2dYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xTqDxONFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xTqDxONFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KHDv1eD3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KHDv1eD3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U51ufnFDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U51ufnFDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U4TsNQj9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U4TsNQj9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wjpOsTcxL.jpg\",\"url\":\"https: