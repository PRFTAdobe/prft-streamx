    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6BJZ2\",\"sku\":\"B07HZ6BJZ2\",\"lang\":\"en\",\"slug\":\"clayton-reclining-contemporary-fabric-living-room-chair-30-w-linen-b07hz6bjz2\",\"name\":\"Clayton Reclining Contemporary Fabric Living-Room Chair, 30&quot;W, Linen\",\"description\":\"With an ideal blend of style and comfort, this recliner is made to order just for you. The tasteful fabric in Linen, and wooden frame adds a contemporary flair, the perfect addition to any room. Sturdy wooden frame with stain-resistant fabric; no assembly required The tight, fixed back and seat cushions ensure durability and comfort; fits perfectly in a living-room corner or beside a couch or bed Product Dimensions: 30&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; seat back height: 41&quot;H; arm height: 24&quot;H; leg height: 6.5&quot;H Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Clayton Reclining Contemporary Fabric Living-Room Chair, 30&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CicEeqFoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tM5jfgZmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tM5jfgZmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YIRYbtXqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YIRYbtXqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Dm+mXpzoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Dm+mXpzoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k0VgojcqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wxcm8sryL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-i