    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B088K35C1X\",\"sku\":\"B088K35C1X\",\"lang\":\"en\",\"slug\":\"rivet-alfred-mid-century-modern-wide-curved-back-accent-kitchen-dining-room-chair-25-2-w-canary-yellow-renewed-b088k35c1x\",\"name\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Canary Yellow (Renewed)\",\"description\":\"This classic mid-century modern accent chair features a wide curved back and armrest combined with simple tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 25.2W&quot; x 23.2&quot;D x x31.9&quot;H Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. Simple assembly; just attach legs. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Canary Yellow (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JK+xlL6vL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ple7-7xGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ple7-7xGL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"15.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Canary\",\"label\":\"Canary\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Yellow\",\"label\":\"Yellow\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":969,\"discountedValue\":872.1}}"
