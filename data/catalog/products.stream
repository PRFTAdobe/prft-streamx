    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD61D9\",\"sku\":\"B082QD61D9\",\"lang\":\"en\",\"slug\":\"rivet-spear-mid-century-modern-channel-tufted-leather-accent-chair-with-wood-arms-29-1-w-cognac-b082qd61d9\",\"name\":\"Rivet Spear Mid-Century Modern Channel Tufted Leather Accent Chair with Wood Arms, 29.1&quot;W, Cognac\",\"description\":\"Classic design features get a modern twist in this chic channel-back accent chair. The tufted upholstery comes in a cognac leather sure to fit with any design scheme. A curved back and wooden armrests provide support and an elegant look that will add a finishing touch wherever you need seating. 29.1&quot;W x 31.5&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 24.4&quot;D; seat back height: 21.7&quot;H; arm height: 25.2&quot;H; leg height: 11&quot;H Solid ash frame, leather upholstery Add elegance to any seating area with the classic design features of this channel-back chair. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Spear Mid-Century Modern Channel Tufted Leather Accent Chair with Wood Arms, 29.1&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nmi6P6DkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7101Bh55qsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7101Bh55qsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aclZb2iYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aclZb2iYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bnOda8h3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori