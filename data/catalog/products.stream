    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X61W2Y\",\"sku\":\"B075X61W2Y\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-hunter-green-b075x61w2y\",\"name\":\"Leila Ottoman, 34&quot; W, Hunter Green\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing makes cushion resilient This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and velvet upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot; W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jD+ifikwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NZ1FhvDBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NZ1FhvDBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817Ee6pSvAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817Ee6pSvAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e+iYeBVlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e+iYeBVlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-IweorLlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-IweorLlL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"39.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Hunter green\",\"label\":\"Hunter green\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Storage-ottomans\",\"label\":\"Storage-ottomans\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Green\",\"label\":\"Green\"}]}],\"categories\":[{\"id\":\"Accent Furniture\",\"slug\":\"accent-furniture\",\"name\":\"Accent Furniture\",\"value\":\"Accent Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":908,\"discountedValue\":817.2}}"
