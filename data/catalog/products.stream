    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3Z1\",\"sku\":\"B075X4F3Z1\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-smoky-teal-b075x4f3z1\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Smoky Teal\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Smoky Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xXNz-MEDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MCpPnPOCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MCpPnPOCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QeY9W3otL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QeY9W3otL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KnAhveS6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KnAhveS6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xI2UE4ZpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xI2UE4ZpS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\