    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08FHH4RY4\",\"sku\":\"B08FHH4RY4\",\"lang\":\"en\",\"slug\":\"rivet-alfred-mid-century-modern-wide-curved-back-accent-kitchen-dining-room-chair-25-2-w-ash-grey-renewed-b08fhh4ry4\",\"name\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Ash Grey (Renewed)\",\"description\":\"This classic mid-century modern accent chair features a wide curved back and armrest combined with simple tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 25.2&quot;W x 23.2&quot;D x 31.9&quot;H Fabric is 90% polyester/10% linen. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. Simple assembly; just attach legs. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Ash Grey (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tvB2SF0-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GJ9PdLx7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GJ9PdLx7L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"15.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",