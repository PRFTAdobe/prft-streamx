    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5C3\",\"sku\":\"B075X4F5C3\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-ottoman-27-w-blackwood-b075x4f5c3\",\"name\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Blackwood\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Nylon webbing supports the seat Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Blackwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wYkSBwKeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q0NBneopL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q0NBneopL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1B4rrqtfEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1B4rrqtfEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15hiGZar5S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15hiGZar5S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dK-sHvCbS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dK-sHvCbS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10yM5pXKKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10yM5pXKKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1woWWQFYSL.jpg\",\"