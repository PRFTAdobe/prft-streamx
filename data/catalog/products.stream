    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78LXZJ\",\"sku\":\"B07B78LXZJ\",\"lang\":\"en\",\"slug\":\"crawford-farmhouse-wood-dining-room-round-back-kitchen-chair-38-75-inch-height-set-of-2-grey-b07b78lxzj\",\"name\":\"Crawford Farmhouse Wood Dining Room Round Back Kitchen Chair, 38.75 Inch Height, Set of 2, Grey\",\"description\":\"24.75&quot;L x 21.5&quot;W x 38.75&quot;H Hardwood legs and frame; cushion and back inset have performance fabric upholstery A graceful style with rustic finish, ideal for a transitional or modern farmhouse décor Quality materials and construction are designed to outlast a busy family Assembly required Free returns for 30 days. 3-year warranty. Distressed rustic finish is paired with elegant design in this chair. A gracefully curved back has fabric insets on the front and rear. Quality hardwood and construction techniques ensure it will last through many family dinners.\",\"primaryImage\":{\"alt\":\"Crawford Farmhouse Wood Dining Room Round Back Kitchen Chair, 38.75 Inch Height, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wv2b0DlqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-AJj5juaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-AJj5juaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I2m0dNi6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I2m0dNi6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912IGgy9R1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912IGgy9R1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V2DT+nfkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V2DT+nfkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YBU6H-hML.jpg\",\"url\":\"https://storage.go