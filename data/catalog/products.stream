    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N3QL\",\"sku\":\"B075X4N3QL\",\"lang\":\"en\",\"slug\":\"marin-upholstered-ottoman-29-w-beige-b075x4n3ql\",\"name\":\"Marin Upholstered Ottoman, 29&quot;W, Beige\",\"description\":\"This item is made to order just for you 29&quot;W x 23&quot;D x 21&quot;H Sturdy hardwood frame with durable performance fabric upholstery Firm nylon webbing makes cushion resilient Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Sit back, relax, and prop up your feet on this plush ottoman. This practical addition to your home can be an extra seat or place to set a tray of snacks. The sturdy frame and tightly woven upholstery will last for years to come.\",\"primaryImage\":{\"alt\":\"Marin Upholstered Ottoman, 29&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YK+FCCDUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XuBjzOe4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XuBjzOe4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8120sG8i5SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8120sG8i5SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+dw4szFzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+dw4szFzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911yHyyE0LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911yHyyE0LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1O8bHNcvbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"name\":\"widt