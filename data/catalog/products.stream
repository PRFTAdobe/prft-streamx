    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N1MCL\",\"sku\":\"B07B4N1MCL\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-adjustable-headrest-loveseat-sofa-77-5-w-light-grey-b07b4n1mcl\",\"name\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Loveseat Sofa, 77.5&quot;W, Light Grey\",\"description\":\"This sofa isn't just handsomely styled; it's cleverly functional, too. A headrest across the back adjusts upright for watching TV, then tilts back when you're ready to relax. Compactly sized for smaller spaces, it features modern metal legs. 77.5&quot;W x 39.3&quot;D x 37&quot;H; Seat Height: 16.9&quot;H ; Seat Depth: 21.2&quot;D; Seat Back Height: 17.77&quot;H; Arm Height: 23.2&quot;H; Leg Height: 5.5&quot; Quality upholstery with a cedar hardwood frame; metal legs Clean lines and streamlined design is thoroughly contemporary Unique headrest feature adjusts upward and backward Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Loveseat Sofa, 77.5&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+ke1-bSlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gJpo3UZBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gJpo3UZBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zEUQbSpmS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zEUQbSpmS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lgayHJXSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lgayHJXSL.jpg\"},{\"alt\":\"https://storage.googleapis.com