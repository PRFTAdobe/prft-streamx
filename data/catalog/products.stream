    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWM3FN\",\"sku\":\"B07QGWM3FN\",\"lang\":\"en\",\"slug\":\"seahurst-king-footboard-and-side-rails-80-w-gray-taupe-b07qgwm3fn\",\"name\":\"Seahurst King Footboard and Side Rails, 80&quot;W, Gray Taupe\",\"description\":\"A beautiful way to complete the look of your king-size bed, this gray-taupe side-rails-and-footboard set works perfectly with the matching Emerly king headboard. 80&quot;W x 81&quot;D x 23&quot;H Gray-taupe finish, oak veneers, rubberwood solids, nickel acrylic hardware The casual contemporary style of this collection makes it the perfect addition or update to your bedroom. Cross-slat support system with adjustable levelers included. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty. Wipe clean with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Seahurst King Footboard and Side Rails, 80&quot;W, Gray Taupe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Je9raoNXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lIAb8k7DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lIAb8k7DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yjYJOwbsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yjYJOwbsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51yM9g4vN4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51yM9g4vN4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9152jGpPoKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9152jGpPoKL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"64.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"84.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\