    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQXRD4\",\"sku\":\"B075YQXRD4\",\"lang\":\"en\",\"slug\":\"rivet-julian-minimalist-modern-tufted-kitchen-bar-height-stools-set-of-2-37-8-inch-height-synthetic-leather-red-b075yqxrd4\",\"name\":\"Rivet Julian Minimalist Modern Tufted Kitchen Bar Height Stools, Set of 2, 37.8 Inch Height, Synthetic Leather, Red\",\"description\":\"Add snazzy style and a vibrant pop of color to your home with these fun bar stools. The low-back seats with channel tufting sit on tall metal legs. Combine with others of the same color or mix and match for a look that's sure to turn heads. Synthetic leather upholstery on hardwood frame; metal legs with grey finish Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty. 19.3&quot;W x 21&quot;D x 37.8&quot;H. Seat height is 29&quot;. Easy-care synthetic leather. Durable finish on legs.\",\"primaryImage\":{\"alt\":\"Rivet Julian Minimalist Modern Tufted Kitchen Bar Height Stools, Set of 2, 37.8 Inch Height, Synthetic Leather, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pwCSqeBOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719rBqHM47L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719rBqHM47L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91woMEJrmbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91woMEJrmbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wt2Pbnb2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wt2Pbnb2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Xix0nDmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Xix0nDmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZfCu8jMjL.jpg\",\"url\":\"