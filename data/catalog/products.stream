    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ1H8T\",\"sku\":\"B07QCQ1H8T\",\"lang\":\"en\",\"slug\":\"glenwilde-queen-headboard-75-w-cream-b07qcq1h8t\",\"name\":\"Glenwilde Queen Headboard, 75&quot;W, Cream\",\"description\":\"The strong, smooth lines of this cream-colored queen-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 75&quot;W x 11&quot;D x 52&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Queen Headboard, 75&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61YK6fUPNsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819qFfMCdGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819qFfMCdGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gYS68Y1fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gYS68Y1fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v2S3eSzCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1v2S3eSzCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EuvYIKTsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EuvYIKTsL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"label\":\"inches