    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M5CW8\",\"sku\":\"B07B4M5CW8\",\"lang\":\"en\",\"slug\":\"appleton-farmhouse-recliner-35-w-light-blue-b07b4m5cw8\",\"name\":\"Appleton Farmhouse Recliner, 35&quot;W, Light Blue\",\"description\":\"This is definitely not your dad's old overstuffed recliner. This chair features graceful style, neutral colors and durable fabric. With its rolled arms and tufted back, it has the right touches of modern and classic to blend with most decor. 35&quot;W x 40&quot;D x 41&quot;H; Seat Height: 20&quot;H ; Seat Depth: 21&quot;D; Seat Back Height: 41&quot;H; Arm Height: 24&quot;H; Front legs: 5.625&quot;H; Back legs: 4.75&quot;H Stain-resistant polyester fabric, sturdy pine wood frame Modern and classic come together for a transitional style Push back reclining mechanism; removable and reversible seat cushion No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Appleton Farmhouse Recliner, 35&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919PMd7pKXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915PucOGSaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915PucOGSaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zuR18ezIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zuR18ezIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dqjJzu9PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dqjJzu9PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L+eHwnFyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L+eHwnFyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EpIVSrCjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original