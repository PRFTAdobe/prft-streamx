        "bytes": "{\"id\":\"B07TD5R27D\",\"sku\":\"B07TD5R27D\",\"lang\":\"en\",\"slug\":\"kids-youth-gaming-recliner-with-headrest-and-back-pillow-5-age-group-black-and-white-b07td5r27d\",\"name\":\"Kids/Youth Gaming Recliner with Headrest and Back Pillow, 5+ Age Group, Black and White\",\"description\":\"Kid’s/youth recliner appropriate for ages 5 and up, 90 pounds weight capacity Unique gaming design, with headrest and matching pillow for extra comfort and support Upholstered with LeatherSoft for durability and plush support; easy to clean with a damp cloth Solid hardwood frame and raised plastic feet for enhanced sturdiness CA117 fire retardant foam filling for children's safety Relaxing recliner ideal for playing video games, watching TV, reading and more\",\"primaryImage\":{\"alt\":\"Kids/Youth Gaming Recliner with Headrest and Back Pillow, 5+ Age Group, Black and White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DZmm+iGXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71626LIr9tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71626LIr9tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LmJvz3qjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LmJvz3qjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZlFpQXqSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZlFpQXqSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sWDcEglwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sWDcEglwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/618hVmQ-2EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/618hVmQ-2EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/6