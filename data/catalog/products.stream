    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2KGCF7\",\"sku\":\"B07J2KGCF7\",\"lang\":\"en\",\"slug\":\"genesse-loveseat-sofa-couch-64-w-fawn-b07j2kgcf7\",\"name\":\"Genesse Loveseat Sofa Couch, 64&quot;W, Fawn\",\"description\":\"Complete your interior design with this beautiful fawn-colored sofa. Its performance-fabric upholstery offers comfortable seating, and its clean lines and modern narrow-arm and thin-leg design make this sofa an ideal addition to transitional-style home decor. Overall: 64&quot;W x 39&quot;D x 34&quot;H; Seat Height: 19.68&quot;H; Seat Depth 22.05&quot;D; Seat Back Height: 23.62&quot;H; Arm Height: 23.62&quot;H; Leg Height: 5.51&quot;H Solid-wood frame and legs with performance fabric upholstery Slim-arm design with wooden plinth Foam cushions provide lasting comfort Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Genesse Loveseat Sofa Couch, 64&quot;W, Fawn\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81emMC4VvlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AIJwpt24L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AIJwpt24L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t4Oxux54L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t4Oxux54L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819GlWQrjfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819GlWQrjfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910oSjiG2vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910oSjiG2vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yroIuCjSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yroIuCjSL.jpg\"},{\"alt\":\"https://stor