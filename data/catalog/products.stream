    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZFR24\",\"sku\":\"B07B4ZFR24\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-king-bed-84-w-fresh-dune-b07b4zfr24\",\"name\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Fresh Dune\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Fresh Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816mr80OvLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+nBzK3EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+nBzK3EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VQFYObX3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VQFYObX3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tC0fntCSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tC0fntCSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911QzYrMY4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911QzYrMY4L.j