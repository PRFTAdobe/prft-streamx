    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MJZN1\",\"sku\":\"B07B4MJZN1\",\"lang\":\"en\",\"slug\":\"jacobsen-traditional-leather-accent-chair-31-w-camel-brown-b07b4mjzn1\",\"name\":\"Jacobsen Traditional Leather Accent Chair, 31&quot;W, Camel Brown\",\"description\":\"The classic wingback chair gets a modern refresh in a more compact size. Dark grey nailhead trim gives this piece an upscale accent, while the top grain leather is comfortable and durable.  Natural markings in the leather make each chair unique. 30.7&quot;W x 33.4&quot;D x 33.8&quot;H Top-grain leather on wood frame with wood legs The classic wingback chair is updated and downsized to a more transitional look. An ideal accent chair for a family room or a home office Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Jacobsen Traditional Leather Accent Chair, 31&quot;W, Camel Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FDB-AkYWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-15Ozi+-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-15Ozi+-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LCFmP-EuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LCFmP-EuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IlUMfytoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IlUMfytoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ALJPpgaSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ALJPpgaSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x7pHq8v0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x7pHq8v0L.jpg\"}],\"attributes\":[{\"name\":\"height\