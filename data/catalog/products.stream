  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XJQLB\",\"sku\":\"B0831XJQLB\",\"lang\":\"en\",\"slug\":\"rosemont-vintage-tufted-sofa-couch-with-nailheads-88-w-grey-b0831xjqlb\",\"name\":\"Rosemont Vintage Tufted Sofa Couch with Nailheads, 88&quot;W, Grey\",\"description\":\"This elegant gray sofa with tufted back and foam-padded cushions is a stylish, comfortable addition to your living room. Sloping arms and nailhead detailing bring a distinctive flair to any interior. The durable performance upholstery is both attractive and easy to clean. 88&quot;W x 36&quot;D x 33.5&quot;H; seat height: 20&quot;H; seat depth: 24&quot;D; seat back height: 33.5&quot;H; arm height: 27.5&quot;H; leg height: 5&quot;H Upholstered in 95% polyester, 5% nylon performance fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rosemont Vintage Tufted Sofa Couch with Nailheads, 88&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wwyHBXMnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x5+il-I+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x5+il-I+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jvm3YXWzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jvm3YXWzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bk6EENbeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bk6EENbeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j0+Jh0nuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j0+Jh0nuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dFyV53keL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dFyV53keL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xPDImnmcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xPDImnmcL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"120.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Sierra\",\"label\":\"Sierra\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Lodge\",\"label\":\"Lodge\"},{\"value\":\"Power\",\"label\":\"Power\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":468,\"discountedValue\":421.2}}"
