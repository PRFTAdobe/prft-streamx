      "content": {
        "bytes": "{\"id\":\"B07HSH22K8\",\"sku\":\"B07HSH22K8\",\"lang\":\"en\",\"slug\":\"rivet-modern-cabinet-with-inner-shelf-15-w-walnut-b07hsh22k8\",\"name\":\"Rivet Modern Cabinet with Inner Shelf, 15&quot;W, Walnut\",\"description\":\"This cabinet boasts timeless, mid-century elegance with a walnut veneer that complements a broad variety of decors. The 2 large drawers provide ample storage, and the top inner shelf offers easy access to books, tablets, and other items. 27.6&quot;W x 15.0&quot;D x 29.5&quot;H Solid wood and MDF with walnut veneer Classic mid-century style with simple design One top inner shelf with 2 drawers for ample storage space Assemble in 15-30 minutes Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Modern Cabinet with Inner Shelf, 15&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812TpgyZfPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mcd74Ub9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mcd74Ub9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zayFQalRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zayFQalRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RpPme3woL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RpPme3woL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MhCrgFI8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MhCrgFI8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TYQKYhOHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TYQKYhOHL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":