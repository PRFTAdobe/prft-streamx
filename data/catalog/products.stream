    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4SC9RP\",\"sku\":\"B07B4SC9RP\",\"lang\":\"en\",\"slug\":\"contemporary-metal-bedroom-bench-with-cushion-58-w-oatmeal-b07b4sc9rp\",\"name\":\"Contemporary Metal Bedroom Bench with Cushion, 58&quot;W, Oatmeal\",\"description\":\"A great accent piece, this modern upholstered bench will fit just right at the foot of your bed or in an entryway. With a plush ivory tufted cushion and oiled bronze metal legs, its open, airy design adds seating without making the room feel crowded. 58&quot;L x 18&quot;W x 19&quot;H Metal and fabric (65% rayon; 35% linen) Simple, transitional design with neutral cushion and metal base Steel base provides sturdy support Assemble in 15-30 minutes; attach seat to base Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Contemporary Metal Bedroom Bench with Cushion, 58&quot;W, Oatmeal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IgozlC5tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ARchGdC0S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ARchGdC0S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912NgJuEZpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912NgJuEZpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Yj-KZOIXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Yj-KZOIXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FNDc4lrwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FNDc4lrwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815XCFgkmGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815XCFgkmGL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"