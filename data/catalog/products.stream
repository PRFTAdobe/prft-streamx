    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4M23\",\"sku\":\"B07QFP4M23\",\"lang\":\"en\",\"slug\":\"anne-marie-contemporary-sofa-couch-91-5-w-grey-b07qfp4m23\",\"name\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Grey\",\"description\":\"This sofa’s modern take on a classic design perfectly enhances your transitional-style home decor without sacrificing comfort. The cushions are reversible to enhance durability and prolong this sofa’s life. Overall: 91.5&quot;W x 40&quot;D x 39&quot;H. Seat height: 21&quot;H; seat depth: 22&quot;D; seat back height Sturdy wood frame and legs with durable 100% polypropylene upholstery Loose seat and back cushions are reversible to help keep this item looking great over time Classic meets contemporary for an ideal modern farmhouse feel. Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lBcPOKUQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Aw1N3lhNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Aw1N3lhNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E3GpjROkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E3GpjROkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810-k83kS8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810-k83kS8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OrdpV5bJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OrdpV5bJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hW2P5gusL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/