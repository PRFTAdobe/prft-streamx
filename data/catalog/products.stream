    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2S61W\",\"sku\":\"B084W2S61W\",\"lang\":\"en\",\"slug\":\"elise-upholstered-barstool-42-5-h-slate-gray-b084w2s61w\",\"name\":\"Elise Upholstered Barstool, 42.5&quot;H, Slate Gray\",\"description\":\"This slate-colored rectangular barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 42.5&quot;H; seat height: 29.9&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 25.2&quot;H Solid hardwood frame upholstered in moisture-repellent, stain-resistant fabric Footrest with kickplate for stability and durability, with padded seat and back for comfort. Low profile mid-century inspired barstool. Arrives fully assembled. Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Barstool, 42.5&quot;H, Slate Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gGLnga+5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zXQ9-mHqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zXQ9-mHqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jF3-99TsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jF3-99TsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B-hvRk6rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B-hvRk6rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j8gsImP3L.jpg\",\"url\