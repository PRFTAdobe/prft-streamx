    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z9QB7N\",\"sku\":\"B075Z9QB7N\",\"lang\":\"en\",\"slug\":\"rivet-industrial-wood-and-metal-round-dining-kitchen-table-35-4-w-recycled-elm-b075z9qb7n\",\"name\":\"Rivet Industrial Wood and Metal Round Dining Kitchen Table, 35.4&quot;W, Recycled Elm\",\"description\":\"Enjoy your daily cup of morning coffee while sitting at this clever industrial table. A starburst pattern accents the recycled elm wood top. The iron base has four legs and a swivel function that allows you to adjust the height and lock it into place. 35.4&quot; Diameter; adjustable height from 24.41&quot; to 34.25&quot; maximum. The top is made of recycled elm wood; iron base has coated black finish Hand-turned swivel function allows you to adjust to your preferred height and lock it into place. No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Wood and Metal Round Dining Kitchen Table, 35.4&quot;W, Recycled Elm\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812Uj0ypleL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f3uggMiFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f3uggMiFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LPZ1vCzoS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LPZ1vCzoS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ohlVkibL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ohlVkibL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NYDxYTsbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NYDxYTsbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XL3DNsf9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XL3DNsf9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"44.1\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Counter height table\",\"label\":\"Counter height table\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Dining-tables\",\"label\":\"Dining-tables\"},{\"value\":\"Dining table\",\"label\":\"Dining table\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Round dining table\",\"label\":\"Round dining table\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Side table\",\"label\":\"Side table\"},{\"value\":\"Dining room table\",\"label\":\"Dining room table\"},{\"value\":\"Kitchen table\",\"label\":\"Kitchen table\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Console table\",\"label\":\"Console table\"},{\"value\":\"Kitchen table set\",\"label\":\"Kitchen table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Coffee table\",\"label\":\"Coffee table\"},{\"value\":\"Natural+black iron\",\"label\":\"Natural+black iron\"}]}],\"categories\":[{\"id\":\"Tables\",\"slug\":\"tables\",\"name\":\"Tables\",\"value\":\"Tables\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":447,\"discountedValue\":402.3}}"
