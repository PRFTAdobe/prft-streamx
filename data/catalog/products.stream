    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC15Z8Z\",\"sku\":\"B07PC15Z8Z\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-ottoman-30-w-dark-grey-b07pc15z8z\",\"name\":\"Rivet Andrews Contemporary Ottoman, 30&quot;W, Dark Grey\",\"description\":\"This attractive dark-grey ottoman will bring class to your living room or den—or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 30&quot;W x 22&quot;D x 18&quot;H Solid hardwood frame with tapered wood legs Use as an extra seat or a place to rest your feet. Contemporary style and top grain leather combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Ottoman, 30&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DVZ+pAHyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mSZQKsFNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mSZQKsFNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gil9Bq7yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Gil9Bq7yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fefkgsw9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fefkgsw9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I2b0QDGSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I2b0QDGSL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.72\",\"label\":\"inc