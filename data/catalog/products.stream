    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X467QG\",\"sku\":\"B075X467QG\",\"lang\":\"en\",\"slug\":\"hillsboro-modern-wingback-living-room-accent-chair-with-nailhead-trim-29-w-beige-b075x467qg\",\"name\":\"Hillsboro Modern Wingback Living Room Accent Chair With Nailhead Trim, 29&quot;W, Beige\",\"description\":\"Streamlined, gently curving &quot;wings&quot; and arms give a refined, modern refresh to the mid-century wingback chair. Hand-applied nailhead trim with brass finish adds an air of sophistication, while the seat cushion is removable for easy cleaning. 29&quot;W x 37''D x 40.5''H Rayon/linen/polyester blend fabric; metal nailhead trim with brass finish; wood legs. A modernized silhouette of the mid-century wingback style with removable seat cushion Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillsboro Modern Wingback Living Room Accent Chair With Nailhead Trim, 29&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dp-4sEkJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XA6bIdrQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XA6bIdrQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dg7n90liL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dg7n90liL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aU++mJjkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aU++mJjkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wk9jy-TUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wk9jy-TUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Wj6CzmlFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original