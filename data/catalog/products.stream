    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB78S\",\"sku\":\"B07QCMB78S\",\"lang\":\"en\",\"slug\":\"anne-marie-contemporary-sofa-couch-91-5-w-cream-b07qcmb78s\",\"name\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Cream\",\"description\":\"This sofa’s modern take on a classic design perfectly enhances your transitional-style home decor without forfeiting comfort. The cushions are reversible to enhance durability and prolong this sofa’s life. Overall: 91.5&quot;W x 40&quot;D x 39&quot;H. Seat height: 21&quot;H; seat depth: 22&quot;D; seat back height: 20&quot;H Sturdy wood frame and legs with durable 92% polyester and 8% nylon upholstery Loose seat and back cushions are reversible to help keep this item looking great over time Classic meets contemporary for an ideal modern farmhouse feel. Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Anne Marie Contemporary Sofa Couch, 91.5&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ezyb12HLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xd9T5xB-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xd9T5xB-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919gYvcXeGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919gYvcXeGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H+mWdoCCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H+mWdoCCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81paFamm0-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81paFamm0-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MXxZrEFGL.jpg\",\"url\":\"https://storage.googleapis.com/