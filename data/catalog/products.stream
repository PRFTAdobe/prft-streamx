      "content": {
        "bytes": "{\"id\":\"B075X5HB1D\",\"sku\":\"B075X5HB1D\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-tan-b075x5hb1d\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Tan\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pt1O0m0+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KosLSmSpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KosLSmSpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gUCIl8e7S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gUCIl8e7S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18SgmRZJAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18SgmRZJAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"60.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"l