    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0854SM298\",\"sku\":\"B0854SM298\",\"lang\":\"en\",\"slug\":\"rivet-coen-contemporary-modern-upholstered-accent-swivel-chair-30-w-velvet-forest-b0854sm298\",\"name\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Velvet Forest\",\"description\":\"Add the finishing touch to your home decor with this contemporary-style accent chair. Its unique design and beautiful fabric adds design interest to any room, and the swivel feature ensures it's as comfortable as it is stylish. Overall: 30&quot;W x 31&quot;D x 28&quot;H; seat height: 16.93&quot;H; seat depth: 22.83&quot;D; seat back height: 28&quot;H; arm height: 25.19&quot;H Solid-wood frame with swivel mechanism. Fabric upholstery over foam cushioning. Clean-cut contemporary style complements modern, minimal, and urban-modern home decor. No assembly required. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Velvet Forest\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nVQLeAU5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716wMj8-svL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716wMj8-svL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NJlTWY-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NJlTWY-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kZMcK7mfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kZMcK7mfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8127Txb44YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8127Txb44YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71N8M5K5QZL.jpg\",\"url\":\"https://s