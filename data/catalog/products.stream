    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VQYF\",\"sku\":\"B075X4VQYF\",\"lang\":\"en\",\"slug\":\"marin-studded-loveseat-60-w-latte-b075x4vqyf\",\"name\":\"Marin Studded Loveseat, 60&quot;W, Latte\",\"description\":\"This item is made to order just for you 60&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional loveseat turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Loveseat, 60&quot;W, Latte\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sItqnRzuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ymOFtnu8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ymOFtnu8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KEOD7rvQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KEOD7rvQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IIpfrqOPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IIpfrqOPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LF2Je4ngL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LF2Je4ngL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"60.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight