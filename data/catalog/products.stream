    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB7J1\",\"sku\":\"B07QCMB7J1\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-living-room-chair-with-wood-base-and-legs-39-w-ivory-b07qcmb7j1\",\"name\":\"Hillman Mid-Century Living Room Chair with Wood Base and Legs, 39&quot;W, Ivory\",\"description\":\"Wide, comfortable cushions are a hallmark of this mid-century inspired arm chair. Easy-care ivory upholstery and reversible back cushions help keep this piece looking fresh. A hardwood frame connects to tapered wood legs and lends structure to the foam-padded cushions. High arms give additional support. 39&quot;W x 38&quot;D x 33&quot;H; seat height: 18&quot;H; seat depth: 21&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 8&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Removable and reversible back and throw cushions Classic shape and plush cushions make this chair work in a variety of decors. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Living Room Chair with Wood Base and Legs, 39&quot;W, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916g5PXKMLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913EGfz6jNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913EGfz6jNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U1JjEqmmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91U1JjEqmmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sT+5gcWML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sT+5gcWML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sWM6NVQjL.jpg\",\"url\":\"https://storage.googleapis.com/pu