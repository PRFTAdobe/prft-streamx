      "content": {
        "bytes": "{\"id\":\"B075YMN1BC\",\"sku\":\"B075YMN1BC\",\"lang\":\"en\",\"slug\":\"high-back-dining-room-table-chairs-38-h-set-of-2-navy-b075ymn1bc\",\"name\":\"High-Back Dining Room Table Chairs, 38&quot;H, Set of 2, Navy\",\"description\":\"Simple lines and classic modern style give these chairs timeless versatility. High backs, firm padding and performance fabric make them comfortable and durable for the long haul, and they will blend with traditional, modern and transitional decor. 23&quot;W x 19&quot;D x 38&quot;H 95% polyester/5% nylon on hardwood frame. Solid hardwood frame, performance fabric and timeless style for durable versatility. No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"High-Back Dining Room Table Chairs, 38&quot;H, Set of 2, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IQRECS9iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tvKEHZc9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tvKEHZc9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A148cr9CtIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A148cr9CtIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KZRXopxiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KZRXopxiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12MdORkh8S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12MdORkh8S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10X7vSvdaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10X7vSvdaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"n