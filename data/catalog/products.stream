    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4WBLM\",\"sku\":\"B075X4WBLM\",\"lang\":\"en\",\"slug\":\"st-cloud-modernarmless-straight-back-settee-49-w-tan-b075x4wblm\",\"name\":\"St. Cloud ModernArmless Straight Back Settee, 49&quot;W, Tan\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish. A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud ModernArmless Straight Back Settee, 49&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918opCGuOdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-0Q6E7otL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-0Q6E7otL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11SvF6MagL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11SvF6MagL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SqunIQJTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SqunIQJTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JjqeKhErL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JjqeKhErL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]},{\"name\":