    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072M1W86Y\",\"sku\":\"B072M1W86Y\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-sofa-couch-with-hardwood-frame-89-w-slate-b072m1w86y\",\"name\":\"Lauren Down-Filled Oversized Sofa Couch with Hardwood Frame, 89&quot;W, Slate\",\"description\":\"Dimensions: 89.4''W x 44.9”D x 37.4”H Get comfort you can literally sink into with this classically styled, overstuffed sofa. A clean and simple silhouette with track arms in a durable performance fabric, it's the perfect addition for your living room. Solid hardwood frame with moisture repellent, stain resistant fabric Timeless casual Exceptional comfort with high performance fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Sofa Couch with Hardwood Frame, 89&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sCK9A+WoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18qaYOvZML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18qaYOvZML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mF9nGtq+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mF9nGtq+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BANmrhtTS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BANmrhtTS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-97R21EbS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-97R21EbS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZGBVCoh6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZGBVCoh6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.401573\",\"label