    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X342T5\",\"sku\":\"B075X342T5\",\"lang\":\"en\",\"slug\":\"westport-modern-nailhead-upholstered-accent-arm-chair-36-w-stone-brown-b075x342t5\",\"name\":\"Westport Modern Nailhead Upholstered Accent Arm Chair, 36&quot;W, Stone Brown\",\"description\":\"Elevate your style with this head-turning modern chair. The deep seat is combined with a down-blend back cushion that is reversible. Nailhead trim on the arms and across the sides, along with the exposed wood base, adds extra sophistication. 36&quot;W x 37.75''D x  33''H Durable polyester fabric; metal nailhead trim; wood legs. Removable, reversible back cushion enhances durability. No assembly required. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Westport Modern Nailhead Upholstered Accent Arm Chair, 36&quot;W, Stone Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wnnS4QlcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911RnsVKH2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911RnsVKH2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V+0ju9G-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V+0ju9G-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EVmC5A36L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EVmC5A36L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12DYCUapxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12DYCUapxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.75\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"113.7\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Stone brown\",\"label\":\"Stone brown\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":331,\"discountedValue\":297.9}}"
