  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4H26MQ\",\"sku\":\"B07B4H26MQ\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-adjustable-headrest-leather-loveseat-sofa-61-8-w-black-leather-b07b4h26mq\",\"name\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Loveseat Sofa, 61.8&quot;W, Black Leather\",\"description\":\"This leather loveseat isn't just handsomely styled; it's cleverly functional, too. A headrest across the back adjusts upright for watching TV, then tilts back when you're ready to relax. Compactly sized for smaller spaces, it features modern metal legs. 61.8&quot;W x 39.3&quot;D x 37&quot;H; Seat Height: 16.9&quot;H ; Seat Depth: 21.2&quot;D; Seat Back Height: 17.77&quot;H; Arm Height: 23.2&quot;H; Leg Height: 5.5&quot; Genuine leather on cedar hardwood frame; metal legs Clean lines and streamlined design is thoroughly contemporary Unique headrest feature adjusts upward and backward Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Loveseat Sofa, 61.8&quot;W, Black Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91den+9otOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913St2Om4KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913St2Om4KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vh5EvILnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vh5EvILnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D2Y4efqZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D2Y4efqZL.jpg\"},{\"