    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4T4BF\",\"sku\":\"B075X4T4BF\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-loveseat-63-w-saddle-brown-b075x4t4bf\",\"name\":\"Charles Classic Oversized Leather Loveseat, 63&quot;W, Saddle Brown\",\"description\":\"This item is made to order just for you Overall depth: 39&quot;, Seat depth: 23&quot;, Height: 38&quot;, Width: 63&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional loveseat with plenty of room for family, friends and pets Let yourself be wrapped in comfort by this extra large loveseat. Traditional rolled arms and turned wood legs are combined with top-grain leather upholstery for an update on a classic piece. Its long silhouette means ample space for family. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Loveseat, 63&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914GxcuVzJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E6ZEw7V8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E6ZEw7V8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e6FykZtCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e6FykZtCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w0vCN6sIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1w0vCN6sIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"valu