    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MSWZ5VP\",\"sku\":\"B07MSWZ5VP\",\"lang\":\"en\",\"slug\":\"ravenna-home-traditional-upholstered-headboard-king-77-8-inch-charcoal-grey-b07mswz5vp\",\"name\":\"Ravenna Home Traditional Upholstered Headboard -King, 77.8 Inch, Charcoal Grey\",\"description\":\"77.8&quot;W x 3.9&quot;D x 54.3&quot;H Well-constructed plywood and metal legs This king-size headboard with foam padding in gray woven polyester provides serene bedroom decor in a classic, transitional style. Padding and sturdy construction give extra comfort and support. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Traditional Upholstered Headboard -King, 77.8 Inch, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nn6s7xGcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Az5tZl6vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Az5tZl6vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XDfghG5yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XDfghG5yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xPDFPTj2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xPDFPTj2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HgvhAN2jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HgvhAN2jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810FCDEP0NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810FCDEP0NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Clscip3VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Clscip3VL.jpg\"}],\"attributes\":[{\"name\":\"