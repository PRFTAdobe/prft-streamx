    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z1VKKX\",\"sku\":\"B075Z1VKKX\",\"lang\":\"en\",\"slug\":\"rivet-eastport-industrial-bed-side-wood-nightstand-21-7-w-oak-finish-b075z1vkkx\",\"name\":\"Rivet Eastport Industrial Bed Side Wood Nightstand, 21.7&quot;W, Oak Finish\",\"description\":\"This simply-designed solid pine piece with an oak veneer can be used as a bedroom nightstand or living room end table. Wherever it lands, you'll enjoy nice storage space with modern industrial design. Durable solid wood is built to last and sustainably sourced. 21.6&quot;W x 19.7&quot;D x 21.6&quot;H Handcrafted from solid wood. Modern industrial design of natural pine to blend with modern and rustic styles Simple design can be used in living area or bedroom Simple assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Eastport Industrial Bed Side Wood Nightstand, 21.7&quot;W, Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914kgbgR7VL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ty4FzWZ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ty4FzWZ1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q8vWu-FML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q8vWu-FML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iqxbAdRuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iqxbAdRuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UIqL+pGxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UIqL+pGxL.jpg\"}],\"attribu