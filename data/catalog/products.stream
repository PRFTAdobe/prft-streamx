    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MXQ7BV\",\"sku\":\"B084MXQ7BV\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-solid-wood-headboard-king-79-w-charcoal-gray-b084mxq7bv\",\"name\":\"Modern Farmhouse Solid Wood Headboard, King, 79&quot;W, Charcoal Gray\",\"description\":\"This solid pine headboard has a charcoal gray finish that accentuates the beauty of the natural wood grain. Made from recycled pine, this rustic headboard will complement your bedroom and blend seamlessly with farmhouse or contemporary decor. 79&quot;W x 3&quot;D x 45&quot;H Recycled pine Predrilled holes allow for easy connection to most metal bed frames. Made of recycled pine, each headboard is unique and slightly different from the next. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Solid Wood Headboard, King, 79&quot;W, Charcoal Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719msctu8WL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61S4j-+Bu4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61S4j-+Bu4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ypgzDn-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ypgzDn-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QXWFb79HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QXWFb79HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61C1vU4EV2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61C1vU4EV2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719xXGKSlUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719xXGKSlUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pj9qtFalL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pj9qtFalL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZLwI-NSaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZLwI-NSaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"45.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"3.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"79.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"46.33\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Solid\",\"label\":\"Solid\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":623,\"discountedValue\":560.7}}"
