    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BDFPT\",\"sku\":\"B07B7BDFPT\",\"lang\":\"en\",\"slug\":\"rivet-eastern-modern-velvet-dining-kitchen-chairs-32-inch-height-set-of-2-orange-b07b7bdfpt\",\"name\":\"Rivet Eastern Modern Velvet Dining Kitchen Chairs, 32 Inch Height, Set of 2, Orange\",\"description\":\"Get your glam on with this chic modern dining chair set. Plush velvet cushions are paired with a geometric leg base that's finished in bronze for added luster. These eye-catching chairs will be right at home in a modern or industrial style room. 20&quot;W x 23.6&quot;D x 32.4&quot;H; Seat Height: 18.8&quot;H ; Seat Depth: 17.3&quot;D; Seat Back Height: 13.7&quot;H; Arm Height: 18.8&quot;H Modern industrial with glamorous velvet Use as dining room chair or as extra chair in living room or bedroom No assembly required Free returns for 30 days. 1-year warranty. Velvet upholstery on metal base\",\"primaryImage\":{\"alt\":\"Rivet Eastern Modern Velvet Dining Kitchen Chairs, 32 Inch Height, Set of 2, Orange\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eEutgmteL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qhn+BU6EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qhn+BU6EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zXBe6dxkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zXBe6dxkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81frJ9p6TqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81frJ9p6TqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A176Ye5nDOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A176Ye5nDOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-yjwqEAmL.jpg\",\"url\":\"https://storage.googleapis.com/pur