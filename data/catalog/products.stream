    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWLJR8S\",\"sku\":\"B07BWLJR8S\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-loveseat-sofa-56-w-storm-grey-b07bwljr8s\",\"name\":\"Rivet Revolve Modern Upholstered Loveseat Sofa, 56&quot;W, Storm Grey\",\"description\":\"This modern loveseat sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. The solid wood frame makes this loveseat feel sturdy and substantial. Hardwood frame with solid beech wood legs Modern style with timeless touches A great piece to brighten up any space Simple assembly; just attach legs Free returns for 30 days. 1-year warranty. 34.6''D x 56.3 ”W x 35.4''H\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Loveseat Sofa, 56&quot;W, Storm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ASO5jPNnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917Y2-EjqvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917Y2-EjqvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14nXo2JcgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14nXo2JcgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hR80XYGXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hR80XYGXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aEn9un22L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aEn9un22L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-5kjz6AgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-5kjz6AgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+vgniijzL.jpg\",\"url\":\"https://storage.googleapis.com/puresigh