    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D4DXJ\",\"sku\":\"B07B4D4DXJ\",\"lang\":\"en\",\"slug\":\"andover-modern-square-ottoman-33-w-grey-linen-b07b4d4dxj\",\"name\":\"Andover Modern Square Ottoman, 33&quot;W, Grey Linen\",\"description\":\"Wooden legs, clean lines, and box-edge cushions bring stylish sophistication to modern or transitional rooms. With a sturdy frame and springy cushioning, this ottoman is ready to withstand years as a footrest or extra seating for guests. 33&quot;W x 33&quot;D x 21&quot;H; Seat Height: 21&quot;H ; Seat Depth: 33&quot;D; Seat Back Height: 21&quot;H; Leg Height: 4.25&quot;H Polyester fabric on hardwood pine frame The streamlined shape is a hallmark of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Square Ottoman, 33&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kmHvNZaJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0niTOO3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0niTOO3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S6y9qIvQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S6y9qIvQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V2kN7FVaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V2kN7FVaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"36.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Grey linen\",\"label\":\"Grey linen\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Square ottoman\",\"label\":\"Square ottoman\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":432,\"discountedValue\":388.8}}"
