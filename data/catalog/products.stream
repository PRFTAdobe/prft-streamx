      "content": {
        "bytes": "{\"id\":\"B075YMN1KY\",\"sku\":\"B075YMN1KY\",\"lang\":\"en\",\"slug\":\"rivet-alfred-mid-century-modern-wide-curved-back-accent-kitchen-dining-room-chair-25-2-w-ash-grey-b075ymn1ky\",\"name\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Ash Grey\",\"description\":\"This classic mid-century modern accent chair features a wide curved back and armrest combined with simple tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 25.2&quot;W x 23.2&quot;D x 31.9&quot;H Fabric is 90% polyester/10% linen. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. Simple assembly; just attach legs. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Ash Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y408+O6bL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19-48kuwiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19-48kuwiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10tDEU-ZwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10tDEU-ZwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S3h8Ua87L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1S3h8Ua87L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\