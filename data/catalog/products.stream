    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6GJ5J\",\"sku\":\"B07HZ6GJ5J\",\"lang\":\"en\",\"slug\":\"kristin-sofa-chaise-96-5-w-indigo-b07hz6gj5j\",\"name\":\"Kristin Sofa Chaise, 96.5&quot;W, Indigo\",\"description\":\"Add style and comfort to your home with this classic sofa chaise. With a time-tested traditional design, this sofa is an ideal accent for many home-decor styles, and its beautiful indigo hue brightens the room with color. Its cushions are reversible to extend this sofa’s life. Overall: 96.5&quot;W x 37&quot;D x 37.5&quot;H; Seat Height: 21.5&quot;H; Seat Depth 24&quot;D; Seat Back Height: 30&quot;H; Arm Height: 32&quot;H; Leg Height: 2.5&quot;H; chaise depth: 68.5&quot;D; chaise width: 32&quot;W Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Traditional design is both fashionable and practical. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Kristin Sofa Chaise, 96.5&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E1tqBHFxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnC5sHi3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnC5sHi3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iu+QU2gYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iu+QU2gYS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VHcsZJ7OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VHcsZJ7OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zzg0vxOjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag