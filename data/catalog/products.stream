        "bytes": "{\"id\":\"B07B7B94NC\",\"sku\":\"B07B7B94NC\",\"lang\":\"en\",\"slug\":\"cottage-wood-bar-stool-24-h-red-b07b7b94nc\",\"name\":\"Cottage Wood Bar Stool, 24&quot;H, Red\",\"description\":\"This simple, classic wooden counter-height stool is offered in a distressed deep red finish. It's perfect for adding seating to a rustic or modern farmhouse kitchen, and easy to move around when you need more seating in another room. 18&quot;W x 9.5&quot;D x 24&quot;H; Seat Height: 24&quot;H Sturdy hardwoods Ideal for rustic and modern farmhouse spaces Easy to care for -- just wipe with damp cloth Assembly in 15-30 minutes Doesn't say what you need to do Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Cottage Wood Bar Stool, 24&quot;H, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81myVCCpUgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uU-a9NvKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uU-a9NvKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ADPKt1E1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ADPKt1E1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BmJJJrdQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BmJJJrdQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71krv98NNUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71krv98NNUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917shTJjkkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917shTJjkkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719nMJS+UzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719nMJS+UzL.jpg\"},