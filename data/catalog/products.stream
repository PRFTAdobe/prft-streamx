    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568VZZR\",\"sku\":\"B08568VZZR\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-stucco-b08568vzzr\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Stucco\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811zMK6fOQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817tHuzGGrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817tHuzGGrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B4wS8q2AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B4wS8q2AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71M75snAIuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71M75snAIuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yZHdRNJRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yZHdRNJRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A8bR4uCC