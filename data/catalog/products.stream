    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QC85X9J\",\"sku\":\"B07QC85X9J\",\"lang\":\"en\",\"slug\":\"classic-home-office-desk-with-drawer-54-w-dark-espresso-b07qc85x9j\",\"name\":\"Classic Home Office Desk with Drawer, 54&quot;W, Dark Espresso\",\"description\":\"The classic design and rich dark-espresso finish of this desk make it a striking and useful addition to your home office or interior space. Ample writing space and plenty of leg room allow for maximum productivity. 54''W x 23.5''D x 30''H Solid pine and MDF; dark espresso finish This pine desk combines style and function to provide ample space for your home office needs. The dark espresso finish and the classic lines of this desk bring a distinctive flair to any home office or living space. Assemble in 15-30 minutes Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Home Office Desk with Drawer, 54&quot;W, Dark Espresso\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GPcOY06kL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-oI1Z56nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-oI1Z56nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xRJfyS1yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xRJfyS1yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VxyRHH-fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VxyRHH-fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jR5o6PQEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jR5o6PQEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XMyYWY0bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XMyYWY0bL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41cQ8la4KoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41cQ8la4KoL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"23.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"54.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"45.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"500lbs\",\"label\":\"500lbs\"},{\"value\":\"Wheels\",\"label\":\"Wheels\"},{\"value\":\"Childs\",\"label\":\"Childs\"},{\"value\":\"Espacios\",\"label\":\"Espacios\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Corner\",\"label\":\"Corner\"},{\"value\":\"Cabot\",\"label\":\"Cabot\"},{\"value\":\"Escritorio\",\"label\":\"Escritorio\"},{\"value\":\"Bush\",\"label\":\"Bush\"},{\"value\":\"Computer\",\"label\":\"Computer\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Study\",\"label\":\"Study\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Executive\",\"label\":\"Executive\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Craft\",\"label\":\"Craft\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Respawn\",\"label\":\"Respawn\"},{\"value\":\"Deks\",\"label\":\"Deks\"},{\"value\":\"Youth\",\"label\":\"Youth\"},{\"value\":\"Tall\",\"label\":\"Tall\"},{\"value\":\"Student\",\"label\":\"Student\"},{\"value\":\"Mobile\",\"label\":\"Mobile\"},{\"value\":\"Kids\",\"label\":\"Kids\"},{\"value\":\"Headphones\",\"label\":\"Headphones\"},{\"value\":\"Ps4\",\"label\":\"Ps4\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Standup\",\"label\":\"Standup\"},{\"value\":\"Workstation