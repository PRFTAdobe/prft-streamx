        "bytes": "{\"id\":\"B075X4F5LM\",\"sku\":\"B075X4F5LM\",\"lang\":\"en\",\"slug\":\"leila-tufted-velvet-living-room-sofa-couch-88-w-blue-b075x4f5lm\",\"name\":\"Leila Tufted Velvet Living Room Sofa Couch, 88&quot;W, Blue\",\"description\":\"This item is made to order just for you 88&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with 100% polyester upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look sofa. With solid wood legs in a dark walnut finish, plush velvet upholstery and a low, curved tufted back, it exudes opulence. Three removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Velvet Living Room Sofa Couch, 88&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811xGuHmVaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U5N9iYcHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U5N9iYcHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v4dFyZ1TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v4dFyZ1TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+OhZFu2WL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+OhZFu2WL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T6w2NPpyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T6w2NPpyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"92.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"165.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Accent Furniture\",\"slug\":\"accent-furniture\",\"name\":\"Accent Furniture\",\"value\":\"Accent Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":264,\"discountedValue\":237.6}}"
