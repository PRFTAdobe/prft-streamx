    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JVMJL\",\"sku\":\"B07P6JVMJL\",\"lang\":\"en\",\"slug\":\"rivet-cove-modern-tufted-loveseat-with-tapered-legs-mid-century-56-w-caramel-b07p6jvmjl\",\"name\":\"Rivet Cove Modern Tufted Loveseat with Tapered Legs, Mid-Century, 56&quot;W, Caramel\",\"description\":\"This modern loveseat comes with tufted back and seat cushions atop tall tapered legs. The design offers simple lines that fit well with most decors, and the solid wood frame give this beautiful piece a sense of solidity and timelessness. 32.7&quot;W x 33.9&quot;D x 35.4&quot;H Solid wood frame and legs; leather upholstery Add style when you add extra seating with this gorgeous modern loveseat. Tufting on the seat and back cushions adds elegance to this modern loveseat. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cove Modern Tufted Loveseat with Tapered Legs, Mid-Century, 56&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8199jR9H1LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FqRa3TtGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FqRa3TtGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i91Qf5qIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i91Qf5qIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T8wjvK5GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1T8wjvK5GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wN4dkw0ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wN4dkw0ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-image