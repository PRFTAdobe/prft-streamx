    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L6C7R\",\"sku\":\"B07B4L6C7R\",\"lang\":\"en\",\"slug\":\"andover-leather-loveseat-sofa-67-w-saddle-brown-b07b4l6c7r\",\"name\":\"Andover Leather Loveseat Sofa, 67&quot;W, Saddle Brown\",\"description\":\"Complete your living space with this stylish loveseat. With its saddle-colored upholstery, this loveseat is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this loveseat’s life. Overall: 67&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Loveseat Sofa, 67&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KVITztIuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jv4xIG6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jv4xIG6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bmNtXfbFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bmNtXfbFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iY6DEpL3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iY6DEpL3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEzt5AV9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEzt5AV9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0