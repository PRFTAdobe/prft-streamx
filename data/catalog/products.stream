    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSC43\",\"sku\":\"B07QFRSC43\",\"lang\":\"en\",\"slug\":\"rivet-modern-high-back-barstool-set-of-2-43-5-h-blue-b07qfrsc43\",\"name\":\"Rivet Modern High-Back Barstool, Set of 2, 43.5&quot;H, Blue\",\"description\":\"This set of 2 contemporary barstools comes in a durable blue upholstery that tops black-finished metal legs. The foam padding and elastic suspension system help ensure the backs and seats stay firm and comfortable, while a distinctive flair adds a personal touch to any home or business. 19.5&quot;W x 21.25&quot;D x 43.5&quot;H Durable fabric on metal frame The foam padding and elastic suspension system help keep the back and seat firm and comfortable. The distinctive design of these contemporary barstools brings a touch of personal style to any home or business. Simple assembly in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern High-Back Barstool, Set of 2, 43.5&quot;H, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cT9bUBhQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SQzsstaZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SQzsstaZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714n9Ea4FBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714n9Ea4FBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1heGOUCJGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1heGOUCJGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gZqed4wWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gZqed4wWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KhJyACSCL.jpg\",\"url\":\"https://s