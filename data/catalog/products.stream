    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ24FSL\",\"sku\":\"B07QJ24FSL\",\"lang\":\"en\",\"slug\":\"ravenna-home-dining-chairs-set-of-2-40-h-praline-b07qj24fsl\",\"name\":\"Ravenna Home Dining Chairs, Set of 2, 40&quot;H, Praline\",\"description\":\"20.20&quot;W x 26&quot;D x 40&quot;H; seat height: 20&quot;H; seat dimension: 21&quot; x 18&quot; This set of 2 dining chairs features a solid wood frame for durability and praline-colored fabric upholstery for easy maintenance. Web suspension and no-sag springs provide comfortable seating. The gently curving back, flared legs, and trim of individually placed silver nailheads add an elegant touch to your dining room. The style blends easily with either classic or modern furniture. Assemble in 15 minutes or less Clean by vacuuming or wiping with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Dining Chairs, Set of 2, 40&quot;H, Praline\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N+P5b7KBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UtNwf0UJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UtNwf0UJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TYwrPKIKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TYwrPKIKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bAjHYBN7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bAjHYBN7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QCLp27tSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QCLp27tSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OpvZARH+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OpvZARH+L.jpg\"}],\"attributes\":[{\"n