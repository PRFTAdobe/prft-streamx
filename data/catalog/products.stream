    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QD6V6N8\",\"sku\":\"B07QD6V6N8\",\"lang\":\"en\",\"slug\":\"rivet-industrial-coffee-table-with-multisquare-wood-design-47-24-w-b07qd6v6n8\",\"name\":\"Rivet Industrial Coffee Table with Multisquare Wood Design, 47.24&quot;W\",\"description\":\"The multisquare wooden plank tabletop creates a natural and textured look that will catch the eye in any space. A bronze frame creates a sturdy base, stable enough for this piece to work wherever you need storage. This unique piece comes fully assembled and has easy care, making it a must-have addition. 47.24&quot;W x 25.59&quot;D x 15.75&quot;H Tabletop made with unique multisquare wood parquetry design inset in a metal base This coffee table is a mix of modern aesthetics and traditional craftwork. The bronze frame has clean lines and modern styling. Fully assembled table No assembly required Clean with a soft, damp cloth. Avoid placing furniture near heat vents or open windows. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Coffee Table with Multisquare Wood Design, 47.24&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gNaLH6ujL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I0okjF+5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I0okjF+5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714RKLuhvtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714RKLuhvtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817jWklZI3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817jWklZI3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tWN0YfVNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tWN0YfVNL.jpg\"},{\"alt\":\"https://storage.googleapis.