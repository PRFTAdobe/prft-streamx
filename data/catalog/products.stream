        "bytes": "{\"id\":\"B07L6KM74G\",\"sku\":\"B07L6KM74G\",\"lang\":\"en\",\"slug\":\"classic-solid-wood-saddle-seat-counter-stool-with-foot-plate-24-black-2-pack-b07l6km74g\",\"name\":\"Classic Solid Wood Saddle-Seat Counter Stool with Foot Plate - 24&quot;, Black, 2-Pack\",\"description\":\"Set of two saddle-seat counter stools with foot rests Sturdy solid wood construction with A-frame design and square legs Contoured saddle-seat provides even weight distribution up to 220 pounds Ideal for counter-height surfaces such as kitchen islands, work tables, home bars, and more Classic design fits in with both contemporary and traditional decor Easy to assemble; includes all necessary hardware\",\"primaryImage\":{\"alt\":\"Classic Solid Wood Saddle-Seat Counter Stool with Foot Plate - 24&quot;, Black, 2-Pack\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711aqsVN1CL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61cW-F+HfzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61cW-F+HfzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714yHnR6JyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714yHnR6JyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYMCWVWiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NYMCWVWiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZHgBLZfLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZHgBLZfLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bBWxij2zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bBWxij2zL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label