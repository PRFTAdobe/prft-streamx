    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JPHNF\",\"sku\":\"B0857JPHNF\",\"lang\":\"en\",\"slug\":\"beech-wishbone-counter-height-barstool-38-2-h-black-and-natural-b0857jphnf\",\"name\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Black and Natural\",\"description\":\"The graceful curves of this black- and natural-colored beech barstool mask its everyday durability. It's light, portable, and perfect for any place in the house where there's a countertop. The soft, comfortable woven paper-rope seat is 100% natural. 22.4&quot;W x 22.8&quot;D x 38.2&quot;H Beech frame with a woven seat The sturdy beech frame will stand the test of time, while the soft woven paper-rope seat is easy to sink into. Simple but fashionable, this black- and natural-colored wishbone-style curved design adds sophistication to any counter area. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Black and Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/611iFBW-qyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61TEgHVKkKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61TEgHVKkKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eAtu9TCIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eAtu9TCIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uZpnSTwJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uZpnSTwJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K5AzCr7LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K5AzCr7LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51tyMy4wslL.jpg\",\