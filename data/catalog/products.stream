    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNRBX2\",\"sku\":\"B07QDNRBX2\",\"lang\":\"en\",\"slug\":\"seahurst-queen-bed-headboard-64-w-gray-taupe-b07qdnrbx2\",\"name\":\"Seahurst Queen Bed Headboard, 64&quot;W, Gray Taupe\",\"description\":\"This queen-size headboard in a charming neutral shade of gray taupe gives your bed a sense of serene grandeur. 64&quot;W x 3&quot;D x 64&quot;H Gray-taupe finish, oak veneers, rubberwood solids, nickel acrylic hardware The casual contemporary style of this collection makes it the perfect addition or update to your bedroom. Purchase the headboard alone and pair with your existing bed frame, or purchase the matching footboard and side rails to complete the look. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty. Wipe clean with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Seahurst Queen Bed Headboard, 64&quot;W, Gray Taupe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Sh0YOz2tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717mUPNTHOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717mUPNTHOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lIAb8k7DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lIAb8k7DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916sGYY6JWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916sGYY6JWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51yM9g4vN4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51yM9g4vN4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"64.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"3.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{