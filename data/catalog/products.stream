    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071FMT3R7\",\"sku\":\"B071FMT3R7\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-top-grain-leather-sofa-67-w-cognac-b071fmt3r7\",\"name\":\"Rivet Andrews Contemporary Top-Grain Leather Sofa, 67&quot; W, Cognac\",\"description\":\"Bring comfort and style into your living room with this practical loveseat.  Featuring a solid wood frame with 100% top-grain leather, it's made to withstand active households.  Clean, tailored lines add a modern touch. 67.3''W x 37”D x 36.2”H Soft top-grain leather; solid hardwood frame. Two-over-two cushion design with comfortable foam cushioning and resilient elastic webbing Simple leg assembly.  Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Top-Grain Leather Sofa, 67&quot; W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EP8fr-d0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GJsplHtVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GJsplHtVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914hwaa+RRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914hwaa+RRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jHgDYsRGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jHgDYsRGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cEU8Xbk4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cEU8Xbk4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\