    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YNL272\",\"sku\":\"B075YNL272\",\"lang\":\"en\",\"slug\":\"elden-nailhead-trim-saddle-kitchen-counter-backless-bar-stool-30-h-hemp-b075ynl272\",\"name\":\"Elden Nailhead-Trim Saddle Kitchen Counter Backless Bar Stool, 30&quot;H, Hemp\",\"description\":\"The brushed brass nailhead trim adds a handsome accent to this modern farmhouse bar stool. Tall sturdy wood legs provide stability, and performance fabric holds up to a busy family's wear and tear. 19.6&quot;W x 14.1&quot;D x 29.9&quot;H 95% polyester/5% nylon performance fabric on wood frame, solid wood legs Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Nailhead-Trim Saddle Kitchen Counter Backless Bar Stool, 30&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rKVQV3reL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iRb4c+rlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iRb4c+rlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lMpzHJlML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lMpzHJlML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911o3pA5FFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911o3pA5FFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NWhWh06dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NWhWh06dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RDtuDxXtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RDtuDxXtS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30