    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDZLRC\",\"sku\":\"B082QDZLRC\",\"lang\":\"en\",\"slug\":\"rivet-bigelow-modern-leather-sofa-with-square-legs-89-4-w-cognac-b082qdzlrc\",\"name\":\"Rivet Bigelow Modern Leather Sofa with Square Legs, 89.4&quot;W, Cognac\",\"description\":\"Clean lines and cognac-leather upholstery combine to give this sofa a timeless feel sure to become the key feature in any space. You won’t sacrifice comfort for style with this piece. The solid wood frame and square legs form a sturdy foundation, and foam-padded cushions slope for added back support. 89.4&quot;W x 37.4&quot;D x 30.7&quot;H; seat height: 18.1&quot;H; seat depth: 22.8&quot;D; seat back height: 18.1&quot;H; arm height: 24&quot;H; leg height: 5.9&quot;H Solid wood frame, plinth, and tapered legs; leather upholstery A sturdy, solid wood frame and soft, foam-padded cushions bring a mix of comfort and support to any seating area. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bigelow Modern Leather Sofa with Square Legs, 89.4&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-4trnLXSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61D5VeCi10L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61D5VeCi10L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hiNTY4XHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hiNTY4XHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rMLfvOoWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rMLfvOoWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zPj-kCPGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zPj-kCPGL.jpg\"},{\"