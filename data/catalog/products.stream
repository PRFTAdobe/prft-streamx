    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5TMV6\",\"sku\":\"B075X5TMV6\",\"lang\":\"en\",\"slug\":\"rivet-stewart-modern-industrial-recliner-with-metal-and-oak-b075x5tmv6\",\"name\":\"Rivet Stewart Modern Industrial Recliner with Metal and Oak\",\"description\":\"27”W x 37”D x 42”H Solid wood frame covered in polyester/acrylic blend fabric, brushed metal legs, oak High comfort with push-back recline feature to lean at different angles Free returns for 30 days. 1-year warranty. Who says a recliner has to look boring? Kick back and relax in this smartly styled upholstered chair with metal and wood accents. This mid-century modern piece features plush grey fabric, brushed black metal legs and arms topped in rustic oak. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Stewart Modern Industrial Recliner with Metal and Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c9fSq3+0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Lca1m3wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Lca1m3wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LKGQiPtZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LKGQiPtZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bclWAabFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bclWAabFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-8upK3FiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-8upK3FiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-kR7fyejL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-kR7fyejL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"