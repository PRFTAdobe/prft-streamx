    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0717B4TLX\",\"sku\":\"B0717B4TLX\",\"lang\":\"en\",\"slug\":\"dalton-sectional-sofa-couch-91-5-w-stone-b0717b4tlx\",\"name\":\"Dalton Sectional Sofa Couch, 91.5&quot;W, Stone\",\"description\":\"Transitional design meets exceptional comfort for everyday living in this sofa. With moisture-repelling and stain-resistant fabric, it can take toddler spills and muddy paw prints, yet still add timeless style to your family room. 91.5&quot;W x 37.5&quot;D x 35&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Transitional style Crisp, expert tailoring and track arm design built for heavy duty wear No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Dalton Sectional Sofa Couch, 91.5&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tR9MjlxmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j4-S1wmrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j4-S1wmrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IEUHuPRoS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IEUHuPRoS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17fT3ai6QS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17fT3ai6QS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l+K+T9w7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l+K+T9w7L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"91.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"135.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Stone\",\"label\":\"Stone\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Grey\",\"label\":\"Grey\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":939,\"discountedValue\":845.1}}"
