    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DFS3S\",\"sku\":\"B07B7DFS3S\",\"lang\":\"en\",\"slug\":\"industrial-metal-office-computer-desk-60-w-power-sit-to-standing-table-brown-black-b07b7dfs3s\",\"name\":\"Industrial Metal Office Computer Desk, 60&quot;W, Power Sit to Standing Table, Brown/Black\",\"description\":\"You'll love this sawhorse desk that adjusts for sitting or standing, thanks to a motorized lift top. A rustic wood top is mounted on industrial metal with an antiqued finish. Two USB ports allow you to charge devices while working. 30&quot;L x 60&quot;W x 30&quot;H Wood composites with Mindi wood veneer; metal legs with antiqued finish Will work with modern, industrial or farmhouse styles Lift top has memory and automatic lock features Assembly in an hour or less; assemble base, then bolt to top Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Metal Office Computer Desk, 60&quot;W, Power Sit to Standing Table, Brown/Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nQB3vrh+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815TYYbWceL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815TYYbWceL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tsKb95GaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tsKb95GaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMhj3WVBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMhj3WVBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+bM9W1I7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+bM9W1I7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813JfCAocTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813JfCA