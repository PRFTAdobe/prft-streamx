    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ37F9\",\"sku\":\"B07QCQ37F9\",\"lang\":\"en\",\"slug\":\"merrill-queen-headboard-with-decorative-nailhead-trim-75-w-lagoon-b07qcq37f9\",\"name\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Lagoon\",\"description\":\"This chic lagoon-colored queen-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 75&quot;W x 11&quot;D x 52&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Lagoon\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w31QlLoaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cUtBjK8rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cUtBjK8rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KRcd9S4dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KRcd9S4dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811vzqaft9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811vzqaft9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rzycrk-hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rzycrk-hL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\