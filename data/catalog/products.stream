    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F593\",\"sku\":\"B075X4F593\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-leather-loveseat-58-w-driftwood-b075x4f593\",\"name\":\"Rivet Lawson Modern Angled Leather Loveseat, 58&quot;W, Driftwood\",\"description\":\"This item is made to order just for you 58&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Leather Loveseat, 58&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vIDx0UpHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bNnZXyBaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bNnZXyBaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F1U3pACOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F1U3pACOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nRzkcsOgS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nRzkcsOgS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"58.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value