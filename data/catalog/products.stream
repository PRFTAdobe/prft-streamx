    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831YLF39\",\"sku\":\"B0831YLF39\",\"lang\":\"en\",\"slug\":\"lyon-upholstered-ottoman-45-5-w-linen-b0831ylf39\",\"name\":\"Lyon Upholstered Ottoman, 45.5&quot;W, Linen\",\"description\":\"The generous size of this fully padded ottoman provides plenty of room for putting your feet up and relaxing. The clean, modern lines and linen-colored upholstery bring a distinctive flair to your living room or family room. Durable, easy-care performance fabric makes cleaning a breeze. 45.5&quot;W x 25.5&quot;D x 20&quot;H; leg height: 6&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Lyon Upholstered Ottoman, 45.5&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KQ2R-qIuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814QA0MiwKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814QA0MiwKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dDTf-fPdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dDTf-fPdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AHCQ-Ks4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AHCQ-Ks4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"v