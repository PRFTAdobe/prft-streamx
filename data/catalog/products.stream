    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B5LVF\",\"sku\":\"B07B7B5LVF\",\"lang\":\"en\",\"slug\":\"rivet-ian-mid-century-modern-industrial-wood-kitchen-dining-table-storage-brown-b07b7b5lvf\",\"name\":\"Rivet Ian Mid-Century Modern Industrial Wood Kitchen Dining Table, Storage, Brown\",\"description\":\"This table is space-saving design at its best. An extra leaf allows you to lengthen it when needed, while drawers provide storage. The modern design and butterscotch finish allow it to blend with contemporary, transitional or industrial styles. 29.02&quot;L x 19-60&quot;W x 30&quot;H Sturdy hardwoods with acacia veneer Modern design that's understated enough to fit with a range of décor Provides compact storage space along with a place to eat meals No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ian Mid-Century Modern Industrial Wood Kitchen Dining Table, Storage, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+HWNbmSjL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QHScUZmuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QHScUZmuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fKDBEfsQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fKDBEfsQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dIsmUpi4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dIsmUpi4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rBJrI+SmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rBJrI+SmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G4yqBtvpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G4yqBtvpL.jpg\"},{\"alt\":\"https://storage.googleapi