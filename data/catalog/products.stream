    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084L7RVQB\",\"sku\":\"B084L7RVQB\",\"lang\":\"en\",\"slug\":\"solid-pine-rustic-farmhouse-coffee-table-52-w-rustic-oak-b084l7rvqb\",\"name\":\"Solid Pine Rustic Farmhouse Coffee Table, 52&quot;W, Rustic Oak\",\"description\":\"This simply constructed coffee table is the perfect complement to your rustic or farmhouse decor, but its pale wood finish makes it versatile enough for any design scheme. The hollow structure provides extra storage. Durable pine construction will help keep your items secure. 52&quot;W x 26&quot;D x 18&quot;H Solid pine construction The simple design features a hollowed-out frame with a wide bottom, perfect for keeping small items both conveniently located and neatly stored. Use this piece as the perfect finishing touch for your farmhouse decor or to add a rustic touch to your existing design scheme. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Solid Pine Rustic Farmhouse Coffee Table, 52&quot;W, Rustic Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71m3fmVhl1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91E5mGjL7HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91E5mGjL7HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ROUO4JxgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ROUO4JxgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i-IyUqNJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i-IyUqNJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NvRJ7wjDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NvRJ7wjDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/or