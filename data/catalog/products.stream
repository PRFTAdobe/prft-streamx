    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQ8Q2K\",\"sku\":\"B075YQ8Q2K\",\"lang\":\"en\",\"slug\":\"rivet-florence-mid-century-modern-wide-open-back-accent-kitchen-dining-chairs-18-8-w-grey-set-of-2-b075yq8q2k\",\"name\":\"Rivet Florence Mid-Century Modern Wide Open-Back Accent Kitchen Dining Chairs, 18.8&quot;W, Grey, Set of 2\",\"description\":\"The unique shape of this Mid-century modern chair's open back give it a light, airy feel that works in a dining room, craft room, home office -- anywhere you need an extra seat. It's easy to move between rooms and up and down stairs. Hardwood upholstered with polyester fabric; black metal legs Ideal for any home needing furniture that multi-tasks. 2 chairs to a pack. Assembly in 15 minutes; attach base with 4 screws. Vaccuum, spot clean with damp cloth. Free returns for 30 days. 1-year warranty. 18.8&quot;W x 22.8&quot;D x 33.9&quot;H. 18.7&quot; seat height.\",\"primaryImage\":{\"alt\":\"Rivet Florence Mid-Century Modern Wide Open-Back Accent Kitchen Dining Chairs, 18.8&quot;W, Grey, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9130l7YyGdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1C9cBXvOVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1C9cBXvOVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1d4qVB9BsS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1d4qVB9BsS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gOe-IPHhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gOe-IPHhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812ggHq6T0L.jpg\",\"url\":\"h