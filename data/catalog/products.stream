    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ1X2J4\",\"sku\":\"B07QJ1X2J4\",\"lang\":\"en\",\"slug\":\"rivet-modern-haraden-upholstered-button-tufted-bench-44-w-navy-b07qj1x2j4\",\"name\":\"Rivet Modern Haraden Upholstered Button-Tufted Bench, 44&quot;W, Navy\",\"description\":\"This charming, sophisticated-looking bench would be equally at home at the foot of your bed or under a spacious window. The navy-blue button-tufted upholstery makes this as classy as it is comfortable. 44&quot;W x 16&quot;D x 17&quot;H Durable polyester fabric over wood frame; solid wood legs in a walnut finish Contemporary design with wood frame upholstered in navy-colored fabric; solid wood legs Foam padding and elastic suspension system keep seat firm and springy. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. Avoid moisture. Wipe clean with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Modern Haraden Upholstered Button-Tufted Bench, 44&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VlSf9Cc7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tm6LuQn1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tm6LuQn1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81weTRT1jsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81weTRT1jsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hkFZCB3gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hkFZCB3gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816Qk2KLSgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816Qk2KLSgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NZ3nhAlXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NZ3nhAlXL.jpg\