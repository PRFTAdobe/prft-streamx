    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086VZ7NMD\",\"sku\":\"B086VZ7NMD\",\"lang\":\"en\",\"slug\":\"seriana-upholstered-power-recliner-chair-34-w-sandstone-b086vz7nmd\",\"name\":\"Seriana Upholstered Power Recliner Chair, 34&quot;W, Sandstone\",\"description\":\"This power recliner chair fits perfectly in contemporary living rooms. The sandstone upholstery goes with any decor and is durable and easy to maintain. High armrests provide additional support. The tall back cushions are loose, allowing you to adjust for comfort as the footrest reclines. This item is made to order just for you 34&quot;W x 40&quot;D x 29&quot;H; seat height: 20&quot;H; seat depth: 23&quot;D; back height: 27&quot;H; arm height: 28&quot;H; leg height: 2.25&quot;H Sturdy wood frame with stain-resistant fabric Plug directly into outlet for power, or use battery pack so you do not have to worry about cords. The footrest reclines, but the back does not move. No assembly required Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Seriana Upholstered Power Recliner Chair, 34&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71muvqLMyeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P8fqBJ8ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P8fqBJ8ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lhUEZi4+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lhUEZi4+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZnW4huS9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZnW4huS9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816r-f0-CuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816r-f0-CuL.jpg\"},{\"a