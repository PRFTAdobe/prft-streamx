    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QK35CN1\",\"sku\":\"B07QK35CN1\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-iron-b07qk35cn1\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Iron\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft iron-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Cotton fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gF1WDirNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61BDSR8NjYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61BDSR8NjYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DoCgswL-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DoCgswL-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SFMIcoY8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SFMIcoY8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":