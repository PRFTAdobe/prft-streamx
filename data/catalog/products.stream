        "bytes": "{\"id\":\"B07B4YNHPF\",\"sku\":\"B07B4YNHPF\",\"lang\":\"en\",\"slug\":\"rivet-gwyneth-mid-century-velvet-king-bed-with-headboard-82-w-navy-blue-b07b4ynhpf\",\"name\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 82&quot;W, Navy Blue\",\"description\":\"92.125&quot;L x 81.66&quot;W x 49&quot;H 100% Polyester Fabric Elegant, modern design High performance fabric that will last Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 1-year warranty. Add a crisp, tailored feel to your bedroom with this modern upholstered king bed. Elegance abounds with the panel tufted headboard and footboard covered in plush navy velvet. Simple tapered wood legs complete the look.\",\"primaryImage\":{\"alt\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 82&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ULTTSAa9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l1z7WfjJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1l1z7WfjJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jjZKZmDOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jjZKZmDOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CLkr6oITL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CLkr6oITL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+gQojjGbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+gQojjGbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dTiFZXeeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dTiFZXeeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]},{\"name\":\"width\"