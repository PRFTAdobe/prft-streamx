    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL488Q\",\"sku\":\"B07QDL488Q\",\"lang\":\"en\",\"slug\":\"ravenna-home-margaret-modern-living-room-chair-28-w-beige-b07qdl488q\",\"name\":\"Ravenna Home Margaret Modern Living Room Chair, 28&quot;W, Beige\",\"description\":\"28&quot;W x 30.5&quot;D x 37.5&quot;H; seat height: 18&quot;H; seat depth: 20.5&quot;D; back cushion height: 20&quot;H; arm height: 23.25&quot;H Durable fabric on wood frame; solid wood legs with natural finish Foam padding and an elastic suspension system help keep the back and seat firm and springy. Modern style and classic comfort meet in one attractive chair. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Margaret Modern Living Room Chair, 28&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dTBCzmN6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W57HkwvcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W57HkwvcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FTNULtoPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FTNULtoPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b3TXLKQJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b3TXLKQJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d7Fl9tdmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d7Fl9tdmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pyhhWkxXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pyhhWkxXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918AfDF1kwL.jpg\",\"url\":\"https://storage.goog