    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK58HV\",\"sku\":\"B07BWK58HV\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-sofa-chaise-sectional-115-w-charcoal-grey-b07bwk58hv\",\"name\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Charcoal Grey\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912ebpKUJdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kBgFOBFbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kBgFOBFbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ehro1pOPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ehro1pOPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y9l0rF13S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y9l0rF13S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UqIiWxPvS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UqIiWxPvS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1aCsW-kNGS.jpg\",\"url\":\"https://storage.googleapis.com/puresi