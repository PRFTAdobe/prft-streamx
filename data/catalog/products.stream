    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQDKZL\",\"sku\":\"B07QBQDKZL\",\"lang\":\"en\",\"slug\":\"ravenna-home-dining-chairs-set-of-2-40-h-ivory-b07qbqdkzl\",\"name\":\"Ravenna Home Dining Chairs, Set of 2, 40&quot;H, Ivory\",\"description\":\"20.20&quot;W x 26&quot;D x 40&quot;H; seat height: 20&quot;H; seat dimension: 21&quot; x 18&quot; This set of 2 dining chairs features a solid wood frame for durability and ivory-colored fabric upholstery for easy maintenance. Web suspension and no-sag springs provide comfortable seating. The gently curving back, flared legs, and trim of individually placed silver nailheads add an elegant touch to your dining room. The style blends easily with either classic or modern furniture. Assemble in 15 minutes or less Clean by vacuuming or wiping with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Dining Chairs, Set of 2, 40&quot;H, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z-GJQNa9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81s-SW5T1+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81s-SW5T1+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-IbeY1mIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-IbeY1mIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XS7RuLGiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XS7RuLGiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812k3KLWGwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812k3KLWGwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PI9zoCM1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PI9zoCM1L.jpg\"}],\"attributes\":[{\"name\":\"