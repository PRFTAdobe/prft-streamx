    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSF15K2\",\"sku\":\"B07HSF15K2\",\"lang\":\"en\",\"slug\":\"rivet-weedin-contemporary-upholstered-dining-chair-set-of-2-20-x-23-x-33-inches-juniper-blue-b07hsf15k2\",\"name\":\"Rivet Weedin Contemporary Upholstered Dining Chair - Set of 2, 20 x 23 x 33 Inches, Juniper Blue\",\"description\":\"The gorgeous juniper asymmetrical weave pattern of this contemporary dining chair pairs perfectly with the sleek rounded design to make a truly modern statement of style and sophistication. Smooth black metal legs complete the motif and lend sturdy support to the cushioned wooden frame. Metal legs lend extra support to the solid wooden frame. Avoid moisture. Wipes clean with soft, dry cloth. 23&quot;D x 20&quot;W x 33&quot;H Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Weedin Contemporary Upholstered Dining Chair - Set of 2, 20 x 23 x 33 Inches, Juniper Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HMrijPz9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PMvhP6iXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PMvhP6iXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y03G9sBnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y03G9sBnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gpQ7TD7tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gpQ7TD7tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OVmvfcCML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OVmvfcCML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yreYpWOhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yreYpWOhL.jpg\"}],\"attributes\":[{\"name\":\"height\",\