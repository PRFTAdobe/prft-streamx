  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WN36\",\"sku\":\"B075X2WN36\",\"lang\":\"en\",\"slug\":\"rivet-curved-tufted-velvet-accent-chair-marina-mid-century-28-7-w-hunter-green-b075x2wn36\",\"name\":\"Rivet Curved Tufted Velvet Accent Chair, Marina Mid-Century, 28.7&quot;W, Hunter Green\",\"description\":\"Modernize your living room or bedroom with the curves of this mid-century inspired chair. It features luxurious velvet upholstery, a tufted back and curved arms that fit you in all the right places. The hardwood back adds extra style and sturdiness. Sturdy hardwood frame with soft, 100% polyester velvet fabric. Plush style in a compact size for small spaces Simple leg assembly. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty. 28.7&quot;W x 29.9”D x 31.1”H. Seat height is 18.1&quot;.\",\"primaryImage\":{\"alt\":\"Rivet Curved Tufted Velvet Accent Chair, Marina Mid-Century, 28.7&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Xl1truRSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-IHkhM7RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-IHkhM7RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wlq-UBjML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wlq-UBjML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XUHbBlkRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XUHbBlkRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hPbUcYcsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hPbUcYcsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"}],\"attributes\":[{\"name\":\"heigh