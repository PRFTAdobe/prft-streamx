    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VR52\",\"sku\":\"B075X4VR52\",\"lang\":\"en\",\"slug\":\"leila-velvet-tufted-sofa-69-w-navy-blue-b075x4vr52\",\"name\":\"Leila Velvet Tufted Sofa, 69&quot;W, Navy Blue\",\"description\":\"This item is made to order just for you 69&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with 100% polyester upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look loveseat. With solid wood legs in a dark walnut finish, plush velvet upholstery and a low, curved tufted back, it exudes opulence. Two removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Velvet Tufted Sofa, 69&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oxHoB51RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819LsbOJwLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819LsbOJwLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x5Mhkyb0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1x5Mhkyb0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KW2xJXY5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KW2xJXY5L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":