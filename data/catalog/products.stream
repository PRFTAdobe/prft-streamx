    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MDG86\",\"sku\":\"B07B4MDG86\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-charcoal-b07b4mdg86\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Charcoal\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 31&quot;W x 23&quot;D x 20&quot;H; Seat Height: 20&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 20&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c6pNPFdBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0vLO2FsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z0vLO2FsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w+Nza4fUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w+Nza4fUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RenETPGUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1RenETPGUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Gdqt3S5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Gdqt3S5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zRBsbexLL.jpg\",\"url\":\"https://storage.googleapis.com