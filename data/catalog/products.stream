    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCQ6Z8\",\"sku\":\"B082QCQ6Z8\",\"lang\":\"en\",\"slug\":\"rivet-bigelow-modern-sofa-with-square-legs-89-4-w-navy-b082qcq6z8\",\"name\":\"Rivet Bigelow Modern Sofa with Square Legs, 89.4&quot;W, Navy\",\"description\":\"Clean lines and a classic navy color combine to give this sofa a timeless feel sure to become the key feature in any space. You won’t sacrifice comfort for style with this piece. The solid wood frame and square legs form a sturdy foundation, and foam-padded cushions slope for added back support. 89.4&quot;W x 37.4&quot;D x 30.7&quot;H; seat height: 18.1&quot;H; seat depth: 22.8&quot;D; seat back height: 18.1&quot;H; arm height: 24&quot;H; leg height: 5.9&quot;H Solid wood frame, plinth, and tapered legs A sturdy, solid wood frame and soft, foam-padded cushions bring a mix of comfort and support to any seating area. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bigelow Modern Sofa with Square Legs, 89.4&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LCFALgaqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811rcciCMAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811rcciCMAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cqnZKtZEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cqnZKtZEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwsR3G8xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwsR3G8xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h-FCCtPqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h-FCCtPqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-im