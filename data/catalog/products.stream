    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZVP19\",\"sku\":\"B07PBZVP19\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-sofa-with-tufted-back-79-9-w-emerald-green-b07pbzvp19\",\"name\":\"Rivet Sloane Mid-Century Modern Sofa with Tufted Back, 79.9&quot;W, Emerald Green\",\"description\":\"This modern sofa sports a tufted back, a strong profile, and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The durable upholstery and solid-wood frame make this piece both cozy and reliable. 79.9&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; 100% polyester upholstery A solid wood frame and durable fabric make this sofa as practical as it is stylish. A tufted back adds elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Sofa with Tufted Back, 79.9&quot;W, Emerald Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NR414wVOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YmTGd2nJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YmTGd2nJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H3QPi0ZSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H3QPi0ZSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-TKAAF4rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-TKAAF4rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IxNms69jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IxNms69jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zrp1JnESL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/