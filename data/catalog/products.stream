    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8SV5P5\",\"sku\":\"B07P8SV5P5\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-leather-sofa-with-tapered-wood-legs-74-w-black-b07p8sv5p5\",\"name\":\"Rivet Aiden Mid-Century Leather Sofa with Tapered Wood Legs, 74&quot;W, Black\",\"description\":\"This sofa features easy-care leather with removable cushions that will help keep cleaning simple, and the attractive black color will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 74&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable and reversible back cushions Mid-century style and top grain leather combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Leather Sofa with Tapered Wood Legs, 74&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-KiTrUj-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qBmXdERrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qBmXdERrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NAdwQjYbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NAdwQjYbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UZMOJPeSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UZMOJPeSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DHmIbH15L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DHmIbH15L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CVomqBYOL.jpg\",\"url\":\"https://storage.googleapis.com/pure