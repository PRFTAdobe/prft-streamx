    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G5SY7\",\"sku\":\"B07B4G5SY7\",\"lang\":\"en\",\"slug\":\"rivet-cliff-mid-century-modern-round-tufted-velvet-pouf-ottoman-39-w-evergreen-b07b4g5sy7\",\"name\":\"Rivet Cliff Mid-Century Modern Round Tufted Velvet Pouf Ottoman, 39&quot;W, Evergreen\",\"description\":\"After a long day, your tired legs and feet will look forward to this plush velvet ottoman. It's also a handy extra seat for guests and a place to rest a tray of snacks. Tufting gives it a mid-century modern flair, while the fabric adds a bit of glam. 39.3&quot;W x 39.3&quot;D x 15.7&quot;H Velvet fabric on wood frame Mid-century modern meets glam in this statement piece Can be a foot rest, extra seating for guests, or a perch for a tray of snacks No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cliff Mid-Century Modern Round Tufted Velvet Pouf Ottoman, 39&quot;W, Evergreen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916nN9EZToL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1US2nV79mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1US2nV79mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15fNrBp6ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15fNrBp6ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IIEv5FsDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IIEv5FsDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d6PLb2saL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d6PLb2saL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.3\",\"label\":\"inches\"}]},{\"nam