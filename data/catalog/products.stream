    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7YDCL\",\"sku\":\"B07HZ7YDCL\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-left-facing-loveseat-fabric-52-w-stone-b07hz7ydcl\",\"name\":\"Bagley Sectional Component, Left-Facing Loveseat, Fabric, 52&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the left-facing loveseat component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 52&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Left-Facing Loveseat, Fabric, 52&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61sZqD91osL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HTIckGa6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HTIckGa6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tROYAxJ+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tROYAxJ+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h1J2-BLHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h1J2-BLHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L8p6eVs0L.jpg\",\"url\":\"https://storage.googleapis.com