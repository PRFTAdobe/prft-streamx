    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08554L385\",\"sku\":\"B08554L385\",\"lang\":\"en\",\"slug\":\"rivet-nova-modern-slatted-back-plastic-dining-chair-set-of-2-21-6-w-moss-gray-b08554l385\",\"name\":\"Rivet Nova Modern Slatted-Back Plastic Dining Chair, Set of 2, 21.6&quot;W, Moss Gray\",\"description\":\"This modern slatted chair with a European design is stylish but flexible enough to suit many dining room tables. Its breezy appearance makes it perfect for less formal settings as well. Made of sturdy beech, steel, and plastic, it will last and adapt to any changes in the surrounding furniture. 21.6&quot;W x 23.5&quot;D x 32.1&quot;H; seat height: 15.2&quot;H; seat depth: 16.9&quot;D; seat back height: 15.7&quot;H; arm height: 24.4&quot;H; leg height: 10.4&quot;H Polypropylene, steel, beech This versatile, durable chair can be used alone or as part of a dining room set. An original piece by an Italian designer that complements many different table styles Clean with a damp, warm cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Nova Modern Slatted-Back Plastic Dining Chair, Set of 2, 21.6&quot;W, Moss Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XtQxEsaOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vNGCDtZfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vNGCDtZfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61IU+qaKU7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61IU+qaKU7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SXb5Tg9EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SXb5Tg9EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oIRbqJW8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oIRbqJW8L.jpg