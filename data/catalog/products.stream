    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSN37\",\"sku\":\"B07QFRSN37\",\"lang\":\"en\",\"slug\":\"leather-barstool-with-brass-nailhead-trim-43-h-cognac-b07qfrsn37\",\"name\":\"Leather Barstool with Brass Nailhead Trim, 43&quot;H, Cognac\",\"description\":\"Brushed-brass nailhead trim adds elegance to this traditional high-back barstool design that fits with most decor and looks great in a home or business. The top grain leather upholstery is water resistant, while the solid wood construction withstands wear from regular use, helping this stool last. 21&quot;W x 22&quot;D x 43&quot;H; seat height: 30&quot;H; seat depth: 17&quot;D Solid wood frame; brass nailhead trim; top grain leather Top grain leather provides water resistance with a cool feel. Brushed-brass nails add elegance to this transitional design, making it perfect for any home or business. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leather Barstool with Brass Nailhead Trim, 43&quot;H, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AIz1PXyCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WFM-+Y74L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WFM-+Y74L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P6ADBjVeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P6ADBjVeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+AL9WgfSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+AL9WgfSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XX4zDOhCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XX4zDOhCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WmVQsgmdL.jpg\",