    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ1J7M\",\"sku\":\"B07QCQ1J7M\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-welt-trimmed-dining-chair-35-h-felt-gray-set-of-2-b07qcq1j7m\",\"name\":\"Rivet Contemporary Welt-Trimmed Dining Chair, 35&quot;H, Felt Gray, Set of 2\",\"description\":\"The understated welt trim provides a decorative element to this simple but chic dining chair. The felt-gray upholstery will blend with any color scheme and is made of a durable, low-maintenance fabric. A solid wood frame and legs support this comfortable, low-armed seat. 23&quot;W x 25&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 17&quot;D; seat back height: 15&quot;H Set of 2 100% polyester fabric on a solid wood frame Simple design with elegant welt Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Welt-Trimmed Dining Chair, 35&quot;H, Felt Gray, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TzZQMsWyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gaRHGvbaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gaRHGvbaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X8poUr8dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X8poUr8dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tLEjZmVHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tLEjZmVHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TVaeNws-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TVaeNws-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7