        "bytes": "{\"id\":\"B07B4MD55M\",\"sku\":\"B07B4MD55M\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-leather-recliner-30-w-driftwood-b07b4md55m\",\"name\":\"Edmunds Traditional Leather Recliner, 30&quot;W, Driftwood\",\"description\":\"Straight lines and narrow arms combine modern touches with classic leather, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Top-grain leather on seat and inside back arms and footrest; split leather on sides and back Streamlined silhouette combines modern style with classic leather for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Leather Recliner, 30&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uouZd8KPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gXujR44FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gXujR44FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914N5N92WIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914N5N92WIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UXWOwfiOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UXWOwfiOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eVht78NrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eVht78NrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"88.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Glider rocker\",\"label\":\"Glider rocker\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Leather sofa\",\"label\":\"Leather sofa\"},{\"value\":\"Driftwood leather\",\"label\":\"Driftwood leather\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Full size bed frame\",\"label\":\"Full size bed frame\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":748,\"discountedValue\":673.2}}"
