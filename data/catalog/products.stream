    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HJFY5K8\",\"sku\":\"B07HJFY5K8\",\"lang\":\"en\",\"slug\":\"gaming-racing-style-office-chair-with-removable-headrest-and-high-back-cushion-red-b07hjfy5k8\",\"name\":\"Gaming/Racing Style Office Chair with Removable Headrest and High Back Cushion - Red\",\"description\":\"High-back gaming chair provides ultimate comfort and control, whether at work or play; black with red accents Made of premium PU leather upholstery on top, PVC material along the sides and bottom, and a nylon base Custom fit with height-adjustable armrest and tilt control for easily reclining; headset pillow and lumbar cushion offer added support 360-degree swivel and smooth-rolling casters for changing direction or gliding along the floor; some assembly required Measures 22.1 by 29.5 by 51 to 54.7 inches (LxWxH); weighs 40.8 pounds; backed by an AmazonBasics 1-year limited warranty High-back gaming chair provides ultimate comfort and control, whether at work or play; black with red accents Uphostered with premium PU leather on top, PVC materials along the sides and bottom; enhanced strong metal frame for extra stability and durability Custom fit with height-adjustable armrest and tilt control for easily reclining; removable headset pillow and lumbar cushion offer addional support and comfort 360-degree swivel and smooth-rolling casters for changing direction or gliding along the floor Measures 22.1 by 29.5 by 51 to 54.7 inches (LxWxH); 275lbs weight capacity hardware and instructions are included for easy assembly; backed by AmazonBasics 1-year limited warranty\",\"primaryImage\":{\"alt\":\"Gaming/Racing Style Office Chair with Removable Headrest and High Back Cushion - Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61JUe6eJUZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Bv4y3SPTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Bv4y3SPTL.jpg\"},{\"al