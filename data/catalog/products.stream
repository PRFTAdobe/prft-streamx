    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP3BFD\",\"sku\":\"B075YP3BFD\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-counter-height-stool-37-h-aqua-b075yp3bfd\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Aqua\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x 37&quot;H | Seat height is 26&quot;. Durable polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. This counter stool's substantial arms, back and padded seat, and swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a Mid-century style statement piece in your home. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UKA2HnKYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WdmR7hrcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WdmR7hrcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yim30BSgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yim30BSgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mPPP9gD9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mPPP9gD9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YvYtHQALS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YvYtHQALS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mFTRPYNfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mFTRP