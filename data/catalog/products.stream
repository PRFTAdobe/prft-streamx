    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085FGZVYY\",\"sku\":\"B085FGZVYY\",\"lang\":\"en\",\"slug\":\"ravenna-home-push-back-recliner-living-room-chair-33-9-w-beige-b085fgzvyy\",\"name\":\"Ravenna Home Push-Back Recliner Living Room Chair, 33.9&quot;W, Beige\",\"description\":\"33.9&quot;W x 36.2&quot;D x 41.3&quot;H; seat height: 18.5&quot;H; seat depth: 20.9&quot;D Plywood frame with strong reclining mechanism, comfortable seat cushion, and streamlined piping Manual push-back recliner with solid round arms and wingback design Assemble in 15 minutes or less Indoor use only; avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Push-Back Recliner Living Room Chair, 33.9&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T+dLB5MPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8169+VhH44L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8169+VhH44L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uAIsVYP-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uAIsVYP-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CmcPxRGJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CmcPxRGJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F2tjBbbgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71F2tjBbbgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DgWtC3eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DgWtC3eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eK0d-ITrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eK0d-ITrL.jpg\"},{\"alt\":\"