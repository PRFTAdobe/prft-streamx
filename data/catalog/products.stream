    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JVMJ2\",\"sku\":\"B07P6JVMJ2\",\"lang\":\"en\",\"slug\":\"rivet-cove-modern-tufted-accent-chair-with-tapered-legs-mid-century-32-7-w-denim-b07p6jvmj2\",\"name\":\"Rivet Cove Modern Tufted Accent Chair with Tapered Legs, Mid-Century, 32.7&quot;W, Denim\",\"description\":\"This modern armchair comes with tufted back and seat cushions atop tall tapered legs. The design offers simple lines that fit well with most decors, and the solid wood frame give this beautiful piece a sense of solidity and timelessness. 32.7&quot;W x 33.9&quot;D x 35.4&quot;H Solid wood frame and legs; 100% polyester upholstery Add style when you add extra seating with this gorgeous modern armchair. Tufting on the seat and back cushions adds elegance to this modern armchair. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cove Modern Tufted Accent Chair with Tapered Legs, Mid-Century, 32.7&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GCN5nGZrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XdatRhiqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XdatRhiqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nv4BQWbSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nv4BQWbSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y9zx-ZugL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y9zx-ZugL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kREY6oK6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kREY6oK6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911CCXA3uTL.jpg\",\"url\":\"https://storage.googleapis.com/