    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ24F4Z\",\"sku\":\"B07QJ24F4Z\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-lagoon-b07qj24f4z\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Lagoon\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft lagoon-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Lagoon\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oZPqKrrTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811vzqaft9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811vzqaft9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GAnd5VZUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GAnd5VZUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918EiKY3glL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918EiKY3glL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9148NsKZY-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9148NsKZY-L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"64.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"3.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"49.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Panels\",\"label\":\"Panels\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Boards\",\"label\":\"Boards\"},{\"value\":\"Platform\",\"label\":\"Platform\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Mattress\",\"label\":\"Mattress\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Floating\",\"label\":\"Floating\"},{\"value\":\"Needed\",\"label\":\"Needed\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Lights\",\"label\":\"Lights\"},{\"value\":\"Escritorio\",\"label\":\"Escritorio\"},{\"value\":\"Computer\",\"label\":\"Computer\"},{\"value\":\"Sized\",\"label\":\"Sized\"},{\"value\":\"Lttle\",\"label\":\"Lttle\"},{\"value\":\"No\",\"label\":\"No\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Poppy\",\"label\":\"Poppy\"},{\"value\":\"Head\",\"label\":\"Head\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Kid\",\"label\":\"Kid\"},{\"value\":\"Monarch\",\"label\":\"Monarch\"},{\"value\":\"Youth\",\"label\":\"Youth\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"Box\",\"label\":\"Box\"},{\"value\":\"Spring\",\"label\":\"Spring\"},{\"value\":\"Girls\",\"label\":\"Girls\"},{\"value\":\"Kids\",\"label\":\"Kids\"},{\"value\":\"Crema\",\"label\":\"Crema\"},{\"value\":\"Cal\",\"label\":\"Cal\"},{\"value\":\"Taupe\",\"label\":\"Taupe\"},{\"value\":\"Progressive\",\"label\":\"Progressive\"},{\"value\":\"Pink\",\"