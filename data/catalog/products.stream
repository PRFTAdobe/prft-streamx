    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ1MZX\",\"sku\":\"B07QCQ1MZX\",\"lang\":\"en\",\"slug\":\"glenwilde-full-headboard-69-w-eclipse-b07qcq1mzx\",\"name\":\"Glenwilde Full Headboard, 69&quot;W, Eclipse\",\"description\":\"The strong, smooth lines of this eclipse-colored full-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 69&quot;W x 11&quot;D x 52&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Full Headboard, 69&quot;W, Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81crDcVJQCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yhNtRuVrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yhNtRuVrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916d0Ltpd7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916d0Ltpd7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vqODLRyiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vqODLRyiL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"