    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5TMWF\",\"sku\":\"B075X5TMWF\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-velvet-tufted-customizable-daybed-sofa-78-w-berry-amp-silver-b075x5tmwf\",\"name\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Berry &amp; Silver\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and silver metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Berry &amp; Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CLYD270dL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1+C4r3jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L1+C4r3jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oGC9+ctzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oGC9+ctzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AY49uRwsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AY49uRwsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gXAUlt7tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gXAUlt7tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VPyegY5EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-ima