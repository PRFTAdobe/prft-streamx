    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJWXMMQ\",\"sku\":\"B07QJWXMMQ\",\"lang\":\"en\",\"slug\":\"abigail-ottoman-29-w-haze-b07qjwxmmq\",\"name\":\"Abigail Ottoman, 29&quot;W, Haze\",\"description\":\"Comfort meets class in this attractive transitional-style ottoman. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The seat cushions are reversible to prolong the life of this ottoman. 29&quot;W x 23&quot;D x 19&quot;H; seat height: 19&quot;H; seat depth: 23&quot;D; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The ottoman is light and easy to move around your room for ideal comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Ottoman, 29&quot;W, Haze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61vkqStiTTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yvg2ykLoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yvg2ykLoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13EIbFqYiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13EIbFqYiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OU3d6qahL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OU3d6qahL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.0\",\"label\":\"inches\"}]},{\"na