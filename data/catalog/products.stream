    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8JNR\",\"sku\":\"B0723H8JNR\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-oversized-tufted-accent-arm-chair-50-w-hemp-b0723h8jnr\",\"name\":\"Bradbury Chesterfield Oversized Tufted Accent Arm Chair, 50&quot;W, Hemp\",\"description\":\"An updated twist on the classic Chesterfield design, this handsome tufted arm chair is as comfortable as it is eye-catching. Its sturdy design and high performance upholstery will hold up to your busy family. Solid and engineered hardwoods; polyester/nylon fabric Timeless and functional Refreshed design of a classic with extra wide seating capacity. Minimal assembly; just attach legs Free returns for 30 days. 3-year warranty. Dimensions: 50&quot;W x 39&quot;D x 30.3&quot;H\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Oversized Tufted Accent Arm Chair, 50&quot;W, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915-G55ygvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VuOafMQ3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VuOafMQ3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1elXR3EPzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1elXR3EPzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15me5O0-kS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15me5O0-kS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jAHSz4fnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jAHSz4fnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14ipZw3jsS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14ipZw3jsS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.31496\",\"label\":\"