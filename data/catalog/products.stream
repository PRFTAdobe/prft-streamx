    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMWRX5\",\"sku\":\"B075YMWRX5\",\"lang\":\"en\",\"slug\":\"industrial-swivel-kitchen-dining-room-counter-bar-stool-adjustable-26-inch-30-inch-height-brown-wood-b075ymwrx5\",\"name\":\"Industrial Swivel Kitchen Dining Room Counter/Bar Stool, Adjustable 26 Inch-30 Inch Height, Brown Wood\",\"description\":\"This barstool is high-style industrial and versatile as well. The seat adjusts from counter height to bar height with a few simple turns. Natural color variations in the wood seat make each one uniquely beautiful. The base is made of durable metal. 17.75&quot; Diameter. Height adusts from 26&quot;-30.&quot; Solid wood and metal Adjustable height allows this stool to work with a counter or bar Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Swivel Kitchen Dining Room Counter/Bar Stool, Adjustable 26 Inch-30 Inch Height, Brown Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+DvQP15iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m44VvGZlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m44VvGZlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z-7T9kBQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z-7T9kBQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ZjkC4wKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ZjkC4wKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jWRLmirYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jWRLmirYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.7