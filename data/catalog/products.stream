    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDDJV9\",\"sku\":\"B082QDDJV9\",\"lang\":\"en\",\"slug\":\"rivet-bayard-contemporary-leather-living-room-chair-with-curved-back-and-armrests-35-5-w-cognac-b082qddjv9\",\"name\":\"Rivet Bayard Contemporary Leather Living Room Chair with Curved Back and Armrests, 35.5&quot;W, Cognac\",\"description\":\"This living room chair is a stylish way to add extra seating wherever you need it. Cognac leather upholstery and tapered legs form a piece that combines modern design elements with a classic silhouette. Sit in comfort, supported by foam-padded cushions, a solid wood frame, and gently sloping armrests. 35.5&quot;W x 34.2&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 21.2&quot;D; seat back height: 16.53&quot;H; arm height: 24.8&quot;H; leg height: 8.27&quot;H Solid wood frame, leather upholstery This chair combines chic, contemporary design elements in a classic structure, making it the perfect fit wherever you need seating. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bayard Contemporary Leather Living Room Chair with Curved Back and Armrests, 35.5&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81F6XdxTUgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uo247+1VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uo247+1VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UTt-084SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UTt-084SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81POu2yIwVL.jpg\",\"url\