    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZXK2\",\"sku\":\"B07B4FZXK2\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-chaise-sofa-sectional-115-w-grey-linen-b07b4fzxk2\",\"name\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Grey Linen\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816Aj09H8bL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hS4nukPeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hS4nukPeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mzOvRxJnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mzOvRxJnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ohm2uCgRS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ohm2uCgRS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X5ztCeVNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X5ztCeVNL.jpg\"},{\"alt\":\"https://storage.go