    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085GX69W8\",\"sku\":\"B085GX69W8\",\"lang\":\"en\",\"slug\":\"dunburough-upholstered-power-recliner-chair-37-w-brown-b085gx69w8\",\"name\":\"Dunburough Upholstered Power Recliner Chair, 37&quot;W, Brown\",\"description\":\"The plush back and seat of this reclining chair are just the start of its comfort features. Solid construction makes it sturdy yet allows you to recline or sit up with ease. The soft upholstery comes in a deep brown that provides a classic look, sure to fit into any space you need seating. 37&quot;W x 40&quot;D x 42&quot;H; seat height: 20&quot;H; seat back height: 42&quot;H; seat depth: 22&quot;D; arm height: 25&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. A rich color and classic shape mean that this recliner can be a design staple while providing support with its padded cushions and solid frame. No assembly required Clean only with water-based shampoo or foam upholstery cleaner. Do not saturate. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Dunburough Upholstered Power Recliner Chair, 37&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818+bKzIagL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yDZGQQlZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yDZGQQlZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UCQOBPvcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UCQOBPvcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914GTrTarrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914GTrTarrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810FeX1BjRL.jpg\",\"url\":\"https://storage.googleap