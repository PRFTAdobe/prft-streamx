    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X543WY\",\"sku\":\"B075X543WY\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-accent-chair-32-w-indigo-b075x543wy\",\"name\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Indigo\",\"description\":\"A straight back and sloping, low-profile arms are the highlights of this mid-century inspired chair. Assembled in the U.S., it features a sturdy wood frame upholstered with durable, tightly woven fabric for a handsome design that's built to last. This item is made to order just for you 32&quot;W x 33&quot;D x 38&quot;H. Seat height is 19&quot;. Sturdy wood frame, durable polyester fabric, wood legs with walnut finish A Mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ydPwSVWlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFu2m6CkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFu2m6CkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mck8-wwqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mck8-wwqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R0ovStawL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R0ovStawL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nmX9vI+LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nmX9vI+LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CqF1gIppL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CqF1gIppL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"59.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Indigo\",\"label\":\"Indigo\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":802,\"discountedValue\":721.8}}"
