        "bytes": "{\"id\":\"B073G6T3HK\",\"sku\":\"B073G6T3HK\",\"lang\":\"en\",\"slug\":\"benton-square-ottoman-35-w-midnight-b073g6t3hk\",\"name\":\"Benton Square Ottoman, 35&quot;W, Midnight\",\"description\":\"A perfect combination of style and practicality, this modern square ottoman is a great addition to any seating area. Its generous size and sturdy build allow it to work as a comfy footrest or a place to rest a tray of snacks. 35&quot;W x 35&quot;D x 16&quot;H Solid pine frame and legs with polyester fabric Modern casual Practical design for use as extra seating or a footrest Minimal assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Benton Square Ottoman, 35&quot;W, Midnight\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iwDseIyzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RApMRVd3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RApMRVd3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1quNp96x8S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1quNp96x8S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kXOSwoJeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kXOSwoJeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uPCF0ozaS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uPCF0ozaS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hpuxY2B8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hpuxY2B8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"