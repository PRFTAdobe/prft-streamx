      "content": {
        "bytes": "{\"id\":\"B075QDTYDF\",\"sku\":\"B075QDTYDF\",\"lang\":\"en\",\"slug\":\"clifton-modern-upholstered-queen-bedwith-headboard-68-5-w-cream-b075qdtydf\",\"name\":\"Clifton Modern Upholstered Queen Bedwith Headboard, 68.5&quot;W, Cream\",\"description\":\"Clean, modern lines combined with classic fabric upholstery allow this lovely piece to work with any style bedroom. A low-profile headboard and footboard help it blend with smaller rooms. Side rails are upholstered in the same pleasing neutral color. 89.75&quot;L x 68.5&quot;W x 57.9&quot;H Hardwood frame coverd by polyester fabric Modern design with classic fabric upholstery helps it blend with most styles No box spring required; mattress sold separately Minor assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Clifton Modern Upholstered Queen Bedwith Headboard, 68.5&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817PiskMTRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912u5iaZkRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912u5iaZkRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12g9tJa6cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12g9tJa6cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M0sAZ7xyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M0sAZ7xyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jx2sQalRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Jx2sQalRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"57.875\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"89.75\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"68.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"90.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"},{\"value\":\"Infinitey natural\",\"label\":\"Infinitey natural\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Ivory\",\"label\":\"Ivory\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"}]}],\"categories\":[{\"id\":\"H