    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B51HWHC\",\"sku\":\"B07B51HWHC\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-queen-headboard-71-w-fresh-pewter-b07b51hwhc\",\"name\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Fresh Pewter\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 71&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Fresh Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817wqCuGUhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OOAXrb+nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OOAXrb+nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DFLle4HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DFLle4HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915aI6OEwFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915aI6OEwFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wp1SeItJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wp1SeItJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127TdtyaxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127TdtyaxL.jp