    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LM5D3\",\"sku\":\"B07P5LM5D3\",\"lang\":\"en\",\"slug\":\"leila-tufted-leather-sofa-couch-88-w-saddle-b07p5lm5d3\",\"name\":\"Leila Tufted Leather Sofa Couch, 88&quot;W, Saddle\",\"description\":\"Vintage design and chic leather upholstery combine in this piece, making it the perfect fit for modern and classic decor schemes. Foam-padded cushions and solid wood legs ensure that this sofa is functional and comfortable as well as a stylish addition to any lounge area. 88&quot;W x 36&quot;D x 31&quot; Sturdy wood frame and solid wood legs in a dark walnut finish with rich 100% top-grain leather. Foam cushions provide lasting support and comfort. Treat yourself to luxury with this striking vintage-look sofa. The classic upholstery and solid wood legs in an espresso finish exude opulence. Rich leather upholstery adds sophistication and comfort to any space. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Leather Sofa Couch, 88&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71dwvSGjN3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Hk+U-P92L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Hk+U-P92L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cFJjes6wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cFJjes6wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EhxRwMX0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EhxRwMX0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\"},{\"alt\":\"https://storage.googleapis.com