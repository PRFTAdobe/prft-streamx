    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GXYDG\",\"sku\":\"B07B4GXYDG\",\"lang\":\"en\",\"slug\":\"isabel-traditional-accent-chair-36-w-tan-b07b4gxydg\",\"name\":\"Isabel Traditional Accent Chair, 36&quot;W, Tan\",\"description\":\"With performance fabric that resists stains along with wear and tear, this handsome chair is ready for guests, pets and an active family. Its clean, streamlined design blends with most any style room. A matching storage ottoman is sold separately. 35.8&quot;W x 35.4&quot;D x 37.4&quot;H Performance fabric on wood frame Streamlined design fits a modern or transitional room Comfortable seating with a classic style Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Accent Chair, 36&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Ljms5txL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+Pu1TTayL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+Pu1TTayL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DPiWA1xyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DPiWA1xyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1usNhT5gvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1usNhT5gvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mJG3PQI+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mJG3PQI+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label