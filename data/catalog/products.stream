    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSGBB2D\",\"sku\":\"B07HSGBB2D\",\"lang\":\"en\",\"slug\":\"rylee-modern-bookcase-27-6-w-x-76-8-h-mixed-gray-b07hsgbb2d\",\"name\":\"Rylee Modern Bookcase 27.6&quot;W x 76.8”H, Mixed Gray\",\"description\":\"Classic style with a modern flair make this bookcase unique. A mixed-gray finish adorns the 4 spacious niches, and the built-in drawer makes for extra storage capacity. The slim profile is ideal for small offices, libraries, and bedrooms. 27.6”W x 13.8”D x 76.8”H Wood Mixed gray finish adds a modern flair to this sturdy wood bookcase Full-size niches and a built-in drawer afford ample space for your collection. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rylee Modern Bookcase 27.6&quot;W x 76.8”H, Mixed Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f2DZ0-TJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hp8zMT7+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hp8zMT7+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YM8nEv5hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YM8nEv5hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VSOyWczQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VSOyWczQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w+ec3gybL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w+ec3gybL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.66\",\"label\":\"inche