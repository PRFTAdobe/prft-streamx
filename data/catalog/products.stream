    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TYTR16H\",\"sku\":\"B07TYTR16H\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-counter-height-stool-37-h-chalk-b07tytr16h\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Chalk\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x 37&quot;H | Seat height is 26&quot;. Durable polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. This counter stool's substantial arms, back and padded seat, and swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a Mid-century style statement piece in your home. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Counter Height Stool, 37&quot;H, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HWW1kSrmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81riAhQUzrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81riAhQUzrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FgtIZAWhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FgtIZAWhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f43c-dJbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f43c-dJbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816cP+hbnIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816c