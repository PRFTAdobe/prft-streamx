    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07M7MMPYP\",\"sku\":\"B07M7MMPYP\",\"lang\":\"en\",\"slug\":\"ravenna-home-modern-dining-chair-36-inch-height-denim-blue-b07m7mmpyp\",\"name\":\"Ravenna Home Modern Dining Chair, 36 Inch Height, Denim Blue\",\"description\":\"Overall: 26.0&quot;W x 21.7&quot;D x 36.0&quot;H; seat height: 18.5&quot;H; seat depth: 21&quot;D; seat back height: 17.52&quot;H; arm height: 24.40&quot;H Dining chair framed in wood and manufactured wood; cushioned with high-density foam for comfort A clean-lined square back, elegant low-swoop arms, plush upholstery, and beautiful nailhead trim make this dining chair both convenient accent seating and a stunning decor accent. Brown-finished solid-wood legs balance the design and offer lasting durability. Soft, woven fabric upholstery is 100% polyester for easy cleaning and maintenance. Assemble in 15-30 minutes Use water-based cleaning agents or foam. Never use tap water. Use distilled water, as tap water contains minerals that may cause rings or fading.\",\"primaryImage\":{\"alt\":\"Ravenna Home Modern Dining Chair, 36 Inch Height, Denim Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y7KPtV2QL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fksGalG5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fksGalG5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QYt7WRlHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QYt7WRlHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916pvKMhWXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916pvKMhWXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dIby+NHhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dIby+NHhL.jpg\"},{\"alt\":\"https://storage.googleap