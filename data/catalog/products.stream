    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BGYVB\",\"sku\":\"B07B7BGYVB\",\"lang\":\"en\",\"slug\":\"rivet-ferry-modern-industrial-dining-room-kitchen-chairs-36-inch-height-set-of-2-grey-black-metal-b07b7bgyvb\",\"name\":\"Rivet Ferry Modern Industrial Dining Room Kitchen Chairs, 36 Inch Height, Set of 2, Grey, Black Metal\",\"description\":\"A fun retro vibe makes these chairs eclectic and modern. Clever metal leg bases are left exposed a short way up the sides for an extra industrial touch. The armless style is compact for the dining table or other rooms in need of extra seating. 19.2&quot;W x 25.9&quot;D x 35.8&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 18.1&quot;D; Seat Back Height: 16.5&quot;H; Arm Height: 19.2&quot;H Metal frame with cotton fabric Modern industrial with a retro vibe Use as dining room chair or as extra chair in living room or bedroom No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ferry Modern Industrial Dining Room Kitchen Chairs, 36 Inch Height, Set of 2, Grey, Black Metal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dhPdpOR9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YGvTLWxwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YGvTLWxwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811kEx5WVtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811kEx5WVtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hSd+4h9PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hSd+4h9PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814rhOPEtML.jp