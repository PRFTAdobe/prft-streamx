    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ML473\",\"sku\":\"B07B4ML473\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-mid-century-modern-couch-sofa-87-w-slate-brown-b07b4ml473\",\"name\":\"Rivet Edgewest Low Back Mid-Century Modern Couch Sofa, 87&quot;W, Slate Brown\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 87&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Mid-Century Modern Couch Sofa, 87&quot;W, Slate Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sjkZCrFNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c17ERtSQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c17ERtSQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ACUDjA0NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ACUDjA0NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ArDB6KYFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ArDB6KYFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfzohkLqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfzohkLqL.jpg\"},{\"alt\":\"https://storag