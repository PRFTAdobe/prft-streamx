    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MDK2G\",\"sku\":\"B07B4MDK2G\",\"lang\":\"en\",\"slug\":\"andover-leather-living-room-accent-chair-38-w-driftwood-b07b4mdk2g\",\"name\":\"Andover Leather Living Room Accent Chair, 38&quot;W, Driftwood\",\"description\":\"Complete your living space with this stylish chair. With its driftwood-colored upholstery, this chair is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this chair’s life. Overall: 38&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Living Room Accent Chair, 38&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kBIyu+XfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g5jQlozvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g5jQlozvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IlgmulMOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IlgmulMOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LZVOCPlbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LZVOCPlbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tlcbJbpkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tlcbJbpkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C55ZbAmwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91C55ZbAmwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"92.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Accent chair\",\"label\":\"Accent chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":395,\"discountedValue\":355.5}}"
