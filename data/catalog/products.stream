    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCQ723\",\"sku\":\"B082QCQ723\",\"lang\":\"en\",\"slug\":\"rivet-revere-round-upholstered-iron-framed-ottoman-30-3-w-grey-b082qcq723\",\"name\":\"Rivet Revere Round Upholstered Iron-Framed Ottoman, 30.3&quot;W, Grey\",\"description\":\"Your feet and legs will rest comfortably on the foam padding in this ottoman. A powder-coated iron frame forms a steady base. Upholstery in grey leather ensures that this piece will blend with all color schemes and design tastes, making this a simple way to spruce up your space. 30.3&quot;W x 30.3&quot;D x 18.1&quot;H; seat height: 18.1&quot;H; seat depth: 30.3&quot;D; leg height: 7.3&quot;H Powdered-iron base, polyester upholstery An easy and stylish way to add comfort to any seating area, this ottoman is foam padded to create soft support. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Revere Round Upholstered Iron-Framed Ottoman, 30.3&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wziOHG5RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GE+EBBifL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GE+EBBifL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dTTR8+w1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dTTR8+w1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CiEN3thrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CiEN3thrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YAE1JYO0L.jpg\",\"url\":\"https://storage.