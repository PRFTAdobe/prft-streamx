    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z96KX3\",\"sku\":\"B075Z96KX3\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-industrial-canvas-set-of-2-dining-room-kitchen-chairs-31-5-inch-height-grey-b075z96kx3\",\"name\":\"Rivet Mid-Century Industrial Canvas Set of 2 Dining Room Kitchen Chairs, 31.5 Inch Height, Grey\",\"description\":\"This industrial chair features canvas stretched across a steel frame. Tough fabric and strong construction combine to make this sturdy piece useful at a dining table, in the living area or at a desk. 19.7&quot;W x 20.5&quot;D x 31.5&quot;H Canvas fabric and metal frame with black finish No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. A style statement piece useful in a dining room, living area or home office. 2 chairs to a pack.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Industrial Canvas Set of 2 Dining Room Kitchen Chairs, 31.5 Inch Height, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71a7+3aOZ0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Bd1lvvIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Bd1lvvIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81msAqJM6XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81msAqJM6XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+XYxyIWfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+XYxyIWfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91No1D7xApL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91No1D7xApL.jpg\"},{\"alt\":\"https://storage.googleap