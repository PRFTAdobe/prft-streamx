        "bytes": "{\"id\":\"B071ZLXZQ7\",\"sku\":\"B071ZLXZQ7\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-oversized-arm-chair-59-w-ecru-b071zlxzq7\",\"name\":\"Hoffman Down-Filled Performance Fabric Oversized Arm Chair, 59&quot;W, Ecru\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this chair has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 59&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Oversized Arm Chair, 59&quot;W, Ecru\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OR2hB7OIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YVZTU0UFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YVZTU0UFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QJINggHqS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QJINggHqS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1STnyU1JqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1STnyU1JqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kIM9qQr1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kIM9qQr1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MARBfCkNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MARBfCkNL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"labe