    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8629F\",\"sku\":\"B075Z8629F\",\"lang\":\"en\",\"slug\":\"larson-industrial-wood-metal-nesting-side-end-tables-24-w-set-of-3-walnut-b075z8629f\",\"name\":\"Larson Industrial Wood & Metal Nesting Side End Tables, 24&quot;W, Set of 3, Walnut\",\"description\":\"These three nesting tables have a natural distressed finish, while the metal legs and trim have a darker brown matte finish. The clean lines and warm wood tones will make this set look at home in most any style room. Solid pine tops and metal frames Industrial and rustic touches allow this set of tables to blend with many styles. Tops are distressed with a walnut finish Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. 3 tables included: Small: 16&quot;Wx 13.2&quot;D x 18.25&quot;H; Medium: 20&quot;W x 14.75&quot;D x 21.25&quot;H; Large: 24&quot;W x 16&quot;D x 24.25&quot;H\",\"primaryImage\":{\"alt\":\"Larson Industrial Wood & Metal Nesting Side End Tables, 24&quot;W, Set of 3, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914DnTeCHyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ndp4e9L3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ndp4e9L3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uEHOfpnGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uEHOfpnGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pLo0Otb9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pLo0Otb9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ark3zgiOL.jpg\",\"url\":\"https: