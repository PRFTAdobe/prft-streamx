    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QDXWB4\",\"sku\":\"B075QDXWB4\",\"lang\":\"en\",\"slug\":\"clifton-modern-upholstered-queen-bed-with-storage-drawers-69-5-w-cream-b075qdxwb4\",\"name\":\"Clifton Modern Upholstered Queen Bed with Storage Drawers, 69.5&quot;W, Cream\",\"description\":\"This bed is as functional as it is lovely. It features a simple modern design with classic fabric upholstery. Side rails feature two drawers on each side that are perfect for hiding holiday gifts or storing off-season clothes. 89.75&quot;L x 69.5&quot;W x 57.9&quot;H Hardwood frame coverd by polyester fabric Modern design with classic fabric upholstery helps it blend with most styles No box spring required; mattress sold separately Minor assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Clifton Modern Upholstered Queen Bed with Storage Drawers, 69.5&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n+7x5VKOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818UqKMzi-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818UqKMzi-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ee3L5bsoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ee3L5bsoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YtExtF0SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YtExtF0SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1vQ1SIk+PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9105Qq9gMBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9105Qq9gMBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values