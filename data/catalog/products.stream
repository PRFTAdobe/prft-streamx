        "bytes": "{\"id\":\"B07J2W23YZ\",\"sku\":\"B07J2W23YZ\",\"lang\":\"en\",\"slug\":\"genesse-living-room-accent-chair-37-w-fawn-b07j2w23yz\",\"name\":\"Genesse Living Room Accent Chair, 37&quot;W, Fawn\",\"description\":\"Complete your interior design with this beautiful fawn-colored accent chair. Its performance-fabric upholstery offers comfortable seating, and its clean lines and modern narrow-arm and thin-leg design make this chair an ideal addition to transitional-style home decor. Overall: 37&quot;W x 39&quot;D x 34&quot;H; Seat Height: 19.68&quot;H; Seat Depth 22.05&quot;D; Seat Back Height: 23.62&quot;H; Arm Height: 23.62&quot;H; Leg Height: 5.51&quot;H Solid-wood frame and legs with performance fabric upholstery Slim-arm design with wooden plinth Foam cushions provide lasting comfort Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Genesse Living Room Accent Chair, 37&quot;W, Fawn\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MUGgYlrzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WnD5h-FnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WnD5h-FnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VVygH-9gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VVygH-9gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910adB3EBlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910adB3EBlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t4Oxux54L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t4Oxux54L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\