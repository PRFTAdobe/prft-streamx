        "bytes": "{\"id\":\"B073G8Q63T\",\"sku\":\"B073G8Q63T\",\"lang\":\"en\",\"slug\":\"benton-square-ottoman-35-w-damask-taupe-b073g8q63t\",\"name\":\"Benton Square Ottoman, 35&quot;W, Damask Taupe\",\"description\":\"A perfect combination of style and practicality, this modern square ottoman is a great addition to any seating area. Its generous size and sturdy build allow it to work as a comfy footrest or a place to rest a tray of snacks. 35&quot;W x 35&quot;D x 16&quot;H Solid pine frame and legs with linen/cotton blend fabric Modern casual Practical design for use as extra seating or a footrest Minimal assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Benton Square Ottoman, 35&quot;W, Damask Taupe\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919TLCaIuzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QsAf06WBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QsAf06WBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12widzDtRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12widzDtRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QzM2AlX+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QzM2AlX+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ZXg83q+cS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ZXg83q+cS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JVIU0NxQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JVIU0NxQS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"labe