    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSJFK\",\"sku\":\"B07QFRSJFK\",\"lang\":\"en\",\"slug\":\"rivet-fir-mid-century-modern-dining-accent-chair-23-6-w-felt-gray-b07qfrsjfk\",\"name\":\"Rivet Fir Mid-Century Modern Dining Accent Chair, 23.6&quot;W, Felt Gray\",\"description\":\"This retro-style chair features sloping low-profile arms and tapered wood legs that bring a distinctive flair to any room. Gold foot caps and rich felt gray fabric add a glam touch to the overall appearance. 23.6&quot;W x 24.8&quot;D x 35.4&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 17.7&quot;D; Seat Back Height: 15.7&quot;H Upholstered back, seat and sloping armrests provide comfort; solid wood frame adds support This chair brings mid-century modern flair to your dining room or anywhere you need extra seating. No assembly required Avoid moisture. Wipe away dust and debris with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fir Mid-Century Modern Dining Accent Chair, 23.6&quot;W, Felt Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81igBH7ghsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812T8mDn7HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812T8mDn7HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MmVMko8EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MmVMko8EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A190Ab+HF0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A190Ab+HF0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JE5XtqwbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JE5XtqwbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815qpJcHUvL.jpg\",\"url\":\"https://storage.g