  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ1LXVM\",\"sku\":\"B07HZ1LXVM\",\"lang\":\"en\",\"slug\":\"rivet-goodwin-modern-living-room-accent-chair-32-3-w-x-35-8-h-navy-blue-b07hz1lxvm\",\"name\":\"Rivet Goodwin Modern Living Room Accent Chair, 32.3&quot;W x 35.8&quot;H, Navy Blue\",\"description\":\"This striking living-room chair will be the perfect finishing touch for your modern-style home decor. With its beautiful navy-blue upholstery, this chair will nicely complement your existing interior design, and its sleek, classy design adds elegance to any room. Overall: 32.3&quot;W x 36.2&quot;D x 35.8&quot;H; Seat Height: 18.5&quot;H; Seat Depth 22&quot;D; Seat Back Height: 20.1&quot;H; Arm Height: 26.4&quot;H; Leg Height: 6.3&quot;H Solid-wood frame and legs with 100% polyester upholstery Strong slim legs elevate this piece and add modern flair. The soft, removable back and reversible cushions ensure durability and comfort. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Goodwin Modern Living Room Accent Chair, 32.3&quot;W x 35.8&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1caPO2jhOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RndS6iTkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RndS6iTkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GrMWaQ0sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GrMWaQ0sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d3W-EccaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d3W-EccaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UHkRTRnWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UHkRTRnWL