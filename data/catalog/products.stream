    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCPZTFJ\",\"sku\":\"B07QCPZTFJ\",\"lang\":\"en\",\"slug\":\"leather-counter-height-barstool-with-brass-nailhead-trim-39-h-cognac-b07qcpztfj\",\"name\":\"Leather Counter-Height Barstool with Brass Nailhead Trim, 39&quot;H, Cognac\",\"description\":\"These high-back transitional-style barstools have distinctive cognac-colored leather upholstery with brass nailhead trim. Open sides allow for freedom of movement, and the solid wood frame provides stability and balance. 21&quot;W x 22&quot;D x 39&quot;H; seat height: 26&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Top grain leather upholstery on a solid wood frame Open sides allow maximum freedom of movement. These transitional barstools feature brass nailhead decorative trim on cognac-colored leather seats. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leather Counter-Height Barstool with Brass Nailhead Trim, 39&quot;H, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r7nWUWOzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81d7X8I-ooL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81d7X8I-ooL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C2IYHSpfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C2IYHSpfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DQYJW5onL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DQYJW5onL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HmzM6HURL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HmzM6HURL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SXNT4cEGL.jpg\",\"url\":\"https://storage.googl