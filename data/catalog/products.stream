    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0832HVJJT\",\"sku\":\"B0832HVJJT\",\"lang\":\"en\",\"slug\":\"ergonomic-500-pound-oversized-mesh-chair-with-adjustable-armrests-and-chrome-base-grey-bifma-certified-renewed-b0832hvjjt\",\"name\":\"Ergonomic 500-pound Oversized Mesh Chair with Adjustable Armrests and Chrome Base - Grey, BIFMA Certified (Renewed)\",\"description\":\"BIFMA certified high-quality mesh chair for home and office Ergonomic design with a spacious molded foam seat for extra support and comfort Durable steel construction with a weight capacity of up to 500 pounds; sturdy 5-point chrome base Adjustable height, armrests and tilt mechanism 360-degree swivel mobility and caster wheels allow you to move around your workspace easily Covered in mesh fabric for extra breathability\",\"primaryImage\":{\"alt\":\"Ergonomic 500-pound Oversized Mesh Chair with Adjustable Armrests and Chrome Base - Grey, BIFMA Certified (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mYkTTRHfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61m4nyu3uZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61m4nyu3uZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61LNyHpC4HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61LNyHpC4HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DVL3Qu4LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DVL3Qu4LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CtApAG0DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CtApAG0DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51HKMohqPHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51HKMohqPHL.jpg\"},{\"alt\":\"https://storage.goo