    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082BM2BC1\",\"sku\":\"B082BM2BC1\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-swivel-home-office-task-chair-25-5-w-ash-gray-with-nickel-finish-b082bm2bc1\",\"name\":\"Rivet Modern Upholstered Swivel Home Office Task Chair, 25.5&quot;W, Ash Gray with Nickel Finish\",\"description\":\"The soft, curved lines of this adjustable office chair will be a welcome addition to any space. The low back and arms give it a less-imposing profile suitable for a modern workplace or home office. 25.5&quot;W x 25.75&quot;D x 34&quot;–37.75&quot;H; seat height: 19.25&quot;–23&quot; Soft, contoured cushions are upholstered in ash-colored velvet. This chair has a 360-degree swivel mechanism with height and tension adjustments to accommodate your work style. This simple design focuses on comfort and functionality. Assemble in 15-30 minutes Always use on firm, level ground. Do not stand on the seat or let children play with this chair. Check (and if necessary, tighten) all screws every 90 days. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Swivel Home Office Task Chair, 25.5&quot;W, Ash Gray with Nickel Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tA01a2K8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nt5w+gZhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nt5w+gZhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hMM1DE0wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hMM1DE0wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xm2nDjNEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xm2nDjNEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uztJtcseL.jpg\",\"url\":\"https://storage.googleapis.com/puresig