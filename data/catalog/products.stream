        "bytes": "{\"id\":\"B07B4SC3LS\",\"sku\":\"B07B4SC3LS\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-queen-bed-66-w-fresh-dune-b07b4sc3ls\",\"name\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Fresh Dune\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 66&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyester/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim Queen Bed, 66&quot;W, Fresh Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816mr80OvLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1JhcJlA2kS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+nBzK3EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+nBzK3EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pxef0uI-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pxef0uI-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wx5Fhb3ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wx5Fhb3ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911QzYrMY4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911QzYrMY4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"56.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"92.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"66.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"141.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Upholstered front bed\",\"label\":\"Upholstered front bed\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"72710-050sliplago\",\"label\":\"72710-050sliplago\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Trim queen bed\",\"label\":\"Trim queen bed\"},{\"value\":\"Classic style bed\",\"label\":\"Classic style bed\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Stone and beam 72710-050sliplago\",\"label\":\"Stone and beam 72710-050sliplago\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"}]}],\"categories\":[{\"id\":\"Beds\",\"slug\":\"beds\",\"name\":\"Beds\",\"value\":\"Beds\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":767,\"discountedValue\":690.3}}"
