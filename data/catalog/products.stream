    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082JGV1YM\",\"sku\":\"B082JGV1YM\",\"lang\":\"en\",\"slug\":\"5-shelf-bookcase-75-h-weathered-oak-finish-b082jgv1ym\",\"name\":\"5-Shelf Bookcase, 75&quot;H, Weathered Oak Finish\",\"description\":\"This bookcase brings sophistication and functionality to your home with a timeless, airy design; generous shelf space; and classic molding. The X-design of the sides not only adds style but also strength. 31.7&quot;W x 13.2&quot;D x 75&quot;H Durable MDF wood and solid pine with pine veneer in weathered oak finish The 5 wide and sturdy shelves offer ample storage for books, objets d'art, keepsakes, and more. Alone or in series, this sturdy bookcase exudes classic style, equally at home in the living room, study, office, or hallway. Assemble in 15-30 minutes Using a soft, damp cloth, wipe in the direction of the wood grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"5-Shelf Bookcase, 75&quot;H, Weathered Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pVLfwoxPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Pn4Yr1PNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Pn4Yr1PNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Eb8grIywL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Eb8grIywL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z7cEHhvCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81z7cEHhvCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718+aEB5L9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718+aEB5L9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71N3dAA0X+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71