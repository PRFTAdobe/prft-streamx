        "bytes": "{\"id\":\"B07PC427H1\",\"sku\":\"B07PC427H1\",\"lang\":\"en\",\"slug\":\"classic-fabric-tufted-dining-chair-with-wooden-legs-set-of-2-charcoal-b07pc427h1\",\"name\":\"Classic Fabric Tufted Dining Chair with Wooden Legs - Set of 2, Charcoal\",\"description\":\"Set of 2 cushioned dining chairs with button tufted upholstery Timeless look that fits in well with both modern and traditional decor Button tufted backrest adds a tasteful touch to your dining room Sturdy wood frame with curved, slightly tapered legs Perfect in a formal or casual dining room, or in an elevated kitchen dining area Linen upholstery is durable, comfortable, and stylish\",\"primaryImage\":{\"alt\":\"Classic Fabric Tufted Dining Chair with Wooden Legs - Set of 2, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FnAzXVPHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zh+XTmTIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zh+XTmTIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hDFU0KxML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hDFU0KxML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iyLeQOPGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iyLeQOPGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911WdgZ6p2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911WdgZ6p2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VIKtiLcfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VIKtiLcfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.2\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.0\",\"label