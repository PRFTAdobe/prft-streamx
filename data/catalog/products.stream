      "content": {
        "bytes": "{\"id\":\"B07B7G4VYF\",\"sku\":\"B07B7G4VYF\",\"lang\":\"en\",\"slug\":\"industrial-pallet-wood-coffee-table-with-wheels-51-w-natural-b07b7g4vyf\",\"name\":\"Industrial Pallet Wood Coffee Table with Wheels, 51&quot;W, Natural\",\"description\":\"This low, wide coffee table has the look of a rustic industrial pallet on wheels. Made of reclaimed fir wood, it provides handsome style along with a place to perch remotes, magazines and snack trays on the top and lower shelf. 51.2&quot;W x 33.5&quot;D x 16.54&quot;H; Leg Height: 7.09&quot;H Reclaimed fir wood, metal wheels Rustic and industrial touches make it perfect for modern or farmhouse-style settings. Wheels make it easy to move when necessary; for indoor use only No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Pallet Wood Coffee Table with Wheels, 51&quot;W, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810TOznf1iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916eOnDWqaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916eOnDWqaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OwkHFVO1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OwkHFVO1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LJ5HnQQLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LJ5HnQQLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v5GlKB2aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v5GlKB2aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n-IA-WWqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n-IA-WWqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",