    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHYDDS1\",\"sku\":\"B07QHYDDS1\",\"lang\":\"en\",\"slug\":\"rivet-brooker-down-filled-mid-century-love-seat-65-w-quarry-b07qhydds1\",\"name\":\"Rivet Brooker Down-Filled Mid-Century Love Seat, 65&quot;W, Quarry\",\"description\":\"This mid-century love seat with removable and reversible down-filled cushions offers comfort, while the hardwood frame and tapered legs increase its daily wear-and-tear durability. Whether used as a focus piece or a foundational piece, tufted back cushions add a touch of elegance to any room. 65&quot;W x 38&quot;D x 35&quot;H Solid hardwood frame, down-filled cushions, tapered wood legs Removable and reversible down-filled cushions This mid-century love seat adds elegance and comfort to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brooker Down-Filled Mid-Century Love Seat, 65&quot;W, Quarry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZntlIIS-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FJ1Xw1EJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FJ1Xw1EJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QOG9bx72L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QOG9bx72L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919nNhieFmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919nNhieFmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZPpXAeu1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZPpXAeu1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kXM8ZfYwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9