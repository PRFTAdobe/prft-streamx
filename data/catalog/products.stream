    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MGRHY\",\"sku\":\"B07B4MGRHY\",\"lang\":\"en\",\"slug\":\"andover-studio-sofa-couch-78-w-charcoal-leather-b07b4mgrhy\",\"name\":\"Andover Studio Sofa Couch, 78&quot;W, Charcoal Leather\",\"description\":\"Complete your living space with this stylish studio sofa. With its charcoal-colored upholstery, this sofa is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sofa’s life. Overall: 78&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Studio Sofa Couch, 78&quot;W, Charcoal Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Vzeh0U9DL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cFSdprtYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cFSdprtYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hfFOFgIwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hfFOFgIwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SxKxY1SkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SxKxY1SkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VQjMyP1eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VQjMyP1eL.jpg\"}],