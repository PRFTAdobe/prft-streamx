    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0746H4BNS\",\"sku\":\"B0746H4BNS\",\"lang\":\"en\",\"slug\":\"rivet-charlotte-mid-century-modern-upholstered-gold-accent-chair-29-w-light-blue-b0746h4bns\",\"name\":\"Rivet Charlotte Mid-Century Modern Upholstered Gold Accent Chair, 29&quot;W, Light Blue\",\"description\":\"Glam meets industrial in this upholstered chair with square metal side pieces serving as arms and legs. Smart design and plush cushions make this a welcome addition anywhere a comfortable accent chair is needed. 29&quot;W x 35&quot;D x 38&quot;H Sturdy metal frame and legs in a brushed brass finish Glam industrial Nicely padded with contemporary frame No assembly. Product arrives in one piece. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Charlotte Mid-Century Modern Upholstered Gold Accent Chair, 29&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B4XFd5VwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912fNflDfxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912fNflDfxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WN9atG3rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WN9atG3rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DeGw8LWSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DeGw8LWSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UPfJTPLfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UPfJTPLfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1DDRcIjOhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1DDRcIjOhS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\"