    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMY27C\",\"sku\":\"B075YMY27C\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-kitchen-dining-room-accent-chair-33-h-canary-b075ymy27c\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Canary\",\"description\":\"Dimensions: 22.8&quot;W x 22.1&quot;D x 33.1&quot;H | Seat Height is 18.5&quot; A cut-out back and tapered legs give this accent chair a classic mid-century modern design. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Canary\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pIe8eM8KL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1diTE6hGVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1diTE6hGVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u7STDUxML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1u7STDUxML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dapjs5UlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dapjs5UlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fhpUQmH8S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fhpUQmH8S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nMConOfFL.jpg\"}]