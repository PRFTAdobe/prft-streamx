    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YLW78\",\"sku\":\"B07B4YLW78\",\"lang\":\"en\",\"slug\":\"bridgewater-curved-queen-headboard-66-w-curious-pearl-b07b4ylw78\",\"name\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Curious Pearl\",\"description\":\"This headboard adds classic style to any space. Hand-applied pewter nailhead trim accents the headboards curved silhouette. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 66&quot;W x 4&quot;D x 56&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Curved Queen Headboard, 66&quot;W, Curious Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TLEmt69uL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Iv4uJdaOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Iv4uJdaOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pA2w0eXIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pA2w0eXIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ARImn51eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ARImn51eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UDLEASOpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UDLEASOpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zaZecmVsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zaZecmVs