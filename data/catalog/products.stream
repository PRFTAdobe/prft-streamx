    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MTFSC\",\"sku\":\"B07B4MTFSC\",\"lang\":\"en\",\"slug\":\"andover-leather-living-room-accent-chair-38-w-charcoal-b07b4mtfsc\",\"name\":\"Andover Leather Living Room Accent Chair, 38&quot;W, Charcoal\",\"description\":\"Complete your living space with this stylish chair. With its charcoal-colored upholstery, this chair is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this chair’s life. Overall: 38&quot;W x 38&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Living Room Accent Chair, 38&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fLXW42OoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2OLbjiZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918NwsVip+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918NwsVip+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kPJr7p2dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kPJr7p2dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FG6oEWYgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FG6oEWYgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WIyZyMejL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W