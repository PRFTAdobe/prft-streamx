    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X543WR\",\"sku\":\"B075X543WR\",\"lang\":\"en\",\"slug\":\"cameron-classic-oversized-arm-chair-32-w-indigo-b075x543wr\",\"name\":\"Cameron Classic Oversized Arm Chair, 32&quot;W, Indigo\",\"description\":\"This item is made to order just for you 32&quot;W x 36&quot;D x 37&quot;H. Seat height is 21&quot;. Solid wood frame and legs, 100% polyester upholstery, metal with nickel finish Tight seat and back crafted to endure heavy wear. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty. Add some elegance to your living room with this oversized accent chair. With its smooth fabric on rolled arms and back, it exudes classic high style. Turned spindle wood legs on coated nickel casters makes it easy to move from room to room.\",\"primaryImage\":{\"alt\":\"Cameron Classic Oversized Arm Chair, 32&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qXzEnvbDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y7eBQf7KS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1y7eBQf7KS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9166ZVyCl6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9166ZVyCl6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yVX6jl48L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yVX6jl48L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RLXhoF5AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RLXhoF5AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FyWimxFZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FyWimxFZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Heigh