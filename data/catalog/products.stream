    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZRL8DW\",\"sku\":\"B07TZRL8DW\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-leather-high-back-swivel-seat-counter-stool-39-h-light-brown-b07tzrl8dw\",\"name\":\"Alaina Contemporary Leather High-Back Swivel Seat Counter Stool, 39&quot;H, Light Brown\",\"description\":\"This counter height bar stool allows you to fit your guests around the kitchen island for special celebrations, while a swivel function makes it extra easy for everyone to chat. Their transitional style allows them to blend with any style room. 18.5&quot;W x 22&quot;D x 39&quot;H; Seat Depth: 16.5&quot;D; Seat Back Height: 12.5&quot;H; Seat Height: 26&quot;H Durable leather on a solid hardwood frame with swivel seat and low arms Modern design with durable leather provides a transitional look No assembly required. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary Leather High-Back Swivel Seat Counter Stool, 39&quot;H, Light Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ijDfMaUrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815k9g6w6yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815k9g6w6yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3pqRdVhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71n3pqRdVhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IgjB7O7oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IgjB7O7oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OMrpru8cL.jpg\",\"url\":\"https://storage.googleapis