    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSL4TS1\",\"sku\":\"B07HSL4TS1\",\"lang\":\"en\",\"slug\":\"rivet-kingston-modern-chest-of-drawers-35-43-w-white-b07hsl4ts1\",\"name\":\"Rivet Kingston Modern Chest of Drawers 35.43&quot;W, White\",\"description\":\"The engineered geometric texture rendered in pure white puts this hardwood chest of drawers on the cusp of classic and modern. The gold accents on the drawer handles and feet add pops of color, and the three wide drawers provide plenty of space for storage. 35.43&quot;W x 17.72&quot;D x 29.53&quot;H Engineered hardwood and fiberboard; metal legs Features textured detailing on front of drawers with gold accents on handles and feet. Two drawers for maximized storage next to couch or bed; side-mounted ball-bearing drawer slides and gold hand pulls. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Kingston Modern Chest of Drawers 35.43&quot;W, White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714FBkQf26L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71McsyA4a5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71McsyA4a5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bjzbkkekL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bjzbkkekL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EcvCpIoIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EcvCpIoIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KlUeIu6nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KlUeIu6nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-aQLS05cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-aQLS05cL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"81.6\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Vanity\",\"label\":\"Vanity\"},{\"value\":\"Cherry\",\"label\":\"Cherry\"},{\"value\":\"Barn\",\"label\":\"Barn\"},{\"value\":\"Acme\",\"label\":\"Acme\"},{\"value\":\"Lingerie\",\"label\":\"Lingerie\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Asian\",\"label\":\"Asian\"},{\"value\":\"Nightstand\",\"label\":\"Nightstand\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Barnwood\",\"label\":\"Barnwood\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Mirrored\",\"label\":\"Mirrored\"},{\"value\":\"Dressers\",\"label\":\"Dressers\"},{\"value\":\"Apothecary\",\"label\":\"Apothecary\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Cabinets\",\"label\":\"Cabinets\"},{\"value\":\"Bureaus\",\"label\":\"Bureaus\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Oriental\",\"label\":\"Oriental\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Deco\",\"label\":\"Deco\"},{\"value\":\"Japanese\",\"label\":\"Japanese\"},{\"value\":\"Door\",\"label\":\"Door\"},{\"value\":\"Hollywood\",\"label\":\"Hollywood\"},{\"value\":\"Dresser\",\"label\":\"Dresser\"},{\"value\":\"Naima\",\"label\":\"Naima\"},{\"value\":\"Armour\",\"label\":\"Armour\"},{\"value\":\"Sommerford\",\"label\":\"Sommerford\"},{\"value\":\"Signature\",\"label\":\"S