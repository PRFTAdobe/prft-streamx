    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD9LQM\",\"sku\":\"B082QD9LQM\",\"lang\":\"en\",\"slug\":\"rivet-bayard-contemporary-leather-couch-with-curved-back-and-armrests-76-w-grey-b082qd9lqm\",\"name\":\"Rivet Bayard Contemporary Leather Couch with Curved Back and Armrests, 76&quot;W, Grey\",\"description\":\"Tapered legs, a rounded back and armrests, and a chic gray leather upholstery give this couch a contemporary feel, but this design is classic enough to blend with any decor. A solid wood frame and foam padding in the cushions make it a sturdy and comfortable place to relax. 76.0&quot;W x 34.3&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 21.2&quot;D; seat back height: 16.53&quot;H; arm height: 24.8&quot;H; leg height: 8.27&quot;H Solid wood frame, leather upholstery This couch combines chic, contemporary design elements in a classic structure, making it the perfect fit wherever you need seating. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bayard Contemporary Leather Couch with Curved Back and Armrests, 76&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Um+BJeMIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QVg6F1wjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QVg6F1wjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/617hpWXYnLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/617hpWXYnLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VMKep5HXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VMKep5HXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a1WkcXfVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a1WkcX