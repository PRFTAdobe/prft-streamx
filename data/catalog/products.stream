        "bytes": "{\"id\":\"B07J2R9Y7F\",\"sku\":\"B07J2R9Y7F\",\"lang\":\"en\",\"slug\":\"rivet-willard-contemporary-accent-lounge-chair-26-w-slate-b07j2r9y7f\",\"name\":\"Rivet Willard Contemporary Accent Lounge Chair, 26&quot;W, Slate\",\"description\":\"The sharp angles of this accent chair contrast nicely with the smooth comfort of the upholstery. The black metal legs are thin but sturdy, and the slate-colored upholstery adds a sense of dark beauty. Overall: 26&quot;W x 30&quot;D x 34&quot;H; Seat Height: 17.32&quot;H; Seat Depth: 20.47&quot;D; Seat Back Height: 34&quot;H; Arm Height: 24.8&quot;H; Leg Height: 19.68&quot;H Solid-wood frame with black metal legs Modern design chair No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Willard Contemporary Accent Lounge Chair, 26&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ws6Qa7UwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uGXTfNQAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uGXTfNQAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917yjurth3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917yjurth3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXLAHK4cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXLAHK4cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YhWdDeeoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YhWdDeeoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eQ3ASKogL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eQ3ASKogL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches