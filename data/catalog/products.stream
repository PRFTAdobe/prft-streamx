    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QBZB1Q\",\"sku\":\"B082QBZB1Q\",\"lang\":\"en\",\"slug\":\"rivet-theresa-modern-upholstered-accent-chair-30-w-cream-b082qbzb1q\",\"name\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Cream\",\"description\":\"A great fit for a fireside evening or just to lounge around in, this modern upholstered chair is the perfect addition to any room in your home. The slightly curved armrests add a touch of class, and the reversible seat cushion allows for longer wear. This item is made to order just for you. 30&quot;W x 31&quot;D x 33&quot;H; seat height: 20&quot;H; seat depth: 21&quot;D; seat back height: 13&quot;H; arm height: 24&quot;H; leg height: 12&quot;H This chair has a sturdy wood frame and legs. Foam seat cushions provide lasting support and comfort. Upholstery is 100% polyester. No assembly required; removable and reversible seat cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IjcEV35hL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717uSGu6mOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717uSGu6mOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aOn7+KJ+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aOn7+KJ+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b4y05XTWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b4y05XTWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UvuWNdikL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UvuWNdikL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ozKt5eFsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ozKt5eFsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CtXbmI+qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CtXbmI+qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m1B13owYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m1B13owYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"38.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Glider\",\"label\":\"Glider\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Cen