    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJD1NC\",\"sku\":\"B07BWJD1NC\",\"lang\":\"en\",\"slug\":\"andover-modern-left-l-sectional-sofa-124-w-dark-tan-b07bwjd1nc\",\"name\":\"Andover Modern Left L-Sectional Sofa, 124&quot;W, Dark Tan\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wood legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left L-Sectional Sofa, 124&quot;W, Dark Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81COxvxAoqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nslXKbSfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nslXKbSfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jc4iYG2dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jc4iYG2dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+sEdgMnUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+sEdgMnUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810hlN30YrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810hlN30YrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\