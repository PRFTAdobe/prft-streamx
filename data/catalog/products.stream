    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B84H7G8\",\"sku\":\"B07B84H7G8\",\"lang\":\"en\",\"slug\":\"traditional-nailhead-button-tufted-leather-recliner-chair-33-4-w-brown-leather-b07b84h7g8\",\"name\":\"Traditional Nailhead Button Tufted Leather Recliner Chair, 33.4&quot;W, Brown Leather\",\"description\":\"The tall, tufted back of this recliner will bring a mid-century influenced flair to your room. Leather upholstery and nail head trim accents add sophisticated touches. This piece will be a comfortable addition to any style room. 33.4&quot;W x 38.2&quot;D x 43.3&quot;H Top-grain leather on seat, inside back and arms; split leather on back and outside arms; wood legs A traditional style with a bit of mid-century influence Tall back for added comfort; push-back recliner with pop-up foot support Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Traditional Nailhead Button Tufted Leather Recliner Chair, 33.4&quot;W, Brown Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rhhKnVE4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IKdvPlwRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IKdvPlwRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915MR6zRSbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915MR6zRSbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuVfBmT9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cuVfBmT9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mapEGsxBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mapEGsxBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b01wrwtLL.jpg\",\"url\":\"https://storage.googleapis.com/pu