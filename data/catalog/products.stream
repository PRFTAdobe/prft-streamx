    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YV7V1P\",\"sku\":\"B075YV7V1P\",\"lang\":\"en\",\"slug\":\"rivet-ray-mid-century-modern-kitchen-dining-room-chairs-set-of-2-34-3-h-brown-faux-leather-b075yv7v1p\",\"name\":\"Rivet Ray Mid-Century Modern Kitchen Dining Room Chairs, Set of 2, 34.3&quot;H, Brown Faux Leather\",\"description\":\"These faux leather dining chairs feature quilted diamond stitching for an eye-catching style twist. Lightly padded for comfort, they are easily moved around to multi-task at your dining room or kitchen table, as extra seating in the living room, or at a desk. 17.7&quot;W x 20.9&quot;D x 34.3&quot;H. Seat height is 19.1&quot; Vintage-look light brown synthetic leather on wood frame; sleek industrial metal legs with black finish. A multi-tasking chair easily moved from room to room; durable coating on legs. Assemble in 10 minutes or less. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ray Mid-Century Modern Kitchen Dining Room Chairs, Set of 2, 34.3&quot;H, Brown Faux Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pUqqzgTSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pBaelJgwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ldZ2f9GbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ldZ2f9GbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptWf2dD7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptWf2dD7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RPxQRpgBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RPxQRpgBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A155Oud