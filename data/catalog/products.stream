    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCWRTW\",\"sku\":\"B082QCWRTW\",\"lang\":\"en\",\"slug\":\"rivet-madison-modern-fabric-round-lift-top-storage-tray-ottoman-pouf-19-7-w-marshmallow-b082qcwrtw\",\"name\":\"Rivet Madison Modern Fabric Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Marshmallow\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila—it's an extra tray for snacks! An ottoman couldn't be more clever and multitasking than this. 19.7&quot;W x 19.7&quot;D x 16.5&quot;H Compact and stable with wood-frame construction and durable 100% polyester fabric exterior Perfect for any room where storage space or a footstool is needed. Modern styling perfect for your contemporary home. Simple assembly in 15 minutes or less. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Madison Modern Fabric Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Marshmallow\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91esboz-0NL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LdCf6JVBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LdCf6JVBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TrD08wXFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TrD08wXFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lVqsTOb1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lVqsTOb1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i-YuTNuyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i-YuTNuyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P2xqvgC8L.jpg\",\"url\":\"https://storage.googleapis.com/puresig