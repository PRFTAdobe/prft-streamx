    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8PWBB\",\"sku\":\"B07BW8PWBB\",\"lang\":\"en\",\"slug\":\"andover-modern-right-u-sectional-sofa-134-w-sand-b07bw8pwbb\",\"name\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Sand\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; wood legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m19wlwHFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nkWO2pMPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nkWO2pMPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817WjvNCrHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817WjvNCrHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mFA6EazuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mFA6EazuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816vOK4NMwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816vOK4NMwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SAvtrGw6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SAvtrGw6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi