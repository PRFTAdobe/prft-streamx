    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGFYLLM\",\"sku\":\"B07QGFYLLM\",\"lang\":\"en\",\"slug\":\"rivet-jaxon-rustic-side-table-22-h-natural-and-black-b07qgfyllm\",\"name\":\"Rivet Jaxon Rustic Side Table, 22&quot;H, Natural and Black\",\"description\":\"Natural wood with knots, splits, color variations, repair patches, and other imperfections sits within a black metal base with 3 legs. The base forms a lip around the wood top, which creates a visual appeal and keeps things from rolling off the edge. This piece pairs well with modern decor. 16&quot;W x 16&quot;D x 22&quot;H Wood and metal This rustic tabletop touts knots, splits, repair patches, and natural imperfections and rests in a black metal base with 3 legs. The piece can be used as a side table or an accent table. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Jaxon Rustic Side Table, 22&quot;H, Natural and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JAmhLAi8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WMEDxZCuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WMEDxZCuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1whKaW3l3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1whKaW3l3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zKSV7XU+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zKSV7XU+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9132MCyTeNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9132MCyTeNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XBfxucJDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/or