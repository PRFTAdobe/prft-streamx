    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MN72YQ\",\"sku\":\"B084MN72YQ\",\"lang\":\"en\",\"slug\":\"rivet-modern-industrial-coffee-table-with-metal-base-and-trays-42-1-w-walnut-finish-b084mn72yq\",\"name\":\"Rivet Modern Industrial Coffee Table with Metal Base and Trays, 42.1&quot;W, Walnut Finish\",\"description\":\"This gorgeous coffee table is the perfect marriage of industrial chic and stylish practicality. The unique and appealing top with its split tray design helps keep objects secure, while the warm walnut finish complements the dark patina of the metal base. 42.1&quot;W x 21.7&quot;D x 15.2&quot;H Durable MDF wood with walnut-finished pine veneer atop a sturdy metal base The coffee table has a dual-tray top supported by a strong metal base. Industrial without being utilitarian, this contemporary piece will complement any interior design. Assemble in 15 minutes or less Using a soft, damp cloth, wipe in the direction of the wood grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Industrial Coffee Table with Metal Base and Trays, 42.1&quot;W, Walnut Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71y-1HhNmtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pTv6yZ+hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pTv6yZ+hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qAZu2Mj3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qAZu2Mj3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+YZFbo19L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+YZFbo19L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d7+xjARBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d7+xjARBL.jpg\"},{\"alt\":\"https://storage.googleapi