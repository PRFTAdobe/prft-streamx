    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5TN1Y\",\"sku\":\"B075X5TN1Y\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-ottoman-27-w-pearl-b075x5tn1y\",\"name\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Pearl\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Firm nylon webbing makes cushion resilient Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910DYlc7HhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A108t4vU1uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A108t4vU1uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I6ZrJT0hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I6ZrJT0hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GoOAicujL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GoOAicujL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18RoWT99zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18RoWT99zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JWIH46XWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JWIH46XWL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"