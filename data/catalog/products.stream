        "bytes": "{\"id\":\"B07P7NVLV8\",\"sku\":\"B07P7NVLV8\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-leather-sofa-couch-80-w-caramel-b07p7nvlv8\",\"name\":\"Rivet Revolve Modern Leather Sofa Couch, 80&quot;W, Caramel\",\"description\":\"This modern sofa features simple lines and square armrests atop tall tapered legs, giving it a minimalist feel that looks great with most decor styles. 79.9&quot;W x 34.6&quot;D x 35.4&quot;H Hardwood frame, solid beech wood legs and durable leather upholstery stand up to wear and tear Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Leather Sofa Couch, 80&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hSR910cpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813MZJfSvzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813MZJfSvzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JV4r4Z7kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JV4r4Z7kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-pBfiERDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-pBfiERDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UrYnSwroL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UrYnSwroL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"val