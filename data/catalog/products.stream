    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78RCTR\",\"sku\":\"B07B78RCTR\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-counter-height-wood-table-with-shelves-55-w-distressed-grey-b07b78rctr\",\"name\":\"Modern Farmhouse Counter-Height Wood Table with Shelves, 55&quot;W, Distressed Grey\",\"description\":\"This counter-height table is ready to accommodate your family for quick meals, as a kitchen island or extra task space. With 3 shelves for storage you'll have everything you need at hand. This versatile piece is ideal for a modern farmhouse kitchen. 24&quot;L x 55&quot;W x 36&quot;H Hardwood and fiberboard with neutral distressed finish Traditional design makes it ideal for a transitional area or farmhouse kitchen Can serve as a casual table for 4, kitchen island, coffee nook or task table with shelves for extra storage Assemble in 30 minutes to an hour Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Counter-Height Wood Table with Shelves, 55&quot;W, Distressed Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sc-1cmgxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814K3E6q-zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814K3E6q-zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nigxIHYaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nigxIHYaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dk+UWm47L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dk+UWm47L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RIeRbHP4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RIeRbHP4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZCV2AFYbL.jpg\",\"url\":\"https://storage.googleapis.com/p