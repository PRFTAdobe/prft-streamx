    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B074KLJQKV\",\"sku\":\"B074KLJQKV\",\"lang\":\"en\",\"slug\":\"fremont-slatted-2-door-cabinet-31-5-w-ash-b074kljqkv\",\"name\":\"Fremont Slatted 2-Door Cabinet, 31.5&quot;W, Ash\",\"description\":\"31.5”W x 15.75”D x 31.7”H Solid ash frame and legs are complemented by hardwood doors with ash veneer A handsome piece that can anchor a modern, rustic or transitional style room or hallway Display photos or a vase of flowers on top; store books or other items inside Assembly in 15 minutes or less. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. This simple, beautifully designed cabinet provides storage space as well as a handsome complement to modern, transitional or rustic décor. The vertical pieces of solid ashwood on the front of the drawer and doors add visual interest.\",\"primaryImage\":{\"alt\":\"Fremont Slatted 2-Door Cabinet, 31.5&quot;W, Ash\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sjOqF+9GL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t2NQ5rZQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t2NQ5rZQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CYglVAS9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CYglVAS9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ceg71na+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ceg71na+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p-zOZpIIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p-zOZpIIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13TIKK2rtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13TIKK2rtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Heig