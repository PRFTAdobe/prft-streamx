    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B8445BB\",\"sku\":\"B07B8445BB\",\"lang\":\"en\",\"slug\":\"rivet-dayton-mid-century-modern-metal-bar-stool-24-h-pack-of-2-beige-b07b8445bb\",\"name\":\"Rivet Dayton Mid-Century Modern Metal Bar Stool, 24&quot;H, Pack of 2, Beige\",\"description\":\"18.5&quot;W x 18.5&quot;D x 24&quot;H Hardwood seat with metal legs Wood and metal combination makes it great for a modern or industrial style room Easy to move to another room when you need more seating No assembly required Free returns for 30 days. 1-year warranty. Minimalist, sleek wood and hairpin-curve metal legs merge mid-century style with modern industrial materials. These stools are durable, low maintenance and ready to hosts many friends for a casual dinner at the bar or counter.\",\"primaryImage\":{\"alt\":\"Rivet Dayton Mid-Century Modern Metal Bar Stool, 24&quot;H, Pack of 2, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uOQryKJIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f1H+lEWWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f1H+lEWWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k3eu6h+4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k3eu6h+4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CFDnxqNvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CFDnxqNvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s65IXauDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s65IXauDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DWB0TFgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+DWB0TFgL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value