    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2R9Y4W\",\"sku\":\"B07J2R9Y4W\",\"lang\":\"en\",\"slug\":\"rivet-brooke-contemporary-mid-century-modern-tufted-leather-living-room-chair-35-w-cognac-b07j2r9y4w\",\"name\":\"Rivet Brooke Contemporary Mid-Century Modern Tufted Leather Living Room Chair, 35&quot;W, Cognac\",\"description\":\"Add mid-century charm to your home decor with this striking living-room chair. Its crisp lines and distinct shape combine for an attractive contemporary-style look, and its beautiful cognac-colored leather upholstery will blend well with your existing interior-design style. Overall: 35&quot;W x 35&quot;D x 31&quot;H; seat height: 19.29&quot;H; seat depth: 22.83&quot;D; seat back height: 31&quot;H; arm height: 31&quot;H; leg height: 7.87&quot;H Solid-wood frame with brass legs and genuine leather upholstery Elegant contemporary-style design also pairs well with vintage or mid-century-modern home decor Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brooke Contemporary Mid-Century Modern Tufted Leather Living Room Chair, 35&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61GNOdKkuWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51dVIHBAhcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51dVIHBAhcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JHva0fnKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JHva0fnKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JyFpEPi7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JyFpEPi7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\"},{\"alt\"