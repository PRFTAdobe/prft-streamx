    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4W31C3\",\"sku\":\"B07B4W31C3\",\"lang\":\"en\",\"slug\":\"rivet-jonathan-mid-century-modern-wood-full-bed-59-5-w-walnut-b07b4w31c3\",\"name\":\"Rivet Jonathan Mid-Century Modern Wood Full Bed, 59.5&quot;W, Walnut\",\"description\":\"59.5&quot;W x 88&quot;D x 52&quot;H; LegHeight: 10.75&quot; Multi-slat mattress support means no additional box spring required Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 1-year warranty. Bring mid-century flair to your bedroom retreat with this full-size platform bed. The smooth, clean lines of the slatted headboard are accented with tapered legs for a classic modern style. Optional under-bed storage drawers are available.\",\"primaryImage\":{\"alt\":\"Rivet Jonathan Mid-Century Modern Wood Full Bed, 59.5&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L4yoIhpXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f3H435nXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91f3H435nXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fQUsgjq7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fQUsgjq7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811FKUPd+LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811FKUPd+LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wWGRoFj4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wWGRoFj4L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"lab