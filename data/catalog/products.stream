      "content": {
        "bytes": "{\"id\":\"B075X4PRZ9\",\"sku\":\"B075X4PRZ9\",\"lang\":\"en\",\"slug\":\"marin-leather-studded-chair-33-w-walnut-b075x4prz9\",\"name\":\"Marin Leather Studded Chair, 33&quot;W, Walnut\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with rich leather upholstery Removable and reversible back and seat cushion adds lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Rich leather and clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Leather Studded Chair, 33&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Wxu2CN5eL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yUqpEADJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yUqpEADJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNkeaG8AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XNkeaG8AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SpYav6ebL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SpYav6ebL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{