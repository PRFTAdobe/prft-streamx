    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQXR2Y\",\"sku\":\"B075YQXR2Y\",\"lang\":\"en\",\"slug\":\"rivet-julie-mid-century-modern-dining-room-accent-chair-with-arms-32-h-aqua-blue-b075yqxr2y\",\"name\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Aqua Blue\",\"description\":\"This classic mid-century modern accent chair features a simple, clean design with narrow armrests and tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 24&quot;W x 24&quot;D x 32&quot;H; seat height: 19&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Fabric is 100% polyester; hardwood legs with espresso finish Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Aqua Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pwY-iwvPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AD7StCJML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AD7StCJML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910M91TK73L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910M91TK73L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814m2ixP3aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814m2ixP3aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pcnHuXs2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pcnHuXs2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1YvYtHQALS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-ima