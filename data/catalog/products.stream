    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853NLYDD\",\"sku\":\"B0853NLYDD\",\"lang\":\"en\",\"slug\":\"rivet-olander-mid-century-modern-ottoman-with-self-centering-swivel-base-20-5-w-stucco-b0853nlydd\",\"name\":\"Rivet Olander Mid-Century Modern Ottoman with Self-Centering Swivel Base, 20.5&quot;W, Stucco\",\"description\":\"This ergonomically sloped ottoman will help you create a seating area that is relaxing and stylish. The curved sides provide a comfortable place for you to rest your feet and legs and also add a contemporary feel to the piece. A self-centering swivel base of brushed metal allows you to easily rotate while seated. 20.5&quot;W x 15.4&quot;D x 15.4&quot;H; seat height: 15.4&quot;H; seat depth: 15.4&quot;D Brushed-brass base with polyester and acrylic upholstery Ottoman features a self-centering swivel for convenience. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Olander Mid-Century Modern Ottoman with Self-Centering Swivel Base, 20.5&quot;W, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CRYzGPMPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zkXftfXfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zkXftfXfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jn7r3RlbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jn7r3RlbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sxb9ZOAzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sxb9ZOAzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ivIcN9LfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ivIcN9LfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/