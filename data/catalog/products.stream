    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ML8SY\",\"sku\":\"B07B4ML8SY\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-82-w-navy-b07b4ml8sy\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Navy\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 82&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xvjWkvbmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914+c3mmu7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914+c3mmu7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZRbBQJgNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZRbBQJgNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812etuCzD5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812etuCzD5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A