    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSBJ5DV\",\"sku\":\"B07HSBJ5DV\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-upholstered-counter-height-stool-with-gold-accents-37-h-juniper-blue-b07hsbj5dv\",\"name\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Juniper Blue\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous juniper blue, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 37&quot;H; Seat Height: 26&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Juniper Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EVDagJXBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yYzaVOkhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yYzaVOkhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y45NB0DyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y45NB0DyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jPZ5MbRcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jPZ5MbRcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cj5M+JSvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cj5M+JSvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j+DzHNnjL.jpg\",\"url\":\"https://storage.googleapis.c