        "bytes": "{\"id\":\"B075X33RXZ\",\"sku\":\"B075X33RXZ\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-ink-blue-b075x33rxz\",\"name\":\"Leila Ottoman, 34&quot; W, Ink Blue\",\"description\":\"This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and plush upholstery add to its high style. This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing gives cushion resilience. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot; W, Ink Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81g0n9x4keL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ahnNaSuxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ahnNaSuxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LewI-OvZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LewI-OvZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I1V8AJfRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I1V8AJfRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Wei