    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0723H8HN3\",\"sku\":\"B0723H8HN3\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-ottoman-with-hardwood-frame-46-5-w-slate-b0723h8hn3\",\"name\":\"Lauren Down Filled Oversized Ottoman with Hardwood Frame, 46.5&quot;W, Slate\",\"description\":\"Dimensions: 46.5&quot;W x 46.5&quot;D x 18.5&quot;H This ottoman combines a simple silhouette with sink-in comfort. Fabric that is stain and moisture-resistant makes this ottoman work as a footrest, an extra seat for company, or a place to park a tray of snacks. Sturdy hardwood frame; polyester/nylon stain-resistant fabric Timeless casual Exceptional comfort with high performance fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down Filled Oversized Ottoman with Hardwood Frame, 46.5&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GQ8DytzEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qhuHZ9UZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qhuHZ9UZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10H8dRDZBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10H8dRDZBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12TwXnx2aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12TwXnx2aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LQ5Stc7IS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LQ5Stc7IS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81riGB6YAqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81riGB6YAqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.503937\",\"label