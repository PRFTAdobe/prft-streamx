    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JWDCR\",\"sku\":\"B07P6JWDCR\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-loveseat-sofa-couch-78-7-w-slate-b07p6jwdcr\",\"name\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Slate\",\"description\":\"This attractive loveseat has the low button-tufted back, scroll arms, and short legs that are the hallmark of the classic chesterfield style. Whether as a statement piece or part of a living-room suite, this loveseat will be a welcome addition to any decor. Dimensions: 79&quot;W x 39&quot;D x 30&quot;H Solid hardwood frame; upholstery: 98% polyester, 2% nylon Removable and reversible seat cushions A classic style updated in stain-resistant fabric makes this perfect for the modern home. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Loveseat Sofa Couch, 78.7&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xdDRvr0bL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tpH4i4XzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tpH4i4XzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71llB9ktEhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71llB9ktEhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nSCunRBWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nSCunRBWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gLvEeIj9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gLvEeIj9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fSrX-bY3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fSrX