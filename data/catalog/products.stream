      "content": {
        "bytes": "{\"id\":\"B0728NW8C4\",\"sku\":\"B0728NW8C4\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-oversized-arm-chair-59-w-grey-tweed-b0728nw8c4\",\"name\":\"Hoffman Down-Filled Performance Fabric Oversized Arm Chair, 59&quot;W, Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this chair has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 59&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Oversized Arm Chair, 59&quot;W, Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oAzyyESmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1neX8VTfES.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1neX8VTfES.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B9vbOy72S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B9vbOy72S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oOJulU8uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oOJulU8uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xL0RptGYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xL0RptGYS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ThVFSrTHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ThVFSrTHS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value