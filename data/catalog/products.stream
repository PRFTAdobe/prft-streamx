    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2RH8Z\",\"sku\":\"B084W2RH8Z\",\"lang\":\"en\",\"slug\":\"linden-classic-upholstered-dining-chair-18-9-w-set-of-2-cadet-blue-b084w2rh8z\",\"name\":\"Linden Classic Upholstered Dining Chair, 18.9&quot;W, Set of 2, Cadet Blue\",\"description\":\"This set of two classically styled armless dining chairs are upholstered in a cadet-blue fabric that makes them equally perfect for a classic dining room or eat-in kitchen. Their luxury and practicality means they evoke both romantic dinners for two and fabulous banquets for the whole family. 18.9&quot;W x 24.4&quot;D x 34.3&quot;H; seat height: 19.3&quot;H; seat depth: 18.5&quot;D; seat back height: 19.7&quot;H; leg height: 14.6&quot;H Solid wood frame High back provides extra support and added flair. Simple dining chair boasts beautiful fabric. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Linden Classic Upholstered Dining Chair, 18.9&quot;W, Set of 2, Cadet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jzbQ+ehsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xMph-8JuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xMph-8JuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ngx1uPC+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ngx1uPC+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eO5uc6EEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eO5uc6EEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eXB6TfSLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eXB6TfSLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X3XL7kuhL.j