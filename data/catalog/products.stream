    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07M6PHS9P\",\"sku\":\"B07M6PHS9P\",\"lang\":\"en\",\"slug\":\"classic-tufted-counter-height-barstool-set-of-2-37-5-h-beige-b07m6phs9p\",\"name\":\"Classic Tufted Counter-Height Barstool, Set of 2, 37.5&quot;H, Beige,\",\"description\":\"Complete your kitchen or bar area with these vintage-inspired tufted counter stools. The sturdy solid-wood frame features an elastic suspension system that’s designed to keep the seat firm, and the elegant design nicely complements vintage, country and farmhouse-style home decor. Overall: 21.25&quot;W x 20.5&quot;D x 37.5&quot;H; seat height: 24.25&quot;H; seat depth: 18&quot;D; seat back height: 13.5&quot;H Durable fabric on wood frame; solid-wood legs with natural finish Set of 2 vintage-inspired counter-height bar stools with wood frame and beige upholstery Foam padding and elastic suspension system keep the back and seat firm and springy. Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Tufted Counter-Height Barstool, Set of 2, 37.5&quot;H, Beige,\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EA7Z9L-HL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tuFJHvXRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tuFJHvXRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O969JEipL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O969JEipL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71420GnfTEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71420GnfTEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fDsIvo8HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fDsIvo8HL.jpg\"},{\"alt\":\"https://storage.googleapis.c