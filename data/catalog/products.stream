  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ8N5DD\",\"sku\":\"B07HZ8N5DD\",\"lang\":\"en\",\"slug\":\"kristin-chair-and-a-half-upholstered-sleeper-sofa-55-5-w-navy-b07hz8n5dd\",\"name\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Navy\",\"description\":\"Add style and comfort to your home with this classic chair-and-a-half sleeper. With a time-tested traditional design, this chair is an ideal accent for many home-decor styles, and its beautiful indigo hue brightens the room with color. Its cushions are reversible to extend this chair’s life. Overall: 55.5&quot;W x 37&quot;D x 37.5&quot;H; Seat Height: 21.5&quot;H; Seat Depth 24&quot;D; Seat Back Height: 30&quot;H; Arm Height: 32&quot;H; Leg Height: 2.5&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Traditional design is both fashionable and practical. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916CHGwHg1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vrk4suorL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vrk4suorL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DWwdzTMBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DWwdzTMBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XAF-OaRuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XAF-OaRuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LrfAloYfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LrfAloYfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916eD6sMXnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916eD6sMXnL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"66.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"139.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Oversized\",\"label\":\"Oversized\"},{\"value\":\"Hugger\",\"label\":\"Hugger\"},{\"value\":\"800lb\",\"label\":\"800lb\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Tables\",\"label\":\"Tables\"},{\"value\":\"Recline\",\"label\":\"Recline\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Best\",\"label\":\"Best\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Armchair\",\"label\":\"Armchair\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Zero\",\"label\":\"Zero\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Motor\",\"label\":\"Motor\"},{\"value\":\"Armless\",\"label\":\"Armless\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Deal\",\"label\":\"Deal\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Perfect\",\"label\":\"Perfect\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Half\",\"label\":\"Half\"},{\"value\":\"Heat\",\"label\":\"Heat\"},{\"value\":\"Yard