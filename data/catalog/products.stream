    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ39LY\",\"sku\":\"B07QCQ39LY\",\"lang\":\"en\",\"slug\":\"canton-twin-button-tufted-headboard-42-w-pearl-b07qcq39ly\",\"name\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Pearl\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft pearl-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 42&quot;W x 3&quot;D x 62&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XVHu34ANL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kJgxr0llL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kJgxr0llL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nsCdbSIjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nsCdbSIjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EBoyC8IKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EBoyC8IKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":