    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33RZK\",\"sku\":\"B075X33RZK\",\"lang\":\"en\",\"slug\":\"larkin-living-room-accent-swivel-chair-30-w-smokey-teal-b075x33rzk\",\"name\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Smokey Teal\",\"description\":\"This simple slipcover swivel accent chair brings touches of modern and traditional to your home. Covered in high-performance twill upholstery that is comfortable and durable, its slender design makes it practical even in small spaces. This item is made to order just for you 30&quot;W x 35&quot;D x 33&quot;H. Seat height is 20&quot;. Sturdy metal base, solid wood frame, durable performance fabric Swivel mechanism allows you to turn in any direction. No assembly required. Vacuum or lightly brush. Spot clean with a damp cloth if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Smokey Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aTFQrEy9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12YJ4uuv5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12YJ4uuv5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G7KLTFpwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G7KLTFpwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17PiPFEdfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1v6oFy4DaS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1v6oFy4DaS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dAIQjIzfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dAIQjIzfS.jpg\"}],\"attributes\":[{\"name\":\"hei