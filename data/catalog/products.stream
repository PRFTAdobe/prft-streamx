    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W368LX\",\"sku\":\"B084W368LX\",\"lang\":\"en\",\"slug\":\"flanigan-curved-back-upholstered-dining-chair-24-4-w-midnight-b084w368lx\",\"name\":\"Flanigan Curved-Back Upholstered Dining Chair, 24.4&quot;W, Midnight\",\"description\":\"With lovely curved wingback styling, this midnight-colored upholstered dining chair will enhance your dining area with its classic charm. The sturdy wood frame and cushioned seat give this chair timeless allure. Both moisture repellent and stain resistant, it is ready for anything. 24.4&quot;W x 24.8&quot;D x 37.8&quot;H; seat height: 19.3&quot;H; seat depth: 17.3&quot;D; seat back height: 22.8&quot;H; leg height: 15&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric Armless, cushioned, high-back style exudes easy luxury. Wingback dining chair with polished brass nailhead trim No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Flanigan Curved-Back Upholstered Dining Chair, 24.4&quot;W, Midnight\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dnRaZ50vL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812dVNT+oZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812dVNT+oZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81285vtP+dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81285vtP+dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IcgpLsdpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IcgpLsdpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e4fWy+ebL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81e4fWy+ebL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima