    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8KXDK\",\"sku\":\"B075Z8KXDK\",\"lang\":\"en\",\"slug\":\"avondale-wood-and-metal-office-computer-desk-60-w-walnut-b075z8kxdk\",\"name\":\"Avondale Wood and Metal Office Computer Desk, 60&quot;W, Walnut\",\"description\":\"60&quot;W x 24&quot;D x 30.25&quot;H Durable metal frame and solid pine wood with distressed walnut finish Multipurpose desk with fixed, open shelves on each side for extra display or storage space The classic writing desk meets industrial influence in this simply styled piece. It features two-toned wood mixed with dark brown metal and two fixed shelves on each side. This sleek, airy piece can be used as a desk or craft table. Easy assembly in 15-30 minutes. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Avondale Wood and Metal Office Computer Desk, 60&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ji0qNlfBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MaG1PqPvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MaG1PqPvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXupdHcLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXupdHcLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VQmc5JX+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VQmc5JX+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dUgYl3YxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dUgYl3YxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"val