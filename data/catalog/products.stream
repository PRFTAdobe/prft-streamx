  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857K54FM\",\"sku\":\"B0857K54FM\",\"lang\":\"en\",\"slug\":\"wishbone-and-rattan-dining-chair-with-arms-21-9-w-brown-b0857k54fm\",\"name\":\"Wishbone and Rattan Dining Chair with Arms, 21.9&quot;W, Brown\",\"description\":\"The graceful curves of this ash chair mask its everyday durability. It's light, portable, and perfect for the kitchen, dining room, living room, or office. The soft, comfortable woven paper-rope seat is 100% natural. 21.9&quot;W x 22.8&quot;D x 31.5&quot;H Ash frame with a woven seat The sturdy ash frame will stand the test of time, while the soft woven paper-rope seat is easy to sink into. Simple but fashionable, this brown wishbone-style curved design adds a breezy sophistication to any gathering area. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Wishbone and Rattan Dining Chair with Arms, 21.9&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61vHozqxFFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nKtFVDP6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nKtFVDP6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616PSWx-4qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616PSWx-4qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61liEALkSrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61liEALkSrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yzFcZQZUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yzFcZQZUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZFjxBnEsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZFjxBnEsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X-a2Ci3DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X-a2Ci3DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61N2Ptg0g6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61N2Ptg0g6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61I2y27OToL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61I2y27OToL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"21.9\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"13.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"And\",\"label\":\"And\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Armen\",\"label\":\"Armen\"},{\"value\":\"Faux\",\"label\":\"Faux\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":357,\"discountedValue\":321.3}}"
