    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082STTKWF\",\"sku\":\"B082STTKWF\",\"lang\":\"en\",\"slug\":\"sadie-living-room-wingback-accent-chair-33-w-charcoal-plaid-b082sttkwf\",\"name\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Charcoal Plaid\",\"description\":\"The classic wingback chair gets a modern refresh with neutral upholstery in Charcoal Plaid. Made to order in the United States of partially imported materials, it features a sturdy wood frame, tall tapered legs, and durable, tightly woven fabric. Sturdy wood frame and legs; hard-wearing fabric with reversible seat cushion for durability; no assembly required Product Dimensions: 33&quot;W x 38&quot;D x 41&quot;H Care Instructions: Avoid moisture; wipe down with a clean, soft cloth Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Sadie Living Room Wingback Accent Chair, 33&quot;W, Charcoal Plaid\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17TFwM8BqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914EIoB4mFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914EIoB4mFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CHuucCfXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CHuucCfXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17gHf6T50L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17gHf6T50L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ZRCV4dsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-ZRCV4dsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uAlnzAcBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uAlnzAcBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"va