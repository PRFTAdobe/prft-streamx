    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3R5\",\"sku\":\"B075X4F3R5\",\"lang\":\"en\",\"slug\":\"rivet-jamie-leather-mid-century-modern-low-arm-accent-chair-31-w-cognac-b075x4f3r5\",\"name\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Cognac\",\"description\":\"A great addition to any room, this versatile accent chair is sure to be a conversation piece. It features eye catching Mid-century inspired design with distinctive slanted arms and sturdy hardwood legs. 31&quot;W x 32.3&quot;D x 35”H Solid hardwood frame and soft top-grain leather. Highly fashionable design in a compact size for small spaces. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ADiOVT1AL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sPnPx7uYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sPnPx7uYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N5uyqbtDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91N5uyqbtDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gEqY8Z-sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gEqY8Z-sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Yi8amqDGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Yi8amqDGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BznbhOIqL.jpg\",\"url\":\"https://storage.googleapis