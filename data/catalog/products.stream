    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MDB89\",\"sku\":\"B07B4MDB89\",\"lang\":\"en\",\"slug\":\"andover-modern-right-chaise-sofa-sectional-126-w-light-blue-b07b4mdb89\",\"name\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Light Blue\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, these pieces are ready to withstand years of fun and cuddles with friends, family and pets. 126&quot;W x 61&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wCDFj4BML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VzPXGnqqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VzPXGnqqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13v44t+-jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13v44t+-jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Afr1A4bxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Afr1A4bxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1C62nL7myS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1C62nL7myS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IDDOJ0AnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IDDOJ0AnL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"172.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Light blue\",\"label\":\"Light blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional\",\"label\":\"Sectional\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Right chaise sofa\",\"label\":\"Right chaise sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]},{\"id\":\"Featured\",\"slug\":\"featured\",\"name\":\"Featured\",\"value\":\"Featured\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"