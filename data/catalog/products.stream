    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FL8\",\"sku\":\"B075X43FL8\",\"lang\":\"en\",\"slug\":\"marin-leather-nailhead-studded-living-room-accent-chair-33-w-saddle-brown-b075x43fl8\",\"name\":\"Marin Leather Nailhead Studded Living Room Accent Chair, 33&quot;W, Saddle Brown\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with rich leather upholstery Removable and reversible back and seat cushion adds lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Rich leather and clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Leather Nailhead Studded Living Room Accent Chair, 33&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vkgW9+8QL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913aouhF7aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913aouhF7aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cyQ7aSuHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cyQ7aSuHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oOMEj0wZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oOMEj0wZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14OFt3qrEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14OFt3qrEL.jpg\"},{\"alt\":\"https://sto