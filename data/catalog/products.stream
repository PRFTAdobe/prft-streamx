  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMSLWY\",\"sku\":\"B07BWMSLWY\",\"lang\":\"en\",\"slug\":\"andover-leather-left-facing-sofa-chaise-sectional-126-w-charcoal-b07bwmslwy\",\"name\":\"Andover Leather Left-Facing Sofa-Chaise Sectional, 126&quot;W, Charcoal\",\"description\":\"Complete your living space with this stylish sectional. With its charcoal-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 126&quot;W x 61&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Left-Facing Sofa-Chaise Sectional, 126&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Zi6v5b3gL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XniPhin3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XniPhin3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Kh1JoMMyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Kh1JoMMyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nHw4HH7ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nHw4HH7ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uwb7H12RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uwb7H12RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91