    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJ22YVJ\",\"sku\":\"B07QJ22YVJ\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-romero-cream-b07qj22yvj\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Romero Cream\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft cream-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Romero Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T3wgeL0jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GR6D0LmbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GR6D0LmbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MJi8jBZfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MJi8jBZfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jrVawJtEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jrVawJtEL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]