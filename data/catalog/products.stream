        "bytes": "{\"id\":\"B073G8VWJX\",\"sku\":\"B073G8VWJX\",\"lang\":\"en\",\"slug\":\"edgewood-modern-storage-ottoman-36-w-merlot-b073g8vwjx\",\"name\":\"Edgewood Modern Storage Ottoman, 36&quot;W, Merlot\",\"description\":\"This classic, tailored storage bench is the perfect place to hide those extra pillows in your master suite or stow toys in the living room. Simple modern design in a magnificent merlot red adds just the right pop of color. 36&quot;W x 18&quot;D x 18&quot;H Solid pine frame and linen/viscose blend fabric Modern and functional Provides stylish storage No assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Edgewood Modern Storage Ottoman, 36&quot;W, Merlot\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k+4tDhbwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZR-xr3vCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZR-xr3vCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rPfxml8+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rPfxml8+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YSG1tzxfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YSG1tzxfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xtlZIPCtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xtlZIPCtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1midIrgwYS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1midIrgwYS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":