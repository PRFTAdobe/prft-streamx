        "bytes": "{\"id\":\"B07HSBDCX8\",\"sku\":\"B07HSBDCX8\",\"lang\":\"en\",\"slug\":\"rylee-modern-farmhouse-acacia-wood-dining-bench-71-w-gray-wash-acacia-b07hsbdcx8\",\"name\":\"Rylee Modern Farmhouse Acacia Wood Dining Bench, 71&quot;W, Gray-Wash Acacia\",\"description\":\"Add a contemporary touch to your dining room, kitchen or entryway with this beautiful bench. Made from solid acacia with a subtle gray-washed finish, this bench perfectly complements most home-décor styles. Acacia solid wood with Acacia veneer Low height profile with sturdy wood legs for dining seating or an entryway. Avoid moisture. Wipes clean with soft, dry cloth. 18.5&quot;L x 70.87&quot;W x 9.84&quot;H Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Rylee Modern Farmhouse Acacia Wood Dining Bench, 71&quot;W, Gray-Wash Acacia\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mUIKRvqWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vTEvHJdcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vTEvHJdcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f2GRmFhpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f2GRmFhpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nvl3uH4qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nvl3uH4qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mOIaseBrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mOIaseBrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"n