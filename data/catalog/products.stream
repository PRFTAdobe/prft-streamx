        "bytes": "{\"id\":\"B07KXFDD2H\",\"sku\":\"B07KXFDD2H\",\"lang\":\"en\",\"slug\":\"high-back-executive-swivel-office-desk-chair-with-ribbed-puresoft-upholstery-white-lumbar-support-modern-style-b07kxfdd2h\",\"name\":\"High-Back Executive Swivel Office Desk Chair with Ribbed Puresoft Upholstery - White, Lumbar Support, Modern Style\",\"description\":\"High-back executive office chair with 360 degree swivel capability Ergonomic design offers reliable back support for daily use Polished chrome details and durable polyurethane faux leather ribbed upholstery Sturdy five-point base with rolling caster wheels for smooth mobility One-touch height adjustment allows you to easily modify the chair’s height, reducing neck and back strain Durable construction with 330 pound weight capacity\",\"primaryImage\":{\"alt\":\"High-Back Executive Swivel Office Desk Chair with Ribbed Puresoft Upholstery - White, Lumbar Support, Modern Style\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q0yiIvIfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/610c4YRXlLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/610c4YRXlLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ppMKysryL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ppMKysryL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rwzgoYQ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rwzgoYQ2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aa39AAiWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aa39AAiWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zSBmhQuBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zSBmhQuBL.jpg\"}],\"attributes\":[{\"n