    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D49G2\",\"sku\":\"B07B4D49G2\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-accent-chair-38-w-charcoal-b07b4d49g2\",\"name\":\"Brandeberry Farmhouse Charles of London Accent Chair, 38&quot;W, Charcoal\",\"description\":\"The classic English roll arm gives this cozy chair a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 38&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Stain-resistant polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Accent Chair, 38&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14KXTzIV9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QHmfd6smL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QHmfd6smL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DP8LvbUhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DP8LvbUhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18nPK5T-gS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18nPK5T-gS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cz1r8DJeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cz1r8DJeL.jpg\"},{\"alt\":\"https://s