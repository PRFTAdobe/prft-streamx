    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07SRCRVCX\",\"sku\":\"B07SRCRVCX\",\"lang\":\"en\",\"slug\":\"solimo-antares-engineered-wood-bedside-table-sienna-cherry-finish-b07srcrvcx\",\"name\":\"Solimo Antares Engineered Wood Bedside Table (Sienna Cherry Finish)\",\"description\":\"Product Dimensions: Length (45 cm), Width (38 cm), Height (46 cm) Sturdy structure made from premium quality European standard engineered wood that is resistant against stains and humidity Underwent more than 20 tests to ensure safety and quality Easy-to-clean, compact design with elegant finish; Free from burrs and sharp edges to eliminate accidental scrapes and cuts Spacious tabletop to place bedtime essentials like water, alarm, keys, medic Made without carcinogens like lead, PCP, and formaldehyde to ensure safe use Comes with 3-year warranty against manufacturing defects\",\"primaryImage\":{\"alt\":\"Solimo Antares Engineered Wood Bedside Table (Sienna Cherry Finish)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VnbQ4HbLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61I2G403DeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61I2G403DeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61cf-aGndoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61cf-aGndoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fVo3b-k0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61fVo3b-k0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bTt08buaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bTt08buaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.1102\",\"label\":\"millimeters\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"14.9606\",\