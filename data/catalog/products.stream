    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075ZBW1RR\",\"sku\":\"B075ZBW1RR\",\"lang\":\"en\",\"slug\":\"larson-industrial-wood-and-metal-2-shelf-bookcase-39-h-walnut-b075zbw1rr\",\"name\":\"Larson Industrial Wood and Metal 2-Shelf Bookcase, 39&quot;H, Walnut\",\"description\":\"34&quot;L x 14&quot;W x 39.25&quot;H Solid pine wood shelves and top; metal legs Industrial and rustic touches allow this bookshelf to blend with many styles. Two fixed distressed wood shelves with a walnut finish Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. This bookcase has a natural distressed finish, while the metal legs and trim have a darker brown matte finish. With two fixed shelves to provide a display area to for books and photos, this bookshelf will make a simple statement in any room.\",\"primaryImage\":{\"alt\":\"Larson Industrial Wood and Metal 2-Shelf Bookcase, 39&quot;H, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X30ETu4eL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fkld974FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fkld974FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TuYQtY1TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TuYQtY1TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+aeBpwMNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+aeBpwMNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1outAk9kxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1outAk9kxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"