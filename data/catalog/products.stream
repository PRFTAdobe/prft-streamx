    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P7NWJ39\",\"sku\":\"B07P7NWJ39\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sofa-with-tapered-wood-legs-74-w-dark-grey-b07p7nwj39\",\"name\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 74&quot;W, Dark Grey\",\"description\":\"This sofa features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive gray fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 74&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs Removable and reversible back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 74&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811b1XUNVGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EHPGg6owL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EHPGg6owL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SgKrfPBVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SgKrfPBVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WWtqoT2fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WWtqoT2fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LkGG0GpdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LkGG0GpdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J