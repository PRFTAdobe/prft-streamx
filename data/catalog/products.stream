    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ57QKK\",\"sku\":\"B07HZ57QKK\",\"lang\":\"en\",\"slug\":\"kristin-loveseat-76-w-indigo-b07hz57qkk\",\"name\":\"Kristin Loveseat, 76&quot;W, Indigo\",\"description\":\"Add style and comfort to your home with this classic loveseat. With a time-tested traditional design, this loveseat is an ideal accent for many home-decor styles, and its beautiful indigo hue brightens the room with color. Its cushions are reversible to extend this loveseat’s life. Overall: 76&quot;W x 37&quot;D x 37.5&quot;H; Seat Height: 21.5&quot;H; Seat Depth 24&quot;D; Seat Back Height: 30&quot;H; Arm Height: 32&quot;H; Leg Height: 2.5&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Traditional design is both fashionable and practical. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Kristin Loveseat, 76&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yaf+RLorL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZXYiX70L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZXYiX70L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xLfBNcrwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xLfBNcrwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c9dUj6WxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c9dUj6WxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lcibI7WPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lcibI7WPL.jpg\"}],\"attributes\":[{\"name\":\"h