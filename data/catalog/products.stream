    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2JGX7F\",\"sku\":\"B07J2JGX7F\",\"lang\":\"en\",\"slug\":\"calhoun-sofa-couch-91-w-tweed-b07j2jgx7f\",\"name\":\"Calhoun Sofa Couch, 91&quot;W, Tweed\",\"description\":\"Overall: 91&quot;W x 41&quot;D x 36&quot;H; seat height: 20.5&quot;H; seat depth: 27&quot;D; seat back height: 31&quot;H; arm height: 24&quot;H; leg height: 1.75&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric A classic design updated to suit contemporary tastes, perfect for transitional-style home decor Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Calhoun Sofa Couch, 91&quot;W, Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JMfranKuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uSO5QYioS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uSO5QYioS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91faA0HCS-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91faA0HCS-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cFlly+BJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cFlly+BJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918R+tKCH9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918R+tKCH9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9109UlhxLdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9109UlhxLdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZxxPP