        "bytes": "{\"id\":\"B072M1WJTW\",\"sku\":\"B072M1WJTW\",\"lang\":\"en\",\"slug\":\"rivet-madison-modern-round-lift-top-storage-tray-ottoman-pouf-19-7-w-denim-b072m1wjtw\",\"name\":\"Rivet Madison Modern Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Denim\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila -- it's an extra tray for snacks! An ottoman couldn't be more clever and multi-tasking than this. 19.7&quot;W x 19.7&quot;D x 16.5&quot;H Wood frame Modern, round design Perfect for any room where a storage space or footstool is needed. Simple assembly; just attach four legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Madison Modern Round Lift-Top Storage Tray Ottoman Pouf, 19.7&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ks5HUGmRS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pE25TBLWS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pE25TBLWS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71K1IT7-o6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71K1IT7-o6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q2G3YswQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q2G3YswQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mU0pPSu0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mU0pPSu0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CZYimwIeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CZYimwIeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.5\",\"label\":\"inches\"}]},{\"name\":\"width\",