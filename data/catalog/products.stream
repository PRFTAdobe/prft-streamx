    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MFK71\",\"sku\":\"B07B4MFK71\",\"lang\":\"en\",\"slug\":\"andover-ottoman-32-w-saddle-colored-leather-b07b4mfk71\",\"name\":\"Andover Ottoman, 32&quot;W, Saddle-Colored Leather\",\"description\":\"Overall: 32&quot;W x 25&quot;D x 21&quot;H; seat height: 21&quot;H; seat depth: 33&quot;D; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you. Complete your living space with this stylish ottoman. With its saddle-colored upholstery, this ottoman is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this ottoman’s life.\",\"primaryImage\":{\"alt\":\"Andover Ottoman, 32&quot;W, Saddle-Colored Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61wwuBBZj5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jqaz0iM6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jqaz0iM6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71h31lsG5UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71h31lsG5UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IAqWOTWCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IAqWOTWCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lub6A6qHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Tl0LT84ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Tl0LT84ZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"valu