    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD6R9M\",\"sku\":\"B082QD6R9M\",\"lang\":\"en\",\"slug\":\"rivet-maple-channel-tufted-upholstered-storage-ottoman-with-a-soft-close-hinge-45-3-w-dark-grey-b082qd6r9m\",\"name\":\"Rivet Maple Channel Tufted Upholstered Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Dark Grey\",\"description\":\"Storage is made simple and convenient with this stylish channel-top ottoman. A solid wood frame and tapered legs provide a sturdy base, and a high-quality galvanized, soft-close hinge makes it easy to shut small items away but keep within easy reach. Dark-gray upholstery matches any decor. 45.3&quot;W x 18.9&quot;D x 18.5&quot;H; seat height: 18.5&quot;H; seat depth: 18.9&quot;D; leg height: 6.3&quot;H Solid wood frame and legs; polyester, linen, and rayon upholstery Store small items and help reduce clutter in your home with this ottoman. Made with a soft-close hinge for easy use. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Maple Channel Tufted Upholstered Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8103wdgk+8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VURIer0JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VURIer0JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812QDnPKAjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812QDnPKAjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qtTgZbSLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qtTgZbSLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t49o1W73L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/