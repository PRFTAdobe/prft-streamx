    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GSPNR\",\"sku\":\"B07B4GSPNR\",\"lang\":\"en\",\"slug\":\"andover-modern-right-chaise-sofa-sectional-126-w-dark-tan-b07b4gspnr\",\"name\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Dark Tan\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, these pieces are ready to withstand years of fun and cuddles with friends, family and pets. 126&quot;W x 61&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Dark Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812ucQy0v9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13rvZ8jdLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13rvZ8jdLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQ1PbwPaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQ1PbwPaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810IIaYX7QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810IIaYX7QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GzbXEMWPL.jpg\",\"url\":\"https://