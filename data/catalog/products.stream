e\",\"label\":\"Farmhouse\"},{\"value\":\"6\",\"label\":\"6\"},{\"value\":\"Sommerford\",\"label\":\"Sommerford\"},{\"value\":\"Signature\",\"label\":\"Signature\"},{\"value\":\"By\",\"label\":\"By\"},{\"value\":\"Comodas\",\"label\":\"Comodas\"},{\"value\":\"Ashley\",\"label\":\"Ashley\"},{\"value\":\"Louis\",\"label\":\"Louis\"}]}],\"categories\":[{\"id\":\"Dressers\",\"slug\":\"dressers\",\"name\":\"Dressers\",\"value\":\"Dressers\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":462,\"discountedValue\":415.8}}"
