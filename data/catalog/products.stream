    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2X4ML\",\"sku\":\"B075X2X4ML\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-loveseat-58-w-pearl-b075x2x4ml\",\"name\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Pearl\",\"description\":\"This item is made to order just for you Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. 58&quot;W x 34&quot;D x 34&quot;H No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91juJ7tnd-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1djgEwlsNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1djgEwlsNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K6gOpAuPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91K6gOpAuPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911HZHLIlyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911HZHLIlyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JWIH46XWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JWIH46XWL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"58.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Pearl\",\"label\":\"Pearl\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Ivory\",\"label\":\"Ivory\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":317,\"discountedValue\":285.3}}"
