    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QDTYGK\",\"sku\":\"B075QDTYGK\",\"lang\":\"en\",\"slug\":\"chanton-tufted-upholstered-queen-sleigh-bed-with-headboard-95-5-l-grey-b075qdtygk\",\"name\":\"Chanton Tufted Upholstered Queen Sleigh Bed with Headboard, 95.5&quot;L, Grey\",\"description\":\"This traditional sleigh bed has a low-profile headboard and footboard that features tufted detailing and arched rolls at the top for a truly romantic flair. Soft linen fabric adds a feel of luxury and a touch of glamour. 95.5&quot;L x 65.6&quot;W x 52.2&quot;H Fabric of 65% rayon/35% linen covers a hardwood frame A romantic transitional style that will blend with classic and modern décor Includes upholstered side rails. Requires mattress and boxspring (sold separately). Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Chanton Tufted Upholstered Queen Sleigh Bed with Headboard, 95.5&quot;L, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nuvZE-NML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ny-I8JJGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ny-I8JJGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e45D5-ctL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1e45D5-ctL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QRSHRvAAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QRSHRvAAS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xApGtL-OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xApGtL-OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u7JQXWs+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u7JQXWs+L