    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YN3HPQ\",\"sku\":\"B075YN3HPQ\",\"lang\":\"en\",\"slug\":\"rivet-brianna-mid-century-modern-kitchen-dining-room-set-of-2-removable-cushion-chairs-34-2-inch-height-grey-b075yn3hpq\",\"name\":\"Rivet Brianna Mid-Century Modern Kitchen Dining Room Set of 2 Removable Cushion Chairs, 34.2 Inch Height, Grey\",\"description\":\"These Mid-century chairs feature removable seat cushions for ease of cleaning and durability. They're also stackable and easily moved around to multi-task at your dining room table, as extra seating in the living room, or at a desk. 19.7&quot;L, 23.5&quot;W, 34.2&quot;H. Seat height is 19.9&quot;. Polyester fabric on wood frame; metal legs with black finish Can be stacked and easily moved around to accommodate small spaces Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brianna Mid-Century Modern Kitchen Dining Room Set of 2 Removable Cushion Chairs, 34.2 Inch Height, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912GrSYJoNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NTWAku13L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NTWAku13L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1d4qVB9BsS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1d4qVB9BsS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ohlVkibL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ohlVkibL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Up7GjeTbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Up7GjeTbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8163a+S02dL.jpg\",\"url\":\"https://storage.goog