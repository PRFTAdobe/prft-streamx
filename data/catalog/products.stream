    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNRFGS\",\"sku\":\"B07QDNRFGS\",\"lang\":\"en\",\"slug\":\"barstool-with-brass-nailhead-trim-43-h-gray-b07qdnrfgs\",\"name\":\"Barstool with Brass Nailhead Trim, 43&quot;H, Gray\",\"description\":\"Brushed-brass nailheads add elegance to this transitional barstool. The solid hardwood frame and moisture-repellent fabric with stain resistance are durable and help this stool resist the daily wear and tear that comes with life. The style looks great with most decor, allowing use in most homes. 21&quot;W x 22&quot;D x 43&quot;H; seat height: 30&quot;H; seat depth: 17&quot;D 98% polyester, 2% nylon, solid wood frame Moisture-repellent and stain-resistant fabric with a solid hardwood frame helps keep this barstool looking like new. Brushed nails add elegance to this transitional design, making it perfect for any home or business. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Barstool with Brass Nailhead Trim, 43&quot;H, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pHMi4qOaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+lG4S6MVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+lG4S6MVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgyp+SspL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgyp+SspL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8BbqxTuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8BbqxTuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NvSrgT5UL.jpg\