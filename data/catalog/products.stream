  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWNM2Q\",\"sku\":\"B07QGWNM2Q\",\"lang\":\"en\",\"slug\":\"glenwilde-full-headboard-69-w-pewter-b07qgwnm2q\",\"name\":\"Glenwilde Full Headboard, 69&quot;W, Pewter\",\"description\":\"The strong, smooth lines of this pewter-colored full-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 69&quot;W x 11&quot;D x 52&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Full Headboard, 69&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Wty7A5WUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gGx7NygVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gGx7NygVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zp+o6waYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zp+o6waYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kJ3E25gYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kJ3E25gYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"lab