        "bytes": "{\"id\":\"B07QGWM3G2\",\"sku\":\"B07QGWM3G2\",\"lang\":\"en\",\"slug\":\"aikins-modern-queen-bed-headboard-68-w-glazed-mocha-b07qgwm3g2\",\"name\":\"Aikins Modern Queen Bed Headboard, 68&quot;W, Glazed Mocha\",\"description\":\"This queen-size headboard in a charming neutral shade of glazed mocha gives your bed a sense of serene grandeur. 68&quot;W x 5&quot;D x 50&quot;H Glazed mocha finish, oak veneers, select solids, champagne hardware The casual contemporary style of this collection makes it the perfect addition or update to your bedroom. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty. Wipe clean with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Aikins Modern Queen Bed Headboard, 68&quot;W, Glazed Mocha\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71N5QTOuhZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/511qB7iyGoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/511qB7iyGoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MfL++QxnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MfL++QxnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n4Aoc9quL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91n4Aoc9quL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DlBULY71L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DlBULY71L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"50.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"5.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"68.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"106.9\",\"labe