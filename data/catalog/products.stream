    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSNCM\",\"sku\":\"B07QFRSNCM\",\"lang\":\"en\",\"slug\":\"glenwilde-full-headboard-69-w-dune-b07qfrsncm\",\"name\":\"Glenwilde Full Headboard, 69&quot;W, Dune\",\"description\":\"The strong, smooth lines of this dune-colored full-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 69&quot;W x 11&quot;D x 52&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde Full Headboard, 69&quot;W, Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ej21x1JqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y6GCPqDkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y6GCPqDkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OIAQrO3bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OIAQrO3bL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jfu2HH4FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jfu2HH4FL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"label\":\"i