    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD9P8H\",\"sku\":\"B082QD9P8H\",\"lang\":\"en\",\"slug\":\"rivet-bayard-contemporary-upholstered-living-room-chair-with-curved-back-and-armrests-35-5-w-dark-grey-b082qd9p8h\",\"name\":\"Rivet Bayard Contemporary Upholstered Living Room Chair with Curved Back and Armrests, 35.5&quot;W, Dark Grey\",\"description\":\"This living room chair is a stylish way to add extra seating wherever you need it. Dark-gray upholstery and tapered legs form a piece that combines modern design elements with a classic silhouette. Sit in comfort, supported by foam-padded cushions, a solid wood frame, and gently sloping armrests. 35.5&quot;W x 34.2&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 21.2&quot;D; seat back height: 16.53&quot;H; arm height: 24.8&quot;H; leg height: 8.27&quot;H Solid wood frame; polyester, linen, and rayon upholstery This chair combines chic, contemporary design elements in a classic structure, making it the perfect fit wherever you need seating. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bayard Contemporary Upholstered Living Room Chair with Curved Back and Armrests, 35.5&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gTaP35aFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914I4+7ORUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914I4+7ORUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gJ23fSxZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gJ23fSxZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cH0SnLl8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cH0SnLl8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/