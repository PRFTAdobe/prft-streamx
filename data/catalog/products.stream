        "bytes": "{\"id\":\"B07RCMX761\",\"sku\":\"B07RCMX761\",\"lang\":\"en\",\"slug\":\"foldable-18-metal-platform-bed-frame-with-tool-free-assembly-no-box-spring-needed-full-b07rcmx761\",\"name\":\"Foldable, 18&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - Full\",\"description\":\"Product Dimensions: 75&quot; L x 54&quot; W x 18&quot; H | Weight: 43.2 pounds Full size platform bed frame offers a quiet, noise-free, supportive foundation for a mattress. No box spring needed Folding mechanism makes the frame easy to store and move in tight spaces Made of durable steel with a sleek black finish Provides extra under-the-bed storage space Fast, easy setup—no tools required\",\"primaryImage\":{\"alt\":\"Foldable, 18&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - Full\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-unZBhZuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x5EKe02hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x5EKe02hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HqogVnL+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HqogVnL+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6xBCGI4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6xBCGI4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eXibCXvSL.jpg\",\"url\":\"https://storage.goo