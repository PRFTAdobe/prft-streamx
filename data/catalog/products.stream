    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MYZM8\",\"sku\":\"B07B4MYZM8\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-chaise-sofa-sectional-115-w-blue-b07b4myzm8\",\"name\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yIpSdhXwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16+ZSGYcwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16+ZSGYcwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pu2scRH7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Pu2scRH7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11WloDb0BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11WloDb0BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gIXad4NoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gIXad4NoL.jpg\"},{\"alt\":\"https://storage.google