    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MN2W9\",\"sku\":\"B07B4MN2W9\",\"lang\":\"en\",\"slug\":\"andover-modern-rectangle-ottoman-32-w-light-blue-b07b4mn2w9\",\"name\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Light Blue\",\"description\":\"Wooden legs, clean lines, and box-edge cushions bring stylish sophistication to modern or transitional rooms. With a sturdy frame and springy cushioning, this ottoman is ready to withstand years as a footrest or extra seating for guests. 32&quot;W x 25&quot;D x 21&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 21&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame The streamlined shape is a hallmark of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DgAzZ7aAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SUMgqX0OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SUMgqX0OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q-tb4jBuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q-tb4jBuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D23GDIXXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D23GDIXXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1974bH7DpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1974bH7DpL.jpg