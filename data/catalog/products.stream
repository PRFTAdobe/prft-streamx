        "bytes": "{\"id\":\"B07HZ72KXX\",\"sku\":\"B07HZ72KXX\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-armless-sofa-fabric-78-w-stone-b07hz72kxx\",\"name\":\"Bagley Sectional Component, Armless Sofa, Fabric, 78&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the armless sofa component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 78&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Armless Sofa, Fabric, 78&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gC1P215jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814cALCcOnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814cALCcOnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XFWxSy+FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XFWxSy+FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L7IcGUSHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L7IcGUSHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\"},{\