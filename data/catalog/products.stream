  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWL4C2F\",\"sku\":\"B07BWL4C2F\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-right-facing-u-shape-sectional-leather-117-w-saddle-b07bwl4c2f\",\"name\":\"Rivet Edgewest Modern Right-Facing U-Shape Sectional, Leather, 117&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 117&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm; Height: 25&quot;H; Leg Height: 5.25&quot;H; Chaise Depth: 25&quot;D; Chaise Width: 32&quot;W Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; choose the configuration thats right for you Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Right-Facing U-Shape Sectional, Leather, 117&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QftlZVW3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kzHlG5PVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kzHlG5PVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AbIxitm0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AbIxitm0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-uHq9ZmAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-uHq9ZmAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tcSAbU9qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tcSAbU9qL.jpg\"}],\"attributes\":[{\"nam