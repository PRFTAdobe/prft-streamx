    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084S12MYC\",\"sku\":\"B084S12MYC\",\"lang\":\"en\",\"slug\":\"bergen-upholstered-dining-chair-with-wood-legs-set-of-2-20-w-mint-green-b084s12myc\",\"name\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Mint Green\",\"description\":\"Luxury and practicality are married in these beautifully padded dining room chairs. The solid hardwood frame is upholstered in a soothing mint-green performance fabric for easy maintenance and long hours of comfortable sitting. 20&quot;W x 22.5&quot;D x 32.75&quot;H; seat height: 20&quot;H; seat depth: 19&quot;D; seat back height: 12.75&quot;H; leg height: 14&quot;H The solid hardwood frame has a natural finish to complement the performance fabric upholstery on the seat and back. These classic, comfortable chairs can be used as part of a dining room suite, as occasional chairs, or as accent chairs in a bedroom or office. As part of the simple and modern design, backrests are curved ergonomically to ensure comfort while sitting. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Mint Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SeCDVTJtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719C0tzKCKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719C0tzKCKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q9Y96TJlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71q9Y96TJlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rm-FcdaWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rm-FcdaWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71