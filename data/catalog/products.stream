    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP52JM\",\"sku\":\"B07QFP52JM\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-channel-backed-living-room-chair-35-w-leather-cognac-b07qfp52jm\",\"name\":\"Rivet Damien Mid-Century Modern Channel-Backed Living Room Chair, 35&quot;W, Leather, Cognac\",\"description\":\"A channeled back brings elegance to this mid-century 100% top grain leather living room chair with tapered wood legs. The solid hardwood frame combines with the stain resistance of the upholstery, decreasing the wear and tear that comes with daily life and helping to keep this chair looking like new. 35&quot;W x 38&quot;D x 32&quot;H Solid hardwood frame, top grain leather, bench seat cushion with high-density foam, tapered wood legs, brass metal cap Removable and reversible seat cushion A solid hardwood frame with high-density foam adds durability to this channel-backed mid-century chair. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Channel-Backed Living Room Chair, 35&quot;W, Leather, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kg1Fp9KJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AssoRFe7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AssoRFe7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-LDHOOnoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-LDHOOnoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EdGld2KTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EdGld2KTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D+mQ5xZ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D+mQ5xZ1L.jpg