      "content": {
        "bytes": "{\"id\":\"B075X4PTS8\",\"sku\":\"B075X4PTS8\",\"lang\":\"en\",\"slug\":\"rivet-eva-tufted-mid-century-velvet-down-filled-chair-60-5-w-hunter-green-b075x4pts8\",\"name\":\"Rivet Eva Tufted Mid-Century Velvet Down-Filled Chair, 60.5&quot;W, Hunter Green\",\"description\":\"Bring stunning, Mid-century elegance to your living room with this hand-tufted loveseat featuring luxurious velvet upholstery. The plush down-filled bench cushion is removable and reversible, and is held in place by clips at the corners. Durable polyester velvet on hardwood frame and brushed brass legs Modern elegant style with reversible cushion to extend the life of the piece Free returns for 30 days. 1-year warranty. 33.5&quot;W x 35.25''D x 30.25''H Simple assembly in 15 minutes or less. Vacuum or wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Eva Tufted Mid-Century Velvet Down-Filled Chair, 60.5&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jUFA2zqCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127WtA23mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127WtA23mL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ATAVktAnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XSUmqZsRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XSUmqZsRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"116.72\",\"label\":