    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7MWMCW\",\"sku\":\"B07B7MWMCW\",\"lang\":\"en\",\"slug\":\"rivet-edgemont-contemporary-office-desk-swivel-chair-24-h-blue-velvet-b07b7mwmcw\",\"name\":\"Rivet Edgemont Contemporary Office Desk Swivel Chair, 24&quot;H, Blue Velvet\",\"description\":\"At first glance, this mid-century modern-inspired piece appears to be a simple chair, but it actually swivels 360 degrees on a wood base with angled legs. A beautiful blue velvet fabric will bring a pop of color to modern or transitional style room. 21.3&quot;W x 22.8&quot;D x 24.3&quot;H Hardwood base; velvet fabric. Mid-century minimalist, retro style 360 degree swivel function Assembly in less than 15 minutes, simply screw seat cushion to base Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgemont Contemporary Office Desk Swivel Chair, 24&quot;H, Blue Velvet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HJRDHNYYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sZ9iOd28L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sZ9iOd28L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HPUu+qXAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HPUu+qXAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FEQR6IzoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FEQR6IzoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eZ37NOuDS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eZ37NOuDS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y68qdljpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y68qdljpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value