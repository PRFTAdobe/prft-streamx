    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2RH5S\",\"sku\":\"B084W2RH5S\",\"lang\":\"en\",\"slug\":\"vivianne-modern-upholstered-armless-dining-chair-with-casters-19-7-w-hemp-b084w2rh5s\",\"name\":\"Vivianne Modern Upholstered Armless Dining Chair with Casters, 19.7&quot;W, Hemp\",\"description\":\"This armless dining chair, upholstered in a hemp-colored fabric, adds contemporary elegance to your room. This comfortable seating has casters, making it easy to move while retaining your modern aesthetic. The moisture-repellent and stain-resistant fabric makes cleanup easy. 19.7&quot;W x 27.6&quot;D x 36.2&quot;H; seat height: 20.9&quot;H; seat depth: 17.3&quot;D; seat back height: 33.1&quot;H; leg height: 2&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric These chairs have wheels, which makes them easy to move and comfortable to adjust. Feather-filled cushions provide great comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Vivianne Modern Upholstered Armless Dining Chair with Casters, 19.7&quot;W, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Isg7hPxlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X-BMLjTOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X-BMLjTOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8191-0x4xTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8191-0x4xTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D3uNvR9FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D3uNvR9FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CCppPv9yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CCppPv9yL.jpg\"},{\"alt\":\"ht