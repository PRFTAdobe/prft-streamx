    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZRKTGZ\",\"sku\":\"B07TZRKTGZ\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-high-back-swivel-seat-bar-stool-43-h-hemp-b07tzrktgz\",\"name\":\"Alaina Contemporary High-Back Swivel Seat Bar Stool, 43&quot;H, Hemp\",\"description\":\"This bar stool allows you to fit your guests around the bar or kitchen island for special celebrations, while a swivel function makes it extra easy for everyone to chat. Their transitional style allows them to blend with any style room. 18.5&quot;W x 22&quot;D x 43&quot;H; Seat Depth: 16.5&quot;D; Seat Back Height: 12.5&quot;H; Seat Height: 30&quot;H Moisture-repellent, stain-resistant fabric on a solid hardwood frame with swivel seat and low arms Modern design with classic solid upholstery provides a transitional look No assembly required. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary High-Back Swivel Seat Bar Stool, 43&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fdETs9JaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61KNfXYyh-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61KNfXYyh-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-6VFegpHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-6VFegpHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Zu1A496+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Zu1A496+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g7mQsypcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g7mQsypcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713+oYs8cVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori