    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08DG7K18L\",\"sku\":\"B08DG7K18L\",\"lang\":\"en\",\"slug\":\"rivet-alva-modern-curved-back-plastic-dining-chair-23-2-w-nude-pink-renewed-b08dg7k18l\",\"name\":\"Rivet Alva Modern Curved-Back Plastic Dining Chair, 23.2&quot;W, Nude Pink (Renewed)\",\"description\":\"This modern chair with a sleek European design is stylish but flexible enough to go with many types of dining room tables or even be used in other rooms. Made of sturdy beech, steel, and plastic, it will last and adapt to any changes in the surrounding furniture. 23.23&quot;W x 50.5&quot;D x 32&quot;H; seat height: 18.11&quot;H; seat depth: 15.5&quot;D; seat back height: 15&quot;H; arm height: 27.5–30.7&quot;H; leg height: 17.3&quot;H Polypropylene, steel, beech This versatile, durable chair can be used alone or as part of a dining room set. An original piece by an Italian designer that complements many different table styles Avoid moisture. Clean with a damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alva Modern Curved-Back Plastic Dining Chair, 23.2&quot;W, Nude Pink (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61+kDUpanFL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61JeTlKNKPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61JeTlKNKPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OoySsRnFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61OoySsRnFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6107-8kY1uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6107-8kY1uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CJYKwTKcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CJYKwTKcL.jpg\"}],\"attributes\":[{\