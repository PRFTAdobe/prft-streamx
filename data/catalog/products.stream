    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YPTG6M\",\"sku\":\"B075YPTG6M\",\"lang\":\"en\",\"slug\":\"rivet-brianna-mid-century-2-pack-removable-cushion-chairs-34-2-h-red-b075yptg6m\",\"name\":\"Rivet Brianna Mid-Century 2-Pack Removable Cushion Chairs, 34.2&quot;H, Red\",\"description\":\"These Mid-century chairs feature removable seat cushions for ease of cleaning and durability. They're also stackable and easily moved around to multi-task at your dining room table, as extra seating in the living room, or at a desk. 19.7&quot;L, 23.5&quot;W, 34.2&quot;H. Seat height is 19.9&quot;. Polyester fabric on wood frame; metal legs with black finish Can be stacked and easily moved around to accommodate small spaces Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brianna Mid-Century 2-Pack Removable Cushion Chairs, 34.2&quot;H, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i1-opCXQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FJUK0gwwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FJUK0gwwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oiIxx+lpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oiIxx+lpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SUYNV+bJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SUYNV+bJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TANYaks-S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TANYaks-S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BaR5F8rVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BaR5F8rVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\"