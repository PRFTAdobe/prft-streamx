  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL42CL\",\"sku\":\"B07QDL42CL\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-ottoman-30-w-leather-cognac-b07qdl42cl\",\"name\":\"Rivet Damien Mid-Century Modern Ottoman, 30&quot;W, Leather, Cognac\",\"description\":\"Tapered legs with brass caps bring elegance to any room with this mid-century 100% top grain leather ottoman. The solid hardwood frame combines with the stain resistance of the upholstery, decreasing the wear and tear that comes with daily life and helping to keep this ottoman looking like new. 30&quot;W x 22&quot;L x 19&quot;H Solid hardwood frame, top grain leather, tapered wood legs, brass metal cap Top grain leather means this ottoman is easy to maintain. Tapered legs with brass caps add elegance to any room, while a solid hardwood frame increases the durability of this mid-century ottoman. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Ottoman, 30&quot;W, Leather, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DiV4G1zeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nB-+mR3EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nB-+mR3EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91782VjUk0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91782VjUk0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81utBzbqIwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81utBzbqIwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919QZpqDw9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919QZpqDw9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/ori