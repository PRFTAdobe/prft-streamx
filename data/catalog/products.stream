    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQMN3\",\"sku\":\"B07QBMQMN3\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-living-room-chair-with-tapered-wood-legs-35-w-aqua-b07qbmqmn3\",\"name\":\"Rivet Isabelle Mid-Century Modern Living Room Chair with Tapered Wood Legs, 35&quot;W, Aqua\",\"description\":\"This chair’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its subtle upholstery ensures that it will match the color scheme of most any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 35&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Living Room Chair with Tapered Wood Legs, 35&quot;W, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91V6fP1jVPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-2BesAKvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-2BesAKvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PiOXkASWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PiOXkASWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ekqgmy4qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ekqgmy4qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WiQJVOAeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WiQJ