    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853QJ6VS\",\"sku\":\"B0853QJ6VS\",\"lang\":\"en\",\"slug\":\"rivet-woven-dining-chair-22-83-w-brown-b0853qj6vs\",\"name\":\"Rivet Woven Dining Chair, 22.83&quot;W, Brown\",\"description\":\"This chair sports a casual, modern look, but with its woven seat, it has all the comfort of an old favorite. It can blend with both contemporary and classic surroundings and can be a lovely addition to a variety of rooms. 22.83&quot;W x 21.5&quot;D x 33.7&quot;H Brown ash legs and arms with a woven paper-rope seat The solid ash legs and arms are complemented by a comfortable handwoven seat. This chair looks light and modern but has sturdy ash legs. It can blend with both contemporary and classic surroundings. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Woven Dining Chair, 22.83&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uTH+XhhbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ozpqxhTzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ozpqxhTzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Q1EHTTeRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Q1EHTTeRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Qi2PUlgqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Qi2PUlgqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810f5wvHiWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810f5wvHiWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bKbxF5CGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bKbxF5CGL.jpg\"},{\"alt\":\"https://storag