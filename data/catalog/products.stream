    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4DB6Z4\",\"sku\":\"B07B4DB6Z4\",\"lang\":\"en\",\"slug\":\"modern-living-room-chair-31-w-linen-b07b4db6z4\",\"name\":\"Modern Living Room Chair, 31&quot;W, Linen\",\"description\":\"Bring global and rustic touches to your room with this casual modern chair. The rattan sides and back are paired with removable cushions covered with linen fabric. This transitional piece will bring a light, breezy touch to most any style room. 30.75&quot;W x 36.25&quot;D x 38.25&quot;H; Seat Height: 19.5&quot;H ; Seat Depth: 20.5&quot;D; Seat Back Height: 37.5&quot;H; Arm Height: 24.75&quot;H; Leg Height: 8.25&quot; Linen fabric on rattan and wood frame A transitional look with touches of rustic and global style Cushions are removable and reversible No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Living Room Chair, 31&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11fpPmAhZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZoyR5L2GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZoyR5L2GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91psD7UbMZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91psD7UbMZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q60qyuPYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q60qyuPYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tP2eUvFcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tP2eUvFcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ALEY-ydeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ALEY-ydeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"62.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Linen\",\"label\":\"Linen\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":885,\"discountedValue\":796.5}}"
