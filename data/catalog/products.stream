    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSLZB\",\"sku\":\"B07QFRSLZB\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-channel-back-dining-chair-35-h-ivory-set-of-2-b07qfrslzb\",\"name\":\"Rivet Contemporary Channel-Back Dining Chair, 35&quot;H, Ivory, Set of 2\",\"description\":\"This channel-back chair is a modern addition to any dining space. Its ivory upholstery will complement any number of color schemes, and its simple, understated design allows it to work in nearly any space. A solid wood frame and easy-care fabric give this chair plenty of durability. 19&quot;W x 24&quot;D x 35&quot;H; seat height: 19&quot;H; seat depth: 17&quot;D; seat back height: 16&quot;H Set of 2 85% polyester, 15% acrylic fabric on a solid hardwood frame Simple design with channel back No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Channel-Back Dining Chair, 35&quot;H, Ivory, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t7ILRrXDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15d9SYHqOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15d9SYHqOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+XGMbnT9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+XGMbnT9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p60dyTAjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p60dyTAjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w3KFig9XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w3KFig9XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Vjcxl1+uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8