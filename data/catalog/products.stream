    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRRLG1\",\"sku\":\"B07QFRRLG1\",\"lang\":\"en\",\"slug\":\"elden-leather-nailhead-trim-kitchen-counter-backless-bar-stool-30-h-cognac-b07qfrrlg1\",\"name\":\"Elden Leather Nailhead-Trim Kitchen Counter Backless Bar Stool, 30&quot;H, Cognac\",\"description\":\"Brushed-brass nailhead trim wraps around this barstool’s cognac-hued cushion, adding a timeless look to the modern farmhouse design. Top grain leather reduces staining and tops the solid and sturdy wood frame. Together, they keep everyday wear and tear at a minimum while providing comfort. 20&quot;W x 14&quot;D x 30&quot;H Top grain leather on a hardwood frame Stain resistant top grain leather helps keep this barstool looking like new. The brushed-brass nailhead trim adds accents to this modern farmhouse barstool, while sturdy wood legs and top grain leather help keep daily wear and tear at bay. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Leather Nailhead-Trim Kitchen Counter Backless Bar Stool, 30&quot;H, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ccVVNtoHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715OauEcoYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715OauEcoYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L37nazUsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L37nazUsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sskIHNXHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sskIHNXHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71S+cfEJWML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71S+cfEJWML.jpg\"}],\"attributes\":[{\"name\":\"hei