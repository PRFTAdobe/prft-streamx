    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4HZS7\",\"sku\":\"B075X4HZS7\",\"lang\":\"en\",\"slug\":\"leila-tufted-chair-44-w-ink-blue-b075x4hzs7\",\"name\":\"Leila Tufted Chair, 44&quot; W, Ink Blue\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage look chair. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Chair, 44&quot; W, Ink Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j3pAhJ26L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915h8uMpIrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915h8uMpIrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K5qpudDuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K5qpudDuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xwXoUfPTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xwXoUfPTL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.0\",\"label\