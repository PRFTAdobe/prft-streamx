    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNRFRF\",\"sku\":\"B07QDNRFRF\",\"lang\":\"en\",\"slug\":\"glenwilde-king-headboard-92-w-iron-b07qdnrfrf\",\"name\":\"Glenwilde King Headboard, 92&quot;W, Iron\",\"description\":\"The strong, smooth lines of this iron-colored king-size headboard will center the focus of your bedroom where it belongs—on the bed. The plush upholstery makes the headboard as comfortable as it is stylish, whether you're ready to read, relax, or sleep. 92&quot;W x 11&quot;D x 52&quot;H Cotton fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Glenwilde King Headboard, 92&quot;W, Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71h4N7ErRLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Up-8O7KSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Up-8O7KSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C3d1GOQxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C3d1GOQxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wm2+rlgvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7194zSoSO5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7194zSoSO5L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"11.0\",\"label\":\"inches\"}]},{\"name\"