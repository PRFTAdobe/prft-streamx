    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZ79Z\",\"sku\":\"B07QGSZ79Z\",\"lang\":\"en\",\"slug\":\"abigail-leather-ottoman-29-w-dark-brown-b07qgsz79z\",\"name\":\"Abigail Leather Ottoman, 29&quot;W, Dark Brown\",\"description\":\"Comfort meets class in this attractive transitional-style ottoman. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The seat cushions are reversible to prolong the life of this ottoman. 29&quot;W x 23&quot;D x 19&quot;H; seat height: 19&quot;H; seat depth: 23&quot;D; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The ottoman is light and easy to move around your room for ideal comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Leather Ottoman, 29&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51TL4utuOVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910rMQ3vdZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910rMQ3vdZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51YujPjuclL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51YujPjuclL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-7WeW7gQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-7WeW7gQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10-3HeWB6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10-3HeWB6L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"valu