        "bytes": "{\"id\":\"B07QFRSC92\",\"sku\":\"B07QFRSC92\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-welt-trimmed-dining-chair-35-h-juniper-set-of-2-b07qfrsc92\",\"name\":\"Rivet Contemporary Welt-Trimmed Dining Chair, 35&quot;H, Juniper, Set of 2\",\"description\":\"The understated welt trim provides a decorative element to this simple but chic dining chair. The juniper upholstery will add a pop of color to many color schemes and is made of a durable, low-maintenance fabric. A solid wood frame and legs support this comfortable, low-armed seat. 23&quot;W x 25&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 17&quot;D; seat back height: 15&quot;H Set of 2 80% polyester, 20% acrylic fabric on a solid wood frame Simple design with elegant welt Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Welt-Trimmed Dining Chair, 35&quot;H, Juniper, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jRCUjivvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hvKG296EL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hvKG296EL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19iM35Z-GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19iM35Z-GL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dn5KcN0HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dn5KcN0HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qRGNpoJ8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qRGNpoJ8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81guarrZLAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81guarrZLAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.46\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.47\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"22.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Rattan\",\"label\":\"Rattan\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Iconic\",\"label\":\"Iconic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Lucite\",\"label\":\"Lucite\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Side\",\"label\":\"Side\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Parsons\",\"label\":\"Parsons\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Home\",\"label\":\"Home\"},{\"value\":\"Folding\",\"label\":\"Folding\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Parson\",\"label\":\"Parson\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Accent\",\"label\":\"Accent\"},{\"value\":\"Upholstered\",\"label\":\"Upholstered\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Double\",\"label\":\"Double\"},{\"value\":\"Waiting\",\"label\":\"Waiting\"},{\"value\":\"Leg\",\"label\":\"Leg\"},{\"value\":\"Microfiber\",\"label\":\"Microfiber\"},{\"value\":\"Pink\",\"label\":\"Pink\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"4\",\"label\":\"4\"