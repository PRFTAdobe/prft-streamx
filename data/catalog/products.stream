    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085GXHL6X\",\"sku\":\"B085GXHL6X\",\"lang\":\"en\",\"slug\":\"hampstead-modern-power-recliner-accent-chair-with-wood-legs-30-w-beige-and-ivory-circles-b085gxhl6x\",\"name\":\"Hampstead Modern Power Recliner Accent Chair with Wood Legs, 30&quot;W, Beige and Ivory Circles\",\"description\":\"The beige and ivory circular pattern on this reclining accent chair will create a statement in any room. Add a bold touch to your decor without sacrificing comfort. A seat cushioned with compression foam and constructed with spring hangers rests on a solid wooden frame to give you extra support. 30&quot;W x 39&quot;D x 39&quot;H; seat height: 20&quot;H; seat back height: 39&quot;H; seat depth: 19&quot;D; arm height: 26&quot;H; leg height: 6.5&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. Relaxing and reclining are made easy with mechanisms that are insulated to reduce noise and designed to create a smoother motion. No assembly required Clean with shampoo, foam, or dry cleaning solvent as desired. Do not saturate. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Hampstead Modern Power Recliner Accent Chair with Wood Legs, 30&quot;W, Beige and Ivory Circles\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bjNWpKDKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jMR9Kqw8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jMR9Kqw8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PViDPmDgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PViDPmDgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y9Qg1M8eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y9Qg1M8eL.jpg\"},{\"alt\":\"