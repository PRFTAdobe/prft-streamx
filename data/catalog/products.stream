    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMSM1J\",\"sku\":\"B07BWMSM1J\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-armchair-with-tapered-legs-32-7-w-denim-b07bwmsm1j\",\"name\":\"Rivet Sloane Mid-Century Modern Armchair with Tapered Legs, 32.7&quot;W, Denim\",\"description\":\"Impress your friends with this mid-century modern style. The u-shaped, curved silhouette of this chair, accented by hand tufting and buttons on the back pillow, will look smart in your living room or anywhere else a fashionable chair is needed. 32.7”W x 35.8''D x 33.1''H Hardwood frame with solid beech wood legs Mid-century modern A great accent piece to brighten up any space Simple assembly; just attach legs and back Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Armchair with Tapered Legs, 32.7&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819X46SzsAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kgMZaU2-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kgMZaU2-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+1fKzMFiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+1fKzMFiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PZ6AjzTHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PZ6AjzTHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810aVYX9ijL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810aVYX9ijL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"32.7\",\"l