      "content": {
        "bytes": "{\"id\":\"B071J7Q32J\",\"sku\":\"B071J7Q32J\",\"lang\":\"en\",\"slug\":\"kristin-round-arm-performance-fabric-chair-44-w-sand-b071j7q32j\",\"name\":\"Kristin Round Arm Performance Fabric Chair, 44&quot;W, Sand\",\"description\":\"This cozy chair will be the perfect piece for your living room. With its classic style and expert tailoring, you will not be able to resist sitting down and relaxing in all-out comfort. 44&quot;W x 37&quot;D x 37.5&quot;H Solid hardwood and laminate wood frame; polyester/nylon performance fabric Modern casual Classic style designed for heavy-duty use No assembly required Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Round Arm Performance Fabric Chair, 44&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vfD+RibaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rkOXoCF5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rkOXoCF5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ZZjib6SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ZZjib6SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MBmIRoDJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MBmIRoDJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BQAywqB7S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1BQAywqB7S.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"71.0\",\"label\":