    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8PYZ9\",\"sku\":\"B07BW8PYZ9\",\"lang\":\"en\",\"slug\":\"andover-modern-left-u-sectional-sofa-134-w-dark-tan-b07bw8pyz9\",\"name\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Dark Tan\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Dark Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C2xXB-O2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TLBr-aUPS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nslXKbSfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nslXKbSfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8197CZ4jU4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8197CZ4jU4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pNLZsPqqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pNLZsPqqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+sEdgMnUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+sEdgMnUS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"v