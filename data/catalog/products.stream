    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DMLPL\",\"sku\":\"B07B7DMLPL\",\"lang\":\"en\",\"slug\":\"elias-industrial-metal-office-computer-desk-60-w-brown-black-b07b7dmlpl\",\"name\":\"Elias Industrial Metal Office Computer Desk, 60&quot;W, Brown/Black\",\"description\":\"This mid-century inspired piece makes an artful style statement while serving as a desk -- and could serve as a craft table as well. The wood and steel combo give it rustic and industrial touches, while open shelving gives you storage areas. 28&quot;L x 60&quot;W x 30&quot;H Wood veneer over wood composites; steel Mid-century minimalist, retro style Four open shelves; metal casters add to the industrial look and make it easy to move Assembly in 30 minutes or less; bolt together base, then bolt to top Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elias Industrial Metal Office Computer Desk, 60&quot;W, Brown/Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OqPkir30L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KnVGr4jRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KnVGr4jRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMhj3WVBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sMhj3WVBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wiy6-OnIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wiy6-OnIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CyyfHUm0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CyyfHUm0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YGpfD0tlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YGpfD0tlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight