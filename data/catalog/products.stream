        "bytes": "{\"id\":\"B075X52BM1\",\"sku\":\"B075X52BM1\",\"lang\":\"en\",\"slug\":\"larkin-living-room-accent-swivel-chair-30-w-smoke-b075x52bm1\",\"name\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Smoke\",\"description\":\"This elegant slipcover swivel accent chair in Smoke is made to order just for you. Upholstered in high-performance twill fabric that is comfortable and durable, its slender design makes it practical even in small spaces. Sturdy metal base, solid wood frame, durable performance fabric; no assembly required Swivel mechanism allows you to turn in any direction Care Instructions: Vacuum or lightly brush; spot clean with a damp cloth if needed Product Dimensions: 30&quot;W x 35&quot;D x 33&quot;H; seat height is 20&quot; Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Smoke\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-JDs14TaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cqjJhG08L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cqjJhG08L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X0uWPBo1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X0uWPBo1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XCsXiBByL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XCsXiBByL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fewRIRuvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fewRIRuvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ZEpvRHzIS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ZEpvRHzIS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\"