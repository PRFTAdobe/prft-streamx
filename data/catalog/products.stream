  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDDJXJ\",\"sku\":\"B082QDDJXJ\",\"lang\":\"en\",\"slug\":\"rivet-spear-mid-century-modern-channel-tufted-accent-chair-with-wood-arms-29-1-w-dark-grey-b082qddjxj\",\"name\":\"Rivet Spear Mid-Century Modern Channel Tufted Accent Chair with Wood Arms, 29.1&quot;W, Dark Grey\",\"description\":\"Classic design features get a modern twist in this chic channel-back accent chair. The tufted upholstery comes in a contemporary gray sure to fit with any design scheme. A curved back and wooden armrests provide support and an elegant look that will add a finishing touch wherever you need seating. 29.1&quot;W x 31.5&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 24.4&quot;D; seat back height: 21.7&quot;H; arm height: 25.2&quot;H; leg height: 11&quot;H Solid ash frame, polyester and acrylic upholstery Add elegance to any seating area with the classic design features of this channel-back chair. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Spear Mid-Century Modern Channel Tufted Accent Chair with Wood Arms, 29.1&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914nsKl60RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919bf1abg1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919bf1abg1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EfQEnhfgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EfQEnhfgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EPZE8NxJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EPZE8NxJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Yf3VA-OjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Yf3VA-OjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BFqySI0FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BFqySI0FL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"29.1\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"26.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Glider\",\"label\":\"Glider\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Reclining\",\"label\":\"Reclining\"},{\"value\":\"Navy\",\"label\":\"Navy\"},{\"value\":\"2\",\"label\":\"2\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Signature\",\"label\":\"Signature\"},{\"value\":\"Lazyboy\",\"label\":\"Lazyboy\"},{\"value\":\"By\",\"label\":\"By\"},{\"value\":\"Swivel\",\"label\":\"Swivel\"},{\"value\":\"Ashley\",\