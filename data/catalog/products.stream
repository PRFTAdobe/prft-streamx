    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4W5TM9\",\"sku\":\"B07B4W5TM9\",\"lang\":\"en\",\"slug\":\"prudence-tufted-queen-bed-66-w-cream-herringbone-b07b4w5tm9\",\"name\":\"Prudence Tufted Queen Bed, 66&quot;W, Cream Herringbone\",\"description\":\"This bed adds classic style to any space. A hand-tufted headboard adds an interesting design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 66&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Prudence Tufted Queen Bed, 66&quot;W, Cream Herringbone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+tPuYcmDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bkW5sRPsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bkW5sRPsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912IS6P+scL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912IS6P+scL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jeRycS7DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jeRycS7DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D6b9rXfpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D6b9rXfpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818uyRV5n+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818uyRV5n+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"56.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"92.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"66.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"141.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Romero cream\",\"label\":\"Romero cream\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"}]}],\"categories\":[{\"id\":\"Beds\",\"slug\":\"beds\",\"name\":\"Beds\",\"value\":\"Beds\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":245,\"discountedValue\":220.5}}"
