    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JWD3W\",\"sku\":\"B07P6JWD3W\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-living-room-accent-armchair-with-hardwood-frame-46-w-pepper-b07p6jwd3w\",\"name\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Pepper\",\"description\":\"Dimensions: 46&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this armchair offers plush support and security. Neutral pepper-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Pepper\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h1XfZrEhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k4vbqvj7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k4vbqvj7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IL-+eRWDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IL-+eRWDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kvKyQyLkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kvKyQyLkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IEdupIhRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IEdupIhRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14g5-aHxKL.jpg\",\"url\":\"https://storage.goog