    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6RKSV\",\"sku\":\"B07HZ6RKSV\",\"lang\":\"en\",\"slug\":\"blaine-modern-upholstered-living-room-accent-chair-32-3-w-light-grey-b07hz6rksv\",\"name\":\"Blaine Modern Upholstered Living Room Accent Chair, 32.3&quot;W, Light Grey\",\"description\":\"Add mid-century elegance to your living room with this light-gray living room chair. The solid-wood frame and polyester upholstery make this chair both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you. Overall: 32.3&quot;W x 37.8&quot;D x 35&quot;H; Seat Height: 19.3&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 25.6&quot;H; Arm Height: 24.4&quot;H; Leg Height: 4.9&quot;H\",\"primaryImage\":{\"alt\":\"Blaine Modern Upholstered Living Room Accent Chair, 32.3&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SG9DfJEKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MZokldZCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MZokldZCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+daY-qCWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+daY-qCWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UXOFJsGQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UXOFJsGQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ATwCJROlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ATwCJROlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1