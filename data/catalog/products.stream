    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCB52Z\",\"sku\":\"B082QCB52Z\",\"lang\":\"en\",\"slug\":\"rivet-theresa-modern-upholstered-accent-chair-30-w-slate-b082qcb52z\",\"name\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Slate\",\"description\":\"A great fit for a fireside evening or just to lounge around in, this modern upholstered chair is the perfect addition to any room in your home. The slightly curved armrests add a touch of class, and the reversible seat cushion allows for longer wear. This item is made to order just for you. 30&quot;W x 31&quot;D x 33&quot;H; seat height: 20&quot;H; seat depth: 21&quot;D; seat back height: 13&quot;H; arm height: 24&quot;H; leg height: 12&quot;H This chair has a sturdy wood frame and legs. Foam seat cushions provide lasting support and comfort. Upholstery is 100% polyester. No assembly required; removable and reversible seat cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DQN8hXlpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Gzbsi1TuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Gzbsi1TuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61n1Tf5IBkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61n1Tf5IBkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LES56RD0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LES56RD0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911vhbTgUDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911vhbTgUDL.jpg\"},{\"alt\":\"https://storage.go