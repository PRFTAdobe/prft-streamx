    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JQ3DY\",\"sku\":\"B0857JQ3DY\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-birch-dining-chair-17-5-w-brown-b0857jq3dy\",\"name\":\"Modern Farmhouse Birch Dining Chair, 17.5&quot;W, Brown\",\"description\":\"This solid birch dining chair has a timeless, traditional look but is still comfortable enough for the most casual of get-togethers. Its brown color helps it match with different tables and types of rooms. 17.5&quot;W x 21.5&quot;D x 39&quot;H Solid birch The 100% birch construction makes this chair sturdy enough to last a lifetime but easy to sit in every day. The birch and brown finish give this chair a classic, understated look that can be adapted to different purposes. Assemble in 15 minutes or less Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Birch Dining Chair, 17.5&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61sEJzcZvYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e9Ps2SgnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e9Ps2SgnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718yHvtCUzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718yHvtCUzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61dJWR9o5pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61dJWR9o5pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51lIvqkEZ9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51lIvqkEZ9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61X6QL+8wQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61X6QL+8wQL.jpg\"},{\"alt\":\"https://sto