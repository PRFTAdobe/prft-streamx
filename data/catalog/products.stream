        "bytes": "{\"id\":\"B07BL5QBY6\",\"sku\":\"B07BL5QBY6\",\"lang\":\"en\",\"slug\":\"classic-grand-3-piece-mirror-table-vanity-set-with-stool-cherry-b07bl5qby6\",\"name\":\"Classic Grand 3-Piece Mirror Table Vanity Set with Stool - Cherry\",\"description\":\"Vanity table with 3-panel mirror, a large top surface, and 3 pull-out drawers (2 on either side of a shallow center drawer) Matching sitting stool provides comfort and slides under the table when not in use; vanity stool holds up to 250 pounds Sturdy post-style legs on vanity table and stool offer decorative flair and reliable strength and stability Elegant style for lasting good looks; pleasingly symmetrical profile; beautiful Cherry color; assembly required (step-by-step instructions included)\",\"primaryImage\":{\"alt\":\"Classic Grand 3-Piece Mirror Table Vanity Set with Stool - Cherry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZGeq4EqVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hmpCD9wiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hmpCD9wiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vOL6aer8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vOL6aer8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918IJfpvTCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918IJfpvTCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sCAQF+U2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sCAQF+U2L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"51.6\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"54.0\",\