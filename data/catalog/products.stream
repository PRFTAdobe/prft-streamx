    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DFM2G\",\"sku\":\"B07B7DFM2G\",\"lang\":\"en\",\"slug\":\"aire-rustic-octagonal-nbsp-fir-wood-coffee-table-39-5-w-black-natural-b07b7dfm2g\",\"name\":\"Aire Rustic Octagonal&nbsp;Fir Wood Coffee Table, 39.5&quot;W, Black & Natural\",\"description\":\"This handsome coffee table will be a stylish focal point along with providing a place for remotes and trays of snacks. A rustic wood top is married with a sturdy iron frame, making this piece great for farmhouse and industrial decor. 39.5&quot;W x 39.5&quot;D x 17.5&quot;H Fir wood top with iron base This versatile table will fit with modern, industrial or farmhouse design Sturdy and durable Assembly in 15 minutes or less; just attach top to base Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Aire Rustic Octagonal&nbsp;Fir Wood Coffee Table, 39.5&quot;W, Black & Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81S0Ros8C-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17kD7YH4-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17kD7YH4-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oI+VFAe0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oI+VFAe0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Ds8IeCavL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Ds8IeCavL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DvehGnc8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DvehGnc8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ikG6fHe1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ikG6fHe1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/