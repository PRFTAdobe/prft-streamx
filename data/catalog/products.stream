    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STD74\",\"sku\":\"B07P8STD74\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-classic-chair-50-w-slate-b07p8std74\",\"name\":\"Bradbury Chesterfield Classic Chair, 50&quot;W, Slate\",\"description\":\"This lovely chair has the low button-tufted back, scroll arms, and short legs that are the hallmark of the classic chesterfield style. Whether as a statement piece or part of a living-room suite, this chair will be a welcome addition to any decor. Dimensions: 50&quot;W x 39&quot;D x 30&quot;H Solid hardwood frame; upholstery: 98% polyester, 2% nylon Removable and reversible seat cushions A classic style updated in stain-resistant fabric makes this perfect for the modern home. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Classic Chair, 50&quot;W, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gRPd6mEkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15LitfP0lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15LitfP0lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JeG5RAsoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JeG5RAsoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CnyMgyo6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CnyMgyo6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b5i09goIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81b5i09goIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qivzTUkTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qivzTUkTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/