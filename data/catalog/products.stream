    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8P2F7\",\"sku\":\"B07BW8P2F7\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-loveseat-65-w-beige-b07bw8p2f7\",\"name\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Beige\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. 65&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9152Wbx6eGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81muzpodbiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81muzpodbiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915L6tvGEiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915L6tvGEiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DZDJV82PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DZDJV82PL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mGuHSMBRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mGuHSMBRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"He