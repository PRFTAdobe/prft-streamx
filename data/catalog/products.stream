    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YPTG8S\",\"sku\":\"B075YPTG8S\",\"lang\":\"en\",\"slug\":\"rivet-industrial-mid-century-modern-hairpin-dining-table-70-9-l-walnut-and-black-b075yptg8s\",\"name\":\"Rivet Industrial Mid-Century Modern Hairpin Dining Table, 70.9&quot;L, Walnut and Black\",\"description\":\"This distinctive dining table appears to float on black metal legs shaped much like hairpins. A hardwood top with walnut finish is roomy enough for dining, but can also work as a desk in modern or industrial-style rooms. 70.9&quot;L x 35.4&quot;D x 29.5&quot;H Hardwood top with walnut finish; metal hairpin legs with black finish An attractive piece useful as a dining room table or as a desk Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Mid-Century Modern Hairpin Dining Table, 70.9&quot;L, Walnut and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MS5PHDx1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b5uyNZcVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b5uyNZcVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819WwsIS4JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819WwsIS4JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wuVMeTcrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wuVMeTcrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"70.9\",\"label\":\"inches\"}]},{\"name\":\"length\",\"la