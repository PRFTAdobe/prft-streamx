    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B82PXCM\",\"sku\":\"B07B82PXCM\",\"lang\":\"en\",\"slug\":\"bradhurst-casual-farmhouse-wood-dining-kitchen-table-61-84-l-white-b07b82pxcm\",\"name\":\"Bradhurst Casual Farmhouse Wood Dining Kitchen Table, 61&quot;-84&quot;L, White\",\"description\":\"A natural wood top rests on an angular, white painted base for a modern refresh of the classic rustic table. You'll delight in the crisp, clean expandable design as well as the fact it's made of 60% reclaimed fir wood, ready to enhance a farmhouse-style space. 60.6-84.3&quot;L x 35.5&quot;D x 30.7&quot;H Made of hardwood comprised of 60% reclaimed fir wood Ideal for modern farmhouse setting but also works with transitional or traditional décor An extra leaf is provided to expand the table if needed Assembly in 30 minutes or less. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bradhurst Casual Farmhouse Wood Dining Kitchen Table, 61&quot;-84&quot;L, White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XJvwmWjUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1scr-dIrcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1scr-dIrcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-AJj5juaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-AJj5juaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zrCEEHJAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zrCEEHJAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rmbRVKIkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rmbRVKIkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IpXQlOk0