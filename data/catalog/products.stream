    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071FMSYZV\",\"sku\":\"B071FMSYZV\",\"lang\":\"en\",\"slug\":\"rivet-fold-modern-ottoman-sofa-bed-48-w-light-grey-b071fmsyzv\",\"name\":\"Rivet Fold Modern Ottoman Sofa Bed, 48&quot;W, Light Grey\",\"description\":\"This contemporary yet classic piece will blend in nicely with your existing style while giving you extra seating and a place to rest your feet. Plus, fold back the top and find a handy twin pull-out bed perfect for surprise visitors. 48&quot;W x 29.9&quot;D x 16.5&quot;H Wood frame and solid beech legs Contemporary and comfortable A cozy addition anywhere you need an extra seat or pull out bed for guests Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fold Modern Ottoman Sofa Bed, 48&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OVDLcZZBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EeW5ly-VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EeW5ly-VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gr9UGR2+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gr9UGR2+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gA73EIHsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gA73EIHsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KjkAwc7LS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1KjkAwc7LS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.1\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"47.2\",\"label\":\"inches\"}]},{\"name\":\"weight\",\