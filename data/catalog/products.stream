    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082MSJRDP\",\"sku\":\"B082MSJRDP\",\"lang\":\"en\",\"slug\":\"decatur-modern-tufted-wingback-living-room-accent-chair-32-37-w-gray-b082msjrdp\",\"name\":\"Decatur Modern Tufted Wingback Living Room Accent Chair, 32.37&quot;W, Gray\",\"description\":\"This contemporary wingback accent chair in Gray looks beautiful while it stands up to the demands of a busy life. Stitch-tufted fabric and gently curved sides bring style and comfort, while durable construction holds up to family, pets and entertaining in your living room. Solid wood frame; upholstered with polyester fabric Minimal assembly; just attach legs Product Dimensions: 32.3&quot;W x 35.8&quot;D x 36.2&quot;H Care Instructions: Avoid moisture and wipe clean with soft, dry cloth Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Decatur Modern Tufted Wingback Living Room Accent Chair, 32.37&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V-tpqPEKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yE9m3EfYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yE9m3EfYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BW3VLah4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BW3VLah4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnXZ-tGVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NnXZ-tGVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MGmVnQLvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MGmVnQLvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GyscoOnzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GyscoOnzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/