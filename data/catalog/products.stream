    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDLG2M\",\"sku\":\"B082QDLG2M\",\"lang\":\"en\",\"slug\":\"rivet-new-luna-upholstered-mid-century-crescent-accent-chair-with-tapered-legs-31-5-w-light-grey-b082qdlg2m\",\"name\":\"Rivet New Luna Upholstered Mid-Century Crescent Accent Chair with Tapered Legs, 31.5&quot;W, Light Grey\",\"description\":\"A sturdy frame of solid wood and wooden tapered legs form the base of this classic mid-century accent chair. Foam padding provides cushioned support. Soft light-grey upholstery creates a comfortable place to sit and gives the piece a classic neutral color that will be at home in any living space. 31.5&quot;W x 35&quot;D x 36.6&quot;H; seat height: 18.1&quot;H; seat depth: 21.3&quot;D; seat back height: 27.6&quot;H; arm height: 24.4&quot;H; leg height: 9.1&quot;H Solid wood frame This handy and beautiful accent chair offers extra seating for surprise guests. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet New Luna Upholstered Mid-Century Crescent Accent Chair with Tapered Legs, 31.5&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jkjC5kHiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1s86PeLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w1s86PeLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iUsCfHCNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iUsCfHCNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mb6njxAFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mb6njxAFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910rcm2J7JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910rcm2J7J