    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084RZBTHX\",\"sku\":\"B084RZBTHX\",\"lang\":\"en\",\"slug\":\"alaina-upholstered-dining-room-kitchen-chairs-20-w-set-of-2-hemp-b084rzbthx\",\"name\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Hemp\",\"description\":\"Clean, compact design helps you fit more of these chairs around the table for those special family dinners. Simple low-slung armrests and straight legs combine with classic performance cotton fabric for a transitional look that will blend with most any décor. Overall: 20&quot;W x 25.1&quot;D x 37.4&quot;H; Seat Height: 19.6&quot;H ; Seat Depth: 16.9&quot;D; Seat Back Height: 16.9&quot;H; Arm Height: 19.4&quot;H Hardwood legs and frame; performance fabric Modern design with classic solid fabric provides a transitional look Arrives fully assembled Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uuEJWAPxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yHhPg+FWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yHhPg+FWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NMWYUT6OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NMWYUT6OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71t0P2qxsqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71t0P2qxsqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aEuRRQ1oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aEuRRQ1oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oF-EAnigL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oF-EAnig