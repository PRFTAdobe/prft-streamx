    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FDW\",\"sku\":\"B075X43FDW\",\"lang\":\"en\",\"slug\":\"rivet-lawson-mid-century-modern-angled-leather-loveseat-sofa-couch-78-w-charcoal-b075x43fdw\",\"name\":\"Rivet Lawson Mid-Century Modern Angled Leather Loveseat Sofa Couch, 78&quot;W, Charcoal\",\"description\":\"This item is made to order just for you Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated sofa. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. 78&quot;W x 34&quot;D x 34&quot;H No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Mid-Century Modern Angled Leather Loveseat Sofa Couch, 78&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GU7NjrTHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912Kdo6wQGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912Kdo6wQGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cRYFk8FnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917qHdcea4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917qHdcea4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E+ddLUDwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E+ddLUDwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aYLTFHhLL.jpg\",\"url\":\"https: