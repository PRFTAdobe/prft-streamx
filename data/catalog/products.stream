    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QB3DJL\",\"sku\":\"B082QB3DJL\",\"lang\":\"en\",\"slug\":\"myrtle-upholstered-accent-chair-30-w-sandstone-b082qb3djl\",\"name\":\"Myrtle Upholstered Accent Chair, 30&quot;W, Sandstone\",\"description\":\"This upholstered accent chair brings a stylish charm to any room. Durable fabric-covered foam seat cushions provide lasting comfort, and the modern design complements any decor. This will be your favorite spot to curl up and read a book or enjoy your favorite hot beverage. This item is made to order just for you. Overall: 30&quot;W x 31&quot;D x 33&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 14&quot;H; arm height: 26&quot;H; leg height: 5.5&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Myrtle Upholstered Accent Chair, 30&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bGff3QGQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n+Gf3SZcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n+Gf3SZcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yDldD6HmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yDldD6HmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nvr7qxWzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nvr7qxWzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919coDTzxVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919coDTzxVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CRG6H4WaL.jp