    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP3BHQ\",\"sku\":\"B075YP3BHQ\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-upholstered-low-back-kitchen-bar-stool-41-h-light-grey-b075yp3bhq\",\"name\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Bar Stool, 41&quot;H, Light Grey\",\"description\":\"This fun bar stool features an upholstered low-back seat on tall, straight wood legs. Firm padding and a solid wood frame add sturdiness and durability, while the light grey fabric brings a nice neutral color to your bar area. Fabric is 60% polyester/20% linen/20% rayon Foam padding and elastic suspension system helps keep seat firm No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty. 20&quot;W x 21&quot;D x 41&quot;H. Seat height is 30&quot;.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Bar Stool, 41&quot;H, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PJEbYYpTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KA4NkBg6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KA4NkBg6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-+hVYMIpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-+hVYMIpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QAXDohSdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QAXDohSdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810bklyCvYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810bklyCvYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kdEfglG7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kdEfglG7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim