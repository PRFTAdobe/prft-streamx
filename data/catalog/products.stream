    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQXRJM\",\"sku\":\"B075YQXRJM\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-minimalist-dining-kitchen-table-53-1-l-walnut-wood-b075yqxrjm\",\"name\":\"Rivet Mid-Century Modern Minimalist Dining Kitchen Table, 53.1&quot;L, Walnut Wood\",\"description\":\"Beautiful in its simplicity and clean lines, this dining table is mid-century minimalist design at its best. Its compact size makes it ideal as a dining table in a small space, but it can also double as a desk or craft table. 53.1&quot;L x 31.5&quot;D x 28.5&quot;H Walnut veneer on hardwood top and solid beech legs Compact size allows it to multi-task as a dining table or desk in small spaces Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Minimalist Dining Kitchen Table, 53.1&quot;L, Walnut Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812uwtIdeVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSuVOGFsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptWf2dD7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ptWf2dD7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O6Otw58lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O6Otw58lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lZjtfytwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lZjtfytwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VJN++s+UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VJN++s+UL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"va