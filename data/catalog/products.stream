    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07K6H8MBV\",\"sku\":\"B07K6H8MBV\",\"lang\":\"en\",\"slug\":\"mattress-foundation-smart-box-spring-for-queen-size-bed-tool-free-easy-assembly-9-inch-queen-b07k6h8mbv\",\"name\":\"Mattress Foundation / Smart Box Spring for Queen Size Bed, Tool-Free Easy Assembly - 9-Inch, Queen\",\"description\":\"Offers the look and functionality of a traditional box spring, but made from steel for longer-lasting durability sturdy enough to support any spring, foam, or hybrid mattress Durable steel frame and horizontal slats provide sturdy, reliable support for any same-size mattress 2-piece fabric top and bottom covers zip securely together for full coverage; cover is removable for spot cleaning Easy Assembly: New frame construction allows for easy assembly in minutes with no tools required Foldable steel frame to be packed in one smart package and faster delivery to your front Measures 9 inches deep; backed by an AmazonBasics 1-year limited warranty\",\"primaryImage\":{\"alt\":\"Mattress Foundation / Smart Box Spring for Queen Size Bed, Tool-Free Easy Assembly - 9-Inch, Queen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J1zEvsM5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xPUljpJXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xPUljpJXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nm1LVMr0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nm1LVMr0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QRESBF1SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QRESBF1SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NILQDoxxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NILQDoxxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GSx7elFPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GSx7elFPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wWMGqcxQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wWMGqcxQL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"9.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"59.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"79.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"36.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Box-springs\",\"label\":\"Box-springs\"}]}],\"categories\":[{\"id\":\"Bed Frames\",\"slug\":\"bed-frames\",\"name\":\"Bed Frames\",\"value\":\"Bed Frames\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":530,\"discountedValue\":477.0}}"
