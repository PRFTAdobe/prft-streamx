    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BFP97\",\"sku\":\"B07B7BFP97\",\"lang\":\"en\",\"slug\":\"alaina-upholstered-dining-room-kitchen-chairs-20-w-set-of-2-grey-b07b7bfp97\",\"name\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Grey\",\"description\":\"Clean, compact design helps you fit more of these chairs around the table for those special family dinners. Simple low-slung armrests and straight legs combine with performance cotton fabric for a transitional look that will blend with most any décor. Overall: 20&quot;W x 25.1&quot;D x 37.4&quot;H; Seat Height: 19.6&quot;H ; Seat Depth: 16.9&quot;D; Seat Back Height: 16.9&quot;H; Arm Height: 19.4&quot;H Hardwood legs and frame; cotton performance fabric Modern design with classic solid fabric provides a transitional look Arrives fully assembled Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-gevXjk8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZgbOZx2DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZgbOZx2DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NjPlifNvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NjPlifNvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GMyAnz1TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GMyAnz1TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KOxoC7D4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KOxoC7D4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H7G3fsERL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H7G3fsERL