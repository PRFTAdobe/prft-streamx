    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YNQ7R1\",\"sku\":\"B075YNQ7R1\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-upholstered-low-back-kitchen-counter-height-stool-37-h-blue-b075ynq7r1\",\"name\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Counter Height Stool, 37&quot;H, Blue\",\"description\":\"This fun counter stool features an upholstered low-back seat on tall, straight wood legs. Firm padding and a solid wood frame add sturdiness and durability, while the marine blue fabric gives your counter area a nice pop of color 20&quot;W x 21&quot;D x 37&quot;H. Seat height is 26&quot;. Fabric is 60% polyester/20% linen/20% rayon Foam padding and elastic suspension system helps keep seat firm No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Counter Height Stool, 37&quot;H, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HE+00vAcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f+XP-9ifL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f+XP-9ifL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i7B9xEI8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i7B9xEI8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+KvNdi3PL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+KvNdi3PL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"17.6\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Barstools\",\"label\":\"Barstools\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Counter stool\",\"label\":\"Counter stool\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Marine blue\",\"label\":\"Marine blue\"},{\"value\":\"Bar stools set of 4\",\"label\":\"Bar stools set of 4\"},{\"value\":\"Bar stools set of 3\",\"label\":\"Bar stools set of 3\"},{\"value\":\"Bar stools set of 2\",\"label\":\"Bar stools set of 2\"},{\"value\":\"Counter stools\",\"label\":\"Counter stools\"},{\"value\":\"Counter height\",\"label\":\"Counter height\"},{\"value\":\"Counter height bar stools\",\"label\":\"Counter height bar stools\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Bar stool\",\"label\":\"Bar stool\"}]}],\"categories\":[{\"id\":\"Barstools\",\"slug\":\"barstools\",\"name\":\"Barstools\",\"value\":\"Barstools\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":433,\"discountedValue\":389.7}}"
