    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568YKW9\",\"sku\":\"B08568YKW9\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-upholstered-dining-chair-21-w-set-of-2-aqua-b08568ykw9\",\"name\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Aqua\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat with fabric upholstery. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Upholstered Dining Chair, 21&quot;W, Set of 2, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YV15iHWbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nYbp4g2RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nYbp4g2RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kQ6sFvElL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kQ6sFvElL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716eOxnAMNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716eOxnAMNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZWQkE2wML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZWQkE2wML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bM5srdJ8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bM5srdJ8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Qqo48pWWL.jpg\