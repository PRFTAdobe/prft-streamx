    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B8F76PH\",\"sku\":\"B07B8F76PH\",\"lang\":\"en\",\"slug\":\"rivet-stevie-mid-century-modern-bar-stool-30-h-pack-of-2-grey-b07b8f76ph\",\"name\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Grey\",\"description\":\"These fun velvet stools will add a cheerful pop of color to any room. Flared modern metal legs are topped by velvet cushions for a plush, sturdy feel and a touch of glam. Move them around to any room where you need an extra seat. 15.75&quot;W x 15.75&quot;D x 30&quot;H Velvet fabric on hardwood frame and legs An update on mid-century modern style that can blend with many rooms Velvet adds comfort and a touch of glam No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Q60SnWTRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OtnE9CdxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OtnE9CdxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PVViWzYHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PVViWzYHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EiABeYZ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EiABeYZ2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qpR1E+jRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qpR1E+jRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915HUoIN5aL.jpg\",\"url\":\"https://