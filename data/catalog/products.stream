    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853Q3Z93\",\"sku\":\"B0853Q3Z93\",\"lang\":\"en\",\"slug\":\"rivet-noah-round-modern-ash-dining-table-35-4-w-white-b0853q3z93\",\"name\":\"Rivet Noah Round Modern Ash Dining Table, 35.4&quot;W, White\",\"description\":\"This modern, sleek round table is small enough to fit in a number of places and easy to move, yet with its solid ash legs, it can endure steady use. It can fit in with a simple decor or be spruced up to go with different rooms or occasions. 35.4&quot;W x 35.4&quot;D x 30&quot;H Solid ash legs and white MDF tabletop with a natural finish This round, modern dining table is easy to carry and clean and can fit in nearly any room. It can be used for meals or a number of other purposes. The ash legs and white tabletop create a stylish but clean modern look. Its ageless design blends with its surroundings. Assemble in 15 minutes or less Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Noah Round Modern Ash Dining Table, 35.4&quot;W, White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61CkJbi9zeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uKF+RZ46L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uKF+RZ46L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rj81PXrTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rj81PXrTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51CmGe+9wCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51CmGe+9wCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Grh5wdobL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Grh5wdobL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/o