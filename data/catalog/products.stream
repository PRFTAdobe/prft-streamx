    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PRPZ\",\"sku\":\"B075X4PRPZ\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-tufted-customizable-daybed-sofa-78-w-platinum-amp-silver-b075x4prpz\",\"name\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Platinum &amp; Silver\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and silver metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Platinum &amp; Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Vts5efjwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914FDzHupqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914FDzHupqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ash42j0aS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ash42j0aS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15B1zevGSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15B1zevGSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91s5Ub7JKIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91s5Ub7JKIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pDdZrRgJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original