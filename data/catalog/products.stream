    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2X4V8\",\"sku\":\"B075X2X4V8\",\"lang\":\"en\",\"slug\":\"leila-tufted-chair-44-w-charcoal-b075x2x4v8\",\"name\":\"Leila Tufted Chair, 44&quot; W, Charcoal\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage look chair. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Chair, 44&quot; W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wf156FQ6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uZS2HWqrS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uZS2HWqrS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Tjc5lo9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Tjc5lo9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HNao7V9OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HNao7V9OL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\"