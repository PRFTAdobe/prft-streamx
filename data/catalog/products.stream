    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MMPPH\",\"sku\":\"B07B4MMPPH\",\"lang\":\"en\",\"slug\":\"traditional-nailhead-leather-recliner-33-w-brown-b07b4mmpph\",\"name\":\"Traditional Nailhead Leather Recliner, 33&quot;W, Brown\",\"description\":\"The simple, clean design of this recliner will blend with any style room. Top-grain leather on the entire chair, as well as nail head accents on the arms, add sophisticated touches. Substantial padding in the back cushion makes it extra welcoming. 32.6&quot;W x 38.9&quot;D x 39.7&quot;H Top grain leather; nailhead trim; wood legs A simple style that blends with any room Plush cushioned back; push-back recliner with pop-up foot support Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Traditional Nailhead Leather Recliner, 33&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QjmQtPIUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gyPtguK+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gyPtguK+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZOoUZ4PwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZOoUZ4PwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HpCUTHIiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HpCUTHIiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RTR5IyUKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RTR5IyUKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b01wrwtLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b01wrwtLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"27.0\",\"label