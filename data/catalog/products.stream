        "bytes": "{\"id\":\"B075X4YDJ6\",\"sku\":\"B075X4YDJ6\",\"lang\":\"en\",\"slug\":\"rivet-modern-upholstered-cube-ottoman-pouf-20-w-black-jack-b075x4ydj6\",\"name\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Black Jack\",\"description\":\"This item is made to order just for you 20&quot;W x 20&quot;Dx 17&quot;H Solid wood frame, polyester/acrylic blend fabric. Multi-purpose cube ottoman is great in any space. Free returns for 30 days. 1-year warranty. Prop up your feet or add a tray of your favorite snacks to the top of this plush cube ottoman. Sturdy enough to use as an extra seat in any room, this versatile ottoman is offered in a range of fabrics. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Modern Upholstered Cube Ottoman Pouf, 20&quot;W, Black Jack\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1K-quFpzwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HWvj9JmAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HWvj9JmAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OtdlkAk+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OtdlkAk+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lbe+pIDzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lbe+pIDzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13qaM5OCCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13qaM5OCCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fE8fIqwYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fE8fIqwYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.0\",\"label\"