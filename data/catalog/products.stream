    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MYDTKM\",\"sku\":\"B084MYDTKM\",\"lang\":\"en\",\"slug\":\"rivet-mango-wood-and-iron-3-drawer-shutter-nightstand-18-w-natural-finish-b084mydtkm\",\"name\":\"Rivet Mango Wood and Iron 3-Drawer Shutter Nightstand, 18&quot;W, Natural Finish\",\"description\":\"This mango wood nightstand marries simplicity and style. Sturdy yet decorative, the natural patina highlights the mango wood's warm hues and grain that cleverly. Resting on airy, origami-style iron legs, the shutter-style pattern cleverly disguises 3 handy drawers. 18&quot;W x 16&quot;D x 22&quot;H; leg height: 7&quot;H Strong, lightweight mango wood in a natural finish with 3 drawers and sturdy iron legs Recalling art deco and Scandinavian influences, this nightstand displays diverse wood grain patterns atop airy, origami-style iron legs Assemble in 15 minutes or less Wipe away dust and debris with a soft, dry cloth. Free returns for 30 days; 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Mango Wood and Iron 3-Drawer Shutter Nightstand, 18&quot;W, Natural Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vbN8eW5sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W8AQa3KFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71W8AQa3KFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812G6VIu0LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812G6VIu0LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71och2yw8FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71och2yw8FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fm5tut6uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fm5tut6uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AepLSlxKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AepLSlxKL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"39.68\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Vanity\",\"label\":\"Vanity\"},{\"value\":\"Chest\",\"label\":\"Chest\"},{\"value\":\"Night\",\"label\":\"Night\"},{\"value\":\"Glass\",\"label\":\"Glass\"},{\"value\":\"Large\",\"label\":\"Large\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Studios\",\"label\":\"Studios\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Vintage\",\"label\":\"Vintage\"},{\"value\":\"Bedside\",\"label\":\"Bedside\"},{\"value\":\"Mirrored\",\"label\":\"Mirrored\"},{\"value\":\"Dressers\",\"label\":\"Dressers\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Coaster\",\"label\":\"Coaster\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Nightstands\",\"label\":\"Nightstands\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Contemporary\",\"label\":\"Contemporary\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Dresser\",\"label\":\"Dresser\"},{\"value\":\"Stand\",\"label\":\"Stand\"},{\"value\":\"Silver\",\"label\":\"Silver\"},{\"value\":\"Walnut\",\"label\":\"Walnut\"},{\"value\":\"Bedrooms\",\"label\":\"Bedrooms\"},{\"value\":\"Mirror\",\"label\":\"Mirror\"}]}],\"categories\":[{\"id\":\"Nightstands\",\"slug\":\"nightstands\",\"nam