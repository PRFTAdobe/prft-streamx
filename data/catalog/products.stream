    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B076NNYB3P\",\"sku\":\"B076NNYB3P\",\"lang\":\"en\",\"slug\":\"dunbar-wood-dining-room-kitchen-table-78-l-oak-finish-b076nnyb3p\",\"name\":\"Dunbar Wood Dining Room Kitchen Table, 78&quot;L, Oak Finish\",\"description\":\"This handsome modern table combines a vintage distressed wood top with industrial-style legs. Simple, clean lines and beautiful quarter-sawn oak veneer finish make this piece look at home in rustic or modern settings. 78&quot;L x 40&quot;D x 30&quot;H Hardwood table top with quarter-sawn oak veneer A simple modern piece with rustic and industrial influences Free returns for 30 days. 3-year warranty. Assembly is required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Dunbar Wood Dining Room Kitchen Table, 78&quot;L, Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t8bLEIjJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91snKDwxhQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91snKDwxhQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iuxrSfeXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iuxrSfeXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZAsqzWvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tZAsqzWvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12oWr0Mi6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12oWr0Mi6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719KDdmBfbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719KDdmBfbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"