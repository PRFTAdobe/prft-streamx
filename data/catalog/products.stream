    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GZ675\",\"sku\":\"B07B4GZ675\",\"lang\":\"en\",\"slug\":\"rivet-berkshire-modern-living-room-accent-chair-37-w-grey-b07b4gz675\",\"name\":\"Rivet Berkshire Modern Living Room Accent Chair, 37&quot;W, Grey\",\"description\":\"Low-angled arms, deep seat cushions and lumbar pillows are hallmarks of this mid-century influenced design. Piping on the arms and slanted metal legs add additional visual interest to this chair, which is sure to be a conversation piece. 37&quot;W x 37&quot;D x 32.2&quot;H; Seat Height: 18.8&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 21.2&quot;H; Arm Height: 22&quot;H; Leg Height: 5.5&quot; Polyester fabric on sturdy wood frame; metal legs with nickel finish Clean lines, low-slung arms and metal legs are hallmarks of mid-century modern style In addition to being a comfortable chair, this is an eye-catching statement piece. Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Berkshire Modern Living Room Accent Chair, 37&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xyIi9q6iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LfCAh-kZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VeDv65yWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VeDv65yWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910JR9HdKLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910JR9HdKLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9167q3j-jZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9167q3j-jZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-