    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQ8QWK\",\"sku\":\"B075YQ8QWK\",\"lang\":\"en\",\"slug\":\"rivet-alfred-mid-century-modern-wide-curved-back-accent-kitchen-dining-room-chair-25-2-w-canary-yellow-b075yq8qwk\",\"name\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Canary Yellow\",\"description\":\"This classic mid-century modern accent chair features a wide curved back and armrest combined with simple tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 25.2W&quot; x 23.2&quot;D x x31.9&quot;H Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. Simple assembly; just attach legs. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Alfred Mid-Century Modern Wide Curved Back Accent Kitchen Dining Room Chair, 25.2&quot;W, Canary Yellow\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ln2qRuoPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PMVTgPuXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PMVTgPuXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kNuuWZuJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kNuuWZuJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g7cxSoumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1g7cxSoumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mb3Lq80bL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mb3Lq80bL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fhpUQmH8S.jpg\",\"url\":\"https://storage.googleapis.com/pu