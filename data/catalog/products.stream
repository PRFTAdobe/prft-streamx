    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G5YWH\",\"sku\":\"B07B4G5YWH\",\"lang\":\"en\",\"slug\":\"rivet-cyprus-mid-century-modern-sofa-couch-88-w-light-grey-b07b4g5ywh\",\"name\":\"Rivet Cyprus Mid-Century Modern Sofa Couch, 88&quot;W, Light Grey\",\"description\":\"This mid-century modern influenced design gets a 21st century update with denim fabric. The unique fold-over arms and back add comfort and softness along with a style twist. Metal legs polish off this casual statement piece. 88.1&quot;W x 34.6&quot;D x 29.2&quot;H; Seat Height: 17.3&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 20.4&quot;H; Arm Height: 29.2&quot;H; Leg Height: 9.3&quot;H Denim fabric is 85% cotton/15% polyester; cedar hardwood frame; metal legs with brass finish Mid-century modern gets a casual update with fold-over cushioning and denim fabric In addition to being a comfortable sofa, this is an eye-catching statement piece. Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cyprus Mid-Century Modern Sofa Couch, 88&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gGjUC1k5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y7TPZ6oWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91y7TPZ6oWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eV29sdm2S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1eV29sdm2S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916Z4wnaRML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916Z4wnaRML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1drbhRZvVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1drbhRZvVL.jpg\"},{\"alt\":\"https://storage.googleapis.