    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084MXFXJ2\",\"sku\":\"B084MXFXJ2\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-solid-wood-nightstand-with-2-drawers-25-5-w-charcoal-gray-b084mxfxj2\",\"name\":\"Modern Farmhouse Solid Wood Nightstand with 2 Drawers, 25.5&quot;W, Charcoal Gray\",\"description\":\"This exceptionally durable nightstand is made of solid wood and has 2 convenient drawers. It has a charcoal gray finish that accentuates the beauty of the natural wood grain. Made from recycled pine, this rustic nightstand goes well with farmhouse or contemporary decor. 25.5&quot;W x 17.75&quot;D x 23.5&quot;H; leg height: 7.75&quot;H Recycled pine; sturdy metal hardware Ball bearing metal glides on 2 drawers allow for ease of use. Made of recycled pine, each nightstand is unique and slightly different from the next. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Solid Wood Nightstand with 2 Drawers, 25.5&quot;W, Charcoal Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819GMLKPwQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BzA0dfyJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BzA0dfyJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MbhoMICcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MbhoMICcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OQTWBkSTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OQTWBkSTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mjQUtp-AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mjQUtp-AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xh3EwKrbL.jpg\",\"url\":\"https://st