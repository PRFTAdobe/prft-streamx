    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZQQPR\",\"sku\":\"B07B4ZQQPR\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-king-headboard-88-w-curious-indigo-b07b4zqqpr\",\"name\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Curious Indigo\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 88&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped King Headboard, 88&quot;W, Curious Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SJmBGy7ZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zmfSHbutL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zmfSHbutL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a+7cquewL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a+7cquewL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jfZ+L1k0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jfZ+L1k0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LPe-UkU1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LPe-UkU1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A112euHWNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A112euHWNML.jpg\"},{\"alt\":\"https://storage.googl