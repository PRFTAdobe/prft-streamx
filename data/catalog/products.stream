    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSBHY71\",\"sku\":\"B07HSBHY71\",\"lang\":\"en\",\"slug\":\"hartford-modern-denim-style-fabric-kitchen-counter-bar-stool-45-h-navy-blue-b07hsbhy71\",\"name\":\"Hartford Modern Denim-Style Fabric Kitchen Counter Bar Stool, 45&quot;H, Navy Blue\",\"description\":\"This classic Parsons-style barstool is understated enough for your farmhouse-style kitchen while still being at home in a formal modern dining room. Featuring a gorgeous easy-care navy fabric seat and back and a solid-wood frame, this comfortable cushioned stool is easily dressed up or down. Solid wood frame, silver metal kick plate and durable 100% polyester fabric Dust or wipe clean with a soft, dry cloth. Avoid abrasive cleaner. Keep indoors, away from direct sunlight, heat, or air conditioning. 18.5&quot;W x 21.5&quot;D x 45&quot;H. No assembly required. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hartford Modern Denim-Style Fabric Kitchen Counter Bar Stool, 45&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FondaEe6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71slksk6BhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71slksk6BhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AS3nCkoOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AS3nCkoOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ur7xP2q+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ur7xP2q+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19VqDC9q0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19VqDC9q0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GvPJVvdjL.jpg\",\"url\":\"https://storage.googleapis.com