    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5VCQ5\",\"sku\":\"B075X5VCQ5\",\"lang\":\"en\",\"slug\":\"westport-modern-nailhead-upholstered-loveseat-sofa-couch-61-5-w-stone-brown-b075x5vcq5\",\"name\":\"Westport Modern Nailhead Upholstered Loveseat Sofa Couch, 61.5&quot;W, Stone Brown\",\"description\":\"Elevate your style with this head-turning modern loveseat. A long down-blend bench seat is combined with back cushions that are reversible. Nailhead trim on the arms and across the sides, along with the exposed wood base, adds extra sophistication. 61.5&quot;W x 37.75''D x 33''H Durable polyester fabric; metal nailhead trim; wood legs. Removable, reversible back cushions. Corner clips keep bench seat firmly in place. No assembly required. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Westport Modern Nailhead Upholstered Loveseat Sofa Couch, 61.5&quot;W, Stone Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RZiao4JKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lqkOuP1AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lqkOuP1AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IpZ8xPpyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IpZ8xPpyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hDqtDxs-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hDqtDxs-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12DYCUapxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12DYCUapxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"61.5\",\"label\":\"inches\"}]},{\"name\