    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWL4BTP\",\"sku\":\"B07BWL4BTP\",\"lang\":\"en\",\"slug\":\"andover-modern-left-u-sectional-sofa-134-w-charcoal-b07bwl4btp\",\"name\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Charcoal\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Left U-Sectional Sofa, 134&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ask75T77L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G8PqaV9dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G8PqaV9dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14IUPML4xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14IUPML4xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WYyvcNANL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WYyvcNANL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qIl4lrLuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qIl4lrLuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AUNEVtYFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AUNEVtYFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/or