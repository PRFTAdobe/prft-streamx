    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2YB48B\",\"sku\":\"B07J2YB48B\",\"lang\":\"en\",\"slug\":\"rivet-abel-modern-contemporary-sofa-81-w-charcoal-b07j2yb48b\",\"name\":\"Rivet Abel Modern Contemporary Sofa, 81&quot;W, Charcoal\",\"description\":\"Upgrade your living room style with this striking contemporary sofa. The stitching all along the edges shows off this sofa’s construction quality, and the slim armrests and silver metal legs complete its sleek look. Overall: 81&quot;W x 34&quot;D x 31&quot;H; Seat Height: 17.71&quot;H; Seat Depth: 21.65&quot;D; Seat Back Height: 31&quot;H; Arm Height: 23.22:H; Leg Height: 5.91&quot;H Solid-wood frame with silver metal legs Slim arm with loose back cushion Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Abel Modern Contemporary Sofa, 81&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91csyxT4lCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yrFCdwpkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yrFCdwpkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CjLbkVJVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CjLbkVJVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pLPGF3-MS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pLPGF3-MS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XCugJdwHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XCugJdwHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A2UN3AlwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A2UN3AlwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vJiVk9f9L.jpg