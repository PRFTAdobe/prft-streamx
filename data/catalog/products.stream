    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X38PZ7\",\"sku\":\"B075X38PZ7\",\"lang\":\"en\",\"slug\":\"newport-nightstand-end-table-22-w-toffee-oak-b075x38pz7\",\"name\":\"Newport Nightstand End Table, 22&quot;W, Toffee Oak\",\"description\":\"22&quot;W x 16&quot;D x 24&quot;H Oak color-finished hardwood with black metal drawers and hardware Transitional style will work in any style bedroom. Drawers suspend on self-closing, ball-bearing extension guides No assembly needed. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. Keep your bedside tidy and stylish with this transitional nightstand, made of both metal and wood. The rivets around the perimeter of the black painted metal drawer give an industrial touch, and the open space underneath provides extra space for books.\",\"primaryImage\":{\"alt\":\"Newport Nightstand End Table, 22&quot;W, Toffee Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v0n0dyV9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14WaQB+KLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14WaQB+KLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FAjCTNRxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FAjCTNRxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+w0n7YirL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+w0n7YirL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qx-Muz91L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qx-Muz91L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A119hGrhp7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A119hGrhp7L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"24.0\",\