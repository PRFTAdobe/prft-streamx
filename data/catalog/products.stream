    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL46GB\",\"sku\":\"B07QDL46GB\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sectional-with-tapered-wood-legs-86-w-dark-grey-b07qdl46gb\",\"name\":\"Rivet Aiden Mid-Century Sectional with Tapered Wood Legs, 86&quot;W, Dark Grey\",\"description\":\"This sectional features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive gray fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 86&quot;W x 37&quot;D x 33&quot;H Solid hardwood frame with tapered wood legs Removable and reversible seat and back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sectional with Tapered Wood Legs, 86&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818vlfq1zbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ESTgbrItL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ESTgbrItL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gTrjdCdfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gTrjdCdfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71snxA2RV1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71snxA2RV1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-WDAVJHXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-WDAVJHXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JEqUboyKL.jpg\",\"url\":\"https://storage.googleapis.com/puresig