    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6BJVN\",\"sku\":\"B07HZ6BJVN\",\"lang\":\"en\",\"slug\":\"fischer-queen-sized-sleeper-sofa-79-w-linen-fabric-b07hz6bjvn\",\"name\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Linen Fabric\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this queen-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 79&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with stain-resistant fabric Clean lines and neutral color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Linen Fabric\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811Ya0mQK0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pMf2ODgXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pMf2ODgXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M9DtkVMDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M9DtkVMDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sAxjzFWoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sAxjzFWoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1b+zI2eOQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1b+zI2eOQS.jpg\"},{\"alt\":\"https://storage.goo