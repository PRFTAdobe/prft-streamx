    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085554J7Q\",\"sku\":\"B085554J7Q\",\"lang\":\"en\",\"slug\":\"rivet-henrik-modern-open-back-plastic-dining-chair-18-5-w-mild-gray-b085554j7q\",\"name\":\"Rivet Henrik Modern Open-Back Plastic Dining Chair, 18.5&quot;W, Mild Gray\",\"description\":\"This modern open-backed chair with its stylish European design easily complements many dining room tables. Its professional look makes it an excellent fit in an office or living room as well. Made of sturdy beech, steel, and plastic, it will last and adapt to any changes in the surrounding decor. Overall: 18.5&quot;W x 21.5&quot;D x 31.1&quot;H. Seat height: 18.1&quot;H; seat depth: 17.5&quot;D; seat back height: 15.3&quot;H; leg height: 16.3&quot;H Polypropylene, steel and beech wood This versatile, durable chair can be used alone or as part of a dining room set. An original piece by an Italian designer that complements many different table styles Clean with a damp, warm cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Henrik Modern Open-Back Plastic Dining Chair, 18.5&quot;W, Mild Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710YQZj4GkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fuc1CyviL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fuc1CyviL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HcYMVRpLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71HcYMVRpLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-lgO8ebeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61-lgO8ebeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iofbOkJiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iofbOkJiL.jpg\"},{\"alt\":\"https://storage.googlea