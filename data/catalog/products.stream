    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N1S1V\",\"sku\":\"B07B4N1S1V\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-accent-chair-34-w-blue-b07b4n1s1v\",\"name\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 34&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nc2XYN0aL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nVbHPYL0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nVbHPYL0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Dh7flAGLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Dh7flAGLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KJk7EbkeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KJk7EbkeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zHZFT0UYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zHZFT0UYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images