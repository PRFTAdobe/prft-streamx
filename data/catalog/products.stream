      "content": {
        "bytes": "{\"id\":\"B075X3SHX2\",\"sku\":\"B075X3SHX2\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-tufted-customizable-daybed-sofa-78-w-platinum-amp-black-b075x3shx2\",\"name\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Platinum &amp; Black\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and blackened pewter metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Platinum &amp; Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Wpib4MFJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10vyxEyMhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10vyxEyMhS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zGGpRGarL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zGGpRGarL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b21yvG-zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b21yvG-zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hv1EmUW9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hv1EmUW9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xnjY1kcrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xnjY1kcrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"27.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"137.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Silver\",\"label\":\"Silver\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Platinum\",\"label\":\"Platinum\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":338,\"discountedValue\":304.2}}"
