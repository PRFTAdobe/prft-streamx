    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB9GH\",\"sku\":\"B07QCMB9GH\",\"lang\":\"en\",\"slug\":\"abigail-ottoman-29-w-golden-brown-b07qcmb9gh\",\"name\":\"Abigail Ottoman, 29&quot;W, Golden Brown\",\"description\":\"Comfort meets class in this attractive transitional-style ottoman. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The seat cushions are reversible to prolong the life of this ottoman. 29&quot;W x 23&quot;D x 19&quot;H; seat height: 19&quot;H; seat depth: 23&quot;D; leg height: 1.5&quot;H Sturdy wood frame with life-friendly 83% olefin and 17% polyester performance fabric The ottoman is light and easy to move around your room for ideal comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Ottoman, 29&quot;W, Golden Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61a4nPUbZyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CaV8iWJdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71CaV8iWJdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z0SKEldeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z0SKEldeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Yb7iKTjPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Yb7iKTjPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1QquzKuKAS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"v