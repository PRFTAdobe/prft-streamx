    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MPVZG\",\"sku\":\"B07B4MPVZG\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-loveseat-65-w-charcoal-grey-b07b4mpvzg\",\"name\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Charcoal Grey\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 65&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Loveseat, 65&quot;W, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sX6V2c2DL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EAb3fZT+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EAb3fZT+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jCkbduNvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jCkbduNvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NHpf3nSvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NHpf3nSvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P6zn+zS2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P6zn+zS2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/pures