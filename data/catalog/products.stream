    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78RCT5\",\"sku\":\"B07B78RCT5\",\"lang\":\"en\",\"slug\":\"creston-modern-wood-dining-buffet-cabinet-credenza-storage-56-w-grey-b07b78rct5\",\"name\":\"Creston Modern Wood Dining Buffet, Cabinet Credenza, Storage, 56&quot;W, Grey\",\"description\":\"Distressed finish combined with clean, simple design makes this buffet ideal for a modern farmhouse décor. Removable shelves and dividers inside give you versatile storage options, while the three drawers are ideal for silverware and small items. 19&quot;L x 56&quot;W x 32&quot;H Hardwood made of poplar solids; oak veneer has distressed finish Ideal for a modern farmhouse décor Top drawer includes a removable utensil holder No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Creston Modern Wood Dining Buffet, Cabinet Credenza, Storage, 56&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EItSebJxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813Q6O+wL-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813Q6O+wL-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b55qQscTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1b55qQscTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OxAD2eCIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OxAD2eCIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFAALFiGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YFAALFiGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sExWq3A4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sExWq3A4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SSp