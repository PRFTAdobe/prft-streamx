        "bytes": "{\"id\":\"B085FGSHQH\",\"sku\":\"B085FGSHQH\",\"lang\":\"en\",\"slug\":\"ravenna-home-albert-power-lift-assist-recliner-chair-34-3-w-cream-b085fgshqh\",\"name\":\"Ravenna Home Albert Power-Lift Assist Recliner Chair, 34.3&quot;W, Cream\",\"description\":\"34.3&quot;W x 38.6&quot;D x 40.6&quot;H; seat height: 19.7&quot;H; seat depth: 22&quot;D Plywood frame with reclining mechanism and German motor with strong performance Reclining chair with a motor lift function that adjusts to whatever position you want Assemble in 15 minutes or less Indoor use only; avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty. Weight limit 300 lbs\",\"primaryImage\":{\"alt\":\"Ravenna Home Albert Power-Lift Assist Recliner Chair, 34.3&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VPJJcENIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fg+kA35aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fg+kA35aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h6kwy2JAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h6kwy2JAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815hc3+dN5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815hc3+dN5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A117jIOJz8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A117jIOJz8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yX+nuxL-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yX+nuxL-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q0nwZGAxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/