    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33RTB\",\"sku\":\"B075X33RTB\",\"lang\":\"en\",\"slug\":\"marin-leather-studded-chair-33-w-driftwood-b075x33rtb\",\"name\":\"Marin Leather Studded Chair, 33&quot;W, Driftwood\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with rich leather upholstery Removable and reversible back and seat cushion adds lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Rich leather and clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Leather Studded Chair, 33&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CFa0UQdHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10cop42YtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10cop42YtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818vVYMPhQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818vVYMPhQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RqRYCuubL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RqRYCuubL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inch