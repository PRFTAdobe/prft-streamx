    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4HZVX\",\"sku\":\"B075X4HZVX\",\"lang\":\"en\",\"slug\":\"elmore-pillow-top-armless-chair-24-w-cocoa-b075x4hzvx\",\"name\":\"Elmore Pillow-Top Armless Chair, 24&quot;W, Cocoa\",\"description\":\"This armless pillow-top chair will add comfort and elegance to any modern or classic style space. Assembled in the U.S., it features a sturdy wood frame, reversible seat and back cushions. Metal casters on the solid wood legs make it easy to move. This item is made to order just for you 24&quot;W x 33&quot;D x 35&quot;H Sturdy wood frame and legs; 100% cotton fabric. A transitional piece that will blend with most any décor Free returns for 30 days. 3-year warranty. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Elmore Pillow-Top Armless Chair, 24&quot;W, Cocoa\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-rm-iU4oL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tx26+DrEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tx26+DrEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XAiOkjDBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XAiOkjDBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GgEKELx5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GgEKELx5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xNF+qJF2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xNF+qJF2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rcXt6CArL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rcXt6CArL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]