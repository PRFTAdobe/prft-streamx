    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086KDBB6J\",\"sku\":\"B086KDBB6J\",\"lang\":\"en\",\"slug\":\"faux-linen-upholstered-square-stitched-platform-bed-mattress-foundation-easy-assembly-strong-wood-slat-support-navy-blue-full-b086kdbb6j\",\"name\":\"Faux-Linen Upholstered Square Stitched Platform Bed - Mattress Foundation - Easy Assembly - Strong Wood Slat Support-Navy Blue, Full\",\"description\":\"All-in-one platform bed with foundation and headboard Durable, stylish faux linen upholstery with diamond-stitched headboard No need for a box spring, simply place mattress on slatted foundation. The bed materials are 60% Upholstered, 30% plywood, 5% metal, 5% plastic. Strong wood slats can hold up to 150 pounds each; includes metal supports and 4 wood legs Sophisticated, simple mid-century modern design Easy assembly with all necessary components, hardware, and tools\",\"primaryImage\":{\"alt\":\"Faux-Linen Upholstered Square Stitched Platform Bed - Mattress Foundation - Easy Assembly - Strong Wood Slat Support-Navy Blue, Full\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QbMwidSeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816X9ngGaPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816X9ngGaPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NwOxXLiiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NwOxXLiiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915sUya9dCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915sUya9dCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+QnVqievL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+QnVqievL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tXE8pNi8L.jpg\",\"url\":\"https://storage