    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07CDRN3SP\",\"sku\":\"B07CDRN3SP\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-tufted-leather-sofa-couch-92-9-w-chestnut-brown-b07cdrn3sp\",\"name\":\"Bradbury Chesterfield Tufted Leather Sofa Couch, 92.9&quot;W, Chestnut Brown\",\"description\":\"Create a lounge-worthy living room with this modern chesterfield sofa. Rich brown leather upholstery, along with a high back and arms, invites you to curl up to read a good book or take a catnap. Dimensions: 92.9''W x 39”D x 30.3”H Engineered wood frame and 100% leather Modern and classic touches Restyled classic design with durable leather. Easy-to-attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Tufted Leather Sofa Couch, 92.9&quot;W, Chestnut Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hGC3uk5NL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cu+PDOYqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cu+PDOYqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zukeVUx7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zukeVUx7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cjaVLoYqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cjaVLoYqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o29ja-DDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o29ja-DDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71330LM9nBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71330LM9nBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bl4mtZMqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91