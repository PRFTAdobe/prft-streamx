    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QFCHLB\",\"sku\":\"B075QFCHLB\",\"lang\":\"en\",\"slug\":\"rivet-kyler-tufted-mid-century-upholstered-king-bed-with-headboard-81-75-l-charcoal-b075qfchlb\",\"name\":\"Rivet Kyler Tufted Mid-Century Upholstered King Bed with Headboard, 81.75&quot;L, Charcoal\",\"description\":\"This thoughtfully design bed will bring streamlined sophistication to your modern room. The headboard features simple tufting and a subtle wingback, while low-profile side rails and footboard complete the clean, simple profile. 88.2&quot;L x 81.75&quot;W x 45.3&quot;H Charcoal fabric Mid-century modern-inspired tufting and low-profile side rails and footboard; simple tapered legs Designed with room underneath for some storage. No boxspring required. Assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kyler Tufted Mid-Century Upholstered King Bed with Headboard, 81.75&quot;L, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z7s5G-E3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tBBNeDOlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tBBNeDOlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B143pYqY-WS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B143pYqY-WS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aSkHWcR7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aSkHWcR7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Eu4v2bxtS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Eu4v2bxtS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bJZAGsB0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bJZAGs