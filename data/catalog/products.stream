    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085Z42JHB\",\"sku\":\"B085Z42JHB\",\"lang\":\"en\",\"slug\":\"solimo-karina-solid-sheesham-wood-4-seater-dining-table-with-chairs-teak-finish-b085z42jhb\",\"name\":\"Solimo Karina Solid Sheesham Wood 4 Seater Dining Table with Chairs (Teak Finish)\",\"description\":\"Table Dimensions: Length (39 Inches), Width, (39 inches), Height (30 inches); Chair Dimensions: Length (17 Inches), Width, (16 inches), Height (35 inches) Material: Sheesham Solid Wood with a premium teak finish Table has undergone horizontal fatigue test of 15000 cycles and the chair has passed 50,000 cycles of back seat fatigue test The table has load bearing capacity of 100 kg to provide proper support The dining set is resistant to humidity, hot water and stains. The robust structure has undergone 15+ quality and safety tests; meets European safety requirement EN 12521 standard, density of wood 811 kg/cu.m Free from burrs & sharp edges for enhanced safety Made free from toxins or harmful chemicals to promise safe use\",\"primaryImage\":{\"alt\":\"Solimo Karina Solid Sheesham Wood 4 Seater Dining Table with Chairs (Teak Finish)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sRCAw6vML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LrFHz9TKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LrFHz9TKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iFPYQ9bFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iFPYQ9bFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gx8sClu8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61gx8sClu8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71v7ZHdY3VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71v7ZHdY3VL.jpg\"},{\"alt\"