    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082BLFMRC\",\"sku\":\"B082BLFMRC\",\"lang\":\"en\",\"slug\":\"rivet-celine-upholstered-home-office-task-chair-22-25-w-beige-b082blfmrc\",\"name\":\"Rivet Celine Upholstered Home Office Task Chair, 22.25&quot;W, Beige\",\"description\":\"Bring a touch of Scandinavian style to your home or office with this upholstered task chair. Subtly tufted beige fabric is paired with a clever wood grain-patterned vinyl backing, bucket seat and brass-finished base for a high comfort, low maintenance modern style. Overall: 22.25&quot;W x 26.25&quot;D x 35.75&quot;–38.75&quot;H; adjustable seat height: 19.75&quot;–22.75&quot; Upholstered chair in a neutral stone-colored fabric accented with blonde wood grain-patterned vinyl. This chair has a 360-degree swivel mechanism with height and tension adjustments to accommodate your work style. The tufted barrel-back design of this chair looks equally stylish in the office or in the living room as occasional seating. Assemble in 15-30 minutes Always use on firm, level ground. Do not stand on the seat or let children play with this chair. Check (and if necessary, tighten) all screws every 90 days. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Celine Upholstered Home Office Task Chair, 22.25&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MwVjZPrPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YzfnmJq8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YzfnmJq8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OAqsLuOCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OAqsLuOCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91REOu4BcWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91REOu4BcWL.jpg\"},{\"alt\":\"https://storag