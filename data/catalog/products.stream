        "bytes": "{\"id\":\"B07B4D499R\",\"sku\":\"B07B4D499R\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-82-w-light-blue-b07b4d499r\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Light Blue\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 82&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Polypropylene fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qYikOIuAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818OrrchgZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818OrrchgZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-TusSJc3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-TusSJc3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I53ZAn7BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I53ZAn7BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DNdQvvsmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DNdQvvsmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Os1O-baLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Os1O-baLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"82.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"43.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"22.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Light blue\",\"label\":\"Light blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":216,\"discountedValue\":194.4}}"
