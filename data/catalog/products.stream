    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2W39LG\",\"sku\":\"B07J2W39LG\",\"lang\":\"en\",\"slug\":\"grover-modern-living-room-accent-chair-30-w-cognac-leather-b07j2w39lg\",\"name\":\"Grover Modern Living Room Accent Chair, 30&quot;W, Cognac Leather\",\"description\":\"Add class to your home decor with this eye-catching accent chair. With its updated interpretation of modern style, this chair is perfect for transitional-themed rooms, and its rich cognac-colored leather upholstery will both complement and enhance your existing home decor. Overall: 30&quot;W x 32&quot;D x 30&quot;H; Seat Height: 17.72&quot;H; Seat Depth 22.04&quot;D; Seat Back Height: 30&quot;H; Arm Height: 22.83&quot;H; Leg Height: 5.51&quot;H Solid-wood frame with leather upholstery Sleek design also pairs well with vintage and mid-century-modern home decor. Foam cushions provide lasting comfort Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Grover Modern Living Room Accent Chair, 30&quot;W, Cognac Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MIPghqNIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t+ZjYeABL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t+ZjYeABL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Rc-l300JS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hvG0BqkPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hvG0BqkPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KWMJ2o-FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KWMJ2o-FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vc77iDG9L.jpg\",\"url\":\"https://st