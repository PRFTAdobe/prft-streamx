        "bytes": "{\"id\":\"B075X61W35\",\"sku\":\"B075X61W35\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-linen-b075x61w35\",\"name\":\"Leila Ottoman, 34&quot;W, Linen\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing makes cushion resilient This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and velvet upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Eh5mDJNhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z-ZVZtx3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Z-ZVZtx3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a8-vmlptL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1a8-vmlptL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p+PdQXMsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p+PdQXMsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919bCF29LzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919bCF29LzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1px7R9pIlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1px7R9pIlL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"v