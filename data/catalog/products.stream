    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073ZPDT1R\",\"sku\":\"B073ZPDT1R\",\"lang\":\"en\",\"slug\":\"kristin-chair-and-a-half-upholstered-sleeper-sofa-55-5-w-sand-b073zpdt1r\",\"name\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Sand\",\"description\":\"In addition to being a lovely accent piece for any room, this chair doubles as a pull-out twin bed perfect for hosting guests. Round arms and clean style give this chair modern and classic touches, allowing it to blend with most styles. 55.5&quot;W and 72&quot;D when unfolded into bed Solid hardwood and laminate wood frame; polyester/nylon performance fabric Modern casual Doubles as an accent chair and pull-out twin bed No assembly required Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Chair-and-a-Half Upholstered Sleeper Sofa, 55.5&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Bx-NCBqNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1hz8ful7TS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1hz8ful7TS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nPtOTW5sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nPtOTW5sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nWiOsgY5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nWiOsgY5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PkAHols3S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PkAHols3S.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"55.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"37.0\",\"label\":