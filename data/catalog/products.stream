    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VW5G\",\"sku\":\"B075X4VW5G\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-leather-ottoman-27-w-saddle-brown-b075x4vw5g\",\"name\":\"Rivet Lawson Modern Angled Leather Ottoman, 27&quot;W, Saddle Brown\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Nylon webbing supports the seat Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Leather Ottoman, 27&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qKHcCk7rL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UeqDYEuLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UeqDYEuLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WQHjch-8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WQHjch-8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CCjxEa8xL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CCjxEa8xL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"27.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Saddle brown\",\"label\":\"Saddle brown\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":789,\"discountedValue\":710.1}}"
