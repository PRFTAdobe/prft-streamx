    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KPWJV\",\"sku\":\"B0853KPWJV\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-counter-height-barstool-38-2-h-graphite-b0853kpwjv\",\"name\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Graphite\",\"description\":\"Powerful in its simplicity, this counter-height barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 38.2&quot;H; seat height: 26&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid wood frame with 100% polyester fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kJHshiAGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kXOgOOnVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kXOgOOnVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hmlatb7qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hmlatb7qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FhJNivD-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FhJNivD-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714sPGojopL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714sPGojopL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IZ62