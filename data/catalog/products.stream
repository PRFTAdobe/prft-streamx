    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085GXH8YR\",\"sku\":\"B085GXH8YR\",\"lang\":\"en\",\"slug\":\"cambridge-upholstered-recliner-rocking-chair-31-w-light-blue-b085gxh8yr\",\"name\":\"Cambridge Upholstered Recliner Rocking Chair, 31&quot;W, Light Blue\",\"description\":\"Light-blue upholstery offers a pop of color, making this piece a decor standout in addition to being a great place to relax. Rock or recline easily without worrying about noise or excessive wear and tear. The mechanisms make this chair’s motions smooth and quiet. 31&quot;W x 37&quot;D x 40&quot;H; seat height: 20&quot;H; seat back height: 40&quot;H; seat depth: 21&quot;D; arm height: 25&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. Upholstery fabric feels soft and plush to the touch but is also durable enough to pass rigorous seam-fatigue testing. Assemble in 15 minutes or less Clean only with dry cleaning solvent. Do not saturate. Do not use water. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Cambridge Upholstered Recliner Rocking Chair, 31&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uxsQ3y7sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZVS-oKKqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZVS-oKKqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wET+Rpk2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wET+Rpk2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917PNcs2zrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917PNcs2zrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Qe4HENYDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origi