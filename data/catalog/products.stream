      "content": {
        "bytes": "{\"id\":\"B072ZNBRR6\",\"sku\":\"B072ZNBRR6\",\"lang\":\"en\",\"slug\":\"rivet-industrial-metal-leg-tv-media-console-walnut-b072znbrr6\",\"name\":\"Rivet Industrial Metal Leg TV Media Console, Walnut\",\"description\":\"This industrial modern stand incorporates a wood base with metal legs. A long top will hold a wide screen TV and three compartments in the console can house other equipment. 70.9&quot;L x 15.7&quot;W x 17.5&quot;H Base is engineered wood with walnut veneer; legs are metal Industrial modern with classic walnut veneer Two drawers and one open compartment provide storage Easy assembly and care Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Metal Leg TV Media Console, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7199FCHaeiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912DYVBr7FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912DYVBr7FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E1VW2wDxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E1VW2wDxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mC17k3xML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mC17k3xML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wnw+eAoBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wnw+eAoBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VobwrTIRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VobwrTIRL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.5\",\"label\":\"inches