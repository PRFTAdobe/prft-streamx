    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D89MZ\",\"sku\":\"B07B4D89MZ\",\"lang\":\"en\",\"slug\":\"isabel-traditional-small-storage-ottoman-24-w-tan-b07b4d89mz\",\"name\":\"Isabel Traditional Small Storage Ottoman, 24&quot;W, Tan\",\"description\":\"22.4&quot;L x 24.4&quot;W x 18.9&quot;H Polyester performance fabric on wood frame Streamlined design fits a modern or transitional room Use as an ottoman, for storage, or as an extra seat. Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty. This ottoman is a multi-tasker, providing a comfy foot rest along with storage space. It can accommodate a tray of snacks or be an extra seat for guests, too. Built to last, its performance fabric will resist stains along with wear and tear.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Small Storage Ottoman, 24&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91syfrFLZUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qYi0drVCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qYi0drVCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916fm3sxyOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916fm3sxyOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eAZsPZwVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eAZsPZwVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MkWiwOkCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MkWiwOkCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PmW6V92CS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.5\",\"label\"