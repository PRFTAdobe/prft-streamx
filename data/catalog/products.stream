    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8PZ2P\",\"sku\":\"B07BW8PZ2P\",\"lang\":\"en\",\"slug\":\"andover-leather-left-facing-l-shaped-sectional-124-w-driftwood-b07bw8pz2p\",\"name\":\"Andover Leather Left-Facing L-Shaped Sectional, 124&quot;W, Driftwood\",\"description\":\"Complete your living space with this stylish sectional. With its driftwood-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 124&quot;W x 96&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Left-Facing L-Shaped Sectional, 124&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+Oc+yGkrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e-EuwDrhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71e-EuwDrhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cTKIRJaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cTKIRJaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jXiNTOGvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jXiNTOGvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ThY-a4WYL.jpg\",\"url\":\"https://storage.googleapis.co