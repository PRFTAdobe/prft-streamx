    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z9X4G2\",\"sku\":\"B075Z9X4G2\",\"lang\":\"en\",\"slug\":\"ferndale-rustic-2-drawer-console-coffee-table-63-w-espresso-b075z9x4g2\",\"name\":\"Ferndale Rustic 2-Drawer Console Coffee Table, 63&quot;W, Espresso\",\"description\":\"Made of solid reclaimed pine, this console table will add a warm rustic touch to your home's entryway, living room, or hallway. Knots and natural variations in the grain of the wood make each piece unique. Two drawers provide convenient storage. 63”W x 17”D x 30”H Durable, sustainably sourced solid pine Modern rustic, with weathered finish and metal drawer pulls Drawer provides a convenient place to store extra keys and phone chargers No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Ferndale Rustic 2-Drawer Console Coffee Table, 63&quot;W, Espresso\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G66pLtsrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W+J67R8iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91W+J67R8iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SMCAKHGRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SMCAKHGRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oKm6TKPHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oKm6TKPHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nxC+laAiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nxC+laAiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mi03QugnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mi03QugnL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\