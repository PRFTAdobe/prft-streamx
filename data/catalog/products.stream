    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071J7Q6KB\",\"sku\":\"B071J7Q6KB\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-sofa-bed-70-w-grey-weave-b071j7q6kb\",\"name\":\"Rivet Revolve Modern Upholstered Sofa Bed, 70&quot;W, Grey Weave\",\"description\":\"This modern sofa has enough classic elements to blend with your existing style. Plus, clean lines, comfortable seating and durable fabric give this piece functionality as well as smart design. When it's getting late, this piece transforms into a convenient sofa bed. 36.6&quot;D x 69.7”W x 35.4&quot;H Solid wood frame and solid beech wood legs Contemporary, streamlined design This piece does double duty as a couch and a bed Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Sofa Bed, 70&quot;W, Grey Weave\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914yVADx0kL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1koWANdp5S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1koWANdp5S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81c-2jmZC7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81c-2jmZC7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zNYUVA2vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zNYUVA2vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11I1mbAgcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11I1mbAgcL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"69.7\",\"labe