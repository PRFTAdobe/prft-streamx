        "bytes": "{\"id\":\"B07HZ6GDN1\",\"sku\":\"B07HZ6GDN1\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-sofa-chaise-fabric-41-w-stone-b07hz6gdn1\",\"name\":\"Bagley Sectional Component, Right-Facing Sofa Chaise, Fabric, 41&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing sofa chaise component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 41&quot;W x 87&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Sofa Chaise, Fabric, 41&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616G8PodZcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BdR+04udL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BdR+04udL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41Yy0q1LGWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41Yy0q1LGWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L8p6eVs0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L8p6eVs0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U92IToOQL.jpg\",\"url\":\"https://storag