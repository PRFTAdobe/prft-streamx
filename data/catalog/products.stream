    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSCBV\",\"sku\":\"B07QFRSCBV\",\"lang\":\"en\",\"slug\":\"classic-high-back-armless-barstool-43-h-set-of-2-black-b07qfrscbv\",\"name\":\"Classic High-Back Armless Barstool, 43&quot;H, Set of 2, Black\",\"description\":\"This set of 2 high-back barstools in a black finish touts a classic armless design in 100% rubberwood. The simple style adds to both modern and traditional decors. The hardwood’s durability protects the stools from daily wear and tear, and the well-constructed surface provides wanted comfort. 22.5&quot;Dx19&quot;Wx43&quot;H Solid rubberwood with a black finish and comfortable back These barstools are designed as simple modern pieces that can blend with traditional and modern styles. Simple assembly in less than 15 minutes Use a dampened, soft and clean cloth with water only. Wipe in the direction of the grain. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic High-Back Armless Barstool, 43&quot;H, Set of 2, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71t4uugq1NL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GI+wuA22L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GI+wuA22L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71egWfqMAKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71egWfqMAKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HMCydTNHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HMCydTNHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vI79UbhaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vI79UbhaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SP7SS4-iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SP7SS4-iL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"22.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"7.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"24\",\"label\":\"24\"},{\"value\":\"Products\",\"label\":\"Products\"},{\"value\":\"Seat\",\"label\":\"Seat\"},{\"value\":\"Backs\",\"label\":\"Backs\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Cambridge\",\"label\":\"Cambridge\"},{\"value\":\"Tractor\",\"label\":\"Tractor\"},{\"value\":\"Saddle\",\"label\":\"Saddle\"},{\"value\":\"Auto\",\"label\":\"Auto\"},{\"value\":\"Bancos\",\"label\":\"Bancos\"},{\"value\":\"Counter\",\"label\":\"Counter\"},{\"value\":\"30&quot;u201d\",\"label\":\"30&quot;u201d\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Inches\",\"label\":\"Inches\"},{\"value\":\"Height\",\"label\":\"Height\"},{\"value\":\"Dining\",\"label\":\"Dining\"},{\"value\":\"High\",\"label\":\"High\"},{\"value\":\"24&quot;\",\"label\":\"24&quot;\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Barstool\",\"label\":\"Barstool\"},{\"value\":\"Safavieh\",\"label\":\"Safavieh\"},{\"value\":\"30&quot;\",\"label\":\"30&quot;\"},{\"value\":\"Angel\",\"label\":\"Angel\"},{\"value\":\"Tools\",\"label\":\"Tools\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Tall\",\"label\":\"Tall\"},{\"value\