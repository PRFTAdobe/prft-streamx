    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084T7MQB4\",\"sku\":\"B084T7MQB4\",\"lang\":\"en\",\"slug\":\"classic-wishbone-dining-chair-22-4-w-white-natural-b084t7mqb4\",\"name\":\"Classic Wishbone Dining Chair, 22.4&quot;W, White / Natural\",\"description\":\"This dining chair combines Mid-Century modern and Scandinavian-inspired styles for beautiful form, function and comfort. With a woven rattan seat, solid beech wood frame and partially open-back this piece works for the dining room or anywhere you need extra seating. 22.4&quot;W x 22.8&quot;D x 28.75&quot;H. Seat height: 18&quot; Solid beech wood frame with a woven paper rattan seat. This versatile, transitional chair blends well with traditional and modern styles. No assembly required. Avoid moisture. Wipe away dust and debris with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Wishbone Dining Chair, 22.4&quot;W, White / Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61acRVVmexL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810ZC5Pt2NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810ZC5Pt2NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61b4dtHUqjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61b4dtHUqjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61q8ofSAU5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61q8ofSAU5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81c9MJT9p7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81c9MJT9p7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AxYc++9oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AxYc++9oL.jpg\"},{\"alt\":\"https://storage