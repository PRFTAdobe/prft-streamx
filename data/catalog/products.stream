    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33SQ9\",\"sku\":\"B075X33SQ9\",\"lang\":\"en\",\"slug\":\"leila-tufted-living-room-loveseat-sofa-couch-69-w-ink-blue-b075x33sq9\",\"name\":\"Leila Tufted Living Room Loveseat Sofa Couch, 69&quot;W, Ink Blue\",\"description\":\"This item is made to order just for you 69&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look loveseat. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Two removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Living Room Loveseat Sofa Couch, 69&quot;W, Ink Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FhumSZgaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w5tSV+x7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81w5tSV+x7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FNfp1OKZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FNfp1OKZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsHG3alBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PsHG3alBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A179yM7qOVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"69.0\",\"label\":\"inches\"}]},{\"