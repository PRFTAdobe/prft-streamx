    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSKSN5C\",\"sku\":\"B07HSKSN5C\",\"lang\":\"en\",\"slug\":\"rivet-roxmere-modern-storage-office-computer-desk-39-4-w-sandblast-gray-b07hsksn5c\",\"name\":\"Rivet Roxmere Modern Storage Office Computer Desk, 39.4&quot;W, Sandblast Gray\",\"description\":\"Complete your interior design with this beautiful modern-style desk, made from solid acacia with a sandblast-gray finish that nicely complements most home-décor themes. With 2 drawers, a desktop, and 2 sliding cabinet doors, this desk will add both style and organization to your room. 39.4&quot;W x 19.7&quot;D x 70.9&quot;H Solid acacia with MDF acacia veneer Modern styling that also blends well with rustic- and contemporary-style home décor This desk has 2 drawers and 2 sliding cabinet doors for maximum organization options. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Roxmere Modern Storage Office Computer Desk, 39.4&quot;W, Sandblast Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wBbXF827L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Eqie4k3dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Eqie4k3dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uhzwNblEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uhzwNblEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7JmlRTFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7JmlRTFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZZuzlRZvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZZuzlRZvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rZl1x1vSL.jpg\",\"ur