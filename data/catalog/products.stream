    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P7NTK44\",\"sku\":\"B07P7NTK44\",\"lang\":\"en\",\"slug\":\"leila-tufted-leather-armchair-44-w-sod-b07p7ntk44\",\"name\":\"Leila Tufted Leather Armchair, 44&quot;W, Sod\",\"description\":\"Vintage design and chic leather upholstery combine in this piece, making it the perfect fit for modern and classic decor schemes. Foam-padded cushions and solid wood legs ensure that this armchair is functional and comfortable as well as a stylish addition to any lounge area. 44&quot;W x 36&quot;D x 31&quot; Sturdy wood frame and solid wood legs in a dark walnut finish with rich 100% top-grain leather. Foam cushions provide lasting support and comfort. Treat yourself to luxury with this striking vintage-look armchair. The classic upholstery and solid wood legs in an espresso finish exude opulence. Rich leather upholstery adds sophistication and comfort to any space. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Leather Armchair, 44&quot;W, Sod\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/618E6WYIpvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71m7S8cFiTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71m7S8cFiTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61hKxjMlxaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61hKxjMlxaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fdBAb4U5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fdBAb4U5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IRh8EebjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IRh8EebjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi