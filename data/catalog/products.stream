    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7TKQH\",\"sku\":\"B07HZ7TKQH\",\"lang\":\"en\",\"slug\":\"blaine-modern-sofa-couch-79-5-w-beige-b07hz7tkqh\",\"name\":\"Blaine Modern Sofa Couch, 79.5&quot;W, Beige\",\"description\":\"Add mid-century elegance to your living room with this beige sofa. The solid-wood frame and polyester upholstery make this sofa both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 79.5&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 22&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you\",\"primaryImage\":{\"alt\":\"Blaine Modern Sofa Couch, 79.5&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BOYIdV79L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9164t1P0ZLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9164t1P0ZLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wfa8UGuXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wfa8UGuXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-VRaid1rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-VRaid1rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814qysN6U2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814qysN6U2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jA8bzZt+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jA8bzZt+L.jpg\"}],\"a