      "content": {
        "bytes": "{\"id\":\"B075X543RT\",\"sku\":\"B075X543RT\",\"lang\":\"en\",\"slug\":\"leila-tufted-living-room-loveseat-sofa-couch-69-w-sandstone-b075x543rt\",\"name\":\"Leila Tufted Living Room Loveseat Sofa Couch, 69&quot;W, Sandstone\",\"description\":\"This item is made to order just for you 69&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushions ensure durability and comfort. Treat yourself to luxury in this striking, vintage look loveseat. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. Two removable/reversible seat cushions ensure many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Living Room Loveseat Sofa Couch, 69&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y2unjSxML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sCPwCzoLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sCPwCzoLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91339gtpP0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91339gtpP0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ASKtdwfXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ASKtdwfXL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"69.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"125.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Beige\",\"label\":\"Beige\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"69&quot; sofa\",\"label\":\"69&quot; sofa\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Sandstone\",\"label\":\"Sandstone\"}]}],\"categories\":[{\"id\":\"Accent Furniture\",\"slug\":\"accent-furniture\",\"name\":\"Accent Furniture\",\"value\":\"Accent Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":796,\"discountedValue\":716.4}}"
