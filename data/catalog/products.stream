        "bytes": "{\"id\":\"B084ZBD4W8\",\"sku\":\"B084ZBD4W8\",\"lang\":\"en\",\"slug\":\"rustic-solid-pine-bed-with-headboard-queen-65-91-w-gray-b084zbd4w8\",\"name\":\"Rustic Solid Pine Bed with Headboard, Queen, 65.91&quot;W, Gray\",\"description\":\"This traditional bed complete with headboard has true rustic charm. Perfect for any bedroom in your home, this pine bed can stand alone as a centerpiece or blend with your existing furniture, adding a touch of welcome serenity. 65.91&quot;W x 84.06&quot;D x 49.02&quot;H Made of pine, plywood, and metal This bed needs no box spring. This rustic design is made with natural reclaimed wood in a gray finish. Assemble in 15-30 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rustic Solid Pine Bed with Headboard, Queen, 65.91&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51PENijr6-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ujfWDBJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ujfWDBJmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eqPJ0nguL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71eqPJ0nguL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oGdXCqCRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61oGdXCqCRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K8VTfo-uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61K8VTfo-uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51zc2RcZFDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51zc2RcZFDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"49