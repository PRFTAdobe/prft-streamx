    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD1HY4\",\"sku\":\"B082QD1HY4\",\"lang\":\"en\",\"slug\":\"rivet-ross-modern-vegan-faux-leather-lift-top-storage-ottoman-pouf-17-7-w-grey-b082qd1hy4\",\"name\":\"Rivet Ross Modern Vegan Faux Leather Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Grey\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila—it's an extra tray for snacks! An ottoman couldn't be more clever and multitasking than this. 17.7&quot;W x 17.7&quot;D x 18.1&quot;H Compact and stable with wood-frame construction and vegan leather exterior Handy anywhere you need an extra place to sit, set things down, or store clutter. Modern styling perfect for your contemporary home. Simple assembly in 15 minutes or less. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ross Modern Vegan Faux Leather Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SiKv1jAyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819BKnQ9xuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819BKnQ9xuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bV7NZu2aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bV7NZu2aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K6gXcr5YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K6gXcr5YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Lli1N7FpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Lli1N7FpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Vp2qPtglL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81