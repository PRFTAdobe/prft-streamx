    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2T4QR\",\"sku\":\"B084W2T4QR\",\"lang\":\"en\",\"slug\":\"reinhart-classic-upholstered-dining-chair-39-h-set-of-2-cadet-blue-b084w2t4qr\",\"name\":\"Reinhart Classic Upholstered Dining Chair, 39&quot;H, Set of 2, Cadet Blue\",\"description\":\"This set of two classically styled armless upholstered dining chairs are perfect for a vintage-look dining room or upscale kitchen. The gently curved high backs of these cadet-blue chairs suggest luxury as well as practicality, and the tapering legs are as supportive as they are lovely. 20.5&quot;W x 26&quot;D x 39&quot;H; seat height: 18.9&quot;H; seat depth: 18.1&quot;D; seat back height: 22.5&quot;H; leg height: 16.5&quot;H The solid wood frame is upholstered in a polyester, rayon, linen blend fabric. The classic style of these chairs makes theme equally suited to modern or traditional decor. Classic high-back dining chair has a transitional look. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Reinhart Classic Upholstered Dining Chair, 39&quot;H, Set of 2, Cadet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fk+ANxvNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Wm4+i3DXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Wm4+i3DXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WVSnZl-lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WVSnZl-lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W8QjPQWjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W8QjPQWjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ztMqHVrYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ztMqHVrYL