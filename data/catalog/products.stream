      "content": {
        "bytes": "{\"id\":\"B075X4PT6K\",\"sku\":\"B075X4PT6K\",\"lang\":\"en\",\"slug\":\"marin-studded-chair-33-w-charcoal-b075x4pt6k\",\"name\":\"Marin Studded Chair, 33&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 33&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional chair turning heads. The loose back and plush seat cushion, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Chair, 33&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hHvqSilyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ncb3FR14S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Ncb3FR14S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uEhAkbazL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uEhAkbazL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GwFNMPGpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GwFNMPGpL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\