    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D6PFP\",\"sku\":\"B07B4D6PFP\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-chaise-sofa-sectional-115-w-hunter-green-b07b4d6pfp\",\"name\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Hunter Green\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right Chaise Sofa Sectional, 115&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GX6HXALTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N+CEcLyvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N+CEcLyvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ctMBI5KeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ctMBI5KeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Vbv2yxfaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Vbv2yxfaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16x7tRVFNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16x7tRVFNL.jpg\"},{\"alt\":\"https://storage