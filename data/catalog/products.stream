    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STHJC\",\"sku\":\"B07P8STHJC\",\"lang\":\"en\",\"slug\":\"leila-tufted-leather-loveseat-sofa-69-w-sod-b07p8sthjc\",\"name\":\"Leila Tufted Leather Loveseat Sofa, 69&quot;W, Sod\",\"description\":\"Vintage design and chic leather upholstery combine in this piece, making it the perfect fit for modern and classic decor schemes. Foam-padded cushions and solid wood legs ensure that this loveseat is functional and comfortable as well as a stylish addition to any lounge area. 69&quot;W x 36&quot;D x 31&quot; Sturdy wood frame and solid wood legs in a dark walnut finish with rich 100% top-grain leather. Foam cushions provide lasting support and comfort. Treat yourself to luxury with this striking vintage-look loveseat. The classic upholstery and solid wood legs in an espresso finish exude opulence. Rich leather upholstery adds sophistication and comfort to any space. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Leather Loveseat Sofa, 69&quot;W, Sod\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rSqT-OhYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71a4ePbZzDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71a4ePbZzDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DtxlREPkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DtxlREPkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fbE1B1L9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fbE1B1L9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fdBAb4U5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fdBAb4U5L.jpg\"},{\"alt\":\"https://storage.google