    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L358V\",\"sku\":\"B0853L358V\",\"lang\":\"en\",\"slug\":\"rivet-lundberg-contemporary-upholstered-counter-height-barstool-with-brass-legs-40-6-h-graphite-b0853l358v\",\"name\":\"Rivet Lundberg Contemporary Upholstered Counter-Height Barstool with Brass Legs, 40.6&quot;H, Graphite\",\"description\":\"Comfort and style meet in this modern counter-height barstool. Feather-filled cushions and open sides provide maximum comfort, while the graphite-colored upholstery and brass legs display a spare, contemporary style. These barstools coordinate well with any modern interior decor. 18.1&quot;W x 22.4&quot;D x 40.6&quot;H; seat height: 26&quot;H; seat depth: 12.6&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid wood frame; feather-filled upholstered cushions; brass base Classic brass legs and footrest, plus the open sides, allow for maximum freedom of movement. Feather-filled cushion provides comfort and a contemporary look at the same time. Classic brass metal base has a footrest for added stability. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Lundberg Contemporary Upholstered Counter-Height Barstool with Brass Legs, 40.6&quot;H, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815BloQ0k4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81py7Kt4EhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81py7Kt4EhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Uju2tOh-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Uju2tOh-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zb1mbSWDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zb1mbSWDL.jpg\"},{\"alt\":\"https://storage.