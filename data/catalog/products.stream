    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VWKL\",\"sku\":\"B075X4VWKL\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-accent-chair-32-w-steel-b075x4vwkl\",\"name\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Steel\",\"description\":\"A straight back and sloping, low-profile arms are the highlights of this mid-century inspired chair. Assembled in the U.S., it features a sturdy wood frame upholstered with durable, tightly woven fabric for a handsome design that's built to last. This item is made to order just for you 32&quot;W x 33&quot;D x 38&quot;H. Seat height is 19&quot;. Sturdy wood frame, durable polyester fabric, wood legs with walnut finish A Mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Steel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tX3NpIMyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17zC-BjdyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17zC-BjdyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X7n7vQW5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X7n7vQW5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1N7joocdHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1N7joocdHS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DvzCKA5rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DvzCKA5rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fVIQ3J+YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fVIQ3J+YL.jpg\"}],\"attributes\":