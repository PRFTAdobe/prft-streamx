    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2VY555\",\"sku\":\"B07J2VY555\",\"lang\":\"en\",\"slug\":\"rivet-coen-contemporary-modern-upholstered-accent-swivel-chair-30-w-charcoal-b07j2vy555\",\"name\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Charcoal\",\"description\":\"Add the finishing touch to your home decor with this contemporary-style accent chair. Its unique design adds interest to any room, and its beautiful dark grey fabric blends well with most home-decor themes. With a swivel feature, this chair is as comfortable as it is stylish. Overall: 30&quot;W x 31&quot;D x 28&quot;H; seat height: 16.93&quot;H; seat depth: 22.83&quot;D; seat back height: 28&quot;H; arm height: 25.19&quot;H Solid-wood frame with swivel mechanism. 100% polyester cover over foam cushioning. Clean-cut contemporary style complements modern, minimal, and urban-modern home decor. No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Coen Contemporary Modern Upholstered Accent Swivel Chair, 30&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13N2tADZGL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10RHRapKSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10RHRapKSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91srFzgDCrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91srFzgDCrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TdFk9Yt9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TdFk9Yt9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zb1mbSWDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zb1mbSWDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A