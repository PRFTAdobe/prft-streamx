    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFRSJBV\",\"sku\":\"B07QFRSJBV\",\"lang\":\"en\",\"slug\":\"alaina-contemporary-high-back-swivel-seat-barstool-43-h-beige-b07qfrsjbv\",\"name\":\"Alaina Contemporary High-Back, Swivel Seat Barstool, 43&quot;H, Beige\",\"description\":\"Enjoy the ease of sitting down and changing direction on the comfortable swivel seat of this high-back beige barstool. The solid hardwood frame and moisture-repellent fabric with stain resistance are durable and keep the stool looking like new, while the transitional style fits with any decor. 19&quot;W x 22&quot;D x 43&quot;H 95% polyester, 5% nylon on a solid hardwood frame Moisture-repellent and stain-resistant fabric help keep this high-back barstool looking like new. The transitional style and swivel seat of this barstool make it a great fit for any home or business. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Contemporary High-Back, Swivel Seat Barstool, 43&quot;H, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7150-rpr4qL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81biU1sokJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81biU1sokJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PERyFgesL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PERyFgesL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZZZfcwxbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZZZfcwxbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+aA76bKPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+aA76bKPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7194zzaB3KL.jpg\",