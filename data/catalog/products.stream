    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X5HBJ9\",\"sku\":\"B075X5HBJ9\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-oversized-upholstered-square-ottoman-38-w-gold-leaf-b075x5hbj9\",\"name\":\"Rivet mid-Century Modern Oversized Upholstered Square Ottoman, 38&quot;W, Gold Leaf\",\"description\":\"This oversized square ottoman works well as a coffee table or a place to rest your tired feet after a busy day. Tall exposed wood legs and welted edging on the durable upholstery give it a clean, tailored look. Available in a range of fabric options. This item is made to order just for you 38&quot;W x 38&quot;D x 16&quot;H Solid hardwood frame, wood legs with a walnut finish and 100% polyester fabric Sturdy enough for use as a coffee table or extra seating Simple leg assembly. Vacuum or wipe with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet mid-Century Modern Oversized Upholstered Square Ottoman, 38&quot;W, Gold Leaf\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9167DX66S9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Rxzyqq4iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Rxzyqq4iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16G6znCbtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16G6znCbtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sKS0DP2TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sKS0DP2TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914-KRQywbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914-KRQywbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value