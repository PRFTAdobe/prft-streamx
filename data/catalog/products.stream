    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCY5RF\",\"sku\":\"B082QCY5RF\",\"lang\":\"en\",\"slug\":\"rivet-bayard-contemporary-upholstered-couch-with-curved-back-and-armrests-76-w-dark-grey-b082qcy5rf\",\"name\":\"Rivet Bayard Contemporary Upholstered Couch with Curved Back and Armrests, 76&quot;W, Dark Grey\",\"description\":\"Tapered legs, a rounded back and armrests, and a chic dark-gray upholstery give this couch a contemporary feel, but this design is classic enough to blend with any decor. A solid wood frame and foam padding in the cushions make it a sturdy and comfortable place to relax. 76.0&quot;W x 34.3&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 21.2&quot;D; seat back height: 16.53&quot;H; arm height: 24.8&quot;H; leg height: 8.27&quot;H Solid wood frame; polyester, linen, and rayon upholstery This couch combines chic, contemporary design elements in a classic structure, making it the perfect fit wherever you need seating. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bayard Contemporary Upholstered Couch with Curved Back and Armrests, 76&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Vy7Pn0TzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zgPOUFTCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zgPOUFTCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819z3wxwO+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819z3wxwO+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pBuPITHOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pBuPITHOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81EutsUA4iL.jpg\",\"url\":\"https://storage.googleapis.