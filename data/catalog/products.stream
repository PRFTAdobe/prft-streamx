    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNQSVF\",\"sku\":\"B07QDNQSVF\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-square-back-armless-dining-chair-34-h-felt-gray-set-of-2-queen-b07qdnqsvf\",\"name\":\"Rivet Contemporary Square-Back Armless Dining Chair, 34&quot;H, Felt Gray, Set of 2, Queen\",\"description\":\"The felt-gray upholstery, armless structure, and clean-line design combine to make this a modern chair that will fit into nearly any dining area’s color scheme and decor. Polished, tapered wood legs lend elegance to the piece and combine with a solid wood frame for a sturdy framework. 18&quot;W x 22&quot;D x 34&quot;H; seat height: 19&quot;H; seat depth: 16&quot;H; seat back height: 15&quot;H Set of 2 100% polyester fabric on solid wood frame Elegant chair with polished and tapered legs No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Square-Back Armless Dining Chair, 34&quot;H, Felt Gray, Set of 2, Queen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812nwjaqutL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IzBV8Q+QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IzBV8Q+QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LwwjNa46L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LwwjNa46L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81l+bjTjtXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81l+bjTjtXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BcT3Bp-sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BcT3Bp-sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage