    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2X98K\",\"sku\":\"B084W2X98K\",\"lang\":\"en\",\"slug\":\"elise-upholstered-barstool-42-5-h-hemp-b084w2x98k\",\"name\":\"Elise Upholstered Barstool, 42.5&quot;H, Hemp\",\"description\":\"This hemp-colored rectangular barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 42.5&quot;H; seat height: 29.9&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 25.2&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric Footrest with kickplate for stability and durability, with padded seat and back for comfort. Low profile mid-century inspired barstool Arrives fully assembled. Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Barstool, 42.5&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q1gR4KH-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Zxou1QA+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Zxou1QA+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wgr8GreGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wgr8GreGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ibamY+DiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ibamY+DiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEdCUfxcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LEdCUfxcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q7P1unsgL.jpg\",\"url\":\"https://storage.googleapis