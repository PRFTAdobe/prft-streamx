    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X3WD5T\",\"sku\":\"B075X3WD5T\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-leonard-2-tone-nightstand-table-22-w-walnut-birch-finish-b075x3wd5t\",\"name\":\"Rivet Mid-Century Modern Leonard 2-Tone Nightstand Table, 22&quot;W, Walnut, Birch Finish\",\"description\":\"This mid-century modern nightstand will add handsome style with two drawers for storage. Walnut veneer on the front and darker birch finish on the top and sides gives it a two-tone effect accented by brass pulls. 22&quot;W x 16&quot;D x 24&quot;H Solid hardware with walnut and birch veneers, brass drawer pulls Mid-century with touches of glam and industrial to blend with modern-style rooms Drawers have concealed slow-close glides underneath for a sleek design. Simple assembly in 15 minutes. Just add legs. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Leonard 2-Tone Nightstand Table, 22&quot;W, Walnut, Birch Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MCmA39OxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EqtRgZ90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EqtRgZ90L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A159Kd9VEDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A159Kd9VEDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Aikxrw0KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Aikxrw0KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Xb7Bm7QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Xb7Bm7QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eAuaSU+tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/