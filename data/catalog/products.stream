        "bytes": "{\"id\":\"B073GC43LG\",\"sku\":\"B073GC43LG\",\"lang\":\"en\",\"slug\":\"truve-modern-studded-ottoman-19-w-sea-blue-b073gc43lg\",\"name\":\"Truve Modern Studded Ottoman, 19&quot;W, Sea Blue\",\"description\":\"This beautifully styled ottoman also serves as extra storage space. Its unique curved edges, covered in polyester fabric and accentuated with brass nail-head trim, bring character and class to any room. 19&quot;W x 17&quot;D x 19&quot;H Strong wood frame with durable polyester upholstery Casual and functional Provides stylish storage No assembly required Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Truve Modern Studded Ottoman, 19&quot;W, Sea Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+WLgKr3LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PwvLrWPwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PwvLrWPwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lDRNH4AHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lDRNH4AHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1suARXMmuS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1suARXMmuS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bJKaWptiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bJKaWptiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nh207zCeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nh207zCeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\