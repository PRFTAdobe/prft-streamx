    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085GXH67Y\",\"sku\":\"B085GXH67Y\",\"lang\":\"en\",\"slug\":\"primrose-upholstered-recliner-rocking-chair-with-swivel-33-w-mocha-brown-b085gxh67y\",\"name\":\"Primrose Upholstered Recliner Rocking Chair with Swivel, 33&quot;W, Mocha Brown\",\"description\":\"Move easily in this comfortable reclining chair. A swivel base allows you to turn from side to side, while durable mechanisms enable you to recline and rock with seamless motion. Deep mocha-brown upholstery means this chair will complement any room. 33&quot;W x 42&quot;D x 42&quot;H; seat height: 21&quot;H; seat back height: 42&quot;H; seat depth: 22&quot;D; arm height: 26&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. A sturdy wood frame under plush cushions provides a solid base for this chair’s classic shape, creating a winning combination of design and comfort. Assemble in 15 minutes or less Clean only with dry cleaning solvent. Do not saturate. Do not use water. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Primrose Upholstered Recliner Rocking Chair with Swivel, 33&quot;W, Mocha Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E-bgFXpWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GcppQ+upL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GcppQ+upL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zT8eL3QQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zT8eL3QQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8198FjcSfEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8198FjcSfEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AwVPj8unL.jpg\",\"url\":\"http