    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQ4778\",\"sku\":\"B075YQ4778\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-kitchen-dining-room-accent-chair-33-h-felt-grey-b075yq4778\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Felt Grey\",\"description\":\"Dimensions: 22.8&quot;W x 22.1&quot;D x 33.1&quot;H | Seat Height is 18.5&quot; A cut-out back and tapered legs give this accent chair a classic mid-century modern design. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KO7a5LlwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D5x0kIaZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D5x0kIaZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WMaXD0ytL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WMaXD0ytL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m+Fx2dQQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m+Fx2dQQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bzlVhDjfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bzlVhDjf