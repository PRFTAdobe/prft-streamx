    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N4W9\",\"sku\":\"B075X4N4W9\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-velvet-tufted-customizable-daybed-sofa-78-w-shadow-amp-silver-b075x4n4w9\",\"name\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Shadow &amp; Silver\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and silver metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Shadow &amp; Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Z8ICQ9dUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19-w0CGRCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19-w0CGRCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PkzP4HtwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PkzP4HtwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bnVTqvImL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bnVTqvImL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14xsvFIxDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14xsvFIxDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xtP7dISeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-