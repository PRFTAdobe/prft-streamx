    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZRKLXL\",\"sku\":\"B07TZRKLXL\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-kitchen-dining-room-accent-chair-33-h-chalk-b07tzrklxl\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Chalk\",\"description\":\"Dimensions: 22.8&quot;W x 22.1&quot;D x 33.1&quot;H | Seat Height is 18.5&quot; A cut-out back and tapered legs give this accent chair a classic mid-century modern design. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. Fabric is 100% polyester. Hardwood legs with espresso finish. Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Kitchen Dining Room Accent Chair, 33&quot;H, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pPEz1hmXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kc41LVSNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kc41LVSNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yt6cI5r4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yt6cI5r4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oVdjfmIuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oVdjfmIuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818xKVT7V+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818xKVT7V+L.jpg\"}],\"