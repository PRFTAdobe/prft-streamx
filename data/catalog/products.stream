    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073G965TS\",\"sku\":\"B073G965TS\",\"lang\":\"en\",\"slug\":\"modern-sweeping-arm-settee-51-w-oxford-stripe-charcoal-b073g965ts\",\"name\":\"Modern Sweeping Arm Settee, 51&quot;W, Oxford Stripe Charcoal\",\"description\":\"This graceful settee will make a pleasing addition to any style of room. A soft sweep of the arms and clean lines make it modern, but linen-look fabric and turned wood-look legs with espresso-colored stain give it a classic look as well. 51”W x 29”D x 35”H Solid pine with linen/cotton fabric Modern with classic touches Will blend with classic and transitional style rooms 4 easy-to-attach legs Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Sweeping Arm Settee, 51&quot;W, Oxford Stripe Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-kElsBa7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q94lwRQHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q94lwRQHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wcyi7Mu9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wcyi7Mu9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mrG+I3klS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mrG+I3klS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1R1yYBUJFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1R1yYBUJFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZcaizuhPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZcaizuhPL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\"