    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X43FJG\",\"sku\":\"B075X43FJG\",\"lang\":\"en\",\"slug\":\"marin-studded-sofa-87-w-linen-b075x43fjg\",\"name\":\"Marin Studded Sofa, 87&quot;W, Linen\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with 80% cotton/20% polyester upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Sofa, 87&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PTpYPpHwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0TVP4-SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0TVP4-SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t8oimb+0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t8oimb+0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14DWk+v2rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14DWk+v2rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cDqWYoJbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cDqWYoJbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Wei