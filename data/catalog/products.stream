    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568W87M\",\"sku\":\"B08568W87M\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-faux-leather-dining-chair-21-w-set-of-2-tan-brown-b08568w87m\",\"name\":\"Rivet Decatur Modern Faux Leather Dining Chair, 21&quot;W, Set of 2, Tan Brown\",\"description\":\"This set of 2 beautiful modern dining chairs feature a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, channel-tufted armless seat in durable faux leather. Overall: 20.5&quot;W x 25&quot;D x 36.6&quot;H. Seat height: 19.3&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Faux Leather Dining Chair, 21&quot;W, Set of 2, Tan Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71b7xak4i0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81et8GbqfPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81et8GbqfPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OHZ09r3oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OHZ09r3oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bvNtKrdsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61bvNtKrdsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SgFW2yeGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SgFW2yeGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61EgPzZpd2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61EgPzZpd2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/