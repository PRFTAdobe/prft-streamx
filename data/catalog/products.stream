    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PT66\",\"sku\":\"B075X4PT66\",\"lang\":\"en\",\"slug\":\"marin-nailhead-studded-sofa-couch-87-w-charcoal-b075x4pt66\",\"name\":\"Marin Nailhead Studded Sofa Couch, 87&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Nailhead Studded Sofa Couch, 87&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aLbZ9Bb6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w2rv-rTiS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1w2rv-rTiS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zXOWDIPRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zXOWDIPRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1B1vjbyOLS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912UAZx5j-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912UAZx5j-L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"la