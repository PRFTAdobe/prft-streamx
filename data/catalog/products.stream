      "content": {
        "bytes": "{\"id\":\"B075Z8628K\",\"sku\":\"B075Z8628K\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-checkerboard-reclaimed-elm-buffet-sideboard-credenza-cabinet-55-1-w-natural-b075z8628k\",\"name\":\"Rivet Mid-Century Modern Checkerboard Reclaimed Elm Buffet Sideboard Credenza Cabinet, 55.1&quot;W, Natural\",\"description\":\"From checkerboard accent front to its tapered legs, this handsome cabinet makes a true mid-century statement. Storage compartments make it useful as an entertainment center, a focal point for a hallway or entryway, or even a dining room buffet. 55.1&quot;W x 17.7&quot;D x 31.5&quot;H Reclaimed solid elm frame and legs A mid-century modern statement piece Soft closing drawers provide convenient storage for dishes, AV equipment and more No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Checkerboard Reclaimed Elm Buffet Sideboard Credenza Cabinet, 55.1&quot;W, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TpiVYzbTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fvj53fQxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fvj53fQxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kR-wLY9HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kR-wLY9HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eSjGlN4OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eSjGlN4OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwPw2DUdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwPw2DUdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B4Lqe-WTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B4Lqe-WTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tjztOItIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tjztOItIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"55.1\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"1.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Credenza\",\"label\":\"Credenza\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Buffet\",\"label\":\"Buffet\"},{\"value\":\"Sideboard\",\"label\":\"Sideboard\"},{\"value\":\"Wine cabinet\",\"label\":\"Wine cabinet\"},{\"value\":\"Buffet cabinet\",\"label\":\"Buffet cabinet\"},{\"value\":\"Sideboards and buffet tables with storage\",\"label\":\"Sideboards and buffet tables with storage\"},{\"value\":\"Natural\",\"label\":\"Natural\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Dining room buffet\",\"label\":\"Dining room buffet\"},{\"value\":\"Bar\",\"label\":\"Bar\"},{\"value\":\"Sideboards\",\"label\":\"Sideboards\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining buffet\",\"label\":\"Dining buffet\"},{\"value\":\"Liquor cabinet\",\"label\":\"Liquor cabinet\"},{\"value\":\"Sideboard buffet\",\"label\":\"Sideboard buffet\"},{\"value\":\"Buffet table\",\"label\":\"Buffet table\"}]}],\"categories\":[{\"id\":\"Buffets & Sideboards\",\"slug\":\"buffets-&-sideboards\",\"name\":\"Buffets & Sideboards\",\"value\":\"Buffets & Sideboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":526,\"discountedValue\":473.4}}"
