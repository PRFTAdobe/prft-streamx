    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N3QJ\",\"sku\":\"B075X4N3QJ\",\"lang\":\"en\",\"slug\":\"rivet-lawson-mid-century-modern-angled-upholstered-arm-chair-33-w-pearl-b075x4n3qj\",\"name\":\"Rivet Lawson Mid-Century Modern Angled Upholstered Arm Chair, 33&quot;W, Pearl\",\"description\":\"This item is made to order just for you 33&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with a removable seat cushion make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling up with a good book on this sophisticated chair. A sleek back, angled arms, a removable seat cushion and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Mid-Century Modern Angled Upholstered Arm Chair, 33&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919KyP9C2HL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+1WJPJ9FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+1WJPJ9FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1awcGpxTOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1awcGpxTOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bIkFIBOSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bIkFIBOSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N1ecv6ZOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1N1ecv6ZOL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"v