    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSKXDTK\",\"sku\":\"B07HSKXDTK\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-upholstered-bar-stool-with-gold-accents-41-h-juniper-blue-b07hskxdtk\",\"name\":\"Rivet Whit Contemporary Upholstered Bar Stool with Gold Accents, 41&quot;H, Juniper Blue\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous juniper blue, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 41&quot;H; Seat Height: 30&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Upholstered Bar Stool with Gold Accents, 41&quot;H, Juniper Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KX0mt7AzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W5qsKIHYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81W5qsKIHYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bcL+erXYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bcL+erXYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cj5M+JSvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cj5M+JSvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LIh2zQeQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LIh2zQeQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MqqLH9LAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/