    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YN3HCD\",\"sku\":\"B075YN3HCD\",\"lang\":\"en\",\"slug\":\"carson-tufted-leather-kitchen-counter-bar-stool-45-h-brown-b075yn3hcd\",\"name\":\"Carson Tufted Leather Kitchen Counter Bar Stool, 45&quot;H, Brown\",\"description\":\"Modern tufting on the back, along with substantial padding in the back and seat, make this bar stool stylish and comfortable. The seat rests upon classic tall wooden legs. Top-grain leather makes it durable and easy to clean. 23.6&quot;W x 18.5&quot;D x 45&quot;H. Base height is 30&quot;. Full top-grain leather; solid poplar legs with espresso finish. Foam padding and elastic suspension system keeps the seat firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Carson Tufted Leather Kitchen Counter Bar Stool, 45&quot;H, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X1S9oiYKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16U6Qt+BEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16U6Qt+BEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cp5JSIcfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cp5JSIcfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12PYjOvPdS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12PYjOvPdS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UNzaAHatL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UNzaAHatL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rHc5dGahL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rHc5dGahL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"