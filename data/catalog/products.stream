    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCPWG3\",\"sku\":\"B082QCPWG3\",\"lang\":\"en\",\"slug\":\"rivet-revere-round-upholstered-iron-framed-ottoman-30-3-w-ivory-b082qcpwg3\",\"name\":\"Rivet Revere Round Upholstered Iron-Framed Ottoman, 30.3&quot;W, Ivory\",\"description\":\"Your feet and legs will rest comfortably on the foam padding in this ottoman. A powder-coated iron frame forms a steady base. Upholstery in a soft ivory color ensures that this piece will blend with all color schemes and design tastes, making this a simple way to spruce up your space. 30.3&quot;W x 30.3&quot;D x 18.1&quot;H; seat height: 18.1&quot;H; seat depth: 30.3&quot;D; leg height: 7.3&quot;H Powdered-iron base; polyester and leather upholstery An easy and stylish way to add comfort to any seating area, this ottoman is foam padded to create soft support. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Revere Round Upholstered Iron-Framed Ottoman, 30.3&quot;W, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KwubWeXSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cRq5-9+qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cRq5-9+qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-+wx2DDqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-+wx2DDqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YyAXAyVsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YyAXAyVsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Q+Vjt+OVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Q+Vjt+OVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VOcVSqK-L.jpg\",\"url