    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N28JV\",\"sku\":\"B07B4N28JV\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-l-sectional-116-w-rouge-red-b07b4n28jv\",\"name\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Rouge Red\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Rouge Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aGhJtSlcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91euNVFwSoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91euNVFwSoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A156T3leROL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A156T3leROL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715angFCK9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715angFCK9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u1yiNOG6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u1yiNOG6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origi