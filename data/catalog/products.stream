{
  "key": "pim:B082DFL4JW",
  "action": "publish",
  "eventTime": null,
  "properties": {
    "sx:type": "data/product"
  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082DFL4JW\",\"sku\":\"B082DFL4JW\",\"lang\":\"en\",\"slug\":\"rivet-avery-industrial-home-office-writing-desk-with-metal-base-40-w-chestnut-brown-finish-b082dfl4jw\",\"name\":\"Rivet Avery Industrial Home Office Writing Desk with Metal Base, 40&quot;W, Chestnut Brown Finish\",\"description\":\"Industrial style meets contemporary functionality in this sturdy, streamlined desk. This versatile piece makes a home office or workplace style statement while also standing up to daily use. A single slim drawer offers handy storage without spoiling the elegantly sparse lines of the desk. 40&quot;W x 18&quot;D x 30&quot;H Durable MDF with chestnut-finished hardwood veneer and an antique bronze-finished metal base A wide top offers ample workspace for writers, artists, or busy professionals. The single drawer slides easily. The clean lines of this desk speak to its industrial-chic roots. The warm wood finish of the top pairs perfectly with the antiqued metal base. Assemble in 15-30 minutes Using a soft, damp cloth, wipe in the direction of the wood grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Avery Industrial Home Office Writing Desk with Metal Base, 40&quot;W, Chestnut Brown Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RSiv8gPEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71buDsLQrKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71buDsLQrKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nnNH0k8lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nnNH0k8lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813jFRjfIzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813jFRjfIzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zalTsWPfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zalTsWPfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PfBtmLZmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PfBtmLZmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61LiW70Jk4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61LiW70Jk4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BppBY9zKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BppBY9zKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61tcKZPlgEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61tcKZPlgEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J9m8e1KtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J9m8e1KtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"60.41\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Large\",\"label\":\"Large\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Curved\",\"label\":\"Curved\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Escritorio\",\"label\":\"Escritorio\"},{\"value\":\"Computer\",\"label\":\"Computer\"},{\"value\":\"Work\",\"label\":\"Work\"},{\"value\":\"Foldable\",\"label\":\"Foldable\"},{\"value\":\"33950212\",\"label\":\"33