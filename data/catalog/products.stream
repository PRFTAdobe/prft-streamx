    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MJL66D4\",\"sku\":\"B07MJL66D4\",\"lang\":\"en\",\"slug\":\"ravenna-home-trellis-pattern-upholstered-headboard-queen-61-6-inch-grey-and-cream-b07mjl66d4\",\"name\":\"Ravenna Home Trellis Pattern Upholstered Headboard - Queen, 61.6 Inch, Grey and Cream\",\"description\":\"61.6&quot;W x 3.1&quot;D x 53.7&quot;H Well-constructed plywood and metal legs This queen-size headboard with foam padding covered in gray-patterned fabric is a serene addition to your bedroom decor in a classic, transitional style. Padding and sturdy construction give extra comfort and support. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Trellis Pattern Upholstered Headboard - Queen, 61.6 Inch, Grey and Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gONOBBf1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kaK5LBeEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kaK5LBeEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NtK8N+FeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NtK8N+FeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yNSZHKP8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yNSZHKP8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lO6mMRK9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lO6mMRK9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tx4f0pjtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tx4f0pjtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YO89dPm8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YO8