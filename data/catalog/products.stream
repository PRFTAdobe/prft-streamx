    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VWHG\",\"sku\":\"B075X4VWHG\",\"lang\":\"en\",\"slug\":\"leila-velvet-tufted-chair-44-w-navy-blue-b075x4vwhg\",\"name\":\"Leila Velvet Tufted Chair, 44&quot;W, Navy Blue\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x 31&quot;H Solid wood frame and legs with 100% polyester upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage look chair. With solid wood legs in a dark walnut finish, plush velvet upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Velvet Tufted Chair, 44&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ThvR85wlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JdCYlHowL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JdCYlHowL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914PIFu8oeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914PIFu8oeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GcwWzpu-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GcwWzpu-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JcB7OLbqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":