    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QD6V6H2\",\"sku\":\"B07QD6V6H2\",\"lang\":\"en\",\"slug\":\"contemporary-side-table-with-bookshelf-21-6-w-black-oak-b07qd6v6h2\",\"name\":\"Contemporary Side Table with Bookshelf, 21.6&quot;W, Black Oak\",\"description\":\"This square table brings functionality to any room with 1 side devoted to shelving that is great for storing books or other items. The height allows it to be used as a side table or a small desk. Butt joints connect the legs and shelving, adding a modern look to the sleek black finish. 21.6&quot;W x 21.6&quot;D x 25.6&quot;H Engineered wood with metal This stylish table offers a modern look and functionality great for any room. Shelving on 1 side of this table makes it great as a side table or a desk in any room. Assemble in 15-30 minutes Wipe with a soft cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Contemporary Side Table with Bookshelf, 21.6&quot;W, Black Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i2+lPssVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TsE9ANC4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TsE9ANC4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kf9161VbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kf9161VbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ukZMe4eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ukZMe4eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GDFVUnNxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GDFVUnNxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G0ZTh3JAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G0ZTh3JAL.jpg\"}],\"