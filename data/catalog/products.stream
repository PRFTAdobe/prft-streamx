    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2Q456\",\"sku\":\"B084W2Q456\",\"lang\":\"en\",\"slug\":\"louise-memory-swivel-counter-height-barstool-38-2-h-midnight-b084w2q456\",\"name\":\"Louise Memory Swivel Counter-Height Barstool, 38.2&quot;H, Midnight\",\"description\":\"This counter-height barstool features a memory swivel, which will return the seat to its proper position every time. The sturdy wood frame includes a footrest, and the padded midnight-colored-upholstered seat makes this barstool an easy addition to your breakfast bar or kitchen counter! 23.6&quot;W x 24&quot;D x 38.2&quot;H; seat height: 26&quot;H; seat depth: 16.9&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric A memory-swivel mechanism means this barstool always looks tidy. Wingback dining chair with polished brass nailhead trim No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Louise Memory Swivel Counter-Height Barstool, 38.2&quot;H, Midnight\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kWW4vH0ML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QxChruoDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QxChruoDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711ws7Q688L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711ws7Q688L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aM61wDWoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71aM61wDWoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ItwYZuWOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ItwYZuWOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-