      "content": {
        "bytes": "{\"id\":\"B072ZMK68Y\",\"sku\":\"B072ZMK68Y\",\"lang\":\"en\",\"slug\":\"rivet-industrial-tilted-wood-and-metal-side-end-table-17-3-w-walnut-b072zmk68y\",\"name\":\"Rivet Industrial Tilted Wood and Metal Side End Table, 17.3&quot;W, Walnut\",\"description\":\"You'll enjoy resting your glass or remote control on this eclectic, industrial-style end table as you kick back and relax. Its compact size is ideal for a tight corner next to a sofa, or for serving snacks at your next game night. 17.3&quot;W x17.3&quot;L x23.2&quot;H Solid hardwood top with walnut finish; metal legs with black matte finish Wood and metal are combined for a chic industrial look Compact size is ideal for a smaller room next to a sofa Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Tilted Wood and Metal Side End Table, 17.3&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xgqOmnjnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e7hr-obaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e7hr-obaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71prN3ChomL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71prN3ChomL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MEI0O501L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MEI0O501L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7101BmkvhML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7101BmkvhML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jHgDYsRGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jHgDYsRGL.jpg\"}],\"attributes\":[{\"name