    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHYD995\",\"sku\":\"B07QHYD995\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-sofa-couch-with-wood-base-and-legs-78-w-ivory-b07qhyd995\",\"name\":\"Hillman Mid-Century Sofa Couch with Wood Base and Legs, 78&quot;W, Ivory\",\"description\":\"Wide, comfortable cushions are a hallmark of this mid-century inspired sofa. Easy-care ivory upholstery and reversible back cushions help keep this piece looking fresh. A hardwood frame connects to tapered wood legs and lends structure to the foam-padded cushions. High arms give additional support. 78&quot;W x 38&quot;D x 33&quot;H; seat height: 18&quot;H; seat depth: 21&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 8&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Removable and reversible back and throw cushions Classic shape and plush cushions make this sofa work in a variety of decors. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Sofa Couch with Wood Base and Legs, 78&quot;W, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TXnI63eQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RC8N8I6VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RC8N8I6VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aQV6iHzJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aQV6iHzJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cOiqB5vnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cOiqB5vnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812ur4nI8vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original