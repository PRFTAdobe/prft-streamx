    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086VYSQ51\",\"sku\":\"B086VYSQ51\",\"lang\":\"en\",\"slug\":\"seriana-upholstered-power-recliner-love-seat-61-w-sandstone-b086vysq51\",\"name\":\"Seriana Upholstered Power Recliner Love Seat, 61&quot;W, Sandstone\",\"description\":\"This power recliner love seat is a must-have for any contemporary living room. Durable sandstone upholstery blends with any decor and is easy to care for. The tall back cushions are loose, allowing you to adjust for comfort as the footrest reclines. High armrests provide cushioned support. This item is made to order just for you 61&quot;W x 40&quot;D x 29&quot;H; seat height: 20&quot;H; seat depth: 23&quot;D; back height: 27&quot;H; arm height: 28&quot;H; leg height: 2.25&quot;H Sturdy wood frame with stain-resistant fabric Plug directly into outlet for power, or use battery pack so you do not have to worry about cords. The footrest reclines, but the back does not move. No assembly required Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Seriana Upholstered Power Recliner Love Seat, 61&quot;W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GRV0ZkKTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WD6XjN1lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WD6XjN1lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QaAR-tHeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QaAR-tHeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rszy2zjXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71rszy2zjXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i-5jbCwaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i-5jbCwa