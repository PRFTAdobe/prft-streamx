      "content": {
        "bytes": "{\"id\":\"B075X5441V\",\"sku\":\"B075X5441V\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-straight-back-settee-49-w-pebble-b075x5441v\",\"name\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Pebble\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish. A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Pebble\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1C7wyYTkhL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1n1QR85qcS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1n1QR85qcS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NDBjEdpZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NDBjEdpZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10-UpIVOmS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10-UpIVOmS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H8ARTyRxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1H8ARTyRxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]