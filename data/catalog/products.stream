    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2WK7QG\",\"sku\":\"B07J2WK7QG\",\"lang\":\"en\",\"slug\":\"rivet-abel-modern-contemporary-accent-chair-32-w-navy-b07j2wk7qg\",\"name\":\"Rivet Abel Modern Contemporary Accent Chair, 32&quot;W, Navy\",\"description\":\"Upgrade your living room style with this striking contemporary accent chair. The stitching all along the edge shows off this chair’s construction quality, and the silver metal legs and slim armrests complete its sleek look. Overall: 32&quot;W x 34&quot;D x 31&quot;H; Seat Height: 17.71&quot;H; Seat Depth: 21.65&quot;D; Seat Back Height: 31&quot;H; Arm Height: 23.22:H; Leg Height: 5.91&quot;H Solid-wood frame with silver metal legs Slim arm with loose back cushion Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Abel Modern Contemporary Accent Chair, 32&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RIVOJQ4jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+XXqY6RqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+XXqY6RqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ud7HKWECL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ud7HKWECL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OVmvfcCML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OVmvfcCML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aOTClTkqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aOTClTkqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912zbrp9WPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912zbrp9WPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origina