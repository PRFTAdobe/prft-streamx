    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QD6TXWS\",\"sku\":\"B07QD6TXWS\",\"lang\":\"en\",\"slug\":\"rivet-claremont-contemporary-nightstand-with-tapered-legs-20-w-pale-wood-and-white-b07qd6txws\",\"name\":\"Rivet Claremont Contemporary Nightstand with Tapered Legs, 20&quot;W, Pale Wood and White\",\"description\":\"This 2-toned contemporary nightstand comes in a natural finish with 2 white drawers and pulls. Unlike similar products, this can be used as a nightstand, side table, or media cabinet. The drawers help control clutter with roomy storage, while the casual look fits with most decor. 20&quot;W x 16&quot;D x 24&quot;H 80% MDF, 20% solid wood Vintage tapered legs add interest to the clean lines of this nightstand. This nightstand offers 2 drawers with pulls and can be used as a nightstand, side table, or media cabinet. Assemble in 15-30 minutes Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Claremont Contemporary Nightstand with Tapered Legs, 20&quot;W, Pale Wood and White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p5MSs6RvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1up4GyYruL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1up4GyYruL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711e00BAEEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711e00BAEEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+duQEBB+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+duQEBB+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aKs2KTI6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aKs2KTI6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QpmD5qIDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QpmD5qIDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"22.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"28.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stand\",\"label\":\"Stand\"},{\"value\":\"Nightstands\",\"label\":\"Nightstands\"},{\"value\":\"Night\",\"label\":\"Night\"},{\"value\":\"Bedrooms\",\"label\":\"Bedrooms\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Coaster\",\"label\":\"Coaster\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Modern\",\"label\":\"Modern\"}]}],\"categories\":[{\"id\":\"Nightstands\",\"slug\":\"nightstands\",\"name\":\"Nightstands\",\"value\":\"Nightstands\",\"label\":null,\"parent\":null,\"subcategories\":[]},{\"id\":\"Featured\",\"slug\":\"featured\",\"name\":\"Featured\",\"value\":\"Featured\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":641,\"discountedValue\":576.9}}"
