    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G5QDB\",\"sku\":\"B07B4G5QDB\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-sofa-87-w-grey-linen-b07b4g5qdb\",\"name\":\"Rivet Edgewest Low Back Modern Sofa, 87&quot;W, Grey Linen\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 87&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Sofa, 87&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91i6JdAHvuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pOakmVS0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pOakmVS0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917iCtRiM0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917iCtRiM0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10fiITLauL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10fiITLauL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sGNDM-ddL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sGNDM-ddL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i5Xf3BYJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i5Xf3BYJL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"80.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"124.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Grey linen\",\"label\":\"Grey linen\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":329,\"discountedValue\":296.1}}"
