        "bytes": "{\"id\":\"B072JG3WK1\",\"sku\":\"B072JG3WK1\",\"lang\":\"en\",\"slug\":\"ashbury-modern-exposed-wood-accent-chair-29-w-navy-b072jg3wk1\",\"name\":\"Ashbury Modern Exposed Wood Accent Chair, 29&quot;W, Navy\",\"description\":\"Graceful curves and a plush back and cushion invite you to take a seat in this accent chair. Its modern combination of sleek exposed wood and attractive upholstery will blend effortlessly with any living space. 31.9&quot;D x 29&quot;W x 33&quot;H Solid wood and engineered hardwood frame, durable fabric Modern yet classic Plush deep cushioning is great for any room needing an extra chair No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Ashbury Modern Exposed Wood Accent Chair, 29&quot;W, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Y51zYw1GL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E3l4dc9oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1E3l4dc9oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ccloM6NRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ccloM6NRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qT4HuifHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1qT4HuifHS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1hRNr+x8pS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1hRNr+x8pS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9129wyqZawL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9129wyqZawL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\