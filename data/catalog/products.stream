    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VM4LMQ\",\"sku\":\"B082VM4LMQ\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-velvet-sofa-couch-80-w-blue-b082vm4lmq\",\"name\":\"Rivet Alonzo Contemporary Velvet Sofa Couch, 80&quot;W, Blue\",\"description\":\"A single bench cushion brings visual unity and gently sloping armrests give it a sleek, comfortable style. With a solid-wood frame and strong brass legs, this sofa offers durability and elegance. Overall: 80.3&quot;W x 37.8&quot;D x 35.4&quot;H; Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and velvet upholstery. Bench seat cushion with removable back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Velvet Sofa Couch, 80&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61m3k7GeDmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rbQx7xY7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61rbQx7xY7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61u4Q6xpkpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61u4Q6xpkpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T5HGYVdZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71T5HGYVdZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H65UC1ZhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H65UC1ZhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MsMVbsuDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MsMVbsuDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-p