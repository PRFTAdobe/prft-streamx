    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSM1W46\",\"sku\":\"B07HSM1W46\",\"lang\":\"en\",\"slug\":\"lyla-rustic-slat-bed-headboard-queen-64-inch-china-gray-b07hsm1w46\",\"name\":\"Lyla Rustic Slat Bed Headboard - Queen, 64 Inch, China Gray\",\"description\":\"The elegant shutter design of this hardwood headboard is nicely complemented by the subtle wood-grain texture and gentle gray finish. The end result is a headboard that conveys subdued but distinct class and sophistication. 64&quot;W x 3&quot;D x 80&quot;H Made of solid hardwood and finished in a semi-translucent gray that allows some wood grain to be seen The headboard has a vintage European feel and will feel equally at home in a farmhouse or city loft. This headboard will require a mattress and box spring. A bed frame is not included. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Lyla Rustic Slat Bed Headboard - Queen, 64 Inch, China Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CyWO1wPyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SsHH1vKBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SsHH1vKBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WFGSeS3CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WFGSeS3CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QXHsmJLmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QXHsmJLmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mBGmkOdyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mBGmkOdyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VlSW-hgmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VlSW-hgmL.jpg\"},{\"alt\":