    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VM7676\",\"sku\":\"B082VM7676\",\"lang\":\"en\",\"slug\":\"rivet-jamie-leather-mid-century-modern-low-arm-accent-chair-31-w-black-b082vm7676\",\"name\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Black\",\"description\":\"A great addition to any room, this versatile accent chair is sure to be a conversation piece. It features eye catching Mid-century inspired design with distinctive slanted arms and sturdy hardwood legs. 31&quot;W x 32.3&quot;D x 35”H Solid hardwood frame and soft top-grain leather. Highly fashionable design in a compact size for small spaces. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Jamie Leather Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812+MziBXML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bG0hFr+ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bG0hFr+ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZfWx+irSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZfWx+irSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814mJHel0rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814mJHel0rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YcCx7QXcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YcCx7QXcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K0ocdEKLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81K0ocdEKLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SmFt-Fh+L.jpg\",\"url\":\"https://storage.googleapis.co