    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G5ZL3\",\"sku\":\"B07B4G5ZL3\",\"lang\":\"en\",\"slug\":\"isabel-traditional-small-storage-ottoman-24-w-slate-grey-b07b4g5zl3\",\"name\":\"Isabel Traditional Small Storage Ottoman, 24&quot;W, Slate Grey\",\"description\":\"22.4&quot;L x 24.4&quot;W x 18.9&quot;H Performance fabric on wood frame Streamlined design fits a modern or transitional room Streamlined design fits a modern or transitional room Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty. This ottoman is a multi-tasker, providing a comfy foot rest along with storage space. It can accommodate a tray of snacks or be an extra seat for guests, too. Built to last, its performance fabric will resist stains along with wear and tear.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Small Storage Ottoman, 24&quot;W, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XBOiB3YHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xPxLhEtRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xPxLhEtRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jEAU0tsNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jEAU0tsNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qsbNYOZ2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qsbNYOZ2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91va9qAwf0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91va9qAwf0L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.5