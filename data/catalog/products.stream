    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ8J1WM\",\"sku\":\"B07HZ8J1WM\",\"lang\":\"en\",\"slug\":\"clayton-reclining-contemporary-leather-living-room-chair-30-w-black-b07hz8j1wm\",\"name\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Black\",\"description\":\"With an ideal blend of style and comfort, this recliner is made to order just for you. The tasteful fabric in Black and wooden frame adds a contemporary flair, the perfect addition to any room. Sturdy wooden frame with stain-resistant fabric; no assembly required The tight, fixed back and seat cushions ensure durability and comfort; fits perfectly in a living-room corner or beside a couch or bed Product Dimensions: 30&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; seat back height: 41&quot;H; arm height: 24&quot;H; leg height: 6.5&quot;H Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Clayton Reclining Contemporary Leather Living-Room Chair, 30&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81owEJKTXaL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KLnYqbgZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KLnYqbgZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LIdLr-ASL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LIdLr-ASL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917EuNucqFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917EuNucqFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DD--2kTzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DD--2kTzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sWJgFaiSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim