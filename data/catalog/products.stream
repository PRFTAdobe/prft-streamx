    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L3W72\",\"sku\":\"B0853L3W72\",\"lang\":\"en\",\"slug\":\"rivet-logan-mid-century-modern-dining-chair-set-of-2-20-1-w-silver-b0853l3w72\",\"name\":\"Rivet Logan Mid-Century Modern Dining Chair, Set of 2, 20.1&quot;W, Silver\",\"description\":\"Make an elegant but practical impression with these modern dining chairs. The padded wood frame provides durability and comfort, and the slim but sturdy black metal base gives you plenty of leg room. These chairs would complement any contemporary-style dining table and decor. 20.1&quot;W x 27.2&quot;D x 36.6&quot;H; seat height: 19.3&quot;H; seat depth: 19.3&quot;D; seat back height: 20.9&quot;H; leg height: 15.7&quot;H Padded solid wood frame; black metal base Black metal base provides plenty of leg room, and open sides allow maximum freedom of movement. Set of 2 chairs featuring a contemporary design with comfortable seating and a modern metal base. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Logan Mid-Century Modern Dining Chair, Set of 2, 20.1&quot;W, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mvF2gJy5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815njViL1KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815njViL1KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tDECjsy4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tDECjsy4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Um4L7ub0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Um4L7ub0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+wBcEq0wL