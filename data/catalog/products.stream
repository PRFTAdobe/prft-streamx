    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4VY14V\",\"sku\":\"B07B4VY14V\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-king-bed-84-w-curious-charcoal-b07b4vy14v\",\"name\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Curious Charcoal\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Curious Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UAuY-1k+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AQ6jOls+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AQ6jOls+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GUT6efQgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GUT6efQgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15e3Rf8cxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15e3Rf8cxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UCHO3q2eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UCHO3q2eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UAZVS+djL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina