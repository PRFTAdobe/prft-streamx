    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M5BYY\",\"sku\":\"B07B4M5BYY\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-recliner-30-w-pewter-b07b4m5byy\",\"name\":\"Edmunds Traditional Recliner, 30&quot;W, Pewter\",\"description\":\"Straight lines and narrow arms combine modern touches with classic fabric, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Cotton fabric on hardwood pine frame Streamlined silhouette combines modern style with a classic fabric for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Recliner, 30&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VaWohfJdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M4UXTdTkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1M4UXTdTkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FPmKjhGEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FPmKjhGEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y2K3qPWPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y2K3qPWPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9154okX9sfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9154okX9sfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UpE+l30nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UpE+l30nL.jpg\"}],\"attribut