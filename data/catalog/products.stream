    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQD6TS\",\"sku\":\"B07QBQD6TS\",\"lang\":\"en\",\"slug\":\"canton-queen-button-tufted-headboard-64-w-pearl-b07qbqd6ts\",\"name\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Pearl\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft pearl-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 64&quot;W x 3&quot;D x 62&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Queen Button-Tufted Headboard, 64&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71UUpvXTMlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pCMcFk0jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pCMcFk0jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A1s062UVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A1s062UVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DzSekVXyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DzSekVXyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+NoZnn-gL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name