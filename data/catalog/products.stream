    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33QV4\",\"sku\":\"B075X33QV4\",\"lang\":\"en\",\"slug\":\"janelle-button-tufted-ottoman-37-w-dove-b075x33qv4\",\"name\":\"Janelle Button Tufted Ottoman, 37&quot;W, Dove\",\"description\":\"Tufting, buttons and nailhead trim come together in this stylish ottoman. Tightly tufted upholstery and spindled wooden legs accent a piece that's useful as a seat for an extra guest, as well as a place for tired feet or a snack tray. This item is made to order just for you 37&quot; Diameter. 19&quot;H. Durable polyester blend fabric; wood metal nickel-finished casters. Smooth rolling casters. Ideal as extra seating, cocktail table, or foot stool. Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Janelle Button Tufted Ottoman, 37&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h0MLgz-NL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11UL9ii07L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A11UL9ii07L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TRNZVXutL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TRNZVXutL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IkF+otxBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IkF+otxBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DwD26eJfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DwD26eJfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+Uu9OcyZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+Uu9OcyZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\"