    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KPWHP\",\"sku\":\"B0853KPWHP\",\"lang\":\"en\",\"slug\":\"rivet-phinney-contemporary-upholstered-dining-chair-19-7-w-graphite-b0853kpwhp\",\"name\":\"Rivet Phinney Contemporary Upholstered Dining Chair, 19.7&quot;W, Graphite\",\"description\":\"This cushy dining chair represents a perfect intersection of style and comfort. The upholstery of the tall seat back is gently shaped to offer both back and head support, while its tapered shape adds visual interest. Elegantly splayed wooden legs give the chair additional stability. 19.7&quot;W x 24.4&quot;D x 36.6&quot;H; seat height: 19.3&quot;H; seat depth: 16.9&quot;D; seat back height: 22.2&quot;H; leg height: 14.4&quot;H Solid wood frame with 100% polyester fabric This well-upholstered chair is comfortable, stable, and stylish. This dining chair has a simple but elegant mid-century design. Assemble in 15 minutes or less Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Phinney Contemporary Upholstered Dining Chair, 19.7&quot;W, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wllwgtiqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wSqHZRJDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wSqHZRJDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71G2ma94fDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71G2ma94fDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71crP-RmXoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71crP-RmXoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7182ow3yCSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7182ow3yCSL.jpg\"},{\"alt\":\"https://storage.googleapis.