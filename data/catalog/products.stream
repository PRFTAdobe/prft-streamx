      "content": {
        "bytes": "{\"id\":\"B073GCWSTH\",\"sku\":\"B073GCWSTH\",\"lang\":\"en\",\"slug\":\"rivet-martin-modern-storage-bench-39-w-navy-velvet-b073gcwsth\",\"name\":\"Rivet Martin Modern Storage Bench, 39&quot;W, Navy Velvet\",\"description\":\"You're having friends over, but didn't have time to clean first. No problem - this storage ottoman is a great place to quickly stash clutter. In addition to its functionality, it's a stylish piece when closed. NOTE: This item is made-to-order, please expect an increased shipping time. 39” W x 19” D x 19” H Solid pine wood with polyester fabric Contemporary but classic A great ottoman for the living room or storage for blankets in a bedroom Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Martin Modern Storage Bench, 39&quot;W, Navy Velvet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rhgnBHJBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tL9PlFOrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tL9PlFOrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1G4yxjFSQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1G4yxjFSQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1z7NVGdcdS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1z7NVGdcdS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DwjphV4LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DwjphV4LL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.0\",\"label\":