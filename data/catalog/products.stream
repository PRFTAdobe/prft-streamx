{
  "key": "pim:B07HSG8DPT",
  "action": "publish",
  "eventTime": null,
  "properties": {
    "sx:type": "data/product"
  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSG8DPT\",\"sku\":\"B07HSG8DPT\",\"lang\":\"en\",\"slug\":\"commodore-casual-wood-side-end-table-17-w-new-whitewash-b07hsg8dpt\",\"name\":\"Commodore Casual Wood Side End Table, 17&quot;W, New Whitewash\",\"description\":\"Add an exotic flair to your home décor with this captivating side table. Made from mango and finished with new whitewash color, this table boasts a unique barrel shape with detailed hand-carved designs around its base. With its casual style, this side table is an ideal accent for any room. 17&quot;W x 17&quot;D x 19&quot;H Made of solid mango with an elegant whitewash finish. Each vertical section in the barrel design is hand carved by a skilled craftsman to create a lace design on the base. Combining modern geometry with a touch of the exotic, this drum-shaped side table crafts a stylish and sophisticated look with its lacy trellis base. Perfect as a chairside table or used in pairs to host a small group. No assembly required Care: Clean as required with a soft, damp cloth; wipe completely dry. Avoid placing furniture near heat vents or open windows. Long periods of heat or excessive dampness can cause splitting, warping, and swelling in solid wood. Protect fine furniture finishes from hot dishes, alcohol, and excessive moisture or dampness. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Commodore Casual Wood Side End Table, 17&quot;W, New Whitewash\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WVPY+WkdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WLW54pLLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WLW54pLLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eLaRiOZRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eLaRiOZRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original