    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B8F6V9M\",\"sku\":\"B07B8F6V9M\",\"lang\":\"en\",\"slug\":\"rivet-stevie-mid-century-modern-bar-stool-30-h-pack-of-2-red-b07b8f6v9m\",\"name\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Red\",\"description\":\"These fun velvet stools will add a cheerful pop of color to any room. Flared modern metal legs are topped by velvet cushions for a plush, sturdy feel and a touch of glam. Move them around to any room where you need an extra seat. 15.75&quot;W x 15.75&quot;D x 30&quot;H Velvet fabric on hardwood frame and legs An update on mid-century modern style that can blend with many rooms Velvet adds comfort and a touch of glam No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Stevie Mid-Century Modern Bar Stool, 30&quot;H, Pack of 2, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FKnVVFvdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IIwZO1guL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IIwZO1guL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XoLtv0p3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XoLtv0p3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91veE3PuVVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91veE3PuVVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mnuipLIiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mnuipLIiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AbOgvKNML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81csyoJwkmL.jpg\",\"url\":\"https://sto