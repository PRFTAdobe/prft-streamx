    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4T15\",\"sku\":\"B07QFP4T15\",\"lang\":\"en\",\"slug\":\"faraday-down-filled-casual-living-room-chair-47-w-charcoal-b07qfp4t15\",\"name\":\"Faraday Down-Filled Casual Living Room Chair, 47&quot;W, Charcoal\",\"description\":\"This modern living room chair comes with removable and reversible down-filled cushions for comfort. Roomy seating is nice with company or family, and the neutral tone matches most decor, making it a great choice for any room. The luxury of a cotton-blend upholstery helps keep everyone cool through the summer. 47&quot; Width x 43&quot; Depth x 33&quot; Height Solid hardwood frame with down-filled seat and back cushions Removable and reversible cushions This casual living room chair offers down-filled cushions and a seat depth of 43&quot; for extra comfort. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Faraday Down-Filled Casual Living Room Chair, 47&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71x8waaZCVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6fupFbsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6fupFbsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bOAV3ddJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bOAV3ddJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71R4hk2IdxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71R4hk2IdxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lg8ciiY9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lg8ciiY9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ksrr0gzrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ksrr0gzrL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.28\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"42.13\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"47.24\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"84.7\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"64011\",\"label\":\"64011\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Corvette\",\"label\":\"Corvette\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Rzr\",\"label\":\"Rzr\"},{\"value\":\"Lp530\",\"label\":\"Lp530\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Side\",\"label\":\"Side\"},{\"value\":\"Accessories\",\"label\":\"Accessories\"},{\"value\":\"Ridgid\",\"label\":\"Ridgid\"},{\"value\":\"Neon\",\"label\":\"Neon\"},{\"value\":\"C6\",\"label\":\"C6\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Lights\",\"label\":\"Lights\"},{\"value\":\"Abarth\",\"label\":\"Abarth\"},{\"value\":\"Mirrors\",\"label\":\"Mirrors\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Led\",\"label\":\"Led\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"View\",\"label\":\"View\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Reflect\",\"label\":\"Reflect\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Signature\",\"label\":\"Signature\"},{\"value\":\"By\",\"label