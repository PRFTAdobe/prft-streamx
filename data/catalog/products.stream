        "bytes": "{\"id\":\"B075YPTFCH\",\"sku\":\"B075YPTFCH\",\"lang\":\"en\",\"slug\":\"rivet-tina-mid-century-modern-curved-back-kitchen-dining-room-table-chairs-25-w-x-36-h-marine-blue-set-of-2-b075yptfch\",\"name\":\"Rivet Tina Mid-Century Modern Curved Back Kitchen Dining Room Table Chairs, 25&quot;W x 36&quot;H, Marine Blue, Set of 2\",\"description\":\"A simple clean design makes these dining chairs blend with most any décor. Fabric is durable and easy to clean, while a high, curved back is stylish and comfortable. These versatile pieces are easily moved anywhere you need extra seating. 25&quot;W x 19&quot;D x 36&quot;H Fabric is 60% polyester/20% linen/20% rayon on wood frame; solid hardwood base Foam padding and elastic suspension system keep backs and seats firm and springy Two chairs included Free returns for 30 days. 1-year warranty. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Tina Mid-Century Modern Curved Back Kitchen Dining Room Table Chairs, 25&quot;W x 36&quot;H, Marine Blue, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GRYI3WCIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rSHTzlUaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rSHTzlUaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-iaeuRnGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-iaeuRnGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JHpxSUGZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JHpxSUGZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tnEOLj17L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tnEOLj17L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IAxXxjElS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"17.6\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dinning table set\",\"label\":\"Dinning table set\"},{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Round dinning table\",\"label\":\"Round dinning table\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Marine blue\",\"label\":\"Marine blue\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Dinning table\",\"label\":\"Dinning table\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Table & Chair Sets\",\"slug\":\"table-&-chair-sets\",\"name\":\"Table & Chair Sets\",\"value\":\"Table & Chair Sets\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":324,\"discountedValue\":291.6}}"
