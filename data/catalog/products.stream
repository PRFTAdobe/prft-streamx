    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L9C4P\",\"sku\":\"B07B4L9C4P\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-ottoman-leather-32-w-charcoal-b07b4l9c4p\",\"name\":\"Rivet Edgewest Modern Ottoman, Leather, 32&quot;W, Charcoal\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 32&quot;W x 26&quot;D x 19&quot;H; Seat Height: 19&quot;H; Seat Depth: 26&quot;D; Leg Height: 5.25&quot;H Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; individual pieces can be configured in many ways Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Ottoman, Leather, 32&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BrIT+xcYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AhWsvuVFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AhWsvuVFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R--T3soZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91R--T3soZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AZsZ0e1CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AZsZ0e1CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bM+yvqX0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bM+yvqX0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1daU3IA5FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1daU3IA5FL.jpg\"}],\"