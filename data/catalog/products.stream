    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2YWSF3\",\"sku\":\"B07J2YWSF3\",\"lang\":\"en\",\"slug\":\"calhoun-loveseat-sofa-62-5-w-tweed-b07j2ywsf3\",\"name\":\"Calhoun Loveseat Sofa, 62.5&quot;W, Tweed\",\"description\":\"Overall: 62.5&quot;W x 41&quot;D x 36&quot;H; seat height: 20.5&quot;H; seat depth: 27&quot;D; seat back height: 31&quot;H; arm height: 24&quot;H; leg height: 1.75&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric A classic design updated to suit contemporary tastes, perfect for transitional-style home decor Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Calhoun Loveseat Sofa, 62.5&quot;W, Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s2uI-vPlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uSO5QYioS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uSO5QYioS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xQebjqcsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xQebjqcsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eG6ImgI7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eG6ImgI7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bErxF3pWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bErxF3pWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mjG+XtoML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mjG+XtoML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"valu