    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMZGDG\",\"sku\":\"B082VMZGDG\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-velvet-loveseat-sofa-64-w-blue-b082vmzgdg\",\"name\":\"Rivet Alonzo Contemporary Velvet Loveseat Sofa, 64&quot;W, Blue\",\"description\":\"A single bench cushion brings visual unity and gently sloping armrests give it a sleek, comfortable style. With a solid-wood frame and strong brass legs, this love seat offers durability and elegance. Overall: 63.8&quot;W x 37.8&quot;D x 35.4&quot;H. Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and velvet upholstery. Bench seat cushion with removable back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Velvet Loveseat Sofa, 64&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fGIrfquNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-hc7WoLCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-hc7WoLCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WkfZ+3noL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WkfZ+3noL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7189HootKzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7189HootKzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XgVLp7dyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XgVLp7dyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gn9DD8zIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gn9DD8zIL.jpg\"},{\"alt\":\"https://storage.googleapis.c