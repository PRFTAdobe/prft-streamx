    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6X7T7\",\"sku\":\"B07HZ6X7T7\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-corner-sofa-fabric-90-w-stone-b07hz6x7t7\",\"name\":\"Bagley Sectional Component, Right-Facing Corner Sofa, Fabric, 90&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing corner sofa component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 90&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Corner Sofa, Fabric, 90&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61yLDnKlsxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lQ8duzPEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lQ8duzPEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kQDZeS0ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kQDZeS0ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G-hoDCt0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dPGWkG8bL.jpg\",\"url\":\"https://storag