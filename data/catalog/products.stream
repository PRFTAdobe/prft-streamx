    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LN3XK\",\"sku\":\"B07P5LN3XK\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-leather-chair-with-tapered-wood-legs-35-w-dark-brown-b07p5ln3xk\",\"name\":\"Rivet Aiden Mid-Century Leather Chair with Tapered Wood Legs, 35&quot;W, Dark Brown\",\"description\":\"This chair features easy-care leather with removable cushions that will help keep cleaning simple, and the attractive brown color will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 35&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable and reversible back cushions Mid-century style and top grain leather combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Leather Chair with Tapered Wood Legs, 35&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ex-Cax-4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cXGeTitRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cXGeTitRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71C3Gp8fIfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71C3Gp8fIfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LBmZDG3nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LBmZDG3nL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XeAaIpCeL.jpg\",\"url\":\"https://storage.