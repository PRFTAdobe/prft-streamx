    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2G21K\",\"sku\":\"B084W2G21K\",\"lang\":\"en\",\"slug\":\"linden-classic-upholstered-dining-chair-18-9-w-set-of-2-light-gray-b084w2g21k\",\"name\":\"Linden Classic Upholstered Dining Chair, 18.9&quot;W, Set of 2, Light Gray\",\"description\":\"This set of two classically styled armless dining chairs are upholstered in a light-gray fabric that makes them equally perfect for a classic dining room or eat-in kitchen. Their luxury and practicality means they evoke both romantic dinners for two and fabulous banquets for the whole family. 18.9&quot;W x 24.4&quot;D x 34.3&quot;H; seat height: 19.3&quot;H; seat depth: 18.5&quot;D; seat back height: 19.7&quot;H; leg height: 14.6&quot;H Solid wood frame High back provides extra support and added flair. Simple dining chair boasts beautiful fabric. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Linden Classic Upholstered Dining Chair, 18.9&quot;W, Set of 2, Light Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81l5gdWfOLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718VQrwYuuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718VQrwYuuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-hGtM76iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-hGtM76iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T8QPHlo7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T8QPHlo7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+eFH9bYcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+eFH9bYcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rBBrwmI0L.j