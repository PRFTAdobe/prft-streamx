    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YNJR62\",\"sku\":\"B075YNJR62\",\"lang\":\"en\",\"slug\":\"sophia-modern-swivel-kitchen-bar-stool-43-3-h-slate-grey-b075ynjr62\",\"name\":\"Sophia Modern Swivel Kitchen Bar Stool, 43.3&quot;H, Slate Grey\",\"description\":\"With a substantial padded back and seat, this bar stool provides maximum comfort -- and it swivels! The solid hardwood frame is sturdy and stable, and performance fabric makes it durable and easy to clean. 17.7&quot;D x 21.3&quot;W x 43.3&quot;H. Seat height is 30 inches. 95% polyester/5% nylon on hardwood frame; solid poplar legs. Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Swivel Kitchen Bar Stool, 43.3&quot;H, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818CwPbuQUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81snr7v5ybL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81snr7v5ybL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B10ZhoHTHJS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nw7O-OzaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nw7O-OzaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81efcNcL9YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81efcNcL9YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BGYn3N9eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BGYn3N9eL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"43.3\",\"label\":\"inche