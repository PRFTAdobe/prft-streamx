    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084S1DM72\",\"sku\":\"B084S1DM72\",\"lang\":\"en\",\"slug\":\"bergen-upholstered-dining-chair-with-wood-legs-set-of-2-20-w-gray-b084s1dm72\",\"name\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Gray\",\"description\":\"Luxury and practicality are married in these beautifully padded dining room chairs. The solid hardwood frame is upholstered in a soothing gray performance fabric for easy maintenance and long hours of comfortable sitting. 20&quot;W x 22.5&quot;D x 32.75&quot;H; seat height: 20&quot;H; seat depth: 19&quot;D; seat back height: 12.75&quot;H; leg height: 14&quot;H The solid hardwood frame has a natural finish to complement the performance fabric upholstery on the seat and back. These classic, comfortable chairs can be used as part of a dining room suite, as occasional chairs, or as accent chairs in a bedroom or office. As part of the simple and modern design, backrests are curved ergonomically to ensure comfort while sitting. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Xy5wqjS6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-ljbaTRVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-ljbaTRVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81af47WAcaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81af47WAcaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RM1vQOECL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RM1vQOECL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Otx1a1eTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Otx1a1eTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71svHdeZQ3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71svHdeZQ3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TaBTrkcML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TaBTrkcML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8103qlKo-DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8103qlKo-DL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.75\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"31.6\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Armen\",\"label\":\"Armen\"},{\"value\":\"Faux\",\"label\":\"Faux\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":475,\"discountedValue\":427.5}}"
