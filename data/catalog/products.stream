        "bytes": "{\"id\":\"B075X4QFD5\",\"sku\":\"B075X4QFD5\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-leather-accent-arm-chair-39-w-saddle-brown-b075x4qfd5\",\"name\":\"Charles Classic Oversized Leather Accent Arm Chair, 39&quot;W, Saddle Brown\",\"description\":\"This item is made to order just for you Overall depth: 39&quot;, Seat depth: 23&quot;, Height: 38&quot;, Width: 39&quot; Sturdy hardwood frame with 100% cow hide leather. An oversized traditional chair with plenty of room for family, friends and pets Let yourself be wrapped in comfort by this extra large seat. Traditional rolled arms and turned wood legs are combined with modern 100% leather upholstery for an update on a classic piece. Its long silhouette means ample space for you and your dog. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Leather Accent Arm Chair, 39&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zv-bpkb6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y-L0ZclhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y-L0ZclhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nb68DxV9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nb68DxV9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"99.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Reclining sofa\",\"label\":\"Reclining sofa\"},{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Saddle brown\",\"label\":\"Saddle brown\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Outdoor sofa\",\"label\":\"Outdoor sofa\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Leather sofa\",\"label\":\"Leather sofa\"},{\"value\":\"Contemporary sofa\",\"label\":\"Contemporary sofa\"},{\"value\":\"Patio sofa\",\"label\":\"Patio sofa\"},{\"value\":\"Futon sofa\",\"label\":\"Futon sofa\"},{\"value\":\"Mid century sofa\",\"label\":\"Mid century sofa\"},{\"value\":\"Glider rocker\",\"label\":\"Glider rocker\"},{\"value\":\"Sofa bedsofa cover\",\"label\":\"Sofa bedsofa cover\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Couch covers for sofa\",\"label\":\"Couch covers for sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Full size bed frame\",\"label\":\"Full size bed frame\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Sofa tables\",\"label\":\"Sofa tables\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Sofa table\",\"label\":\"Sofa table\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":820,\"discountedValue\":738.0}}"
