    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BKKD52Q\",\"sku\":\"B07BKKD52Q\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-velvet-bench-loveseat-sofa-74-w-otter-grey-b07bkkd52q\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Loveseat Sofa, 74&quot;W, Otter Grey\",\"description\":\"This sleek, Mid-century inspired velvet sofa is designed to impress. A long fixed bench seat cushion, two back cushions, tapered wood legs, and smooth bolster pillows provide just the right mix of sophistication with a contemporary edge. 74''W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs. Removable and reversible back seat cushions for easy cleaning. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Bench Loveseat Sofa, 74&quot;W, Otter Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fKl23S3tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mv4QHwnHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mv4QHwnHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rj9axct1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rj9axct1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ewD11e8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16ewD11e8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A0XJ6Gh5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A0XJ6Gh5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c2DFSDUtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c2DFSDUtL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"valu