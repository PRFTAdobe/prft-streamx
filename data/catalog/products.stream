      "content": {
        "bytes": "{\"id\":\"B072PZKCMQ\",\"sku\":\"B072PZKCMQ\",\"lang\":\"en\",\"slug\":\"decatur-modern-tufted-wingback-living-room-accent-chair-32-3-w-silver-b072pzkcmq\",\"name\":\"Decatur Modern Tufted Wingback Living Room Accent Chair, 32.3&quot;W, Silver\",\"description\":\"This contemporary wingback accent chair in Silver looks beautiful while it stands up to the demands of a busy life. Stitch-tufted fabric and gently curved sides bring style and comfort, while durable construction holds up to family, pets and entertaining in your living room. Solid wood frame; upholstered with polyester fabric Minimal assembly; just attach legs Product Dimensions: 32.3&quot;W x 35.8&quot;D x 36.2&quot;H Care Instructions: Avoid moisture and wipe clean with soft, dry cloth Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Decatur Modern Tufted Wingback Living Room Accent Chair, 32.3&quot;W, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1MD60owSSS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19YOERPEDS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19YOERPEDS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LZoqGWSHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LZoqGWSHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14emVzL-CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14emVzL-CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AL0dfyb5S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AL0dfyb5S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+BEO6VnwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+BEO6VnwS.jpg\"}],\"attributes\":[{\"name\":\"height\"