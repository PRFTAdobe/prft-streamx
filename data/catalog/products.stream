    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L7RLQ\",\"sku\":\"B07B4L7RLQ\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-loveseat-57-w-dark-grey-b07b4l7rlq\",\"name\":\"Brandeberry Farmhouse Charles of London Loveseat, 57&quot;W, Dark Grey\",\"description\":\"The classic English roll arm gives this cozy loveseat a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 43&quot;L x 57&quot;W x 38&quot;H Stain-resistant polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Loveseat, 57&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P-z1f-BgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h3ASLUttL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81h3ASLUttL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16YmS8fqiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16YmS8fqiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ha6VGQJZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ha6VGQJZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V8pc0EK6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V8pc0EK6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I95XYNDhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I95