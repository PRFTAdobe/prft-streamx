    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZ3CB\",\"sku\":\"B07QGSZ3CB\",\"lang\":\"en\",\"slug\":\"rivet-isabelle-mid-century-modern-sofa-with-tapered-wood-legs-76-w-aqua-b07qgsz3cb\",\"name\":\"Rivet Isabelle Mid-Century Modern Sofa with Tapered Wood Legs, 76&quot;W, Aqua\",\"description\":\"This sofa’s tapered wood legs and wide, angular arms and back give it a cool, modern look. Its subtle upholstery ensures that it will match the color scheme of most any room that needs additional seating. Foam cushions and a solid hardwood frame lend structure to this comfortable piece. 76&quot;W x 35&quot;D x 35&quot;H; seat height: 17&quot;H; seat depth: 23&quot;D; seat back height: 18&quot;H; arm height: 25&quot;H; leg height: 7&quot;H Solid hardwood frame, tapered wood legs, and 100% polyester fabric Foam-padded cushions add support. The tapered legs add a touch of delicacy to this sturdy piece. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Isabelle Mid-Century Modern Sofa with Tapered Wood Legs, 76&quot;W, Aqua\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71WnUYB4F8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jjtnx69hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jjtnx69hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bmQNyvyjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1bmQNyvyjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Lk4jmvDyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Lk4jmvDyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uX3YXSbGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71uX3YXSbGL.jpg\"},{\"alt\":\"https://storage.