    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MF2NL\",\"sku\":\"B07B4MF2NL\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-mid-century-modern-loveseat-65-w-blue-ink-b07b4mf2nl\",\"name\":\"Rivet Edgewest Low Back Mid-Century Modern Loveseat, 65&quot;W, Blue Ink\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 65&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Mid-Century Modern Loveseat, 65&quot;W, Blue Ink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ych-LUtML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713oLI02I6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713oLI02I6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oYGMVy-cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oYGMVy-cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uQMxgsByL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uQMxgsByL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rVM38isrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rVM38isrL.jpg\"},{\"alt\":\"https://storage.googleapis.co