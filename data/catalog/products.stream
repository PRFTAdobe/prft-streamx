      "content": {
        "bytes": "{\"id\":\"B07B4MGBJD\",\"sku\":\"B07B4MGBJD\",\"lang\":\"en\",\"slug\":\"isabel-traditional-large-storage-ottoman-68-w-slate-grey-b07b4mgbjd\",\"name\":\"Isabel Traditional Large Storage Ottoman, 68&quot;W, Slate Grey\",\"description\":\"67.7&quot;W x 29.5&quot;D x 18.9&quot;H Performance fabric on wood frame Streamlined design fits a modern or transitional room Use as an ottoman, for storage, or as an extra seat. Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty. This ottoman is a multi-tasker, providing a comfy foot rest along with storage space. It can accommodate a tray of snacks or be an extra seat for guests, too. Built to last, its performance fabric will resist stains along with wear and tear.\",\"primaryImage\":{\"alt\":\"Isabel Traditional Large Storage Ottoman, 68&quot;W, Slate Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OFHW4oO1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oXRjyqFUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1oXRjyqFUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SoeGLOekS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k+uDxbKJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k+uDxbKJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LZ37W3gzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LZ37W3gzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mdKVQ4REL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mdKVQ4REL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.75\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"13.75\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.75\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"29.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Slate grey\",\"label\":\"Slate grey\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Storage-ottomans\",\"label\":\"Storage-ottomans\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Large storage ottoman\",\"label\":\"Large storage ottoman\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":564,\"discountedValue\":507.6}}"
