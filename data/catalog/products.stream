    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08555TMQ8\",\"sku\":\"B08555TMQ8\",\"lang\":\"en\",\"slug\":\"rivet-modern-wood-kitchen-counter-bar-stool-29-5-h-black-b08555tmq8\",\"name\":\"Rivet Modern Wood Kitchen Counter Bar Stool, 29.5&quot; H, Black\",\"description\":\"This modern barstool is made of sturdy solid birch with a glossy black finish; it features a contoured seat and no back for a classically minimalist, Scandinavian-inspired profile with maximized style and sophistication. Sturdy, solid birch wood construction for stability. 14.4&quot;D x 17.3”W x 29.5”H Assemble in 15 minutes or less Avoid moisture. Wipe away dust and debris with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Wood Kitchen Counter Bar Stool, 29.5&quot; H, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61GWZiORI0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61REmBvCWrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61REmBvCWrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61l39iL1SpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61l39iL1SpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/619c-buk4eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/619c-buk4eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/510rGRaQdpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/510rGRaQdpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61M+GrCC6XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61M+GrCC6XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-2xXKbY2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/