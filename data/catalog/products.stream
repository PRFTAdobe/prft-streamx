    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWNP22\",\"sku\":\"B07QGWNP22\",\"lang\":\"en\",\"slug\":\"barstool-with-brass-nailhead-trim-43-h-beige-b07qgwnp22\",\"name\":\"Barstool with Brass Nailhead Trim, 43&quot;H, Beige\",\"description\":\"Brushed-brass nailheads add elegance to this transitional barstool. The solid hardwood frame and moisture-repellent fabric with stain resistance are durable and help this stool resist the daily wear and tear that comes with life. The style looks great with most decor, allowing use in most homes. 21&quot;W x 22&quot;D x 43&quot;H; seat height: 30&quot;H; seat depth: 17&quot;D 98% polyester, 2% nylon, solid wood frame Moisture-repellent and stain-resistant fabric with a solid hardwood frame helps keep this barstool looking like new. Brushed nails add elegance to this transitional design, making it perfect for any home or business. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Barstool with Brass Nailhead Trim, 43&quot;H, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oyhnvYVxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912odyfd3jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912odyfd3jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bmKWPiLWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bmKWPiLWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NzGkuJWlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NzGkuJWlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719w+AtIyBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719w+AtIyBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918DR55-QfL.j