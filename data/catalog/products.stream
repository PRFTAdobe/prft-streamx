    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z7HQHY\",\"sku\":\"B075Z7HQHY\",\"lang\":\"en\",\"slug\":\"barrett-reclaimed-wood-6-drawer-desk-71-w-white-and-sandstone-pine-b075z7hqhy\",\"name\":\"Barrett Reclaimed Wood 6-Drawer Desk, 71&quot;W, White and Sandstone Pine\",\"description\":\"Item dimensions: 71”W x 28”D x 30”H Solid, recycled pine wood with natural imperfections for rustic touch Six side drawers provide extra storage. Create an inviting home office with this distinct charming desk. Influenced by early Americana style, it's made of recycled and reclaimed wood with a milky white finish that adds old world charm. Easy assembly - just attach handles. Dust with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Barrett Reclaimed Wood 6-Drawer Desk, 71&quot;W, White and Sandstone Pine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SqRg4ICML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41NH7i+3omL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41NH7i+3omL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41gLcP1JToL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41gLcP1JToL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x9M0vumxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91x9M0vumxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/413BSVRgkPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/413BSVRgkPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XWFtDC-hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XWFtDC-hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1voqY49+QL.jpg\",\"url\":\"https://storage.googleapis.c