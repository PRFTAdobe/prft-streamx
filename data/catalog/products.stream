    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMN185\",\"sku\":\"B075YMN185\",\"lang\":\"en\",\"slug\":\"rivet-2-tiered-industrial-kitchen-rolling-bar-cart-with-wheels-32-3-w-natural-black-b075ymn185\",\"name\":\"Rivet 2-Tiered Industrial Kitchen Rolling Bar Cart with Wheels, 32.3&quot;W, Natural, Black\",\"description\":\"This two-tiered rolling bar cart combines the warmth of natural wood with industrial-style black metal framing. Rolling caster wheels make it easy to move, and two wheel locks allow you to keep it in place. Fill with your favorite beverages and you're ready to host friends for a night of fun. 32.31&quot;W x 15.76&quot;D x 27.78&quot;H Solid fir wood shelves. Metal trim, frame and casters have black finish. Two of the four rotating wheels lock to park the cart just where you want it This versatile piece functions as a mobile bar cart or as an accent table for potted plants or decor Some assembly is required. Clean with a soft, dry cloth Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet 2-Tiered Industrial Kitchen Rolling Bar Cart with Wheels, 32.3&quot;W, Natural, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811MtUhK2fL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wLHLOhwPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wLHLOhwPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pu9INEc7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pu9INEc7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1atvcrkthL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1atvcrkthL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EgLnaoyvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EgLnaoyvL.jpg\"},{\"alt\":\"https://storage.g