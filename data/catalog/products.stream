    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VLP26L\",\"sku\":\"B082VLP26L\",\"lang\":\"en\",\"slug\":\"rivet-alonzo-contemporary-leather-livingroom-accent-chair-39-w-cognac-b082vlp26l\",\"name\":\"Rivet Alonzo Contemporary Leather Livingroom Accent Chair, 39&quot;W, Cognac\",\"description\":\"Sleek, graceful lines combine with modern touches for a vesatile, elegant armchair. A solid-wood frame and strong brass legs offer durability and comfort that will stand the test of time. Overall: 39&quot;W x 37.8&quot;D x 35.4&quot;H. Seat Height: 18.11&quot;H; Seat Depth: 22&quot;D; Seat Back Height: 17.3&quot;H; Arm Height: 23.6&quot;H; Leg Height: 7.1&quot;H Solid-wood frame with brass metal legs and genuine leather upholstery Reversible seat and back cushions Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alonzo Contemporary Leather Livingroom Accent Chair, 39&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pjSc7GHtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71G24+UH8hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71G24+UH8hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719M4V4XeKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719M4V4XeKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uiECKnTOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uiECKnTOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pOGztr2yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pOGztr2yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LnKAYzphL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LnKAYzphL.jpg\"},{\"alt\":\"https://st