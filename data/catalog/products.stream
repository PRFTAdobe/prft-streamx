        "bytes": "{\"id\":\"B07JZKSPY2\",\"sku\":\"B07JZKSPY2\",\"lang\":\"en\",\"slug\":\"9-leg-support-bed-frame-strong-support-for-box-spring-and-mattress-set-tool-free-easy-assembly-king-size-bed-b07jzkspy2\",\"name\":\"9-Leg Support Bed Frame - Strong Support for Box Spring and Mattress Set - Tool-Free Easy Assembly - King Size Bed\",\"description\":\"King bed frame supports a same-size box spring and mattress set (not included) 9 legs (3 rows of 3) and a side-to-side center bar for optimal stability and all-over support Durable steel construction with a sleek black finish Simple lock-together system for easy assembly (no tools needed)\",\"primaryImage\":{\"alt\":\"9-Leg Support Bed Frame - Strong Support for Box Spring and Mattress Set - Tool-Free Easy Assembly - King Size Bed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bGnZ9jo1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hoCcYZRYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hoCcYZRYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61r9c0-OrlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61r9c0-OrlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ffrgf641L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ffrgf641L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61BuADKdiSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61BuADKdiSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714kkda6o5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7