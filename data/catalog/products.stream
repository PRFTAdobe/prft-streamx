    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ8LNNS\",\"sku\":\"B07HZ8LNNS\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-right-facing-loveseat-fabric-52-w-dove-b07hz8lnns\",\"name\":\"Bagley Sectional Component, Right-Facing Loveseat, Fabric, 52&quot;W, Dove\",\"description\":\"This dove-colored sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the right-facing loveseat component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric. Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you. Overall: 52&quot;W x 40&quot;D x 36&quot;H; Seat Height: Seat Depth: 24&quot;D; Seat Back Height: 36&quot;H; Arm Height: 24&quot;H; Leg Height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Right-Facing Loveseat, Fabric, 52&quot;W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61o23LRGVBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aWevuPe-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aWevuPe-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LUMbFdb3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81LUMbFdb3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oNwtzoTCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oNwtzoTCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-kcvE0CNL.jpg\",\"url\":\"https://storage.googleapi