        "bytes": "{\"id\":\"B075YZPMWK\",\"sku\":\"B075YZPMWK\",\"lang\":\"en\",\"slug\":\"rivet-eastport-industrial-wood-nightstand-table-21-7-w-oak-finish-b075yzpmwk\",\"name\":\"Rivet Eastport Industrial Wood Nightstand Table, 21.7&quot;W, Oak Finish\",\"description\":\"84.6&quot;W x 67.2&quot;D x 41&quot;H Handcrafted from solid wood. Modern industrial design of natural pine to blend with modern and rustic styles No boxpring required; mattress sold seperatly. Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. This simply-designed solid pine platform bed with an oak veneer will be a perfect addition to your master suite or any bedroom. The sustainably sourced wood is so beautiful that it speaks for itself, and the rustic oak finish adds subtle warmth and style.\",\"primaryImage\":{\"alt\":\"Rivet Eastport Industrial Wood Nightstand Table, 21.7&quot;W, Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vOkGSY7VL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kdMm5OabL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kdMm5OabL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l5nZ2z1TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l5nZ2z1TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GXKfhdt7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GXKfhdt7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uqPbamgLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h6RuVlIuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h6RuVlIuL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"84.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"67.2\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"132.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Brown\",\"label\":\"Brown\"},{\"value\":\"Metal bunk beds\",\"label\":\"Metal bunk beds\"},{\"value\":\"Wood bunk beds\",\"label\":\"Wood bunk beds\"},{\"value\":\"Wood beds\",\"label\":\"Wood beds\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"King beds\",\"label\":\"King beds\"},{\"value\":\"Trundle beds\",\"label\":\"Trundle beds\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Double beds\",\"label\":\"Double beds\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"},{\"value\":\"King platform beds\",\"label\":\"King platform beds\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Queen bedset\",\"label\":\"Queen bedset\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Metal beds\",\"label\":\"Metal beds\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Single beds\",\"label\":\"Single beds\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"}]}],\"categories\":[{\"id\":\"Nightstands\",\"slug\":\"nightstands\",\"name\":\"Nightstands\"