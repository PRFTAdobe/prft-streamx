    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4WBQR\",\"sku\":\"B075X4WBQR\",\"lang\":\"en\",\"slug\":\"rivet-garfield-mid-century-modern-top-grain-leather-recliner-chair-31-w-aged-black-b075x4wbqr\",\"name\":\"Rivet Garfield Mid-Century Modern Top-Grain Leather Recliner Chair, 31&quot;W, Aged Black\",\"description\":\"31&quot;W x 34.25&quot;D x 34''H Leather upholstery on hardwood frame with brushed brass finish base Modern, low-profile look in a super comfortable classic recliner Free returns for 30 days. 1-year warranty. Not your average bulky recliner, this streamlined leather chair is as comfortable as it is classy. It features top-grain leather on a brushed brass metal base with a cushiony down-filled seat and back that you can sink into at the end of a long day. Simple assembly in 15 minutes or less. Vacuum or wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Garfield Mid-Century Modern Top-Grain Leather Recliner Chair, 31&quot;W, Aged Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ctG7N0z4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xD4czEEdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xD4czEEdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MS9QzQ7oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MS9QzQ7oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X0LZdmnHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X0LZdmnHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917YngO1UZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917YngO1UZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BVFDfnasL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BVFDfnasL.jpg\