      "content": {
        "bytes": "{\"id\":\"B075QDMWTM\",\"sku\":\"B075QDMWTM\",\"lang\":\"en\",\"slug\":\"rivet-payton-tufted-queen-bed-with-storage-drawers-89-4-l-natural-b075qdmwtm\",\"name\":\"Rivet Payton Tufted Queen Bed With Storage Drawers, 89.4&quot; L, Natural\",\"description\":\"This bed is as functional as it is elegant. Subtle tufting in the herringbone fabric gives the headboard and footboard distinctive style. Four drawers underneath provide the perfect place for hiding Christmas gifts or storing off-season clothing. 89.4&quot;L x 66.3&quot;W x 59.8&quot;H 100% polyester fabric Mid-century modern-inspired design with subtle tufting Two drawers on each side are preassembled and easy to slide in Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Payton Tufted Queen Bed With Storage Drawers, 89.4&quot; L, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xVUzCKLpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rDreKeDmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rDreKeDmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bSyCmhn7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bSyCmhn7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19MNuhpzfS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B19MNuhpzfS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wx5MTchkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wx5MTchkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jrSTdi7DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jrSTdi7DL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Hei