    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSLVYPB\",\"sku\":\"B07HSLVYPB\",\"lang\":\"en\",\"slug\":\"lyla-rustic-slat-bed-headboard-king-79-inch-china-gray-b07hslvypb\",\"name\":\"Lyla Rustic Slat Bed Headboard - King, 79 Inch, China Gray\",\"description\":\"This headboard’s grand shutter design can give your bedroom the effortlessly sophisticated look of a European cafe. The grain of the solid hardwood peers through the subtle gray finish, offering a comforting combination of natural texture and neutral tones. 79&quot;W x 3&quot;D x 80&quot;H Made of solid hardwood and finished in a semi-translucent gray that allows some wood grain to be seen The headboard has a vintage European feel and will feel at home in a farmhouse or city loft. This headboard will require a mattress and box spring. A bed frame not included. Assemble in 15-30 minutes Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Lyla Rustic Slat Bed Headboard - King, 79 Inch, China Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81CyWO1wPyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SsHH1vKBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SsHH1vKBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WFGSeS3CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WFGSeS3CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QXHsmJLmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QXHsmJLmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mBGmkOdyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mBGmkOdyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VlSW-hgmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VlSW-h