    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4YDCS\",\"sku\":\"B075X4YDCS\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-accent-chair-32-w-pebble-brown-b075x4ydcs\",\"name\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Pebble Brown\",\"description\":\"A straight back and sloping, low-profile arms are the highlights of this mid-century inspired chair. Assembled in the U.S., it features a sturdy wood frame upholstered with durable, tightly woven fabric for a handsome design that's built to last. This item is made to order just for you 32&quot;W x 33&quot;D x 38&quot;H. Seat height is 19&quot;. Sturdy wood frame, durable polyester fabric, wood legs with walnut finish A Mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Accent Chair, 32&quot;W, Pebble Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sAkV2KnsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17JmBwJmvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17JmBwJmvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yqNrWImiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yqNrWImiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VBhM4JT7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VBhM4JT7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nxIrMTD3S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nxIrMTD3S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LT+lPfpvS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LT+lPfpvS.jp