    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QB8FYS9\",\"sku\":\"B07QB8FYS9\",\"lang\":\"en\",\"slug\":\"industrial-parquetry-top-with-metal-base-side-table-19-69-w-antique-bronze-b07qb8fys9\",\"name\":\"Industrial Parquetry Top with Metal Base Side Table, 19.69&quot;W, Antique Bronze\",\"description\":\"The industrial style of this side table constructed of a metal base topped with solid mango fits with most contemporary decor. The antique bronze with French gray tones of the honeycomb parquetry adds elegance that looks beautiful next to a favorite chair or couch. 19.69&quot;W x 19.69&quot;D x 22.24&quot;H Honeycomb parquetry top in mango and metal base A parquetry top in an antique bronze finish with French gray tones sits on a metal base, giving this industrial piece a casual-chic feel. This side table looks great next to a couch or chair. No assembly required Wipe with a soft, damp cloth; dry thoroughly. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Parquetry Top with Metal Base Side Table, 19.69&quot;W, Antique Bronze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81muGe19tXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XBUXlhA1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XBUXlhA1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jgcdK0Y0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jgcdK0Y0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bl9TYF1rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bl9TYF1rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916YpzGTJHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916YpzGTJHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Rhxmjqf9