    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK59HF\",\"sku\":\"B07BWK59HF\",\"lang\":\"en\",\"slug\":\"andover-right-facing-sofa-chaise-sectional-126-w-driftwood-leather-b07bwk59hf\",\"name\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Driftwood Leather\",\"description\":\"Overall: 126&quot;W x 61&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you. Complete your living space with this stylish sofa-chaise sectional. With its driftwood-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life.\",\"primaryImage\":{\"alt\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Driftwood Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Tc-JKVhAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qWvo8qSWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qWvo8qSWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AxYbtOp4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AxYbtOp4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fsbMIJEuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fsbMIJEuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-im