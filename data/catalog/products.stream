    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ6X7ZF\",\"sku\":\"B07HZ6X7ZF\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-left-facing-sofa-chaise-fabric-41-w-linen-b07hz6x7zf\",\"name\":\"Bagley Sectional Component, Left-Facing Sofa Chaise, Fabric, 41&quot;W, Linen\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the left-facing sofa chaise component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 41&quot;W x 87&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; arm height: 24&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Left-Facing Sofa Chaise, Fabric, 41&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jKemr9e+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ppoMZtOhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ppoMZtOhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WY7F9kn6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WY7F9kn6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PuWhu4DsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PuWhu4DsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i0Gl8S53L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31yCXpCUa+L.jpg\",\"url\":\"https://storage.go