    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3PF\",\"sku\":\"B075X4F3PF\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-velvet-bench-seat-sofa-without-side-pillows-74-w-hunter-green-b075x4f3pf\",\"name\":\"Rivet Aiden Tufted Mid-Century Velvet Bench Seat Sofa, Without Side Pillows, 74&quot;W, Hunter Green\",\"description\":\"This sleek, Mid-century inspired velvet sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 74''W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Velvet Bench Seat Sofa, Without Side Pillows, 74&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810yPhrxugL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NW4rEk4BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NW4rEk4BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qdr-ELgYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qdr-ELgYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FeYIJw5JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FeYIJw5JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j5OV-ZzpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j5OV-ZzpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1PAJJB4dAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Hei