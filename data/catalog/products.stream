    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KM5Q3\",\"sku\":\"B0853KM5Q3\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-counter-height-barstool-38-2-h-stucco-b0853km5q3\",\"name\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Stucco\",\"description\":\"Powerful in its simplicity, this counter-height barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 38.2&quot;H; seat height: 26&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid wood frame with 80% polyester, 20% acrylic fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oDEy0i6rL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tjB7txriL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tjB7txriL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rOXF3ZZNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rOXF3ZZNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XHIORD1NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XHIORD1NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/