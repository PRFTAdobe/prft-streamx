      "content": {
        "bytes": "{\"id\":\"B07B7B244W\",\"sku\":\"B07B7B244W\",\"lang\":\"en\",\"slug\":\"rivet-allie-leather-industrial-mid-century-dining-room-kitchen-chair-33-h-brown-and-black-b07b7b244w\",\"name\":\"Rivet Allie Leather Industrial Mid-Century Dining Room Kitchen Chair, 33&quot;H, Brown and Black\",\"description\":\"Clean lines and one-piece arms-and-leg frames on each side make for a very modern look that could also work in an industrial décor. The compact design helps you fit more guests around the table, while soft top-grain leather adds richness and durability. Overall: 22&quot;W x 24.4&quot;D x 33.4&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 17.7&quot;D; Seat Back: 14&quot;H; Arm: 25.9&quot;H Metal frame with matte black finish; channel-tufted top grain leather, Contemporary design that can blend with modern and industrial décor. Sleek, clean look with a comfortable leather seat No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Allie Leather Industrial Mid-Century Dining Room Kitchen Chair, 33&quot;H, Brown and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DNWOd-5bL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G846WdpTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G846WdpTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q+oPfaqpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q+oPfaqpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zaM3ogOWS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zaM3ogOWS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DIiD4xbSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DIiD4xbSL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"24.4\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"20.9\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Brown leather\",\"label\":\"Brown leather\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":297,\"discountedValue\":267.3}}"
