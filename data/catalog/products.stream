    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZBPK7\",\"sku\":\"B07B4ZBPK7\",\"lang\":\"en\",\"slug\":\"prudence-tufted-king-bed-84-w-spinnsol-indigo-b07b4zbpk7\",\"name\":\"Prudence Tufted King Bed, 84&quot;W, Spinnsol Indigo\",\"description\":\"This bed adds classic style to any space. A hand-tufted headboard adds an interesting design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Prudence Tufted King Bed, 84&quot;W, Spinnsol Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818MacJtTEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oJKHJmBVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oJKHJmBVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814Bjy23GGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814Bjy23GGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818fuLqseYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818fuLqseYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zSHcx8ocL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zSHcx8ocL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918d-tf4qdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918d-tf4qdL.jpg\"},{\"alt\":\"https://storage.googl