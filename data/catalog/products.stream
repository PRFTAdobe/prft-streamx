        "bytes": "{\"id\":\"B07KXF19FN\",\"sku\":\"B07KXF19FN\",\"lang\":\"en\",\"slug\":\"high-back-executive-swivel-office-desk-chair-with-ribbed-puresoft-upholstery-black-lumbar-support-modern-style-b07kxf19fn\",\"name\":\"High-Back Executive Swivel Office Desk Chair with Ribbed Puresoft Upholstery - Black, Lumbar Support, Modern Style\",\"description\":\"High-back executive office chair with 360 degree swivel capability Ergonomic design offers reliable back support for daily use Polished chrome details and durable polyurethane faux leather ribbed upholstery Sturdy five-point base with rolling caster wheels for smooth mobility One-touch height adjustment allows you to easily modify the chair’s height, reducing neck and back strain Durable construction with 275 pound weight capacity\",\"primaryImage\":{\"alt\":\"High-Back Executive Swivel Office Desk Chair with Ribbed Puresoft Upholstery - Black, Lumbar Support, Modern Style\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YCInWiz8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d5YEyu-ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71d5YEyu-ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-QPa4voAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-QPa4voAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61a4cccCkrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61a4cccCkrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eDIUpzEkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eDIUpzEkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xo0TgWgtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xo0TgWgtL.jpg\"}],\"attributes\":[{\"n