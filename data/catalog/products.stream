    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VM9F98\",\"sku\":\"B082VM9F98\",\"lang\":\"en\",\"slug\":\"rivet-alvin-contemporary-livingroom-chair-39-w-aqua-teal-blue-b082vm9f98\",\"name\":\"Rivet Alvin Contemporary Livingroom Chair, 39&quot;W, Aqua Teal Blue\",\"description\":\"If you’re looking for a piece that’s at once modern and timeless, this chair is for you. The button-tufted, fixed back gently curves into a pair of elegant armrests, and the firm, spacious seat cushion adds durability and comfort. Overall: 39&quot;W x 36.6&quot;D x 32.3&quot;H. Seat Height: 18.1&quot;H; Seat Depth: 23.2&quot;D; Seat Back Height: 32&quot;H; Arm Height: 22&quot;H; Leg Height: 7.1&quot;H Solid-wood frame and legs with performance upholstery Modern, simple design that combines Mid-century touches with contemporary Scandinavian appeal Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alvin Contemporary Livingroom Chair, 39&quot;W, Aqua Teal Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OmDotrZ8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NVvUpznnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NVvUpznnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f32w+mfeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f32w+mfeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WCe7jwETL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WCe7jwETL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CegGoVvSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CegGoVvSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kQ6sFvElL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim