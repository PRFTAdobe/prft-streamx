    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZJVP\",\"sku\":\"B07B4FZJVP\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-82-w-grey-linen-b07b4fzjvp\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Grey Linen\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 82&quot;W x 43&quot;D x 39&quot;H; Seat Height: 21&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 37&quot;H; Arm Height: 27&quot;H; Front legs: 5.25&quot;H; Back legs: 4&quot;H Polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 82&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DXL17CFCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mum3SPmqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Mum3SPmqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zGJU0T3rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zGJU0T3rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14jampihNS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14jampihNS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/C1/C1lf45DhhRS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/C1/C1lf45DhhRS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim