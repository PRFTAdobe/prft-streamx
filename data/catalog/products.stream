    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072PZC1PM\",\"sku\":\"B072PZC1PM\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-upholstered-ottoman-bench-63-4-w-dark-grey-b072pzc1pm\",\"name\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman Bench, 63.4&quot;W, Dark Grey\",\"description\":\"This sleek extra-long ottoman can serve as a footstool, an extra place to put a tray of snacks, or a comfortable seat for several of your friends. The tapered solid wood legs and low profile give this a classic mid-century modern style. 63.4&quot;W x 25.6'' D x 15.7''H Solid wood frame and tapered beech legs A retro-looking addition for your living room Simple assembly; just attach legs from the zippered compartment underneath Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman Bench, 63.4&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pVfOVzGiL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wSK4PZQQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wSK4PZQQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sM4KNetXS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sM4KNetXS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17kc+0CHCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17kc+0CHCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qu12Zsx8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qu12Zsx8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"25.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"6