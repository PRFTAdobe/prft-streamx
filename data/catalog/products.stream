        "bytes": "{\"id\":\"B075X2WN27\",\"sku\":\"B075X2WN27\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-leather-accent-chair-35-4-w-cognac-b075x2wn27\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Leather Accent Chair, 35.4&quot;W, Cognac\",\"description\":\"This sleek, mid-century inspired leather chair is designed to impress. A deep seat cushion, back cushion, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 35.4”W x 36.2”D x 30.3”H Soft top-grain leather; solid hardwood frame; tapered wood legs Removable and reversible back cushion for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Leather Accent Chair, 35.4&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DhlhgLNcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vbzx6TXtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Vbzx6TXtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9132MCyTeNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9132MCyTeNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kAkZiyqqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kAkZiyqqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Pv6zL1rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918Pv6zL1rL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"