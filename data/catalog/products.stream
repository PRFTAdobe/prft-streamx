    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDNT1MM\",\"sku\":\"B07QDNT1MM\",\"lang\":\"en\",\"slug\":\"merrill-queen-headboard-with-decorative-nailhead-trim-75-w-dune-b07qdnt1mm\",\"name\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Dune\",\"description\":\"This chic dune-colored queen-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 75&quot;W x 11&quot;D x 52&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill Queen Headboard with Decorative Nailhead Trim, 75&quot;W, Dune\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RXyRemvTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910CRDjEmkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910CRDjEmkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BuyDkn51L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kRYHazYUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kRYHazYUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-wf+1iv7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-wf+1iv7L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"l