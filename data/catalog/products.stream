        "bytes": "{\"id\":\"B07DBGPVMF\",\"sku\":\"B07DBGPVMF\",\"lang\":\"en\",\"slug\":\"ravenna-home-mayes-sloped-nailhead-sofa-87-w-pewter-b07dbgpvmf\",\"name\":\"Ravenna Home Mayes Sloped Nailhead Sofa, 87&quot;W, Pewter\",\"description\":\"This item is made to order just for you Sturdy hardwood frame with durable 100% polyester upholstery; hand-applied nailhead trim Sloped track arms and nailhead trim bring modern updates to a mid-century inspired piece Removable and reversible cushions add durability and keep it looking fresh Free returns for 30 days. 1-year warranty. 38&quot;L x 87&quot;W x 34&quot;H\",\"primaryImage\":{\"alt\":\"Ravenna Home Mayes Sloped Nailhead Sofa, 87&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bLZMtqCSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X5jZmVlQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X5jZmVlQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rt10iyuAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rt10iyuAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819keyESG6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819keyESG6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8xWKZ1DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+8xWKZ1DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tkg0d1HxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tkg0d1HxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"va