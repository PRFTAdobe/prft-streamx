        "bytes": "{\"id\":\"B075Z6YS1Z\",\"sku\":\"B075Z6YS1Z\",\"lang\":\"en\",\"slug\":\"larson-industrial-wood-and-metal-4-shelf-bookcase-73-h-walnut-b075z6ys1z\",\"name\":\"Larson Industrial Wood and Metal 4-Shelf Bookcase, 73&quot;H, Walnut\",\"description\":\"34&quot;W x 14&quot;D x 73.25&quot;H Solid pine wood shelves and top; metal legs Industrial and rustic touches allow this bookshelf to blend with many styles. Four fixed distressed wood shelves with a walnut finish Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. This bookcase has a natural distressed finish, while the metal legs and trim have a darker brown matte finish. With four fixed shelves to provide a display area to for books and photos, this bookshelf will make a simple statement in any room.\",\"primaryImage\":{\"alt\":\"Larson Industrial Wood and Metal 4-Shelf Bookcase, 73&quot;H, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G6aQrK0GL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817sIctCElL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817sIctCElL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yiYGinz5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BL9Hw3nLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BL9Hw3nLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SROi16o2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SROi16o2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rAyU+WrLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rAyU+WrLL.jpg\"}],\"attributes\":[{\"name\":\"height\",