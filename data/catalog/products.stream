        "bytes": "{\"id\":\"B072ZNPRTC\",\"sku\":\"B072ZNPRTC\",\"lang\":\"en\",\"slug\":\"rivet-king-street-industrial-four-drawer-media-console-table-walnut-black-metal-glass-b072znprtc\",\"name\":\"Rivet King Street Industrial Four-Drawer Media Console Table, Walnut, Black Metal, Glass\",\"description\":\"Wooden drawers appear to float, under a tempered glass top, in a metal frame on this modern coffee table. Place your drinks and snacks on top, while storing your remote controls and chargers in the handy drawers underneath. 47.2&quot;L x 15.7&quot;W x 31.5&quot;H Engineered wood, walnut veneer drawers, metal legs and transparent glass top Modern Industrial Two drawers provide storage space No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet King Street Industrial Four-Drawer Media Console Table, Walnut, Black Metal, Glass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gN8GiP-RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JU6m9Y3ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JU6m9Y3ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sAwNqp1wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sAwNqp1wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j5rk9kYXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81j5rk9kYXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X2C0v3dFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X2C0v3dFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HzT1XeLPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1HzT1XeLPL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"va