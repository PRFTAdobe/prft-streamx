    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7SMYQ\",\"sku\":\"B07HZ7SMYQ\",\"lang\":\"en\",\"slug\":\"blaine-modern-ottoman-36-2-w-light-gray-b07hz7smyq\",\"name\":\"Blaine Modern Ottoman, 36.2&quot;W, Light Gray\",\"description\":\"Add traditional elegance to your living room with this light-gray ottoman. The solid-wood frame and polyester upholstery make this ottoman both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Solid-wood frame and legs with 100% polyester upholstery This compact, durable ottoman is wrapped in high-density foam. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you. Overall: 36.2&quot;W x 24.4&quot;D x 18.9&quot;H; Seat Height: 18.9&quot;H; Seat Depth: 24.4&quot;D; Seat Back Height: 15&quot;H; Leg Height: 4.9&quot;H\",\"primaryImage\":{\"alt\":\"Blaine Modern Ottoman, 36.2&quot;W, Light Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k8Zv0zX4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lcqIogYvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lcqIogYvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eXpmUW-3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eXpmUW-3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913yTEMiPxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913yTEMiPxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UHWGtoEQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UHWGtoEQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pj8B77bzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Pj8B77bzL.jpg\"}],\"attributes\":[{\"name\":\"height\