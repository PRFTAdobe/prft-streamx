    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B21QY\",\"sku\":\"B07B7B21QY\",\"lang\":\"en\",\"slug\":\"modern-farmhouse-kitchen-counter-height-wood-stools-set-of-2-40-5-h-distressed-grey-b07b7b21qy\",\"name\":\"Modern Farmhouse Kitchen Counter-Height Wood Stools, Set of 2, 40.5&quot;H, Distressed Grey\",\"description\":\"This set of two stools match the Stone & Beam Grace kitchen island, or can be used anywhere you need extra counter-height seating. The distressed white-wash finish makes them ideal for a modern farmhouse kitchen. 21.375&quot;W x 18.75&quot;D x 40.5&quot;H Hardwood and fiberboard with distressed grey finish and fabric seats Traditional design make these chairs ideal for a transitional area or farmhouse kitchen Counter height stools are handy for any kitchen in need of extra seating at an island or task area Assemble in 30 minutes to an hour Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Farmhouse Kitchen Counter-Height Wood Stools, Set of 2, 40.5&quot;H, Distressed Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HTEauK-iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jVGfrw2ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jVGfrw2ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911hlYqb7NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911hlYqb7NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NMw9B2moL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NMw9B2moL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GP5wv8skL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GP5wv8skL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Dk+UWm47L.jpg\",\"url\":\"https://storage.googlea