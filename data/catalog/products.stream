        "bytes": "{\"id\":\"B075YQXR7T\",\"sku\":\"B075YQXR7T\",\"lang\":\"en\",\"slug\":\"elden-nailhead-trim-saddle-kitchen-counter-height-backless-stool-26-h-hemp-b075yqxr7t\",\"name\":\"Elden Nailhead-Trim Saddle Kitchen Counter-Height Backless Stool, 26&quot;H, Hemp\",\"description\":\"The brushed brass nailhead trim adds a handsome accent to this modern farmhouse counter stool. Tall sturdy wood legs provide stability, and performance fabric holds up to a busy family's wear and tear. 14.2&quot;W x 19.7&quot;D x 26&quot;H 95% polyester/5% nylon performance fabric on wood frame, solid wood legs Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elden Nailhead-Trim Saddle Kitchen Counter-Height Backless Stool, 26&quot;H, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814FvWtf-zL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XrNrI2RjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XrNrI2RjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LSkze2gJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LSkze2gJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pxXKnoX3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pxXKnoX3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11Wai8F4qS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11Wai8F4qS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D-GXfYKLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D-GXfYKLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"v