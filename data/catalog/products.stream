    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP4WY5\",\"sku\":\"B075YP4WY5\",\"lang\":\"en\",\"slug\":\"rivet-rachel-set-of-2-space-age-modern-mid-century-dining-kitchen-swivel-chairs-35-2-inch-height-synthetic-leather-charcoal-grey-b075yp4wy5\",\"name\":\"Rivet Rachel Set of 2 Space-Age Modern Mid-Century Dining Kitchen Swivel Chairs, 35.2 Inch Height, Synthetic Leather, Charcoal Grey\",\"description\":\"With a look straight out of The Jetsons TV show, these chairs exude the mid-century space-age era. Enjoy swiveling 360 degrees at the dining room table or in the living room. Geometric stitching and legs in a starburst shape add to the fun style. 22.9&quot;W x 20.1&quot;D x 35.2&quot;H. Seat height is 19.7&quot;. Distressed synthetic leather on wood frame; metal legs with black finish Chairs swivel; Light enough to move from room to room for multi-tasking. Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Rachel Set of 2 Space-Age Modern Mid-Century Dining Kitchen Swivel Chairs, 35.2 Inch Height, Synthetic Leather, Charcoal Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81v1bFoUO7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwPw2DUdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hwPw2DUdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eNeGk5DiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eNeGk5DiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lMxlTOhNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lMxlTOhNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bJWURZ+dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bJWURZ+dL.jpg\"},{\"alt\":\"https://storage.