        "bytes": "{\"id\":\"B071J7Q6KD\",\"sku\":\"B071J7Q6KD\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-armchair-with-tapered-legs-33-w-grey-weave-b071j7q6kd\",\"name\":\"Rivet Revolve Modern Upholstered Armchair with Tapered Legs, 33&quot;W, Grey Weave\",\"description\":\"This modern armchair features simple lines and square armrests atop tall tapered legs, giving it a minimalist look that pairs well with most decor styles 32.7&quot;W x 34.6&quot;D x 35.4&quot;H Hardwood frame, solid beech wood legs and durable polyester upholstery stand up to wear and tear Assemble in 15 minutes or less, just attach the legs that come zippered inside the product Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-Year Warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Armchair with Tapered Legs, 33&quot;W, Grey Weave\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MyhDVP8sL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aJWTbVvZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aJWTbVvZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1veSB4ANVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1veSB4ANVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OiCakq-CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OiCakq-CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s6WJFhuTS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s6WJFhuTS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"32.