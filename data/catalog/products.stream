    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VW7N\",\"sku\":\"B075X4VW7N\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-loveseat-58-w-blue-eclipse-b075x4vw7n\",\"name\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Blue Eclipse\",\"description\":\"This item is made to order just for you Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. 58&quot;W x 34&quot;D x 34&quot;H No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Loveseat, 58&quot;W, Blue Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MMHP1pzdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14X81XAAJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14X81XAAJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910g5SB+eAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910g5SB+eAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XKXpufMyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XKXpufMyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LWZiMmaDS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1LWZiMmaDS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"58.0\"