    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDKRC5\",\"sku\":\"B082QDKRC5\",\"lang\":\"en\",\"slug\":\"rivet-bayard-contemporary-leather-couch-with-curved-back-and-armrests-76-w-cognac-b082qdkrc5\",\"name\":\"Rivet Bayard Contemporary Leather Couch with Curved Back and Armrests, 76&quot;W, Cognac\",\"description\":\"Tapered legs, a rounded back and armrests, and a chic cognac-colored genuine leather upholstery give this couch a contemporary feel, but this design is classic enough to blend with any decor. A solid wood frame and foam padding in the cushions make it a sturdy and comfortable place to relax. 76.0&quot;W x 34.3&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 21.2&quot;D; seat back height: 16.53&quot;H; arm height: 24.8&quot;H; leg height: 8.27&quot;H Solid wood frame, genuine leather upholstery This couch combines chic, contemporary design elements in a classic structure, making it the perfect fit wherever you need seating. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Bayard Contemporary Leather Couch with Curved Back and Armrests, 76&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71S4wHLPOwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71A5j6fKGzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71A5j6fKGzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fClfcFj9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fClfcFj9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ma0zlaBoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight