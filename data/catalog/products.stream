  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQFPL\",\"sku\":\"B07QBMQFPL\",\"lang\":\"en\",\"slug\":\"hillman-mid-century-living-room-chair-with-wood-base-and-legs-39-w-fog-gray-b07qbmqfpl\",\"name\":\"Hillman Mid-Century Living Room Chair with Wood Base and Legs, 39&quot;W, Fog Gray\",\"description\":\"Wide, comfortable cushions are a hallmark of this mid-century inspired love seat. Easy-care gray upholstery and reversible back cushions help keep this piece looking fresh. A hardwood frame connects to tapered wood legs and lends structure to the foam-padded cushions. High arms give additional support. 39&quot;W x 38&quot;D x 33&quot;H; seat height: 18&quot;H; seat depth: 21&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 8&quot;H Solid hardwood frame, tapered wood legs, and 85% polyester and 15% acrylic performance fabric Removable and reversible back and throw cushions Classic shape and plush cushions make this chair work in a variety of decors. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hillman Mid-Century Living Room Chair with Wood Base and Legs, 39&quot;W, Fog Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wsO8B3EHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WjEyCLQZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WjEyCLQZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vixX3VMaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vixX3VMaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qxeHId5QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qxeHId5QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xsLwQBtOL.jpg\",\"url\":\"https://storage.googleapi