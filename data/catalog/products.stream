        "bytes": "{\"id\":\"B07QCQ1MMQ\",\"sku\":\"B07QCQ1MMQ\",\"lang\":\"en\",\"slug\":\"ravenna-home-haraden-modern-scroll-topped-queen-headboard-with-nailhead-trim-62-w-beige-b07qcq1mmq\",\"name\":\"Ravenna Home Haraden Modern Scroll-Topped Queen Headboard with Nailhead Trim, 62&quot;W, Beige\",\"description\":\"62&quot;W x 3.5&quot;D x 46&quot;H Durable polyester fabric on wood frame; metal legs with a black finish Contemporary design with a wood frame upholstered in beige fabric; metal legs Foam padding and an elastic suspension system keep the headboard supportive and springy. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. Avoid moisture. Wipe clean with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Ravenna Home Haraden Modern Scroll-Topped Queen Headboard with Nailhead Trim, 62&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uDt-9omtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zoDRGo6cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zoDRGo6cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MBVUC4ZPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MBVUC4ZPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nxriJVA1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nxriJVA1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811V17-uW4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811V17-uW4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bk6u2BgiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bk6u2BgiL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"3.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"46.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"28.042513\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Wall\",\"label\":\"Wall\"},{\"value\":\"Boards\",\"label\":\"Boards\"},{\"value\":\"Platform\",\"label\":\"Platform\"},{\"value\":\"Size\",\"label\":\"Size\"},{\"value\":\"Leather\",\"label\":\"Leather\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Cama\",\"label\":\"Cama\"},{\"value\":\"Stone\",\"label\":\"Stone\"},{\"value\":\"Full\",\"label\":\"Full\"},{\"value\":\"Beam\",\"label\":\"Beam\"},{\"value\":\"Backboard\",\"label\":\"Backboard\"},{\"value\":\"Board\",\"label\":\"Board\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Mounted\",\"label\":\"Mounted\"},{\"value\":\"Faux\",\"label\":\"Faux\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Headboards\",\"label\":\"Headboards\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Frames\",\"label\":\"Frames\"},{\"value\":\"Head\",\"label\":\"Head\"},{\"value\":\"Bookcase\",\"label\":\"Bookcase\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"California\",\"label\":\"California\"},{\"value\":\"Espaldar\",\"label\":\"Espaldar\"},{\"value\":\"Adjustable\",\"label\":\"Adjustable\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Twin\",\"label\":\"Twin\"},{\"value\":\"Footboard\",\"label\":\"Footboard\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Zinus\",\"label\":\"Zinus\"},{\"value\":\"Cabeceras\",\"label\":\"Cabeceras\"},{\"value\":\"Padded\",\"label\":\"Padded\"},{\"value\":\"Tufted\",\"label\":\"Tufted\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\"