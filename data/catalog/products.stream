    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N4Z5\",\"sku\":\"B075X4N4Z5\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-chair-33-w-blackwood-b075x4n4z5\",\"name\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Blackwood\",\"description\":\"This item is made to order just for you 33&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Tight, padded back with a removable seat cushion makes it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling up with a good book on this sophisticated chair. A sleek back, angled arms, a removable seat cushion and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Chair, 33&quot;W, Blackwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1r3udKRbyS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NDTfxvxdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NDTfxvxdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16rfMQnyuS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16rfMQnyuS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CWdIeH8PS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L345S5ABL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L345S5ABL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\"