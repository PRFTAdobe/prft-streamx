    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GVRXK\",\"sku\":\"B07B4GVRXK\",\"lang\":\"en\",\"slug\":\"andover-modern-right-l-sectional-sofa-124-w-linen-b07b4gvrxk\",\"name\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Linen\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H 80% cotton/20% polyester blend fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a3BCUxBbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q+mia7kML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q+mia7kML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dj5d+iTgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dj5d+iTgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710xm4YjElL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710xm4YjElL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QR8sUuJRL.jpg\",\"url\":\"https://storage.googleapis.