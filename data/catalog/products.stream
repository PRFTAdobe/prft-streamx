    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGSZ78G\",\"sku\":\"B07QGSZ78G\",\"lang\":\"en\",\"slug\":\"abigail-sofa-couch-86-w-haze-b07qgsz78g\",\"name\":\"Abigail Sofa Couch, 86&quot;W, Haze\",\"description\":\"Comfort meets class in this attractive transitional-style sofa. The angular shape makes a statement in your home decor, and four dark-colored legs add elegance to the piece. The back and seat cushions are reversible to prolong the life of this sofa. 86&quot;W x 41&quot;D x 35&quot;H; seat height: 20&quot;H; seat depth: 40&quot;D; seat back height: 15&quot;H; arm height: 25&quot;H; leg height: 1.5&quot;H Sturdy wood frame with rich 100% top grain leather The removable seat and back cushions ensure durability and comfort. Classy angular design pairs well with contemporary-style home decor. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Abigail Sofa Couch, 86&quot;W, Haze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MfZem3e6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F-pL+2zDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DP5toRwvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DP5toRwvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D+cRBUg8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91D+cRBUg8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Hk10LqU6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Hk10LqU6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wq4b6vuAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori