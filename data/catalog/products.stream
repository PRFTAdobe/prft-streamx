    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4L563M\",\"sku\":\"B07B4L563M\",\"lang\":\"en\",\"slug\":\"andover-modern-right-l-sectional-sofa-124-w-grey-b07b4l563m\",\"name\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Grey\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vvVkhNhYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Bg34BOvfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Bg34BOvfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rQbtA-wDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rQbtA-wDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y+kt9nNsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y+kt9nNsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yB7SOh0IS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yB7SOh0IS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1i9cUpMk1S.jpg\",\"url\":\"https://storage.googleapis.com/p