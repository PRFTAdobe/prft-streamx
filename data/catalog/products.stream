      "content": {
        "bytes": "{\"id\":\"B075X61WKJ\",\"sku\":\"B075X61WKJ\",\"lang\":\"en\",\"slug\":\"norah-leather-and-wood-round-ottoman-39-5-saddle-brown-b075x61wkj\",\"name\":\"Norah Leather and Wood Round Ottoman, 39.5&quot;, Saddle Brown\",\"description\":\"This simple but stylish round ottoman is designed to blend with most any decor. The wood frame has a light oak finish for a rustic touch, with a smooth top-grain leather upholstered top. Use as a foot stool or extra seat for guests. 39.5'' Diameter x 17.25''H 100% top-grain leather on wood frame. Use as a resting place for tired feet, a snack tray, or an extra guest No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Norah Leather and Wood Round Ottoman, 39.5&quot;, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91X+8Y0xhyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MCesN-faL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MCesN-faL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mdgsctO3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mdgsctO3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gw1bHlK7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gw1bHlK7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RUUWdsBaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RUUWdsBaL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"17.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\"