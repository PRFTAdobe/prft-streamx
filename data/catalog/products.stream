  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853L359H\",\"sku\":\"B0853L359H\",\"lang\":\"en\",\"slug\":\"rivet-lundberg-contemporary-upholstered-barstool-with-brass-legs-44-5-h-graphite-b0853l359h\",\"name\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Graphite\",\"description\":\"Comfort and style meet in this contemporary barstool. Feather-filled cushions and open sides provide maximum comfort, while the graphite-colored upholstery and brass legs display a spare, contemporary style. These barstools coordinate well with any modern interior decor. Solid wood frame; feather-filled upholstered cushions; brass base Classic brass legs and footrest, plus the open sides, allow for maximum freedom of movement. Feather-filled cushion provides comfort and a contemporary look at the same time. Classic brass metal base has a footrest for added stability. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty 18.1&quot;W x 22.4&quot;D x 44.5&quot;H; seat height: 29.9&quot;H; seat depth: 12.6&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Lundberg Contemporary Upholstered Barstool with Brass Legs, 44.5&quot;H, Graphite\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815fW2whAYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oiRGjmtPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oiRGjmtPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AlC6mq0ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AlC6mq0ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718h61q8RFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718h61q8RFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JJ