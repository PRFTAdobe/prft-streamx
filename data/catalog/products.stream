    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQH5B\",\"sku\":\"B07QBMQH5B\",\"lang\":\"en\",\"slug\":\"rivet-asher-modern-storage-ottoman-15-75-w-fabric-pink-b07qbmqh5b\",\"name\":\"Rivet Asher Modern Storage Ottoman, 15.75&quot;W, Fabric, Pink\",\"description\":\"Complete your modern-style interior decorating with this tastefully elegant ottoman. With a sleek design and a storage compartment under its lid, this ottoman is an ideal combination of style, comfort, and functionality. 15.75&quot;W x 15.75&quot;D x 16&quot;H; seat height: 16&quot;H; seat depth: 15.75&quot;D Solid-wood frame with 100% polyester upholstery Storage ottoman with comfortable pink fabric This ottoman's simple elegance perfectly complements a modern-style room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Asher Modern Storage Ottoman, 15.75&quot;W, Fabric, Pink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1btWfpEBcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jk73goFTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Jk73goFTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sonnFRtpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sonnFRtpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c7ahs4paL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91c7ahs4paL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Gm4uIRF1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Gm4uIRF1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bTv7I+URL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bTv7I+URL.jpg\"},{\"alt\":\"https://storage.go