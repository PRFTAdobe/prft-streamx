    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWK58D9\",\"sku\":\"B07BWK58D9\",\"lang\":\"en\",\"slug\":\"andover-modern-right-u-sectional-sofa-134-w-linen-b07bwk58d9\",\"name\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Linen\",\"description\":\"With sturdy frames and reversible cushions, this roomy sectional is durable for years of TV watching, bouncing kids and lounging pets. The streamlined design and track arms bring stylish sophistication to a modern or transitional room. 134&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H 80% Cotton/20% Polyester on hardwood pine frame; wooden legs with dark walnut finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right U-Sectional Sofa, 134&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OkgzwPxxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1514nPQWpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1514nPQWpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AoGNhXvSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n18MaBuSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n18MaBuSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vKPOhVWEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vKPOhVWEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MU42clJeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MU42clJeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"H