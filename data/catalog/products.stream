    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QC876YV\",\"sku\":\"B07QC876YV\",\"lang\":\"en\",\"slug\":\"rivet-modern-storage-ottoman-side-table-17-13-w-birch-veneer-with-a-white-top-b07qc876yv\",\"name\":\"Rivet Modern Storage Ottoman Side Table, 17.13&quot;W, Birch Veneer with a White Top\",\"description\":\"The versatility of this contemporary accent piece makes it perfect for any home. The octagonal shape and natural birch grain draw the eye to its beauty, while the interior storage adds functionality. Used as a stool, side table, or small ottoman, the possibilities are endless. 17.13&quot;W x 17.13&quot;D x 18&quot;H MDF, birch veneer, and hardwood A dual-tone finish and geometric design add a modern flair to this stylish accent piece. This accent piece offers interior storage and can be used as a side table, stool, or ottoman. No assembly required Wipe with a soft, damp cloth in the direction of the grain. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Storage Ottoman Side Table, 17.13&quot;W, Birch Veneer with a White Top\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Ag20sARxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mglvk8QaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mglvk8QaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811rIKl11AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/811rIKl11AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wpFNDK2FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wpFNDK2FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ySDTn0jhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ySDTn0jhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NLqnVJ55L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61NLqnVJ55L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.13\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"17.13\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"23.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Prime\",\"label\":\"Prime\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Cherry\",\"label\":\"Cherry\"},{\"value\":\"Wheels\",\"label\":\"Wheels\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Nightstand\",\"label\":\"Nightstand\"},{\"value\":\"Stands\",\"label\":\"Stands\"},{\"value\":\"Entryway\",\"label\":\"Entryway\"},{\"value\":\"Corner\",\"label\":\"Corner\"},{\"value\":\"Bedside\",\"label\":\"Bedside\"},{\"value\":\"Mirrored\",\"label\":\"Mirrored\"},{\"value\":\"Dressers\",\"label\":\"Dressers\"},{\"value\":\"Sets\",\"label\":\"Sets\"},{\"value\":\"Console\",\"label\":\"Console\"},{\"value\":\"Tables\",\"label\":\"Tables\"},{\"value\":\"Powered\",\"label\":\"Powered\"},{\"value\":\"Folding\",\"label\":\"Folding\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"That\",\"label\":\"That\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Tv\",\"label\":\"Tv\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Usb\",\"label\":\"Usb\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Lamps\",\"label\":\"Lamps\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Espresso\",\"label\":\"Espresso\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Snack\",\"label\":\"Snack\"},{\"valu