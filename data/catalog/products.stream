    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TZQZ1DJ\",\"sku\":\"B07TZQZ1DJ\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-bar-stool-41-h-navy-velvet-b07tzqz1dj\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Navy Velvet\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x41&quot;H | Seat height is 30&quot;. This bar stool's padded arms, back and padded swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a mid-century style statement piece in your home. Durable performance velvet on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Navy Velvet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ht5+9BmSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kTWSl9DHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kTWSl9DHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wtsmsKYZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wtsmsKYZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61PhCgYWywL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61PhCgYWywL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jP4oxVhHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jP4oxVhHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cRtUdnnzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cRtUdnnzL.jpg\"},{\"alt\":\"https:/