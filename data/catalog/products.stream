    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PRYX\",\"sku\":\"B075X4PRYX\",\"lang\":\"en\",\"slug\":\"marin-upholstered-ottoman-29-w-pewter-b075x4pryx\",\"name\":\"Marin Upholstered Ottoman, 29&quot;W, Pewter\",\"description\":\"This item is made to order just for you 29&quot;W x 23&quot;D x 21&quot;H Sturdy hardwood frame with 80% cotton/20% polyester upholstery Firm nylon webbing makes cushion resilient Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Sit back, relax, and prop up your feet on this plush ottoman. This sophisticated yet practical addition to your home can be an extra seat or place to set a tray of snacks. The sturdy frame and upholstery will last for many years.\",\"primaryImage\":{\"alt\":\"Marin Upholstered Ottoman, 29&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rdhSz6tnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91utnEThZ3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91utnEThZ3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F+zMrMqSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F+zMrMqSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Z+4BNZSIS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1Z+4BNZSIS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AYUhiiMBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AYUhiiMBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Storage-ottomans\",\"label\":\"Storage-ottomans\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pewter\",\"label\":\"Pewter\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Grey\",\"label\":\"Grey\"}]}],\"categories\":[{\"id\":\"Accent Furniture\",\"slug\":\"accent-furniture\",\"name\":\"Accent Furniture\",\"value\":\"Accent Furniture\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":295,\"discountedValue\":265.5}}"
