    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7PFW4\",\"sku\":\"B07HZ7PFW4\",\"lang\":\"en\",\"slug\":\"blaine-modern-sleeper-sofa-bed-78-w-beige-b07hz7pfw4\",\"name\":\"Blaine Modern Sleeper Sofa Bed, 78&quot;W, Beige\",\"description\":\"Add mid-century elegance to your living room with this beige sofa bed. The solid-wood frame and polyester upholstery make this sofa bed both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 78&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 21.7&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you\",\"primaryImage\":{\"alt\":\"Blaine Modern Sleeper Sofa Bed, 78&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wvuioatdL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mxl1w5fRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Mxl1w5fRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G77MD845L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G77MD845L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rNi85ukCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rNi85ukCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lYiPjQO4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lYiPjQO4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cTqcE6k7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81c