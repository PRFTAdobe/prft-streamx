    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08555N6YQ\",\"sku\":\"B08555N6YQ\",\"lang\":\"en\",\"slug\":\"rivet-modern-wood-counter-height-kitchen-bar-stool-24-h-black-b08555n6yq\",\"name\":\"Rivet Modern Wood Counter-Height Kitchen Bar Stool, 24&quot; H, Black\",\"description\":\"This modern counter-height barstool is made of sturdy solid birch with a glossy black finish; it features a contoured seat and no back for a classically minimalist, Scandinavian-inspired profile with maximized style and sophistication. Sturdy, solid birch wood construction for stability. 14.4&quot;D x 17.3”W x 24.2”H Assemble in 15 minutes or less Avoid moisture. Wipe away dust and debris with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Wood Counter-Height Kitchen Bar Stool, 24&quot; H, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71SFQWgFO9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jrwLwS8rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61jrwLwS8rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61X93ziZMxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61X93ziZMxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/21/21ywUm4h+iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/21/21ywUm4h+iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61o3d3jWxrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61o3d3jWxrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fw5JHJPPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fw5JHJPPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61+evl1YRkL.jpg\",\"url\":\"https://storage.googleapis.com/pur