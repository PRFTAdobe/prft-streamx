    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STJ2T\",\"sku\":\"B07P8STJ2T\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sofa-with-tapered-wood-legs-74-w-wathet-blue-b07p8stj2t\",\"name\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 74&quot;W, Wathet Blue\",\"description\":\"This sofa features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive blue fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 74&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs Removable and reversible back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 74&quot;W, Wathet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bV-VaZl0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VOcw9pNGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VOcw9pNGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zgX-LPfAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zgX-LPfAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DlhoAkFYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DlhoAkFYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Te3vtka5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Te3vtka5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ClrBuuJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/