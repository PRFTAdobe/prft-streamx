        "bytes": "{\"id\":\"B072PZVY9J\",\"sku\":\"B072PZVY9J\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-upholstered-ottoman-bench-63-4-w-light-grey-b072pzvy9j\",\"name\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman Bench, 63.4&quot;W, Light Grey\",\"description\":\"This handsome ottoman can serve as a footstool, an extra place to put a tray of snacks, or a comfortable seat for several of your friends. The tapered solid wood legs and low profile give this a classic mid-century modern style. 63.4&quot;W x 25.6'' D x 15.7''H Solid wood frame with tapered beech legs A retro-looking addition for your living room Simple assembly; just attach legs from the zippered compartment underneath Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman Bench, 63.4&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X2Z2kB6kL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zXhzSHEWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zXhzSHEWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IcH+JhFXS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1IcH+JhFXS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgOkaq6wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgOkaq6wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uRD521CuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uRD521CuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lATi7xncL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lATi7xncL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"labe