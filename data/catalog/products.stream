    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831XJQMC\",\"sku\":\"B0831XJQMC\",\"lang\":\"en\",\"slug\":\"lyon-upholstered-sofa-couch-94-w-steel-b0831xjqmc\",\"name\":\"Lyon Upholstered Sofa Couch, 94&quot;W, Steel\",\"description\":\"This steel-gray upholstered sofa couch brings a crisp, modern style to your living room with a distinctive flair. Fully padded seat and back cushions provide long-lasting comfort while out-slanting arms allow plenty of freedom of movement. Easy-care, durable performance fabric makes cleaning a snap. 94&quot;W x 38&quot;D x 37&quot;H; seat height: 21.5&quot;H; seat depth: 23.5&quot;D; seat back height: 30.5&quot;H; arm height: 30.5&quot;H; leg height: 6&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Lyon Upholstered Sofa Couch, 94&quot;W, Steel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IcJ9xRzwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81076V+6zTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81076V+6zTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ef-g+brCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ef-g+brCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916gbziqIeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916gbziqIeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1oPKKhW1-S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1oPKKhW1-S.jpg\"},{\"alt\":\"h