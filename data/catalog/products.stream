    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P7NVGWX\",\"sku\":\"B07P7NVGWX\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-living-room-accent-armchair-with-hardwood-frame-46-w-pearl-b07p7nvgwx\",\"name\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Pearl\",\"description\":\"Dimensions: 46&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this armchair offers plush support and security. Neutral pearl-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Living Room Accent Armchair with Hardwood Frame, 46&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91stkFf0unL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xa6FeSkWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xa6FeSkWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wfQlRbzTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wfQlRbzTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DR9f9dwSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DR9f9dwSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WSDlHz0JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WSDlHz0JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nHPvBqGQL.jpg\",\"url\":\"https://storage.googleap