    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082PCPQS9\",\"sku\":\"B082PCPQS9\",\"lang\":\"en\",\"slug\":\"rivet-sheena-glam-tufted-velvet-shell-chair-23-5-w-teal-b082pcpqs9\",\"name\":\"Rivet Sheena Glam Tufted Velvet Shell Chair, 23.5&quot;W, Teal\",\"description\":\"This teal-velvet upholstered accent chair has a padded seat and wide shell-like back that will keep you lounging and relaxing in plush, cushioned comfort. Splayed tapering metal legs with a golden finish ensure added stability and style. 23.5&quot;W x 26&quot;D x 32.25&quot;H; seat height: 18.5&quot;H; seat depth: 19.5&quot;D; seat back height: 21.5&quot;H; leg height: 11&quot;H Sturdy metal legs support foam cushioning covered in durable yet indulgent velvet upholstery. The soft velvet upholstery offers a rich, luxe appeal, making this accent chair equally perfect for your living room, home office, or bedroom. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sheena Glam Tufted Velvet Shell Chair, 23.5&quot;W, Teal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715DNvMfRfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gM+UCT0NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gM+UCT0NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JuN4BzqdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JuN4BzqdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712jGw9lHpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712jGw9lHpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oU0r-vRXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oU0r-vRXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-i