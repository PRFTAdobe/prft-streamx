    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LM3LT\",\"sku\":\"B07P5LM3LT\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-sofa-couch-with-hardwood-frame-89-w-chocolate-b07p5lm3lt\",\"name\":\"Lauren Down-Filled Oversized Sofa Couch with Hardwood Frame, 89&quot;W, Chocolate\",\"description\":\"Dimensions: 89&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this sofa offers plush support and security. Neutral chocolate-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Sofa Couch with Hardwood Frame, 89&quot;W, Chocolate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-9KESU6+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fMfKLppuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fMfKLppuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1--F+eU2OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1--F+eU2OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-40PL1HSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-40PL1HSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uaEJ30R6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1uaEJ30R6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dZRzWg7ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81