    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PRPS\",\"sku\":\"B075X4PRPS\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-tufted-customizable-daybed-sofa-78-w-rain-amp-black-b075x4prps\",\"name\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Rain &amp; Black\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and blackened pewter metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. This stylish piece can serve as a daybed and loveseat. Upholstered in a subtle off-white and teal pattern, it features a long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish, making it perfect for any room. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Tufted Customizable Daybed Sofa, 78&quot;W, Rain &amp; Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91s1MaOfqWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919HlwJVnPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919HlwJVnPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10lB188m5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A10lB188m5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1h63e7uZrS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1h63e7uZrS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VnsEojCFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VnsEojCFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1X4JvM2UQS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origin