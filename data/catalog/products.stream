      "content": {
        "bytes": "{\"id\":\"B072ZK2FZ6\",\"sku\":\"B072ZK2FZ6\",\"lang\":\"en\",\"slug\":\"rivet-industrial-modern-wood-and-metal-coffee-table-31-5-w-walnut-b072zk2fz6\",\"name\":\"Rivet Industrial Modern Wood and Metal Coffee Table, 31.5&quot;W, Walnut\",\"description\":\"You'll enjoy resting your glass or remote control on this eclectic, industrial-style coffee table as you kick back and relax. Its compact size is ideal for a smaller space in front of a sofa, and perfect for serving snacks at your next party. 31.5&quot;W x15&quot;D x 23.2&quot;H Solid hardwood top with walnut finish; metal legs with black matte finish Wood and metal are combined for a chic industrial look Compact size is ideal for a smaller room in front of a sofa Easy assembly in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Industrial Modern Wood and Metal Coffee Table, 31.5&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SzvTdu6mL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XXhGj71lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XXhGj71lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JUFiOdPFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JUFiOdPFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H5pY404CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81H5pY404CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pAJMz2hLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pAJMz2hLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D5qnxDX+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1D5qnxDX+L.jpg\"}],\"attributes\"