        "bytes": "{\"id\":\"B07R1JT4JL\",\"sku\":\"B07R1JT4JL\",\"lang\":\"en\",\"slug\":\"retro-hairpin-compact-computer-desk-washed-grey-with-black-legs-b07r1jt4jl\",\"name\":\"Retro Hairpin Compact Computer Desk - Washed Grey with Black Legs\",\"description\":\"Mid-century modern-inspired desk for offices, studios, bedrooms, or anywhere desk space is needed Hairpin-style powder-coated metal legs add style and stability Ideal for computer work, writing, as a vanity, console table, and more Slim, minimal design saves space while offering an ample work area Sturdy MDF wood plank desk surface Easy assembly with provided hardware and instructions\",\"primaryImage\":{\"alt\":\"Retro Hairpin Compact Computer Desk - Washed Grey with Black Legs\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61x006aomUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nQRiA8ZTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nQRiA8ZTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NNFkp8D4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NNFkp8D4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/615FW6qFquL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/615FW6qFquL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AgSiP8oaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AgSiP8oaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vQFIYQVeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vQFIYQVeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"26.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\