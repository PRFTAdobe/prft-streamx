    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07JY2W3KS\",\"sku\":\"B07JY2W3KS\",\"lang\":\"en\",\"slug\":\"ravenna-home-living-room-recliner-chair-leather-brown-b07jy2w3ks\",\"name\":\"Ravenna Home Living Room Recliner Chair, Leather, Brown\",\"description\":\"For living room, den, family room, or office, this brown leather recliner will suit a variety of decors. Use it in its upright position, or push back for a fully supported and relaxing experience. Overall: 32.5&quot;W x 38&quot;D x 41&quot;H; arm height: 26&quot;; seat depth; 20&quot; Leather and foam over a strong metal mechanism; encased metal pocket coils for added comfort. Beautiful dark brown leather over dense foam make this recliner comfortable and attractive. Generously padded arms, seat, and back offer comfort, while full chaise recliners deliver optimal leg support. Assemble in 15 minutes or less Free returns for 30 days, 1-year warranty\",\"primaryImage\":{\"alt\":\"Ravenna Home Living Room Recliner Chair, Leather, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91i8yss7TwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eNbE1LMxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eNbE1LMxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zUEWaYcuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zUEWaYcuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Id6XjkZrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Id6XjkZrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NA+47sliL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91NA+47sliL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918LmRkwzGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918LmRkwzGL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.8\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"42.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"101.41\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Rocker recliner chair\",\"label\":\"Rocker recliner chair\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Lazy boy recliners\",\"label\":\"Lazy boy recliners\"},{\"value\":\"Lazy boy recliner\",\"label\":\"Lazy boy recliner\"},{\"value\":\"Leather recliner\",\"label\":\"Leather recliner\"},{\"value\":\"Theater seating\",\"label\":\"Theater seating\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":719,\"discountedValue\":647.1}}"
