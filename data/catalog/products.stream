    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMJ254\",\"sku\":\"B075YMJ254\",\"lang\":\"en\",\"slug\":\"rivet-florence-mid-century-wide-open-back-accent-dining-room-chairs-18-8-w-red-set-of-2-b075ymj254\",\"name\":\"Rivet Florence Mid-Century Wide Open-Back Accent Dining Room Chairs, 18.8&quot;W, Red, Set of 2\",\"description\":\"The unique shape of this Mid-century modern chair's open back give it a light, airy feel that works in a dining room, craft room, home office -- anywhere you need an extra seat. It's easy to move between rooms and up and down stairs. Hardwood upholstered with polyester fabric; black metal legs Ideal for any home needing furniture that multi-tasks. 2 chairs to a pack. Assembly in 15 minutes; attach base with 4 screws. Vaccuum, spot clean with damp cloth. Free returns for 30 days. 1-year warranty. 18.8&quot;W x 22.8&quot;D x 33.9&quot;H. 18.7&quot; Seat height\",\"primaryImage\":{\"alt\":\"Rivet Florence Mid-Century Wide Open-Back Accent Dining Room Chairs, 18.8&quot;W, Red, Set of 2\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MspIettDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KQ9NDMVKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KQ9NDMVKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jl5HZFTSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jl5HZFTSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VhHDcHqmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VhHDcHqmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TANYaks-S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1TANYaks-S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nz2QPHO9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Nz2QPHO9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"22.8\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"12.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":954,\"discountedValue\":858.6}}"
