    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084T7WS8J\",\"sku\":\"B084T7WS8J\",\"lang\":\"en\",\"slug\":\"classic-wishbone-dining-chair-22-4-w-natural-natural-b084t7ws8j\",\"name\":\"Classic Wishbone Dining Chair, 22.4&quot;W, Natural / Natural\",\"description\":\"This dining chair combines Mid-Century modern and Scandinavian-inspired styles for beautiful form, function and comfort. With a woven rattan seat, solid beech wood frame and partially open-back this piece works for the dining room or anywhere you need extra seating. 22.4&quot;W x 22.8&quot;D x 28.75&quot;H. Seat height: 18&quot; Solid beech wood frame with a woven paper rattan seat. This versatile, transitional chair blends well with traditional and modern styles. No assembly required. Avoid moisture. Wipe away dust and debris with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Wishbone Dining Chair, 22.4&quot;W, Natural / Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71blstsDxDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zZoyS4F0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zZoyS4F0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71baf5m1M6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71baf5m1M6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815zy9RlpSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815zy9RlpSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715dBMdjjJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715dBMdjjJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WYvsZXvDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WYvsZXvDL.jpg\"},{\"alt\":\"https://s