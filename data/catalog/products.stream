    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0719SNKSY\",\"sku\":\"B0719SNKSY\",\"lang\":\"en\",\"slug\":\"rivet-west-mid-century-oak-platform-bed-with-inlays-queen-86-l-dark-oak-finish-b0719snksy\",\"name\":\"Rivet West, Mid-Century, Oak Platform Bed With Inlays, Queen (86&quot;L), Dark Oak Finish\",\"description\":\"Low-profile and high-style is the hallmark of the West collection. This platform bed requires no box spring, giving any bedroom a modern look. Two metal gold inlays run horizontally across the headboard, giving a distinctive look to a clean silhouette. 63.5&quot; W x 86&quot;L x 46&quot; H Solid hardwoods with a finish of wire-brushed matte dark oak; gold-toned metal inlays Modern and simple yet distinctive design Sturdy mortise-and-tenon construction and platform design make a box spring unnecessary. Assemble in 30 minutes or less. Wipe with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet West, Mid-Century, Oak Platform Bed With Inlays, Queen (86&quot;L), Dark Oak Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81tS8z5EuQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VCgrGEsvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81VCgrGEsvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pC2iz3D-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81pC2iz3D-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uedhWpC8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uedhWpC8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fZfCRxD5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fZfCRxD5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kT-HTAvUL.jpg\",\"url\":\"https://stor