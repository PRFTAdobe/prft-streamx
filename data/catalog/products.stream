      "content": {
        "bytes": "{\"id\":\"B073GBFBTS\",\"sku\":\"B073GBFBTS\",\"lang\":\"en\",\"slug\":\"rivet-sodo-round-back-modern-accent-chair-citrine-b073gbfbts\",\"name\":\"Rivet SoDo Round Back Modern Accent Chair, Citrine\",\"description\":\"This cleanly designed chair with a rounded back is fashionable and comfortable at the same time. Ideal for entertaining friends in the living room, or as the perfect chair for the corner of a bedroom. 23” W x 30” D x 35” H Solid pine wood frame with poly/cotton blend fabric Mid-century modern Great for any room where an accent chair is needed Simple assembly; just attach legs Made-to-order Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet SoDo Round Back Modern Accent Chair, Citrine\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ok0m6eKlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QhKjgBhHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QhKjgBhHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q+DjK-ORS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q+DjK-ORS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UrRjcvDYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UrRjcvDYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18YrNBAoML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18YrNBAoML.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"23.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"28.0\",\"label\":\"