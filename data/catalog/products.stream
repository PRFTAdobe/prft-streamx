    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ5XRNC\",\"sku\":\"B07HZ5XRNC\",\"lang\":\"en\",\"slug\":\"rivet-goodwin-modern-sofa-88-6-w-light-grey-b07hz5xrnc\",\"name\":\"Rivet Goodwin Modern Sofa, 88.6&quot;W, Light Grey\",\"description\":\"This striking sofa will be the perfect finishing touch for your modern-style home decor. With its beautiful light-gray upholstery, this sofa will nicely complement your existing interior design, and its sleek, classy design adds elegance to any room. Overall: 88.6&quot;W x 36.2&quot;D x 35.8&quot;H; Seat Height: 18.5&quot;H; Seat Depth 22&quot;D; Seat Back Height: 20.1&quot;H; Arm Height: 26.4&quot;H; Leg Height: 6.3&quot;H Solid-wood frame and legs with 100% polyester upholstery Strong slim legs elevate this piece and add modern flair. The soft, removable back and reversible cushions ensure durability and comfort. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Goodwin Modern Sofa, 88.6&quot;W, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p9rnaRniL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l+wBgxKSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l+wBgxKSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zpu95WrLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zpu95WrLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gsBPzNASL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gsBPzNASL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BrcUI3ePL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BrcUI3ePL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1X2tg-fD-L.jpg\",\"url\