  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07ML7P8XS\",\"sku\":\"B07ML7P8XS\",\"lang\":\"en\",\"slug\":\"classic-tufted-counter-height-barstool-set-of-2-37-5-h-navy-b07ml7p8xs\",\"name\":\"Classic Tufted Counter-Height Barstool, Set of 2, 37.5&quot;H, Navy\",\"description\":\"Complete your kitchen or bar area with these vintage-inspired tufted counter stools. The sturdy solid-wood frame features an elastic suspension system that’s designed to keep the seat firm, and the elegant design nicely complements vintage, country and farmhouse-style home decor. Overall: 21.25&quot;W x 20.5&quot;D x 37.5&quot;H; seat height: 24.25&quot;H; seat depth: 18&quot;D; seat back height: 13.5&quot;H Durable fabric on wood frame; solid-wood legs with natural finish Set of 2 vintage-inspired counter-height bar stools with wood frame and navy upholstery Foam padding and elastic suspension system keep the back and seat firm and springy. Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Classic Tufted Counter-Height Barstool, Set of 2, 37.5&quot;H, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KD9J2nWHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lNhBjmxdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lNhBjmxdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919EYdrXSbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919EYdrXSbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L9HJLq0gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L9HJLq0gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vOr0gX3TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81vOr0gX3TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kke8LHR9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kke8LHR9L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"21.25\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"33.08\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"44\",\"label\":\"44\"},{\"value\":\"Cherry\",\"label\":\"Cherry\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Rattan\",\"label\":\"Rattan\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Dinning\",\"label\":\"Dinning\"},{\"value\":\"Centiar\",\"label\":\"Centiar\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Shell\",\"label\":\"Shell\"},{\"value\":\"D372\",\"label\":\"D372\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Dinner\",\"label\":\"Dinner\"},{\"value\":\"Knight\",\"label\":\"Knight\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Round\",\"label\":\"Round\"},{\"value\":\"Desk\",\"label\":\"Desk\"},{\"value\":\"Dining\",\"label\":\"Dining\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Table\",\"label\":\"Table\"},{\"value\":\"Eames\",\"label\":\"Eames\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Barstools\",\"label\":\"Barstools\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"White\",\"label\":\"White\"},{\"value\":\"Tolix\"