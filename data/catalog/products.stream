    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B073WQ8JLT\",\"sku\":\"B073WQ8JLT\",\"lang\":\"en\",\"slug\":\"foldable-14-metal-platform-bed-frame-with-tool-free-assembly-no-box-spring-needed-twin-xl-b073wq8jlt\",\"name\":\"Foldable, 14&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - Twin XL\",\"description\":\"Product Dimensions: 80&quot; L x 39&quot; W x 14&quot; H | Weight: 28.1 pounds Designed for sleepers up to 250 pounds Twin X-Large platform bed frame offers a quiet, noise-free, supportive foundation for a mattress. No box spring needed Folding mechanism makes the frame easy to store and move in tight spaces Provides extra under-the-bed storage space with a vertical clearance of about 13 inches Fast, easy setup—no tools required Made of durable steel with a sleek black finish\",\"primaryImage\":{\"alt\":\"Foldable, 14&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - Twin XL\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91395kFBwxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Jw00EjbSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Jw00EjbSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/611vzqcCyoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/611vzqcCyoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71s7-a99g5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71s7-a99g5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\"},{\"alt\":\"https://storage