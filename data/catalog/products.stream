    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QDGZX9\",\"sku\":\"B075QDGZX9\",\"lang\":\"en\",\"slug\":\"rivet-gwyneth-mid-century-velvet-king-bed-with-headboard-92-1-l-steel-grey-b075qdgzx9\",\"name\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 92.1&quot;L, Steel Grey\",\"description\":\"This bed's sumptuous upholstery will have you feeling like royalty. Both headboard and footboard have channel tufting, while the plush velvet fabric exudes glamour. Wooden legs with warm dark finish complete this mid-century modern look. 92.1&quot;L x 81.7&quot;W x 49&quot;H Velvet upholstery; wood legs. Mid-century modern style with glam detailing and fabric No boxspring required. King mattress sold separately. Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Gwyneth Mid-Century Velvet King Bed with Headboard, 92.1&quot;L, Steel Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HXhiNSCwL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YHgn1eFoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1YHgn1eFoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VUVWikPzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VUVWikPzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g9WNFPZ1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g9WNFPZ1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YTuSk05XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YTuSk05XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IneG35-mL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IneG35-mL.jpg\"}],\"attributes\":[{\"name\":\"height\",\