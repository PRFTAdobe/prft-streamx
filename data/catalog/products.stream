    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PC1PDXG\",\"sku\":\"B07PC1PDXG\",\"lang\":\"en\",\"slug\":\"rivet-cove-mid-century-modern-tufted-sofa-with-tapered-legs-72-w-caramel-b07pc1pdxg\",\"name\":\"Rivet Cove Mid-Century Modern Tufted Sofa with Tapered Legs, 72&quot;W, Caramel\",\"description\":\"This modern sofa comes with tufted back and seat cushions atop tall tapered legs. The design offers simple lines that fit well with most decors, and the solid wood frame give this beautiful piece a sense of solidity and timelessness. 32.7&quot;W x 33.9&quot;D x 35.4&quot;H Solid wood frame and legs; leather upholstery Add style when you add extra seating with this gorgeous modern sofa. Tufting on the seat and back cushions adds elegance to this modern sofa. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Cove Mid-Century Modern Tufted Sofa with Tapered Legs, 72&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711Hz263udL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SJOYLfDZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SJOYLfDZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xrbhTAsrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xrbhTAsrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RkM7UCj9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RkM7UCj9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+OgCgDMCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+OgCgDMCL.