    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZ8P4W\",\"sku\":\"B07PBZ8P4W\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-upholstered-ottoman-25-6-w-optical-grey-b07pbz8p4w\",\"name\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Optical Grey\",\"description\":\"This strong lines of this sleek upholstered ottoman give it a stylish presence. The sturdy cream-colored linen-like upholstery and beautiful solid wood tapered legs help ensure this piece is as lasting as it is lovely. 25.6&quot;W x 25.6&quot;D x 15.7&quot;H Solid wood frame and tapered beech legs; 100% polyester upholstery Comfortably rest your feet while sitting on your sofa or favorite armchair. This ottoman features a sleek modern design with simple upholstered lines and tall tapered legs. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Optical Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812-VxPQejL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bJK5vM46L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bJK5vM46L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916j2Y-zFFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916j2Y-zFFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VuI+EKzhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VuI+EKzhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m0PyRe8lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m0PyRe8lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816ZD2K9+kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images