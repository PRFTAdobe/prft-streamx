    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STJ2Q\",\"sku\":\"B07P8STJ2Q\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sofa-with-tapered-wood-legs-87-w-wathet-blue-b07p8stj2q\",\"name\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Wathet Blue\",\"description\":\"This sofa features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive blue fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 87&quot;W x 36&quot;D x 30&quot;H Solid hardwood frame with tapered wood legs Removable and reversible back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sofa with Tapered Wood Legs, 87&quot;W, Wathet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71D2um-WhnL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718pZ3wP3uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718pZ3wP3uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816hWROfhAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816hWROfhAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ySdr3VV3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ySdr3VV3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ClrBuuJmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ClrBuuJmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818k9Z6YqOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/