    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071J7Q9X4\",\"sku\":\"B071J7Q9X4\",\"lang\":\"en\",\"slug\":\"rivet-huxley-mid-century-accent-chair-light-grey-b071j7q9x4\",\"name\":\"Rivet Huxley Mid-Century Accent Chair, Light Grey\",\"description\":\"This mid-century modern chair is reminiscent of the Mad Men era. The curved solid wood frame and comfortable seating make this chair ideal for the living room or home office. 35”D x 28.3”W x 33.9”H Solid wood frame and polyester/linen/cotton fabric Mid-century modern Handsome, practical design No assembly required. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Huxley Mid-Century Accent Chair, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A109hYA3S0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSMxhqqrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JSMxhqqrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PBW+zMVIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PBW+zMVIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1er-eVbeMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1er-eVbeMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hXUQfiudL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hXUQfiudL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SEplpSxzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SEplpSxzL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28.3\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.0\",\"l