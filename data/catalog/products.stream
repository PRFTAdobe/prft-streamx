    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QHKF8CT\",\"sku\":\"B07QHKF8CT\",\"lang\":\"en\",\"slug\":\"industrial-side-table-with-decorative-metal-base-15-95-w-mango-wood-and-black-b07qhkf8ct\",\"name\":\"Industrial Side Table with Decorative Metal Base, 15.95&quot;W, Mango Wood and Black\",\"description\":\"An industrial table that fits within a casual or contemporary decor, this piece adds an airy feel with an open, metal base touting a diamond pattern and rivets in a black finish. The solid mango top is distressed for additional texture and style. Consider pairing with a recliner or sofa. 15.94&quot;W x 15.94&quot;D x 17.91&quot;H Solid mango with metal base A metal diamond-shaped design with rivets in a black finish adds a casual chic flair to a distressed solid wood top with a natural finish. This versatile table easily fits any casual decor. No assembly required Wipe with a soft, damp cloth; dry thoroughly. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Industrial Side Table with Decorative Metal Base, 15.95&quot;W, Mango Wood and Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M2-OGhmrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HMx2z-LXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HMx2z-LXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wUvKM6sFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wUvKM6sFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81onj195MvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81onj195MvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918fTLwKcNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918fTLwKcNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/