    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853Q71J6\",\"sku\":\"B0853Q71J6\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-pine-extendable-dining-table-39-77-w-brown-b0853q71j6\",\"name\":\"Rivet Mid-Century Modern Pine Extendable Dining Table, 39&quot;–77&quot;W, Brown\",\"description\":\"This sleek, stylish table recalls the simplicity of mid-century dining. The extendable top panel makes it flexible—it can be small enough for a breakfast nook or big enough for a dining room. Its sturdy pine construction will make it a fixture at your family meals for many years to come. 39&quot;–77&quot;W x 39&quot;D x 29.1&quot;H Pine and MDF with pine veneer This mid-century dining table is extendable with solid pine legs. It's an ideal spot to share a meal at home. This classic table can be used in breakfast nooks, kitchens, and dining rooms. The extendable top panel is great for both big and small gatherings. Assemble in 15 minutes or less Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Pine Extendable Dining Table, 39&quot;–77&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DyQzfXmoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EgJLomKvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EgJLomKvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51nr0Ot-h4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51nr0Ot-h4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ejgSnuOAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ejgSnuOAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616mPu-FfqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/616mPu-FfqL.jp