    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMJN1D\",\"sku\":\"B082VMJN1D\",\"lang\":\"en\",\"slug\":\"westview-extra-deep-down-filled-leather-loveseat-sofa-couch-75-6-w-dark-grey-b082vmjn1d\",\"name\":\"Westview Extra-Deep Down-Filled Leather Loveseat Sofa Couch, 75.6&quot;W, Dark Grey\",\"description\":\"This loveseat, with its deep cushions and sturdy frame, will help you add maximum comfort and style to any living space in your home. Never believe that you have to sacrifice comfort for style—this couch has it both in spades. 75.6&quot;W x 42.1&quot;D x 31.5&quot;H Solid wood frame and block legs with 100% top-grain leather Seat and back cushions are filled with luxurious down. Assemble in 15 minutes or less To clean, avoid moisture and wipe down with a clean, soft cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Westview Extra-Deep Down-Filled Leather Loveseat Sofa Couch, 75.6&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zBwMlYTqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VnExnxUWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VnExnxUWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eV2m8HFLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eV2m8HFLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QSrRPTfWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71QSrRPTfWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y9m+3l80L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y9m+3l80L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m-UTOoqAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m-UTOoqAL.jpg\"},{\"alt\":\"https://storage.googl