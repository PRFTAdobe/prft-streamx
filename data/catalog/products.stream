    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QFP4T8V\",\"sku\":\"B07QFP4T8V\",\"lang\":\"en\",\"slug\":\"ravenna-home-maplewood-reclining-console-loveseat-81-w-leather-dark-roast-b07qfp4t8v\",\"name\":\"Ravenna Home Maplewood Reclining Console Loveseat, 81&quot;W, Leather, Dark Roast\",\"description\":\"81&quot;W x 39&quot;D x 41&quot;H; seat height: 20&quot;H; seat depth: 22&quot;D; back cushion height: 24.5&quot;H; arm height: 27&quot;H Leather upholstery on a frame of kiln-dried hardwood with metal seat braces and a steel rocker base This double reclining loveseat with storage console features a smooth-acting reclining mechanism. It's cozier with two! Snuggle up while you catch up on your favorite shows in this comfortable reclining loveseat. Assemble in 15 minutes or less Wipe down with a damp cloth every month or so to remove any dirt or dust buildup. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Maplewood Reclining Console Loveseat, 81&quot;W, Leather, Dark Roast\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cH9VKCFZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i2Ab3H9iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81i2Ab3H9iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IDqmBKpFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IDqmBKpFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9156eDgJ3iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9156eDgJ3iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J2vP4QkWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J2vP4QkWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KRrQBlShL.jpg\",\"url\":\"https://storage.googleapis.com/pure