    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2X98G\",\"sku\":\"B084W2X98G\",\"lang\":\"en\",\"slug\":\"elise-upholstered-barstool-42-5-h-midnight-blue-b084w2x98g\",\"name\":\"Elise Upholstered Barstool, 42.5&quot;H, Midnight Blue\",\"description\":\"This midnight-colored rectangular barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 42.5&quot;H; seat height: 29.9&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 25.2&quot;H Solid hardwood frame upholstered in moisture-repellent, stain-resistant fabric Footrest with kickplate for stability and durability, with padded seat and back for comfort. Mid-Century inspired barstool with back. Arrives fully assembled Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Barstool, 42.5&quot;H, Midnight Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716eewwBIVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JwJ7uB67L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JwJ7uB67L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jH+MZ2VJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jH+MZ2VJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gx2RiBgGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gx2RiBgGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fsvdcmh2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1fsvdcmh2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71N61TrYIgL.jpg