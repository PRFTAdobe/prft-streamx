    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ9K9S3\",\"sku\":\"B07HZ9K9S3\",\"lang\":\"en\",\"slug\":\"kristin-ottoman-33-w-indigo-b07hz9k9s3\",\"name\":\"Kristin Ottoman, 33&quot;W, Indigo\",\"description\":\"Add style and comfort to your home with this classic ottoman. With a time-tested traditional design, this ottoman is an ideal accent for many home-decor styles, and its beautiful indigo hue brightens the room with color. Its cushions are reversible to extend this ottoman’s life. Overall: 33&quot;W x 24&quot;D x 18.5&quot;H; Seat Height: 21.5&quot;H; Seat Depth 24&quot;D; Leg Height: 2.5&quot;H Solid-wood frame with mortise-and-tenon construction and 8-guage sinuous spring support system, fully padded and upholstered with performance fabric Traditional design is both fashionable and practical. Loose back and seat cushions are removable and reversible to ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Kristin Ottoman, 33&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GAfc676pL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+gPxiSRlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+gPxiSRlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17BhX+uZFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B17BhX+uZFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nyBoCGSJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nyBoCGSJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916il6rkT1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916il6rkT1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"25.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"30.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Laguna\",\"label\":\"Laguna\"},{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Sterling\",\"label\":\"Sterling\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Skyler\",\"label\":\"Skyler\"},{\"value\":\"Large\",\"label\":\"Large\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Trunks\",\"label\":\"Trunks\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Chests\",\"label\":\"Chests\"},{\"value\":\"Benches\",\"label\":\"Benches\"},{\"value\":\"Entryway\",\"label\":\"Entryway\"},{\"value\":\"Santa\",\"label\":\"Santa\"},{\"value\":\"Rest\",\"label\":\"Rest\"},{\"value\":\"Inches\",\"label\":\"Inches\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Gliding\",\"label\":\"Gliding\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Gun\",\"label\":\"Gun\"},{\"value\":\"Dollars\",\"label\":\"Dollars\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Decor\",\"label\":\"Decor\"},{\"value\":\"60&quot;\",\"label\":\"60&quot;\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Square\",\"label\":\"Square\"},{\"value\":\"Seats\",\"label\":\"Seats\"},{\"value\":\"Foot\",\"label\":\"Foot\"},{\"value\":\"Tray\",\"label\":\"Tray\"},{\"value\":\"Game\",\"label\":\"Game\"},{\"value\":\"Storage\",\"label\":\"Storage\"},{\"value\":\"Logan\",\"label\":\"Logan\"},{\"value\":\"Dark\",\"l