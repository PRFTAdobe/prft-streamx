    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07263589Q\",\"sku\":\"B07263589Q\",\"lang\":\"en\",\"slug\":\"bradbury-chesterfield-modern-tufted-ottoman-30-3-w-hemp-b07263589q\",\"name\":\"Bradbury Chesterfield Modern Tufted Ottoman, 30.3&quot;W, Hemp\",\"description\":\"This classic, tailored ottoman is the perfect place for extra guests to sit or to rest your feet after a long day. Simple modern design with hemp-color fabric adds just the right style. Dimensions: 22.4”D x 30.3 ”W x 19.7”H Solid and engineered hardwoods; polyester/nylon fabric Timeless and functional Refreshed design of a classic Minimal assembly; just attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Bradbury Chesterfield Modern Tufted Ottoman, 30.3&quot;W, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mHnS0WhCL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iV8oUMEIS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iV8oUMEIS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12HSjG7oUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12HSjG7oUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RQ6Bv578L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RQ6Bv578L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B13UJiOyU+S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B13UJiOyU+S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zG7TryZwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zG7TryZwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.68504\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.440945\",\"label\