    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QMGMYP\",\"sku\":\"B075QMGMYP\",\"lang\":\"en\",\"slug\":\"darby-wingback-king-upholstered-headboard-80-w-warm-grey-b075qmgmyp\",\"name\":\"Darby Wingback King Upholstered Headboard, 80&quot;W, Warm Grey\",\"description\":\"This mid-century modern headboard's wingback design is covered in linen-look performance fabric for durability. Nailhead trim adds another touch of elegance, and ample foam padding makes it comfortable to lean against while enjoying a good book. 80&quot; W x 11.5&quot; D x 51.5&quot;H Hardwood frame; polyester performance fabric; metal nailheads with antiqued brass finish An update of a classic mid-century modern style Performance fabric is durable, easy to clean. Headboard has Dacron-wrapped foam padding. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Darby Wingback King Upholstered Headboard, 80&quot;W, Warm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VDeEvnqOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o2FszicOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o2FszicOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lp8wn3ALL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lp8wn3ALL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11uWK5vntS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11uWK5vntS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1u9FExbhxS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1u9FExbhxS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yZH9HCKhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag