        "bytes": "{\"id\":\"B075X4T5RT\",\"sku\":\"B075X4T5RT\",\"lang\":\"en\",\"slug\":\"marin-studded-sofa-87-w-tan-b075x4t5rt\",\"name\":\"Marin Studded Sofa, 87&quot;W, Tan\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Sofa, 87&quot;W, Tan\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rKca7usLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FFh0NqgRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hbYzmsIwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hbYzmsIwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S-tNJ2caL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S-tNJ2caL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ORsnO-fqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ORsnO-fqL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\