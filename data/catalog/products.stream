{
  "key": "pim:B07HSLKFD5",
  "action": "publish",
  "eventTime": null,
  "properties": {
    "sx:type": "data/product"
  },
  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSLKFD5\",\"sku\":\"B07HSLKFD5\",\"lang\":\"en\",\"slug\":\"commodore-casual-round-coffee-table-23-6-w-whitewash-mango-wood-b07hslkfd5\",\"name\":\"Commodore Casual Round Coffee Table, 23.6&quot;W, Whitewash Mango Wood\",\"description\":\"Bring an exotic feel into your home with this unique bunching coffee table. Made from solid mango, this casual-style coffee table is finished with new whitewash color that highlights the wood’s grain. The intricate cut-out design in the table’s base makes it a captivating centerpiece for any room. 23.6&quot;W x 23.6&quot;D x 17.7&quot;H Made of solid mango with an elegant whitewash finish. Each vertical section in the barrel design is hand carved by a skilled craftsman to create a lace design on the base. Combining modern geometry with a touch of the exotic, this drum-shaped coffee table crafts a stylish and sophisticated look with its lacy trellis base. This table is great in pairs in front of a sofa or sectional. No assembly required Care: Clean as required with a soft, damp cloth; wipe completely dry. Avoid placing furniture near heat vents or open windows. Long periods of heat or excessive dampness can cause splitting, warping, and swelling in solid wood. Protect fine furniture finishes from hot dishes, alcohol, and excessive moisture or dampness. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Commodore Casual Round Coffee Table, 23.6&quot;W, Whitewash Mango Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zNAMCo6tL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kKyXT0OdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kKyXT0OdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IQLWfVN0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81IQLWfVN0L.jpg\"},{\"alt\":\"https://storage.googleapis.