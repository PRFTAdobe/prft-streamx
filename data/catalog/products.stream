        "bytes": "{\"id\":\"B075Z93NHP\",\"sku\":\"B075Z93NHP\",\"lang\":\"en\",\"slug\":\"rustic-parson-office-computer-desk-with-7-drawers-64-w-oak-b075z93nhp\",\"name\":\"Rustic Parson Office Computer Desk with 7 Drawers, 64&quot;W, Oak\",\"description\":\"With a rustic oak finish, this seven-drawer double-pedestal desk is as beautiful as it is functional. File drawers on both sides glide easily in and out, thanks to concealed, self-closing, ball-bearing extension guides. 64&quot;W x 26&quot;D x 30&quot;H Solid hardwood with oak veneer; custom decorative metal door pulls Plenty of room for storing files in easy-glide, slow-closing drawers Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rustic Parson Office Computer Desk with 7 Drawers, 64&quot;W, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dlTRtJseL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IFeMGYFVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1IFeMGYFVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gK8LhSxIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gK8LhSxIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hJEBuv0-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hJEBuv0-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+yS5snM+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+yS5snM+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"64.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"26.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\