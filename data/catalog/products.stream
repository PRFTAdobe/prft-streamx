    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWLGCB5\",\"sku\":\"B07BWLGCB5\",\"lang\":\"en\",\"slug\":\"andover-right-facing-sofa-chaise-sectional-126-w-saddle-colored-leather-b07bwlgcb5\",\"name\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Saddle-Colored Leather\",\"description\":\"Overall: 126&quot;W x 61&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you. Complete your living space with this stylish sofa-chaise sectional. With its saddle-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life.\",\"primaryImage\":{\"alt\":\"Andover Right-Facing Sofa-Chaise Sectional, 126&quot;W, Saddle-Colored Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ZN7YgKcJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91csSkQMa9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91csSkQMa9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KHr-uDyFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KHr-uDyFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hA4R9PFjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81hA4R9PFjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cgMZqmurL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71cgMZqmurL.jpg\"},{\"alt\":\"https://storage.googleapis.com/pure