  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YZ16V7\",\"sku\":\"B075YZ16V7\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-stark-6-drawer-dresser-61-w-warm-espresso-b075yz16v7\",\"name\":\"Rivet Mid-Century Stark 6-Drawer Dresser, 61&quot;W, Warm Espresso\",\"description\":\"This warm espresso-finished dresser sits on a metal base for a bit of industrial style. The simple metal handles add just the right touch to the minimalist profile. Durable solid pine is built to last and sustainably sourced. 61&quot;W x 18&quot;D x 32&quot;H FSC-certified solid pine. Drawers feature wood runners and safety stops. Mid-century modern design will blend with a modern bedroom. Six large drawers offer lots of storage for clothes. Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Stark 6-Drawer Dresser, 61&quot;W, Warm Espresso\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911EiPQpzgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vowJYU+8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vowJYU+8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jekIpwIGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jekIpwIGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91stYPu+g7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91stYPu+g7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hUHxOTmKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hUHxOTmKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Cr5FuoZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Cr5FuoZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-image