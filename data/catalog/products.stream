    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KM5QL\",\"sku\":\"B0853KM5QL\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-barstool-42-1-h-stucco-b0853km5ql\",\"name\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Stucco\",\"description\":\"Powerful in its simplicity, this barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 42.1&quot;H; seat height: 29.9&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H Solid wood frame with 80% polyester, 20% acrylic fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Barstool, 42.1&quot;H, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71IOEl1730L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815FSd+WJAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815FSd+WJAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i8TgKv7TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71i8TgKv7TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719sB2YTL+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719sB2YTL+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rKzg6X-6L.jpg\",\"url\":\"https://storage.googleapis.com