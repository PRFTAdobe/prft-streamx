    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP394B\",\"sku\":\"B075YP394B\",\"lang\":\"en\",\"slug\":\"rivet-julian-minimalist-modern-tufted-kitchen-bar-height-stools-set-of-2-37-8-inch-height-synthetic-leather-autumn-yellow-b075yp394b\",\"name\":\"Rivet Julian Minimalist Modern Tufted Kitchen Bar Height Stools, Set of 2, 37.8 Inch Height, Synthetic Leather, Autumn Yellow\",\"description\":\"Add snazzy style and a vibrant pop of color to your home with these fun bar stools. The low-back seats with channel tufting sit on tall metal legs. Combine with others of the same color or mix and match for a look that's sure to turn heads. 19.3&quot;W x  21&quot;D x 37.8&quot;H.  Seat height is 29&quot;. Synthetic leather upholstery on hardwood frame; metal legs with grey finish Easy-care synthetic leather. Durable  finish on legs. Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julian Minimalist Modern Tufted Kitchen Bar Height Stools, Set of 2, 37.8 Inch Height, Synthetic Leather, Autumn Yellow\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81m8RJ5oilL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bolWq+qML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bolWq+qML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Th4JwAIuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Th4JwAIuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jowgakTCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71jowgakTCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AXa3zX-ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AXa3zX-ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origina