        "bytes": "{\"id\":\"B075X543S4\",\"sku\":\"B075X543S4\",\"lang\":\"en\",\"slug\":\"leila-ottoman-34-w-sandstone-b075x543s4\",\"name\":\"Leila Ottoman, 34&quot; W, Sandstone\",\"description\":\"This item is made to order just for you 34&quot;W x 23&quot;D x 19&quot;H Solid wood frame and legs with durable fabric upholstery. Firm nylon webbing makes cushion resilient This striking vintage-look ottoman is good for more than just putting up your feet. It also can be a handy place for a tray of drinks or an extra seat for guests. Solid wood legs in a dark walnut finish and plush upholstery add to its high style. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Ottoman, 34&quot; W, Sandstone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PQB5ObArL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m1tBO6m6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91m1tBO6m6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w84T5lpQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w84T5lpQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ywIhOv16L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ywIhOv16L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AMh-XrfaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AMh-XrfaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917eh8NWeYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917eh8NWeYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"19.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"v