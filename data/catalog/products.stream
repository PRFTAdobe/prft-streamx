    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8WD59\",\"sku\":\"B075Z8WD59\",\"lang\":\"en\",\"slug\":\"rivet-hillside-antiqued-round-coffee-table-39-4-d-wood-and-bronze-b075z8wd59\",\"name\":\"Rivet Hillside Antiqued Round Coffee Table, 39.4&quot;D, Wood and Bronze\",\"description\":\"Rustic and industrial come together in this wood and metal round coffee table. Hardwood strips are laid out in a parquet sunburst pattern for the top, while a brush bronzed finish gives the hollow metal base an antiqued feel with a hint of glam. 39.4&quot; Diameter x 16&quot;H Reclaimed elm and metal with brushed bronze finish Rustic and industrial elements make this table work with modern or transitional décor. No assembly required. Wipe with soft dry cloth. Free return for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Hillside Antiqued Round Coffee Table, 39.4&quot;D, Wood and Bronze\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Jqfqe0LbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1efvEO5y-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1efvEO5y-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EhoHFk12L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EhoHFk12L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91boNuNNjOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91boNuNNjOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VvgqPHhrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VvgqPHhrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1reiHuq9pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1reiHuq9pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ae