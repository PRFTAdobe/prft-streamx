torage.googleapis.com/puresight-pim-images/original/91/91Fqpx0MpqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fqpx0MpqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nrq7kiEOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nrq7kiEOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d94agnuqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1d94agnuqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LRLecImfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LRLecImfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916bvCwmhbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916bvCwmhbL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"43.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"99.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dark grey\",\"label\":\"Dark grey\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"}