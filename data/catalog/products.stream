    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F3Z2\",\"sku\":\"B075X4F3Z2\",\"lang\":\"en\",\"slug\":\"marin-nailhead-studded-sofa-couch-87-w-grey-b075x4f3z2\",\"name\":\"Marin Nailhead Studded Sofa Couch, 87&quot;W, Grey\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with durable performance fabric upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Nailhead Studded Sofa Couch, 87&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KHfLWtAfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913298m32aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913298m32aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lv6hvo0yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Lv6hvo0yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yB7SOh0IS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yB7SOh0IS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KRIUa7dJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KRIUa7dJL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inch