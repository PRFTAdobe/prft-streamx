        "bytes": "{\"id\":\"B075X4PTSN\",\"sku\":\"B075X4PTSN\",\"lang\":\"en\",\"slug\":\"modern-leather-living-room-wingback-accent-chair-32-75-w-saddle-b075x4ptsn\",\"name\":\"Modern Leather Living Room Wingback Accent Chair, 32.75&quot;W, Saddle\",\"description\":\"More modern and angular &quot;wings&quot; and arms give the classic wingback chair a modern refresh. Top grain leather and birch wood legs give this piece lasting style and quality. Firm cushions and a matching lumbar pillow provide comfort and support. 32.75&quot;W x 36.25''D x 38.75''H Sturdy wood frame and legs; 100% top grain leather. A modern take on the mid-century wingback style with quality leather and lumbar support Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Modern Leather Living Room Wingback Accent Chair, 32.75&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6FrMPU+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MCesN-faL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MCesN-faL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n1f7oIjCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1n1f7oIjCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yzT-aa5TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yzT-aa5TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Ng49QWnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914Ng49QWnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y88eiCCIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Y88eiCCIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917KMn7+43L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917KMn7+43L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ubAAoGOOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ubAAoGOOL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.75\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"32.75\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"62.48\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Glider rocker\",\"label\":\"Glider rocker\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Saddle\",\"label\":\"Saddle\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Leather sofa\",\"label\":\"Leather sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Full size bed frame\",\"label\":\"Full size bed frame\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":836,\"discountedValue\":752.4}}"
