    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZPGY3\",\"sku\":\"B07B4ZPGY3\",\"lang\":\"en\",\"slug\":\"bridgewater-scalloped-queen-headboard-71-w-spinnsol-natural-b07b4zpgy3\",\"name\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Spinnsol Natural\",\"description\":\"This headboard adds classic style to any space. The scalloped corners and top stitch detailing complete the look. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 71&quot;W x 5&quot;D x 51&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Scalloped Queen Headboard, 71&quot;W, Spinnsol Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cTdKZsfEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aIhWGxw3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91aIhWGxw3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f-w6YNCVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f-w6YNCVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E5izje-VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E5izje-VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YuKF1-AWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YuKF1-AWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vHqj2mfEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91