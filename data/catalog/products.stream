    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDSXMN\",\"sku\":\"B082QDSXMN\",\"lang\":\"en\",\"slug\":\"rivet-spear-mid-century-modern-channel-tufted-accent-chair-with-wood-arms-29-1-w-ivory-b082qdsxmn\",\"name\":\"Rivet Spear Mid-Century Modern Channel Tufted Accent Chair with Wood Arms, 29.1&quot;W, Ivory\",\"description\":\"Classic design features get a modern twist in this chic channel-back accent chair. The tufted upholstery comes in a contemporary ivory sure to fit with any design scheme. A curved back and wooden armrests provide support and an elegant look that will add a finishing touch wherever you need seating. 29.1&quot;W x 31.5&quot;D x 32.7&quot;H; seat height: 17.7&quot;H; seat depth: 24.4&quot;D; seat back height: 21.7&quot;H; arm height: 25.2&quot;H; leg height: 11&quot;H Solid ash frame, polyester and acrylic upholstery Add elegance to any seating area with the classic design features of this channel-back chair. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Spear Mid-Century Modern Channel Tufted Accent Chair with Wood Arms, 29.1&quot;W, Ivory\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UiKCAROfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SxXdUM0vL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SxXdUM0vL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cszjHwGeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cszjHwGeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JFrX1A75L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JFrX1A75L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917gJEETmML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/