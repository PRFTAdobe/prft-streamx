    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X33T21\",\"sku\":\"B075X33T21\",\"lang\":\"en\",\"slug\":\"rivet-parks-mid-century-modern-wingback-leather-accent-chair-30-5-w-aged-black-b075x33t21\",\"name\":\"Rivet Parks Mid-Century Modern Wingback Leather Accent Chair, 30.5&quot;W, Aged Black\",\"description\":\"The Mid-century inspired wingback gets a modern update in this leather accent chair. A matching luxe pillow provides extra lumbar support to a tall back and perfectly shaped arms. Tapered hardwood legs add a crowning touch to a bold, impressive style. 30.5&quot;W x 35.25''D x 40''H 100% top grain leather upholstery and pillow; hardwood frame and birch legs A refresh of the classic wingback No assembly.  Wipe with a dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Parks Mid-Century Modern Wingback Leather Accent Chair, 30.5&quot;W, Aged Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81r58Hroy8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JPM8wKnUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JPM8wKnUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H00FZp-BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H00FZp-BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sVVzQxc1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sVVzQxc1L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"40.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"35.25\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"56.32\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"K