    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MF2N5\",\"sku\":\"B07B4MF2N5\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-sofa-leather-87-w-saddle-b07b4mf2n5\",\"name\":\"Rivet Edgewest Modern Sofa, Leather, 87&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; individual pieces can be configured in many ways. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you. Overall: 87&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Sofa, Leather, 87&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8112KH2qa-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wDwEGnDLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wDwEGnDLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cwhjZTnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cwhjZTnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k+C6UymcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k+C6UymcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9169hwVEk3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9169hwVEk3L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"28.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"80.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"124.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Sofa\",\"label\":\"Sofa\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":429,\"discountedValue\":386.1}}"
