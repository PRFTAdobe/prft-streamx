    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQ8QSD\",\"sku\":\"B075YQ8QSD\",\"lang\":\"en\",\"slug\":\"sophia-modern-swivel-kitchen-counter-height-stool-39-4-h-navy-blue-b075yq8qsd\",\"name\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Navy Blue\",\"description\":\"With a substantial padded back and seat, this counter stool provides maximum comfort and swivels for easy conversation. The solid hardwood frame is sturdy and stable, and performance fabric makes it durable and easy to clean. 17.7&quot;D x 21.3&quot;W x 39.4&quot;H. Seat height is 26&quot;. 95% polyester/5% nylon on hardwood frame; solid poplar legs. Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Swivel Kitchen Counter Height Stool, 39.4&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-IH+OgaSL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLz68tPXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XLz68tPXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T5VkmKyLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81T5VkmKyLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cAAmquprL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cAAmquprL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9126lkqn8fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9126lkqn8fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BUAIa-lDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1BUAIa-lDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima