    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ8J1VF\",\"sku\":\"B07HZ8J1VF\",\"lang\":\"en\",\"slug\":\"fischer-queen-sized-sleeper-sofa-79-w-driftwood-leather-b07hz8j1vf\",\"name\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Driftwood Leather\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this queen-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 79&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with rich top-grain leather upholstery Clean lines and rich color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Queen-Sized Sleeper Sofa, 79&quot;W, Driftwood Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71LlAStnrzL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PnudfqUUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PnudfqUUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WI1eFx+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WI1eFx+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mUiwB1kJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mUiwB1kJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YkopdALCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YkopdALCL.jpg\"},{\"alt\