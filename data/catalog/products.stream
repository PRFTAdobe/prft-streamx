    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8THZJ\",\"sku\":\"B075Z8THZJ\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-microfiber-dining-chair-30-5-h-2-pack-brown-b075z8thzj\",\"name\":\"Rivet Mid-Century Modern Microfiber Dining Chair, 30.5&quot;H, 2-Pack, Brown\",\"description\":\"18.5&quot;W x 20.9&quot;D x 30.5&quot;H Microfiber fabric over hardwood frame; metal legs have black finish Along with seating, these chairs bring retro fun to a dining table, living room or desk Assemble in 15 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Simple sloped seats are paired with tall black metal bases for a classic Mid-century style. The microfiber has a distressed finish to give these bar stools a hint of vintage style -- but with the modern conveniences of easy cleaning and durability.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Microfiber Dining Chair, 30.5&quot;H, 2-Pack, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919x0Ud2NlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kl+YggQ0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91kl+YggQ0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hNFFT7GTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hNFFT7GTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s2-TidB3S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s2-TidB3S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o8VuvXSfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91o8VuvXSfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1raJsCFf3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1raJsCFf3L.jpg\"}],\"attributes\":[{\"name\":\"height\