    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MKSB1\",\"sku\":\"B07B4MKSB1\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-dark-grey-b07b4mksb1\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Dark Grey\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 23&quot;L x 31&quot;W x 21&quot;H Stain-resistant polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915Cu+aPYUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xzHIODfBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xzHIODfBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18OVGRV9NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18OVGRV9NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mVLG9icoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mVLG9icoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LRLecImfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LRLecImfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BgiSSZLAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BgiSSZLAL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\