    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4VWRC\",\"sku\":\"B075X4VWRC\",\"lang\":\"en\",\"slug\":\"stella-storage-ottoman-on-wheels-47-w-brown-b075x4vwrc\",\"name\":\"Stella Storage Ottoman on Wheels, 47&quot;W, Brown\",\"description\":\"This handsome ottoman can multi-task and move from room to room on casters. In the living room, it can provide extra seating, a comfy footrest, a magazine display area, or a place for a snack tray. In the bedroom, it can store pillows and blankets. This item is made to order just for you 47&quot;W x 27&quot;D x 18&quot;H Sturdy wood frame; durable performance fabric; metal casters. With transitional style and storage space, this piece will be handy in many rooms. Easy assembly, just attach the casters. Vacuum or spot clean with damp cloth. Made in the US of partially imported materials. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Stella Storage Ottoman on Wheels, 47&quot;W, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EOEoXc+6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wKYdEANhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wKYdEANhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914aPwgVdGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914aPwgVdGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1leugWychL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1leugWychL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gbHSzgjJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gbHSzgjJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sNY54mhVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sNY54mhVL.jpg\"},{\"alt\":\"htt