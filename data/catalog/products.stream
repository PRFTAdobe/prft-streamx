    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7B9FKC\",\"sku\":\"B07B7B9FKC\",\"lang\":\"en\",\"slug\":\"cottage-wood-bar-stool-29-h-green-b07b7b9fkc\",\"name\":\"Cottage Wood Bar Stool, 29&quot;H, Green\",\"description\":\"This simple, classic wooden bar stool is offered in a distressed hunter green finish. It's perfect for adding seating to a rustic or modern farmhouse kitchen, and easy to move around when you need more seating in another room. 18&quot;W x 9.5&quot;D x 29&quot;H; Seat Height: 29&quot;H Sturdy hardwoods Ideal for rustic and modern farmhouse spaces Easy to care for -- just wipe with damp cloth Assembly in 15-30 minutes Doesn't say what you need to do Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Cottage Wood Bar Stool, 29&quot;H, Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717oJybLo5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717XmQ9butL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717XmQ9butL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GG9bTrj8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GG9bTrj8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hvTq8nBkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hvTq8nBkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819QMOcHrSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819QMOcHrSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sPOmEkhJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sPOmEkhJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kazq3E+pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kazq3E+pL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OFFqU87nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OFFqU87nL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"29.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"18.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"9.5\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"11.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bar stool 29\",\"label\":\"Bar stool 29\"},{\"value\":\"Bar stools green\",\"label\":\"Bar stools green\"},{\"value\":\"Bar stools set of 3\",\"label\":\"Bar stools set of 3\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"}]}],\"categories\":[{\"id\":\"Barstools\",\"slug\":\"barstools\",\"name\":\"Barstools\",\"value\":\"Barstools\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":805,\"discountedValue\":724.5}}"
