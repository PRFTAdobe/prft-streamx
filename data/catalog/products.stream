    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X65R3R\",\"sku\":\"B075X65R3R\",\"lang\":\"en\",\"slug\":\"marin-leather-recliner-30-w-walnut-b075x65r3r\",\"name\":\"Marin Leather Recliner, 30&quot;W, Walnut\",\"description\":\"Relax in style in this push-back recliner. It's crafted for durability with a solid wood frame, rich leather, and dashing nail head detail that is applied by hand over matching trim. Stylishly sloped arms complete the handsome design. This item is made to order just for you 30&quot;W x 36&quot;D x 41&quot;H. Seat height is 21&quot;. Solid wood frame and legs with 100% leather upholstery Poly wrapped foam cushions; back cushion attached with hidden Velcro to keep it in place Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Marin Leather Recliner, 30&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1AGxSMShZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CBREI-7UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CBREI-7UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aqd3WKBML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aqd3WKBML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sLAHbjBSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EdSQMZZIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1EdSQMZZIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"val