    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2Z2BS5\",\"sku\":\"B07J2Z2BS5\",\"lang\":\"en\",\"slug\":\"rivet-brooke-contemporary-mid-century-modern-tufted-sofa-couch-82-w-grey-b07j2z2bs5\",\"name\":\"Rivet Brooke Contemporary Mid-Century Modern Tufted Sofa Couch, 82&quot;W, Grey\",\"description\":\"Add mid-century charm to your home decor with this striking sofa. Its crisp lines and distinct shape combine for an attractive contemporary-style look, and its beautiful grey fabric upholstery will blend well with your existing interior-design style. Overall: 82&quot;W x 35&quot;D x 31&quot;H; seat height: 19.29&quot;H; seat depth: 22.83&quot;D; seat back height: 31&quot;H; arm height: 31&quot;H; leg height: 7.87&quot;H Solid-wood frame with fabric upholstery and brass legs Elegant contemporary-style design also pairs well with vintage or mid-century-modern home decor Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Brooke Contemporary Mid-Century Modern Tufted Sofa Couch, 82&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xPV3Ey1kL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PUBF9bjMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1PUBF9bjMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Bt0GOpGnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Bt0GOpGnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818sVXfijZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818sVXfijZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gIJflPehL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gIJflPehL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RCfSCCWfL.jpg\"