    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X54415\",\"sku\":\"B075X54415\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-straight-back-settee-49-w-steel-b075x54415\",\"name\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Steel\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish. A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Steel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A132Y0Q8owL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18fllahMCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18fllahMCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vLUtxgbaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vLUtxgbaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+BuymwVhS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1+BuymwVhS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-eTuPp+qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-eTuPp+qL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]},{