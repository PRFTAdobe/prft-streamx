      "content": {
        "bytes": "{\"id\":\"B075X4PRVN\",\"sku\":\"B075X4PRVN\",\"lang\":\"en\",\"slug\":\"marin-studded-sofa-87-w-indigo-b075x4prvn\",\"name\":\"Marin Studded Sofa, 87&quot;W, Indigo\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with 100% cotton upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Studded Sofa, 87&quot;W, Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81d+F92cdYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912kbqCZ3wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912kbqCZ3wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814aVp8r8+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814aVp8r8+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Uf73Hb-QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Uf73Hb-QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j3hiIhsvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j3hiIhsvL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"87.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"va