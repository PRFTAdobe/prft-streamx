    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QD7WY8\",\"sku\":\"B082QD7WY8\",\"lang\":\"en\",\"slug\":\"rivet-maple-channel-tufted-vegan-leather-storage-ottoman-with-a-soft-close-hinge-45-3-w-black-b082qd7wy8\",\"name\":\"Rivet Maple Channel Tufted Vegan Leather Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Black\",\"description\":\"Storage is made simple and convenient with this stylish channel-top ottoman. A solid wood frame and tapered legs provide a sturdy base, and a high-quality galvanized, soft-close hinge makes it easy to shut small items away but keep them within reach. Black faux leather upholstery matches any decor. 45.3&quot;W x 18.9&quot;D x 18.5&quot;H; seat height: 18.5&quot;H; seat depth: 18.9&quot;D; leg height: 6.3&quot;H Solid wood frame and legs, faux leather upholstery Store small items and help reduce clutter in your home with this ottoman. Made with a soft-close hinge for easy use. Assemble in 15 minutes or less Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Maple Channel Tufted Vegan Leather Storage Ottoman with a Soft-Close Hinge, 45.3&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Yi-BAiXQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917lPT8NQkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917lPT8NQkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MI5y8VCNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MI5y8VCNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KEcxrbp5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KEcxrbp5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/619jluQCQcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/