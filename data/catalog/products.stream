        "bytes": "{\"id\":\"B075YN3GVN\",\"sku\":\"B075YN3GVN\",\"lang\":\"en\",\"slug\":\"rivet-ricky-mid-century-modern-set-of-2-upholstered-dining-room-kitchen-chairs-37-inch-height-felt-grey-b075yn3gvn\",\"name\":\"Rivet Ricky Mid-Century Modern Set of 2 Upholstered Dining Room Kitchen Chairs, 37 Inch Height, Felt Grey\",\"description\":\"Simple, sleek high-backed mid-century modern dining chairs. They're also easy to move anywhere you need extra seating. 24&quot;W x 19&quot;D x 37&quot;H Durable polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep backs and seats firm and springy Free returns for 30 days. 1-year warranty. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Ricky Mid-Century Modern Set of 2 Upholstered Dining Room Kitchen Chairs, 37 Inch Height, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I0y83jdTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sUeay-jiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sUeay-jiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wFtZ5xbML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wFtZ5xbML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k2heYdrrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1k2heYdrrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1iwARGs7AS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lNKNQVuIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lNKNQVuIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"lab