    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VL45Z5\",\"sku\":\"B082VL45Z5\",\"lang\":\"en\",\"slug\":\"westview-extra-deep-down-filled-sofa-couch-89-w-smoke-b082vl45z5\",\"name\":\"Westview Extra-Deep Down-Filled Sofa Couch, 89&quot;W, Smoke\",\"description\":\"This couch, with its deep cushions and sturdy frame, will help you add maximum comfort and style to any living space in your home. Never believe that you have to sacrifice comfort for style—this couch has it both in spades. 89&quot;W x 42.1&quot;D x 31.5&quot;H Solid wood frame and block legs with durable 100% polyester fabric upholstery, heavy-duty webbing, and down-filled cushions Seat and back cushions are filled with luxurious down. Assemble in 15 minutes or less To clean, avoid moisture and wipe down with a clean, soft cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Westview Extra-Deep Down-Filled Sofa Couch, 89&quot;W, Smoke\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fULzpRu-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Eo2VgR7SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Eo2VgR7SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n2ujB03dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n2ujB03dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Sz2QAfKML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Sz2QAfKML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sM65PadqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kuw8xU2LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Kuw8xU2LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/