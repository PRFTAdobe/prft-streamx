    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KMNVT\",\"sku\":\"B0853KMNVT\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-counter-height-barstool-38-2-h-silver-b0853kmnvt\",\"name\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Silver\",\"description\":\"Powerful in its simplicity, this counter-height barstool is fully upholstered, with strong wooden legs and a curved, supportive back. The addition of 4 offset rungs adds stability and provides a handy and comfortable footrest. 18.9&quot;W x 22.4&quot;D x 38.2&quot;H; seat height: 26&quot;H; seat depth: 16.5&quot;D; seat back height: 16.1&quot;H; leg height: 22&quot;H Solid wood frame with 100% polyester fabric The solid wood frame is well cushioned and fully upholstered. A lovely example of mid-century simplicity, this barstool is both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Counter-Height Barstool, 38.2&quot;H, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zzMq4YGyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QjbMROOIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QjbMROOIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Uv6jFwOSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Uv6jFwOSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61+73ylCGNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61+73ylCGNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XHIORD1NL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XHIORD1NL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vt2HacMcL.