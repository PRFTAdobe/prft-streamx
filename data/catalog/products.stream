    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4SCPH1\",\"sku\":\"B07B4SCPH1\",\"lang\":\"en\",\"slug\":\"rivet-catelyn-brushed-brass-queen-bed-with-headboard-67-w-blue-b07b4scph1\",\"name\":\"Rivet Catelyn Brushed Brass Queen Bed with Headboard, 67&quot;W, Blue\",\"description\":\"Create the classic minimalist mid-century look in your bedroom with the Catelyn platform bed. Featuring simple lines and sophisticated brushed gold legs, it's upholstered in durable navy fabric for a striking style statement. 88&quot;L x 67&quot;W x 48&quot;H Polyester upholstery and metal legs with brushed gold finish Classic mid-century design Highly durable fabric Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Catelyn Brushed Brass Queen Bed with Headboard, 67&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DDw-JJtQL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y0bfDKXGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y0bfDKXGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HwY2dFH7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HwY2dFH7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A103Z07ufnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A103Z07ufnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YtOLZd+oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YtOLZd+oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RErIUt2qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RErIUt2qL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"48.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"67.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"88.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"149.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Beds\",\"label\":\"Beds\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Platform bed frame\",\"label\":\"Platform bed frame\"},{\"value\":\"Bed frame queen\",\"label\":\"Bed frame queen\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Queen bed frame\",\"label\":\"Queen bed frame\"},{\"value\":\"Twin bed frame\",\"label\":\"Twin bed frame\"},{\"value\":\"Queen headboard\",\"label\":\"Queen headboard\"},{\"value\":\"Bed frame\",\"label\":\"Bed frame\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Daybed\",\"label\":\"Daybed\"},{\"value\":\"Headboards for queen beds\",\"label\":\"Headboards for queen beds\"}]}],\"categories\":[{\"id\":\"Beds\",\"slug\":\"beds\",\"name\":\"Beds\",\"value\":\"Beds\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":638,\"discountedValue\":574.2}}"
