    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSH4ZR2\",\"sku\":\"B07HSH4ZR2\",\"lang\":\"en\",\"slug\":\"rivet-kingston-modern-dresser-19-69-w-white-b07hsh4zr2\",\"name\":\"Rivet Kingston Modern Dresser 19.69&quot;W, White\",\"description\":\"The striking texture of this engineered hardwood end table is balanced by its simple color scheme: pure white with gold accents on the handles and feet. The 2 drawers provide more than enough storage for your bedside. 15.75&quot;W x 19.69&quot;D x 23.23&quot;H Engineered hardwood and fiberboard; metal legs Features textured detailing on front of drawers with gold accents on handles and feet. Two drawers for maximized storage next to couch or bed; side-mounted ball-bearing drawer slides and gold hand pulls. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Kingston Modern Dresser 19.69&quot;W, White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+yrSSlmpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xf-0UQAAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xf-0UQAAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VcXZi7NlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61VcXZi7NlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6116XrcEu2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6116XrcEu2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eXLAoBH7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61eXLAoBH7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61M6nA6XVPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61M6nA6XVPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origi