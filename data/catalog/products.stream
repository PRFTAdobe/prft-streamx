    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JM2Q3\",\"sku\":\"B0857JM2Q3\",\"lang\":\"en\",\"slug\":\"beech-wishbone-counter-height-barstool-38-2-h-black-b0857jm2q3\",\"name\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Black\",\"description\":\"The graceful curves of this black beech barstool mask its everyday durability. It's light, portable, and perfect for any place in the house where there's a countertop. The soft, comfortable woven paper-rope seat is 100% natural. 22.4&quot;W x 22.8&quot;D x 38.2&quot;H Beech frame with a woven seat The sturdy beech frame will stand the test of time, while the soft woven paper-rope seat is easy to sink into. Simple but fashionable, this black wishbone-style curved design adds sophistication to any counter area. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Beech Wishbone Counter-Height Barstool, 38.2&quot;H, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ml4KVeqbL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BLThoTCTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BLThoTCTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vUE-uzEsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71vUE-uzEsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TznwWmLjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TznwWmLjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ah1glEFML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Ah1glEFML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ANQHto90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ANQ