    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0728NW8DV\",\"sku\":\"B0728NW8DV\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-sectional-sofa-couch-127-w-grey-tweed-b0728nw8dv\",\"name\":\"Hoffman Down-Filled Performance Fabric Sectional Sofa Couch, 127&quot;W, Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sectional sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 127&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Sectional Sofa Couch, 127&quot;W, Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81clQEHaO6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18G1TKNgzS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18G1TKNgzS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1MAxk3A8KS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1MAxk3A8KS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uh56-Qs9S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1uh56-Qs9S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1v6ZcYFltS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1v6ZcYFltS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.5\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Lengt