    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7LL5LN\",\"sku\":\"B07B7LL5LN\",\"lang\":\"en\",\"slug\":\"rivet-contemporary-leather-office-desk-chair-31-curved-base-brown-b07b7ll5ln\",\"name\":\"Rivet Contemporary Leather Office Desk Chair, 31&quot;, Curved Base, Brown\",\"description\":\"A distressed brown leather seat rests on a metal curved frame that includes armrests. The low back completes this prime example of mid-century retro design that will blend with today's modern or industrial decor. 22&quot;W x 23.6&quot;D x 63&quot;H Leather; iron frame with dark grey finish; hardwood Mid-century minimalist style This chair is ideal for an office but can serve as extra seating in living or dining areas No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Contemporary Leather Office Desk Chair, 31&quot;, Curved Base, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NumU03pvL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8183XPgmUsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8183XPgmUsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U1fGFnX9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U1fGFnX9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qHb+9JBML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qHb+9JBML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lkL+j4DlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lkL+j4DlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915yXkcHkCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915yXkcHkCL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"lab