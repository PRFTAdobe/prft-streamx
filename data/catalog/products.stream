    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082Q97X1G\",\"sku\":\"B082Q97X1G\",\"lang\":\"en\",\"slug\":\"troy-upholstered-love-seat-sofa-couch-56-w-ash-gray-b082q97x1g\",\"name\":\"Troy Upholstered Love Seat Sofa Couch, 56&quot;W, Ash Gray\",\"description\":\"This gray upholstered love seat sofa couch brings stylish charm to any living or family room. Durable fabric-covered foam seat cushions provide lasting comfort, and the modern design complements any decor. There is plenty of room for friends and family or to stretch out and watch a movie. This item is made to order just for you. Overall: 56&quot;W x 36&quot;D x 34&quot;H; seat height: 22&quot;H; seat depth: 20&quot;D; seat back height: 12&quot;H; arm height: 24&quot;H; leg height: 5.625&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Troy Upholstered Love Seat Sofa Couch, 56&quot;W, Ash Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81mI6mroVML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f+-RqaqpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f+-RqaqpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oSn101r5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oSn101r5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Lp2BUzGXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Lp2BUzGXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xH6IR1GDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xH6IR1GDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-