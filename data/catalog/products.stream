    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4G612M\",\"sku\":\"B07B4G612M\",\"lang\":\"en\",\"slug\":\"rivet-berkshire-mid-century-modern-sofa-couch-82-6-w-dark-grey-b07b4g612m\",\"name\":\"Rivet Berkshire Mid-Century Modern Sofa Couch, 82.6&quot;W, Dark Grey\",\"description\":\"Low-angled arms, deep seat cushions and lumbar pillows are hallmarks of this mid-century influenced design. Piping on the arms and slanted metal legs add additional visual interest to this sofa, which is sure to be a conversation piece. 82.6&quot;W x 37&quot;D x 32.2&quot;H; Seat Height: 18.8&quot;H ; Seat Depth: 22&quot;D; Seat Back Height: 21.2&quot;H; Arm Height: 22&quot;H; Leg Height: 5.5&quot; Polyester fabric on sturdy wood frame; metal legs with nickel finish Clean lines, low-slung arms and metal legs are hallmarks of mid-century modern style In addition to being a comfortable sofa, this is an eye-catching statement piece. Easy assembly in less than 30 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Berkshire Mid-Century Modern Sofa Couch, 82.6&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910yGgQMyVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+1GWAzmPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+1GWAzmPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SL2nBKXgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SL2nBKXgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mM5w0LUpS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mM5w0LUpS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PRNFqREBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PRNFqREBL.jpg\"},{\"alt\":\"https://storage.googleapis.com