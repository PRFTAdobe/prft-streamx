      "content": {
        "bytes": "{\"id\":\"B07B4MN127\",\"sku\":\"B07B4MN127\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-recliner-30-w-sand-b07b4mn127\",\"name\":\"Edmunds Traditional Recliner, 30&quot;W, Sand\",\"description\":\"Straight lines and narrow arms combine modern touches with classic fabric, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Stain-resistant polyester fabric on hardwood pine frame Streamlined silhouette combines modern style with a classic fabric for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Recliner, 30&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hIsvTytBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j+ojmRapL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91j+ojmRapL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mcokvbIKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91mcokvbIKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fjz+6exOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fjz+6exOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F4csB0M9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1F4csB0M9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13bVnAlLZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13bVnAlLZL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"88.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Office\",\"label\":\"Office\"},{\"value\":\"Prime\",\"label\":\"Prime\"},{\"value\":\"Hugger\",\"label\":\"Hugger\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"610\",\"label\":\"610\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Infinite\",\"label\":\"Infinite\"},{\"value\":\"Recline\",\"label\":\"Recline\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Best\",\"label\":\"Best\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Cuddler\",\"label\":\"Cuddler\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Zero\",\"label\":\"Zero\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Motor\",\"label\":\"Motor\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Rv\",\"label\":\"Rv\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Perfect\",\"label\":\"Perfect\"},{\"value\":\"Seats\",\"label\":\"Seats\"},{\"value\":\"Lazy\",\"label\":\"Lazy\"},{\"value\":\"Heat\",\"label\":\"Heat\"},{\"value\":\"Yard\",\"label\":\"Yard\"},{\"value\":\"Sleep\",\"label\":\"Sleep\"},{\"value\":\"Recliners\",\"label\":\"Recliners\"},{\"value\":\"Love\",\"label\":\"Love\"},{\"value\":\"Couches\",\"label\":\"Couches\"},{\"value\":\"Farmhouse\",\"labe