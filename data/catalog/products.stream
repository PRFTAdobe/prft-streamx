  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4D8945\",\"sku\":\"B07B4D8945\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-accent-chair-34-w-beige-b07b4d8945\",\"name\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Beige\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 34&quot;W x 33&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Back and seat cushions are removable and reversible, extending the life of the pieces Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Accent Chair, 34&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917oXuW+BqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I325No+wL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I325No+wL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81atOwxHZoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81atOwxHZoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QHq3AmdVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QHq3AmdVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tkk24lC5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tkk24lC5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima