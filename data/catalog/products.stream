      "content": {
        "bytes": "{\"id\":\"B07R7XFD22\",\"sku\":\"B07R7XFD22\",\"lang\":\"en\",\"slug\":\"foldable-18-metal-platform-bed-frame-with-tool-free-assembly-no-box-spring-needed-king-b07r7xfd22\",\"name\":\"Foldable, 18&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - King\",\"description\":\"Product Dimensions: 80&quot; L x 76&quot; W x 18&quot; H | Weight: 54.1 pounds King platform bed frame offers a quiet, noise-free, supportive foundation for a mattress. No box spring needed Folding mechanism makes the frame easy to store and move in tight spaces Made of durable steel with a sleek black finish Provides extra under-the-bed storage space Fast, easy setup—no tools required\",\"primaryImage\":{\"alt\":\"Foldable, 18&quot; Metal Platform Bed Frame with Tool-Free Assembly, No Box Spring Needed - King\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81J4zaMCFoL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WzMT6LwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915WzMT6LwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q04oGnSZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q04oGnSZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61On-pKOumL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DqEQ38XhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DqEQ38XhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814Bs7ryHSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814Bs7ryHSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61XF9oYh+3L.jpg\",\"url\":\"https://storage.googleap