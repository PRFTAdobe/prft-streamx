    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QB3D8Y\",\"sku\":\"B082QB3D8Y\",\"lang\":\"en\",\"slug\":\"cedar-upholstered-love-seat-sofa-couch-with-nailheads-67-w-midnight-gray-b082qb3d8y\",\"name\":\"Cedar Upholstered Love Seat Sofa Couch with Nailheads, 67&quot;W, Midnight Gray\",\"description\":\"This gray upholstered love seat brings a stylish charm to any room. Durable fabric-covered foam seat cushions provide lasting comfort, and the rustic nailhead trim enhances any decor. This will be your favorite spot to curl up and read a book or enjoy your favorite hot beverage. This item is made to order just for you. Overall: 67&quot;W x 38&quot;D x 30&quot;H; seat height: 19&quot;H; seat depth: 20&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 2.75&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cedar Upholstered Love Seat Sofa Couch with Nailheads, 67&quot;W, Midnight Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KwBoNlnAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9117cExLsoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9117cExLsoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81USXUWa-UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81USXUWa-UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xXiG2V1jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91xXiG2V1jL.jpg\"},{\"a