    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWMQQ3J\",\"sku\":\"B07BWMQQ3J\",\"lang\":\"en\",\"slug\":\"andover-right-facing-l-shaped-sectional-124-w-driftwood-leather-b07bwmqq3j\",\"name\":\"Andover Right-Facing L-Shaped Sectional, 124&quot;W, Driftwood Leather\",\"description\":\"Complete your living space with this stylish sectional. With its driftwood-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 124&quot;W x 96&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Right-Facing L-Shaped Sectional, 124&quot;W, Driftwood Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZgDwhMf6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EQpWh2BzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91EQpWh2BzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cTKIRJaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815cTKIRJaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VRPhoZl5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VRPhoZl5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WpSrVB3CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WpSrVB3CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pbAjIA4JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pbAjIA4JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sbfjeuP7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sbfjeuP7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81waMwhqPIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81waMwhqPIL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"96.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"124.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"172.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Sofas\",\"label\":\"Sofas\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":377,\"discountedValue\":339.3}}"
