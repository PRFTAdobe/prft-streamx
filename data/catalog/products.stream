    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MHTG1\",\"sku\":\"B07B4MHTG1\",\"lang\":\"en\",\"slug\":\"andover-modern-right-chaise-sofa-sectional-126-w-cream-b07b4mhtg1\",\"name\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Cream\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, these pieces are ready to withstand years of fun and cuddles with friends, family and pets. 126&quot;W x 61&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right Chaise Sofa Sectional, 126&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71V6c6T8FsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nS6JIeOuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nS6JIeOuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YkXCFf3kL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YkXCFf3kL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v1bKk2S+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17l1OYaC2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17l1OYaC2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Ef7pEx-nL.jpg\",\"url\":\"https://storage.g