    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W2RH7F\",\"sku\":\"B084W2RH7F\",\"lang\":\"en\",\"slug\":\"flanigan-curved-back-upholstered-dining-chair-24-4-w-hemp-b084w2rh7f\",\"name\":\"Flanigan Curved-Back Upholstered Dining Chair, 24.4&quot;W, Hemp\",\"description\":\"With lovely curved wingback styling, this hemp-colored upholstered dining chair will enhance your dining area with its classic charm. The sturdy wood frame and cushioned seat give this chair timeless allure. Both moisture repellent and stain resistant, it is ready for anything. 24.4&quot;W x 24.8&quot;D x 37.8&quot;H; seat height: 19.3&quot;H; seat depth: 17.3&quot;D; seat back height: 22.8&quot;H; leg height: 15&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric Armless, cushioned, high-back style exudes easy luxury. Wingback dining chair with polished brass nailhead trim No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Flanigan Curved-Back Upholstered Dining Chair, 24.4&quot;W, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n-cG45hJL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8132zAzdwkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8132zAzdwkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D30Eh5DwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D30Eh5DwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+3UO+0NkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91+3UO+0NkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81018e1FFiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81018e1FFiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/