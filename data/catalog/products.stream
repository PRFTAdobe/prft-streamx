    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QDL4228\",\"sku\":\"B07QDL4228\",\"lang\":\"en\",\"slug\":\"elizabeth-contemporary-loveseat-sofa-65-w-blue-b07qdl4228\",\"name\":\"Elizabeth Contemporary Loveseat Sofa, 65&quot;W, Blue\",\"description\":\"Clean lines give this loveseat sofa a modern, sophisticated look. Removable seat cushions and backs are comfortable and easy to adjust, with performance fabric upholstery to help reduce the wear and tear caused by daily life. Steel seat springs and a wood frame provide structure, support and durability. 65&quot;W x 38&quot;D x 38&quot;H Wood frame and legs, steel springs, foam, fiber Loose, reversible back and seat cushions in durable upholstery This contemporary blue sofa with espresso wood legs matches most decor styles Assemble in 15 minutes or less Lightly vacuum every month or two to remove dirt and dust Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elizabeth Contemporary Loveseat Sofa, 65&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911viZX9A0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pVXlY82AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pVXlY82AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-DkmaPlXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81-DkmaPlXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919vfI5R19L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919vfI5R19L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19Gea9MNEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19Gea9MNEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914QZ9ph4GL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9