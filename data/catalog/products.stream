        "bytes": "{\"id\":\"B07HSK7Z85\",\"sku\":\"B07HSK7Z85\",\"lang\":\"en\",\"slug\":\"rivet-decatur-modern-kitchen-bar-stool-41-h-chalk-b07hsk7z85\",\"name\":\"Rivet Decatur Modern Kitchen Bar Stool, 41&quot;H, Chalk\",\"description\":\"This beautiful modern barstool features a bold squared-off design for both the seat and legs. The metal frame, supported by an H-spreader bar encompasses a plush, backed, armless seat covered in durable upholstery. Overall: 22&quot;D x 18&quot;W x 41&quot;H. Seat height: 30&quot; Solid wooden frame and black metal legs combine for maximum style and support Avoid moisture. Wipes clean with soft, dry cloth. Arrives fully assembled. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Decatur Modern Kitchen Bar Stool, 41&quot;H, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716bMBCh70L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wBpFGuSIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wBpFGuSIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OtPIV96CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OtPIV96CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Y76I5-q+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Y76I5-q+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w0ieFO1BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91w0ieFO1BL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"41.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"