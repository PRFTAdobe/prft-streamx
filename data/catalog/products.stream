    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08F2G7JMZ\",\"sku\":\"B08F2G7JMZ\",\"lang\":\"en\",\"slug\":\"rivet-julie-mid-century-modern-dining-room-accent-chair-with-arms-32-h-light-grey-renewed-b08f2g7jmz\",\"name\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Light Grey (Renewed)\",\"description\":\"This classic mid-century modern accent chair features a simple, clean design with narrow armrests and tapered legs. Plenty of padding makes it sturdy and comfortable to use in the dining room or anywhere else extra seating is needed. 24&quot;W x 24&quot;D x 32&quot;H; seat height: 19&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Fabric is 60% polyester/20% linen/20% rayon; hardwood legs with espresso finish Foam padding and elastic suspension system keep back and seat firm and springy No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julie Mid-Century Modern Dining Room Accent Chair with Arms, 32&quot;H, Light Grey (Renewed)\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91rpZe4W6+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ofLphXakL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ofLphXakL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e6YxRvqQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91e6YxRvqQL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"18.7\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Dining chair\",\"label\":\"Dining chair\"},{\"value\":\"Dining chairs set of 4\",\"label\":\"Dining chairs set of 4\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Light gray\",\"label\":\"Light gray\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Kitchen chairs\",\"label\":\"Kitchen chairs\"},{\"value\":\"Dining chairs\",\"label\":\"Dining chairs\"},{\"value\":\"Dining table set\",\"label\":\"Dining table set\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Dining-chairs\",\"label\":\"Dining-chairs\"},{\"value\":\"Accent chair set of 2\",\"label\":\"Accent chair set of 2\"},{\"value\":\"Grey\",\"label\":\"Grey\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":401,\"discountedValue\":360.9}}"
