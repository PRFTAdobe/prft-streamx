    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P6JTZ1K\",\"sku\":\"B07P6JTZ1K\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-upholstered-sofa-92-w-stone-b07p6jtz1k\",\"name\":\"Charles Classic Oversized Upholstered Sofa, 92&quot;W, Stone\",\"description\":\"Let yourself be wrapped in comfort by this generously plush sofa. Traditional rolled arms and turned wood legs are combined with modern upholstery for a welcome update on a classic piece. 92&quot;W x 39&quot;D x 38&quot;H Solid hardwood frame; upholstery: 95% polyester, 5% nylon Removable back and seat cushions make upkeep a breeze. A traditional silhouette is paired with modern, stain-resistant fabric, making this the perfect addition to a busy home. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Upholstered Sofa, 92&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71DlCqKrXYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qHrZ7RXSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qHrZ7RXSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71V9e1iUM8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71V9e1iUM8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OEkTqNAWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OEkTqNAWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wRI0xoGjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wRI0xoGjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ERh0ooLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916ERh0ooLL.jpg\"}],\"attributes\":[{\"name\":\"height\