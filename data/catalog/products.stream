    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853NYVYL\",\"sku\":\"B0853NYVYL\",\"lang\":\"en\",\"slug\":\"rivet-stowell-modern-low-profile-glider-chair-with-sloping-back-and-arms-29-5-w-sunday-silver-b0853nyvyl\",\"name\":\"Rivet Stowell Modern Low-Profile Glider Chair with Sloping Back and Arms, 29.5&quot;W, Sunday Silver\",\"description\":\"A sloping back and arms provide support and a modern look to this foam-padded, low-profile gliding chair. Soft upholstery in a Sunday silver color makes this piece an elegant addition wherever you need seating. Relax with this glider’s gentle rocking motion every time you sit down. 29.5&quot;W x 34.3&quot;D x 31.5&quot;H; seat height: 18.1&quot;H; seat depth: 22&quot;D; seat back height: 28.3&quot;H; arm height: 24.4&quot;H Soft polyester upholstery and foam padding Gliding motion provides extra comfort and relaxation. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Stowell Modern Low-Profile Glider Chair with Sloping Back and Arms, 29.5&quot;W, Sunday Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81HWhVeElrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MBfO2BQmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81MBfO2BQmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812G7ksVqaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812G7ksVqaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WU2v9Rq-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WU2v9Rq-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FT2Y9E36L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FT2Y9E36L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresi