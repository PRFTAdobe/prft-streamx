    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QDC64H\",\"sku\":\"B082QDC64H\",\"lang\":\"en\",\"slug\":\"rivet-revere-round-leather-iron-framed-ottoman-30-3-w-cognac-b082qdc64h\",\"name\":\"Rivet Revere Round Leather Iron-Framed Ottoman, 30.3&quot;W, Cognac\",\"description\":\"Your feet and legs will rest comfortably on the foam padding in this ottoman. A powder-coated iron frame forms a steady base. Upholstery in a rich cognac color ensures that this piece will blend with all color schemes and design tastes, making this a simple way to spruce up your space. 30.3&quot;W x 30.3&quot;D x 18.1&quot;H; seat height: 18.1&quot;H; seat depth: 30.3&quot;D; leg height: 7.3&quot;H Powdered-iron base, leather upholstery An easy and stylish way to add comfort to any seating area, this ottoman is foam padded to create soft support. No assembly required Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Revere Round Leather Iron-Framed Ottoman, 30.3&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BJJODqbVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61w4t4Ld4yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61w4t4Ld4yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71c9piBo+fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71c9piBo+fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cvWQHKNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cvWQHKNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ju2k4xe+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ju2k4xe+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TUcn9Um4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TUcn9Um4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718PFv9KrwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718PFv9KrwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.9\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Jennifer\",\"label\":\"Jennifer\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Mattress\",\"label\":\"Mattress\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Inch\",\"label\":\"Inch\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Black\",\"label\":\"Black\"},{\"value\":\"Sleeper\",\"label\":\"Sleeper\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Benches\",\"label\":\"Benches\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Stools\",\"label\":\"Stools\"},{\"value\":\"Entryway\",\"label\":\"Entryway\"},{\"value\":\"Footstool\",\"label\":\"Footstool\"},{\"value\":\"Bedroom\",\"label\":\"Bedroom\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Best\",\"label\":\"Best\"},{\"value\":\"Footstools\",\"label\":\"Footstools\"},{\"value\":\"Hallway\",\"label\":\"Hallway\"},{\"value\":\"10\",\"label\":\"10\"},{\"value\":\"Decorative\",\"label\":\"Decorative\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"12\",\"label\":\"12\"},{\"value\":\"Fringed\",\"