    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJYGDZ9\",\"sku\":\"B07QJYGDZ9\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-leather-sectional-with-tapered-wood-legs-86-w-dark-brown-b07qjygdz9\",\"name\":\"Rivet Aiden Mid-Century Leather Sectional with Tapered Wood Legs, 86&quot;W, Dark Brown\",\"description\":\"This sectional features easy-care leather with removable cushions that will help keep cleaning simple, and the attractive brown color will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 86&quot;W x 37&quot;D x 33&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable and reversible seat and back cushions Mid-century style and top grain leather combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Leather Sectional with Tapered Wood Legs, 86&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71f6S4g0XLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61wgyE5EIkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61wgyE5EIkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913bAFTWROL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913bAFTWROL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61iQC0GQkwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61iQC0GQkwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qLcJF1SZL.jpg\",\