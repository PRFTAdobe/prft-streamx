    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCMB7LV\",\"sku\":\"B07QCMB7LV\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-channel-backed-loveseat-75-w-felt-grey-b07qcmb7lv\",\"name\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat, 75&quot;W, Felt Grey\",\"description\":\"A channeled back brings elegance to this mid-century love seat with tapered wood legs. The solid hardwood frame combines with the durable upholstery, decreasing the wear and tear that comes with daily life and helping to keep this love seat looking like new. 75&quot;W x 38&quot;D x 32&quot;H Solid hardwood frame, 100% polyester fabric, bench seat cushion with high-density foam, tapered wood legs, brass metal cap Removable and reversible seat cushion A solid hardwood frame with high-density foam adds durability to this channel-backed mid-century love seat. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Channel-Backed Loveseat, 75&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yl1cVHO1L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RqD6B0JFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RqD6B0JFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nhcBORk0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nhcBORk0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815Bx7MqL0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815Bx7MqL0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/