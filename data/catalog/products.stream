    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBQFF7P\",\"sku\":\"B07QBQFF7P\",\"lang\":\"en\",\"slug\":\"canton-twin-button-tufted-headboard-42-w-romero-cream-b07qbqff7p\",\"name\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Romero Cream\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft cream-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 42&quot;W x 3&quot;D x 62&quot;H Polypropylene fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Romero Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71g6L5g8NtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KgaI-vIYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yfkwQdw9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71yfkwQdw9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I4vwmiZNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I4vwmiZNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819kzkl3ERL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819kzkl3ERL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{