    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082KVVQH1\",\"sku\":\"B082KVVQH1\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-bonded-leather-swivel-office-chair-with-chrome-metal-base-22-8-w-saddle-brown-b082kvvqh1\",\"name\":\"Rivet Mid-Century Bonded Leather Swivel Office Chair with Chrome Metal Base, 22.8&quot;W, Saddle Brown\",\"description\":\"Strength, style, and substance come together in this lovely saddle-brown leather task chair. Mid-century styling means this chair can add a touch of tradition to a modern space or a hint of simplicity to a classic space. Casters and a metal base enhance flexibility and utility. 22.8&quot;W x 15.7&quot;D x 39&quot;–42.9&quot;H; seat height: 16.9&quot;–20.9&quot;H; seat depth: 19.7&quot;D; seat back height: 18.9&quot;H; arm height: 26&quot;–29.1&quot;H; leg height: 13&quot;–16.9&quot;H Bonded leather and foam cushioning over a metal and plywood frame with metal base and rolling caster wheels This leather desk chair looks like it's straight out of the CEO's office—polished, professional, and luxurious. Simple assembly in 15 minutes Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days; 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Bonded Leather Swivel Office Chair with Chrome Metal Base, 22.8&quot;W, Saddle Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cJPQSTT8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716gGNdI-rL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716gGNdI-rL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hff-71rrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hff-71rrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kjb4QIW2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71kjb4QIW2L.jpg\"},{\"alt\":\"https://storage.googleap