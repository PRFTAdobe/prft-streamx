        "bytes": "{\"id\":\"B07B7B94DP\",\"sku\":\"B07B7B94DP\",\"lang\":\"en\",\"slug\":\"hughes-casual-wood-dining-room-kitchen-chairs-set-of-2-grey-b07b7b94dp\",\"name\":\"Hughes Casual Wood Dining Room Kitchen Chairs, Set of 2, Grey\",\"description\":\"A rustic wood back, along with a warm natural finish, give this chair a welcoming and inviting vibe. Performance fabric on the seat cushion and high quality construction ensure it will last through many meals around your dining room table. 23.25&quot;L x 19&quot;W x 39&quot;H Hardwood back, legs and frame; cushion covered with 100% polyester performance fabric A casual rustic style that's warm and inviting Performance fabric and solid construction enhance this chair's durability Assembly in 30 minutes or less; just bolt on back and legs Free returns for 30 days; 3-year warranty\",\"primaryImage\":{\"alt\":\"Hughes Casual Wood Dining Room Kitchen Chairs, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Fx7mHvttL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SQivFbwqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SQivFbwqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cZ5TPTSFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cZ5TPTSFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18j-IPDptS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18j-IPDptS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918gkKuop5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918gkKuop5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KJ6v2V3zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81KJ6v2V3zL.jpg\"}],\"attributes\":[{\"name\":\