      "content": {
        "bytes": "{\"id\":\"B071LTB14G\",\"sku\":\"B071LTB14G\",\"lang\":\"en\",\"slug\":\"rivet-elliot-easy-pull-modern-sofa-bed-71-w-grey-b071ltb14g\",\"name\":\"Rivet Elliot Easy-Pull Modern Sofa Bed, 71&quot;W, Grey\",\"description\":\"This modern sofa is a comfortable place for you and your friends to enjoy many game nights. Getting late? Just remove the cushions and pull out the bed for guests who may or may not have planned to crash overnight. 36.6''D x 71.3 ”W x 35.4 ''H Solid beech wood legs with espresso-color finish Modern Practical, clean design will fit with your existing style. No assembly. Product arrives in one piece. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Elliot Easy-Pull Modern Sofa Bed, 71&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A163vNReYKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-6uv3WcVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-6uv3WcVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p7E02X09L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91p7E02X09L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TrMuon-hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1TrMuon-hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sWet5xhSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1sWet5xhSS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.3\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"71.3\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"1