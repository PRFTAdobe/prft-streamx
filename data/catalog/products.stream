    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5CS\",\"sku\":\"B075X4F5CS\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-sofa-78-w-smoke-b075x4f5cs\",\"name\":\"Rivet Lawson Modern Angled Sofa, 78&quot;W, Smoke\",\"description\":\"This item is made to order just for you 78&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% polyester upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated sofa. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Sofa, 78&quot;W, Smoke\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rBbZdHUHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MmccXgfLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MmccXgfLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iO8ve1nlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iO8ve1nlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Vt8OYo1zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Vt8OYo1zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ainMgdEhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ainMgdEhL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"114.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Smoke\",\"label\":\"Smoke\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":677,\"discountedValue\":609.3}}"
