    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MRPVT\",\"sku\":\"B07B4MRPVT\",\"lang\":\"en\",\"slug\":\"brandeberry-leather-loveseat-58-w-driftwood-b07b4mrpvt\",\"name\":\"Brandeberry Leather Loveseat, 58&quot;W, Driftwood\",\"description\":\"Complete your interior design with this elegant loveseat. With its rich driftwood-colored leather, this loveseat is an ideal match for traditional, farmhouse, or vintage home decor. The sturdy wood frame and reversible cushions add durability and extend the life of this beautiful piece. Overall: 58&quot;W x 43&quot;D x 39&quot;H; seat height: 21&quot;H; seat depth: 22&quot;D; seat back height: 37&quot;H; arm height: 27&quot;H; leg height: 5.25&quot;H Sturdy wood frame with rich top-grain leather upholstery Rich leather enhances tasteful traditional style Sturdy frame; reversible cushions for durability; front-leg casters make it easy to move Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Brandeberry Leather Loveseat, 58&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61sZds3e+mL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91roWqD+G+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91roWqD+G+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/613vwLhTjRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/613vwLhTjRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FB0ZbN7BL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FB0ZbN7BL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/