    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07J2KFXC7\",\"sku\":\"B07J2KFXC7\",\"lang\":\"en\",\"slug\":\"rivet-alvin-contemporary-sofa-couch-81-w-aqua-teal-blue-b07j2kfxc7\",\"name\":\"Rivet Alvin Contemporary Sofa Couch, 81&quot;W, Aqua Teal Blue\",\"description\":\"If you’re looking for a piece that’s at once modern and timeless, this sofa is for you. The button-tufted, fixed back gently curves into a pair of elegant armrests, and two firm, spacious seat cushions add durability and comfort. Overall: 81&quot;W x 37&quot;D x 32&quot;H; Seat Height: 18.11&quot;H; Seat Depth: 23.23&quot;D; Seat Back Height: 32&quot;H; Arm Height: 22.05&quot;H; Leg Height: 7.09&quot;H Solid-wood frame and legs with performance upholstery Modern, simple design that combines Mid-century touches with contemporary Scandinavian appeal Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Alvin Contemporary Sofa Couch, 81&quot;W, Aqua Teal Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812U-A+TKrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TS--sw-ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TS--sw-ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91phMUkUg2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91phMUkUg2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x6HtWFrkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x6HtWFrkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VvQcYaIwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VvQcYaIwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815mCMMvpgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/