    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP32LQ\",\"sku\":\"B075YP32LQ\",\"lang\":\"en\",\"slug\":\"rivet-florence-mid-century-modern-set-of-2-wide-open-back-accent-kitchen-dining-room-chairs-18-8-w-navy-blue-b075yp32lq\",\"name\":\"Rivet Florence Mid-Century Modern Set of 2 Wide Open-Back Accent Kitchen Dining Room Chairs, 18.8&quot;W, Navy Blue\",\"description\":\"The unique shape of this Mid-century modern chair's open back give it a light, airy feel that works in a dining room, craft room, home office -- anywhere you need an extra seat. It's easy to move between rooms and up and down stairs. Hardwood upholstered with polyester fabric; black metal legs Ideal for any home needing furniture that multi-tasks. 2 chairs to a pack. Assembly in 15 minutes; attach base with 4 screws. Vaccuum, spot clean with damp cloth. Free returns for 30 days. 1-year warranty. 18.8&quot;W x 22.8&quot;D x 33.9&quot;H. 18.7&quot; Seat height\",\"primaryImage\":{\"alt\":\"Rivet Florence Mid-Century Modern Set of 2 Wide Open-Back Accent Kitchen Dining Room Chairs, 18.8&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nlq2X3-TL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jDb7JhNOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81jDb7JhNOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B2A5CNQsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91B2A5CNQsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aqnSPtUnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81aqnSPtUnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rc9EdEIzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1rc9EdEIzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1