    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4PT96\",\"sku\":\"B075X4PT96\",\"lang\":\"en\",\"slug\":\"marin-leather-nailhead-studded-sofa-couch-87-w-driftwood-b075x4pt96\",\"name\":\"Marin Leather Nailhead Studded Sofa Couch, 87&quot;W, Driftwood\",\"description\":\"This item is made to order just for you 87&quot;W x 41&quot;D x 37&quot;H Sturdy hardwood frame with rich leather upholstery Removable and reversible back and seat cushions add lasting style. Assemble in 15 minutes or less. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty. Rich leather and clean lines accentuated by trim and nailhead detail will have this transitional sofa turning heads. The loose back and plush seat cushions, and tapered wood legs, add to the sophisticated silhouette.\",\"primaryImage\":{\"alt\":\"Marin Leather Nailhead Studded Sofa Couch, 87&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81X541qU-OL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Edf-2+sEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Edf-2+sEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZBTZbsr6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZBTZbsr6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1zec8KS5BS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1stIiF5rQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1stIiF5rQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdUgQF6JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdUgQF6JL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\