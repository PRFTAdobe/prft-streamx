    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MHCDR\",\"sku\":\"B07B4MHCDR\",\"lang\":\"en\",\"slug\":\"andover-modern-sofa-couch-93-w-grey-b07b4mhcdr\",\"name\":\"Andover Modern Sofa Couch, 93&quot;W, Grey\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 93&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; choose the configuration thats right for you Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Sofa Couch, 93&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1STIzQe44L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mwlI4P6XL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mwlI4P6XL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91S+x5NJdAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qeu3iwjBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91qeu3iwjBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELdgTslyS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ELdgTslyS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1yB7SOh0IS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim