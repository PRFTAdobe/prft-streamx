    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LM53Z\",\"sku\":\"B07P5LM53Z\",\"lang\":\"en\",\"slug\":\"rivet-sloane-modern-leather-armchair-with-tapered-legs-32-7-w-caramel-b07p5lm53z\",\"name\":\"Rivet Sloane Modern Leather Armchair with Tapered Legs, 32.7&quot;W, Caramel\",\"description\":\"This modern armchair sports a strong profile and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The leather upholstery and solid-wood frame make this piece both cozy and reliable. 32.7&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; leather upholstery A solid wood frame and leather upholstery make this armchair as practical as it is stylish. Tapered legs add elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Modern Leather Armchair with Tapered Legs, 32.7&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8104fkqvLRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UAfsr0KlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UAfsr0KlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719RkNmJJ8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719RkNmJJ8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910G1Wg087L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/910G1Wg087L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8189yjRT+uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8189yjRT+uL.jpg\"}],\"att