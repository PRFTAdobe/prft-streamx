    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSDP2CP\",\"sku\":\"B07HSDP2CP\",\"lang\":\"en\",\"slug\":\"rivet-modern-chest-of-drawers-with-diamond-pattern-17-3-w-walnut-amp-gray-wash-b07hsdp2cp\",\"name\":\"Rivet Modern Chest of Drawers with Diamond Pattern 17.3&quot;W, Walnut &amp; Gray Wash\",\"description\":\"A convex diamond pattern adorns the door fronts of this sophisticated hardwood cabinet. The top and sides—honey-colored with a wire-brushed finish—complete this piece’s contemporary look. Inside the 2 doors is a shelf that provides 2-tiered storage. 17.3&quot;W x 37.8&quot;L x 33.5H Solid hardwood with French honey and dark coffee finish; splayed metal legs in a dark gunmetal finish This clean-lined cabinet is inspired by modern design, but the unique door fronts give it a glam or sophisticated appeal. Two doors with interior shelf Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Modern Chest of Drawers with Diamond Pattern 17.3&quot;W, Walnut &amp; Gray Wash\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FbLksX0LL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O4jB7K10L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91O4jB7K10L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXKv0NItL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tXKv0NItL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rDsfFrjsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rDsfFrjsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SADpVJHML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SADpVJHML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t9t4wiXTL.jpg\",\"url\":\"https://storage.