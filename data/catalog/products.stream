  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0831Y1G6Y\",\"sku\":\"B0831Y1G6Y\",\"lang\":\"en\",\"slug\":\"lyon-upholstered-chair-and-a-half-55-w-linen-b0831y1g6y\",\"name\":\"Lyon Upholstered Chair-and-a-Half, 55&quot;W, Linen\",\"description\":\"This sumptuous chair-and-a-half is the ultimate in roomy comfort. The linen-colored upholstery and modern design bring a distinctive flair to your living room or family room. Flared arms allow for maximum freedom of movement and the fully padded cushions provide long-lasting comfort. 55&quot;W x 38&quot;D x 37&quot;H; seat height: 21.5&quot;H; seat depth: 23.5&quot;D; seat back height: 30.5&quot;H; arm height: 30.5&quot;H; leg height: 6&quot;H Upholstered in 100% polyester fabric; fully padded solid wood frame with mortise and tenon construction Removable and reversible seat cushions; sinuous spring support system with durable foam-padded cushions Assemble in 15 minutes or less Spills should be spot cleaned and rinsed with water. Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Lyon Upholstered Chair-and-a-Half, 55&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sqcLcDy-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rP+1hNcwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rP+1hNcwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xfuikJnGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xfuikJnGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UGdSNG1HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UGdSNG1HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13XtUNzZxL.jpg\"},{\"alt\":\