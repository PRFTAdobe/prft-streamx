    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MJL5SZB\",\"sku\":\"B07MJL5SZB\",\"lang\":\"en\",\"slug\":\"ravenna-home-westcott-tufted-loveseat-sofa-couch-60-w-blue-velvet-b07mjl5szb\",\"name\":\"Ravenna Home Westcott Tufted Loveseat Sofa Couch, 60&quot;W, Blue Velvet\",\"description\":\"60&quot;W x 30.7&quot;D x 30.7&quot;H; seat height: 18.5&quot;H Wood; foam; velvet This loveseat has velvet upholstery, a button-tufted back, and rolled arms with a curving silhouette. Plush cushioning and soft fabric over a sturdy wooden frame. Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Ravenna Home Westcott Tufted Loveseat Sofa Couch, 60&quot;W, Blue Velvet\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/7103UoTKYWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hl64cKUrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71hl64cKUrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81alj4ahxCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81alj4ahxCL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712PoPLqLSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712PoPLqLSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712sjJwGUkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/712sjJwGUkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-F+2SE86L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-F+2SE86L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XY3NOABDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XY3NOABDL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value