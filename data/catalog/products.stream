  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4HZY8\",\"sku\":\"B075X4HZY8\",\"lang\":\"en\",\"slug\":\"janelle-button-tufted-round-leather-wheeled-ottoman-37-w-brown-saddle-b075x4hzy8\",\"name\":\"Janelle Button Tufted Round Leather Wheeled Ottoman, 37&quot;W, Brown Saddle\",\"description\":\"Tufting, buttons and nailhead trim come together in this stylish ottoman. Tightly tufted upholstery and spindled wooden legs accent a piece that's useful as a seat for an extra guest, as well as a place for tired feet or a snack tray. This item is made to order just for you 37&quot; Diameter. 19&quot;H. 100% leather; legs have dark walnut finish with metal nickel-finished casters. Smooth rolling casters. Ideal as extra seating, cocktail table, or foot stool. Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Janelle Button Tufted Round Leather Wheeled Ottoman, 37&quot;W, Brown Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nMp4FGopL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eDrN2BvbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eDrN2BvbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6ndATsbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91M6ndATsbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P-H8sOjUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P-H8sOjUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1mbv54efwS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1B2M9xHKjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1B2M9xHKjL.jpg\"}