    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ65Q43\",\"sku\":\"B07HZ65Q43\",\"lang\":\"en\",\"slug\":\"westcott-contemporary-93-sofa-fabric-93-w-silver-b07hz65q43\",\"name\":\"Westcott Contemporary 93&quot; Sofa, Fabric, 93&quot;W, Silver\",\"description\":\"This sofa’s base and armrests blend seamlessly to create continuous, cohesive look. The stain-resistant fabric allows for clean comfort, and the removable and reversible back and seat cushions add lasting style. Sturdy wood frame with stain-resistant fabric Removable and reversible back and seat cushions add lasting style. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 93&quot;W x 36&quot;D x 30&quot;H; seat height: 20&quot;H; seat depth: 24&quot;D; seat back height: 30&quot;H; arm height: 30&quot;H; leg height: 5.25&quot;H\",\"primaryImage\":{\"alt\":\"Westcott Contemporary 93&quot; Sofa, Fabric, 93&quot;W, Silver\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pgKZuij4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fmmqv2uMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1fmmqv2uMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DUSlP88ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DUSlP88ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vcNTCvILL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vcNTCvILL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Eny4G90qL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Eny4G90qL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2PgFoczL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1t2PgFoczL.jpg\"},{\"alt\