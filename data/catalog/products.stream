    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QJXK4BF\",\"sku\":\"B07QJXK4BF\",\"lang\":\"en\",\"slug\":\"rivet-damien-mid-century-modern-ottoman-30-w-felt-grey-b07qjxk4bf\",\"name\":\"Rivet Damien Mid-Century Modern Ottoman, 30&quot;W, Felt Grey\",\"description\":\"Tapered legs with brass caps bring elegance to any room with this mid-century ottoman. The solid hardwood frame combines with the durable upholstery, decreasing the wear and tear that comes with daily life and helping to keep this ottoman looking like new. 30&quot;W x 22&quot;L x 19&quot;H Solid hardwood frame, tapered wood legs, brass metal cap Mid-century style complements any decor. Tapered legs with brass caps add elegance to any room, while a solid hardwood frame increases the durability of this mid-century ottoman. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Damien Mid-Century Modern Ottoman, 30&quot;W, Felt Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+kB6wp8ZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918G+xiBbWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918G+xiBbWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Gvb5rn4eL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Gvb5rn4eL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81poWyV6WqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81poWyV6WqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rRmvJCWHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rRmvJCWHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wTcj7valL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori