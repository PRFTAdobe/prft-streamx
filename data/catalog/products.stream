    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WNRP\",\"sku\":\"B075X2WNRP\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-leather-bench-seat-sofa-without-side-pillows-74-w-cognac-b075x2wnrp\",\"name\":\"Rivet Aiden Tufted Mid-Century Leather Bench Seat Sofa, Without Side Pillows, 74&quot;W, Cognac\",\"description\":\"This sleek, Mid-century inspired leather sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 74''W x 36.2”D x 30.3”H Soft top-grain leather; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Leather Bench Seat Sofa, Without Side Pillows, 74&quot;W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81U2VuTyDTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qRYLbP-gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qRYLbP-gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+SltEN8IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+SltEN8IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XbizwO7TL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XbizwO7TL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810tgXv+cJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810tgXv+cJL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",