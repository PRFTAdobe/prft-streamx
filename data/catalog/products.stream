    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07124WCJZ\",\"sku\":\"B07124WCJZ\",\"lang\":\"en\",\"slug\":\"highland-modern-wingback-living-room-accent-chair-31-9-w-caviar-b07124wcjz\",\"name\":\"Highland Modern Wingback Living Room Accent Chair, 31.9&quot;W, Caviar\",\"description\":\"Bridging classic and contemporary, this accent chair is a modern twist on the timeless wingback chair. The clean, updated style with thick-woven fabric brings welcoming comfort to your seating area. 31.9&quot;W x 37.8&quot;D x 42&quot;H Sustainably sourced solid beech wood covered in thick-woven fabric Contemporary Updated design on a classic piece blends well with existing décor. Minimal assembly; just attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Highland Modern Wingback Living Room Accent Chair, 31.9&quot;W, Caviar\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1WMSXFyZmS.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1lCPNZbcHS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1lCPNZbcHS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UK8YetaFS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UK8YetaFS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18LQNOAmhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A18LQNOAmhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913YyCr604L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913YyCr604L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NdPNNW60S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NdPNNW60S.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"42.1\",\"label\":\"inches\"}]},{\"name\":\"wi