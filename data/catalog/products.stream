        "bytes": "{\"id\":\"B0853N8T7M\",\"sku\":\"B0853N8T7M\",\"lang\":\"en\",\"slug\":\"rivet-rione-modern-leather-swivel-chair-with-rounded-back-30-3-w-marseille-cognac-b0853n8t7m\",\"name\":\"Rivet Rione Modern Leather Swivel Chair with Rounded Back, 30.3&quot;W, Marseille Cognac\",\"description\":\"Style and functionality meet in this low-profile, foam-padded swivel chair. The rotating base allows easy movement. A round back that curves into high arms provides ample support and gives the piece a classic look. Cognac-colored leather upholstery means this chair will blend with existing decor. 30.3&quot;W x 30.7&quot;D x 30.7&quot;H; seat height: 17.3&quot;H; seat depth: 20.9&quot;D; seat back height: 27.6&quot;H; arm height: 24.8&quot;H Top-grain leather upholstery and foam padding The swivel features allow for easy movement within the chair, providing extra convenience and comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Rione Modern Leather Swivel Chair with Rounded Back, 30.3&quot;W, Marseille Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TLj2+Fb6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YaQCA4sqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kGfKW7SPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kGfKW7SPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iT9ufuExL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iT9ufuExL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B20Nbj-0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71B20Nbj-0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+wFj6YP3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+wFj6YP3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PxzZdC-+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PxzZdC-+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n2YgU5xeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81n2YgU5xeL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.708662\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"30.708662\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"30.31496\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"44.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Oversized\",\"label\":\"Oversized\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Gdf\",\"label\":\"Gdf\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Studio\",\"label\":\"Studio\"},{\"value\":\"Lift\",\"label\":\"Lift\"},{\"value\":\"Design\",\"label\":\"Design\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Baxton\",\"label\":\"Baxton\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Seniors\",\"label\":\"Seniors\"},{\"value\":\"Room\",\"label\":\"Room\"},{\"value\":\"Big\",\"label\":\"Big\"},{\"value\":\"Egg\",\"label\":\"Egg\"},{\"value\":\"Living\",\"label\":\"Living\"},{\"value\":\"Electric\",\"label\":\"Electric\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Kieran\",\"label\":\"Kieran\"},{\"value\":\"Century\",\"label\":\"Century\"},{\"value\":\"Yandel\",\"label\":\"Yandel\"},{\"value\":\"Boy\",\"label\":\"Boy\"},{\"value\":\"Lazy\",\"label\":\"La