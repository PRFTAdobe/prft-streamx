    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YR7N1\",\"sku\":\"B07B4YR7N1\",\"lang\":\"en\",\"slug\":\"bridgewater-curved-king-headboard-82-w-curious-indigo-b07b4yr7n1\",\"name\":\"Bridgewater Curved King Headboard, 82&quot;W, Curious Indigo\",\"description\":\"This headboard adds classic style to any space. Hand-applied pewter nailhead trim accents the headboards curved silhouette. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you Polyster/linen blend fabric, polyurethane foam, plywood frame The headboard is fully upholstered on the front and the back. Compatible with most bolt-on bed frames. The sturdy frame is covered in a thick polyester padding for extra comfort. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty. 82&quot;W x 4&quot;D x 56&quot;H\",\"primaryImage\":{\"alt\":\"Bridgewater Curved King Headboard, 82&quot;W, Curious Indigo\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-XYyakGmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NqKyn99cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NqKyn99cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zmfSHbutL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zmfSHbutL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Av3Jd4tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+Av3Jd4tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s8QWDXxiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1s8QWDXxiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WnHQZiZhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WnHQZiZh