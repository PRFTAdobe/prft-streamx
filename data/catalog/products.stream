    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5DM\",\"sku\":\"B075X4F5DM\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-ottoman-27-w-blue-eclipse-b075x4f5dm\",\"name\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Blue Eclipse\",\"description\":\"You'll enjoy kicking up your tired feet, as well as always having a handy extra seat, with this sophisticated ottoman. Sleek lines with tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. This item is made to order just for you 27&quot;W x 20&quot;D x 16&quot;H Sturdy hardwood frame and legs with 92% polyester and 8% linen upholstery. Firm nylon webbing makes cushion resilient Free returns for 30 days. 1-year warranty. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Ottoman, 27&quot;W, Blue Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Dzc13zAsL.jpg\"},\"gallery\":[],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"16.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"27.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"20.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"32.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Blue eclipse\",\"label\":\"Blue eclipse\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label