    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075ZCLPHP\",\"sku\":\"B075ZCLPHP\",\"lang\":\"en\",\"slug\":\"rivet-stevie-velvet-mid-century-modern-kitchen-bar-stools-set-of-2-20-9-inch-height-yellow-green-b075zclphp\",\"name\":\"Rivet Stevie Velvet Mid-Century Modern Kitchen Bar Stools, Set of 2, 20.9 Inch Height, Yellow Green\",\"description\":\"These fun velvet stools will add a cheerful pop of color to any room. Flared modern metal legs are topped by velvet cushions for a plush, sturdy feel and a touch of glam. Move them around to any room where you need an extra seat. 15.75&quot; Diameter x 20.9&quot; H Velvet fabric over a hardwood frame; metal legs with black finish Brighten up a room and add extra seating with these stools Assemble in less than 10 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Stevie Velvet Mid-Century Modern Kitchen Bar Stools, Set of 2, 20.9 Inch Height, Yellow Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71AVoHd3p5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iQcVBYCGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81iQcVBYCGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GdlIRPkiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71GdlIRPkiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VwctBIkVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VwctBIkVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14i20u1OSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A14i20u1OSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zo+6AmHVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zo+6AmHVL.jpg\"}],\"att