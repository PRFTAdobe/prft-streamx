        "bytes": "{\"id\":\"B07BWKFNDK\",\"sku\":\"B07BWKFNDK\",\"lang\":\"en\",\"slug\":\"lummi-modern-armless-living-room-accent-chair-21-6-w-storm-grey-b07bwkfndk\",\"name\":\"Lummi Modern Armless Living Room Accent Chair, 21.6&quot; W, Storm Grey\",\"description\":\"Let your unique style shine through with this modern accent slipper chair. The soft brushed fabric blends well in your master suite or living room. 29.9&quot;D x 21.6&quot;W x 32.7&quot;H Beech wood frame covered in polyester fabric Modern Simple, streamlined design will complement your existing style Minimal assembly; just attach legs Free returns for 30 days. 3 year warranty.\",\"primaryImage\":{\"alt\":\"Lummi Modern Armless Living Room Accent Chair, 21.6&quot; W, Storm Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VInHRb0OL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YVWA-peuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81YVWA-peuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LoNuxW8RL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LoNuxW8RL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815gy3m3JLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815gy3m3JLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cv8BvxMwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cv8BvxMwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nYcyq1c+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nYcyq1c+L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"32.7\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"29.9\",\"label\":\"inches\"}