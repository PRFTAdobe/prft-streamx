    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B79WTSL\",\"sku\":\"B07B79WTSL\",\"lang\":\"en\",\"slug\":\"rivet-fir-mid-century-modern-velvet-dining-kitchen-chair-23-6-w-green-b07b79wtsl\",\"name\":\"Rivet Fir Mid-Century Modern Velvet Dining Kitchen Chair, 23.6&quot;W, Green\",\"description\":\"This velvet chair brings mid-century modern flair to any room. Sloping low-profile arms, the lower back opening, and tapered wooden legs are hallmarks of retro style, while the gold-tone metal leg caps and rich colors add glam effects. 23.6&quot;W x 24.8&quot;D x 35.4&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 17.7&quot;D; Seat Back Height: 15.7&quot;H Upholstered back, seat and sloping armrests provide comfort; solid wood frame adds support. This chair is a Mid-Century glam style statement in your dining room or anywhere you need extra seating. No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fir Mid-Century Modern Velvet Dining Kitchen Chair, 23.6&quot;W, Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71w7fL49XcL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91i4M1My8KL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91i4M1My8KL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Aha3I7kLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Aha3I7kLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jtKXQdMtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jtKXQdMtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zn69xlLcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Zn69xlLcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918KrAj2OIL.jpg\",\"url\":\"https://storage.googleapis.com/pures