    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4CZRMJ\",\"sku\":\"B07B4CZRMJ\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-recliner-30-w-light-blue-b07b4czrmj\",\"name\":\"Edmunds Traditional Recliner, 30&quot;W, Light Blue\",\"description\":\"Straight lines and narrow arms combine modern touches with classic fabric, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies shows and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Stain-resistant polyester fabric on hardwood pine frame Streamlined silhouette combines modern style with a classic fabric for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Recliner, 30&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P7YTxgK7L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MUQH5tzNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MUQH5tzNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ym2Zf-ZFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ym2Zf-ZFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eibXbocNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eibXbocNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SvVBGuyvS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SvVBGuyvS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SnB0u1KOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origi