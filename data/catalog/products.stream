    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B085GWXXNR\",\"sku\":\"B085GWXXNR\",\"lang\":\"en\",\"slug\":\"cambridge-upholstered-recliner-rocking-chair-31-w-beige-b085gwxxnr\",\"name\":\"Cambridge Upholstered Recliner Rocking Chair, 31&quot;W, Beige\",\"description\":\"Cream upholstery creates a classic look, making this piece a decor standout in addition to being a great place to relax. Rock or recline easily without worrying about noise or excessive wear and tear. The mechanisms make this chair’s motions smooth and quiet. 31&quot;W x 37&quot;D x 40&quot;H; seat height: 20&quot;H; seat back height: 40&quot;H; seat depth: 21&quot;D; arm height: 25&quot;H Kiln-dried hardwood, engineered wood, and high-density oriented strand board frame. Steel seat and back springs. High-resilience memory foam cushions. Upholstery fabric feels soft and plush to the touch but is also durable enough to pass rigorous seam-fatigue testing. Assemble in 15 minutes or less Clean only with water-based shampoo or foam upholstery cleaner. Do not saturate. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Cambridge Upholstered Recliner Rocking Chair, 31&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gCKIP7zOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qs3RBz0ML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Qs3RBz0ML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P3TqmcfiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81P3TqmcfiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ohCkaojrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ohCkaojrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eUqAr+5dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eU