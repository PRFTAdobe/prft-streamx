    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4N27B1\",\"sku\":\"B07B4N27B1\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-u-sectional-117-w-blue-b07b4n27b1\",\"name\":\"Rivet Edgewest Low Back Modern Left U-Sectional, 117&quot;W, Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left U-Sectional, 117&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C+lKuEGYL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gwmKRIWWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gwmKRIWWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u825Kz74L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u825Kz74L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ttUYg+ZWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ttUYg+ZWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pWTfvIDRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1pWTfvIDRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/origin