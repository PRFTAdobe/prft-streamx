    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F4SF\",\"sku\":\"B075X4F4SF\",\"lang\":\"en\",\"slug\":\"rivet-uptown-mid-century-velvet-tufted-customizable-daybed-sofa-78-w-shadow-amp-brass-b075x4f4sf\",\"name\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Shadow &amp; Brass\",\"description\":\"This item is made to order just for you 78&quot;W x 27&quot;D x 25&quot;H Solid wood frame, soft velvet upholstery and brass metal finish Highly versatile piece for extra seating in a living room or at the foot of a bed Free returns for 30 days. 1-year warranty. Elevate your style with a functional piece that can serve as a daybed and loveseat. A long tufted cushion, arms with side bolster pillows, and metal legs in three choices of finish make it perfect for the living room or at the foot of a bed. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Uptown Mid-Century Velvet Tufted Customizable Daybed Sofa, 78&quot;W, Shadow &amp; Brass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OVPTdJR3L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1byUVCmk1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1byUVCmk1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16cSY1jDnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16cSY1jDnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SdLzZSBiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81SdLzZSBiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iCpcLd71L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iCpcLd71L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xEDYMbguL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag