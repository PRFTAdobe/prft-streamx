    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2PC3L\",\"sku\":\"B075X2PC3L\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-leonard-2-tone-bedroom-dresser-62-w-walnut-birch-finish-b075x2pc3l\",\"name\":\"Rivet Mid-Century Leonard 2-Tone Bedroom Dresser, 62&quot;W, Walnut, Birch Finish\",\"description\":\"This mid-century modern dresser will add handsome style while holding plenty of clothing in six drawers. Walnut veneer on the front and darker birch finish on the top and sides gives it a two-tone effect accented by brass pulls. 62&quot;W x 18&quot;D x 35&quot;H Solid hardwood with walnut and birch veneers, brass drawer pulls Mid-century with touches of glam and industrial to blend with modern-style rooms Drawers have concealed slow-close glides underneath for a sleek design. Simple assembly in 15 minutes. Just add legs. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Leonard 2-Tone Bedroom Dresser, 62&quot;W, Walnut, Birch Finish\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KkHQHRRIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QhVS90akL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QhVS90akL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i5BjRRyqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1i5BjRRyqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KwdQgFohL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91KwdQgFohL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nunJz7VNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nunJz7VNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ArwC91J3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ArwC91