    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YMN1WH\",\"sku\":\"B075YMN1WH\",\"lang\":\"en\",\"slug\":\"sophia-modern-dining-room-kitchen-table-accent-chairs-36-inch-height-set-of-2-hemp-b075ymn1wh\",\"name\":\"Sophia Modern Dining Room Kitchen Table Accent Chairs, 36 Inch Height, Set of 2, Hemp\",\"description\":\"Regardless of your style, these clean, simple chairs will look handsome at your dining room table, in a living room or at a desk. The comfortable backs and seats are anchored by wood left in a light, natural-color finish. 24&quot;W x 20&quot;D x 36&quot;H 95% polyester/5% nylon performance fabric on hardwood frame; solid rubberwood legs in natural finish Foam padding and elastic suspension system keeps upholstery firm and resilient No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Sophia Modern Dining Room Kitchen Table Accent Chairs, 36 Inch Height, Set of 2, Hemp\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TpJCU++jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tV2PADg9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tV2PADg9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P1hyfWgyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1P1hyfWgyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11Wai8F4qS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B11Wai8F4qS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zoDYEkK+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zoDYEkK+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k7DvpoMqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k7DvpoMqL.jpg\"}],\"attributes\"