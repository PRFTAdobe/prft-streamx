    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07KSRKDXF\",\"sku\":\"B07KSRKDXF\",\"lang\":\"en\",\"slug\":\"faux-linen-upholstered-tufted-headboard-king-grey-b07ksrkdxf\",\"name\":\"Faux Linen Upholstered Tufted Headboard - King, Grey\",\"description\":\"Upholstered headboard brings elegant style and added comfort to any king-size bed Metal frame; soft 100% polyester faux-linen upholstery in Grey Tufted design creates impression of orderly squares for a sleek modern appearance Adjustable height; wipes clean with a damp cloth; weighs 22 pounds Measures 3.5 inches deep by 61.5 inches wide by 45.5 to 53 inches high (floor to top of headboard); backed by an AmazonBasics limited 1-year warranty\",\"primaryImage\":{\"alt\":\"Faux Linen Upholstered Tufted Headboard - King, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JW-EesbKL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EdgzPq5cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EdgzPq5cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QSQfSPc6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QSQfSPc6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ptu9ueG8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ptu9ueG8L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"24.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"4.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"78.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"King bed frame\",\"label\":\"King bed frame\"},{\"valu