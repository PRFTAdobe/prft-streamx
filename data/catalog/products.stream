    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4ZPH19\",\"sku\":\"B07B4ZPH19\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-industrial-geometric-carved-wood-bedroom-nightstand-24-brown-black-metal-b07b4zph19\",\"name\":\"Rivet Mid-Century Modern Industrial Geometric Carved Wood Bedroom Nightstand, 24&quot;, Brown, Black Metal\",\"description\":\"24&quot;W x 17&quot;D x 25&quot;H; LegHeight: 8&quot; Two storage drawers with raised geometric design No assembly required Free returns for 30 days. 1-year warranty. Cool square knobs and a raised geometric design give an illusion of depth and style in this head-turning nightstand. This is a perfect bedside table for showcasing a lamp and books on top, while two roomy drawers store clothing and accessories.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Industrial Geometric Carved Wood Bedroom Nightstand, 24&quot;, Brown, Black Metal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YspMsAy9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q72+OqbIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q72+OqbIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Lm7zt9wBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Lm7zt9wBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VSXdpltKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VSXdpltKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tKJAtMMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tKJAtMMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B195e5RvnXS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B195e5RvnXS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/8