        "bytes": "{\"id\":\"B07B4VXZZX\",\"sku\":\"B07B4VXZZX\",\"lang\":\"en\",\"slug\":\"rivet-modern-wood-king-bed-79-w-spiced-walnut-b07b4vxzzx\",\"name\":\"Rivet Modern Wood King Bed, 79&quot;W, Spiced Walnut\",\"description\":\"79&quot;W x 87.5&quot;D x 50&quot;H; LegHeight: 9&quot; 100% constructed by hand Assemble in 30 minutes-1 hour with two people Free returns for 30 days. 1-year warranty. Bring an air of the outdoors into your bedroom haven with this handcrafted platform king bed. The spiced walnut finish and neutral upholstered inset headboard give it a streamlined, contemporary feel. The sturdy slat system requires no box spring.\",\"primaryImage\":{\"alt\":\"Rivet Modern Wood King Bed, 79&quot;W, Spiced Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WKsguqJkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cegQ9uizL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cegQ9uizL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914a5NPjsiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914a5NPjsiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xf0TWY0LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xf0TWY0LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A105IOsniKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A105IOsniKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Otqmo+U-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Otqmo+U-L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"50.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"79.0\",\"label\":\"inches\"}]},{\"name\":\"leng