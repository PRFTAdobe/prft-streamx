    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B51HWFF\",\"sku\":\"B07B51HWFF\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-king-bed-84-w-spinnsol-iron-b07b51hwff\",\"name\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Spinnsol Iron\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Spinnsol Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71iSXS41tjL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71P7IT-JN2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71P7IT-JN2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-WeawtjGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-WeawtjGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HYtjr0BtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HYtjr0BtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-Psvt2tpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-Psvt2tpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719ezp-ropL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719e