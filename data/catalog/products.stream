    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8VJ4N\",\"sku\":\"B07BW8VJ4N\",\"lang\":\"en\",\"slug\":\"andover-leather-left-facing-u-shaped-sectional-134-w-driftwood-b07bw8vj4n\",\"name\":\"Andover Leather Left-Facing U-Shaped Sectional, 134&quot;W, Driftwood\",\"description\":\"Complete your living space with this stylish sectional. With its driftwood-colored upholstery, this sectional is an ideal accent for transitional-style home decor. The solid-wood frame enhances durability and extends this sectional’s life. Overall: 134&quot;W x 96&quot;D x 33&quot;H; seat height: 21&quot;H; seat depth: 25&quot;D; seat back height: 28&quot;H; arm height: 28&quot;H; leg height: 4.25&quot;H; chaise depth: 23&quot;D; chaise width: 40&quot;W Sturdy wood frame with rich top-grain leather upholstery Transitional style blends well with a variety of home-decor themes. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Andover Leather Left-Facing U-Shaped Sectional, 134&quot;W, Driftwood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Xyzq7V9jL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1wBhU9wpaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sgNn-grLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sgNn-grLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J+87e1ZxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J+87e1ZxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yhw5+IreL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yhw5+IreL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61mwwlF