    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QBH69W\",\"sku\":\"B082QBH69W\",\"lang\":\"en\",\"slug\":\"rivet-theresa-modern-upholstered-accent-chair-30-w-gray-b082qbh69w\",\"name\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Gray\",\"description\":\"A great fit for a fireside evening or just to lounge around in, this modern upholstered chair is the perfect addition to any room in your home. The slightly curved armrests add a touch of class, and the reversible seat cushion allows for longer wear. This item is made to order just for you. 30&quot;W x 31&quot;D x 33&quot;H; seat height: 20&quot;H; seat depth: 21&quot;D; seat back height: 13&quot;H; arm height: 24&quot;H; leg height: 12&quot;H This chair has a sturdy wood frame and legs. Foam seat cushions provide lasting support and comfort. Upholstery is 100% polyester. No assembly required; removable and reversible seat cushion ensures durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Theresa Modern Upholstered Accent Chair, 30&quot;W, Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lKUMsE5YL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J2pGnfsbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J2pGnfsbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v6DJX8xfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v6DJX8xfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WIwZjPJ4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WIwZjPJ4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fxebmMdTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fxebmMdTL.jpg\"},{\"alt\":\"https://storage.googl