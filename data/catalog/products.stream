    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0857JM2NC\",\"sku\":\"B0857JM2NC\",\"lang\":\"en\",\"slug\":\"mid-century-beech-and-rattan-dining-chair-with-arms-21-9-w-natural-b0857jm2nc\",\"name\":\"Mid-Century Beech and Rattan Dining Chair with Arms, 21.9&quot;W, Natural\",\"description\":\"This simple, well-crafted chair, made of solid beech, is light and casual, evoking the simplicity of mid-century design. Its sturdy craftsmanship will make it last, while its soft, woven seat will keep it a joy to sit in. 21.9&quot;W x 19.5&quot;D x 30&quot;H Beech legs and arms with a woven paper-rope seat This chair is light, breezy, and simple to move and fit in any room in the house. Its handwoven seat is attractive and easy to sink into. This chair's natural mid-century look ensures it will work with different decors. No assembly required Using a soft, damp cloth, wipe in the direction of the grain. Free returns for 30 days; 3-year warranty.\",\"primaryImage\":{\"alt\":\"Mid-Century Beech and Rattan Dining Chair with Arms, 21.9&quot;W, Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bsxnNPoLL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y0I44Wf1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y0I44Wf1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JClmdzAKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JClmdzAKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lhak+kPnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lhak+kPnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Qa2lamCXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Qa2lamCXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71bVUpTaqOL.jpg\",\"url\":\"https://st