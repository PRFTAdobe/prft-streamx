    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJD1S8\",\"sku\":\"B07BWJD1S8\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-right-u-sectional-117-w-beige-b07bwjd1s8\",\"name\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Beige\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 117&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Right U-Sectional, 117&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ZgiphGhgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127buy9PmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9127buy9PmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tkqFsjlIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tkqFsjlIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OsEcLd+DL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1OsEcLd+DL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a+RtG8LRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81a+RtG8LRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L5x7Es6gL.jpg\"},{\"alt\"