        "bytes": "{\"id\":\"B07QF9Y234\",\"sku\":\"B07QF9Y234\",\"lang\":\"en\",\"slug\":\"rivet-modern-media-cabinet-with-self-closing-doors-59-w-b07qf9y234\",\"name\":\"Rivet Modern Media Cabinet with Self-Closing Doors, 59&quot;W\",\"description\":\"This media cabinet features 3 cabinets and 2 shelves for plenty of storage. Self-closing cabinet doors help you avoid damage and clutter. An all-over light finish means that this cabinet can blend in any living room, den, or media room, making it the perfect space for all your entertainment items. 59&quot;W x 17&quot;D x 21&quot;H MDF and metal The light finish will fit into most any room's color scheme. This cabinet has 3 self-closing cabinet doors and 2 shelves. Assemble in 15-30 minutes Clean with a soft cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Modern Media Cabinet with Self-Closing Doors, 59&quot;W\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61HbLaufznL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QIutnMCjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61QIutnMCjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DVjfs27iL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61DVjfs27iL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IvvTPpuWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IvvTPpuWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41o73p35loL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/41/41o73p35loL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ecOu-MXJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51ecOu-MXJL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Heig