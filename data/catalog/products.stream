    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2LMTC\",\"sku\":\"B075X2LMTC\",\"lang\":\"en\",\"slug\":\"rivet-subtle-mid-century-arch-fabric-queen-bed-frame-with-wood-trim-61-75-w-walnut-b075x2lmtc\",\"name\":\"Rivet Subtle Mid-Century Arch Fabric Queen Bed Frame With Wood Trim, 61.75&quot;W, Walnut\",\"description\":\"A subtly arched headboard features light grey upholstery with wood trim in a warm walnut finish. The matching wood footboard and side rails continue the clean, modern look, while the padded headboard is cozy to lean against while reading. 61.75&quot;W x 88&quot; L x 50&quot; H Hardwood with warm walnut finish and polyester fabric upholstery on front of headboard Modern with classic touches for a look that will blend with any décor A simple but elegant bed that does not require a boxspring. Assemble in 15-30 minutes. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Subtle Mid-Century Arch Fabric Queen Bed Frame With Wood Trim, 61.75&quot;W, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WKsguqJkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nuq7tFggL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Nuq7tFggL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cegQ9uizL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cegQ9uizL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xf0TWY0LL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xf0TWY0LL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xr8g-Ba9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Xr8g-Ba9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1QyT2ycq5L.jpg\",\"url\":\"https://storage.googleapis