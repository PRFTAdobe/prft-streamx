    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07Q2PCN2H\",\"sku\":\"B07Q2PCN2H\",\"lang\":\"en\",\"slug\":\"adjustable-foam-floor-sofa-grey-b07q2pcn2h\",\"name\":\"Adjustable Foam Floor Sofa - Grey\",\"description\":\"Adjustable floor sofa that can be used for sitting or sleeping; durable metal frame Great for dorm rooms, out of town guests, family night, playing video games, and more Constructed with high-density foam in flexible segments for ease of adjustability Supple suede exterior upholstery adds an extra layer of plush comfort Lightweight design is portable and easy to set up and store\",\"primaryImage\":{\"alt\":\"Adjustable Foam Floor Sofa - Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91eeO1mh2RL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31saYAVWqAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31saYAVWqAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lft8eK1JL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lft8eK1JL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tX7fA-6CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1tX7fA-6CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916TS1lP-uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916TS1lP-uL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"7.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"24.5\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Office\",\"label\":\"Off