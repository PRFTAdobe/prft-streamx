    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z96KQL\",\"sku\":\"B075Z96KQL\",\"lang\":\"en\",\"slug\":\"casual-wood-office-computer-desk-54-5-w-crescent-oak-b075z96kql\",\"name\":\"Casual Wood Office Computer Desk, 54.5&quot;W, Crescent Oak\",\"description\":\"54.5&quot;L x 24&quot;W x 31.25&quot;H Metal base with pewter finish; rubberwood solids; oak veneer Mid-century with a touch of industrial style Assembly in 30 minutes or less; assemble base Free returns for 30 days. 3-year warranty. This classy desk design features a floating desk top, a file drawer, and two utility drawers, all in a warm oak veneer with a sleek pewter base. The large work area will provide plenty of room for your files, mail, and laptop. Raised desktop for extra function; two utility drawers; one file drawer with hangers\",\"primaryImage\":{\"alt\":\"Casual Wood Office Computer Desk, 54.5&quot;W, Crescent Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912cVymusrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P9CgloCaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P9CgloCaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N4nkkM79L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N4nkkM79L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gxty9QWkL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gxty9QWkL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfjQ7vVfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1VfjQ7vVfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914QXzmbBwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914QXzmbBwL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"valu