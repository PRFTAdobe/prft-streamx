    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STD8P\",\"sku\":\"B07P8STD8P\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-top-grain-leather-loveseat-sofa-with-removable-cushions-67-w-dark-brown-b07p8std8p\",\"name\":\"Rivet Andrews Contemporary Top-Grain Leather Loveseat Sofa with Removable Cushions, 67&quot;W, Dark Brown\",\"description\":\"This love seat features removable cushions in an attractive brown leather that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 67&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs and top grain leather Removable back and seat cushions Contemporary style and top grain leather combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Top-Grain Leather Loveseat Sofa with Removable Cushions, 67&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61WvkPc9QkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1GcrUEx0DS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711UTvmuMDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711UTvmuMDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YqF-TvZVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YqF-TvZVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZX7dh4R0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZX7dh4R0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61TCRvQDCKL.jpg\",\"ur