    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B813LW1\",\"sku\":\"B07B813LW1\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-industrial-metal-buffet-credenza-28-inch-height-beige-wood-b07b813lw1\",\"name\":\"Rivet Mid-Century Modern Industrial Metal Buffet Credenza, 28 Inch Height, Beige, Wood\",\"description\":\"Mid-century minimalist design and natural wood tones combine with a metal frame to give this piece outstanding beauty. Three drawers and a lower shelf offer flexible storage options for a modern, farmhouse or even industrial style setting. 17.7&quot;W x 35.4&quot;D x 27.6&quot;H Solid oak drawer fronts; drawer interiors are fiberboard; metal base Wood and metal combination makes it suitable for modern, farmhouse or industrial décor Can be used as a dining room buffet or as a storage cabinet in other areas No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Industrial Metal Buffet Credenza, 28 Inch Height, Beige, Wood\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SCzGcqVHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13LV5A5x9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A13LV5A5x9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CHOnmbeiS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1CHOnmbeiS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SkrXsDI+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1SkrXsDI+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OTthxaDsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OTthxaDsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91RSeJJeAQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-im