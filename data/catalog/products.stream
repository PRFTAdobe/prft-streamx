    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084S16SRF\",\"sku\":\"B084S16SRF\",\"lang\":\"en\",\"slug\":\"bergen-upholstered-dining-chair-with-wood-legs-set-of-2-20-w-beige-b084s16srf\",\"name\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Beige\",\"description\":\"Luxury and practicality are married in these beautifully padded dining room chairs. The solid hardwood frame is upholstered in a soothing beige performance fabric for easy maintenance and long hours of comfortable sitting. 20&quot;W x 22.5&quot;D x 32.75&quot;H; seat height: 20&quot;H; seat depth: 19&quot;D; seat back height: 12.75&quot;H; leg height: 14&quot;H The solid hardwood frame has a natural finish to complement the performance fabric upholstery on the seat and back. These classic, comfortable chairs can be used as part of a dining room suite, as occasional chairs, or as accent chairs in a bedroom or office. As part of the simple and modern design, backrests are curved ergonomically to ensure comfort while sitting. Assemble in 15 minutes or less Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Bergen Upholstered Dining Chair with Wood Legs, Set of 2, 20&quot;W, Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71M8S5jiuHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81egufb+eoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81egufb+eoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EMYHX-K9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71EMYHX-K9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718AV48tuBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/718AV48tuBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710vwOG5qGL.jpg\",\