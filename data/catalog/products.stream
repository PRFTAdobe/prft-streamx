    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4GXZNW\",\"sku\":\"B07B4GXZNW\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-sofa-81-w-dark-grey-b07b4gxznw\",\"name\":\"Brandeberry Farmhouse Charles of London Sofa, 81&quot;W, Dark Grey\",\"description\":\"The classic English roll arm gives this cozy sofa a look ideal for a cottage or farmhouse décor. Sturdy construction, durable fabric and reversible cushions allow this piece to withstand years of fun with friends, family and pets. 43&quot;L x 81&quot;W x 38&quot;H Stain-resistant polyester fabric on hardwood pine frame English roll arms combine with modern lines to blend with transitional or farmhouse décor Sturdy frame, reversible cushions for durability; front-leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Sofa, 81&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YDSuqhZ5L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81era6twvBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81era6twvBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-jvhomD7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-jvhomD7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g1BZxBl9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91g1BZxBl9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dS4qfkjPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dS4qfkjPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L0EjS6-yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1L0EjS6-yL.jpg\"}],\