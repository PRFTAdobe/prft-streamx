    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7BDFPR\",\"sku\":\"B07B7BDFPR\",\"lang\":\"en\",\"slug\":\"rivet-fir-mid-century-modern-velvet-dining-accent-chair-23-6-w-blue-b07b7bdfpr\",\"name\":\"Rivet Fir Mid-Century Modern Velvet Dining Accent Chair, 23.6&quot;W, Blue\",\"description\":\"This velvet chair brings mid-century modern flair to any room. Sloping low-profile arms, the lower back opening, and tapered wooden legs are hallmarks of retro style, while the gold-tone metal leg caps and rich colors add glam effects. 23.6&quot;W x 24.8&quot;D x 35.4&quot;H; Seat Height: 19.2&quot;H ; Seat Depth: 17.7&quot;D; Seat Back Height: 15.7&quot;H Upholstered back, seat and sloping armrests provide comfort; solid wood frame adds support This chair is a mid-Century glam style statement piece for your dining room or anywhere you need extra seating. No assembly required Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Fir Mid-Century Modern Velvet Dining Accent Chair, 23.6&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71BzGtO2CML.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmmh27hdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmmh27hdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FoLmWPwiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FoLmWPwiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pzdp1MzoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pzdp1MzoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I3ACPmWOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91I3ACPmWOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91QKR+otV-L.jpg\",\"url\":\"https://storage.googleapis.com/pures