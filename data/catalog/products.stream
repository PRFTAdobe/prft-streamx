    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W368ML\",\"sku\":\"B084W368ML\",\"lang\":\"en\",\"slug\":\"elise-upholstered-counter-height-bar-stool-38-6-h-slate-b084w368ml\",\"name\":\"Elise Upholstered Counter-Height Bar Stool, 38.6&quot;H, Slate\",\"description\":\"This slate-colored counter-height barstool is perfect for your mid-century design kitchen or bar. The sturdy wood frame includes a footrest, and the upholstered, padded seat makes it a welcome addition to your entertainment area or everyday breakfast nook. 18.5&quot;W x 22.4&quot;D x 38.6&quot;H; seat height: 26&quot;H; seat depth: 16.9&quot;D; seat back height: 17.3&quot;H; leg height: 21.3&quot;H. Solid hardwood frame upholstered in moisture-repellent, stain-resistant fabric. Footrest with kickplate for stability and durability, with padded seat and back for comfort. Low profile mid-century inspired barstool. Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elise Upholstered Counter-Height Bar Stool, 38.6&quot;H, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71Bfj4Vc6CL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wsur1SZvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wsur1SZvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1K7jUru+qS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ISZlrKGSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ISZlrKGSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MsGd-yw4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MsGd-yw4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71KpnBwKPjL.j