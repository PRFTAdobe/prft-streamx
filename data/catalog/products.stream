    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07R7W7ZMP\",\"sku\":\"B07R7W7ZMP\",\"lang\":\"en\",\"slug\":\"wooden-home-office-computer-study-desk-with-drawer-39-inch-white-b07r7w7zmp\",\"name\":\"Wooden, Home Office, Computer Study Desk with Drawer, 39 Inch, White\",\"description\":\"Modern wooden desk for home offices, dorm rooms, and more Simple, clean design with block legs and ample work surface space Pull-out center track drawer is large enough for storing supplies and up to a 12.5&quot; laptop Durably constructed with laminated MDF particle board Laminated surface is easy to clean and resists wear and tear Easy assembly (two people recommended); hardware and instructions included BIFMA Certified Desk Dimensions: 39 x 19.6 x 30 inches (WxDxH)\",\"primaryImage\":{\"alt\":\"Wooden, Home Office, Computer Study Desk with Drawer, 39 Inch, White\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61N6hsWQ85L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6Oiye9tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81k6Oiye9tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61GYQw7dbXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61GYQw7dbXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6190S7i4ELL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6190S7i4ELL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Os6L1LOhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Os6L1LOhL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"19.63\",\"label\":\"inches\"}