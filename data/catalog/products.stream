    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B7DFR8X\",\"sku\":\"B07B7DFR8X\",\"lang\":\"en\",\"slug\":\"elias-casual-wood-office-computer-desk-48-w-grey-b07b7dfr8x\",\"name\":\"Elias Casual Wood Office Computer Desk, 48&quot;W, Grey\",\"description\":\"This counter-height desk allows you to stand as you work, and the taller profile also means more drawer space. A distressed grey oak finish gives it a rustic casual style. This transitional piece will work with most any style room. 24&quot;L x 48&quot;W x 36&quot;H Wood composites; oak wood veneer; metal drawer pulls A rustic style ideal for a modern farmhouse décor, but will blend with most styles 4 drawers provide plenty of storage No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Elias Casual Wood Office Computer Desk, 48&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81km8+F21lL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FoGrVbQIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FoGrVbQIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PL2fLlU4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91PL2fLlU4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v2lwog4-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91v2lwog4-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Z0daFa+tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Z0daFa+tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PUM47NjHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81PUM47NjHL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"width\"