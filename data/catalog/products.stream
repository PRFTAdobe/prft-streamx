    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M6CFN\",\"sku\":\"B07B4M6CFN\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-l-sectional-116-w-eclipse-blue-b07b4m6cfn\",\"name\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Eclipse Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left L-Sectional, 116&quot;W, Eclipse Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gr2m3BP0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L-DyzilLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81L-DyzilLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fbLOh0myL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fbLOh0myL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FikcvzSiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FikcvzSiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KKh15YZPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1KKh15YZPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-ima