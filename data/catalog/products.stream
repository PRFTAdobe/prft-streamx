    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QDV397\",\"sku\":\"B075QDV397\",\"lang\":\"en\",\"slug\":\"rivet-nova-modern-king-bed-frame-with-arched-headboard-79-5-w-gold-finished-metal-b075qdv397\",\"name\":\"Rivet Nova Modern King Bed Frame with Arched Headboard, 79.5&quot;W, Gold Finished Metal\",\"description\":\"Elevate your bedroom with this distinctive gold-finished metal platform bed. It can be played up or down to either be a focal point of an otherwise neutral room or paired with glam-inspired furnishings. King size; 85&quot;L x 79.5&quot;W x 46&quot;H Sturdy metal with elegant gold finish. 15-slat wood mattress support Modern elegance with an arched headboard, simple rounded spindles and beautifully-tapered legs in a brushed gold finish. Tall legs leave plenty of room underneath for storage Assemble in 30 minutes to 1 hour. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Nova Modern King Bed Frame with Arched Headboard, 79.5&quot;W, Gold Finished Metal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-H6ORhtZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MyYxVkzrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71MyYxVkzrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TU+A70MJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91TU+A70MJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16R4gCNEDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16R4gCNEDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81irL-91cHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81irL-91cHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813rwlbtf0L.jpg\",\"url\":\"https://storage.googlea