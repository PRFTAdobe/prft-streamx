    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ39N1\",\"sku\":\"B07QCQ39N1\",\"lang\":\"en\",\"slug\":\"canton-twin-button-tufted-headboard-42-w-pewter-b07qcq39n1\",\"name\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Pewter\",\"description\":\"Button tufting gives this headboard a classic, homey look that is equally at home in shabby-chic or transitional surroundings. The soft pewter-colored upholstery offers a restful place to lean back with a good book before sinking into a good night's sleep. 42&quot;W x 3&quot;D x 62&quot;H Polyester and cotton blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort while you rest in bed with a good book. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Canton Twin Button-Tufted Headboard, 42&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61SlzT0SytL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dqjyLxDoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dqjyLxDoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/611pI0a03HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/611pI0a03HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719xHeP04CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/719xHeP04CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1vkPUFRvLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"62.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"42.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"3.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"44.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Panels\",\"label\":\"Panels\"},{\"value\":\"Set\",\"label\":\"Set\"},{\"value\":\"Boards\",\"label\":\"Boards\"},{\"value\":\"Platform\",\"label\":\"Platform\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Mattress\",\"label\":\"Mattress\"},{\"value\":\"Rustic\",\"label\":\"Rustic\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Floating\",\"label\":\"Floating\"},{\"value\":\"King\",\"label\":\"King\"},{\"value\":\"Escritorio\",\"label\":\"Escritorio\"},{\"value\":\"Computer\",\"label\":\"Computer\"},{\"value\":\"Sized\",\"label\":\"Sized\"},{\"value\":\"Lttle\",\"label\":\"Lttle\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Poppy\",\"label\":\"Poppy\"},{\"value\":\"Frames\",\"label\":\"Frames\"},{\"value\":\"Head\",\"label\":\"Head\"},{\"value\":\"Gray\",\"label\":\"Gray\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Distressed\",\"label\":\"Distressed\"},{\"value\":\"Wood\",\"label\":\"Wood\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Kid\",\"label\":\"Kid\"},{\"value\":\"Monarch\",\"label\":\"Monarch\"},{\"value\":\"Youth\",\"label\":\"Youth\"},{\"value\":\"Only\",\"label\":\"Only\"},{\"value\":\"California\",\"label\":\"California\"},{\"value\":\"Girls\",\"label\":\"Girls\"},{\"value\":\"Kids\",\"label\":\"Kids\"},{\"value\":\"Crema\",\"label\":\"Crema\"},{\"value\":\"Cal\",\"label\":\"Cal\"},{\"value\":\"Taupe\",\"label\":\"Taupe\"},{\"value\":\"Progressive\",\"label\":\"Progressive\"},{\"value\":\"Pink\",\"label\":\"Pink\"},{\"value\":\"White\",\"label\":\"White\"},