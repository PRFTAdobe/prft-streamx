    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07TYTQPYN\",\"sku\":\"B07TYTQPYN\",\"lang\":\"en\",\"slug\":\"rivet-malida-mid-century-modern-open-back-swivel-kitchen-bar-stool-41-h-chalk-b07tytqpyn\",\"name\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Chalk\",\"description\":\"Dimensions: 22&quot;W x 21&quot;D x41&quot;H | Seat height is 30&quot;. Durable polyester fabric on wood frame, solid hardwood base Foam padding and elastic suspension system keep back and seat firm and springy Free returns for 30 days. 1-year warranty. This barstool's substantial arms, back and padded seat, and swivel seat make it easy to settle comfortably in the perfect spot. The unique shape of the seat back makes this a Mid-century style statement piece in your home. No assembly required. Wipe with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Malida Mid-Century Modern Open Back Swivel Kitchen Bar Stool, 41&quot;H, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81N+bd6e+lL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q3oy+cjpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Q3oy+cjpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nkFy8nraL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nkFy8nraL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AXcU1sEeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91AXcU1sEeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WYmChyoLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WYmChyoLL.jpg\"}],\"attributes\":[{\"name