    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LNM5P\",\"sku\":\"B07P5LNM5P\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-leather-sofa-couch-with-hardwood-frame-89-w-dark-brown-b07p5lnm5p\",\"name\":\"Lauren Down-Filled Oversized Leather Sofa Couch with Hardwood Frame, 89&quot;W, Dark Brown\",\"description\":\"Dimensions: 89&quot;W x 45&quot;D x 37&quot;H Soft down-filled cushions on a frame of solid hardwood mean this sofa offers plush support and security. Neutral dark-brown leather upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Removable and reversible seat cushion. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down-Filled Oversized Leather Sofa Couch with Hardwood Frame, 89&quot;W, Dark Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nl-VimOgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UyA8N96FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81UyA8N96FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sfLWTPksL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71sfLWTPksL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PUQC28CAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71PUQC28CAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u3+u7luZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u3+u7luZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12ydqGPgDS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B12ydqGPgDS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.88\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"89.37\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"147.4\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Rolled\",\"label\":\"Rolled\"},{\"value\":\"Downs\",\"label\":\"Downs\"},{\"value\":\"Chaise\",\"label\":\"Chaise\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Recliner\",\"label\":\"Recliner\"},{\"value\":\"Shaped\",\"label\":\"Shaped\"},{\"value\":\"Furniture\",\"label\":\"Furniture\"},{\"value\":\"Camel\",\"label\":\"Camel\"},{\"value\":\"Clearance\",\"label\":\"Clearance\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Corner\",\"label\":\"Corner\"},{\"value\":\"Button\",\"label\":\"Button\"},{\"value\":\"Chairs\",\"label\":\"Chairs\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Catanzaro\",\"label\":\"Catanzaro\"},{\"value\":\"Grey\",\"label\":\"Grey\"},{\"value\":\"Bed\",\"label\":\"Bed\"},{\"value\":\"Space\",\"label\":\"Space\"},{\"value\":\"De\",\"label\":\"De\"},{\"value\":\"Down\",\"label\":\"Down\"},{\"value\":\"Small\",\"label\":\"Small\"},{\"value\":\"Para\",\"label\":\"Para\"},{\"value\":\"Queen\",\"label\":\"Queen\"},{\"value\":\"Mid\",\"label\":\"Mid\"},{\"value\":\"Holders\",\"label\":\"Holders\"},{\"value\":\"Overstuffed\",\"label\":\"Overstuffed\"},{\"value\":\"Seats\",\"label\":\"Seats\"},{\"value\":\"Out\",\"label\":\"Out\"},{\"value\":\"Filled\",\"label\":\"Filled\"},{\"value\":\"Sectionals\",\"label\":\"Sectionals\"},{\"value\":\"Half\",\"label\":\"Half\"},{\"value\":\"Theater\",\"label\":\"Theater\"},{\"value\":\"Cognac\",\"label\":\"Cognac\"