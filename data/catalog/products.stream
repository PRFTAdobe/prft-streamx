    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZ3VDS\",\"sku\":\"B07PBZ3VDS\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-leather-ottoman-bench-63-4-w-caramel-b07pbz3vds\",\"name\":\"Rivet Ava Mid-Century Modern Leather Ottoman Bench, 63.4&quot;W, Caramel\",\"description\":\"A sleek extra-long leather ottoman offers comfort to everyone's tired feet all at once—or handy spare seating. This modern piece touts simple upholstered lines and beautiful tapered legs made from solid wood. 63.4&quot;W x 25.6&quot;D x 15.7&quot;H Solid wood frame and tapered beech legs; leather upholstery As a shared footrest or spare seating, this ottoman will grace living room, den, or hallway with equal ease. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Leather Ottoman Bench, 63.4&quot;W, Caramel\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71nacEEUhuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61k0JIx360L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61k0JIx360L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Bhbg9nrBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Bhbg9nrBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GFaskSleL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GFaskSleL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ueErGkqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61q3H03fmUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61q3H03fmUL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\"