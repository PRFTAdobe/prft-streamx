    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MH9DB\",\"sku\":\"B07B4MH9DB\",\"lang\":\"en\",\"slug\":\"brandeberry-farmhouse-charles-of-london-ottoman-31-w-sand-b07b4mh9db\",\"name\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Sand\",\"description\":\"Tailored upholstery and rustic legs give this ottoman a look ideal for a cottage or farmhouse décor. Sturdy construction and durable fabric allow this piece to withstand years of fun with friends, family and pets. 31&quot;W x 23&quot;D x 20&quot;H; Seat Height: 20&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 20&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Tailored lines and rustic legs blend with transitional or farmhouse décor Sturdy frame, resilient cushioning; leg casters make it easy to move Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Brandeberry Farmhouse Charles of London Ottoman, 31&quot;W, Sand\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91JCI+w9QZL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h8pWKFI+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1h8pWKFI+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UVqnkHN9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UVqnkHN9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tNXZp7FIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tNXZp7FIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JrcGJBB-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JrcGJBB-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Suve-PiwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-p