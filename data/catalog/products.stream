    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VMWB4G\",\"sku\":\"B082VMWB4G\",\"lang\":\"en\",\"slug\":\"rivet-jamie-upholstered-mid-century-modern-low-arm-accent-chair-31-w-chalk-b082vmwb4g\",\"name\":\"Rivet Jamie Upholstered Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Chalk\",\"description\":\"A great addition to any room, this versatile accent chair is sure to be a conversation piece. It features eye catching Mid-century inspired design with distinctive slanted arms and sturdy hardwood legs. 31&quot;W x 32.3&quot;D x 35”H Solid hardwood frame with fabric blend of 70% Polyester, 20% Linen, 10% Cotton. Highly fashionable design in a compact size for small spaces. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Jamie Upholstered Mid-Century Modern Low Arm Accent Chair, 31&quot;W, Chalk\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+xvz1ODtL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uof5h5UyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81uof5h5UyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dC5a4ctjL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81dC5a4ctjL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A0tIIUCFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81A0tIIUCFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BFcm6IkFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81BFcm6IkFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1JKZVSlMJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61cFJd-lwqL.jp