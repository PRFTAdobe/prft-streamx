    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSHYZKN\",\"sku\":\"B07HSHYZKN\",\"lang\":\"en\",\"slug\":\"rylee-modern-acacia-wood-5-drawer-bedroom-chest-39-4-w-gray-wash-acacia-b07hshyzkn\",\"name\":\"Rylee Modern Acacia Wood 5-Drawer Bedroom Chest, 39.4&quot;W, Gray-Wash Acacia\",\"description\":\"Add a modern flair to your home with this beautiful dresser. Made from solid acacia with a subtle gray-wash finish, this chest of drawers perfectly complements most home-décor styles. Its 4 elegant but strong legs keep the dresser sturdy, and its 5 drawers provide plenty of storage options. 39.4&quot;W x 17.7&quot;D x 41.3&quot;H Solid acacia wood with acacia veneer on back panel, shelves, and drawer bottoms Subtle gray-washed distressed finish and clean lines create an attractive modern look. This dresser has 5 soft-closing drawers. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Rylee Modern Acacia Wood 5-Drawer Bedroom Chest, 39.4&quot;W, Gray-Wash Acacia\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1WQ20KTbmL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HEOcRvGhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HEOcRvGhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y1CO9ZK4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1y1CO9ZK4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l+EcH4gLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l+EcH4gLL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1ShIdV8OMS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DNN9VaFoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-i