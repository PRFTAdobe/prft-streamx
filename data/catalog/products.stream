    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082Q8N8BY\",\"sku\":\"B082Q8N8BY\",\"lang\":\"en\",\"slug\":\"cedar-upholstered-sofa-couch-with-nailheads-91-w-midnight-gray-b082q8n8by\",\"name\":\"Cedar Upholstered Sofa Couch with Nailheads, 91&quot;W, Midnight Gray\",\"description\":\"This gray upholstered sofa couch brings stylish charm to any living or family room. Durable fabric-covered foam seat cushions provide lasting comfort, and the rustic nailhead trim enhances any decor. There is plenty of room for friends and family or to stretch out and watch a movie. This item is made to order just for you. Overall: 91&quot;W x 38&quot;D x 30&quot;H; seat height: 19&quot;H; seat depth: 20&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 2.75&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cedar Upholstered Sofa Couch with Nailheads, 91&quot;W, Midnight Gray\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9192QsmZ+CL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cMMLxp5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819cMMLxp5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qcoHOqpYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qcoHOqpYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810xrDSWSZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/810xrDSWSZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1MQcDqC90L.jpg\"},{\"alt\":\"https://storage.goo