    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MKPVH\",\"sku\":\"B07B4MKPVH\",\"lang\":\"en\",\"slug\":\"rivet-kaden-mid-century-modern-adjustable-headrest-leather-living-room-accent-chair-35-8-w-black-leather-b07b4mkpvh\",\"name\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Living Room Accent Chair, 35.8&quot;W, Black Leather\",\"description\":\"This leather chair isn't just handsomely styled; it's cleverly functional, too. A headrest across the back adjusts upright for watching TV, then tilts back when you're ready to relax. Compactly sized for smaller spaces, it features modern metal legs. 35.8&quot;W x 39.3&quot;D x 37&quot;H; Seat Height: 16.9&quot;H ; Seat Depth: 21.2&quot;D; Seat Back Height: 17.77&quot;H; Arm Height: 23.2&quot;H; Leg Height: 5.5&quot; Genuine leather on cedar hardwood frame; metal legs Clean lines and streamlined design is thoroughly contemporary Unique headrest feature adjusts upward and backward Assembly in 30 minutes or less; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Kaden Mid-Century Modern Adjustable Headrest Leather Living Room Accent Chair, 35.8&quot;W, Black Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91yAkHU-gpL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918y+7QAsJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918y+7QAsJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YUczrptmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91YUczrptmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918w7oRIcgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918w7oRIcgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cdpydFOzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814I6Nd3jLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814I6Nd3jLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.8\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"39.3\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"69.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Black leather\",\"label\":\"Black leather\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Sofas\",\"label\":\"Sofas\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":817,\"discountedValue\":735.3}}"
