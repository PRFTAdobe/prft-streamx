    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W349LD\",\"sku\":\"B084W349LD\",\"lang\":\"en\",\"slug\":\"esme-memory-swivel-counter-height-barstool-39-4-h-cadet-blue-b084w349ld\",\"name\":\"Esme Memory-Swivel Counter-Height Barstool, 39.4&quot;H, Cadet Blue\",\"description\":\"This cadet-blue-colored counter-height barstool features a memory swivel, so it will always look polished and poised at your bar or kitchen counter. The very slightly winged high back makes a refined statement when set against your classic kitchen cabinets or polished bar. 20.1&quot;W x 22.4&quot;D x 39.4&quot;H; seat height: 26&quot;H; seat depth: 16.5&quot;D; seat back height: 18.5&quot;H; leg height: 20.9&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric A memory-swivel mechanism means this barstool always looks tidy. Classic transitional look with memory swivel No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Esme Memory-Swivel Counter-Height Barstool, 39.4&quot;H, Cadet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Wf35W6rRL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hgp00onHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hgp00onHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YUc91uG9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YUc91uG9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713iOskQesL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/713iOskQesL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eO5uc6EEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eO5uc6EEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/8