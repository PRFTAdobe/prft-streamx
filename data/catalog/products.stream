{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Kids twin beds\",\"label\":\"Kids twin beds\"}]}],\"categories\":[{\"id\":\"Headboards\",\"slug\":\"headboards\",\"name\":\"Headboards\",\"value\":\"Headboards\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":401,\"discountedValue\":360.9}}"
