    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4CZNPH\",\"sku\":\"B07B4CZNPH\",\"lang\":\"en\",\"slug\":\"aubree-farmhouse-accent-chair-32-w-striped-grey-linen-b07b4cznph\",\"name\":\"Aubree Farmhouse Accent Chair, 32&quot;W, Striped Grey Linen\",\"description\":\"With linen-blend fabric and low-profile English roll arms, this chair will be cozy and charming in a modern farmhouse décor. Traditional-style legs have casters on the front two feet, making it easy to move to just the right spot for conversation. 32&quot;W x 36&quot;D x 37&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 37&quot;H; Arm Height: 24&quot;H; Front legs: 7&quot;H; Back legs: 6.625&quot;H Linen/cotton blend fabric on hardwood pine frame English roll arms and scrolled back for classic and farmhouse style touches Front legs are on casters, making it to maneuver to just where you want it Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Aubree Farmhouse Accent Chair, 32&quot;W, Striped Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eKaO2NkgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XS6h6X0lL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XS6h6X0lL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UMQMic3VS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1UMQMic3VS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DAV3DGg7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DAV3DGg7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ObjJbCJ8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ObjJbCJ8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1