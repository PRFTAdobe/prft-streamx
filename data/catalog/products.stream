    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B78M186\",\"sku\":\"B07B78M186\",\"lang\":\"en\",\"slug\":\"alaina-upholstered-dining-room-kitchen-chairs-20-w-set-of-2-navy-blue-b07b78m186\",\"name\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Navy Blue\",\"description\":\"Clean, compact design helps you fit more of these chairs around the table for those special family dinners. Simple low-slung armrests and straight legs combine with classic performance cotton fabric for a transitional look that will blend with most any décor. Overall: 20&quot;W x 25.1&quot;D x 37.4&quot;H; Seat Height: 19.6&quot;H ; Seat Depth: 16.9&quot;D; Seat Back Height: 16.9&quot;H; Arm Height: 19.4&quot;H Hardwood legs and frame; performance fabric Modern design with classic solid fabric provides a transitional look Arrives fully assembled Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Alaina Upholstered Dining Room Kitchen Chairs, 20&quot;W, Set of 2, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b4CoAyMqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NgYJj0I1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1NgYJj0I1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91696AogUwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91696AogUwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GWlsa91IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81GWlsa91IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1holVmxpaS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1holVmxpaS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91u6nNSAtNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina