    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KX8NG\",\"sku\":\"B0853KX8NG\",\"lang\":\"en\",\"slug\":\"rivet-lundberg-contemporary-faux-leather-barstool-with-brass-legs-44-5-h-brown-b0853kx8ng\",\"name\":\"Rivet Lundberg Contemporary Faux Leather Barstool with Brass Legs, 44.5&quot;H, Brown\",\"description\":\"Comfort and style meet in this contemporary barstool. Feather-filled cushions and open sides provide maximum comfort, while the brown faux leather and brass legs display a spare, contemporary style. These barstools coordinate well with any modern interior decor. Solid wood frame; feather-filled faux leather cushions; brass base Classic brass legs and footrest, plus the open sides, allow for maximum freedom of movement. Feather-filled cushion provides comfort and a contemporary look at the same time. Classic brass metal base has a footrest for added stability. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty 18.1&quot;W x 22.4&quot;D x 44.5&quot;H; seat height: 29.9&quot;H; seat depth: 12.6&quot;D; seat back height: 16.1&quot;H; leg height: 26&quot;H\",\"primaryImage\":{\"alt\":\"Rivet Lundberg Contemporary Faux Leather Barstool with Brass Legs, 44.5&quot;H, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71RMS8dQXuL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YF39xTV6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YF39xTV6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OHZ09r3oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91OHZ09r3oL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zocW7ZwcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zocW7ZwcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81G+nnePqYL.jpg\",