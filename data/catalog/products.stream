    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0856GXMML\",\"sku\":\"B0856GXMML\",\"lang\":\"en\",\"slug\":\"larkin-living-room-accent-swivel-chair-30-w-iron-b0856gxmml\",\"name\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Iron\",\"description\":\"An Amazon brand - This simple slipcover swivel accent chair brings touches of modern and traditional to your home. Covered in high-performance twill upholstery that is comfortable and durable, its slender design makes it practical even in small spaces. This item is made to order just for you. 30&quot;W x 35&quot;D x 33&quot;H. Seat height is 20&quot;. Sturdy metal base, solid wood frame, durable performance fabric Swivel mechanism allows you to turn in any direction. No assembly required. Vacuum or lightly brush. Spot clean with a damp cloth if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Larkin Living Room Accent Swivel Chair, 30&quot;W, Iron\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ViWXphXUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q1KkVrrIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Q1KkVrrIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L1zAIAhnL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91L1zAIAhnL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913EPSxLajL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913EPSxLajL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8D25QF8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91d8D25QF8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gTrMYzajL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1gTrMYzajL.jpg\"},{\"alt\":\"https://storage.googlea