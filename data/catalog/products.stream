    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07MF1S4YM\",\"sku\":\"B07MF1S4YM\",\"lang\":\"en\",\"slug\":\"classic-tufted-barstool-set-of-2-44-h-navy-b07mf1s4ym\",\"name\":\"Classic Tufted Barstool, Set of 2, 44&quot;H, Navy\",\"description\":\"Overall: 23.75&quot;W x 20.25&quot;D x 44.3&quot;H; seat height: 30.25&quot;H; seat depth: 18&quot;D; seat back height: 13.5&quot;H Durable fabric on wood frame; solid-wood legs with natural finish Set of 2 vintage-inspired barstools with wood frame and tufted navy upholstery Foam padding and elastic suspension system keep the back and seat firm and springy. Avoid moisture. Wipe clean with soft, dry cloth. Free returns for 30 days. 3-year warranty. Complete your kitchen or bar area with these vintage-inspired tufted barstools. The sturdy solid-wood frame features an elastic suspension system that’s designed to keep the seat firm, and the elegant design nicely complements vintage, country and farmhouse-style home decor.\",\"primaryImage\":{\"alt\":\"Classic Tufted Barstool, Set of 2, 44&quot;H, Navy\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zCyKbXR+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fQg44ixXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71fQg44ixXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bqGAKw-0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bqGAKw-0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J60y4ygGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J60y4ygGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mrMNk2zXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71mrMNk2zXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kke8LHR9L.jpg\",\"url\":\"https: