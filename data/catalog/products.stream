    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P8STHNL\",\"sku\":\"B07P8STHNL\",\"lang\":\"en\",\"slug\":\"lauren-down-filled-oversized-ottoman-with-hardwood-frame-46-5-w-pearl-b07p8sthnl\",\"name\":\"Lauren Down Filled Oversized Ottoman with Hardwood Frame, 46.5&quot;W, Pearl\",\"description\":\"Dimensions: 46&quot;W x 46&quot;D x 19&quot;H Soft down-filled cushions on a frame of solid hardwood mean this ottoman offers plush support and security. Neutral pearl-colored upholstery allows this piece to blend into your existing color scheme with ease. Solid hardwood frame with moisture-repellent, stain-resistant fabric made of 98% polyester, 2% nylon; down-filled seat and back cushions Wide surface provides a comfortable space for rest or extra seating. Classic design will fit any space. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Lauren Down Filled Oversized Ottoman with Hardwood Frame, 46.5&quot;W, Pearl\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/819-THSKVDL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nN6p9gFPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nN6p9gFPL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oLd5GrptL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71oLd5GrptL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XsfNAjSAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XsfNAjSAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FmsM5OSEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1FmsM5OSEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71wfQlRbzTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-imag