    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0719WQHLX\",\"sku\":\"B0719WQHLX\",\"lang\":\"en\",\"slug\":\"rivet-ava-mid-century-modern-upholstered-ottoman-25-6-w-dark-grey-b0719wqhlx\",\"name\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Dark Grey\",\"description\":\"This handsome ottoman can serve as a footstool, an extra place to put a tray of snacks, or a comfortable seat for a friend. The tapered solid wood legs and low profile give this a classic mid-century modern style. 25.6&quot;W x 25.6&quot;D x15.7&quot;H Solid wood frame with tapered beech legs A retro-looking addition for your living room Simple assembly; just attach legs from the zippered compartment underneath Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ava Mid-Century Modern Upholstered Ottoman, 25.6&quot;W, Dark Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UIhhD3hfL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gR8SMFOQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gR8SMFOQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12MkeGnC4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12MkeGnC4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AuGicxNBS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AuGicxNBS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kiAoPEN+L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kiAoPEN+L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I3mFcGMfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81I3mFcGMfL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"15.7\",\"label\":\"inches\"}]},{\"name\":\"