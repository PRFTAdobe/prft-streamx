    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072FVHS93\",\"sku\":\"B072FVHS93\",\"lang\":\"en\",\"slug\":\"rivet-midtown-contemporary-upholstered-loveseat-sofa-68-5-w-cream-b072fvhs93\",\"name\":\"Rivet Midtown Contemporary Upholstered Loveseat Sofa, 68.5&quot;W, Cream\",\"description\":\"Nestle in for an evening of movie marathon on this modern, smartly designed sofa. With seating for two and removable side and back cushions, you'll have plenty of room for snuggling with your pet or significant other. 37&quot;D x 68.5”W x 31.5&quot;H Sturdy hardwood frame, resilient cushions and solid beech legs Contemporary Soft, removable cushions make sofa easier to move. Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Midtown Contemporary Upholstered Loveseat Sofa, 68.5&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HrMday7iL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A21M7B6VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A21M7B6VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81te-oVSEZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81te-oVSEZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SCmdi1keS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1SCmdi1keS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IYDh4F3aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91IYDh4F3aL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"68.5\",\"label\":\"inches\"}]},{\"name