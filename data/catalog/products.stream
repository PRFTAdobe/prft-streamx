  "payload": {
    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YQXRBS\",\"sku\":\"B075YQXRBS\",\"lang\":\"en\",\"slug\":\"rivet-julian-minimalist-modern-tufted-dining-room-counter-height-bar-stools-set-of-2-34-3-inch-height-synthetic-leather-red-b075yqxrbs\",\"name\":\"Rivet Julian Minimalist Modern Tufted Dining Room Counter Height Bar Stools, Set of 2, 34.3 Inch Height, Synthetic Leather, Red\",\"description\":\"Add a vibrant pop of color to your home with these fun counter stools. The low-back seats with channel tufting sit on tall metal legs. Combine with other colors or mix and match for a look that's sure to turn heads. 19.3&quot;W x 21&quot;D x 34.3&quot;H. 25.2&quot; seat height Synthetic leather upholstery on hardwood frame; metal legs with grey finish Easy-care synthetic leather. Durable  finish on legs. Assemble in 10 minutes or less. Wipe with soft damp cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Julian Minimalist Modern Tufted Dining Room Counter Height Bar Stools, Set of 2, 34.3 Inch Height, Synthetic Leather, Red\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81zZAqhnM4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q9gUySiQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Q9gUySiQL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HXY8WgmtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HXY8WgmtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Xix0nDmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16Xix0nDmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715BTOqEyAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715BTOqEyAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WsCPYLVVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81WsCPYLVVL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"19.3\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"21.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"10.3\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Stool\",\"label\":\"Stool\"},{\"value\":\"Barstools\",\"label\":\"Barstools\"},{\"value\":\"Bar stools\",\"label\":\"Bar stools\"},{\"value\":\"Counter stool\",\"label\":\"Counter stool\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Bar stools set of 4\",\"label\":\"Bar stools set of 4\"},{\"value\":\"Bar stools set of 3\",\"label\":\"Bar stools set of 3\"},{\"value\":\"Bar stools set of 2\",\"label\":\"Bar stools set of 2\"},{\"value\":\"Counter stools\",\"label\":\"Counter stools\"},{\"value\":\"Counter height\",\"label\":\"Counter height\"},{\"value\":\"Counter height bar stools\",\"label\":\"Counter height bar stools\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Bar stool\",\"label\":\"Bar stool\"}]}],\"categories\":[{\"id\":\"Barstools\",\"slug\":\"barstools\",\"name\":\"Barstools\",\"value\":\"Barstools\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":451,\"discountedValue\":405.9}}"
