      "content": {
        "bytes": "{\"id\":\"B073GCWSX8\",\"sku\":\"B073GCWSX8\",\"lang\":\"en\",\"slug\":\"rivet-huxley-mid-century-accent-chair-burnt-orange-b073gcwsx8\",\"name\":\"Rivet Huxley Mid-Century Accent Chair, Burnt Orange\",\"description\":\"This mid-century modern chair is reminiscent of the Mad Men era. The curved solid wood frame and comfortable seating make this chair ideal for the living room or home office. 35&quot;D x 28.3&quot;W x 33.9&quot;H Solid wood frame and polyester/acrylic fabric Mid-century modern Handsome, practical design No assembly required. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Huxley Mid-Century Accent Chair, Burnt Orange\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1lAxsxCuTL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RHdDA9NEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RHdDA9NEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A156WOJt1uL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A156WOJt1uL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9153e0XuR1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9153e0XuR1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14AxuDILPS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B14AxuDILPS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"33.9\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"28.3\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"33.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Wood chair\",\"label\":\"Wood chair\"},{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Mid century chair\",\"label\":\"Mid century chair\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Dining room chairs\",\"label\":\"Dining room chairs\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Chairs for living room\",\"label\":\"Chairs for living room\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Comfortable chair\",\"label\":\"Comfortable chair\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Gaming chair\",\"label\":\"Gaming chair\"},{\"value\":\"Burnt orange\",\"label\":\"Burnt orange\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Hanging chair\",\"label\":\"Hanging chair\"},{\"value\":\"Massage chair\",\"label\":\"Massage chair\"},{\"value\":\"Fabric chair\",\"label\":\"Fabric chair\"},{\"value\":\"Patio lounge chair\",\"label\":\"Patio lounge chair\"},{\"value\":\"Outdoor folding chair\",\"label\":\"Outdoor folding chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Office chair\",\"label\":\"Office chair\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Lounge chair\",\"label\":\"Lounge chair\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Rocking chair\",\"label\":\"Rocking chair\"},{\"value\":\"Rocking recliner chair\",\"label\":\"Rocking recliner chair\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"},{\"value\":\"Swing chair\",\"label\":\"Swing chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\