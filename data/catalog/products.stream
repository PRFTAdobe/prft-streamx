    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MLQ2X\",\"sku\":\"B07B4MLQ2X\",\"lang\":\"en\",\"slug\":\"andover-modern-right-l-sectional-sofa-124-w-pewter-b07b4mlq2x\",\"name\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Pewter\",\"description\":\"Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. With sturdy frames and reversible cushions, the pieces in this collection will withstand years of fun and cuddles with family and pets. 124&quot;W x 96&quot;D x 33&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H 80% cotton/20% polyester blend fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Right L-Sectional Sofa, 124&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81C9tVfEdxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V4DX1xKtL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1V4DX1xKtL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ENlIVCioL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ENlIVCioL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Vzkt4ukvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Vzkt4ukvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818kM0Xf3CL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818kM0Xf3CL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81JkMnlFUrL.jpg\",\"url\":\"https://storage.googleap