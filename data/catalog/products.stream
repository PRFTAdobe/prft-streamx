    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSDTR8H\",\"sku\":\"B07HSDTR8H\",\"lang\":\"en\",\"slug\":\"rivet-whit-contemporary-upholstered-counter-height-stool-with-gold-accents-37-h-flannel-grey-b07hsdtr8h\",\"name\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Flannel Grey\",\"description\":\"The dual-height stretcher bars that lend this high-rise barstool additional support double as a comfort-enhancing footrest. The rounded, open-backed design, upholstered in gorgeous flannel grey, lends an air of contemporary chic and modern sensibility to any setting. 20&quot;D x 20&quot;W x 37&quot;H; Seat Height: 26&quot; Solid wood frame & legs with dark brown finish with gold accents Dual-height stretcher bars add stability and double as a convenient footrest Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Whit Contemporary Upholstered Counter Height Stool with Gold Accents, 37&quot;H, Flannel Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81oe7wGVVOL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r8JlNJ8FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1r8JlNJ8FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812jLmsDuHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/812jLmsDuHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pLPGF3-MS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1pLPGF3-MS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xJqFvAf1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xJqFvAf1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81ejpFxzx8L.jpg\",\"url\":\"https://storage.googleapis.c