    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HSLQ2QZ\",\"sku\":\"B07HSLQ2QZ\",\"lang\":\"en\",\"slug\":\"hartford-modern-denim-style-fabric-kitchen-counter-bar-stool-45-5-h-dove-grey-b07hslq2qz\",\"name\":\"Hartford Modern Denim-Style Fabric Kitchen Counter Bar Stool, 45.5&quot;H, Dove Grey\",\"description\":\"This classic Parsons-style barstool is understated enough for your farmhouse-style kitchen while still being at home in a formal modern dining room. Featuring a gorgeous easy-care dove-gray fabric seat and back and a solid-wood frame, this comfortable cushioned stool is easily dressed up or down. Solid wood frame, silver metal kickplate and durable 100% polyester fabric Dust or wipe clean with a soft, dry cloth. Avoid abrasive cleaner. Keep indoors, away from direct sunlight, heat, or air conditioning. 18.5&quot;W x 21.5&quot;D x 45.5&quot;H. No assembly required. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hartford Modern Denim-Style Fabric Kitchen Counter Bar Stool, 45.5&quot;H, Dove Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/814RxtIo1YL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sXQy+IzHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sXQy+IzHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1T4NBPNdTS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1T4NBPNdTS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E0oN565VL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81E0oN565VL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxQFgRpmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1zxQFgRpmL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"45.5\",\"label\":\"inches\"}]},{\"nam