    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0853KR33B\",\"sku\":\"B0853KR33B\",\"lang\":\"en\",\"slug\":\"rivet-eli-modern-curved-back-dining-chair-set-of-2-19-3-w-stucco-b0853kr33b\",\"name\":\"Rivet Eli Modern Curved-Back Dining Chair, Set of 2, 19.3&quot;W, Stucco\",\"description\":\"Powerful in its simplicity, each chair is fully upholstered with a curved, supportive back and sturdy wood legs. Soft, rounded edges give these chairs a sculptural quality that makes them a charming addition to any room. 19.3&quot;W x 23.2&quot;D x 33.1&quot;H; seat height: 18.9&quot;H; seat depth: 16.9&quot;D; seat back height: 17.7&quot;H; leg height: 15.4&quot;H Solid wood frame with 80% polyester, 20% acrylic fabric The solid wood frame is well cushioned and fully upholstered. Set of 2 lovely mid-Century inspired chairs are both comfortable and durable. No assembly required Avoid moisture; wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty\",\"primaryImage\":{\"alt\":\"Rivet Eli Modern Curved-Back Dining Chair, Set of 2, 19.3&quot;W, Stucco\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Zgl-AeJeL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AnmlBlVUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81AnmlBlVUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+RUk-lyeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+RUk-lyeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716mENFXl-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716mENFXl-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716lUYAiffL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716lUYAiffL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+JomPAgzL.jpg\",\