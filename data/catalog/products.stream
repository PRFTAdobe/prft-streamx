    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ7PG2X\",\"sku\":\"B07HZ7PG2X\",\"lang\":\"en\",\"slug\":\"bagley-sectional-component-armless-loveseat-fabric-44-w-stone-b07hz7pg2x\",\"name\":\"Bagley Sectional Component, Armless Loveseat, Fabric, 44&quot;W, Stone\",\"description\":\"This sectional sofa boasts a smooth polyester-nylon blend that’s a dream to sit or lie on. This is the armless loveseat component—put several pieces together to arrange your seating in a way that brings the most possible comfort to your living room. Sturdy wood frame with stain-resistant fabric Attached back and reversible seat cushions add lasting style. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you Overall: 44&quot;W x 40&quot;D x 36&quot;H; seat height: 22&quot;H; seat depth: 24&quot;D; seat back height: 36&quot;H; leg height: 2.125&quot;H\",\"primaryImage\":{\"alt\":\"Bagley Sectional Component, Armless Loveseat, Fabric, 44&quot;W, Stone\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61pp3hKMohL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nB1voF7IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nB1voF7IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1VXWHOLZSS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lffixNNiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91lffixNNiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Hc0EcsD3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Hc0EcsD3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U92IToOQL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1U92