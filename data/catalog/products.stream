    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082Q97534\",\"sku\":\"B082Q97534\",\"lang\":\"en\",\"slug\":\"cedar-upholstered-sofa-couch-with-nailheads-91-w-oat-beige-b082q97534\",\"name\":\"Cedar Upholstered Sofa Couch with Nailheads, 91&quot;W, Oat Beige\",\"description\":\"This neutral upholstered sofa brings a stylish charm to any living or family room. Durable fabric-covered foam seat cushions provide lasting comfort, and the rustic nailhead trim enhances any decor. There is plenty of room for friends and family or to stretch out and watch a movie. This item is made to order just for you. Overall: 91&quot;W x 38&quot;D x 30&quot;H; seat height: 19&quot;H; seat depth: 20&quot;D; seat back height: 18&quot;H; arm height: 26&quot;H; leg height: 2.75&quot;H Sturdy wood frame and legs; life-friendly performance fabric; foam seat cushions Removable and reversible seat and back cushions ensure durability and comfort. Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Cedar Upholstered Sofa Couch with Nailheads, 91&quot;W, Oat Beige\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81D+8KXqaPL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GzucZR29L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GzucZR29L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qKD6VaZSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qKD6VaZSL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+TizphlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919+TizphlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kmTCa1hDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kmTCa1hDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/p