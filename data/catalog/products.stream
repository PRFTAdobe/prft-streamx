    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B074KLN3HX\",\"sku\":\"B074KLN3HX\",\"lang\":\"en\",\"slug\":\"parson-entertainment-tower-with-wood-shelves-and-drawer-72-h-oak-b074kln3hx\",\"name\":\"Parson Entertainment Tower with Wood Shelves and Drawer, 72&quot;H, Oak\",\"description\":\"22&quot;L x 16&quot;W x 72&quot;H Solid wood with beautiful oak finish Clean modern lines and rustic finish combined for a transitional style Drawers are suspended on concealed, self-closing, ball-bearing extension glides No assembly required. Wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. Enjoy years of use with this practical and casual entertainment tower and display unit. The wood shelves are perfect for heavy speakers, books, and games, and the self-closing bottom drawer can hold those extra cables and phone chargers.\",\"primaryImage\":{\"alt\":\"Parson Entertainment Tower with Wood Shelves and Drawer, 72&quot;H, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817zncd4RAL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TmvU7aAoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TmvU7aAoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17hIOPN+0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17hIOPN+0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o+6qowJoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o+6qowJoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yVX6jl48L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1yVX6jl48L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"72.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"22.0\",\"label\":\"inches\"}]},{\"name\":\"