    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071FMSYNH\",\"sku\":\"B071FMSYNH\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-performance-fabric-living-room-sectional-sofa-couch-127-w-ecru-b071fmsynh\",\"name\":\"Hoffman Down-Filled Performance Fabric Living Room Sectional Sofa Couch, 127&quot;W, Ecru\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sectional sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 127&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Performance Fabric Living Room Sectional Sofa Couch, 127&quot;W, Ecru\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71O-0Mrx1DL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RKWP0CHRL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1RKWP0CHRL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15udsg8S8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A15udsg8S8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I8tkEjGeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1I8tkEjGeL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kNj5aPzdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kNj5aPzdL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"39.5\",\"label\":\"inches\"}]},{\"name\":\"length\"