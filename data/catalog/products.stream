    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4Z6PXF\",\"sku\":\"B07B4Z6PXF\",\"lang\":\"en\",\"slug\":\"tisbury-nailhead-trim-king-bed-84-w-spinnsol-natural-b07b4z6pxf\",\"name\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Spinnsol Natural\",\"description\":\"This bed adds classic style to any space. A hand-applied pewter nailhead trim accents the scalloped silhouette for added design detail. The sturdy frame is covered in a thick polyester padding for extra comfort. This item is made to order just for you 84&quot;W x 92&quot;D x 56&quot;H; Legs: 5.5&quot;H; Footboard: 18&quot;H Polyster/linen blend fabric, polyurethane foam, plywood frame The bed is fully upholstered on the front and back of the headboard and footboard. Cross-slat support system with adjustable levelers included. Assemble in 30 minutes-1 hour. Vacuum, brush lightly or spot-clean only. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Tisbury Nailhead Trim King Bed, 84&quot;W, Spinnsol Natural\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81p-wd3Th0L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XicoD3WyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81XicoD3WyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UBviFiYoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UBviFiYoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wL3hnSafL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81wL3hnSafL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CsfKuC+ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91CsfKuC+ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ZT9mkFoZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina