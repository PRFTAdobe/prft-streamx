    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWKFN7N\",\"sku\":\"B07BWKFN7N\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-right-facing-sofa-chaise-sectional-leather-115-w-saddle-b07bwkfn7n\",\"name\":\"Rivet Edgewest Modern Right-Facing Sofa Chaise Sectional, Leather, 115&quot;W, Saddle\",\"description\":\"Features such as track arms, box-edge framing, and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the pieces can be configured in many ways to accommodate family and friends. Overall: 115&quot;W x 33&quot;D x 31&quot;H; Seat Height: 19&quot;H; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H; Chaise Depth: 46&quot;D; Chaise Width: 33&quot;W Sturdy wood frame with rich top grain leather upholstery Back and seat cushions are reversible; choose the configuration thats right for you Assemble in 15 minutes or less Free returns for 30 days. 1-year warranty This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Right-Facing Sofa Chaise Sectional, Leather, 115&quot;W, Saddle\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817ZmTGJy-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+kOm9UnVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+kOm9UnVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgITaCJfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81lgITaCJfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fUmmcl1hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91fUmmcl1hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717SxwLwHBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717SxwLwHBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"28.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"36.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"75.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"114.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Sofas\",\"label\":\"Sofas\"}]}],\"categories\":[{\"id\":\"Sofas & Couches\",\"slug\":\"sofas-&-couches\",\"name\":\"Sofas & Couches\",\"value\":\"Sofas & Couches\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":737,\"discountedValue\":663.3}}"
