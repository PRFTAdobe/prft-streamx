    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07JCRRBGN\",\"sku\":\"B07JCRRBGN\",\"lang\":\"en\",\"slug\":\"rivet-thomas-modern-upholstered-sofa-couch-81-5-w-grey-b07jcrrbgn\",\"name\":\"Rivet Thomas Modern Upholstered Sofa Couch, 81.5&quot;W, Grey\",\"description\":\"This sofa can bring natural warmth to your living room. The simple, angular design has air of modernity to it, and the solid-wood frame ensures that this sofa will last for years to come. Overall: 81.5&quot;W x 40.9&quot;D x 26.8&quot;H; Seat Height: 16.1&quot;H; Seat Depth: 28&quot;D; Seat Back Height: 25.6&quot;H; Arm Height: 26.8&quot;H; Leg Height: 1.2&quot;H Solid-wood frame and legs The seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 1-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Rivet Thomas Modern Upholstered Sofa Couch, 81.5&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71XTh3h5KsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xjO2j5zXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xjO2j5zXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DnHimLBdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91DnHimLBdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yJNmhG2gL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yJNmhG2gL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-r15E4g1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71-r15E4g1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VwaKXE2pL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71VwaKXE2pL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Hei