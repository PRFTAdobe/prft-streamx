    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BWJMB8Q\",\"sku\":\"B07BWJMB8Q\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-modern-left-sofa-chaise-sectional-115-w-hunter-green-b07bwjmb8q\",\"name\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Hunter Green\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 115&quot;W x 58&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Modern Left Sofa Chaise Sectional, 115&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JZbHTT2wL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M+K31kVhL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81M+K31kVhL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yHmOo784L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81yHmOo784L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZV006QrOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZV006QrOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V+59z6VrL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81V+59z6VrL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A16x7tRVFNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina