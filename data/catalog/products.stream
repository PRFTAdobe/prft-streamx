unds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Orange\",\"label\":\"Orange\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Red\",\"label\":\"Red\"},{\"value\":\"Sofa bed\",\"label\":\"Sofa bed\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Living room chair\",\"label\":\"Living room chair\"},{\"value\":\"Futon\",\"label\":\"Futon\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Living room furniture\",\"label\":\"Living room furniture\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":866,\"discountedValue\":779.4}}"
