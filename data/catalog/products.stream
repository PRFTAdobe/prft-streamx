    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B0725Z23G4\",\"sku\":\"B0725Z23G4\",\"lang\":\"en\",\"slug\":\"rivet-ventura-mid-century-louvered-dresser-60-w-cherry-b0725z23g4\",\"name\":\"Rivet Ventura Mid-Century Louvered Dresser, 60&quot;W, Cherry\",\"description\":\"60&quot;W x 19&quot;D x 35&quot;H Solid hardwoods with mid-tone cherry finish A clean Mid-century modern style No assembly needed. Wipe with soft dry cloth. Free returns for 30 days. 1-year warranty. Clean, simple lines are the hallmark of this casual Mid-century modern dresser. A warm cherry finish and striking louvered design will ensure enjoyment for years to come. Six sleek drawers open with finger pulls, and concealed glides ensure they roll smoothly. Drawers are suspended on easy opening, concealed, self-closing extension guides\",\"primaryImage\":{\"alt\":\"Rivet Ventura Mid-Century Louvered Dresser, 60&quot;W, Cherry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ao6HETaIL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SI+htPchL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SI+htPchL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vtUJZakGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91vtUJZakGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1haQJcqbpL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1haQJcqbpL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jF602BgoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91jF602BgoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tRAmNGyuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91tRAmNGyuL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"val