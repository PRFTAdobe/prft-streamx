    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4N3GM\",\"sku\":\"B075X4N3GM\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-velvet-accent-chair-35-4-w-otter-grey-b075x4n3gm\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Accent Chair, 35.4&quot;W, Otter Grey\",\"description\":\"This sleek, mid-century inspired velvet chair is designed to impress. A deep seat cushion, back cushion, tapered wood legs, and smooth bolster pillows provide just the right mix of sophistication with a contemporary edge. 35.4”W x 36.2”D x 30.3”H 100% polyester; solid hardwood frame; tapered wood legs. Removable and reversible back cushion for easy cleaning. Free returns for 30 days. 1-year warranty. Simple leg assembly. Wipe with a soft, dry cloth.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Velvet Accent Chair, 35.4&quot;W, Otter Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pvqYcNJ-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913DOJojn6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/913DOJojn6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1flZxjo7tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1flZxjo7tL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LV25kXraL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LV25kXraL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhbc3CzuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91zhbc3CzuL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"36.2\",\"