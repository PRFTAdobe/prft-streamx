    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B086KFCF4V\",\"sku\":\"B086KFCF4V\",\"lang\":\"en\",\"slug\":\"faux-linen-upholstered-square-stitched-platform-bed-mattress-foundation-easy-assembly-strong-wood-slat-support-dark-grey-queen-b086kfcf4v\",\"name\":\"Faux-Linen Upholstered Square Stitched Platform Bed - Mattress Foundation - Easy Assembly - Strong Wood Slat Support-Dark Grey, Queen\",\"description\":\"All-in-one platform bed with foundation and headboard Durable, stylish faux linen upholstery with diamond-stitched headboard No need for a box spring, simply place mattress on slatted foundation. The bed materials are 60% Upholstered, 30% plywood, 5% metal, 5% plastic. Strong wood slats can hold up to 150 pounds each; includes metal supports and 4 wood legs Sophisticated, simple mid-century modern design Easy assembly with all necessary components, hardware, and tools\",\"primaryImage\":{\"alt\":\"Faux-Linen Upholstered Square Stitched Platform Bed - Mattress Foundation - Easy Assembly - Strong Wood Slat Support-Dark Grey, Queen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gTL5rO3hL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15HTqGot4S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15HTqGot4S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sv6uHXHUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sv6uHXHUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8185JSezaqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8185JSezaqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915itGXyzdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915itGXyzdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/914FaL2VGLL.jpg\",\"url\":\"https://stor