      "content": {
        "bytes": "{\"id\":\"B07QZ478KZ\",\"sku\":\"B07QZ478KZ\",\"lang\":\"en\",\"slug\":\"modern-adjustable-swivel-bar-island-stools-pu-with-chrome-air-lift-set-of-2-black-b07qz478kz\",\"name\":\"Modern Adjustable Swivel Bar/Island Stools - PU with Chrome Air Lift - Set of 2, Black\",\"description\":\"Set of two swiveling stools for kitchen islands, high tables, or bars Durable, attractive faux leather upholstery Thick foam-cushioned backrests and seats add support and comfort 360 degree swivel capability and air-lift height adjustment mechanism Polished chrome base and footrest add a sleek, modern look\",\"primaryImage\":{\"alt\":\"Modern Adjustable Swivel Bar/Island Stools - PU with Chrome Air Lift - Set of 2, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71OM4cBNFkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YYspx86cL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YYspx86cL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915m6FaV+yL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/915m6FaV+yL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51lD10atT8L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/51/51lD10atT8L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31g-FMZSMmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/31/31g-FMZSMmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HonLZybKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91HonLZybKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YWfbrdhWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71YWfbrdhWL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\"