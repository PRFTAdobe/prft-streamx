    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07P5LN3D6\",\"sku\":\"B07P5LN3D6\",\"lang\":\"en\",\"slug\":\"charles-classic-oversized-upholstered-chair-39-w-dove-b07p5ln3d6\",\"name\":\"Charles Classic Oversized Upholstered Chair, 39&quot; W, Dove\",\"description\":\"Let yourself be wrapped in comfort by this generously plush chair. Traditional rolled arms and turned wood legs are combined with modern upholstery for a welcome update on a classic piece. 39&quot;W x 39&quot;D x 38&quot;H Solid hardwood frame; upholstery: 95% polyester, 5% nylon Removable back and seat cushions make upkeep a breeze. A traditional silhouette is paired with modern, stain-resistant fabric, making this the perfect addition to a busy home. Assemble in 15 minutes or less Vacuum or wipe with a dry cloth. Spot clean if needed. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Charles Classic Oversized Upholstered Chair, 39&quot; W, Dove\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/717vPUMc3cL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714ITUhl5ZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/714ITUhl5ZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1LVE1Sy7IL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G0moSx0jL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91G0moSx0jL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ShBY5vRIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71ShBY5vRIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NkzfKlC7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71NkzfKlC7L.jpg\"}],\"attributes\":[{\"name\":\"heig