    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QGWLB9F\",\"sku\":\"B07QGWLB9F\",\"lang\":\"en\",\"slug\":\"counter-height-barstool-with-brass-nailhead-trim-39-h-slate-b07qgwlb9f\",\"name\":\"Counter-Height Barstool with Brass Nailhead Trim, 39&quot;H, Slate\",\"description\":\"These high-back transitional-style barstools have distinctive slate-colored fabric upholstery with brass nailhead trim. Open sides allow for freedom of movement, and the solid wood frame provides stability and balance. 21&quot;W x 22&quot;D x 39&quot;H; seat height: 26&quot;H; seat depth: 17&quot;D; seat back height: 13&quot;H Moisture-repellent, stain-resistant fabric on a solid hardwood frame Open sides allow maximum freedom of movement. These transitional barstools feature brass nailhead decorative trim on slate-colored performance fabric seats. No assembly required Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Counter-Height Barstool with Brass Nailhead Trim, 39&quot;H, Slate\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81rCp3XzoWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A17Je-fRp5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DgLoHGwTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81DgLoHGwTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eF4rAOOWL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81eF4rAOOWL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xHLVxr+YL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xHLVxr+YL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/711JiCAw+5L.jpg\",\"url\":\"https://storage.googleapis.com/p