    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075Z8M22B\",\"sku\":\"B075Z8M22B\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-open-back-swivel-office-desk-chair-24-w-marble-b075z8m22b\",\"name\":\"Rivet Mid-Century Open Back Swivel Office Desk Chair, 24&quot;W, Marble\",\"description\":\"24&quot;W x 22.8&quot;D x 33.5&quot;H Fabric is 90% polyester/10% linen. Solid wood swivel base and legs. Attractive and suitable for any room where stylish extra seating is needed No assembly required. Vacuum or wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty. While this swivel chair is ideal for a home office, it's handsome enough to be used in any room. The Mid-century inspired design features an opening in the back and low-slung arms. Tall solid-wood legs have an espresso finish.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Open Back Swivel Office Desk Chair, 24&quot;W, Marble\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eCZSDLP+L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GMQkNsaNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GMQkNsaNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18edfNR0-S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B18edfNR0-S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1-U4PzJ+7S.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Z4ImtcwvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Z4ImtcwvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aOhJcEWCL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1aOhJcEWCL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"val