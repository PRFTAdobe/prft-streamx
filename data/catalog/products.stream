    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075YP32X2\",\"sku\":\"B075YP32X2\",\"lang\":\"en\",\"slug\":\"rivet-mid-century-modern-upholstered-low-back-kitchen-counter-height-stool-37-h-light-grey-b075yp32x2\",\"name\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Counter Height Stool, 37&quot;H, Light Grey\",\"description\":\"This fun counter stool features an upholstered low-back seat on tall, straight wood legs. Firm padding and a solid wood frame add sturdiness and durability, while the light grey fabric brings a nice neutral color to your counter area. 20&quot;W x 21&quot;D x 37&quot;H. Seat height is 26&quot;. Fabric is 60% polyester/20% linen/20% rayon Foam padding and elastic suspension system helps keep seat firm No assembly required. Wipe with a soft dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Mid-Century Modern Upholstered Low Back Kitchen Counter Height Stool, 37&quot;H, Light Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dcuF4YA9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912xU61FKYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912xU61FKYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7dhuCgcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j7dhuCgcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16aJ-nc4FS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B16aJ-nc4FS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816D4aJoTcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/816D4aJoTcL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"20.0\",\"label\":\"i