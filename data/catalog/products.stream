    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M2QZ7\",\"sku\":\"B07B4M2QZ7\",\"lang\":\"en\",\"slug\":\"jacobsen-traditional-accent-chair-31-w-fresh-ivory-linen-b07b4m2qz7\",\"name\":\"Jacobsen Traditional Accent Chair, 31&quot;W, Fresh Ivory Linen\",\"description\":\"30.7&quot;W x 33.4&quot;D x 33.8&quot;H Top-grain leather on wood frame with wood legs The classic wingback chair is updated and downsized to a more transitional look. An ideal accent chair for a family room or a home office Easy assembly in 15 minutes or less; just screw on legs Free returns for 30 days. 1-year warranty. The classic wingback chair gets a modern refresh in a more compact size. Dark grey nailhead trim gives this piece an upscale accent, while the top grain leather is comfortable and durable. Natural markings in the leather make each chair unique.\",\"primaryImage\":{\"alt\":\"Jacobsen Traditional Accent Chair, 31&quot;W, Fresh Ivory Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ILcOGEJlL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ln9BcsfUL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ln9BcsfUL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DA7z91azL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DA7z91azL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BJs9mSj5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BJs9mSj5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cdvwLBNOL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cdvwLBNOL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h1yknccSL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91h1yknccSL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"lab