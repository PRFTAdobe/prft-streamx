        "bytes": "{\"id\":\"B07B4MMV7P\",\"sku\":\"B07B4MMV7P\",\"lang\":\"en\",\"slug\":\"andover-modern-living-room-accent-chair-38-w-light-blue-b07b4mmv7p\",\"name\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Light Blue\",\"description\":\"With sturdy frames and reversible cushions, the furniture in this collection will withstand years of fun and cuddles with family and pets. Features such as track arms and box-edge lines bring stylish sophistication to modern or transitional rooms. 38&quot;W x 38&quot;D x 35&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 28&quot;H; Arm Height: 28&quot;H; Leg Height: 4.25&quot;H Stain-resistant polyester fabric on hardwood pine frame Track arms and a streamlined shape are hallmarks of modern design Back and seat cushions are reversible; individual pieces can be configured in many ways Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Living Room Accent Chair, 38&quot;W, Light Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-DrOc0ReL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hO1rDmUNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91hO1rDmUNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pb2reeRJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pb2reeRJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81t4iHeYG4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q9iC1pJIL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1q9iC1pJIL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Do485ov3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Do485ov3L.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"25.0\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Living-room-chairs\",\"label\":\"Living-room-chairs\"},{\"value\":\"Stone & beam\",\"label\":\"Stone & beam\"},{\"value\":\"Chair\",\"label\":\"Chair\"},{\"value\":\"Light blue\",\"label\":\"Light blue\"},{\"value\":\"Couch\",\"label\":\"Couch\"},{\"value\":\"Accent chair\",\"label\":\"Accent chair\"},{\"value\":\"Sectional couch\",\"label\":\"Sectional couch\"},{\"value\":\"Sofa\",\"label\":\"Sofa\"},{\"value\":\"Sleeper sofa\",\"label\":\"Sleeper sofa\"},{\"value\":\"Farmhouse\",\"label\":\"Farmhouse\"},{\"value\":\"Sofa sets for living room\",\"label\":\"Sofa sets for living room\"},{\"value\":\"Loveseat\",\"label\":\"Loveseat\"},{\"value\":\"Sectional sofa\",\"label\":\"Sectional sofa\"},{\"value\":\"Stone and beam\",\"label\":\"Stone and beam\"},{\"value\":\"Recliner chair\",\"label\":\"Recliner chair\"}]}],\"categories\":[{\"id\":\"Chairs\",\"slug\":\"chairs\",\"name\":\"Chairs\",\"value\":\"Chairs\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":593,\"discountedValue\":533.7}}"
