    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZ3VCM\",\"sku\":\"B07PBZ3VCM\",\"lang\":\"en\",\"slug\":\"rivet-sloane-mid-century-modern-armchair-with-tapered-legs-32-7-w-emerald-green-b07pbz3vcm\",\"name\":\"Rivet Sloane Mid-Century Modern Armchair with Tapered Legs, 32.7&quot;W, Emerald Green\",\"description\":\"This modern armchair sports a strong profile and tapered wooden legs, giving it a minimalist yet retro feel that makes it instantly appealing. The durable upholstery and solid-wood frame make this piece both cozy and reliable. 32.7&quot;W x 35.8&quot;D x 33.1&quot;H Solid wood frame and legs; 100% polyester upholstery A solid wood frame and durable fabric make this armchair as practical as it is stylish. Tapered legs add elegance to this minimalist design. Assemble in 15 minutes or less Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Sloane Mid-Century Modern Armchair with Tapered Legs, 32.7&quot;W, Emerald Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91LCYRBXRsL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wfb++nJ0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Wfb++nJ0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t138DiQJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t138DiQJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bIMOsn3AL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bIMOsn3AL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918wjo0bSlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/918wjo0bSlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FIZh6yACL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/orig