    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M2B7N\",\"sku\":\"B07B4M2B7N\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-low-back-contemporary-modern-l-sectional-sofa-116-w-blue-b07b4m2b7n\",\"name\":\"Rivet Edgewest Low Back Contemporary Modern L-Sectional Sofa, 116&quot;W, Blue\",\"description\":\"Features such as track arms, box-edge framing and metal legs make this collection look sharp in modern or industrial settings. Back and seat cushions are reversible, and the collection offers multiple options to accommodate family and friends. 116&quot;W x 79&quot;D x 32&quot;H; Seat Height: 19&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 25&quot;H; Arm Height: 25&quot;H; Leg Height: 5.25&quot;H Stain-resistant polyester fabric; hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Low Back Contemporary Modern L-Sectional Sofa, 116&quot;W, Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81xxljlmT9L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DY-I86QoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1DY-I86QoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815GvvmsIKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/815GvvmsIKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kHy02jO0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81kHy02jO0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t-8sAy3nL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91t-8sAy3nL.jpg\"},{\"alt\":\"https://storage.goo