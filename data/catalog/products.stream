    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4FZN7H\",\"sku\":\"B07B4FZN7H\",\"lang\":\"en\",\"slug\":\"rivet-edgewest-modern-ottoman-32-w-blue-ink-b07b4fzn7h\",\"name\":\"Rivet Edgewest Modern Ottoman, 32&quot;W, Blue Ink\",\"description\":\"Features such as box-edge framing and metal legs make this ottoman look sharp in modern or industrial settings. With a solid frame and durable fabric, it's ready to welcome tired feet or to serve as extra seating for guests. 32&quot;W x 26&quot;D x 19&quot;H; Seat Height: 19&quot;H ; Seat Depth: 26&quot;D; Seat Back Height: 19&quot;H; Leg Height: 5.25&quot;H Polyester fabric on hardwood pine frame; metal legs with bronze finish Crisp, clean lines and metal legs are hallmarks of contemporary style Carefully crafted with a solid wood frame to ensure durability Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Edgewest Modern Ottoman, 32&quot;W, Blue Ink\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9163YtMHQUL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dy0z3Ff2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dy0z3Ff2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pNX---lBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pNX---lBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZIIBVIlBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H5v90O3aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91H5v90O3aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wkymNpFsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wk