    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B084W32W2N\",\"sku\":\"B084W32W2N\",\"lang\":\"en\",\"slug\":\"vivianne-modern-upholstered-armless-dining-chair-with-casters-19-7-w-linen-b084w32w2n\",\"name\":\"Vivianne Modern Upholstered Armless Dining Chair with Casters, 19.7&quot;W, Linen\",\"description\":\"This armless dining chair, upholstered in a linen-colored fabric, adds contemporary elegance to your room. This comfortable seating has casters, making it easy to move while retaining your modern aesthetic. The moisture-repellent and stain-resistant fabric makes cleanup easy. 19.7&quot;W x 27.6&quot;D x 36.2&quot;H; seat height: 20.9&quot;H; seat depth: 17.3&quot;D; seat back height: 33.1&quot;H; leg height: 2&quot;H Solid hardwood frame with moisture-repellent, stain-resistant fabric These chairs have wheels, which makes them easy to move and comfortable to adjust. Feather-filled cushions provide great comfort. No assembly required Avoid moisture. Wipe clean with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Vivianne Modern Upholstered Armless Dining Chair with Casters, 19.7&quot;W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/912Nn9M-cEL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917+OFuVUyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917+OFuVUyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uWI1iynXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91uWI1iynXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813tQ-eTnFL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813tQ-eTnFL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91op0BqpSLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91op0BqpSLL.jpg\"},{\"alt\":