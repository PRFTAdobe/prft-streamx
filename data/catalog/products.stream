    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082QCH6CR\",\"sku\":\"B082QCH6CR\",\"lang\":\"en\",\"slug\":\"rivet-ross-modern-vegan-faux-leather-lift-top-storage-ottoman-pouf-17-7-w-black-b082qch6cr\",\"name\":\"Rivet Ross Modern Vegan Faux Leather Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Black\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila—it's an extra tray for snacks! An ottoman couldn't be more clever and multitasking than this. 17.7&quot;W x 17.7&quot;D x 18.1&quot;H Compact and stable with wood-frame construction and vegan leather exterior Handy anywhere you need an extra place to sit, set things down, or store clutter. Modern styling perfect for your contemporary home Simple assembly in 15 minutes or less. Wipe clean with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ross Modern Vegan Faux Leather Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Black\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81anobkrArL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qrrhdW6fL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qrrhdW6fL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817xccNVyYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/817xccNVyYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81u+-TpA7QL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81u+-TpA7QL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81digpwKVbL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81digpwKVbL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91XIC12lvgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/