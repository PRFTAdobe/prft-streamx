    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B082VKXXN2\",\"sku\":\"B082VKXXN2\",\"lang\":\"en\",\"slug\":\"shorebrook-deep-upholstered-accent-chair-27-6-w-grey-b082vkxxn2\",\"name\":\"Shorebrook Deep Upholstered Accent Chair, 27.6&quot;W, Grey\",\"description\":\"This upholstered chair, with its clean lines and classy look, is well suited for any room in your home. Sturdy, easy to clean, and faintly retro in design while at the same time embracing a modern-day sleekness—what's not to love? 27.6&quot;W x 33.9&quot;D x 35.8&quot;H Solid wood frame with brass nailhead trim This sturdy chair possesses a classy, timeless look, perfect as occasional seating or to add a touch of style to your living room. Assemble in 15 minutes or less To clean, avoid moisture and wipe down with a clean, soft cloth. Free returns for 30 days. 3-year warranty\",\"primaryImage\":{\"alt\":\"Shorebrook Deep Upholstered Accent Chair, 27.6&quot;W, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818wXrPtPVL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oZoSBNq2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91oZoSBNq2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FFgv18VyL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FFgv18VyL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818MPOU7tfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818MPOU7tfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8156PUCur7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/8156PUCur7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tEEWAFG5L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tEEWAFG5L.jpg\"},{\"alt\":\"https://storage.googleapis.com/