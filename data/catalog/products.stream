    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4YZWRK\",\"sku\":\"B07B4YZWRK\",\"lang\":\"en\",\"slug\":\"rivet-jonathan-mid-century-modern-tall-wood-bedroom-dresser-drawers-54-inch-height-brass-hardware-walnut-b07b4yzwrk\",\"name\":\"Rivet Jonathan Mid-Century Modern Tall Wood Bedroom Dresser Drawers, 54 Inch Height, Brass Hardware, Walnut\",\"description\":\"This classic mid-century chest of drawers will have you reveling in retro style as you get dressed each morning. The minimalist design is accented by simple brass hardware on the five drawers. A base of four slanted legs completes the vintage look. 36&quot;W x 19&quot;D x 54&quot;H; LegHeight: 7.5&quot; Five drawers provide ample storage for clothing, jewelry and other items Easy assembly in 15 minutes; just bolt on base Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Jonathan Mid-Century Modern Tall Wood Bedroom Dresser Drawers, 54 Inch Height, Brass Hardware, Walnut\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A03TxdBNL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917T5DcDpzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/917T5DcDpzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1o4guz5-aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UV15UGolL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91UV15UGolL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pMZoXPE7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pMZoXPE7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+wXgF1j-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71+wXgF1j-L.jpg\"},{\"alt\"