    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QLD8DW\",\"sku\":\"B075QLD8DW\",\"lang\":\"en\",\"slug\":\"delano-nailhead-trim-king-headboard-63-25-h-navy-blue-b075qld8dw\",\"name\":\"Delano Nailhead Trim King Headboard, 63.25&quot;H, Navy Blue\",\"description\":\"This headboard will make your bedroom a truly restful retreat. Performance fabric is durable and easy to clean, while ample padding makes it comfy to lean against while enjoying a good book. Nickel-finished nailhead trim borders the graceful curves. 80.5&quot;W x 3.5&quot;D x 63.25&quot;H Polyester fabric. Hardwood frame and legs. Metal nailheads. A modern style with classic linen fabric and simple lines to blend with any decor Polyester performance fabric is durable, easy to clean. Adjusts to 3 different heights. Assemble in 15 minutes or less. Clean with water-based shampoo or foam upholstery cleaner. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Delano Nailhead Trim King Headboard, 63.25&quot;H, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81x+E9AbXWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1NAzmswOZS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k7+b2PmaL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91k7+b2PmaL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dJPD+YOUS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1dJPD+YOUS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iNLv+1IxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91iNLv+1IxL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"63.25\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width