    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QCQ33DC\",\"sku\":\"B07QCQ33DC\",\"lang\":\"en\",\"slug\":\"merrill-king-headboard-with-decorative-nailhead-trim-92-w-eclipse-b07qcq33dc\",\"name\":\"Merrill King Headboard with Decorative Nailhead Trim, 92&quot;W, Eclipse\",\"description\":\"This chic eclipse-colored king-size headboard has strong, simple lines that take it from classic to modern. As comfortable as it is attractive, the headboard is accented with a pewter nailhead trim that adds an extra pop of style. 92&quot;W x 11&quot;D x 52&quot;H Polyester and linen blend fabric, polyurethane foam, plywood frame This bed adds modern classic style to any space. The sturdy frame is covered in a thick layer of padding for extra comfort. The headboard is fully upholstered on both the front and the back. Assemble in 15 minutes or less Free returns for 30 days. 3-year warranty. Vacuum, brush lightly, or spot clean only.\",\"primaryImage\":{\"alt\":\"Merrill King Headboard with Decorative Nailhead Trim, 92&quot;W, Eclipse\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OodNydOxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A19rY5+C58L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919cszYbE3L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919cszYbE3L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b+A5yJL4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91b+A5yJL4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QapTenfPL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81QapTenfPL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"52.0\",\"label\":\"inches\"}]},{\"name\":\"widt