    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2WNYQ\",\"sku\":\"B075X2WNYQ\",\"lang\":\"en\",\"slug\":\"rivet-lawson-modern-angled-leather-loveseat-58-w-charcoal-b075x2wnyq\",\"name\":\"Rivet Lawson Modern Angled Leather Loveseat, 58&quot;W, Charcoal\",\"description\":\"This item is made to order just for you 58&quot;W x 34&quot;D x 34&quot;H Sturdy hardwood frame and legs with 100% leather upholstery. Tight, padded back with two removable seat cushions make it functional and comfortable. Free returns for 30 days. 1-year warranty. You'll enjoy snuggling with family and friends, or by yourself, on this sophisticated loveseat. A sleek back, angled arms, removable seat cushions and tapered legs give it urbane, mid-century influenced style. Available in leather and fabric upholstery. No assembly. Vacuum or wipe with a dry cloth. If needed, spot clean with a damp cloth.\",\"primaryImage\":{\"alt\":\"Rivet Lawson Modern Angled Leather Loveseat, 58&quot;W, Charcoal\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81FAtCLtF8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAR82+8dL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qAR82+8dL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818T9ZqsCYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818T9ZqsCYL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VvHMzTMwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91VvHMzTMwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9146bgafNYL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/9146bgafNYL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"34.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"58.0\",\