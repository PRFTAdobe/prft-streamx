    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ4NFSL\",\"sku\":\"B07HZ4NFSL\",\"lang\":\"en\",\"slug\":\"blaine-modern-loveseat-sofa-55-9-w-navy-blue-b07hz4nfsl\",\"name\":\"Blaine Modern Loveseat Sofa, 55.9&quot;W, Navy Blue\",\"description\":\"Add mid-century elegance to your living room with this navy blue loveseat. The solid-wood frame and polyester upholstery make this loveseat both sturdy and cozy, and the removable/reversible cushions ensure durability and comfort. Overall: 55.9&quot;W x 37.8&quot;D x 35&quot;H; seat height: 19.3&quot;H; seat depth: 22&quot;D; seat back height: 25.6&quot;H; arm height: 24.4&quot;H; leg height: 4.9&quot;H Solid-wood frame and legs with 100% polyester upholstery The tight, removable back cushions and fixed seat cushions ensure durability and comfort. Simple assembly in less than 15 minutes Free returns for 30 days. 3-year warranty. This item is made to order just for you\",\"primaryImage\":{\"alt\":\"Blaine Modern Loveseat Sofa, 55.9&quot;W, Navy Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81TUInwtENL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GwcPoqKuL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91GwcPoqKuL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818HCNIh-2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/818HCNIh-2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cur2Ioy4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1cur2Ioy4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sNFcg2vzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91sNFcg2vzL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MAuicCvvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/or