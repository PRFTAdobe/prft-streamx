    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07124WN22\",\"sku\":\"B07124WN22\",\"lang\":\"en\",\"slug\":\"rivet-ross-modern-tweed-lift-top-storage-ottoman-pouf-17-7-w-denim-b07124wn22\",\"name\":\"Rivet Ross Modern Tweed Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Denim\",\"description\":\"It's a footstool, a storage space, an end table, an extra seat for company. Turn over the lid and voila -- it's an extra tray for snacks! An ottoman couldn't be more clever and multi-tasking than this. 17.7&quot;W x 17.7&quot;D x 18.1&quot;H Wood frame, synthetic legs Compact and modern Handy anywhere you need an extra place to sit, set things down or store clutter. No assembly required. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ross Modern Tweed Lift-Top Storage Ottoman Pouf, 17.7&quot;W, Denim\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CeonpBzXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-CB2PvFdL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1-CB2PvFdL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CJ-zrQn2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1CJ-zrQn2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nkwa69kgS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1nkwa69kgS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c6Rc7T0UL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1c6Rc7T0UL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XbSu5usBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1XbSu5usBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"18.1\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"17.7\",\"label\":\"inches\"}]},{\"name\":\"weight\",\"label\":\"Weight\",\"values\":[{\"value\":\"21.8\",\"label\":\"pounds\"}]},{\"name\":\"keywords\",\"label\":\"Keywords\",\"values\":[{\"value\":\"Bench\",\"label\":\"Bench\"},{\"value\":\"Blue\",\"label\":\"Blue\"},{\"value\":\"Ottomans\",\"label\":\"Ottomans\"},{\"value\":\"Ottoman foot rest\",\"label\":\"Ottoman foot rest\"},{\"value\":\"Mid century\",\"label\":\"Mid century\"},{\"value\":\"Storage-ottomans\",\"label\":\"Storage-ottomans\"},{\"value\":\"Pouf ottoman\",\"label\":\"Pouf ottoman\"},{\"value\":\"Ottoman coffee table\",\"label\":\"Ottoman coffee table\"},{\"value\":\"Ottoman\",\"label\":\"Ottoman\"},{\"value\":\"Storage bench\",\"label\":\"Storage bench\"},{\"value\":\"Modern\",\"label\":\"Modern\"},{\"value\":\"Storage ottoman\",\"label\":\"Storage ottoman\"},{\"value\":\"Foot ottoman\",\"label\":\"Foot ottoman\"},{\"value\":\"Pouf\",\"label\":\"Pouf\"},{\"value\":\"Round ottoman\",\"label\":\"Round ottoman\"},{\"value\":\"Ottoman with storage\",\"label\":\"Ottoman with storage\"},{\"value\":\"Rivet\",\"label\":\"Rivet\"},{\"value\":\"Denim\",\"label\":\"Denim\"}]}],\"categories\":[{\"id\":\"Ottomans\",\"slug\":\"ottomans\",\"name\":\"Ottomans\",\"value\":\"Ottomans\",\"label\":null,\"parent\":null,\"subcategories\":[]}],\"price\":{\"value\":921,\"discountedValue\":828.9}}"
