    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBZL4BX\",\"sku\":\"B07PBZL4BX\",\"lang\":\"en\",\"slug\":\"kristin-mid-century-wood-framed-sleeper-armchair-55-5-w-azure-b07pbzl4bx\",\"name\":\"Kristin Mid-Century Wood-Framed Sleeper Armchair, 55.5&quot;W, Azure\",\"description\":\"This chair’s foam-padded cushions sit loosely on the hardwood frame, making them easy to remove and creating a casual look that gives any space a welcoming and comfortable appearance. Performance fabrics and reversible seat cushions make this chair easy to maintain. 55.5&quot;W x 37&quot;D x 37.5&quot;H Performance fabric over padded solid-wood frame with mortise-and-tenon construction; poly-Dacron foam filling Loose back and seat cushions are removable and reversible, ensuring durability and comfort. Chair easily opens to provide extra sleeping space. Sewn-in detailing along front provides texture. No assembly required Quickly blot spills with a damp cloth. Use a soft, dry cloth for routine care. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Kristin Mid-Century Wood-Framed Sleeper Armchair, 55.5&quot;W, Azure\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81y74LkON4L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jWbimQEcL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1jWbimQEcL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P-8C7NKfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91P-8C7NKfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715miG-xDsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/715miG-xDsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A86Fph6oL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91A86Fph6oL.jpg\"},{\"alt\":\"https://storage.google