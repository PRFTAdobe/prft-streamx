    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4M2N7G\",\"sku\":\"B07B4M2N7G\",\"lang\":\"en\",\"slug\":\"edmunds-traditional-recliner-30-w-grey-linen-b07b4m2n7g\",\"name\":\"Edmunds Traditional Recliner, 30&quot;W, Grey Linen\",\"description\":\"Straight lines and narrow arms combine modern touches with classic fabric, making this chair an ideal transitional style -- AND it's a recliner that doesn't look like a recliner. This piece will last through years of movies and afternoon naps. 30&quot;W x 36&quot;D x 41&quot;H; Seat Height: 21&quot;H ; Seat Depth: 23&quot;D; Seat Back Height: 41&quot;H; Arm Height: 23&quot;H; Front legs: 4.5&quot;H; Back legs: 4.125&quot;H Polyester fabric on hardwood pine frame Streamlined silhouette combines modern style with a classic fabric for a transitional look Push back reclining mechanism No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Edmunds Traditional Recliner, 30&quot;W, Grey Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1qc-yacIgL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eeo4mo5FL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1eeo4mo5FL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmKswyvmL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91cmKswyvmL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1q5GbLsMjS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f9CinfoNL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1f9CinfoNL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dSA4vbNoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dSA4vbNoL.jpg