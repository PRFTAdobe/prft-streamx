        "bytes": "{\"id\":\"B0719WQH8S\",\"sku\":\"B0719WQH8S\",\"lang\":\"en\",\"slug\":\"rivet-revolve-modern-upholstered-armchair-with-tapered-legs-33-w-denim-blue-b0719wqh8s\",\"name\":\"Rivet Revolve Modern Upholstered Armchair with Tapered Legs, 33&quot;W, Denim Blue\",\"description\":\"This chair has enough contemporary yet classic elements to blend in with your existing style. Clean lines, comfortable seating and durable fabric give this piece functionality as well as smart design. 34.6&quot;D x 32.7&quot;W x 35.4&quot;H Hardwood frame with solid beech wood legs Modern style with timeless touches A great accent piece to brighten up any space Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Revolve Modern Upholstered Armchair with Tapered Legs, 33&quot;W, Denim Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A12vHbfzKHL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nXkCrLbgL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1nXkCrLbgL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FA3Feyy-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FA3Feyy-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kwIMNZJoL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kwIMNZJoL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s+7PqwyGS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1s+7PqwyGS.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"35.4\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"34.6\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"32.7\",\"label\":\"inc