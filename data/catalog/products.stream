    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07QBMQ4YF\",\"sku\":\"B07QBMQ4YF\",\"lang\":\"en\",\"slug\":\"rivet-aiden-mid-century-sectional-with-tapered-wood-legs-86-w-hunter-green-b07qbmq4yf\",\"name\":\"Rivet Aiden Mid-Century Sectional with Tapered Wood Legs, 86&quot;W, Hunter Green\",\"description\":\"This sectional features easy-care upholstery with removable cushions that will help keep cleaning simple, and the attractive green fabric will blend in with the decor of almost any room. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 86&quot;W x 37&quot;D x 33&quot;H Solid hardwood frame with tapered wood legs Removable and reversible seat and back cushions Mid-century style and easy-care fabric combine to make this a welcome addition to any room. Assemble in 15 minutes or less Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Mid-Century Sectional with Tapered Wood Legs, 86&quot;W, Hunter Green\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ht7u2x7BL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xSgtfiipL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1xSgtfiipL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1st23gPmVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1st23gPmVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pxWVvgq4L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71pxWVvgq4L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71y5XjIdy1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71y5XjIdy1L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61od+ArINoL.jpg\",\"url\":\"https://storage.googleapis.c