    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BKJXRTQ\",\"sku\":\"B07BKJXRTQ\",\"lang\":\"en\",\"slug\":\"rivet-aiden-tufted-mid-century-modern-leather-bench-seat-sofa-86-6-w-cognac-b07bkjxrtq\",\"name\":\"Rivet Aiden Tufted Mid-Century Modern Leather Bench Seat Sofa, 86.6&quot; W, Cognac\",\"description\":\"This sleek, Mid-century inspired leather sofa is designed to impress. A long fixed bench seat cushion, two back cushions, and tapered wood legs provide just the right mix of sophistication with a contemporary edge. 86.6&quot;W x 36.2”D x 30.3”H Soft top-grain leather; solid hardwood frame; tapered wood legs Removable and reversible back seat cushions for easy cleaning Simple leg assembly. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Aiden Tufted Mid-Century Modern Leather Bench Seat Sofa, 86.6&quot; W, Cognac\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81haWowEh-L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kpq5OiqML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1Kpq5OiqML.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B15pHkvfoKS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mkjLXNJfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1mkjLXNJfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZL9feVy6L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1ZL9feVy6L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NrLVKdZzL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81NrLVKdZzL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"30.3\