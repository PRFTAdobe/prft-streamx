    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B4MH5Q1\",\"sku\":\"B07B4MH5Q1\",\"lang\":\"en\",\"slug\":\"andover-modern-rectangle-ottoman-32-w-pewter-b07b4mh5q1\",\"name\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Pewter\",\"description\":\"Wooden legs, clean lines, and box-edge cushions bring stylish sophistication to modern or transitional rooms. With a sturdy frame and springy cushioning, this ottoman is ready to withstand years as a footrest or extra seating for guests. 32&quot;W x 25&quot;D x 21&quot;H; Seat Height: 21&quot;H ; Seat Depth: 25&quot;D; Seat Back Height: 21&quot;H; Leg Height: 4.25&quot;H Cotton/polyester blend fabric on hardwood pine frame The streamlined shape is a hallmark of modern design Carefully crafted to ensure durability and years of use Easy assembly in less than 15 minutes; just screw in legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Andover Modern Rectangle Ottoman, 32&quot;W, Pewter\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81fI48M0GyL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916xH+Q19OL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/916xH+Q19OL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911S6MW+PJL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MQIKfe69L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MQIKfe69L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81siOj3WWKL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81siOj3WWKL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dpdPGx7tL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dpdPGx7tL.jpg\"}],\"attribut