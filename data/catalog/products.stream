    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568W12Z\",\"sku\":\"B08568W12Z\",\"lang\":\"en\",\"slug\":\"rivet-vermont-modern-faux-leather-diamond-accent-dining-chair-20-w-set-of-2-grey-b08568w12z\",\"name\":\"Rivet Vermont Modern Faux Leather Diamond Accent Dining Chair, 20&quot;W, Set of 2, Grey\",\"description\":\"The armless profile, sleek metal legs and diamond-stitched cushion pattern of this dining chair combine classic and modern looks into an elegant style of its own. Overall: 23.2.&quot;D x 20&quot;W x 35&quot;H. Seat height: 19&quot; Solid wood frame with sturdy metal base. Set of 2 padded, upholstered dining chairs with brass legs and H-shaped stretcher bar. Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Vermont Modern Faux Leather Diamond Accent Dining Chair, 20&quot;W, Set of 2, Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71xN230OnqL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BwPx6o7hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91BwPx6o7hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ktCuNUU0L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61ktCuNUU0L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nFzCh7WAL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61nFzCh7WAL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AWJjY0qTL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61AWJjY0qTL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Hi9og1kwL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61Hi9og1kwL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71lq697Ekr