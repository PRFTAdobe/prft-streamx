    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07BW8MJV9\",\"sku\":\"B07BW8MJV9\",\"lang\":\"en\",\"slug\":\"hoffman-down-filled-chaise-sectional-sofa-couch-87-5-w-dark-grey-tweed-b07bw8mjv9\",\"name\":\"Hoffman Down-Filled Chaise Sectional Sofa Couch, 87.5&quot;W, Dark Grey Tweed\",\"description\":\"Whatever you need to accommodate kids, pets, spills and every other facet of a busy life, this sectional sofa has it all: Plush comfort, stain-resistant fabric, durable construction, and a timeless look to blend with your existing styles. 87.5&quot;W x 39.5&quot;D x 37&quot;H Solid hardwood frame with Revolution Performance Fabric Modern casual Exceptional comfort with high performance polypropylene fabric for heavy wear. No assembly required Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Hoffman Down-Filled Chaise Sectional Sofa Couch, 87.5&quot;W, Dark Grey Tweed\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gHy9G5K6L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SWCrTWqEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91SWCrTWqEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dSim97JvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1dSim97JvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B120AoFekxS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B120AoFekxS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bYavVVadL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91bYavVVadL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UJSxv8O-L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1UJSxv8O-L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1AHI