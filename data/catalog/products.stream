    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B071W2SCTJ\",\"sku\":\"B071W2SCTJ\",\"lang\":\"en\",\"slug\":\"glenwood-industrial-metal-accent-bed-king-86-l-oak-b071w2sctj\",\"name\":\"Glenwood Industrial Metal Accent Bed, King, 86&quot;L, Oak\",\"description\":\"This industrial-influenced bed features metal framework on top of the headboard and bottom of the low-profile footboard. Solid hardwood construction is finished with hand-selected quarter-sawn oak veneer and wire-brushed for a distressed look. 80&quot;W x 86&quot; L x 56&quot; H Solid hardwood with oak veneer and metal base A bold industrial design is softened by a classic wood finish to blend with modern décor. Five slabs, each with two legs, provide sturdy support for mattress and boxspring. Free returns for 30 days. 3-year warranty. Mattress and boxspring not included Easy assembly. Clean with soft dry cloth.\",\"primaryImage\":{\"alt\":\"Glenwood Industrial Metal Accent Bed, King, 86&quot;L, Oak\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Hx+LcvhXL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f5Z+lDd2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81f5Z+lDd2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sNyInf1HL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81sNyInf1HL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919fWVf5R2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/919fWVf5R2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FtQiB-teL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91FtQiB-teL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kKXQxRGEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1kKXQxRGEL.jpg\"}],\"attri