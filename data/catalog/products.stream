    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07B82PXD8\",\"sku\":\"B07B82PXD8\",\"lang\":\"en\",\"slug\":\"rivet-ian-modern-medium-dining-kitchen-table-expandable-60-80-l-brown-b07b82pxd8\",\"name\":\"Rivet Ian Modern Medium Dining Kitchen Table, Expandable, 60-80&quot;L, Brown\",\"description\":\"Slanted, tapered legs provide a hint of mid-century style, while butterscotch finish lends a traditional feel. Handsomely-styled corners are visually appealing as well as sturdy. The result is a transitional table that blends with a variety of décor. 39&quot;D x 60-80&quot;L x 30&quot;H Sturdy hardwoods with acacia veneer Modern and traditional touches give it transitional style that will blend with many rooms An extra leaf is provided to expand the table if needed Assembly in 30 minutes or less; just bolt on legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Ian Modern Medium Dining Kitchen Table, Expandable, 60-80&quot;L, Brown\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/710Jms+85AL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61FUU2KHkVL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/61FUU2KHkVL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gCAxxKOiL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91gCAxxKOiL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6129VmKJHHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/61/6129VmKJHHL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1p26euLLvL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1p26euLLvL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Sn5WDpfML.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Sn5WDpfML.jpg\"}],\"attri