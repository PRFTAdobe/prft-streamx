    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07HZ75R6L\",\"sku\":\"B07HZ75R6L\",\"lang\":\"en\",\"slug\":\"fischer-full-sized-sleeper-sofa-72-w-driftwood-leather-b07hz75r6l\",\"name\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Driftwood Leather\",\"description\":\"A classic look updated for modern tastes and a pull-out bed make this full-sized sleeper sofa a perfect blend of style and functionality. The solid hardwood frame keeps this sofa sturdy through years of use, and the reversible seat cushions ensure durability and extend this sofa’s life. Overall: 72&quot;W x 35&quot;D x 34&quot;H; Seat Height: 20&quot;H; Seat Depth 23&quot;D; Seat Back Height: 34&quot;H; Arm Height: 25&quot;H; Leg Height: 2.75&quot;H Sturdy wood frame with rich top-grain leather upholstery Clean lines and rich color make this piece a perfect accent for transitional-style home decor. The tight, fixed back and reversible seat cushions ensure durability and comfort. No assembly required Free returns for 30 days. 3-year warranty. This item is made to order just for you.\",\"primaryImage\":{\"alt\":\"Fischer Full-Sized Sleeper Sofa, 72&quot;W, Driftwood Leather\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71TYJhEPs2L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tgwlS4XEL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71tgwlS4XEL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JkaA26-9L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71JkaA26-9L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716xmebDZfL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/716xmebDZfL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-TXbkLyGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91-TXbkLyGL.jpg\"},{\"alt\":\"