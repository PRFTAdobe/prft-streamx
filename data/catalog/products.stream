    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B07PBYX3B6\",\"sku\":\"B07PBYX3B6\",\"lang\":\"en\",\"slug\":\"rivet-andrews-contemporary-sofa-couch-with-removable-cushions-82-w-wathet-blue-b07pbyx3b6\",\"name\":\"Rivet Andrews Contemporary Sofa Couch with Removable Cushions, 82&quot;W, Wathet Blue\",\"description\":\"This sofa features removable cushions in an attractive easy-care blue fabric that will bring class to your living room or den or any room you add it to. Foam padding offers comfort, but the solid hardwood frame ensures stability and support. 82&quot;W x 37&quot;D x 36&quot;H Solid hardwood frame with tapered wood legs Reversible and removable back and seat cushions Contemporary style and easy-care fabric combine to make this a welcome addition to any room. No assembly required Avoid moisture. Wipe with a soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Andrews Contemporary Sofa Couch with Removable Cushions, 82&quot;W, Wathet Blue\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81OQa6KUBWL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911EfeGUFGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/911EfeGUFGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yf2FIa59L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81Yf2FIa59L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+PIXk9yXL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81+PIXk9yXL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A4JWuxycL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1A4JWuxycL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81bi+0h1DeL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/origina