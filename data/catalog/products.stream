    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072ZNMKGM\",\"sku\":\"B072ZNMKGM\",\"lang\":\"en\",\"slug\":\"rivet-king-street-industrial-cabinet-media-console-table-with-functional-storage-walnut-black-metal-glass-b072znmkgm\",\"name\":\"Rivet King Street Industrial Cabinet Media Console Table With Functional Storage, Walnut, Black Metal, Glass\",\"description\":\"This modern, super-functional console with its solid metal frame can hold your TV on the tempered glass top, as well as lots of odds and ends in its drawers and cabinets underneath. 47.2&quot;L x 15.7&quot;W x 31.5&quot;H Engineered wood, walnut veneer drawers and cabinets, metal legs, tempered glass top Modern Industrial Designed to hold a TV Minimal Assembly Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet King Street Industrial Cabinet Media Console Table With Functional Storage, Walnut, Black Metal, Glass\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81cmXGpwJ8L.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813BK6HSQGL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/813BK6HSQGL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J+5Jc5V7L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91J+5Jc5V7L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R01NUC7hL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1R01NUC7hL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pPjjOYfDL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91pPjjOYfDL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qNld-ZgBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71qNld-ZgBL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values