    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B08568JW1B\",\"sku\":\"B08568JW1B\",\"lang\":\"en\",\"slug\":\"rivet-vermont-modern-diamond-stitched-upholstered-dining-chair-20-w-set-of-2-graphite-grey-b08568jw1b\",\"name\":\"Rivet Vermont Modern Diamond-Stitched Upholstered Dining Chair, 20&quot;W, Set of 2, Graphite Grey\",\"description\":\"The armless profile, sleek metal legs and diamond-stitched cushion pattern of this dining chair combine classic and modern looks into an elegant style of its own. Overall: 23.2.&quot;D x 20&quot;W x 35&quot;H. Seat height: 19&quot; Solid wood frame with sturdy metal base. Set of 2 padded, upholstered dining chairs with brass legs and H-shaped stretcher bar. Avoid moisture. Wipes clean with soft, dry cloth. Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Vermont Modern Diamond-Stitched Upholstered Dining Chair, 20&quot;W, Set of 2, Graphite Grey\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81RTqPO0qrL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FAJpACaqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71FAJpACaqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gtaYLj67L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71gtaYLj67L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zN1qRuc2L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/71/71zN1qRuc2L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nYI3FBahL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81nYI3FBahL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iNL-SQrZL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1iNL-SQrZL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim