    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075QK52HW\",\"sku\":\"B075QK52HW\",\"lang\":\"en\",\"slug\":\"rivet-elaine-tufted-line-upholstered-headboard-full-queen-60-h-linen-rose-b075qk52hw\",\"name\":\"Rivet Elaine Tufted Line Upholstered Headboard Full / Queen, 60&quot; H, Linen Rose\",\"description\":\"This upholstered headboard will add a polished update to any style bedroom. Performance fabric with a linen-like texture is accented by hand-pulled button tufting. Plentiful foam padding makes it cozy to lean against while reading a good book. 64&quot;W x 7.25&quot;L x 60&quot;H Sturdy hardwood frame; polyeser performance fabric; birch wood legs Transitional style that blends with most décor Narrow profile makes it easy to move. Mattress, boxspring and bed frame sold separately. Easy assembly. All hardware and assembly tools included Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Elaine Tufted Line Upholstered Headboard Full / Queen, 60&quot; H, Linen Rose\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91q9epi-MxL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1h2RV4ITyS.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1h2RV4ITyS.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZmVx4d8aL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91ZmVx4d8aL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gFh3JPZES.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1gFh3JPZES.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l7Mz+3KsL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91l7Mz+3KsL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1alE-ogg1L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/ori