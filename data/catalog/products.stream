    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X2X4SR\",\"sku\":\"B075X2X4SR\",\"lang\":\"en\",\"slug\":\"leila-tufted-oversized-accent-chair-44-w-linen-b075x2x4sr\",\"name\":\"Leila Tufted Oversized Accent Chair, 44&quot; W, Linen\",\"description\":\"This item is made to order just for you 44&quot;W x 36&quot;D x31&quot;H Solid wood frame and legs with durable fabric upholstery. The tight, fixed back and removable/reversible cushion ensures durability and comfort. Treat yourself to luxury in this striking, vintage look chair. With solid wood legs in a dark walnut finish, plush upholstery and a low, curved tufted back, it exudes opulence. The removable/reversible seat cushion ensures many years of use. Assemble in 15 minutes or less. Vacuum or wipe with a soft, dry cloth. Free returns for 30 days. 3-year warranty.\",\"primaryImage\":{\"alt\":\"Leila Tufted Oversized Accent Chair, 44&quot; W, Linen\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91MPYED1DkL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0TVP4-SL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1j0TVP4-SL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GWvWx4gBL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1GWvWx4gBL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nne5Y202L.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91Nne5Y202L.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+p7+-snHL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1+p7+-snHL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"44.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\"