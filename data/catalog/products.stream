    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B075X4F5T8\",\"sku\":\"B075X4F5T8\",\"lang\":\"en\",\"slug\":\"st-cloud-modern-armless-straight-back-settee-49-w-berry-b075x4f5t8\",\"name\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Berry\",\"description\":\"This item is made to order just for you 49&quot;W x 33&quot;D x 38&quot;H Sturdy wood frame, durable polyester fabric, wood legs with walnut finish. A mid-century inspired design that will add elegance to a modern or transitional room Assemble in 15 minutes or less. Vacuum or wipe with soft dry cloth. Free returns for 30 days. 3-year warranty. A straight back and sloping, low-profile arms are the highlights of this mid-century inspired settee. Assembled in the U.S., the sturdy wood frame is upholstered with durable, tightly woven fabric for a handsome design that's built to last.\",\"primaryImage\":{\"alt\":\"St. Cloud Modern Armless Straight Back Settee, 49&quot;W, Berry\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91WuYQS25rL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nQ8UQkQlL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91nQ8UQkQlL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z-Tm1A3sL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1z-Tm1A3sL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sLmS619zL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1sLmS619zL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wLKFJ1tLL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91wLKFJ1tLL.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"38.0\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"49.0\",\"label\":\"inches\"}]},{