    "dev.streamx.blueprints.data.Data": {
      "content": {
        "bytes": "{\"id\":\"B072M1WJF2\",\"sku\":\"B072M1WJF2\",\"lang\":\"en\",\"slug\":\"rivet-midtown-contemporary-upholstered-sofa-couch-92-1-w-cream-b072m1wjf2\",\"name\":\"Rivet Midtown Contemporary Upholstered Sofa Couch, 92.1&quot;W, Cream\",\"description\":\"Nestle in for an evening of movie marathon on this modern, smartly designed sofa. With seating for three and removable side and back cushions, you'll have plenty of room for snuggling with your pet or significant other. 37&quot;D x 92.1”W x 31.5&quot;H Sturdy hardwood frame, resilient cushions and solid beech legs Contemporary Soft, removable cushions make sofa easier to move. Simple assembly; just attach legs Free returns for 30 days. 1-year warranty.\",\"primaryImage\":{\"alt\":\"Rivet Midtown Contemporary Upholstered Sofa Couch, 92.1&quot;W, Cream\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81gxJ5pACBL.jpg\"},\"gallery\":[{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qzinv6UxL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/81/81qzinv6UxL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hgE84-LqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/A1/A1hgE84-LqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dzxtCaiqL.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/91/91dzxtCaiqL.jpg\"},{\"alt\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xQhhy74US.jpg\",\"url\":\"https://storage.googleapis.com/puresight-pim-images/original/B1/B1xQhhy74US.jpg\"}],\"attributes\":[{\"name\":\"height\",\"label\":\"Height\",\"values\":[{\"value\":\"31.5\",\"label\":\"inches\"}]},{\"name\":\"width\",\"label\":\"Width\",\"values\":[{\"value\":\"37.0\",\"label\":\"inches\"}]},{\"name\":\"length\",\"label\":\"Length\",\"values\":[{\"value\":\"92.1\",\"label\":\"inches\"}]},{\"name\":\"we