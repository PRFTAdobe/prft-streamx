n                                    <div>\n                                        <label\n                                            class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                            for=\"postcode\">ZIP Code</label>\n                                        <input\n                                            class=\"shipping-info flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm\"\n                                            id=\"postcode\" required=\"\" value=\"\" />\n                                    </div>\n                                    <div>\n                                        <label\n                                            class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                            for=\"telephone\">Phone Number</label>\n                                        <input type=\"tel\"\n                                            class=\"shipping-info flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm\"\n                                            id=\"telephone\" required=\"\" value=\"\" />\n                                    </div>\n                                </div>\n                                <div class=\"flex items-center space-x-2\">\n                                    <input class=\"billing-address\" type=\"checkbox\" aria-hidden=\"true\" name=\"billing\"\n                                        tabindex=\"-1\" value=\"true\" checked />\n                                    <label\n                                        class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 flex items-center gap-2 cursor-pointer\"\n                                        for=\"billing\">\n                                        Billing address same as Shipping address\n                                    </label>\n                                </div>\n                                <div class=\"form-error-message flex items-center space-x-2 text-dsg-red hidden\">\n                                    <p>All inputs are required</p>\n                                </div>\n                            </div>\n                            <div class=\"block mt-8 border-t pt-6 step-1\">\n                                <div class=\"flex justify-between mb-4\">\n                                    <span class=\"font-semibold\">Total</span>\n                                    <span class=\"font-semibold\">\n                                        <span>$</span>\n                                        <span class=\"total\"></span>\n                                    </span>\n                                </div>\n                                <button\n                                    class=\"continue-payment transition active:scale-95 cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 w-full bg-dsg-red hover:bg-dsg-red/90 text-white\"\n                                    type=\"button\">\n                                    Continue to Payment\n                                </button>\n                            </div>\n                            <div class=\"hidden space-y-6 step-2\">\n                                <div role=\"radiogroup\" aria-required=\"false\" dir=\"ltr\"\n                                    class=\"grid grid-cols-2 gap-4 payment-group\" tabindex=\"0\" style=\"outline: none\">\n                                    <div class=\"border rounded-lg p-4 cursor-pointer border-gray-200\">\n                                        <button type=\"button\" role=\"radio\" aria-checked=\"false\" data-state=\"checked\"\n                                            value=\"stripe\"\n                                            class=\"transition active:scale-95 aspect-square h-4 w-4 rounded-full border border-primary text-primary ring-offset-background focus:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 sr-only\"\n                                            id=\"stripe\" tabindex=\"-1\" data-radix-collection-item=\"\"></button>\n                                        <input type=\"radio\" aria-hidden=\"true\" name=\"payment\" tabindex=\"-1\"\n                                            value=\"checkmo\"\n                                            style=\"transform: translateX(-100%); position: absolute; pointer-events: none; opacity: 0; margin: 0px; width: 16px; height: 16px;\" />\n                                        <label\n                                            class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 flex items-center gap-2 cursor-pointer\"\n                                            for=\"stripe\">\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\"\n                                                viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\n                                                stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                                                class=\"lucide lucide-banknote h-5 w-5\">\n                                                <rect width=\"20\" height=\"12\" x=\"2\" y=\"6\" rx=\"2\"></rect>\n                                                <circle cx=\"12\" cy=\"12\" r=\"2\"></circle>\n                                                <path d=\"M6 12h.01M18 12h.01\"></path>\n                                            </svg>\n                                            Check / Money order\n                                        </label>\n                                    </div>\n                                    <div class=\"payment-error-message flex items-center space-x-2 text-dsg-red hidden\">\n                                        <p>Please select a payment method</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"hidden mt-8 border-t pt-6 step-2\">\n                                <div class=\"flex justify-between mb-4\">\n                                    <span class=\"font-semibold\">Total</span>\n                                    <span class=\"font-semibold\">\n                                        <span>$</span>\n                                        <span class=\"total\"></span>\n                                    </span>\n                                </div>\n                                <button\n                                    class=\"transition active:scale-95 inline-flex cursor-pointer items-center justify-center gap-2 place-order whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 w-full bg-dsg-red hover:bg-dsg-red/90 text-white\"\n                                    type=\"button\">\n                                    Place Order\n                                </button>\n                            </div>\n                            <div class=\"container hidden mx-auto px-4 py-8 grow step-3\">\n                                <div class=\"max-w-3xl mx-auto\">\n                                    <div>\n                                        <div class=\"text-center mb-8\">\n                                            <h1 class=\"text-2xl font-bold text-dsg-red mb-2\">Order Confirmed!</h1>\n                                            <p class=\"text-gray-600\">Thank you for your purchase</p>\n                                        </div>\n                                        <div class=\"space-y-6 user-data\">\n                                            <div>\n                                                <h2 class=\"font-semibold mb-4 text-xl\">Shipping Information</h2>\n                                                <div class=\"grid grid-cols-2 gap-4 text-gray-600\">\n                                                    <div>\n                                                        <p class=\"font-medium\">Name:</p>\n                                                        <p class=\"checkout-name\"></p>\n                                                    </div>\n                                                    <div>\n                                                        <p class=\"font-medium\">Phone:</p>\n                                                        <p class=\"checkout-phone\"></p>\n                                                    </div>\n                                                    <div class=\"col-span-2\">\n                                                        <p class=\"font-medium\">Address:</p>\n                                                        <p class=\"checkout-address\">Main street</p>\n                                                        <p class=\"checkout-city\"></p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div>\n                                                <h2 class=\"font-semibold text-xl mb-4\">Payment Information</h2>\n                                                <div class=\"text-gray-600\">\n                                                    <p class=\"font-medium\">Payment Method:</p>\n                                                    <p class=\"capitalize checkout-payment\"></p>\n                                                </div>\n                                            </div>\n                                            <div>\n                                                <h2 class=\"font-semibold text-xl mb-4\">Order Summary</h2>\n                                                <div class=\"space-y-4\">\n                                                    <div class=\"border-t pt-4\">\n                                                        <div class=\"flex justify-between mb-4\">\n                                                            <span class=\"font-semibold\">Order number</span>\n                                                            <span class=\"font-semibold order-number\"></span>\n                                                        </div>\n                                                        <div class=\"flex justify-between\">\n                                                            <span class=\"font-semibold\">Total</span>\n                                                            <span class=\"font-semibold text-dsg-red\">\n                                                                <span>$</span>\n                                                                <span class=\"total\"></span>\n                                                            </span>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"no-products text-center hidden\">\n        <p class=\"py-8\">Please add products to your cart</p>\n        <a href=\"/homepage.html\"\n            class=\"continue-payment inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 bg-dsg-red hover:bg-dsg-red/90 text-white m-auto\">Continue\n            Shopping</a>\n    </div>\n    <div class=\"loading-message text-center py-8 hidden\">\n        <p>Please wait, while we fetch your cart...</p>\n    </div>\n</div>\n\n<script defer src=\"../web-resources/js/decorators/decorate-cart.js\" type=\"module\"></script>\n<script defer src=\"../web-resources/js/checkout-form.js\" type=\"module\"></script>\n"}}}}{"key":"carousel-template.html","action":"publish","eventTime":{"long":1746198482363},"properties":{},"payload":{"dev.streamx.blueprints.data.Composition":{"layoutKey":{"string":"contentPage.html"},"content":{"bytes":"<!-- Carousel Template -->\n  