                   <th\n                            class=\"h-12 px-4 text-left align-middle font-semibold text-muted-foreground [&:has([role=checkbox])]:pr-0\">\n                            Date</th>\n                        <th\n                            class=\"h-12 px-4 text-left align-middle font-semibold text-muted-foreground [&:has([role=checkbox])]:pr-0\">\n                            Items</th>\n                        <th\n                            class=\"h-12 px-4 text-left align-middle font-semibold text-muted-foreground [&:has([role=checkbox])]:pr-0\">\n                            Total</th>\n                        <th\n                            class=\"h-12 px-4 text-left align-middle font-semibold text-muted-foreground [&:has([role=checkbox])]:pr-0\">\n                            Status</th>\n                    </tr>\n                </thead>\n                <tbody class=\"[&_tr:last-child]:border-0\">\n                </tbody>\n            </table>\n        </div>\n    </div>\n    <div class=\"lg:col-span-1 hidden log-out-user h-[25em]\">\n        <div class=\"flex flex-col items-center rounded-lg py-[10em] px-6\">\n            <div class=\"mb-8\">Please sign in.</div>\n        </div>\n    </div>\n</div>\n<script src=\"../web-resources/js/load-orders.js\" type=\"module\"></script>"}}}}{"key":"cart.html","action":"publish","eventTime":{"long":1746198482234},"properties":{},"payload":{"dev.streamx.blueprints.data.Composition":{"layoutKey":{"string":"contentPage.html"},"content":{"bytes":"{{#define name=\"metaTitle\"}}\n<title>Cart</title>\n\n{{#define name=\"content.html\"}}\n\n<div class=\"container mx-auto px-4 py-8\">\n    \n    <h1 class=\"text-2xl font-bold mb-8\">Shopping Cart</h1>\n    <div id=\"promoBanner\">\n        <div class=\"cf--promo-banner--container bg-gradient-to-r from-dsg-red/90 to-dsg-red mb-8 rounded-lg shadow-lg overflow-hidden hidden\"></div>\n    </div>\n    <div class=\"shopping-cart-content grid grid-cols-1 lg:grid-cols-3 gap-8 hidden\">\n        <div class=\"lg:col-span-2\">\n            <div class=\"cart-items-container bg-white rounded-lg shadow-sm divide-y\">\n            </div>\n        </div>\n        <div class=\"lg:col-span-1\">\n            <div class=\"bg-white rounded-lg shadow-sm p-6\">\n                <h2 class=\"text-xl font-semibold mb-4\">Order Summary</h2>\n                <div class=\"space-y-4\">\n                    <div class=\"flex justify-between\">\n                        <span>Subtotal</span>\n                        <span class=\"font-semibold\">\n                            <span>$</span>\n                            <span class=\"subtotal\"></span>\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between\">\n                        <span>Tax</span>\n                        <span class=\"font-semibold\">\n                            <span>$</span>\n                            <span class=\"tax\"></span>\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between\">\n                        <span>Shipping</span>\n                        <span class=\"font-semibold\">\n                            <span>$</span>\n                            <span class=\"shipping\"></span>\n                        </span>\n                    </div>\n                    <div class=\"border-t pt-4\">\n                        <div class=\"flex justify-between\">\n                            <span class=\"font-semibold\">Total</span>\n                            <span class=\"font-semibold\">\n                                <span>$</span>\n                                <span class=\"total\"></span>\n                            </span>\n                        </div>\n                    </div>\n                    <a class=\"checkout-button transition active:scale-95 cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 px-4 py-2 w-full bg-dsg-red hover:bg-dsg-red/90 text-white\"\n                        href=\"#shippingInformation\">\n                        Proceed to Checkout\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div id=\"shippingInformation\"\n        class=\"shipping-information-content grid grid-cols-1 lg:grid-cols-3 gap-8 form-section hidden\">\n        <div class=\"lg:col-span-2\">\n            <div class=\"container mx-auto px-4 py-8\">\n                <div class=\"max-w-3xl mx-auto\">\n                    <div class=\"tabs flex justify-between mb-8\">\n                        <div class=\"shipping-information flex-1 text-center text-dsg-red\">\n                            <div class=\"border-b-2 pb-2 border-dsg-red\">Shipping Information</div>\n                        </div>\n                        <div class=\"payment-method flex-1 text-center text-gray-500\">\n                            <div class=\"border-b-2 pb-2 border-gray-200\">Payment Method</div>\n                        </div>\n                    </div>\n                    <div class=\"bg-white rounded-lg shadow-sm p-6\">\n                        <form class=\"checkout-form\">\n                            <div class=\"block space-y-4 step-1\">\n                                <div class=\"grid grid-cols-2 gap-4\">\n                                    <div>\n                                        <label\n                                            class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                            for=\"firstname\">First Name</label>\n                                        <input\n                                            class=\"shipping-info flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm\"\n                                            id=\"firstname\" required=\"\" value=\"\" />\n                                    </div>\n                                    <div>\n                                        <label\n                                            class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                            for=\"lastname\">Last Name</label>\n                                        <input\n                                            class=\"shipping-info flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm\"\n                                            id=\"lastname\" required=\"\" value=\"\" />\n                                    </div>\n                                </div>\n                                <div class=\"hidden email-input\">\n                                    <label\n                                        class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                        for=\"email\">Email</label>\n                                    <input\n                                        class=\