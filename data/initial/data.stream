arent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}}],\"gallery\":[{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/m\\/g\\/mg04-bk-0.jpg\",\"alt\":\"Image\"}],\"quantity\":100,\"variants\":[]}"}}}}{"key":"lumax_product:233","action":"publish","eventTime":{"long":1746197730382},"properties":{"sx:type":"product/simple"},"payload":{"dev.streamx.blueprints.data.Data":{"content":{"bytes":"{\"sku\":\"24-MG01\",\"id\":\"233\",\"lang\":\"en\",\"attributes\":[{\"name\":\"small_image\",\"label\":\"Small\",\"values\":[{\"value\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/m\\/g\\/mg01-bk-0.jpg\",\"label\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/m\\/g\\/mg01-bk-0.jpg\"}],\"isFacet\":false},{\"name\":\"thumbnail\",\"label\":\"Thumbnail\",\"values\":[{\"value\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/m\\/g\\/mg01-bk-0.jpg\",\"label\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/m\\/g\\/mg01-bk-0.jpg\"}],\"isFacet\":false},{\"name\":\"url_key\",\"label\":\"URL Key\",\"values\":[{\"value\":\"endurance-watch\",\"label\":\"endurance-watch\"}],\"isFacet\":false},{\"name\":\"activity\",\"label\":\"Activity\",\"values\":[{\"value\":\"Recreation\",\"label\":\"Recreation\"},{\"value\":\"Athletic\",\"label\":\"Athletic\"}],\"isFacet\":true},{\"name\":\"material\",\"label\":\"Material\",\"values\":[{\"value\":\"Metal\",\"label\":\"Metal\"},{\"value\":\"Rubber\",\"label\":\"Rubber\"},{\"value\":\"Silicone\",\"label\":\"Silicone\"}],\"isFacet\":true},{\"name\":\"visibility\",\"label\":\"Visibility\",\"values\":[{\"value\":\"Catalog, Search\",\"label\":\"Catalog, Search\"}],\"isFacet\":false},{\"name\":\"tax_class_id\",\"label\":\"Tax Class\",\"values\":[{\"value\":\"Taxabl