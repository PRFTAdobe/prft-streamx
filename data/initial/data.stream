 whole day's worth of books, binders and gym clothes. The spacious main compartment includes a dedicated laptop sleeve. Two other compartments offer extra storage space.<\\/p>\\n<ul>\\n<li>Foam-padded adjustable shoulder straps.<\\/li>\\n<li>900D polyester.<\\/li>\\n<li>Oversized zippers.<\\/li>\\n<li>Locker loop.<\\/li>\\n<\\/ul>\",\"price\":{\"value\":33,\"discountedValue\":33},\"slug\":\"endeavor-daytrip-backpack-207\",\"categories\":[{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}},{\"id\":\"202\",\"name\":\"Bags\",\"slug\":\"bags\",\"label\":\"Bags\",\"parent\":{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}},{\"id\":\"206\",\"name\":\"Collections\",\"slug\":\"collections\",\"label\":\"Collections\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}],\"gallery\":[{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb06-red-0.jpg\",\"alt\":\"Image\"},{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb06-red-0_alt1.jpg\",\"alt\":\"Image\"}],\"quantity\":100,\"variants\":[]}"}}}}{"key":"lumax_product:208","action":"publish","eventTime":{"long":1746197730382},"properties":{"sx:type":"product/simple"},"payload":{"dev.streamx.blueprints.data.Data":{"content":{"bytes":"{\"sku\":\"24-WB03\",\"id\":\"208\",\"lang\":\"en\",\"attributes\":[{\"name\":\"small_image\",\"label\":\"Small\"