ester\"}],\"isFacet\":true},{\"name\":\"visibility\",\"label\":\"Visibility\",\"values\":[{\"value\":\"Catalog, Search\",\"label\":\"Catalog, Search\"}],\"isFacet\":false},{\"name\":\"tax_class_id\",\"label\":\"Tax Class\",\"values\":[{\"value\":\"Taxable Goods\",\"label\":\"Taxable Goods\"}],\"isFacet\":false}],\"name\":\"Voyage Yoga Bag\",\"label\":\"Voyage Yoga Bag\",\"primaryImage\":{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb01-black-0.jpg\",\"alt\":\"Image\"},\"description\":\"<p>Everything you need for a trip to the gym will fit inside this surprisingly spacious Voyage Yoga Bag. Stock it with a water bottle, change of clothes, pair of shoes, and even a few beauty products. Fits inside a locker and zips shut for security.<\\/p>\\n<ul>\\n<li>Slip pocket on front.<\\/li>\\n<li>Contrast piping.<\\/li>\\n<li>Durable nylon construction.<\\/li>\\n<\\/ul>\",\"price\":{\"value\":32,\"discountedValue\":32},\"slug\":\"voyage-yoga-bag-204\",\"categories\":[{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}},{\"id\":\"202\",\"name\":\"Bags\",\"slug\":\"bags\",\"label\":\"Bags\",\"parent\":{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}}],\"gallery\":[{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb01-black-0.jpg\",\"alt\":\"Image\"}],\"quantity\":100,\"variants\":[]}"}}}}{"key":"lumax_product:205","action":"publish","eventTime":{"long":1746197730382},"properties":{"sx:type":"product/simple"},"payload":{"dev.streamx