rk to gym and back or home again. It's the perfect size and shape for laptop, folded clothes, even extra shoes.<\\/p>\\n<ul>\\n<li>Adjustable crossbody strap.<\\/li>\\n<li>Top handle.<\\/li>\\n<li>Zippered interior pocket.<\\/li>\\n<li>Secure clip closures.<\\/li>\\n<li>Durable fabric construction.<\\/li>\\n<\\/ul>\",\"price\":{\"value\":45,\"discountedValue\":45},\"slug\":\"push-it-messenger-bag-210\",\"categories\":[{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}},{\"id\":\"202\",\"name\":\"Bags\",\"slug\":\"bags\",\"label\":\"Bags\",\"parent\":{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}},{\"id\":\"206\",\"name\":\"Collections\",\"slug\":\"collections\",\"label\":\"Collections\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}],\"gallery\":[{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb04-blue-0.jpg\",\"alt\":\"Image\"}],\"quantity\":100,\"variants\":[]}"}}}}{"key":"lumax_product:211","action":"publish","eventTime":{"long":1746197730382},"properties":{"sx:type":"product/simple"},"payload":{"dev.streamx.blueprints.data.Data":{"content":{"bytes":"{\"sku\":\"24-UG06\",\"id\":\"211\",\"lang\":\"en\",\"attributes\":[{\"name\":\"small_image\",\"label\":\"Small\",\"values\":[{\"value\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/u\\/g\\/ug06-lb-0.jpg\",\"label\":\"https:\\/\\/maste