\",\"label\":\"Thumbnail\",\"values\":[{\"value\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb05-red-0.jpg\",\"label\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb05-red-0.jpg\"}],\"isFacet\":false},{\"name\":\"url_key\",\"label\":\"URL Key\",\"values\":[{\"value\":\"savvy-shoulder-tote\",\"label\":\"savvy-shoulder-tote\"}],\"isFacet\":false},{\"name\":\"activity\",\"label\":\"Activity\",\"values\":[{\"value\":\"Yoga\",\"label\":\"Yoga\"},{\"value\":\"Gym\",\"label\":\"Gym\"}],\"isFacet\":true},{\"name\":\"style_bags\",\"label\":\"Style Bags\",\"values\":[{\"value\":\"Exercise\",\"label\":\"Exercise\"},{\"value\":\"Tote\",\"label\":\"Tote\"}],\"isFacet\":true},{\"name\":\"special_price\",\"label\":\"Special Price\",\"values\":[{\"value\":\"24.000000\",\"label\":\"24.000000\"}],\"isFacet\":false},{\"name\":\"special_from_date\",\"label\":\"Special Price From Date\",\"values\":[{\"value\":\"2024-12-17 00:00:00\",\"label\":\"2024-12-17 00:00:00\"}],\"isFacet\":false},{\"name\":\"visibility\",\"label\":\"Visibility\",\"values\":[{\"value\":\"Catalog, Search\",\"label\":\"Catalog, Search\"}],\"isFacet\":false},{\"name\":\"tax_class_id\",\"label\":\"Tax Class\",\"values\":[{\"value\":\"Taxable Goods\",\"label\":\"Taxable Goods\"}],\"isFacet\":false}],\"name\":\"Savvy Shoulder Tote\",\"label\":\"Savvy Shoulder Tote\",\"primaryImage\":{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb05-red-0.jpg\",\"alt\":\"Image\"},\"description\":\"<p>Powerwalking to the gym or strolling to the local coffeehouse, the Savvy Shoulder Tote lets you stash your essentials in sporty style! A top-loading compartment provides quick and easy access to larger items, while zippered pockets on the front and side hold cash, credit cards and phone.<\\/p>\\n<ul>\\n<li>Water-resistant shell.<\\/li>\\n<li>Water bottle pocket.<\\/li>\\n<li>Padded, articulating shoulder strap.<\\/li>\\n<li>Dimensions: W 21\\\" x H 15\\\" x D 10\\\".<\\/li>\\n<\\/ul>\",\"price\":{\"value\":32,\"discountedValue\":32},\"slug\":\"savvy-shoulder-tote-206\",\"categories\":[{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}},{\"id\":\"202\",\"name\":\"Bags\",\"slug\":\"bags\",\"label\":\"Bags\",\"parent\":{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}},{\"id\":\"206\",\"name\":\"Collections\",\"slug\":\"collections\",\"label\":\"Collections\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}}],\"gallery\":[{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb05-red-0.jpg\",\"alt\":\"Image\"}],\"quantity\":100,\"variants\":[]}"}}}}{"key":"lumax_product:207","action":"publish","eventTime":{"long":1746197730382},"properties":{"sx:type":"product/simple"},"payload":{"dev.streamx.blueprints.data.Data":{"content":{"bytes":"{\"sku\":\"24-WB06\",\"id\":\"207\",\"lang\":\"en\",\"attributes\":[{\"name\":\"small_image\",\"label\":\"Small\",\"values\":[{\"value\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb06-red-0.jpg\",\"label\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/w\\/b\\/wb06-red-0.jpg\"}],\"isFacet\":false},{\"name\":\"thumbnail\",\"label\":\"Thumbnail\",\"values\":[{\"v