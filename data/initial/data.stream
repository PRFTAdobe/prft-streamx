\":\"Gym\",\"label\":\"Gym\"},{\"value\":\"Sports\",\"label\":\"Sports\"}],\"isFacet\":true},{\"name\":\"material\",\"label\":\"Material\",\"values\":[{\"value\":\"Foam\",\"label\":\"Foam\"}],\"isFacet\":true},{\"name\":\"visibility\",\"label\":\"Visibility\",\"values\":[{\"value\":\"Catalog, Search\",\"label\":\"Catalog, Search\"}],\"isFacet\":false},{\"name\":\"tax_class_id\",\"label\":\"Tax Class\",\"values\":[{\"value\":\"Taxable Goods\",\"label\":\"Taxable Goods\"}],\"isFacet\":false}],\"name\":\"Sprite Foam Yoga Brick\",\"label\":\"Sprite Foam Yoga Brick\",\"primaryImage\":{\"url\":\"https:\\/\\/master-7rqtwti-f3ef32mfqsxfe.us-4.magentosite.cloud\\/media\\/catalog\\/product\\/l\\/u\\/luma-yoga-brick.jpg\",\"alt\":\"Image\"},\"description\":\"<p>Our top-selling yoga prop, the 4-inch, high-quality Sprite Foam Yoga Brick is popular among yoga novices and studio professionals alike. An essential yoga accessory, the yoga brick is a critical tool for finding balance and alignment in many common yoga poses. Choose from 5 color options.<\\/p>\\n<ul>\\n<li>Standard Large Size: 4\\\" x 6\\\" x 9\\\".\\n<li>Beveled edges for ideal contour grip.\\n<li>Durable and soft, scratch-proof foam.\\n<li>Individually wrapped.\\n<li>Ten color choices.\\n<\\/ul> \",\"price\":{\"value\":5,\"discountedValue\":5},\"slug\":\"sprite-foam-yoga-brick-217\",\"categories\":[{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\":\"Root Catalog\"}}},{\"id\":\"203\",\"name\":\"Fitness Equipment\",\"slug\":\"fitness-equipment\",\"label\":\"Fitness Equipment\",\"parent\":{\"id\":\"201\",\"name\":\"Gear\",\"slug\":\"gear\",\"label\":\"Gear\",\"parent\":{\"id\":\"181\",\"name\":\"Lumax\",\"slug\":\"lumax\",\"label\":\"Lumax\",\"parent\":{\"id\":\"1\",\"name\":\"Root Catalog\",\"slug\":\"root-catalog-1\",\"label\"