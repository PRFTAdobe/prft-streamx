ems-center gap-2\">\n            <svg class=\"lucide lucide-map-pin h-4 w-4\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path>\n              <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n            </svg>\n            <span>123 Sport Street, CA 90210</span>\n          </li>\n        </ul>\n      </div>\n      <div>\n        <h3 class=\"font-bold text-lg mb-4\">Follow Us</h3>\n        <div class=\"flex space-x-4\">\n          <a class=\"hover:text-dsg-red\" href=\"#\" aria-label=\"open facebook\">\n            <svg class=\"lucide lucide-facebook h-6 w-6\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"></path>\n            </svg>\n          </a><a class=\"hover:text-dsg-red\" href=\"#\" aria-label=\"open instagram\">\n          <svg class=\"lucide lucide-instagram h-6 w-6\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect height=\"20\" rx=\"5\" ry=\"5\" width=\"20\" x=\"2\" y=\"2\"></rect>\n            <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path>\n            <line x1=\"17.5\" x2=\"17.51\" y1=\"6.5\" y2=\"6.5\"></line>\n          </svg>\n        </a><a class=\"hover:text-dsg-red\" href=\"#\" aria-label=\"open x\">\n          <svg class=\"lucide lucide-twitter h-6 w-6\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\"></path>\n          </svg>\n        </a><a class=\"hover:text-dsg-red\" href=\"#\" aria-label=\"open youtube\">\n          <svg class=\"lucide lucide-youtube h-6 w-6\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17\"></path>\n            <path d=\"m10 15 5-3-5-3z\"></path>\n          </svg>\n        </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-400\">\n      <p>Â© 2025 LumaX Sports Apparel. All rights reserved.</p>\n    </div>\n  </div>\n</footer>\n{{#include src=\"/fragments/footLibs.html\"}}"}}}}{"key":"fragments/header.html","action":"publish","eventTime":{"long":1746198481251},"properties":{"sx:type":"fragment/page-structure"},"payload":{"dev.streamx.blueprints.data.Fragment":{"content":{"bytes":"<!-- Nav Start -->\n<header class=\"w-full bg-white border-b border-gray-200\">\n  <div class=\"container mx-auto px-4 py-4\">\n    <div class=\"flex items-center justify-between\">\n      <div class=\"flex items-center space-x-2\">\n        <a href=\"/\"\n        ><img\n          alt\n          class=\"h-10 w-27\"\n          height=\"187\"\n          loading=\"lazy\"\n          src=\"../assets/lumax.svg?width=750&amp;format=svg&amp;optimize=medium\"\n          width=\"491\"\n        /></a>\n      </div>\n      <div class=\"hidden md:flex items-center space-x-8\">\n        <nav>\n          <ul class